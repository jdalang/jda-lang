; Minimal test case for struct array field access bug
; This should expose jda0's codegen issue

struct Token {
    type:  i32
    start: i64
    len:   i64
    imm:   i64
}

fn main() {
    let toks = Token[10]

    print("Test 1: Simple assignment")
    toks[0].type = 42
    print("Success: toks[0].type = 42")

    print("Test 2: Reading back")
    let val = toks[0].type
    print(val)

    print("Test 3: Multiple fields")
    toks[1].type = 100
    toks[1].start = 500
    toks[1].len = 10
    print("Success: Multiple fields")

    print("Test 4: Indexing with variable")
    let idx = 2
    toks[idx].type = 200
    print("Success: Variable index")

    print("All tests passed!")
}
