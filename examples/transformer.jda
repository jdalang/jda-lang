//       logits = model(batch_x)
//       loss   = F.cross_entropy(logits.view(-1,64), batch_y.view(-1))
//       opt.zero_grad()
//       loss.backward()          ← runtime graph traversal (slow)
//       opt.step()

// JDA — (see above — the actual code)

// Key advantages:
//   ✓ Tensors are typed with shape: [BATCH x SEQ_LEN x D_MODEL]f32
//     → shape errors are compile-time, not runtime crashes
//   ✓ @differentiable: backward pass is a plain jda function (inspectable)
//     → no opaque autograd graph built at runtime
//   ✓ No Python interpreter, no C++ extension boundary
//   ✓ Single binary — no venv, no pip, no conda, no CUDA install
//   ✓ GPU via @gpu annotation on forward() — no CUDA C++ required
//   ✓ ~75 lines of real code vs ~120 lines of PyTorch boilerplate
