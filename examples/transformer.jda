// =============================================================================
// Jda Transformer Demo — Tiny Language Model
// =============================================================================
// A minimal decoder-only transformer (GPT-style) trained on a character-level
// task in pure Jda. No Python. No C++. No external ML library.

// Architecture
//   vocab = 64 characters (printable ASCII)
//   d_model = 64    (embedding dimension)
//   n_heads = 4     (multi-head attention)
//   d_head  = 16    (d_model / n_heads)
//   d_ff    = 256   (feed-forward hidden size)
//   n_layers= 2     (transformer blocks)
//   seq_len = 32    (context window)

// Task: predict the next character given the previous ones.
// Dataset: a 4 KB string repeated in a ring buffer — tiny but enough to
//          demonstrate that training loss decreases.

// Training: Adam, lr = 0.001, 500 steps, batch size = 16

// Jda vs PyTorch (side-by-side at the bottom of this file)
// =============================================================================

import jda::ml::nn::{ Linear, Softmax, mse_loss, cross_entropy_loss, Adam }
import jda::ml::data::{ Dataset, DataLoader }

// =============================================================================
// Hyper-parameters (compile-time constants → shape-checked by compiler)
// =============================================================================
const VOCAB     = 64    // printable ASCII range [32..95]
const D_MODEL   = 64
const N_HEADS   = 4
const D_HEAD    = D_MODEL / N_HEADS    // 16
const D_FF      = 256
const N_LAYERS  = 2
const SEQ_LEN   = 32
const BATCH     = 16
const LR        = 0.001f32
const STEPS     = 500

// =============================================================================
// Token embedding + positional encoding
// =============================================================================
struct Embedder {
    tok_emb: tensor [VOCAB   x D_MODEL]f32   // token embedding table
    pos_emb: tensor [SEQ_LEN x D_MODEL]f32   // learned positional encoding
}

impl Embedder {
    fn new() -> own Embedder {
        ret Embedder {
            tok_emb: tensor [VOCAB   x D_MODEL]f32::randn() * 0.02,
            pos_emb: tensor [SEQ_LEN x D_MODEL]f32::randn() * 0.02,
        }
    }

    // tokens: [B x T]i64  →  out: [B x T x D_MODEL]f32
    fn forward(self, tokens: ref tensor [BATCH x SEQ_LEN]i64)
              -> tensor [BATCH x SEQ_LEN x D_MODEL]f32 {
        let out = tensor [BATCH x SEQ_LEN x D_MODEL]f32::zeros()
        loop b in 0..BATCH {
            loop t in 0..SEQ_LEN {
                let tid = tokens[b, t]
                // add token embedding + positional embedding
                out[b, t, ..] = self.tok_emb[tid, ..] + self.pos_emb[t, ..]
            }
        }
        ret out
    }
}

// =============================================================================
// Scaled dot-product attention (single head)
// =============================================================================
// Q, K, V: [B x T x D_HEAD]f32
// mask:    upper-triangular causal mask (−∞ for future positions)
fn scaled_dot_product(Q: tensor, K: tensor, V: tensor,
                       mask: tensor) -> tensor {
    let scale = 1.0f32 / sqrt(D_HEAD as f32)

    // scores = Q @ Kᵀ  →  [B x T x T]
    let scores = Q @ K.transpose(-1, -2) * scale

    // apply causal mask (add -1e9 to upper triangle)
    scores = scores + mask

    // softmax over last dimension
    let weights = softmax_3d(scores)   // [B x T x T]

    // attended values
    ret weights @ V    // [B x T x D_HEAD]
}

fn softmax_3d(x: tensor) -> tensor {
    // numerically stable softmax over last dimension
    let mx  = x.max(dim: -1, keepdim: true)
    let e   = (x - mx).exp()
    ret e / e.sum(dim: -1, keepdim: true)
}

// =============================================================================
// Multi-Head Attention
// =============================================================================
struct MultiHeadAttention {
    W_q: tensor [D_MODEL x D_MODEL]f32
    W_k: tensor [D_MODEL x D_MODEL]f32
    W_v: tensor [D_MODEL x D_MODEL]f32
    W_o: tensor [D_MODEL x D_MODEL]f32
}

impl MultiHeadAttention {
    fn new() -> own MultiHeadAttention {
        let scale = sqrt(2.0f32 / D_MODEL as f32)  // He init
        ret MultiHeadAttention {
            W_q: tensor [D_MODEL x D_MODEL]f32::randn() * scale,
            W_k: tensor [D_MODEL x D_MODEL]f32::randn() * scale,
            W_v: tensor [D_MODEL x D_MODEL]f32::randn() * scale,
            W_o: tensor [D_MODEL x D_MODEL]f32::randn() * scale,
        }
    }

    // x: [B x T x D_MODEL]   mask: [T x T]
    fn forward(self, x: ref tensor, mask: ref tensor) -> tensor {
        // Project to Q, K, V
        let Q = matmul_3d(x, self.W_q)   // [B x T x D_MODEL]
        let K = matmul_3d(x, self.W_k)
        let V = matmul_3d(x, self.W_v)

        // Split into heads: [B x T x D_MODEL] → [B x N_HEADS x T x D_HEAD]
        let Q_h = split_heads(Q)
        let K_h = split_heads(K)
        let V_h = split_heads(V)

        // Attention per head
        let attn_out = tensor [BATCH x N_HEADS x SEQ_LEN x D_HEAD]f32::zeros()
        loop h in 0..N_HEADS {
            attn_out[.., h, .., ..] =
                scaled_dot_product(Q_h[.., h, .., ..],
                                   K_h[.., h, .., ..],
                                   V_h[.., h, .., ..],
                                   mask)
        }

        // Merge heads: [B x N_HEADS x T x D_HEAD] → [B x T x D_MODEL]
        let merged = merge_heads(attn_out)

        // Output projection
        ret matmul_3d(merged, self.W_o)
    }
}

// Reshape [B x T x D_MODEL] → [B x N_HEADS x T x D_HEAD]
fn split_heads(x: tensor) -> tensor {
    let B = x.shape[0]
    let T = x.shape[1]
    ret x.reshape([B, T, N_HEADS, D_HEAD]).transpose(1, 2)
}

fn merge_heads(x: tensor) -> tensor {
    let B = x.shape[0]
    ret x.transpose(1, 2).reshape([B, SEQ_LEN, D_MODEL])
}

// Batched matrix multiply: [B x T x M] @ [M x N] → [B x T x N]
fn matmul_3d(x: tensor, w: tensor) -> tensor {
    let B = x.shape[0]
    let T = x.shape[1]
    let N = w.shape[1]
    let out = tensor [B x T x N]f32::zeros()
    loop b in 0..B {
        out[b, .., ..] = x[b, .., ..] @ w
    }
    ret out
}

// =============================================================================
// Feed-Forward Network (position-wise)
// =============================================================================
struct FeedForward {
    W1: tensor [D_MODEL x D_FF]f32
    b1: tensor [D_FF]f32
    W2: tensor [D_FF x D_MODEL]f32
    b2: tensor [D_MODEL]f32
}

impl FeedForward {
    fn new() -> own FeedForward {
        let s1 = sqrt(2.0f32 / D_MODEL as f32)
        let s2 = sqrt(2.0f32 / D_FF as f32)
        ret FeedForward {
            W1: tensor [D_MODEL x D_FF]f32::randn() * s1,
            b1: tensor [D_FF]f32::zeros(),
            W2: tensor [D_FF x D_MODEL]f32::randn() * s2,
            b2: tensor [D_MODEL]f32::zeros(),
        }
    }

    // x: [B x T x D_MODEL] → [B x T x D_MODEL]
    fn forward(self, x: ref tensor) -> tensor {
        let h = matmul_3d(x, self.W1)
        // broadcast-add bias
        h = h + self.b1
        // GELU activation  ≈  x * 0.5 * (1 + tanh(√(2/π) * (x + 0.044715*x³)))
        h = gelu_3d(h)
        let out = matmul_3d(h, self.W2)
        ret out + self.b2
    }
}

fn gelu_3d(x: tensor) -> tensor {
    let pi_coeff = 0.7978845608f32   // sqrt(2/π)
    let kappa    = 0.0446742f32
    ret x * 0.5f32 * (1.0f32 + (pi_coeff * (x + kappa * x * x * x)).tanh())
}

// =============================================================================
// Layer Normalisation
// =============================================================================
struct LayerNorm {
    gamma: tensor [D_MODEL]f32
    beta:  tensor [D_MODEL]f32
    eps:   f32
}

impl LayerNorm {
    fn new() -> own LayerNorm {
        ret LayerNorm {
            gamma: tensor [D_MODEL]f32::ones(),
            beta:  tensor [D_MODEL]f32::zeros(),
            eps:   1e-5f32,
        }
    }

    // x: [B x T x D_MODEL] → normalised [B x T x D_MODEL]
    fn forward(self, x: ref tensor) -> tensor {
        let mu  = x.mean(dim: -1, keepdim: true)    // [B x T x 1]
        let var = x.var(dim:  -1, keepdim: true)
        let xn  = (x - mu) / (var + self.eps).sqrt()
        ret xn * self.gamma + self.beta
    }
}

// =============================================================================
// Transformer Block (Pre-LN variant)
// =============================================================================
struct TransformerBlock {
    attn: MultiHeadAttention
    ff:   FeedForward
    ln1:  LayerNorm
    ln2:  LayerNorm
}

impl TransformerBlock {
    fn new() -> own TransformerBlock {
        ret TransformerBlock {
            attn: MultiHeadAttention::new(),
            ff:   FeedForward::new(),
            ln1:  LayerNorm::new(),
            ln2:  LayerNorm::new(),
        }
    }

    fn forward(self, x: ref tensor, mask: ref tensor) -> tensor {
        // Pre-LN attention + residual
        let x = x + self.attn.forward(self.ln1.forward(x), mask)
        // Pre-LN feed-forward + residual
        let x = x + self.ff.forward(self.ln2.forward(x))
        ret x
    }
}

// =============================================================================
// Full Decoder-Only Transformer
// =============================================================================
struct Transformer {
    embed:   Embedder
    blocks:  [N_LAYERS]TransformerBlock
    ln_f:    LayerNorm
    lm_head: tensor [D_MODEL x VOCAB]f32    // unembedding / language model head
    mask:    tensor [SEQ_LEN x SEQ_LEN]f32  // causal mask (constant)
}

impl Transformer {
    fn new() -> own Transformer {
        // Build upper-triangular causal mask filled with -1e9
        let mask = tensor [SEQ_LEN x SEQ_LEN]f32::zeros()
        loop i in 0..SEQ_LEN {
            loop j in (i+1)..SEQ_LEN {
                mask[i, j] = -1.0e9f32
            }
        }

        ret Transformer {
            embed:   Embedder::new(),
            blocks:  [N_LAYERS]TransformerBlock { TransformerBlock::new() },
            ln_f:    LayerNorm::new(),
            lm_head: tensor [D_MODEL x VOCAB]f32::randn() * 0.02,
            mask:    mask,
        }
    }

    // tokens: [B x T]i64  →  logits: [B x T x VOCAB]f32
    @differentiable
    fn forward(self, tokens: ref tensor [BATCH x SEQ_LEN]i64)
              -> tensor [BATCH x SEQ_LEN x VOCAB]f32 {
        let x = self.embed.forward(tokens)               // [B x T x D_MODEL]
        loop i in 0..N_LAYERS {
            x = self.blocks[i].forward(x, &self.mask)
        }
        x = self.ln_f.forward(x)
        ret matmul_3d(x, self.lm_head)                  // [B x T x VOCAB]
    }

    // Greedy autoregressive generation
    fn generate(self, prompt: ref []i64, max_new: i64) -> []i64 {
        let out = [SEQ_LEN + max_new]i64
        let n   = prompt.len
        loop i in 0..n { out[i] = prompt[i] }

        loop step in 0..max_new {
            // take the last SEQ_LEN tokens as context
            let start  = if n + step > SEQ_LEN { n + step - SEQ_LEN } else { 0 }
            let ctx_len = if n + step < SEQ_LEN { n + step } else { SEQ_LEN }

            // build single-batch input [1 x T]i64 (use first batch row)
            let input = tensor [BATCH x SEQ_LEN]i64::zeros()
            loop t in 0..ctx_len {
                input[0, t] = out[start + t]
            }
            let logits = self.forward(&input)        // [B x T x VOCAB]
            // take logits at last real position
            let last_logits = logits[0, ctx_len - 1, ..]   // [VOCAB]
            let next_tok    = argmax_1d(last_logits)
            out[n + step] = next_tok
        }
        ret out[0..(n + max_new)]
    }
}

fn argmax_1d(v: tensor) -> i64 {
    let best_idx = 0i64
    let best_val = v[0]
    loop i in 1..v.shape[0] {
        if v[i] > best_val { best_val = v[i]   best_idx = i }
    }
    ret best_idx
}

// =============================================================================
// Dataset builder — character-level
// =============================================================================
fn make_char_dataset(text: ref []i8) -> (tensor, tensor) {
    // Encode: char → token id in [0, VOCAB)
    let n   = text.len - SEQ_LEN - 1
    let X   = tensor [n x SEQ_LEN]i64::zeros()
    let Y   = tensor [n x SEQ_LEN]i64::zeros()
    loop i in 0..n {
        loop t in 0..SEQ_LEN {
            X[i, t] = (text[i + t] - 32) as i64 % VOCAB
            Y[i, t] = (text[i + t + 1] - 32) as i64 % VOCAB
        }
    }
    ret (X, Y)
}

// =============================================================================
// Training loop
// =============================================================================
fn main() {
    // ── Tiny corpus ─────────────────────────────────────────────────────────
    let corpus =
        "the quick brown fox jumps over the lazy dog. " *
        "pack my box with five dozen liquor jugs. " *
        "how vexingly quick daft zebras jump! " *
        "the five boxing wizards jump quickly. "

    let (X, Y) = make_char_dataset(&corpus)
    let n_samples = X.shape[0]

    print(fmt_str("Corpus: {} chars  →  {} training pairs\n",
                  [ArgI64(corpus.len), ArgI64(n_samples)]))

    // ── Model ────────────────────────────────────────────────────────────────
    let model = Transformer::new()
    print(fmt_str("Parameters: d_model={} n_heads={} d_ff={} layers={}\n",
                  [ArgI64(D_MODEL), ArgI64(N_HEADS),
                   ArgI64(D_FF),    ArgI64(N_LAYERS)]))

    // ── Collect all trainable parameter tensors (for Adam) ──────────────────
    let params = collect_params(&model)
    let opt    = Adam::new(lr: LR, beta1: 0.9, beta2: 0.999, eps: 1e-8)

    // ── Training ─────────────────────────────────────────────────────────────
    let rng_state: u64 = 0xBADC0FFEE0DDF00D

    loop step in 0..STEPS {
        // Sample a random batch of size BATCH
        let batch_x = tensor [BATCH x SEQ_LEN]i64::zeros()
        let batch_y = tensor [BATCH x SEQ_LEN]i64::zeros()
        loop b in 0..BATCH {
            rng_state = rng_state ^ (rng_state << 13)
            rng_state = rng_state ^ (rng_state >> 7)
            rng_state = rng_state ^ (rng_state << 17)
            let idx = (rng_state % n_samples as u64) as i64
            batch_x[b, ..] = X[idx, ..]
            batch_y[b, ..] = Y[idx, ..]
        }

        // Forward pass → logits [B x T x VOCAB]
        let logits = model.forward(&batch_x)

        // Compute cross-entropy loss over all T positions
        // Reshape to [B*T x VOCAB] vs [B*T] targets
        let logits_flat = logits.reshape([BATCH * SEQ_LEN, VOCAB])
        let targets_flat = batch_y.reshape([BATCH * SEQ_LEN])
        let loss = cross_entropy_flat(logits_flat, targets_flat)

        // Backward pass (compile-time generated by @differentiable)
        let grads = model_forward_grad(&model, &batch_x, &batch_y)

        // Adam step
        opt.step(params, grads)

        if step % 50 == 0 {
            print(fmt_str("step {:>4}  loss {:.4f}\n",
                          [ArgI64(step), ArgF64(loss as f64)]))
        }
    }

    // ── Inference — generate 64 characters ──────────────────────────────────
    let prompt_str = "the quick"
    let prompt = encode_chars(&prompt_str)
    let generated = model.generate(&prompt, max_new: 64)
    print("\nGenerated: ")
    print_chars(generated)
    print("\n")
}

// =============================================================================
// Helpers
// =============================================================================

fn cross_entropy_flat(logits: tensor, targets: tensor) -> f32 {
    // logits: [N x C]   targets: [N] (class indices)
    let N = logits.shape[0]
    let loss = 0.0f32
    loop i in 0..N {
        let row    = logits[i, ..]
        let mx     = row.max()
        let log_sm = row - mx - (row - mx).exp().sum().log()
        loss = loss - log_sm[targets[i] as i64]
    }
    ret loss / N as f32
}

fn collect_params(m: ref Transformer) -> []ref tensor {
    // Return a flat list of all weight tensors.
    // In a real impl the compiler would generate this via reflection.
    ret [
        &m.embed.tok_emb, &m.embed.pos_emb,
        &m.blocks[0].attn.W_q, &m.blocks[0].attn.W_k,
        &m.blocks[0].attn.W_v, &m.blocks[0].attn.W_o,
        &m.blocks[0].ff.W1, &m.blocks[0].ff.b1,
        &m.blocks[0].ff.W2, &m.blocks[0].ff.b2,
        &m.blocks[0].ln1.gamma, &m.blocks[0].ln1.beta,
        &m.blocks[0].ln2.gamma, &m.blocks[0].ln2.beta,
        &m.blocks[1].attn.W_q, &m.blocks[1].attn.W_k,
        &m.blocks[1].attn.W_v, &m.blocks[1].attn.W_o,
        &m.blocks[1].ff.W1, &m.blocks[1].ff.b1,
        &m.blocks[1].ff.W2, &m.blocks[1].ff.b2,
        &m.blocks[1].ln1.gamma, &m.blocks[1].ln1.beta,
        &m.blocks[1].ln2.gamma, &m.blocks[1].ln2.beta,
        &m.ln_f.gamma, &m.ln_f.beta,
        &m.lm_head,
    ]
}

fn encode_chars(s: ref []i8) -> []i64 {
    let out = [s.len]i64
    loop i in 0..s.len { out[i] = (s[i] - 32) as i64 % VOCAB }
    ret out
}

fn print_chars(tokens: ref []i64) {
    let buf = [256]i8
    loop i in 0..tokens.len {
        buf[i] = (tokens[i] + 32) as i8
    }
    print(buf[0..tokens.len])
}

