// What a language model writes when it guesses at an API: a method borrowed
// from some other language's standard library. Jda has no `.to_string()`.
//
// Before JDA-C005 this compiled clean, ran, and printed 0 -- the failure was
// invisible to the model, to `check --json`, and to the person reading output.
fn main() {
    let n = 42
    let s = n.to_string()
    print("{s}\n")
}
