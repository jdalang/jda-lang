; =============================================================================
; jda::concurrency::channel — Lock-Free Channels
; =============================================================================
; Channels are the ONLY way for J-Threads to share data.
; No shared mutable state means no data races — guaranteed at compile time.
;
; Channel flavours:
;   chan<T>()        — unbuffered (rendezvous — send blocks until recv)
;   chan<T>(N)       — buffered N-capacity (send blocks only when full)
;
; Implementation: MPSC (Multi-Producer Single-Consumer) lock-free ring buffer.
; Uses atomic operations — no mutex, no kernel involvement.
;
; Ownership:
;   send() takes `own T`   — transfers ownership into the channel
;   recv() returns `own T` — transfers ownership out to receiver
;   Zero copy. No cloning.
; =============================================================================

import jda::mem::page_alloc
import jda::concurrency::jthread

const CHAN_DEFAULT_CAP = 64

; =============================================================================
; Channel<T> — internal structure
; =============================================================================
struct Channel<T> {
    buf:    own *T      ; ring buffer (heap allocated)
    cap:    u64         ; buffer capacity (power of 2)
    mask:   u64         ; cap - 1, for fast modulo
    head:   u64         ; atomic — consumer reads from head
    tail:   u64         ; atomic — producers write to tail
    closed: bool        ; atomic flag — true after chan_close()
}

; =============================================================================
; chan<T>() — create an unbuffered channel (capacity = 1)
; chan<T>(N) — create a buffered channel
; =============================================================================
fn chan_new<T>(cap: u64) -> own Channel<T> {
    ; Capacity must be power of 2 for ring buffer mask trick
    let real_cap = next_pow2(cap)
    let buf = pages_alloc((real_cap * size_of<T>() / 4096) + 1) as own *T
    ret Channel<T> {
        buf:    buf,
        cap:    real_cap,
        mask:   real_cap - 1,
        head:   0,
        tail:   0,
        closed: false,
    }
}

; =============================================================================
; send(ch: &Channel<T>, val: own T) — put a value into the channel
; =============================================================================
; Blocks (yields current J-Thread) if buffer is full.
; Returns err if channel is closed.
fn chan_send<T>(ch: &Channel<T>, val: own T) -> Result<(), []i8> {
    if ch.closed { ret err("channel closed") }

    loop {
        let tail = atomic_load(&ch.tail)
        let head = atomic_load(&ch.head)
        let used = tail - head

        if used < ch.cap {
            ; Space available — claim the slot
            if atomic_cmpxchg(&ch.tail, tail, tail + 1) {
                ch.buf[tail & ch.mask] = val   ; write (ownership transferred)
                ret ok(())
            }
            ; Lost the race — retry
        } else {
            ; Buffer full — yield and retry after other threads run
            jthread_yield()
            if ch.closed { ret err("channel closed while waiting") }
        }
    }
}

; =============================================================================
; recv(ch: &Channel<T>) -> own T — take a value from the channel
; =============================================================================
; Blocks (yields) until a value is available.
; Returns err if channel is closed and empty.
fn chan_recv<T>(ch: &Channel<T>) -> Result<own T, []i8> {
    loop {
        let head = atomic_load(&ch.head)
        let tail = atomic_load(&ch.tail)

        if head < tail {
            ; Data available — claim the slot
            if atomic_cmpxchg(&ch.head, head, head + 1) {
                let val = ch.buf[head & ch.mask]   ; read (ownership transferred)
                ret ok(val)
            }
            ; Lost the race — retry
        } else {
            ; Empty
            if ch.closed { ret err("channel closed") }
            jthread_yield()   ; yield and wait for a sender
        }
    }
}

; =============================================================================
; try_recv — non-blocking recv, returns none immediately if empty
; =============================================================================
fn chan_try_recv<T>(ch: &Channel<T>) -> ?own T {
    let head = atomic_load(&ch.head)
    let tail = atomic_load(&ch.tail)
    if head >= tail { ret none }
    if atomic_cmpxchg(&ch.head, head, head + 1) {
        ret some(ch.buf[head & ch.mask])
    }
    ret none
}

; =============================================================================
; close — signal no more sends. Pending recvs drain remaining data.
; =============================================================================
fn chan_close<T>(ch: &Channel<T>) {
    atomic_store(&ch.closed, true)
}

; =============================================================================
; select — wait on multiple channels simultaneously (compiler macro)
; =============================================================================
; Syntax (handled by compiler, desugars to select_raw):
;
;   select {
;       ch1.recv() => |v| { handle_v(v) }
;       ch2.recv() => |v| { handle_v2(v) }
;       ch3.send(val) => { after_send() }
;       timeout(500ms) => { handle_timeout() }
;   }
;
; Implementation: polls each channel in order, yields if none ready.
; Timeout uses the TSC (timestamp counter) to avoid syscall overhead.

fn select_recv2<A, B>(
    ch_a: &Channel<A>, ch_b: &Channel<B>,
    on_a: fn(own A), on_b: fn(own B),
    timeout_ns: i64
) {
    let start = rdtsc()
    let tsc_per_ns = cpu_tsc_hz() / 1_000_000_000

    loop {
        ; Try ch_a
        match chan_try_recv(ch_a) {
            some(v) => { on_a(v)   ret }
            none    => {}
        }
        ; Try ch_b
        match chan_try_recv(ch_b) {
            some(v) => { on_b(v)   ret }
            none    => {}
        }
        ; Check timeout
        if timeout_ns > 0 {
            let elapsed = (rdtsc() - start) / tsc_per_ns
            if elapsed >= timeout_ns as u64 { ret }
        }
        jthread_yield()
    }
}

; =============================================================================
; Helpers
; =============================================================================
fn next_pow2(n: u64) -> u64 {
    if n <= 1 { ret 1 }
    let p = 1u64
    loop p < n { p = p << 1 }
    ret p
}
