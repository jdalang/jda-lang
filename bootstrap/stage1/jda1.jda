        ins.operand2 = arg2
        ins.operand3 = arg3
        ins.bb_target0 = arg4
        ins.bb_target1 = arg5
        ret emit(jfn, bb, &ins)
    }
    if name_len == 10 and streq(src, name_start, 10, "gpu_vecadd") == 1 {
        let ins = Instr{}
        ins.op = OP_GPU_VECADD
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ret emit(jfn, bb, &ins)
    }
    if name_len == 12 and streq(src, name_start, 12, "rocm_has_amd") == 1 {
        let ins = Instr{}
        ins.op = OP_ROCM_CHECK
