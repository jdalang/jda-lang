    if name.str_len == 14 and streq(g_src_buf_ptr, name.str_start, 14, "avx512_dot_f64") == 1 {
        let ins = Instr{}
        ins.op = OP_AVX_DOTF64
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 14 and streq(g_src_buf_ptr, name.str_start, 14, "gpu_has_nvidia") == 1 {
        let ins = Instr{}
        ins.op = OP_GPU_CHECK
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "gpu_matmul") == 1 {
        let ins = Instr{}
        ins.op = OP_GPU_MATMUL
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ins.bb_target0 = arg4
        ins.bb_target1 = arg5
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "gpu_vecadd") == 1 {
        let ins = Instr{}
        ins.op = OP_GPU_VECADD
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 12 and streq(g_src_buf_ptr, name.str_start, 12, "rocm_has_amd") == 1 {
        let ins = Instr{}
        ins.op = OP_ROCM_CHECK
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "rocm_matmul") == 1 {
        let ins = Instr{}
        ins.op = OP_ROCM_MATMUL
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ins.bb_target0 = arg4
        ins.bb_target1 = arg5
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "rocm_vecadd") == 1 {
        let ins = Instr{}
        ins.op = OP_ROCM_VECADD
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ret emit(g_jfn, bb, &ins)
    }

    g_codegen_stype = 0
    let ins = Instr{}
    ins.op        = OP_CALL
    ins.operand0  = arg0
    ins.operand1  = arg1
    ins.operand2  = arg2
    ins.operand3  = arg_cnt
    ins.bb_target0 = arg3
    ins.bb_target1 = arg4
    ins.imm        = arg5
    ins.str_start = name.str_start
    ins.str_len   = name.str_len
    ret emit(g_jfn, bb, &ins)
}


fn legacy_compile_stmts_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let cur = bb
    loop toks[pos[0]].type != TOK_RBRACE and toks[pos[0]].type != TOK_EOF {
        let pos_save = pos[0]
        if toks[pos[0]].type == TOK_IF {
            cur = legacy_compile_if_inline(toks, pos, stab, src, jfn, cur)
        } else {
            if toks[pos[0]].type == TOK_LOOP {
                cur = legacy_compile_loop_inline(toks, pos, stab, src, jfn, cur)
            } else {
                let st = Node{}
                let st_t = toks[pos[0]].type
                if st_t == TOK_LET {
                    st = parse_let(toks, pos, stab, src)
                } else if st_t == TOK_IF {
                    st = parse_if(toks, pos, stab, src)
                } else if st_t == TOK_LOOP {
                    st = parse_loop(toks, pos, stab, src)
                } else if st_t == TOK_RET {
                    expect(TOK_RET)
                    st.node_type = NODE_RET
                    let rt = tok_type_at_raw(toks, pos[0])
                    if rt == TOK_RBRACE or rt == TOK_EOF {
                        st.op = 4
                        st.imm = 0
                    } else {
                        let rval = parse_expr(toks, pos, stab, src)
                        st.child0 = rval
                    }
                } else if st_t == TOK_PRINT {
                    st = parse_
                } else {
                    st = parse_expr_stmt(toks, pos, stab, src)
                }
                if pos[0] == pos_save {
                    if toks[pos[0]].type == TOK_LBRACE {
                        pos[0] = pos[0] + 1
                        let bd = 1
                        loop bd > 0 and toks[pos[0]].type != TOK_EOF {
                            if toks[pos[0]].type == TOK_LBRACE { bd = bd + 1 }
                            if toks[pos[0]].type == TOK_RBRACE { bd = bd - 1 }
                            pos[0] = pos[0] + 1
                        }
                    } else {
                        pos[0] = pos[0] + 1
                    }
                } else {
                    cur = codegen_stmt(st, jfn, cur)
                }
            }
        }
    }
    ret cur
}

fn legacy_compile_if_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(TOK_IF)
    let then_bb  = create_block_live(jfn)
    let else_bb  = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    let cond_id  = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    emit_br(jfn, bb, cond_id, then_bb, else_bb)
    expect(TOK_LBRACE)
    let then_end = legacy_compile_stmts_inline(toks, pos, stab, src, jfn, then_bb)
    expect(TOK_RBRACE)
    emit_jmp(jfn, then_end, merge_bb)
    // Handle else / else-if chain
    if toks[pos[0]].type == TOK_ELSE {
        pos[0] = pos[0] + 1
        if toks[pos[0]].type == TOK_IF {
            // else-if: recursively compile
            let else_end = legacy_compile_if_inline(toks, pos, stab, src, jfn, else_bb)
            emit_jmp(jfn, else_end, merge_bb)
        } else {
            // plain else block
            expect(TOK_LBRACE)
            let else_end = legacy_compile_stmts_inline(toks, pos, stab, src, jfn, else_bb)
            expect(TOK_RBRACE)
            emit_jmp(jfn, else_end, merge_bb)
        }
    } else {
        emit_jmp(jfn, else_bb, merge_bb)
    }
    ret merge_bb
}

fn legacy_compile_loop_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(TOK_LOOP)
    let header_bb = create_block_live(jfn)
    let body_bb   = create_block_live(jfn)
    let exit_bb   = create_block_live(jfn)
    emit_jmp(jfn, bb, header_bb)
    let cond_id = codegen_expr_inline(toks, pos, stab, src, jfn, header_bb)
    emit_br(jfn, header_bb, cond_id, body_bb, exit_bb)
    expect(TOK_LBRACE)
    let body_end = legacy_compile_stmts_inline(toks, pos, stab, src, jfn, body_bb)
    expect(TOK_RBRACE)
    emit_jmp(jfn, body_end, header_bb)
    ret exit_bb
}

fn codegen_if(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let then_bb  = create_block_live(jfn)
    let else_bb  = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    if node.child0 != 0 {
        let cond_id  = codegen_expr(node.child0, jfn, bb)
        emit_br(jfn, bb, cond_id, then_bb, else_bb)
        emit_jmp(jfn, then_bb, merge_bb)
        emit_jmp(jfn, else_bb, merge_bb)
    } else {
        // Block bodies are skipped during parsing, so child0 is not set.
        // Just jump straight to merge if no condition.
        emit_jmp(jfn, bb, merge_bb)
    }
    ret merge_bb
}

fn codegen_loop(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let header_bb = create_block_live(jfn)
    let body_bb   = create_block_live(jfn)
    let exit_bb   = create_block_live(jfn)
    emit_jmp(jfn, bb, header_bb)
    if node.child0 != 0 {
        let cond_id = codegen_expr(node.child0, jfn, header_bb)
        emit_br(jfn, header_bb, cond_id, body_bb, exit_bb)
    } else {
        // Block bodies are skipped during parsing, so child0 is not set.
        // Create a dummy always-true condition.
        let dummy_cond = emit_const(jfn, header_bb, TYPE_I64, 1)
        emit_br(jfn, header_bb, dummy_cond, body_bb, exit_bb)
    }
    emit_jmp(jfn, body_bb, header_bb)
    ret exit_bb
}

fn codegen_syscall(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let nr   = codegen_expr(node.child0, jfn, bb)
    let arg0 = codegen_expr(node.child1, jfn, bb)
    let arg1 = codegen_expr(node.child2, jfn, bb)
    let arg2 = codegen_expr(node.child3, jfn, bb)
    ret emit_syscall_raw(jfn, bb, nr, arg0, arg1, arg2)
}

fn tok_to_jir_op(tok: i32) -> i32 {
    if tok == TOK_PLUS  { ret OP_ADD }
    if tok == TOK_MINUS { ret OP_SUB }
    if tok == TOK_STAR  { ret OP_MUL }
    if tok == TOK_SLASH { ret OP_DIV }
    if tok == TOK_PERCENT { ret OP_MOD }
    if tok == TOK_EQEQ  { ret OP_CMP_EQ }
    if tok == TOK_NEQ   { ret OP_CMP_NE }
    if tok == TOK_LT    { ret OP_CMP_LT }
    if tok == TOK_GT    { ret OP_CMP_GT }
    if tok == TOK_LTE   { ret OP_CMP_LTE }
    if tok == TOK_GTE   { ret OP_CMP_GTE }
    if tok == TOK_AND or tok == TOK_AMP { ret OP_AND }  // Both logical and bitwise AND
    if tok == TOK_OR or tok == TOK_PIPE { ret OP_OR }  // Both logical and bitwise OR
    if tok == TOK_TILDE { ret OP_AND }  // Bitwise NOT - temporary: use AND (will be fixed later)
    if tok == TOK_SHR { ret OP_SHR }
    if tok == TOK_SHL { ret OP_SHL }
    ret -1
}

fn tok_to_jir_op_f64(tok: i32) -> i32 {
    if tok == TOK_PLUS  { ret OP_FADD }
    if tok == TOK_MINUS { ret OP_FSUB }
    if tok == TOK_STAR  { ret OP_FMUL }
    if tok == TOK_SLASH { ret OP_FDIV }
    if tok == TOK_LT    { ret OP_FCMP_LT }
    if tok == TOK_GT    { ret OP_FCMP_GT }
    if tok == TOK_EQEQ  { ret OP_FCMP_EQ }
    ret tok_to_jir_op(tok)
}

// ============================================================
// 7. OPTIMISATION PASSES
// ============================================================

fn find_const(jfn: &JirFunction, val_id: i64) -> ConstVal {
    if val_id < 0 {
        let cv = ConstVal{}
        cv.found = 0
        ret cv
    }
    if val_id >= jfn.next_id {
        let cv = ConstVal{}
        cv.found = 0
        ret cv
    }
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let iid = jfn.blocks[bi].instrs[ii].id
            let iop = jfn.blocks[bi].instrs[ii].op
            if iid == val_id and iop == OP_CONST {
                let cv = ConstVal{}
                cv.found = 1
                cv.val   = jfn.blocks[bi].instrs[ii].imm
                ret cv
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    let cv = ConstVal{}
    cv.found = 0
    ret cv
}

fn fold_constants(jfn: &JirFunction) {
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let iop = jfn.blocks[bi].instrs[ii].op
            if iop == OP_ADD or iop == OP_SUB or
               iop == OP_MUL or iop == OP_DIV or iop == OP_MOD or
               iop == OP_SHR or iop == OP_SHL {
                let ca = find_const(jfn, jfn.blocks[bi].instrs[ii].operand0)
                let cb = find_const(jfn, jfn.blocks[bi].instrs[ii].operand1)
                if ca.found == 1 and cb.found == 1 {
                    let result = 0
                    if iop == OP_ADD { result = ca.val + cb.val }
                    if iop == OP_SUB { result = ca.val - cb.val }
                    if iop == OP_MUL { result = ca.val * cb.val }
                    if iop == OP_DIV and cb.val != 0 {
                        result = ca.val / cb.val
                    }
                    if iop == OP_MOD and cb.val != 0 {
                        let q = ca.val / cb.val
                        result = ca.val - q * cb.val
                    }
                    if iop == OP_SHR { result = ca.val >> cb.val }
                    if iop == OP_SHL { result = ca.val << cb.val }
                    instr_set_op(&jfn.blocks[bi].instrs[ii], OP_CONST)
                    instr_set_imm(&jfn.blocks[bi].instrs[ii], result)
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn dce_mark_float(op: i64, o0: i64, o1: i64, used: &i32) {
    if op == OP_I2F or op == OP_F2I or op == OP_FNEG or op == OP_FSQRT or op == OP_PRINT_FLOAT {
        if o0 >= 0 { used[o0] = 1 }
    }
    if op == OP_FABS or op == OP_FEXP or op == OP_FLOG or op == OP_FSIN or op == OP_FCOS or op == OP_FTANH {
        if o0 >= 0 { used[o0] = 1 }
    }
    if op == OP_FADD or op == OP_FSUB or op == OP_FMUL or op == OP_FDIV {
        if o0 >= 0 { used[o0] = 1 }
        if o1 >= 0 { used[o1] = 1 }
    }
    if op == OP_FCMP_LT or op == OP_FCMP_GT or op == OP_FCMP_EQ or op == OP_FPOW {
        if o0 >= 0 { used[o0] = 1 }
        if o1 >= 0 { used[o1] = 1 }
    }
    if op == OP_TNEW1 or op == OP_TLEN or op == OP_TDATA or op == OP_TFREE {
        if o0 >= 0 { used[o0] = 1 }
    }
    if op == OP_TNEW2 or op == OP_TGET or op == OP_TFILL or op == OP_TSHAPE or op == OP_TSET {
        if o0 >= 0 { used[o0] = 1 }
        if o1 >= 0 { used[o1] = 1 }
    }
}

fn dce_mark_syscall_extra(jfn: &JirFunction, bi: i64, ii: i64, used: &i32) {
    let bt1 = jfn.blocks[bi].instrs[ii].bb_target1
    let imm0 = jfn.blocks[bi].instrs[ii].imm
    if bt1 >= 0 { used[bt1] = 1 }
    if imm0 >= 0 { used[imm0] = 1 }
}

fn dce(jfn: &JirFunction) {
    let used = i32[8192]
    let bi = 0
    // Mark all consumed operands and side-effecting ops
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            // Access fields directly - do NOT copy Instr by value
            let o0 = jfn.blocks[bi].instrs[ii].operand0
            let o1 = jfn.blocks[bi].instrs[ii].operand1
            let o2 = jfn.blocks[bi].instrs[ii].operand2
            let o3 = jfn.blocks[bi].instrs[ii].operand3
            let bt0 = jfn.blocks[bi].instrs[ii].bb_target0
            let bt1 = jfn.blocks[bi].instrs[ii].bb_target1
            let imm0 = jfn.blocks[bi].instrs[ii].imm
            let op = jfn.blocks[bi].instrs[ii].op
            let id = jfn.blocks[bi].instrs[ii].id
            if op == OP_ADD or op == OP_SUB or op == OP_MUL or op == OP_DIV or op == OP_MOD or
               op == OP_CMP_EQ or op == OP_CMP_NE or op == OP_CMP_LT or op == OP_CMP_GT or
               op == OP_CMP_LTE or op == OP_CMP_GTE or op == OP_AND or op == OP_OR or
               op == OP_SHR or op == OP_SHL {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
            }
            if op == OP_RET or op == OP_BR or op == OP_STRLEN or op == OP_PRINT_INT {
                if o0 >= 0 { used[o0] = 1 }
            }
            if op == OP_STORE {
                if o0 >= 0 { used[o0] = 1 }
            }
            if op == OP_LOAD_MEM {
                if o0 >= 0 { used[o0] = 1 }
            }
            if op == OP_STORE_MEM {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
            }
            if op == OP_SYSCALL or op == OP_EPOLL_CTL or op == OP_EPOLL_WAIT {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
                if o2 >= 0 { used[o2] = 1 }
                if bt0 >= 0 { used[bt0] = 1 }
            }
            if op == OP_SYSCALL { dce_mark_syscall_extra(jfn, bi, ii, used) }
            if op == OP_ALLOC {
                if o0 >= 0 { used[o0] = 1 }
            }
            if op == OP_DROP {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
            }
            if op == OP_ATOMIC_LOAD or op == OP_CHAN_NEW or op == OP_CHAN_RECV or op == OP_CHAN_CLOSE or op == OP_GET_NPROCS or op == OP_GET_TID or op == OP_EPOLL_CREATE {
                if o0 >= 0 { used[o0] = 1 }
            }
            dce_mark_float(op, o0, o1, used)
            if op == OP_ATOMIC_STORE {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
            }
            if op == OP_ATOMIC_CAS or op == OP_DEADLOCK_CHK or op == OP_TSET {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
                if o2 >= 0 { used[o2] = 1 }
            }
            if op == OP_ATOMIC_ADD or op == OP_CTX_SWITCH or op == OP_CHAN_SEND or op == OP_CLONE_THREAD or op == OP_FUTEX_WAIT or op == OP_FUTEX_WAKE {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
            }
            if op == OP_CALL or op == OP_CALL_IND {
                if o3 >= 1 { if o0 >= 0 { used[o0] = 1 } }
                if o3 >= 2 { if o1 >= 0 { used[o1] = 1 } }
                if o3 >= 3 { if o2 >= 0 { used[o2] = 1 } }
                if o3 >= 4 { if bt0 >= 0 { used[bt0] = 1 } }
                if o3 >= 5 { if bt1 >= 0 { used[bt1] = 1 } }
                if o3 >= 6 { if imm0 >= 0 { used[imm0] = 1 } }
            }
            if op == OP_TAIL_CALL {
                if o3 >= 1 { if o0 >= 0 { used[o0] = 1 } }
                if o3 >= 2 { if o1 >= 0 { used[o1] = 1 } }
                if o3 >= 3 { if o2 >= 0 { used[o2] = 1 } }
                if o3 >= 4 { if bt0 >= 0 { used[bt0] = 1 } }
                if o3 >= 5 { if bt1 >= 0 { used[bt1] = 1 } }
                if o3 >= 6 { if imm0 >= 0 { used[imm0] = 1 } }
            }
            if op == OP_RET     { used[id] = 1 }
            if op == OP_BR      { used[id] = 1 }
            if op == OP_JMP     { used[id] = 1 }
            if op == OP_SYSCALL { used[id] = 1 }
            if op == OP_ALLOC   { used[id] = 1 }
            if op == OP_DROP    { used[id] = 1 }
            if op == OP_CALL or op == OP_CALL_IND { used[id] = 1 }
            if op == OP_TAIL_CALL { used[id] = 1 }
            if op == OP_STORE   { used[id] = 1 }
            if op == OP_PRINT_INT { used[id] = 1 }
            if op == OP_ARGV_BASE { used[id] = 1 }
            if op == OP_ARGC_GET  { used[id] = 1 }
            if op == OP_STORE_MEM { used[id] = 1 }
            if op == OP_ATOMIC_LOAD  { used[id] = 1 }
            if op == OP_ATOMIC_STORE { used[id] = 1 }
            if op == OP_ATOMIC_CAS   { used[id] = 1 }
            if op == OP_ATOMIC_ADD   { used[id] = 1 }
            if op == OP_RDTSC or op == OP_CTX_SWITCH or op == OP_CHAN_NEW or op == OP_CHAN_SEND or op == OP_CHAN_RECV or op == OP_CHAN_CLOSE or op == OP_GET_NPROCS or op == OP_CLONE_THREAD or op == OP_FUTEX_WAIT or op == OP_FUTEX_WAKE or op == OP_GET_TID or op == OP_EPOLL_CREATE or op == OP_EPOLL_CTL or op == OP_EPOLL_WAIT or op == OP_DEADLOCK_CHK { used[id] = 1 }
            if op == OP_PRINT_FLOAT or op == OP_TNEW1 or op == OP_TNEW2 or op == OP_TFREE or op == OP_TSET or op == OP_TFILL { used[id] = 1 }
            ii = ii + 1
        }
        bi = bi + 1
    }
    // Mark unused instructions dead
    bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let id2 = jfn.blocks[bi].instrs[ii].id
            if used[id2] == 0 {
                instr_set_dead(&jfn.blocks[bi].instrs[ii], 1)
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

// ============================================================
// 7b. TAIL CALL OPTIMIZATION
// ============================================================
// Detects self-recursive tail calls: OP_CALL to current function
// followed by OP_RET returning the call's result.
// Transforms to OP_TAIL_CALL and marks the OP_RET dead.

fn tail_call_opt(jfn: &JirFunction) {
    let src = g_src_buf_ptr
    let fn_ns = g_cur_fn_name_start
    let fn_nl = g_cur_fn_name_len
    let bi = 0
    loop bi < jfn.block_cnt {
        let icnt = jfn.blocks[bi].instr_cnt
        // Find last two non-dead instructions in this block
        let last_ret = -1
        let last_call = -1
        let ii = icnt - 1
        loop ii >= 0 {
            if jfn.blocks[bi].instrs[ii].dead == 0 {
                if last_ret == -1 {
                    last_ret = ii
                } else {
                    if last_call == -1 {
                        last_call = ii
                    }
                }
            }
            if last_call >= 0 { ii = 0 }
            ii = ii - 1
        }
        if last_call >= 0 {
            if last_ret >= 0 {
                let ri = &jfn.blocks[bi].instrs[last_ret]
                let ci = &jfn.blocks[bi].instrs[last_call]
                if ri.op == OP_RET {
                    if ci.op == OP_CALL {
                        if ri.operand0 == ci.id {
                            // Check if call targets current function
                            if ci.str_len == fn_nl {
                                if streq(src, ci.str_start, fn_nl, src + fn_ns) == 1 {
                                    ci.op = OP_TAIL_CALL
                                    instr_set_dead(ri, 1)
                                }
                            }
                        }
                    }
                }
            }
        }
        bi = bi + 1
    }
}

// ============================================================
// 7c. PEEPHOLE OPTIMIZATION
// ============================================================
// Strength reduction: MUL/DIV by power-of-2 → SHL/SHR
// Runs after tail_call_opt, before lowering.

fn log2_of_pow2(v: i64) -> i64 {
    if v == 2 { ret 1 }
    if v == 4 { ret 2 }
    if v == 8 { ret 3 }
    if v == 16 { ret 4 }
    if v == 32 { ret 5 }
    if v == 64 { ret 6 }
    if v == 128 { ret 7 }
    if v == 256 { ret 8 }
    if v == 512 { ret 9 }
    if v == 1024 { ret 10 }
    if v == 2048 { ret 11 }
    if v == 4096 { ret 12 }
    if v == 8192 { ret 13 }
    if v == 16384 { ret 14 }
    if v == 32768 { ret 15 }
    if v == 65536 { ret 16 }
    ret -1
}

fn set_const_imm(jfn: &JirFunction, val_id: i64, new_imm: i64) {
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            if jfn.blocks[bi].instrs[ii].id == val_id {
                if jfn.blocks[bi].instrs[ii].op == OP_CONST {
                    jfn.blocks[bi].instrs[ii].imm = new_imm
                    ret ok(0)
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn peephole(jfn: &JirFunction) {
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let iop = jfn.blocks[bi].instrs[ii].op
            // Strength reduction: MUL by power-of-2 → SHL
            if iop == OP_MUL {
                let cv = find_const(jfn, jfn.blocks[bi].instrs[ii].operand1)
                if cv.found == 1 {
                    let lg = log2_of_pow2(cv.val)
                    if lg >= 1 {
                        jfn.blocks[bi].instrs[ii].op = OP_SHL
                        set_const_imm(jfn, jfn.blocks[bi].instrs[ii].operand1, lg)
                    }
                }
            }
            // Strength reduction: DIV by power-of-2 → SHR
            if iop == OP_DIV {
                let cv = find_const(jfn, jfn.blocks[bi].instrs[ii].operand1)
                if cv.found == 1 {
                    let lg = log2_of_pow2(cv.val)
                    if lg >= 1 {
                        jfn.blocks[bi].instrs[ii].op = OP_SHR
                        set_const_imm(jfn, jfn.blocks[bi].instrs[ii].operand1, lg)
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn loop_promote_scan(jfn: &JirFunction) {
    // Reset promotion state
    g_promo_cnt = 0
    g_promo_slot0 = -1
    g_promo_slot1 = -1
    g_promo_slot2 = -1
    g_promo_header = -1
    g_promo_exit = -1
    g_cand_cnt = 0
    // Find innermost loop: a JMP whose target is an earlier block (back-edge)
    let best_header = -1
    let best_body_end = -1
    let best_exit = -1
    let bi = 0
    loop bi < jfn.block_cnt {
        let ic = jfn.blocks[bi].instr_cnt
        if ic > 0 {
            let last_op = jfn.blocks[bi].instrs[ic - 1].op
            if last_op == OP_JMP {
                let tgt = jfn.blocks[bi].instrs[ic - 1].bb_target0
                if tgt >= 0 and tgt < bi {
                    if tgt > best_header {
                        best_header = tgt
                        best_body_end = bi
                    }
                }
            }
        }
        bi = bi + 1
    }
    if best_header == -1 { ret ok(0) }
    // Find exit block from header's BR instruction
    let hic = jfn.blocks[best_header].instr_cnt
    let hi = 0
    loop hi < hic {
        let hop = jfn.blocks[best_header].instrs[hi].op
        if hop == OP_BR {
            best_exit = jfn.blocks[best_header].instrs[hi].bb_target1
        }
        hi = hi + 1
    }
    if best_exit == -1 { ret ok(0) }
    // Collect slots that are LOADed and STOREd in the loop (header..body_end)
    // Use global arrays to avoid local array indexing issues
    let lb = best_header
    loop lb <= best_body_end {
        let li = 0
        loop li < jfn.blocks[lb].instr_cnt {
            let lop = jfn.blocks[lb].instrs[li].op
            let lslot = -1
            let is_ld = 0
            let is_st = 0
            if lop == OP_LOAD {
                lslot = jfn.blocks[lb].instrs[li].operand0
                is_ld = 1
            }
            if lop == OP_STORE {
                lslot = jfn.blocks[lb].instrs[li].operand1
                is_st = 1
            }
            if lslot > 0 {
                if is_ld == 1 or is_st == 1 {
                    // Find or add slot to candidates using global arrays
                    let ci = 0
                    let found = 0
                    loop ci < g_cand_cnt {
                        if g_cand_slots[ci] == lslot {
                            if is_ld == 1 { g_cand_load[ci] = 1 }
                            if is_st == 1 { g_cand_store[ci] = 1 }
                            found = 1
                        }
                        ci = ci + 1
                    }
                    if found == 0 and g_cand_cnt < 8 {
                        let cc = g_cand_cnt
                        g_cand_slots[cc] = lslot
                        g_cand_load[cc] = is_ld
                        g_cand_store[cc] = is_st
                        g_cand_cnt = cc + 1
                    }
                }
            }
            li = li + 1
        }
        lb = lb + 1
    }
    // Check for CALL instructions in loop (disqualifies promotion)
    let has_call = 0
    lb = best_header
    loop lb <= best_body_end {
        let li = 0
        loop li < jfn.blocks[lb].instr_cnt {
            let lop = jfn.blocks[lb].instrs[li].op
            if lop == OP_CALL or lop == OP_CALL_IND { has_call = 1 }
            if lop == OP_SYSCALL { has_call = 1 }
            if lop == OP_PRINT_INT or lop == OP_PRINT_FLOAT { has_call = 1 }
            if lop == OP_ALLOC { has_call = 1 }
            li = li + 1
        }
        lb = lb + 1
    }
    if has_call == 1 { ret ok(0) }
    // Only promote simple loops (header + 1 body block)
    let loop_span = best_body_end - best_header
    if loop_span != 1 { ret ok(0) }
    // Select slots that are both loaded AND stored (up to 3, for R13/R14/R15)
    let pi = 0
    let ci = 0
    loop ci < g_cand_cnt {
        if g_cand_load[ci] == 1 and g_cand_store[ci] == 1 {
            if pi == 0 { g_promo_slot0 = g_cand_slots[ci] }
            if pi == 1 { g_promo_slot1 = g_cand_slots[ci] }
            if pi == 2 { g_promo_slot2 = g_cand_slots[ci] }
            pi = pi + 1
        }
        ci = ci + 1
    }
    g_promo_cnt = pi
    g_promo_header = best_header
    g_promo_body_end = best_body_end
    g_promo_exit = best_exit
}

fn promo_reg_for_slot(slot: i64) -> i32 {
    if slot == g_promo_slot0 { ret PHYS_R13 }
    if slot == g_promo_slot1 { ret PHYS_R14 }
    if slot == g_promo_slot2 { ret PHYS_R15 }
    ret -1
}

// ============================================================
// 8. GREEDY REGISTER ALLOCATOR
// ============================================================
// Pool: rax rcx rdx rbx rsi rdi r10 r11

fn regalloc_init(ra: &RegAlloc) {
    let i = 0
    loop i < N_ALLOC_REGS {
        ra.reg2val[i] = -1
        i = i + 1
    }
    // Fill val2reg[8192] with -1 (0xFF bytes for i32)
    let ra_bytes = ra as &i8
    fill_bytes(ra_bytes + 64, 32768, 255)
    // Fill spill_off[8192] with -1
    fill_i64_words((ra_bytes + 32960) as &i64, 8192, -1)
    // Spill slots start past callee-saved registers (RBX, R13, R14, R15 = 32 bytes).
    // sp_top is set to jfn.next_slot_off before lowering, so spills start after locals.
    ra.sp_top = 32
    ra.evict_idx = 0
}

fn fill_bytes(buf: &i8, len: i64, val: i8) {
    let i = 0
    loop i < len {
        buf[i] = val
        i = i + 1
    }
}

fn fill_i64_words(buf: &i64, count: i64, val: i64) {
    let i = 0
    loop i < count {
        buf[i] = val
        i = i + 1
    }
}

fn load_param_slot_at(jfn: &JirFunction, idx: i64) -> i64 {
    ret jfn.param_slots[idx]
}

fn reg_pool_at(idx: i64) -> i32 {
    let tbl = i32[13]
    tbl[0] = PHYS_RAX
    tbl[1] = PHYS_RCX
    tbl[2] = PHYS_RDX
    tbl[3] = PHYS_RSI
    tbl[4] = PHYS_RDI
    tbl[5] = PHYS_R8
    tbl[6] = PHYS_R9
    tbl[7] = PHYS_RBX
    tbl[8] = PHYS_R10
    tbl[9] = PHYS_R11
    tbl[10] = PHYS_R13
    tbl[11] = PHYS_R14
    tbl[12] = PHYS_R15
    let in_range = 1
    if idx < 0 { in_range = 0 }
    if idx >= 13 { in_range = 0 }
    if in_range != 1 { ret PHYS_RAX }
    ret tbl[idx]
}

fn regalloc_alloc(ra: &RegAlloc, out: &i8, pos: &i64, val_id: i64) -> i32 {
    let valid = 1
    if val_id < 0 { valid = 0 }
    if val_id >= 8192 { valid = 0 }
    if valid != 1 { ret reg_pool_at(0) }
    let i = 0
    loop i < N_ALLOC_REGS {
        if ra.reg2val[i] == -1 {
            ra.reg2val[i] = val_id
            ra.val2reg[val_id] = i
            ret reg_pool_at(i)
        }
        i = i + 1
    }
    // Round-robin eviction
    let ei = ra.evict_idx
    if ei >= N_ALLOC_REGS { ei = 0 }
    let victim = ra.reg2val[ei]
    let spill_reg = reg_pool_at(ei)
    ra.evict_idx = ei + 1
    if victim < 0 { ret spill_reg }
    if victim >= 8192 { ret spill_reg }
    let next_sp = ra.sp_top + 8
    ra.sp_top = next_sp
    ra.spill_off[victim]  = next_sp
    emit_store_spill(out, pos, next_sp, spill_reg)
    ra.val2reg[victim]    = -1
    ra.reg2val[ei]        = val_id
    ra.val2reg[val_id]    = ei
    ret spill_reg
}

fn regalloc_get(ra: &RegAlloc, val_id: i64) -> i32 {
    let valid = 1
    if val_id < 0 { valid = 0 }
    if val_id >= 8192 { valid = 0 }
    if valid != 1 { ret -1 }
    let idx = ra.val2reg[val_id]
    let idx_ok = 1
    if idx == -1 { idx_ok = 0 }
    if idx < 0 { idx_ok = 0 }
    if idx >= N_ALLOC_REGS { idx_ok = 0 }
    if idx_ok != 1 { ret -1 }
    ret reg_pool_at(idx)
}

fn regalloc_free(ra: &RegAlloc, val_id: i64) {
    let valid = 1
    if val_id < 0 { valid = 0 }
    if val_id >= 8192 { valid = 0 }
    if valid != 1 { ret ok(0) }
    let idx = ra.val2reg[val_id]
    let idx_ok = 1
    if idx == -1 { idx_ok = 0 }
    if idx < 0 { idx_ok = 0 }
    if idx >= N_ALLOC_REGS { idx_ok = 0 }
    if idx_ok != 1 { ret ok(0) }
    
    ra.reg2val[idx]    = -1
    ra.val2reg[val_id] = -1
}

fn mark_use(ctx: &LowerCtx, val_id: i64) {
    let valid = 1
    if val_id < 0 { valid = 0 }
    if val_id >= 8192 { valid = 0 }
    if valid != 1 { ret ok(0) }
    let cur = ctx.use_cnt[val_id]
    ctx.use_cnt[val_id] = cur + 1
}

fn consume_use(ctx: &LowerCtx, val_id: i64) {
    let valid = 1
    if val_id < 0 { valid = 0 }
    if val_id >= 8192 { valid = 0 }
    if valid != 1 { ret ok(0) }
    let cur = ctx.use_cnt[val_id]
    let next = cur - 1
    ctx.use_cnt[val_id] = next
    if next <= 0 {
        regalloc_free(ctx.ra, val_id)
    }
}

// ============================================================
// 9. X86-64 EMISSION HELPERS
// ============================================================

fn emit_byte(out: &i8, pos: &i64, b: i8) {
    let p = pos[0]
    let in_range = 1
    if p < 0 { in_range = 0 }
    if p >= 16777216 { in_range = 0 }
    if in_range != 1 { panic("emit byte overflow") }
    out[p] = b
    pos[0] = p + 1
}

fn poke_byte(buf: &i8, off: i64, val: i8) {
    buf[off] = val
}


fn emit_i16_le(out: &i8, pos: &i64, val: i64) {
    let v = val
    if v < 0 { v = v + 65536 }
    let b0 = mod256(v)
    let v1 = (v - b0) / 256
    let b1 = mod256(v1)
    emit_byte(out, pos, b0)
    emit_byte(out, pos, b1)
}
fn emit_i32_le(out: &i8, pos: &i64, val: i64) {
    let v = val
    if v < 0 { v = v + 4294967296 }
    let b0 = mod256(v)
    let v1 = (v - b0) / 256
    let b1 = mod256(v1)
    let v2 = (v1 - b1) / 256
    let b2 = mod256(v2)
    let v3 = (v2 - b2) / 256
    let b3 = mod256(v3)
    emit_byte(out, pos, b0)
    emit_byte(out, pos, b1)
    emit_byte(out, pos, b2)
    emit_byte(out, pos, b3)
}

fn emit_i64_le(out: &i8, pos: &i64, val: i64) {
    let i = 0
    loop i < 8 {
        let b = mod256(val)
        if b < 0 { b = b + 256 }
        emit_byte(out, pos, b)
        val = (val - b) / 256
        i = i + 1
    }
}

// REX prefix: 0100WRXB
fn rex_byte(w: i32, r: i32, x: i32, b: i32) -> i8 {
    let val = 64
    if w == 1 { val = val + 8 }
    if r == 1 { val = val + 4 }
    if x == 1 { val = val + 2 }
    if b == 1 { val = val + 1 }
    ret val
}

// ModRM byte for reg-reg: mod=11
fn modrm_rr(reg: i32, rm: i32) -> i8 {
    ret 0xC0 + (mod8(reg)) * 8 + (mod8(rm))
}

// Emit REX.W for two registers (sets R if reg>=8, B if rm>=8)
fn emit_rex_w_rr(out: &i8, pos: &i64, reg: i32, rm: i32) {
    let r = 0
    let b = 0
    if reg >= 8 { r = 1 }
    if rm  >= 8 { b = 1 }
    let rex_val = 72 + r * 4 + b
    emit_byte(out, pos, rex_val)
}

// MOV r64, r/m64 (copy rm -> reg):  REX.W 8B /r
fn emit_mov_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, dst, src)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, modrm_rr(dst, src))
}

// MOV r64, imm64:  REX.W B8+rd imm64
fn emit_mov_imm64(out: &i8, pos: &i64, dst: i32, imm: i64) {
    // Optimization: use 32-bit MOV for small non-negative constants (5-6 bytes vs 10)
    if imm >= 0 and imm < 2147483648 {
        if dst >= 8 {
            emit_byte(out, pos, 0x41)
        }
        emit_byte(out, pos, 0xB8 + (mod8(dst)))
        emit_i32_le(out, pos, imm)
        ret ok(0)
    }
    let b = 0
    if dst >= 8 { b = 1 }
    emit_byte(out, pos, 72 + b)
    emit_byte(out, pos, 0xB8 + (mod8(dst)))
    emit_i64_le(out, pos, imm)
}

// ADD r/m64, r64:  REX.W 01 /r
fn emit_add_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x01)
    emit_byte(out, pos, modrm_rr(src, dst))
}

// ADD r/m64, imm32:  REX.W 81 /0 id
// ADD r/m64, imm8: REX.W 83 /0 ib
fn emit_add_imm8(out: &i8, pos: &i64, dst: i32, imm: i64) {
    let b = 0
    if dst >= 8 { b = 1 }
    emit_byte(out, pos, 0x48 + b)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC0 + mod8(dst))
    emit_byte(out, pos, mod256(imm))
}

fn emit_add_imm32(out: &i8, pos: &i64, dst: i32, imm: i64) {
    let b = 0
    if dst >= 8 { b = 1 }
    emit_byte(out, pos, 0x48 + b)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xC0 + mod8(dst))
    emit_i32_le(out, pos, imm)
}

// SUB r/m64, imm32:  REX.W 81 /5 id
fn emit_sub_imm32(out: &i8, pos: &i64, dst: i32, imm: i64) {
    let b = 0
    if dst >= 8 { b = 1 }
    emit_byte(out, pos, 0x48 + b)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xE8 + mod8(dst))
    emit_i32_le(out, pos, imm)
}

// CMP r/m64, imm32:  REX.W 81 /7 id
fn emit_cmp_imm32(out: &i8, pos: &i64, reg: i32, imm: i64) {
    let b = 0
    if reg >= 8 { b = 1 }
    emit_byte(out, pos, 0x48 + b)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xF8 + mod8(reg))
    emit_i32_le(out, pos, imm)
}

// SUB r/m64, r64:  REX.W 29 /r
fn emit_sub_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x29)
    emit_byte(out, pos, modrm_rr(src, dst))
}

// AND r/m64, r64:  REX.W 21 /r
fn emit_and_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x21)
    emit_byte(out, pos, modrm_rr(src, dst))
}

// OR r/m64, r64:  REX.W 09 /r
fn emit_or_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x09)
    emit_byte(out, pos, modrm_rr(src, dst))
}

// SHR r64, imm8:  REX.W C1 /5 imm8  (logical right shift by immediate)
fn emit_shr_imm8(out: &i8, pos: &i64, dst: i32, imm: i32) {
    let rex = 0x48 + (dst / 8)
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE8 + (mod8(dst)))
    emit_byte(out, pos, mod256(imm))
}

// SHL r64, imm8:  REX.W C1 /4 imm8  (left shift by immediate)
fn emit_shl_imm8(out: &i8, pos: &i64, dst: i32, imm: i32) {
    let rex = 0x48 + (dst / 8)
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE0 + (mod8(dst)))
    emit_byte(out, pos, mod256(imm))
}

// SHR r64, CL:  REX.W D3 /5  (logical right shift by CL)
fn emit_shr_rcl(out: &i8, pos: &i64, dst: i32) {
    let rex = 0x48 + (dst / 8)
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0xD3)
    emit_byte(out, pos, 0xE8 + (mod8(dst)))
}

// SHL r64, CL:  REX.W D3 /4  (left shift by CL)
fn emit_shl_rcl(out: &i8, pos: &i64, dst: i32) {
    let rex = 0x48 + (dst / 8)
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0xD3)
    emit_byte(out, pos, 0xE0 + (mod8(dst)))
}

// IMUL r64, r/m64:  REX.W 0F AF /r
fn emit_imul_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, dst, src)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xAF)
    emit_byte(out, pos, modrm_rr(dst, src))
}

// CQO: sign-extend rax into rdx:rax  (48 99)
fn emit_cqo(out: &i8, pos: &i64) {
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x99)
}

// IDIV r/m64:  REX.W F7 /7
fn emit_idiv_r(out: &i8, pos: &i64, divisor: i32) {
    let b = 0
    if divisor >= 8 { b = 1 }
    emit_byte(out, pos, 72 + b)
    emit_byte(out, pos, 0xF7)
    emit_byte(out, pos, modrm_rr(7, divisor))
}

// CMP r/m64, r64:  REX.W 39 /r
fn emit_cmp_rr(out: &i8, pos: &i64, a: i32, b: i32) {
    emit_rex_w_rr(out, pos, b, a)
    emit_byte(out, pos, 0x39)
    emit_byte(out, pos, modrm_rr(b, a))
}

// CMP r64, 0:  REX.W 83 /7 00
fn emit_cmp_zero(out: &i8, pos: &i64, r: i32) {
    // TEST r, r — 3 bytes (vs CMP r, 0 which is 4 bytes)
    // Sets ZF=1 iff r==0, same semantics as CMP r, 0
    emit_rex_w_rr(out, pos, r, r)
    emit_byte(out, pos, 0x85)
    emit_byte(out, pos, modrm_rr(r, r))
}

// PUSH r64
fn emit_push_r(out: &i8, pos: &i64, r: i32) {
    let ext = 0
    if r >= 8 { ext = 1 }
    if ext == 1 {
        emit_byte(out, pos, 0x41)
        emit_byte(out, pos, 0x50 + (mod8(r)))
    } else {
        emit_byte(out, pos, 0x50 + r)
    }
}

// POP r64
fn emit_pop_r(out: &i8, pos: &i64, r: i32) {
    let ext = 0
    if r >= 8 { ext = 1 }
    if ext == 1 {
        emit_byte(out, pos, 0x41)
        emit_byte(out, pos, 0x58 + (mod8(r)))
    } else {
        emit_byte(out, pos, 0x58 + r)
    }
}

// RET
fn emit_ret_instr(out: &i8, pos: &i64) {
    emit_byte(out, pos, 0xC3)
}

// JMP rel32
fn emit_jmp_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0xE9)
    emit_i32_le(out, pos, rel)
}

// JE rel32
fn emit_je_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x84)
    emit_i32_le(out, pos, rel)
}

// JNE rel32
fn emit_jne_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x85)
    emit_i32_le(out, pos, rel)
}

// Jcc rel32 — general conditional jump by condition code
fn emit_jcc_rel32(out: &i8, pos: &i64, cc: i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x80 + cc)
    emit_i32_le(out, pos, rel)
}

// JL rel32
fn emit_jl_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8C)
    emit_i32_le(out, pos, rel)
}

// JG rel32
fn emit_jg_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8F)
    emit_i32_le(out, pos, rel)
}

// SYSCALL
fn emit_syscall_instr(out: &i8, pos: &i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x05)
}

// CALL rel32  (E8 rel32)
fn emit_call_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0xE8)
    emit_i32_le(out, pos, rel)
}

// LEA r64, [rip + rel32]  (RIP-relative load of address)
fn emit_lea_rip(out: &i8, pos: &i64, dst: i32, rel: i64) {
    let r_ext = 0
    if dst >= 8 { r_ext = 1 }
    let rex = 72 + r_ext * 4
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x8D)
    // ModRM: mod=00, reg=dst, rm=101 (RIP+disp32)
    let modrm = mod8(dst)
    let modrm_sh = modrm * 8
    emit_byte(out, pos, modrm_sh + 5)
    emit_i32_le(out, pos, rel)
}

// MOV r64, [rbp - disp]  (load spilled value)
fn emit_load_spill(out: &i8, pos: &i64, dst: i32, off: i64) {
    // REX.W 8B /r  [rbp - off]
    let r_ext = 0
    if dst >= 8 { r_ext = 1 }
    let rex = 72 + r_ext * 4
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x8B)
    // mod=10 (disp32), reg=dst, rm=101 (rbp)
    let modrm = mod8(dst)
    let modrm_sh = modrm * 8
    emit_byte(out, pos, 0x80 + modrm_sh + 5)
    let neg_off = 0 - off
    emit_i32_le(out, pos, neg_off)
}

// MOV [rbp - disp], r64  (store to spill slot)
fn emit_store_spill(out: &i8, pos: &i64, off: i64, src: i32) {
    let r_ext = 0
    if src >= 8 { r_ext = 1 }
    let rex = 72 + r_ext * 4
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x89)
    let modrm = mod8(src)
    let modrm_sh = modrm * 8
    emit_byte(out, pos, 0x80 + modrm_sh + 5)
    let neg_off = 0 - off
    emit_i32_le(out, pos, neg_off)
}

fn emit_load_mem_reg(out: &i8, pos: &i64, dst: i32, base: i32) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    let rex = 72 + dst_hi * 4 + base_hi
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x8B)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    if base3 == 4 {
        // [rsp]/[r12] requires SIB byte (index=none, scale=1)
        let modrm = 0x00 + (dst3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        ret ok(0)
    }
    if base3 == 5 {
        // [rbp]/[r13] cannot use mod=00; use mod=01 with disp8=0
        let modrm = 0x40 + (dst3 * 8) + base3
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0)
        ret ok(0)
    }
    let modrm = 0x00 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
}

fn emit_load_mem_reg32zx(out: &i8, pos: &i64, dst: i32, base: i32) {
    let need_rex = 0
    if dst >= 8 { need_rex = 1 }
    if base >= 8 { need_rex = 1 }
    if need_rex == 1 {
        let dst_hi = dst / 8
        let base_hi = base / 8
        let rex = 64 + dst_hi * 4 + base_hi
        emit_byte(out, pos, rex)
    }
    emit_byte(out, pos, 0x8B)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    if base3 == 4 {
        let modrm = 0x00 + (dst3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        ret ok(0)
    }
    if base3 == 5 {
        let modrm = 0x40 + (dst3 * 8) + base3
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0)
        ret ok(0)
    }
    let modrm = 0x00 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
}

fn emit_load_mem_disp_reg32zx(out: &i8, pos: &i64, dst: i32, base: i32, disp: i64) {
    let need_rex = 0
    if dst >= 8 { need_rex = 1 }
    if base >= 8 { need_rex = 1 }
    if need_rex == 1 {
        let dst_hi = dst / 8
        let base_hi = base / 8
        let rex = 64 + dst_hi * 4 + base_hi
        emit_byte(out, pos, rex)
    }
    emit_byte(out, pos, 0x8B)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    if base3 == 4 {
        let modrm = 0x80 + (dst3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        emit_i32_le(out, pos, disp)
        ret ok(0)
    }
    let modrm = 0x80 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
    emit_i32_le(out, pos, disp)
}

fn emit_load_mem_reg8zx(out: &i8, pos: &i64, dst: i32, base: i32) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    let rex = 64 + dst_hi * 4 + base_hi
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xB6)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    if base3 == 4 {
        let modrm = 0x00 + (dst3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        ret ok(0)
    }
    if base3 == 5 {
        let modrm = 0x40 + (dst3 * 8) + base3
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0)
        ret ok(0)
    }
    let modrm = 0x00 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
}

fn emit_load_mem_disp_reg(out: &i8, pos: &i64, dst: i32, base: i32, disp: i64) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    let rex = 72 + dst_hi * 4 + base_hi
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x8B)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    if base3 == 4 {
        let modrm = 0x80 + (dst3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        emit_i32_le(out, pos, disp)
        ret ok(0)
    }
    let modrm = 0x80 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
    emit_i32_le(out, pos, disp)
}

fn emit_load_mem_disp_reg8zx(out: &i8, pos: &i64, dst: i32, base: i32, disp: i64) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    let rex = 64 + dst_hi * 4 + base_hi
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xB6)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    if base3 == 4 {
        let modrm = 0x80 + (dst3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        emit_i32_le(out, pos, disp)
        ret ok(0)
    }
    let modrm = 0x80 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
    emit_i32_le(out, pos, disp)
}

fn emit_store_mem_reg32(out: &i8, pos: &i64, base: i32, src: i32) {
    let need_rex = 0
    if src >= 8 { need_rex = 1 }
    if base >= 8 { need_rex = 1 }
    if need_rex == 1 {
        let src_hi = src / 8
        let base_hi = base / 8
        let rex = 64 + src_hi * 4 + base_hi
        emit_byte(out, pos, rex)
    }
    emit_byte(out, pos, 0x89)
    let src3 = mod8(src)
    let base3 = mod8(base)
    if base3 == 4 {
        let modrm = 0x00 + (src3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        ret ok(0)
    }
    if base3 == 5 {
        let modrm = 0x40 + (src3 * 8) + base3
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0)
        ret ok(0)
    }
    let modrm = 0x00 + (src3 * 8) + base3
    emit_byte(out, pos, modrm)
}

fn emit_store_mem_reg(out: &i8, pos: &i64, base: i32, src: i32) {
    let src_hi = src / 8
    let base_hi = base / 8
    let rex = 72 + src_hi * 4 + base_hi
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x89)
    let src3 = mod8(src)
    let base3 = mod8(base)
    if base3 == 4 {
        // [rsp]/[r12] requires SIB byte (index=none, scale=1)
        let modrm = 0x00 + (src3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        ret ok(0)
    }
    if base3 == 5 {
        // [rbp]/[r13] cannot use mod=00; use mod=01 with disp8=0
        let modrm = 0x40 + (src3 * 8) + base3
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0)
        ret ok(0)
    }
    let modrm = 0x00 + (src3 * 8) + base3
    emit_byte(out, pos, modrm)
}

// MOV [base], src_8  (byte store)
fn emit_store_mem_byte(out: &i8, pos: &i64, base: i32, src: i32) {
    // Need REX prefix if any register >= 4 (to access byte regs)
    let need_rex = 0
    if src >= 4 { need_rex = 1 }
    if base >= 8 { need_rex = 1 }
    if need_rex == 1 {
        let rex = 0x40 + (src / 8) * 4 + (base / 8)
        emit_byte(out, pos, rex)
    }
    emit_byte(out, pos, 0x88)
    let src3 = mod8(src)
    let base3 = mod8(base)
    if base3 == 4 {
        let modrm = 0x00 + (src3 * 8) + 0x04
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0x20 + base3)
        ret ok(0)
    }
    if base3 == 5 {
        let modrm = 0x40 + (src3 * 8) + base3
        emit_byte(out, pos, modrm)
        emit_byte(out, pos, 0)
        ret ok(0)
    }
    let modrm = 0x00 + (src3 * 8) + base3
    emit_byte(out, pos, modrm)
}

// MOVZX r64, word [base]  — 16-bit zero-extend load
fn emit_load_mem_reg16zx(out: &i8, pos: &i64, dst: i32, base: i32) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    let rex = 0x48 + dst_hi * 4 + base_hi
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xB7)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    let modrm = 0x00 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
}

// MOVZX r64, word [base+disp]  — 16-bit zero-extend load with displacement
fn emit_load_mem_disp_reg16zx(out: &i8, pos: &i64, dst: i32, base: i32, disp: i64) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    let rex = 0x48 + dst_hi * 4 + base_hi
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xB7)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    let modrm = 0x80 + (dst3 * 8) + base3
    emit_byte(out, pos, modrm)
    emit_i32_le(out, pos, disp)
}

// MOV word [base], src  — 16-bit store (operand size prefix 0x66)
fn emit_store_mem_reg16(out: &i8, pos: &i64, base: i32, src: i32) {
    emit_byte(out, pos, 0x66)
    let src_hi = src / 8
    let base_hi = base / 8
    let need_rex = src_hi + base_hi
    if need_rex > 0 {
        let rex = 0x40 + src_hi * 4 + base_hi
        emit_byte(out, pos, rex)
    }
    emit_byte(out, pos, 0x89)
    let src3 = mod8(src)
    let base3 = mod8(base)
    let modrm = 0x00 + (src3 * 8) + base3
    emit_byte(out, pos, modrm)
}

// DIV r/m64 (unsigned):  REX.W F7 /6
fn emit_div_r(out: &i8, pos: &i64, divisor: i32) {
    let b = 0
    if divisor >= 8 { b = 1 }
    emit_byte(out, pos, 72 + b)
    emit_byte(out, pos, 0xF7)
    emit_byte(out, pos, modrm_rr(6, divisor))
}

// SETNE al / SETE al after CMP, then MOVZX rax, al
fn emit_setcc_rax(out: &i8, pos: &i64, cc: i32) {
    // SETCC al:  0F 9x C0
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x90 + cc)
    emit_byte(out, pos, 0xC0)
    // MOVZX rax, al:  48 0F B6 C0
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xB6)
    emit_byte(out, pos, 0xC0)
}

fn emit_setcc_r12(out: &i8, pos: &i64, cc: i32) {
    // SETCC R12b:  41 0F 9x C4  (REX.B for R12 byte register)
    emit_byte(out, pos, 0x41)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x90 + cc)
    emit_byte(out, pos, 0xC4)
    // MOVZX R12, R12b:  4D 0F B6 E4  (REX.WRB: W=1, R=1 for R12 dst, B=1 for R12 src)
    emit_byte(out, pos, 0x4D)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xB6)
    emit_byte(out, pos, 0xE4)
}

// ============================================================
// 10. X86-64 LOWERING  (JIR -> machine code)
// ============================================================

fn emit_save_pool(ra: &RegAlloc, out: &i8, pos: &i64) {
    // P3: Only save registers that hold live values
    let mask = 0
    if ra.reg2val[0] != -1 { emit_push_r(out, pos, PHYS_RAX)  mask = mask + 1 }
    if ra.reg2val[1] != -1 { emit_push_r(out, pos, PHYS_RCX)  mask = mask + 2 }
    if ra.reg2val[2] != -1 { emit_push_r(out, pos, PHYS_RDX)  mask = mask + 4 }
    if ra.reg2val[3] != -1 { emit_push_r(out, pos, PHYS_RSI)  mask = mask + 8 }
    if ra.reg2val[4] != -1 { emit_push_r(out, pos, PHYS_RDI)  mask = mask + 16 }
    if ra.reg2val[5] != -1 { emit_push_r(out, pos, PHYS_R8)   mask = mask + 32 }
    if ra.reg2val[6] != -1 { emit_push_r(out, pos, PHYS_R9)   mask = mask + 64 }
    if ra.reg2val[7] != -1 { emit_push_r(out, pos, PHYS_RBX)  mask = mask + 128 }
    if ra.reg2val[8] != -1 { emit_push_r(out, pos, PHYS_R10)  mask = mask + 256 }
    if ra.reg2val[9] != -1 { emit_push_r(out, pos, PHYS_R11)  mask = mask + 512 }
    g_save_mask = mask
}

fn mask_bit(mask: i64, pow: i64) -> i64 {
    let shifted = mask / pow
    ret shifted - (shifted / 2) * 2
}

fn emit_restore_pool(ra: &RegAlloc, out: &i8, pos: &i64) {
    // P3: Only restore registers that were saved (reverse order)
    let mask = g_save_mask
    if mask_bit(mask, 512) != 0 { emit_pop_r(out, pos, PHYS_R11) }
    if mask_bit(mask, 256) != 0 { emit_pop_r(out, pos, PHYS_R10) }
    if mask_bit(mask, 128) != 0 { emit_pop_r(out, pos, PHYS_RBX) }
    if mask_bit(mask, 64) != 0  { emit_pop_r(out, pos, PHYS_R9) }
    if mask_bit(mask, 32) != 0  { emit_pop_r(out, pos, PHYS_R8) }
    if mask_bit(mask, 16) != 0  { emit_pop_r(out, pos, PHYS_RDI) }
    if mask_bit(mask, 8) != 0   { emit_pop_r(out, pos, PHYS_RSI) }
    if mask_bit(mask, 4) != 0   { emit_pop_r(out, pos, PHYS_RDX) }
    if mask_bit(mask, 2) != 0   { emit_pop_r(out, pos, PHYS_RCX) }
    if mask_bit(mask, 1) != 0   { emit_pop_r(out, pos, PHYS_RAX) }
}





fn ensure_spilled(ra: &RegAlloc, out: &i8, pos: &i64, val_id: i64) {
    if val_id < 0 { ret ok(0) }
    if val_id >= 8192 { ret ok(0) }
    if ra.spill_off[val_id] > 0 { ret ok(0) }
    let r = regalloc_get(ra, val_id)
    if r == -1 { ret ok(0) }
    let next_sp = ra.sp_top + 8
    ra.sp_top = next_sp
    ra.spill_off[val_id] = next_sp
    emit_store_spill(out, pos, next_sp, r)
}

fn get_or_load(ra: &RegAlloc, out: &i8, pos: &i64, val_id: i64) -> i32 {
    let valid = 1
    if val_id < 0 { valid = 0 }
    if val_id >= 8192 { valid = 0 }
    if valid != 1 { ret PHYS_RAX }
    // Check if value is in a promoted register (deferred load)
    let vpr = g_val_promo_reg[val_id]
    if vpr >= 0 { ret vpr }
    let r = regalloc_get(ra, val_id)
    let cached = 0
    if r != -1 { cached = 1 }
    if cached == 1 { ret r }
    let new_r = regalloc_alloc(ra, out, pos, val_id)
    let off = ra.spill_off[val_id]
    let spilled = 0
    if off > 0 { spilled = 1 }
    if spilled == 1 {
        emit_load_spill(out, pos, new_r, off)
    } else {
        // Check if this is a deferred constant
        if g_val_op[val_id] == OP_CONST {
            let cimm = g_val_imm[val_id]
            if cimm == 0 {
                emit_rex_w_rr(out, pos, new_r, new_r)
                emit_byte(out, pos, 0x33)
                emit_byte(out, pos, modrm_rr(new_r, new_r))
            } else {
                emit_mov_imm64(out, pos, new_r, cimm)
            }
        } else {
            emit_mov_imm64(out, pos, new_r, 0)
        }
    }
    ret new_r
}

fn lower_print_int(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // Save caller state
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)

    // Load value into a register, then move to r12
    let val_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_mov_rr(out, pos, PHYS_R12, val_r)

    // sub rsp, 32  (stack buffer for digits + newline)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xEC)
    emit_byte(out, pos, 32)

    // lea rcx, [rsp + 31]   (point to end of buffer)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 31)

    // mov byte [rcx], 10   (newline at end)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x01)
    emit_byte(out, pos, 10)

    // mov r8, r12   (working copy of value)
    emit_byte(out, pos, 0x4D)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xE0)

    // mov r9, 10    (divisor)
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC1)
    emit_i32_le(out, pos, 10)

    // === loop top (record position for backward jump) ===
    let loop_top = pos[0]

    // xor rdx, rdx
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xD2)

    // mov rax, r8
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xC0)

    // div r9  (rax = quotient, rdx = remainder)
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0xF7)
    emit_byte(out, pos, 0xF1)

    // add dl, 48   ('0')
    emit_byte(out, pos, 0x80)
    emit_byte(out, pos, 0xC2)
    emit_byte(out, pos, 48)

    // dec rcx
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC9)

    // mov [rcx], dl
    emit_byte(out, pos, 0x88)
    emit_byte(out, pos, 0x11)

    // mov r8, rax  (quotient becomes new working value)
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xC0)

    // test rax, rax
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x85)
    emit_byte(out, pos, 0xC0)

    // jnz loop_top  (backward relative jump)
    let jnz_off = loop_top - (pos[0] + 2)
    emit_byte(out, pos, 0x75)
    emit_byte(out, pos, mod256(jnz_off))

    // write(1, rcx, rsp+32-rcx)
    // mov rax, 0x02000004   (macOS SYS_WRITE) ... but we target Linux
    // mov rax, 1   (Linux SYS_WRITE)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC0)
    emit_i32_le(out, pos, 1)

    // mov rdi, 1   (fd = stdout)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC7)
    emit_i32_le(out, pos, 1)

    // mov rsi, rcx  (buf ptr)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xCE)

    // lea rdx, [rsp + N] where N=31 if no-newline (imm==1), else 32
    let end_off = 32
    if ins.imm == 1 { end_off = 31 }
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x54)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, end_off)

    // sub rdx, rcx  (len = end - ptr)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x29)
    emit_byte(out, pos, 0xCA)

    // syscall
    emit_syscall_instr(out, pos)

    // add rsp, 32  (restore stack)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC4)
    emit_byte(out, pos, 32)

    // Restore pool and r12
    emit_restore_pool(ctx.ra, out, pos)
    emit_pop_r(out, pos, PHYS_R12)

    consume_use(ctx, ins.operand0)
}

fn lower_syscall_push_arg(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64, idx: i64) {
    let vals = i64[7]
    vals[0] = ins.operand0
    vals[1] = ins.operand1
    vals[2] = ins.operand2
    vals[3] = ins.bb_target0
    vals[4] = ins.bb_target1
    vals[5] = ins.imm
    vals[6] = ins.itype as i64
    let v = vals[idx]
    let r = get_or_load(ctx.ra, out, pos, v)
    emit_push_r(out, pos, r)
}

fn lower_syscall_pop_arg(out: &i8, pos: &i64, idx: i64) {
    let regs = i32[7]
    regs[0] = PHYS_RAX
    regs[1] = PHYS_RDI
    regs[2] = PHYS_RSI
    regs[3] = PHYS_RDX
    regs[4] = PHYS_R10
    regs[5] = PHYS_R8
    regs[6] = PHYS_R9
    let r = regs[idx]
    emit_pop_r(out, pos, r)
}

fn lower_syscall_consume_arg(ins: &Instr, ctx: &LowerCtx, idx: i64) {
    let vals = i64[7]
    vals[0] = ins.operand0
    vals[1] = ins.operand1
    vals[2] = ins.operand2
    vals[3] = ins.bb_target0
    vals[4] = ins.bb_target1
    vals[5] = ins.imm
    vals[6] = ins.itype as i64
    let v = vals[idx]
    consume_use(ctx, v)
}

fn lower_syscall(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    
    // Push in order (always at least the nr)
    let nr_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, nr_r)
    let push_idx = 1
    loop push_idx <= ins.operand3 and push_idx <= 6 {
        lower_syscall_push_arg(ins, ctx, out, pos, push_idx)
        push_idx = push_idx + 1
    }

    // Pop in reverse
    let pop_idx = ins.operand3
    if pop_idx > 6 { pop_idx = 6 }
    loop pop_idx >= 1 {
        lower_syscall_pop_arg(out, pos, pop_idx)
        pop_idx = pop_idx - 1
    }
    lower_syscall_pop_arg(out, pos, 0)
    
    emit_syscall_instr(out, pos)
    
    if ins.id >= 0 and ins.id < 8192 and ctx.use_cnt[ins.id] > 0 {
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 { emit_mov_rr(out, pos, dst, PHYS_R12) }
    } else {
        emit_restore_pool(ctx.ra, out, pos)
    }
    emit_pop_r(out, pos, PHYS_R12)
    
    let use_idx = 0
    let use_lim = ins.operand3
    if use_lim > 6 { use_lim = 6 }
    loop use_idx <= use_lim {
        lower_syscall_consume_arg(ins, ctx, use_idx)
        use_idx = use_idx + 1
    }
}

fn lower_instr_rip_fixup(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64, target_bb: i64, kind: i64) -> i64 {
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    let room = 1
    if ctx.fix_cnt >= 8192 { room = 0 }
    if room != 1 { panic("Lower fixup overflow") }
    let fix_idx = ctx.fix_cnt
    fixup_init(&ctx.fixups[fix_idx], pos[0] + 3, target_bb, kind, 0)
    ctx.fix_cnt = ctx.fix_cnt + 1
    emit_lea_rip(out, pos, dst, 0)
    let rsp2 = ctx.ra.sp_top + 8
    ra_set_sp_top(&ctx.ra, rsp2)
    ra_set_spill(&ctx.ra, ins.id, rsp2)
    emit_store_spill(out, pos, rsp2, dst)
    ret 1
}

fn ra_set_sp_top(ra: &RegAlloc, val: i64) {
    ra.sp_top = val
}

fn ra_set_spill(ra: &RegAlloc, idx: i64, val: i64) {
    ra.spill_off[idx] = val
}

fn lower_instr_constlike(ins: &Instr, ctx: &LowerCtx, jfn: &JirFunction, out: &i8, pos: &i64) -> i64 {
    let is_const = 0
    if ins.op == OP_CONST { is_const = 1 }
    if is_const == 1 {
        // Defer single-use constants with small imm — ADD/CMP/SUB will inline them
        if ctx.use_cnt[ins.id] == 1 {
            let can_defer = 0
            if ins.imm >= 0 and ins.imm < 2147483648 { can_defer = 1 }
            if can_defer == 1 { ret 1 }
        }
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if ins.imm == 0 {
            // XOR dst, dst — 3 bytes instead of MOV imm64 (10 bytes)
            emit_rex_w_rr(out, pos, dst, dst)
            emit_byte(out, pos, 0x33)
            emit_byte(out, pos, modrm_rr(dst, dst))
        } else {
            emit_mov_imm64(out, pos, dst, ins.imm)
        }
        if ctx.use_cnt[ins.id] > 1 {
            let csp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, csp)
            ra_set_spill(&ctx.ra, ins.id, csp)
            emit_store_spill(out, pos, csp, dst)
        }
        ret 1
    }
    let is_strlit = 0
    if ins.op == OP_STRLIT { is_strlit = 1 }
    if is_strlit == 1 { ret lower_instr_rip_fixup(ins, ctx, out, pos, ins.str_start, 1) }
    let is_gaddr = 0
    if ins.op == OP_GADDR { is_gaddr = 1 }
    if is_gaddr == 1 { ret lower_instr_rip_fixup(ins, ctx, out, pos, ins.imm, 3) }
    ret 0
}

fn lower_load_mem(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let base_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_mov_rr(out, pos, PHYS_R12, base_r)
    consume_use(ctx, ins.operand0)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    let ld_sz = type_sizeof(ins.itype)
    if ld_sz == 1 {
        if ins.imm != 0 {
            emit_load_mem_disp_reg8zx(out, pos, dst, PHYS_R12, ins.imm)
        } else {
            emit_load_mem_reg8zx(out, pos, dst, PHYS_R12)
        }
    } else {
        if ld_sz == 2 {
            if ins.imm != 0 {
                emit_load_mem_disp_reg16zx(out, pos, dst, PHYS_R12, ins.imm)
            } else {
                emit_load_mem_reg16zx(out, pos, dst, PHYS_R12)
            }
        } else {
        if ld_sz == 4 {
            if ins.imm != 0 {
                emit_load_mem_disp_reg32zx(out, pos, dst, PHYS_R12, ins.imm)
            } else {
                emit_load_mem_reg32zx(out, pos, dst, PHYS_R12)
            }
        } else {
            if ins.imm != 0 {
                emit_load_mem_disp_reg(out, pos, dst, PHYS_R12, ins.imm)
            } else {
                emit_load_mem_reg(out, pos, dst, PHYS_R12)
            }
        }
        }
    }
    if ctx.use_cnt[ins.id] > 1 {
        let msp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, msp)
        ra_set_spill(&ctx.ra, ins.id, msp)
        emit_store_spill(out, pos, msp, dst)
    }
    ret 1
}

fn lower_instr_mem(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let is_load = 0
    if ins.op == OP_LOAD { is_load = 1 }
    if is_load == 1 {
        // Check if this slot is promoted (loop register optimization)
        let promo_r = -1
        if g_promo_cnt > 0 and g_cur_block_idx >= g_promo_header and g_cur_block_idx <= g_promo_body_end {
            promo_r = promo_reg_for_slot(ins.operand0)
        }
        if promo_r != -1 {
            // Promoted: defer single-use loads (no code emitted)
            if ctx.use_cnt[ins.id] == 1 {
                g_val_promo_reg[ins.id] = promo_r
                ret 1
            }
            // Multi-use: read from pinned register into pool register
            let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
            emit_mov_rr(out, pos, dst, promo_r)
            if ctx.use_cnt[ins.id] > 1 {
                let lsp = ctx.ra.sp_top + 8
                ra_set_sp_top(&ctx.ra, lsp)
                ra_set_spill(&ctx.ra, ins.id, lsp)
                emit_store_spill(out, pos, lsp, dst)
            }
            ret 1
        }
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_load_spill(out, pos, dst, ins.operand0)
        if ctx.use_cnt[ins.id] > 1 {
            let lsp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, lsp)
            ra_set_spill(&ctx.ra, ins.id, lsp)
            emit_store_spill(out, pos, lsp, dst)
        }
        ret 1
    }
    let is_addr = 0
    if ins.op == OP_ADDR { is_addr = 1 }
    if is_addr == 1 {
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        let b = 0
        if dst >= 8 { b = 1 }
        let rex_val = 72 + b * 4
        emit_byte(out, pos, rex_val)
        emit_byte(out, pos, 0x8D)
        let modrm = 0x80 + ((mod8(dst)) * 8) + 5
        emit_byte(out, pos, modrm)
        emit_i32_le(out, pos, 0 - ins.operand0)
        if ctx.use_cnt[ins.id] > 1 {
            let adsp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, adsp)
            ra_set_spill(&ctx.ra, ins.id, adsp)
            emit_store_spill(out, pos, adsp, dst)
        }
        ret 1
    }
    let is_store = 0
    if ins.op == OP_STORE { is_store = 1 }
    if is_store == 1 {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        // Check if this slot is promoted (all stores update the pinned register)
        let st_promo_r = -1
        if g_promo_cnt > 0 {
            st_promo_r = promo_reg_for_slot(ins.operand1)
        }
        if st_promo_r != -1 {
            // Promoted: update pinned register; skip if already there
            if src_r != st_promo_r {
                emit_mov_rr(out, pos, st_promo_r, src_r)
            }
            if g_cur_block_idx < g_promo_header or g_cur_block_idx > g_promo_body_end {
                emit_store_spill(out, pos, ins.operand1, src_r)
            }
        } else {
            emit_store_spill(out, pos, ins.operand1, src_r)
        }
        consume_use(ctx, ins.operand0)
        ret 1
    }
    let is_load_mem = 0
    if ins.op == OP_LOAD_MEM { is_load_mem = 1 }
    if is_load_mem == 1 {
        ret lower_load_mem(ins, ctx, out, pos)
    }
    let is_store_mem = 0
    if ins.op == OP_STORE_MEM { is_store_mem = 1 }
    if is_store_mem == 1 {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        let store_src = src_r
        if ins.operand0 != ins.operand1 {
            let rb = regalloc_get(ctx.ra, ins.operand1)
            if rb == -1 and src_r == reg_pool_at(0) {
                emit_mov_rr(out, pos, PHYS_R12, src_r)
                store_src = PHYS_R12
            }
        }
        let base_r = get_or_load(ctx.ra, out, pos, ins.operand1)
        let st_sz = type_sizeof(ins.itype)
        if st_sz == 1 {
            emit_store_mem_byte(out, pos, base_r, store_src)
        } else {
            if st_sz == 2 {
                emit_store_mem_reg16(out, pos, base_r, store_src)
            } else {
            if st_sz == 4 {
                emit_store_mem_reg32(out, pos, base_r, store_src)
            } else {
                emit_store_mem_reg(out, pos, base_r, store_src)
            }
            }
        }
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    ret 0
}

fn lower_instr_arith(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let is_add = 0
    if ins.op == OP_ADD { is_add = 1 }
    if is_add == 1 {
        // Promoted in-place optimization: ADD directly on promoted register
        let add_promo = -1
        if ins.id >= 0 and ins.id < 8192 { add_promo = g_val_promo_reg[ins.id] }
        if add_promo >= 0 {
            // operand1: check promoted or constant
            let b1_promo = -1
            if ins.operand1 >= 0 and ins.operand1 < 8192 {
                b1_promo = g_val_promo_reg[ins.operand1]
            }
            if b1_promo >= 0 {
                // Both promoted: ADD promo_a, promo_b
                emit_add_rr(out, pos, add_promo, b1_promo)
                consume_use(ctx, ins.operand0)
                consume_use(ctx, ins.operand1)
                ret 1
            }
            let ab_const = 0
            let ab_imm = 0
            if ins.operand1 >= 0 and ins.operand1 < 8192 {
                if g_val_op[ins.operand1] == OP_CONST {
                    ab_imm = g_val_imm[ins.operand1]
                    if ab_imm >= 0 and ab_imm < 2147483648 { ab_const = 1 }
                }
            }
            if ab_const == 1 {
                // Promoted + immediate: ADD promo_a, imm
                if ab_imm >= 0 and ab_imm < 128 {
                    emit_add_imm8(out, pos, add_promo, ab_imm)
                } else {
                    emit_add_imm32(out, pos, add_promo, ab_imm)
                }
                consume_use(ctx, ins.operand0)
                consume_use(ctx, ins.operand1)
                ret 1
            }
            // Promoted + non-promoted: load operand1, ADD promo, reg
            let b1r = get_or_load(ctx.ra, out, pos, ins.operand1)
            emit_add_rr(out, pos, add_promo, b1r)
            consume_use(ctx, ins.operand0)
            consume_use(ctx, ins.operand1)
            ret 1
        }
        // Optimization: ADD with immediate constant
        let b_is_const = 0
        let b_imm = 0
        let b_id = ins.operand1
        if b_id >= 0 and b_id < 8192 {
            if g_val_op[b_id] == OP_CONST { b_is_const = 1  b_imm = g_val_imm[b_id] }
        }
        // Check if imm fits in signed 32-bit
        let imm_fits = 0
        if b_is_const == 1 {
            if b_imm >= 0 and b_imm < 2147483648 { imm_fits = 1 }
        }
        if imm_fits == 1 {
            let a = get_or_load(ctx.ra, out, pos, ins.operand0)
            emit_mov_rr(out, pos, PHYS_R12, a)
            if b_imm >= 0 and b_imm < 128 {
                emit_add_imm8(out, pos, PHYS_R12, b_imm)
            } else {
                emit_add_imm32(out, pos, PHYS_R12, b_imm)
            }
            consume_use(ctx, ins.operand0)
            consume_use(ctx, ins.operand1)
            let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
            emit_mov_rr(out, pos, dst, PHYS_R12)
            if ctx.use_cnt[ins.id] > 1 {
                let asp2 = ctx.ra.sp_top + 8
                ra_set_sp_top(&ctx.ra, asp2)
                ra_set_spill(&ctx.ra, ins.id, asp2)
                emit_store_spill(out, pos, asp2, dst)
            }
            ret 1
        }
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_R12, a)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_add_rr(out, pos, PHYS_R12, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        if ctx.use_cnt[ins.id] > 1 {
            let asp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, asp)
            ra_set_spill(&ctx.ra, ins.id, asp)
            emit_store_spill(out, pos, asp, dst)
        }
        ret 1
    }
    let is_sub = 0
    if ins.op == OP_SUB { is_sub = 1 }
    if is_sub == 1 {
        // Promoted in-place SUB
        let sub_promo = -1
        if ins.id >= 0 and ins.id < 8192 { sub_promo = g_val_promo_reg[ins.id] }
        if sub_promo >= 0 {
            let sb1_promo = -1
            if ins.operand1 >= 0 and ins.operand1 < 8192 {
                sb1_promo = g_val_promo_reg[ins.operand1]
            }
            if sb1_promo >= 0 {
                emit_sub_rr(out, pos, sub_promo, sb1_promo)
                consume_use(ctx, ins.operand0)
                consume_use(ctx, ins.operand1)
                ret 1
            }
            let sbc = 0
            let sbi = 0
            if ins.operand1 >= 0 and ins.operand1 < 8192 {
                if g_val_op[ins.operand1] == OP_CONST {
                    sbi = g_val_imm[ins.operand1]
                    if sbi >= 0 and sbi < 2147483648 { sbc = 1 }
                }
            }
            if sbc == 1 {
                emit_sub_imm32(out, pos, sub_promo, sbi)
                consume_use(ctx, ins.operand0)
                consume_use(ctx, ins.operand1)
                ret 1
            }
            let sb1r = get_or_load(ctx.ra, out, pos, ins.operand1)
            emit_sub_rr(out, pos, sub_promo, sb1r)
            consume_use(ctx, ins.operand0)
            consume_use(ctx, ins.operand1)
            ret 1
        }
        // Optimization: SUB with immediate constant
        let sb_is_const = 0
        let sb_imm = 0
        let sb_id = ins.operand1
        if sb_id >= 0 and sb_id < 8192 {
            if g_val_op[sb_id] == OP_CONST { sb_is_const = 1  sb_imm = g_val_imm[sb_id] }
        }
        let sb_fits = 0
        if sb_is_const == 1 {
            if sb_imm >= 0 and sb_imm < 2147483648 { sb_fits = 1 }
        }
        if sb_fits == 1 {
            let a = get_or_load(ctx.ra, out, pos, ins.operand0)
            emit_mov_rr(out, pos, PHYS_R12, a)
            emit_sub_imm32(out, pos, PHYS_R12, sb_imm)
            consume_use(ctx, ins.operand0)
            consume_use(ctx, ins.operand1)
            let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
            emit_mov_rr(out, pos, dst, PHYS_R12)
            if ctx.use_cnt[ins.id] > 1 {
                let ssp2 = ctx.ra.sp_top + 8
                ra_set_sp_top(&ctx.ra, ssp2)
                ra_set_spill(&ctx.ra, ins.id, ssp2)
                emit_store_spill(out, pos, ssp2, dst)
            }
            ret 1
        }
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_R12, a)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_sub_rr(out, pos, PHYS_R12, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        if ctx.use_cnt[ins.id] > 1 {
            let ssp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, ssp)
            ra_set_spill(&ctx.ra, ins.id, ssp)
            emit_store_spill(out, pos, ssp, dst)
        }
        ret 1
    }
    let is_mul = 0
    if ins.op == OP_MUL { is_mul = 1 }
    if is_mul == 1 {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_R12, a)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_imul_rr(out, pos, PHYS_R12, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let msp2 = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, msp2)
        ra_set_spill(&ctx.ra, ins.id, msp2)
        emit_store_spill(out, pos, msp2, dst)
        ret 1
    }
    let is_div = 0
    if ins.op == OP_DIV { is_div = 1 }
    if ins.op == OP_MOD { is_div = 1 }
    if is_div == 1 {
        // Spill and evict live values in RAX/RDX before idiv clobbers them
        let rax_val = ctx.ra.reg2val[0]
        if rax_val != -1 {
            if rax_val != ins.operand0 and rax_val != ins.operand1 {
                ensure_spilled(ctx.ra, out, pos, rax_val)
                regalloc_free(ctx.ra, rax_val)
            }
        }
        let rdx_val = ctx.ra.reg2val[2]
        if rdx_val != -1 {
            if rdx_val != ins.operand0 and rdx_val != ins.operand1 {
                ensure_spilled(ctx.ra, out, pos, rdx_val)
                regalloc_free(ctx.ra, rdx_val)
            }
        }
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        let safe_b = b
        if b == PHYS_RAX or b == PHYS_RDX {
            emit_mov_rr(out, pos, PHYS_R12, b)
            safe_b = PHYS_R12
        }
        emit_mov_rr(out, pos, PHYS_RAX, a)
        let div_unsigned = is_unsigned_type(ins.itype)
        if div_unsigned == 1 {
            // Unsigned div: zero RDX instead of sign-extend
            emit_rex_w_rr(out, pos, PHYS_RDX, PHYS_RDX)
            emit_byte(out, pos, 0x33)
            emit_byte(out, pos, modrm_rr(PHYS_RDX, PHYS_RDX))
            emit_div_r(out, pos, safe_b)
        } else {
            emit_cqo(out, pos)
            emit_idiv_r(out, pos, safe_b)
        }
        // DIV: quotient in RAX, MOD: remainder in RDX
        let result_reg = PHYS_RAX
        if ins.op == OP_MOD { result_reg = PHYS_RDX }
        emit_mov_rr(out, pos, PHYS_R12, result_reg)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        if ctx.use_cnt[ins.id] > 1 {
            let dsp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, dsp)
            ra_set_spill(&ctx.ra, ins.id, dsp)
            emit_store_spill(out, pos, dsp, dst)
        }
        ret 1
    }
    ret 0
}

fn lower_instr_cmpbit(ins: &Instr, ctx: &LowerCtx, jfn: &JirFunction, out: &i8, pos: &i64) -> i64 {
    let is_cmp = 0
    if ins.op == OP_CMP_EQ { is_cmp = 1 }
    if ins.op == OP_CMP_NE { is_cmp = 1 }
    if ins.op == OP_CMP_LT { is_cmp = 1 }
    if ins.op == OP_CMP_GT { is_cmp = 1 }
    if ins.op == OP_CMP_LTE { is_cmp = 1 }
    if ins.op == OP_CMP_GTE { is_cmp = 1 }
    if is_cmp == 1 {
        // Optimization: CMP with immediate constant
        let cb_is_const = 0
        let cb_imm = 0
        let cb_id = ins.operand1
        if cb_id >= 0 and cb_id < 8192 {
            if g_val_op[cb_id] == OP_CONST { cb_is_const = 1  cb_imm = g_val_imm[cb_id] }
        }
        let cb_fits = 0
        if cb_is_const == 1 {
            if cb_imm >= 0 and cb_imm < 2147483648 { cb_fits = 1 }
        }
        if cb_fits == 1 {
            let a = get_or_load(ctx.ra, out, pos, ins.operand0)
            emit_cmp_imm32(out, pos, a, cb_imm)
            consume_use(ctx, ins.operand0)
            consume_use(ctx, ins.operand1)
        } else {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let cmp_a = a
        if ins.operand0 != ins.operand1 {
            let rb = regalloc_get(ctx.ra, ins.operand1)
            if rb == -1 and a == reg_pool_at(0) {
                emit_mov_rr(out, pos, PHYS_R12, a)
                cmp_a = PHYS_R12
            }
        }
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_cmp_rr(out, pos, cmp_a, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        }
        let cc = 4
        let cc_unsigned = is_unsigned_type(ins.itype)
        if ins.op == OP_CMP_NE { cc = 5 }
        if cc_unsigned == 0 {
            if ins.op == OP_CMP_LT { cc = 0xC }
            if ins.op == OP_CMP_LTE { cc = 0xE }
            if ins.op == OP_CMP_GT { cc = 0xF }
            if ins.op == OP_CMP_GTE { cc = 0xD }
        } else {
            if ins.op == OP_CMP_LT { cc = 0x2 }
            if ins.op == OP_CMP_LTE { cc = 0x6 }
            if ins.op == OP_CMP_GT { cc = 0x7 }
            if ins.op == OP_CMP_GTE { cc = 0x3 }
        }
        // Branch fusion: if CMP result used only once AND the very next
        // non-dead instruction is OP_BR using this result, skip setcc
        // and let BR emit jcc directly using CPU flags
        if ctx.use_cnt[ins.id] == 1 {
            let can_fuse = 0
            let ni = g_cur_instr_idx + 1
            let blk_cnt = jfn.blocks[g_cur_block_idx].instr_cnt
            loop ni < blk_cnt {
                if jfn.blocks[g_cur_block_idx].instrs[ni].dead == 0 {
                    if jfn.blocks[g_cur_block_idx].instrs[ni].op == OP_BR {
                        if jfn.blocks[g_cur_block_idx].instrs[ni].operand0 == ins.id {
                            can_fuse = 1
                        }
                    }
                    ni = blk_cnt
                } else {
                    ni = ni + 1
                }
            }
            if can_fuse == 1 {
                g_fused_cmp_cc = cc
                ret 1
            }
        }
        emit_setcc_r12(out, pos, cc)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let csp2 = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, csp)2
        ra_set_spill(&ctx.ra, ins.id, csp)2
        emit_store_spill(out, pos, csp2, dst)
        ret 1
    }
    let is_and = 0
    if ins.op == OP_AND { is_and = 1 }
    if is_and == 1 {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_R12, a)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_and_rr(out, pos, PHYS_R12, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        if ctx.use_cnt[ins.id] > 1 {
            let asp2 = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, asp2)
            ra_set_spill(&ctx.ra, ins.id, asp2)
            emit_store_spill(out, pos, asp2, dst)
        }
        ret 1
    }
    let is_or = 0
    if ins.op == OP_OR { is_or = 1 }
    if is_or == 1 {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_R12, a)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_or_rr(out, pos, PHYS_R12, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        if ctx.use_cnt[ins.id] > 1 {
            let osp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, osp)
            ra_set_spill(&ctx.ra, ins.id, osp)
            emit_store_spill(out, pos, osp, dst)
        }
        ret 1
    }
    let is_shift = 0
    if ins.op == OP_SHR { is_shift = 1 }
    if ins.op == OP_SHL { is_shift = 1 }
    if is_shift == 1 {
        let cv = find_const(jfn, ins.operand1)
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, a)
        consume_use(ctx, ins.operand0)
        if cv.found == 1 {
            if ins.op == OP_SHR { emit_shr_imm8(out, pos, dst, cv.val) }
            if ins.op == OP_SHL { emit_shl_imm8(out, pos, dst, cv.val) }
        } else {
            let b = get_or_load(ctx.ra, out, pos, ins.operand1)
            if b != PHYS_RCX { emit_mov_rr(out, pos, PHYS_RCX, b) }
            if ins.op == OP_SHR { emit_shr_rcl(out, pos, dst) }
            if ins.op == OP_SHL { emit_shl_rcl(out, pos, dst) }
        }
        consume_use(ctx, ins.operand1)
        if ctx.use_cnt[ins.id] > 1 {
            let shsp = ctx.ra.sp_top + 8
            ra_set_sp_top(&ctx.ra, shsp)
            ra_set_spill(&ctx.ra, ins.id, shsp)
            emit_store_spill(out, pos, shsp, dst)
        }
        ret 1
    }
    ret 0
}

fn lower_branch_fixup(ctx: &LowerCtx, pos: &i64, target_bb: i64, code_off: i64, emit_kind: i64) {
    let room = 1
    if ctx.fix_cnt >= 8192 { room = 0 }
    if room != 1 { panic("Lower fixup overflow") }
    let fix_idx = ctx.fix_cnt
    fixup_init(&ctx.fixups[fix_idx], code_off, target_bb, emit_kind, 0)
    ctx.fix_cnt = ctx.fix_cnt + 1
}

fn lower_instr_ctrl(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let is_ret = 0
    if ins.op == OP_RET { is_ret = 1 }
    if is_ret == 1 {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        if g_lower_is_main == 1 {
            if src_r != PHYS_RDI {
                emit_mov_rr(out, pos, PHYS_RDI, src_r)
            }
            emit_mov_imm64(out, pos, PHYS_RAX, 60)
            emit_syscall_instr(out, pos)
            consume_use(ctx, ins.operand0)
            ret 1
        }
        if src_r != PHYS_RAX {
            emit_mov_rr(out, pos, PHYS_RAX, src_r)
        }
        // Restore callee-saved: LEA RSP, [RBP - 32]; POP R15 R14 R13 RBX RBP; RET
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x65)
        emit_byte(out, pos, 0xE0)
        emit_pop_r(out, pos, PHYS_R15)
        emit_pop_r(out, pos, PHYS_R14)
        emit_pop_r(out, pos, PHYS_R13)
        emit_pop_r(out, pos, PHYS_RBX)
        emit_pop_r(out, pos, PHYS_RBP)
        emit_ret_instr(out, pos)
        consume_use(ctx, ins.operand0)
        ret 1
    }
    let is_jmp = 0
    if ins.op == OP_JMP { is_jmp = 1 }
    if is_jmp == 1 {
        lower_branch_fixup(ctx, pos, ins.bb_target0, pos[0] + 1, 0)
        emit_jmp_rel32(out, pos, 0)
        ret 1
    }
    let is_br = 0
    if ins.op == OP_BR { is_br = 1 }
    if is_br == 1 {
        if g_fused_cmp_cc != -1 {
            // Branch fusion: flags already set by CMP, emit jcc directly
            // Invert condition code (XOR 1 flips lowest bit)
            let inv_cc = g_fused_cmp_cc + 1
            let fcc_even = g_fused_cmp_cc / 2
            fcc_even = fcc_even * 2
            if fcc_even != g_fused_cmp_cc {
                inv_cc = g_fused_cmp_cc - 1
            }
            lower_branch_fixup(ctx, pos, ins.bb_target1, pos[0] + 2, 0)
            emit_jcc_rel32(out, pos, inv_cc, 0)
            lower_branch_fixup(ctx, pos, ins.bb_target0, pos[0] + 1, 0)
            emit_jmp_rel32(out, pos, 0)
            g_fused_cmp_cc = -1
            ret 1
        }
        let cond_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_cmp_zero(out, pos, cond_r)
        lower_branch_fixup(ctx, pos, ins.bb_target1, pos[0] + 2, 0)
        emit_je_rel32(out, pos, 0)
        lower_branch_fixup(ctx, pos, ins.bb_target0, pos[0] + 1, 0)
        emit_jmp_rel32(out, pos, 0)
        consume_use(ctx, ins.operand0)
        ret 1
    }
    let is_sys = 0
    if ins.op == OP_SYSCALL { is_sys = 1 }
    if is_sys == 1 {
        lower_syscall(ins, ctx, out, pos)
        ret 1
    }
    ret 0
}

fn lower_instr_alloc(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let is_alloc = 0
    if ins.op == OP_ALLOC { is_alloc = 1 }
    if is_alloc != 1 { ret 0 }
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let sz_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    if sz_r != PHYS_RSI { emit_mov_rr(out, pos, PHYS_RSI, sz_r) }
    emit_mov_imm64(out, pos, PHYS_RAX, 9)
    emit_mov_imm64(out, pos, PHYS_RDI, 0)
    emit_mov_imm64(out, pos, PHYS_RDX, 3)
    emit_mov_imm64(out, pos, PHYS_R10, 0x22)
    emit_mov_imm64(out, pos, PHYS_R8, -1)
    emit_mov_imm64(out, pos, PHYS_R9, 0)
    emit_syscall_instr(out, pos)
    let keep_res = 1
    if ins.id < 0 { keep_res = 0 }
    if ins.id >= 8192 { keep_res = 0 }
    if ctx.use_cnt[ins.id] <= 0 { keep_res = 0 }
    if keep_res == 1 {
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
        let alsp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, alsp)
        ra_set_spill(&ctx.ra, ins.id, alsp)
        emit_store_spill(out, pos, alsp, dst)
    } else {
        emit_restore_pool(ctx.ra, out, pos)
    }
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    ret 1
}

fn try_inline_call(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    // Try to inline known small functions instead of full CALL sequence.
    // Uses save_pool/restore_pool to avoid register eviction bugs:
    // multiple get_or_load calls can evict earlier args' registers.
    let src = g_src_buf_ptr
    let nlen = ins.str_len
    let nstart = ins.str_start
    let argc = ins.operand3

    // emit_byte(out, pos, b) — 3 args
    if nlen == 9 and argc == 3 {
        if streq(src, nstart, 9, "emit_byte") == 1 {
            // Save context, load args, emit inline body, restore
            emit_push_r(out, pos, PHYS_R12)
            emit_save_pool(ctx.ra, out, pos)
            // Load each arg and push immediately (safe from eviction)
            let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
            emit_push_r(out, pos, r0)
            let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
            emit_push_r(out, pos, r1)
            let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
            emit_push_r(out, pos, r2)
            // Pop into calling convention regs
            emit_pop_r(out, pos, PHYS_RDX)
            emit_pop_r(out, pos, PHYS_RSI)
            emit_pop_r(out, pos, PHYS_RDI)
            // Inline body as raw bytes:
            // MOV R12, [RSI]:  4C 8B 26
            emit_byte(out, pos, 0x4C)
            emit_byte(out, pos, 0x8B)
            emit_byte(out, pos, 0x26)
            // ADD R12, RDI:    49 01 FC
            emit_byte(out, pos, 0x49)
            emit_byte(out, pos, 0x01)
            emit_byte(out, pos, 0xFC)
            // MOV [R12], DL:   41 88 14 24
            emit_byte(out, pos, 0x41)
            emit_byte(out, pos, 0x88)
            emit_byte(out, pos, 0x14)
            emit_byte(out, pos, 0x24)
            // MOV R12, [RSI]:  4C 8B 26
            emit_byte(out, pos, 0x4C)
            emit_byte(out, pos, 0x8B)
            emit_byte(out, pos, 0x26)
            // INC R12:         49 FF C4
            emit_byte(out, pos, 0x49)
            emit_byte(out, pos, 0xFF)
            emit_byte(out, pos, 0xC4)
            // MOV [RSI], R12:  4C 89 26
            emit_byte(out, pos, 0x4C)
            emit_byte(out, pos, 0x89)
            emit_byte(out, pos, 0x26)
            emit_restore_pool(ctx.ra, out, pos)
            emit_pop_r(out, pos, PHYS_R12)
            consume_use(ctx, ins.operand0)
            consume_use(ctx, ins.operand1)
            consume_use(ctx, ins.operand2)
            ret 1
        }
    }

    // poke_byte(buf, off, val) — 3 args
    if nlen == 9 and argc == 3 {
        if streq(src, nstart, 9, "poke_byte") == 1 {
            emit_push_r(out, pos, PHYS_R12)
            emit_save_pool(ctx.ra, out, pos)
            let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
            emit_push_r(out, pos, r0)
            let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
            emit_push_r(out, pos, r1)
            let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
            emit_push_r(out, pos, r2)
            emit_pop_r(out, pos, PHYS_RDX)
            emit_pop_r(out, pos, PHYS_RSI)
            emit_pop_r(out, pos, PHYS_RDI)
            // Inline body as raw bytes: buf[off] = val
            // RDI=buf, RSI=off, RDX=val, R12=scratch
            // MOV R12, RDI:  4C 8B E7
            emit_byte(out, pos, 0x4C)
            emit_byte(out, pos, 0x8B)
            emit_byte(out, pos, 0xE7)
            // ADD R12, RSI:  49 01 F4
            emit_byte(out, pos, 0x49)
            emit_byte(out, pos, 0x01)
            emit_byte(out, pos, 0xF4)
            // MOV [R12], DL: 41 88 14 24
            emit_byte(out, pos, 0x41)
            emit_byte(out, pos, 0x88)
            emit_byte(out, pos, 0x14)
            emit_byte(out, pos, 0x24)
            emit_restore_pool(ctx.ra, out, pos)
            emit_pop_r(out, pos, PHYS_R12)
            consume_use(ctx, ins.operand0)
            consume_use(ctx, ins.operand1)
            consume_use(ctx, ins.operand2)
            ret 1
        }
    }

    ret 0
}

fn lower_tail_call(ins: &Instr, ctx: &LowerCtx, jfn: &JirFunction, out: &i8, pos: &i64) -> i64 {
    if ins.op != OP_TAIL_CALL { ret 0 }
    // Load args with push-pop pattern (same as regular call)
    let vals = i64[6]
    vals[0] = ins.operand0
    vals[1] = ins.operand1
    vals[2] = ins.operand2
    vals[3] = ins.bb_target0
    vals[4] = ins.bb_target1
    vals[5] = ins.imm
    let push_idx = 0
    let push_lim = ins.operand3
    if push_lim > 6 { push_lim = 6 }
    loop push_idx < push_lim {
        let r = get_or_load(ctx.ra, out, pos, vals[push_idx])
        emit_push_r(out, pos, r)
        push_idx = push_idx + 1
    }
    // Pop in reverse order to calling convention registers
    let regs = i32[6]
    regs[0] = PHYS_RDI
    regs[1] = PHYS_RSI
    regs[2] = PHYS_RDX
    regs[3] = PHYS_RCX
    regs[4] = PHYS_R8
    regs[5] = PHYS_R9
    let pop_idx = push_lim - 1
    loop pop_idx >= 0 {
        emit_pop_r(out, pos, regs[pop_idx])
        pop_idx = pop_idx - 1
    }
    // Store args to param slots so BB0 reads fresh values
    let si = 0
    loop si < push_lim {
        emit_store_spill(out, pos, jfn.param_slots[si], regs[si])
        si = si + 1
    }
    // Consume uses
    let ci = 0
    loop ci < push_lim {
        consume_use(ctx, vals[ci])
        ci = ci + 1
    }
    // JMP to BB 0 (function entry)
    lower_branch_fixup(ctx, pos, 0, pos[0] + 1, 0)
    emit_jmp_rel32(out, pos, 0)
    ret 1
}

fn lower_instr_call(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let is_call = 0
    if ins.op == OP_CALL { is_call = 1 }
    if ins.op == OP_CALL_IND { is_call = 1 }
    if is_call != 1 { ret 0 }
    // Handle indirect calls directly — avoid capturing 4-arg return value
    if ins.op == OP_CALL_IND {
        lower_instr_call_ind(ins, ctx, out, pos)
        ret 1
    }
    let inlined = try_inline_call(ins, ctx, out, pos)
    if inlined == 1 { ret 1 }
    emit_save_pool(ctx.ra, out, pos)
    lower_instr_call_args(ins, ctx, out, pos)
    lower_instr_call_emit(ins, ctx, out, pos)
    let argc_vals = i64[6]
    argc_vals[0] = ins.operand0
    argc_vals[1] = ins.operand1
    argc_vals[2] = ins.operand2
    argc_vals[3] = ins.bb_target0
    argc_vals[4] = ins.bb_target1
    argc_vals[5] = ins.imm
    let ci = 0
    let clim = ins.operand3
    if clim > 6 { clim = 6 }
    loop ci < clim {
        consume_use(ctx, argc_vals[ci])
        ci = ci + 1
    }
    ret 1
}

fn lower_instr_call_args(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let vals = i64[6]
    vals[0] = ins.operand0
    vals[1] = ins.operand1
    vals[2] = ins.operand2
    vals[3] = ins.bb_target0
    vals[4] = ins.bb_target1
    vals[5] = ins.imm
    let push_lim = ins.operand3
    if push_lim > 6 { push_lim = 6 }
    // Single-arg: direct MOV to RDI, skip push/pop
    if push_lim == 1 {
        let r = get_or_load(ctx.ra, out, pos, vals[0])
        if r != PHYS_RDI { emit_mov_rr(out, pos, PHYS_RDI, r) }
        ret
    }
    let push_idx = 0
    loop push_idx < push_lim {
        let r = get_or_load(ctx.ra, out, pos, vals[push_idx])
        emit_push_r(out, pos, r)
        push_idx = push_idx + 1
    }
    // Pop in reverse order to target registers
    let regs = i32[6]
    regs[0] = PHYS_RDI
    regs[1] = PHYS_RSI
    regs[2] = PHYS_RDX
    regs[3] = PHYS_RCX
    regs[4] = PHYS_R8
    regs[5] = PHYS_R9
    let pop_idx = push_lim - 1
    loop pop_idx >= 0 {
        emit_pop_r(out, pos, regs[pop_idx])
        pop_idx = pop_idx - 1
    }
}

fn lower_instr_call_emit(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let room = 1
    if ctx.fix_cnt >= 8192 { room = 0 }
    if room != 1 { panic("Lower fixup overflow") }
    let fix_idx = ctx.fix_cnt
    fixup_init(&ctx.fixups[fix_idx], pos[0] + 1, ins.str_start, 2, ins.str_len)
    ctx.fix_cnt = ctx.fix_cnt + 1
    emit_call_rel32(out, pos, 0)
    let keep_res = 1
    if ins.id < 0 { keep_res = 0 }
    if ins.id >= 8192 { keep_res = 0 }
    if ctx.use_cnt[ins.id] <= 0 { keep_res = 0 }
    if keep_res == 1 {
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
        let cesp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, cesp)
        ra_set_spill(&ctx.ra, ins.id, cesp)
        emit_store_spill(out, pos, cesp, dst)
    } else {
        emit_restore_pool(ctx.ra, out, pos)
    }
}

fn lower_instr_drop(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op != OP_DROP { ret 0 }
    // munmap(ptr, size): rax=11, rdi=ptr, rsi=size
    emit_save_pool(ctx.ra, out, pos)
    let ptr_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    if ptr_r != PHYS_RDI { emit_mov_rr(out, pos, PHYS_RDI, ptr_r) }
    let sz_r = get_or_load(ctx.ra, out, pos, ins.operand1)
    if sz_r != PHYS_RSI { emit_mov_rr(out, pos, PHYS_RSI, sz_r) }
    emit_mov_imm64(out, pos, PHYS_RAX, 11)
    emit_syscall_instr(out, pos)
    emit_restore_pool(ctx.ra, out, pos)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    ret 1
}

fn lower_instr_call_ind(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op != OP_CALL_IND { ret 0 }
    // operand0=fn_ptr, operand1..=args, operand3=total_argc (fn_ptr + real args)
    // Use ins.operand3 directly to avoid local variable corruption across 4-arg calls
    emit_save_pool(ctx.ra, out, pos)
    // Push fn pointer (operand0)
    let fn_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, fn_r)
    // Push real args using ins.operand3 directly (avoids corrupted local)
    // argc >= 2 means real_argc >= 1 (at least 1 real arg beyond fn_ptr)
    if ins.operand3 >= 2 { let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)   emit_push_r(out, pos, r1) }
    if ins.operand3 >= 3 { let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)   emit_push_r(out, pos, r2) }
    if ins.operand3 >= 4 { let r3 = get_or_load(ctx.ra, out, pos, ins.bb_target0) emit_push_r(out, pos, r3) }
    if ins.operand3 >= 5 { let r4 = get_or_load(ctx.ra, out, pos, ins.bb_target1) emit_push_r(out, pos, r4) }
    if ins.operand3 >= 6 { let r5 = get_or_load(ctx.ra, out, pos, ins.imm)        emit_push_r(out, pos, r5) }
    // Pop args into calling convention regs (reverse order)
    if ins.operand3 >= 6 { emit_pop_r(out, pos, PHYS_R9) }
    if ins.operand3 >= 5 { emit_pop_r(out, pos, PHYS_R8) }
    if ins.operand3 >= 4 { emit_pop_r(out, pos, PHYS_RDX) }
    if ins.operand3 >= 3 { emit_pop_r(out, pos, PHYS_RSI) }
    if ins.operand3 >= 2 { emit_pop_r(out, pos, PHYS_RDI) }
    // Pop fn pointer into RAX and call
    emit_pop_r(out, pos, PHYS_RAX)
    // call rax: FF D0
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xD0)
    // Capture return value: mov r12,rax (4C 8B E0) then restore pool
    let keep_res = 1
    if ins.id < 0 { keep_res = 0 }
    if ins.id >= 8192 { keep_res = 0 }
    if ctx.use_cnt[ins.id] <= 0 { keep_res = 0 }
    if keep_res == 1 {
        // mov r12, rax: 4C 8B E0 (inline to avoid 4-arg emit_mov_rr)
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x8B)
        emit_byte(out, pos, 0xE0)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 { emit_mov_rr(out, pos, dst, PHYS_R12) }
        let cesp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, cesp)
        ra_set_spill(&ctx.ra, ins.id, cesp)
        emit_store_spill(out, pos, cesp, dst)
    } else {
        emit_restore_pool(ctx.ra, out, pos)
    }
    // Consume uses
    consume_use(ctx, ins.operand0)
    if ins.operand3 >= 2 { consume_use(ctx, ins.operand1) }
    if ins.operand3 >= 3 { consume_use(ctx, ins.operand2) }
    if ins.operand3 >= 4 { consume_use(ctx, ins.bb_target0) }
    if ins.operand3 >= 5 { consume_use(ctx, ins.bb_target1) }
    if ins.operand3 >= 6 { consume_use(ctx, ins.imm) }
    ret 1
}

fn lower_instr_callalloc2(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let handled = lower_instr_alloc(ins, ctx, out, pos)
    if handled == 1 { ret 1 }
    ret lower_instr_call(ins, ctx, out, pos)
}

fn lower_instr_callalloc(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let did_alloc = lower_instr_alloc(ins, ctx, out, pos)
    let handled = did_alloc
    let did_call = lower_instr_call(ins, ctx, out, pos)
    if did_call == 1 { handled = 1 }
    ret handled
}

fn emit_trunc32(out: &i8, pos: &i64, reg: i32) {
    // mov eXX, eXX — zero extends to 64 bits
    let need_rex = 0
    if reg >= 8 { need_rex = 1 }
    if need_rex == 1 {
        let reg_hi = reg / 8
        let rb = 64 + reg_hi * 4 + reg_hi
        emit_byte(out, pos, rb)
    }
    emit_byte(out, pos, 0x89)
    let r3 = mod8(reg)
    emit_byte(out, pos, 0xC0 + (r3 * 8) + r3)
}

fn emit_ctx_switch_save(out: &i8, pos: &i64) {
    // Save from context (RDI = from_ptr):
    // mov [rdi+0], rsp: 48 89 67 00
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x67)
    emit_byte(out, pos, 0x00)
    // mov [rdi+8], rbp: 48 89 6F 08
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x6F)
    emit_byte(out, pos, 0x08)
    // lea rax, [rip+55]: 48 8D 05 37 00 00 00
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x05)
    emit_byte(out, pos, 0x37)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    // mov [rdi+16], rax: 48 89 47 10
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x47)
    emit_byte(out, pos, 0x10)
    // mov [rdi+24], rbx: 48 89 5F 18
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x5F)
    emit_byte(out, pos, 0x18)
    // mov [rdi+32], r12: 4C 89 67 20
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x67)
    emit_byte(out, pos, 0x20)
    // mov [rdi+40], r13: 4C 89 6F 28
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x6F)
    emit_byte(out, pos, 0x28)
    // mov [rdi+48], r14: 4C 89 77 30
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x77)
    emit_byte(out, pos, 0x30)
    // mov [rdi+56], r15: 4C 89 7F 38
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x7F)
    emit_byte(out, pos, 0x38)
}

fn emit_ctx_switch_restore(out: &i8, pos: &i64) {
    // Restore to context (RSI = to_ptr):
    // mov rsp, [rsi+0]: 48 8B 66 00
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x00)
    // mov rbp, [rsi+8]: 48 8B 6E 08
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x6E)
    emit_byte(out, pos, 0x08)
    // mov rbx, [rsi+24]: 48 8B 5E 18
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x5E)
    emit_byte(out, pos, 0x18)
    // mov r12, [rsi+32]: 4C 8B 66 20
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x20)
    // mov r13, [rsi+40]: 4C 8B 6E 28
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x6E)
    emit_byte(out, pos, 0x28)
    // mov r14, [rsi+48]: 4C 8B 76 30
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x76)
    emit_byte(out, pos, 0x30)
    // mov r15, [rsi+56]: 4C 8B 7E 38
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x7E)
    emit_byte(out, pos, 0x38)
    // jmp [rsi+16]: FF 66 10
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x10)
    // .resume lands here (offset 70 from LEA)
}

fn lower_instr_atomic(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op

    // OP_ATOMIC_LOAD: atomic_load(ptr) -> val
    // x86-64 MOV is naturally acquire-ordered on aligned addresses
    // Emit: MOV dst, [ptr]
    if op == OP_ATOMIC_LOAD {
        let ptr_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_load_mem_reg(out, pos, dst, ptr_r)
        consume_use(ctx, ins.operand0)
        ret 1
    }

    // OP_ATOMIC_STORE: atomic_store(ptr, val)
    // Use XCHG [ptr], val — XCHG has implicit LOCK prefix (full barrier)
    // Encoding: REX.W 87 /r with ModRM=[base]
    if op == OP_ATOMIC_STORE {
        let ptr_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        let val_r = get_or_load(ctx.ra, out, pos, ins.operand1)
        // XCHG [ptr_r], val_r: REX.W 0x87 ModRM
        let val_hi = val_r / 8
        let ptr_hi = ptr_r / 8
        let rex = 72 + val_hi * 4 + ptr_hi
        emit_byte(out, pos, rex)
        emit_byte(out, pos, 0x87)
        let val3 = mod8(val_r)
        let ptr3 = mod8(ptr_r)
        if ptr3 == 4 {
            emit_byte(out, pos, (val3 * 8) + 0x04)
            emit_byte(out, pos, 0x24)
        } else if ptr3 == 5 {
            emit_byte(out, pos, 0x40 + (val3 * 8) + ptr3)
            emit_byte(out, pos, 0)
        } else {
            emit_byte(out, pos, (val3 * 8) + ptr3)
        }
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }

    // OP_ATOMIC_CAS: atomic_cmpxchg(ptr, expected, desired) -> old_val
    // LOCK CMPXCHG [ptr], desired
    // RAX must hold expected value; after: RAX = old value, ZF set if swapped
    // Encoding: F0 REX.W 0F B1 /r
    // Use push/pop pattern to avoid register clobbering between operands
    if op == OP_ATOMIC_CAS {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        // Load and push all three operands onto the stack
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
        emit_push_r(out, pos, r2)
        // Pop into fixed registers: desired→RCX, expected→RAX, ptr→RDI
        emit_pop_r(out, pos, PHYS_RCX)
        emit_pop_r(out, pos, PHYS_RAX)
        emit_pop_r(out, pos, PHYS_RDI)
        // LOCK CMPXCHG [RDI], RCX
        // F0 48 0F B1 0F
        emit_byte(out, pos, 0xF0)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0xB1)
        emit_byte(out, pos, 0x0F)
        // Result (old value) is in RAX — move to R12 then restore pool
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
        emit_pop_r(out, pos, PHYS_R12)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        consume_use(ctx, ins.operand2)
        ret 1
    }

    // OP_ATOMIC_ADD: atomic_fetch_add(ptr, val) -> old_val
    // LOCK XADD [ptr], val — atomically adds, returns old value in val register
    // Encoding: F0 REX.W 0F C1 /r
    // Use push/pop pattern to avoid register clobbering
    if op == OP_ATOMIC_ADD {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        // Pop val→RCX, ptr→RDI
        emit_pop_r(out, pos, PHYS_RCX)
        emit_pop_r(out, pos, PHYS_RDI)
        // LOCK XADD [RDI], RCX
        // F0 48 0F C1 0F
        emit_byte(out, pos, 0xF0)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0xC1)
        emit_byte(out, pos, 0x0F)
        // Old value now in RCX — move to R12 then restore pool
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RCX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
        emit_pop_r(out, pos, PHYS_R12)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }

    // OP_RDTSC: rdtsc() -> u64
    // RDTSC puts low 32 bits in EAX, high 32 bits in EDX
    // Combine: SHL RDX,32; OR RAX,RDX
    if op == OP_RDTSC {
        emit_save_pool(ctx.ra, out, pos)
        // RDTSC: 0F 31
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x31)
        // SHL RDX, 32: REX.W C1 /4 20
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC1)
        emit_byte(out, pos, 0xE2)
        emit_byte(out, pos, 32)
        // OR RAX, RDX: REX.W 09 D0
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x09)
        emit_byte(out, pos, 0xD0)
        // Result in RAX — move to R12 then restore pool
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
        ret 1
    }

    // OP_CTX_SWITCH: ctx_switch(from_ptr, to_ptr)
    if op == OP_CTX_SWITCH {
        emit_save_pool(ctx.ra, out, pos)
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        emit_pop_r(out, pos, PHYS_RSI)
        emit_pop_r(out, pos, PHYS_RDI)
        emit_ctx_switch_save(out, pos)
        emit_ctx_switch_restore(out, pos)
        emit_restore_pool(ctx.ra, out, pos)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }

    // OP_FN_ADDR: LEA RAX, [RIP+disp32] with fixup
    if op == OP_FN_ADDR {
        emit_save_pool(ctx.ra, out, pos)
        let fix_ok = 1
        if ctx.fix_cnt >= 8192 { fix_ok = 0 }
        if fix_ok != 1 { panic("fn_addr fixup overflow") }
        fixup_init(&ctx.fixups[ctx.fix_cnt], pos[0] + 3, ins.str_start, 2, ins.str_len)
        ctx.fix_cnt = ctx.fix_cnt + 1
        // LEA RAX, [RIP+0]: 48 8D 05 00 00 00 00
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x05)
        emit_byte(out, pos, 0)
        emit_byte(out, pos, 0)
        emit_byte(out, pos, 0)
        emit_byte(out, pos, 0)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
        ret 1
    }

    ret 0
}

// emit MOV reg, [base + disp8]: REX.W 8B ModRM(01,reg,base) disp8
fn emit_load_disp8(out: &i8, pos: &i64, dst: i32, base: i32, disp: i64) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    emit_byte(out, pos, 72 + dst_hi * 4 + base_hi)
    emit_byte(out, pos, 0x8B)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    if base3 == 4 {
        emit_byte(out, pos, 0x44 + dst3 * 8)
        emit_byte(out, pos, 0x24)
    } else {
        emit_byte(out, pos, 0x40 + dst3 * 8 + base3)
    }
    emit_byte(out, pos, disp)
}

// emit MOV [base + disp8], src: REX.W 89 ModRM(01,src,base) disp8
fn emit_store_disp8(out: &i8, pos: &i64, base: i32, disp: i64, src: i32) {
    let src_hi = src / 8
    let base_hi = base / 8
    emit_byte(out, pos, 72 + src_hi * 4 + base_hi)
    emit_byte(out, pos, 0x89)
    let src3 = mod8(src)
    let base3 = mod8(base)
    if base3 == 4 {
        emit_byte(out, pos, 0x44 + src3 * 8)
        emit_byte(out, pos, 0x24)
    } else {
        emit_byte(out, pos, 0x40 + src3 * 8 + base3)
    }
    emit_byte(out, pos, disp)
}

// emit MOV [base + idx*8], src: REX.W 89 ModRM(00,src,100) SIB(11,idx,base)
fn emit_store_sib8(out: &i8, pos: &i64, base: i32, idx: i32, src: i32) {
    let src_hi = src / 8
    let base_hi = base / 8
    let idx_hi = idx / 8
    emit_byte(out, pos, 72 + src_hi * 4 + idx_hi * 2 + base_hi)
    emit_byte(out, pos, 0x89)
    let src3 = mod8(src)
    let base3 = mod8(base)
    let idx3 = mod8(idx)
    emit_byte(out, pos, src3 * 8 + 4)
    emit_byte(out, pos, 0xC0 + idx3 * 8 + base3)
}

// emit MOV dst, [base + idx*8]: REX.W 8B ModRM(00,dst,100) SIB(11,idx,base)
fn emit_load_sib8(out: &i8, pos: &i64, dst: i32, base: i32, idx: i32) {
    let dst_hi = dst / 8
    let base_hi = base / 8
    let idx_hi = idx / 8
    emit_byte(out, pos, 72 + dst_hi * 4 + idx_hi * 2 + base_hi)
    emit_byte(out, pos, 0x8B)
    let dst3 = mod8(dst)
    let base3 = mod8(base)
    let idx3 = mod8(idx)
    emit_byte(out, pos, dst3 * 8 + 4)
    emit_byte(out, pos, 0xC0 + idx3 * 8 + base3)
}

fn lower_instr_chan(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op

    // OP_CHAN_NEW: chan_new(cap) -> channel pointer
    // Channel layout: [cap(0), head(8), tail(16), count(24), closed(32), buf(40+)]
    // Allocate (cap*8+40) bytes via mmap, store cap at offset 0.
    // mmap returns zeroed pages so head/tail/count/closed are already 0.
    if op == OP_CHAN_NEW {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        // Compute size = cap*8 + 40 + 4095, round to page
        let cap_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, cap_r)
        // pop cap into RCX, compute size in RSI
        emit_pop_r(out, pos, PHYS_RCX)
        // RSI = RCX * 8: LEA RSI, [RCX*8]
        // Use SHL RCX,3 then ADD RCX,4095+40 then AND RCX,~4095 then MOV RSI,RCX
        // Simpler: MOV RSI, RCX; SHL RSI, 3; ADD RSI, 4136; AND RSI, -4096
        emit_mov_rr(out, pos, PHYS_RSI, PHYS_RCX)
        // SHL RSI, 3: 48 C1 E6 03
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC1)
        emit_byte(out, pos, 0xE6)
        emit_byte(out, pos, 3)
        // ADD RSI, 4136 (40 header + 4096-1 for rounding): 48 81 C6 imm32
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x81)
        emit_byte(out, pos, 0xC6)
        emit_byte(out, pos, 0x28)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0)
        emit_byte(out, pos, 0)
        // AND RSI, -4096: 48 81 E6 00 F0 FF FF
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x81)
        emit_byte(out, pos, 0xE6)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0xF0)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xFF)
        // Save cap (RCX) across syscall — syscall clobbers RCX and R11
        emit_push_r(out, pos, PHYS_RCX)
        // mmap(0, RSI, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
        emit_mov_imm64(out, pos, PHYS_RAX, 9)
        emit_mov_imm64(out, pos, PHYS_RDI, 0)
        emit_mov_imm64(out, pos, PHYS_RDX, 3)
        emit_mov_imm64(out, pos, PHYS_R10, 0x22)
        emit_mov_imm64(out, pos, PHYS_R8, -1)
        emit_mov_imm64(out, pos, PHYS_R9, 0)
        emit_syscall_instr(out, pos)
        // Restore cap into RCX
        emit_pop_r(out, pos, PHYS_RCX)
        // RAX = channel pointer, store cap at [RAX+0]
        emit_store_disp8(out, pos, PHYS_RAX, 0, PHYS_RCX)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 { emit_mov_rr(out, pos, dst, PHYS_R12) }
        let cnsp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, cnsp)
        ra_set_spill(&ctx.ra, ins.id, cnsp)
        emit_store_spill(out, pos, cnsp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        consume_use(ctx, ins.operand0)
        ret 1
    }

    // OP_CHAN_SEND: chan_send(ch, val) -> 0=ok, 1=full, -1=closed
    if op == OP_CHAN_SEND {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        emit_pop_r(out, pos, PHYS_RSI)
        emit_pop_r(out, pos, PHYS_RDI)
        // RDI=ch, RSI=val
        // Check closed: if [RDI+32] != 0, return -1
        emit_load_disp8(out, pos, PHYS_RAX, PHYS_RDI, 32)
        emit_cmp_zero(out, pos, PHYS_RAX)
        // JNE .closed (forward jump, patch later)
        emit_byte(out, pos, 0x75)
        let closed_patch = pos[0]
        emit_byte(out, pos, 0)
        // Check full: load count=[RDI+24], cap=[RDI]
        emit_load_disp8(out, pos, PHYS_RCX, PHYS_RDI, 24)
        emit_load_mem_reg(out, pos, PHYS_RDX, PHYS_RDI)
        emit_cmp_rr(out, pos, PHYS_RCX, PHYS_RDX)
        // JE .full (forward jump, patch later)
        emit_byte(out, pos, 0x74)
        let full_patch = pos[0]
        emit_byte(out, pos, 0)
        // Load tail=[RDI+16] into RAX
        emit_load_disp8(out, pos, PHYS_RAX, PHYS_RDI, 16)
        // Compute buf_base = RDI + 40 into RDX
        emit_mov_rr(out, pos, PHYS_RDX, PHYS_RDI)
        // ADD RDX, 40: 48 83 C2 28
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC2)
        emit_byte(out, pos, 40)
        // MOV [RDX + RAX*8], RSI
        emit_store_sib8(out, pos, PHYS_RDX, PHYS_RAX, PHYS_RSI)
        // tail++: INC RAX (48 FF C0)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC0)
        // if tail == cap, wrap to 0: load cap again into RDX
        emit_load_mem_reg(out, pos, PHYS_RDX, PHYS_RDI)
        emit_cmp_rr(out, pos, PHYS_RAX, PHYS_RDX)
        // JNE +2 (skip XOR)
        emit_byte(out, pos, 0x75)
        emit_byte(out, pos, 2)
        // XOR EAX, EAX (31 C0)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)
        // Store tail: MOV [RDI+16], RAX
        emit_store_disp8(out, pos, PHYS_RDI, 16, PHYS_RAX)
        // count++: load, inc, store
        emit_load_disp8(out, pos, PHYS_RCX, PHYS_RDI, 24)
        // INC RCX (48 FF C1)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC1)
        emit_store_disp8(out, pos, PHYS_RDI, 24, PHYS_RCX)
        // Return 0: XOR EAX, EAX
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)
        // JMP .done
        emit_byte(out, pos, 0xEB)
        let done_patch = pos[0]
        emit_byte(out, pos, 0)
        // .full: return 1
        let full_target = pos[0]
        let full_rel = full_target - full_patch
        poke_byte(out, full_patch, full_rel - 1)
        emit_mov_imm64(out, pos, PHYS_RAX, 1)
        // JMP .done
        emit_byte(out, pos, 0xEB)
        let done_patch2 = pos[0]
        emit_byte(out, pos, 0)
        // .closed: return -1
        let closed_target = pos[0]
        let closed_rel = closed_target - closed_patch
        poke_byte(out, closed_patch, closed_rel - 1)
        emit_mov_imm64(out, pos, PHYS_RAX, -1)
        // .done:
        let done_target = pos[0]
        let done_rel1 = done_target - done_patch
        let done_rel2 = done_target - done_patch2
        poke_byte(out, done_patch, done_rel1 - 1)
        poke_byte(out, done_patch2, done_rel2 - 1)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 { emit_mov_rr(out, pos, dst, PHYS_R12) }
        let cssp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, cssp)
        ra_set_spill(&ctx.ra, ins.id, cssp)
        emit_store_spill(out, pos, cssp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }

    // OP_CHAN_RECV: chan_recv(ch) -> value, or -1 if closed+empty, -2 if empty
    if op == OP_CHAN_RECV {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        emit_pop_r(out, pos, PHYS_RDI)
        // RDI=ch
        // Load count=[RDI+24]
        emit_load_disp8(out, pos, PHYS_RCX, PHYS_RDI, 24)
        emit_cmp_zero(out, pos, PHYS_RCX)
        // JNE .has_data (forward jump, patch later)
        emit_byte(out, pos, 0x75)
        let has_data_patch = pos[0]
        emit_byte(out, pos, 0)
        // count==0: check closed
        emit_load_disp8(out, pos, PHYS_RAX, PHYS_RDI, 32)
        emit_cmp_zero(out, pos, PHYS_RAX)
        // JNE .closed_empty
        emit_byte(out, pos, 0x75)
        let closed_patch = pos[0]
        emit_byte(out, pos, 0)
        // empty but not closed: return -2
        emit_mov_imm64(out, pos, PHYS_RAX, -2)
        // JMP .done
        emit_byte(out, pos, 0xEB)
        let done_patch = pos[0]
        emit_byte(out, pos, 0)
        // .closed_empty: return -1
        let closed_target = pos[0]
        let cr_closed_rel = closed_target - closed_patch
        poke_byte(out, closed_patch, cr_closed_rel - 1)
        emit_mov_imm64(out, pos, PHYS_RAX, -1)
        // JMP .done
        emit_byte(out, pos, 0xEB)
        let done_patch2 = pos[0]
        emit_byte(out, pos, 0)
        // .has_data:
        let has_data_target = pos[0]
        let hd_rel = has_data_target - has_data_patch
        poke_byte(out, has_data_patch, hd_rel - 1)
        // Load head=[RDI+8] into RAX
        emit_load_disp8(out, pos, PHYS_RAX, PHYS_RDI, 8)
        // Compute buf_base = RDI + 40 into RDX
        emit_mov_rr(out, pos, PHYS_RDX, PHYS_RDI)
        // ADD RDX, 40
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC2)
        emit_byte(out, pos, 40)
        // Load value: MOV RSI, [RDX + RAX*8]
        emit_load_sib8(out, pos, PHYS_RSI, PHYS_RDX, PHYS_RAX)
        // head++: INC RAX
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC0)
        // if head == cap, wrap to 0
        emit_load_mem_reg(out, pos, PHYS_RDX, PHYS_RDI)
        emit_cmp_rr(out, pos, PHYS_RAX, PHYS_RDX)
        // JNE +2
        emit_byte(out, pos, 0x75)
        emit_byte(out, pos, 2)
        // XOR EAX, EAX
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)
        // Store head: MOV [RDI+8], RAX
        emit_store_disp8(out, pos, PHYS_RDI, 8, PHYS_RAX)
        // count--: load, dec, store
        emit_load_disp8(out, pos, PHYS_RCX, PHYS_RDI, 24)
        // DEC RCX (48 FF C9)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC9)
        emit_store_disp8(out, pos, PHYS_RDI, 24, PHYS_RCX)
        // Return value in RSI -> RAX
        emit_mov_rr(out, pos, PHYS_RAX, PHYS_RSI)
        // .done:
        let done_target = pos[0]
        let cr_done_r1 = done_target - done_patch
        let cr_done_r2 = done_target - done_patch2
        poke_byte(out, done_patch, cr_done_r1 - 1)
        poke_byte(out, done_patch2, cr_done_r2 - 1)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 { emit_mov_rr(out, pos, dst, PHYS_R12) }
        let crsp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, crsp)
        ra_set_spill(&ctx.ra, ins.id, crsp)
        emit_store_spill(out, pos, crsp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        consume_use(ctx, ins.operand0)
        ret 1
    }

    // OP_CHAN_CLOSE: chan_close(ch) -> 0
    if op == OP_CHAN_CLOSE {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        emit_pop_r(out, pos, PHYS_RDI)
        // MOV qword [RDI+32], 1: store 1 at closed flag
        emit_mov_imm64(out, pos, PHYS_RAX, 1)
        emit_store_disp8(out, pos, PHYS_RDI, 32, PHYS_RAX)
        // Return 0
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 { emit_mov_rr(out, pos, dst, PHYS_R12) }
        let ccsp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, ccsp)
        ra_set_spill(&ctx.ra, ins.id, ccsp)
        emit_store_spill(out, pos, ccsp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        consume_use(ctx, ins.operand0)
        ret 1
    }

    ret 0
}

// ── M6: OS thread pool builtins ──────────────────────────────────────
fn lower_instr_mt(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op

    // ── get_nprocs() ─────────────────────────────────────────────────
    // sched_getaffinity(pid=0, size=128, mask_buf) → count set bits
    // Returns number of online CPUs
    if op == OP_GET_NPROCS {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        // Allocate 128 bytes on stack for cpu mask
        // SUB RSP, 128
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x81)
        emit_byte(out, pos, 0xEC)
        emit_i32_le(out, pos, 128)

        // rdi = 0 (pid = self)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xFF)
        // rsi = 128 (mask size)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC6)
        emit_i32_le(out, pos, 128)
        // rdx = rsp (mask buffer)
        emit_mov_rr(out, pos, PHYS_RDX, PHYS_RSP)
        // rax = 204 (SYS_sched_getaffinity)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 204)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // rax = bytes returned. Now count set bits in mask.
        // Save byte count in RCX, use RSI as pointer, RDX as counter
        emit_mov_rr(out, pos, PHYS_RCX, PHYS_RAX)
        emit_mov_rr(out, pos, PHYS_RSI, PHYS_RSP)
        // XOR EDX, EDX  (bit count = 0)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xD2)
        // XOR R8D, R8D  (byte index = 0)
        emit_byte(out, pos, 0x45)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)

        // .outer_loop:
        let outer_loop = pos[0]
        // CMP R8, RCX  (using 0x3B: reg-rm, so R8 - RCX)
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x3B)
        emit_byte(out, pos, 0xC1)
        // JGE .done (forward, patch later)
        emit_byte(out, pos, 0x7D)
        let done_patch = pos[0]
        emit_byte(out, pos, 0x00)

        // MOVZX EAX, byte [RSI + R8]
        emit_byte(out, pos, 0x42)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0xB6)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x06)

        // Count bits in AL using shift loop (8 iterations)
        // R9 = 8
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC1)
        emit_i32_le(out, pos, 8)
        // .bit_loop:
        let bit_loop = pos[0]
        // TEST AL, 1
        emit_byte(out, pos, 0xA8)
        emit_byte(out, pos, 0x01)
        // JZ +3 (skip INC RDX)
        emit_byte(out, pos, 0x74)
        emit_byte(out, pos, 0x03)
        // INC RDX
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC2)
        // SHR AL, 1
        emit_byte(out, pos, 0xD0)
        emit_byte(out, pos, 0xE8)
        // DEC R9
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC9)
        // JNZ .bit_loop
        emit_byte(out, pos, 0x75)
        let bit_back = pos[0] - bit_loop
        let bit_neg = 0 - bit_back
        let bit_rel = bit_neg - 1
        emit_byte(out, pos, bit_rel + 256)

        // INC R8
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC0)
        // JMP .outer_loop
        emit_byte(out, pos, 0xEB)
        let outer_back = pos[0] - outer_loop
        let outer_neg = 0 - outer_back
        let outer_rel = outer_neg - 1
        emit_byte(out, pos, outer_rel + 256)

        // .done:
        let done_target = pos[0]
        let done_diff = done_target - done_patch
        poke_byte(out, done_patch, done_diff - 1)

        // Result in RDX → move to R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RDX)

        // ADD RSP, 128 (restore stack)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x81)
        emit_byte(out, pos, 0xC4)
        emit_i32_le(out, pos, 128)

        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    // ── clone_thread(stack_top, fn_ptr) ─────────────────────────────
    // Creates an OS thread via clone() syscall.
    // stack_top: top of pre-allocated stack for child
    // fn_ptr: function address child should call (stored at top of child stack)
    // Returns: tid in parent, 0 in child
    if op == OP_CLONE_THREAD {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        consume_use(ctx, ins.operand0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        consume_use(ctx, ins.operand1)

        // Pop fn_ptr → R9, stack_top → RSI
        emit_pop_r(out, pos, PHYS_R9)
        emit_pop_r(out, pos, PHYS_RSI)

        // Store fn_ptr at [stack_top - 8] so child can RET into it
        // SUB RSI, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEE)
        emit_byte(out, pos, 8)
        // MOV [RSI], R9
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0x0E)

        // rdi = flags = 0x10F00
        // CLONE_VM|CLONE_FS|CLONE_FILES|CLONE_SIGHAND|CLONE_THREAD|CLONE_SYSVSEM
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC7)
        emit_i32_le(out, pos, 69376)
        // rsi = child_stack (already set)
        // rdx = 0 (parent_tid_ptr)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xD2)
        // r10 = 0 (child_tid_ptr)
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xD2)
        // r8 = 0 (tls)
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)
        // rax = 56 (SYS_clone)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 56)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // In child: rax=0. Child's RSP points to fn_ptr, so RET jumps there.
        // In parent: rax=tid.
        // TEST RAX, RAX
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x85)
        emit_byte(out, pos, 0xC0)
        // JNZ .parent (skip child RET)
        emit_byte(out, pos, 0x75)
        emit_byte(out, pos, 0x01)
        // RET (child jumps to fn_ptr via stack)
        emit_byte(out, pos, 0xC3)
        // .parent:

        // Result (tid) in RAX → R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    // ── futex_wait(addr, expected) ──────────────────────────────────
    // futex(addr, FUTEX_WAIT=0, expected, NULL, NULL, 0)
    // Returns: 0 on success, -EAGAIN if *addr != expected, -EINTR if interrupted
    if op == OP_FUTEX_WAIT {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        consume_use(ctx, ins.operand0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        consume_use(ctx, ins.operand1)

        // Pop expected → RDX, addr → RDI
        emit_pop_r(out, pos, PHYS_RDX)
        emit_pop_r(out, pos, PHYS_RDI)

        // rsi = 0 (FUTEX_WAIT)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xF6)
        // r10 = 0 (timeout = NULL)
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xD2)
        // r8 = 0
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)
        // r9 = 0
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC9)
        // rax = 202 (SYS_futex)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 202)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // Result in RAX → R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    // ── futex_wake(addr, count) ─────────────────────────────────────
    // futex(addr, FUTEX_WAKE=1, count, NULL, NULL, 0)
    // Returns: number of waiters woken
    if op == OP_FUTEX_WAKE {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        consume_use(ctx, ins.operand0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        consume_use(ctx, ins.operand1)

        // Pop count → RDX, addr → RDI
        emit_pop_r(out, pos, PHYS_RDX)
        emit_pop_r(out, pos, PHYS_RDI)

        // rsi = 1 (FUTEX_WAKE)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC6)
        emit_i32_le(out, pos, 1)
        // r10 = 0
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xD2)
        // r8 = 0
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC0)
        // r9 = 0
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xC9)
        // rax = 202 (SYS_futex)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 202)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // Result in RAX → R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    // ── get_tid() ───────────────────────────────────────────────────
    // gettid() syscall 186 — returns current thread ID
    if op == OP_GET_TID {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        // rax = 186 (SYS_gettid)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 186)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // Result in RAX → R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    ret 0
}

// ── M8: deadlock detection ──────────────────────────────────────────
fn lower_instr_deadlock(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op != OP_DEADLOCK_CHK { ret 0 }

    // deadlock_check(ready_cnt, blocked_cnt, io_pending)
    // If ready==0 AND blocked>0 AND io_pending==0 → print "DEADLOCK\n", exit(1)
    // Otherwise return 0
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)

    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    consume_use(ctx, ins.operand0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    consume_use(ctx, ins.operand1)
    let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, r2)
    consume_use(ctx, ins.operand2)

    // Pop: io_pending→RDX, blocked→RSI, ready→RDI
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RSI)
    emit_pop_r(out, pos, PHYS_RDI)

    // Check ready == 0
    // TEST RDI, RDI
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x85)
    emit_byte(out, pos, 0xFF)
    // JNZ .no_deadlock
    emit_byte(out, pos, 0x75)
    let no_dl_patch1 = pos[0]
    emit_byte(out, pos, 0x00)

    // Check blocked > 0
    // TEST RSI, RSI
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x85)
    emit_byte(out, pos, 0xF6)
    // JZ .no_deadlock
    emit_byte(out, pos, 0x74)
    let no_dl_patch2 = pos[0]
    emit_byte(out, pos, 0x00)

    // Check io_pending == 0
    // TEST RDX, RDX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x85)
    emit_byte(out, pos, 0xD2)
    // JNZ .no_deadlock
    emit_byte(out, pos, 0x75)
    let no_dl_patch3 = pos[0]
    emit_byte(out, pos, 0x00)

    // === DEADLOCK DETECTED ===
    // Write "DEADLOCK\n" to stdout (fd=1)
    // Store string on stack: "DEADLOCK\n" = 44 45 41 44 4C 4F 43 4B 0A
    // SUB RSP, 16 (align)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xEC)
    emit_byte(out, pos, 16)
    // MOV DWORD [RSP], 0x44414544  "DEAD"
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x04)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x45)
    emit_byte(out, pos, 0x41)
    emit_byte(out, pos, 0x44)
    // MOV DWORD [RSP+4], 0x0A4B434F  "LOCK\n" (little-endian: 4F=O, 43=C, 4B=K, 0A=\n)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 4)
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x4F)
    emit_byte(out, pos, 0x43)
    emit_byte(out, pos, 0x4B)
    // MOV BYTE [RSP+8], 0x0A  '\n'
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 8)
    emit_byte(out, pos, 0x0A)

    // write(1, rsp, 9) — syscall 1
    // RDI = 1 (stdout)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC7)
    emit_i32_le(out, pos, 1)
    // RSI = RSP (buffer)
    emit_mov_rr(out, pos, PHYS_RSI, PHYS_RSP)
    // RDX = 9 (length)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC2)
    emit_i32_le(out, pos, 9)
    // RAX = 1 (SYS_write)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC0)
    emit_i32_le(out, pos, 1)
    // syscall
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x05)

    // exit(1) — syscall 60
    // RDI = 1
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC7)
    emit_i32_le(out, pos, 1)
    // RAX = 60 (SYS_exit_group = 231 actually, but 60 = SYS_exit)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0xC0)
    emit_i32_le(out, pos, 231)
    // syscall
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x05)

    // .no_deadlock:
    let no_dl_target = pos[0]
    let nd1 = no_dl_target - no_dl_patch1
    poke_byte(out, no_dl_patch1, nd1 - 1)
    let nd2 = no_dl_target - no_dl_patch2
    poke_byte(out, no_dl_patch2, nd2 - 1)
    let nd3 = no_dl_target - no_dl_patch3
    poke_byte(out, no_dl_patch3, nd3 - 1)

    // Return 0 (no deadlock)
    // XOR R12D, R12D
    emit_byte(out, pos, 0x45)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xE4)

    emit_restore_pool(ctx.ra, out, pos)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    let sp = ctx.ra.sp_top + 8
    ra_set_sp_top(&ctx.ra, sp)
    ra_set_spill(&ctx.ra, ins.id, sp)
    emit_store_spill(out, pos, sp, dst)
    emit_pop_r(out, pos, PHYS_R12)
    ret 1
}

// ── M7: epoll builtins ──────────────────────────────────────────────
fn lower_instr_epoll(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op

    // ── epoll_create1(flags) ────────────────────────────────────────
    // syscall 291: epoll_create1(flags) → epfd
    if op == OP_EPOLL_CREATE {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_RDI, r0)
        consume_use(ctx, ins.operand0)

        // rax = 291 (SYS_epoll_create1)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 291)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // Result in RAX → R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    // ── epoll_ctl(epfd, op, fd, event_ptr) ──────────────────────────
    // syscall 233: epoll_ctl(epfd, op, fd, event) → 0 or -errno
    if op == OP_EPOLL_CTL {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        // Load all 4 operands via push/pop to avoid register conflicts
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        consume_use(ctx, ins.operand0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        consume_use(ctx, ins.operand1)
        let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
        emit_push_r(out, pos, r2)
        consume_use(ctx, ins.operand2)
        let r3 = get_or_load(ctx.ra, out, pos, ins.bb_target0)
        emit_push_r(out, pos, r3)
        consume_use(ctx, ins.bb_target0)

        // Pop into syscall registers: event→R10, fd→RDX, op→RSI, epfd→RDI
        // R10 = event_ptr (4th syscall arg)
        emit_byte(out, pos, 0x41)
        emit_byte(out, pos, 0x5A)
        // RDX = fd
        emit_pop_r(out, pos, PHYS_RDX)
        // RSI = op
        emit_pop_r(out, pos, PHYS_RSI)
        // RDI = epfd
        emit_pop_r(out, pos, PHYS_RDI)

        // rax = 233 (SYS_epoll_ctl)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 233)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // Result in RAX → R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    // ── epoll_wait(epfd, events, maxevents, timeout) ────────────────
    // syscall 232: epoll_wait(epfd, events, maxevents, timeout) → nfds or -errno
    if op == OP_EPOLL_WAIT {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)

        // Load all 4 operands via push/pop
        let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r0)
        consume_use(ctx, ins.operand0)
        let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r1)
        consume_use(ctx, ins.operand1)
        let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
        emit_push_r(out, pos, r2)
        consume_use(ctx, ins.operand2)
        let r3 = get_or_load(ctx.ra, out, pos, ins.bb_target0)
        emit_push_r(out, pos, r3)
        consume_use(ctx, ins.bb_target0)

        // Pop into syscall registers: timeout→R10, maxevents→RDX, events→RSI, epfd→RDI
        // R10 = timeout (4th syscall arg)
        emit_byte(out, pos, 0x41)
        emit_byte(out, pos, 0x5A)
        // RDX = maxevents
        emit_pop_r(out, pos, PHYS_RDX)
        // RSI = events
        emit_pop_r(out, pos, PHYS_RSI)
        // RDI = epfd
        emit_pop_r(out, pos, PHYS_RDI)

        // rax = 232 (SYS_epoll_wait)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 232)
        // syscall
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)

        // Result in RAX → R12
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        let sp = ctx.ra.sp_top + 8
        ra_set_sp_top(&ctx.ra, sp)
        ra_set_spill(&ctx.ra, ins.id, sp)
        emit_store_spill(out, pos, sp, dst)
        emit_pop_r(out, pos, PHYS_R12)
        ret 1
    }

    ret 0
}

// === Float / SSE helpers (Phase 7 M1) ===

fn emit_movsd_load_spill(out: &i8, pos: &i64, xmm: i64, spill_off: i64) {
    // MOVSD xmm, [RBP - spill_off]  (F2 0F 10 modrm disp32)
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x10)
    let modrm = 0x85 + xmm * 8
    emit_byte(out, pos, modrm)
    let neg = 0 - spill_off
    emit_i32_le(out, pos, neg)
}

fn emit_movsd_store_spill(out: &i8, pos: &i64, xmm: i64, spill_off: i64) {
    // MOVSD [RBP - spill_off], xmm  (F2 0F 11 modrm disp32)
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x11)
    let modrm = 0x85 + xmm * 8
    emit_byte(out, pos, modrm)
    let neg = 0 - spill_off
    emit_i32_le(out, pos, neg)
}

fn emit_sse_rr(out: &i8, pos: &i64, prefix: i64, opcode: i64, dst_xmm: i64, src_xmm: i64) {
    // prefix 0F opcode ModRM(11, dst, src)
    emit_byte(out, pos, prefix)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, opcode)
    let modrm = 0xC0 + dst_xmm * 8 + src_xmm
    emit_byte(out, pos, modrm)
}

fn emit_movq_gpr_to_xmm(out: &i8, pos: &i64, xmm: i64, gpr: i64) {
    // MOVQ XMMn, GPR  (66 REX.W 0F 6E modrm)
    emit_byte(out, pos, 0x66)
    let rex = 0x48
    if gpr >= 8 { rex = rex + 1 }
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x6E)
    let rm = gpr
    if gpr >= 8 { rm = gpr - 8 }
    let modrm = 0xC0 + xmm * 8 + rm
    emit_byte(out, pos, modrm)
}

fn emit_movq_xmm_to_gpr(out: &i8, pos: &i64, gpr: i64, xmm: i64) {
    // MOVQ GPR, XMMn  (66 REX.W 0F 7E modrm)
    emit_byte(out, pos, 0x66)
    let rex = 0x48
    if gpr >= 8 { rex = rex + 1 }
    if xmm >= 8 { rex = rex + 4 }
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x7E)
    let rd = gpr
    if gpr >= 8 { rd = gpr - 8 }
    let modrm = 0xC0 + xmm * 8 + rd
    emit_byte(out, pos, modrm)
}

fn lower_instr_float(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op

    // OP_I2F: convert integer to f64, result as i64 bits in GPR
    if op == OP_I2F {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        // CVTSI2SD XMM0, src_r
        emit_byte(out, pos, 0xF2)
        let rex_w = 0x48
        if src_r >= 8 { rex_w = rex_w + 1 }
        emit_byte(out, pos, rex_w)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x2A)
        let rm = src_r
        if src_r >= 8 { rm = src_r - 8 }
        emit_byte(out, pos, 0xC0 + rm)
        consume_use(ctx, ins.operand0)
        // MOVQ dst, XMM0 (move float bits directly to allocated GPR)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_F2I: convert f64 to integer
    if op == OP_F2I {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        // MOVQ XMM0, src_r (load float bits into XMM)
        emit_movq_gpr_to_xmm(out, pos, 0, src_r)
        consume_use(ctx, ins.operand0)
        // CVTTSD2SI RAX, XMM0  (F2 48 0F 2C C0)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x2C)
        emit_byte(out, pos, 0xC0)
        // Put result in a GPR register
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_RAX)
        ret 1
    }

    // Binary float ops: FADD, FSUB, FMUL, FDIV
    let is_fbin = 0
    let fbin_op = 0
    if op == OP_FADD { is_fbin = 1 }
    if op == OP_FADD { fbin_op = 0x58 }
    if op == OP_FSUB { is_fbin = 1 }
    if op == OP_FSUB { fbin_op = 0x5C }
    if op == OP_FMUL { is_fbin = 1 }
    if op == OP_FMUL { fbin_op = 0x59 }
    if op == OP_FDIV { is_fbin = 1 }
    if op == OP_FDIV { fbin_op = 0x5E }
    if is_fbin == 1 {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        let b_r = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_movq_gpr_to_xmm(out, pos, 1, b_r)
        emit_sse_rr(out, pos, 0xF2, fbin_op, 0, 1)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        // MOVQ dst, XMM0 (result bits directly to allocated GPR — avoids RAX clobber)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // Unary float ops: FNEG, FSQRT
    if op == OP_FNEG {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        // XOR sign bit: load 0x8000000000000000 into RAX, MOVQ XMM1 RAX, XORPD
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xB8)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x80)
        emit_movq_gpr_to_xmm(out, pos, 1, PHYS_RAX)
        emit_sse_rr(out, pos, 0x66, 0x57, 0, 1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }
    if op == OP_FSQRT {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        emit_sse_rr(out, pos, 0xF2, 0x51, 0, 0)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // Float comparisons: result is integer 0 or 1
    let is_fcmp = 0
    if op == OP_FCMP_LT { is_fcmp = 1 }
    if op == OP_FCMP_GT { is_fcmp = 2 }
    if op == OP_FCMP_EQ { is_fcmp = 3 }
    if is_fcmp > 0 {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        let b_r = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_movq_gpr_to_xmm(out, pos, 1, b_r)
        // UCOMISD XMM0, XMM1
        emit_sse_rr(out, pos, 0x66, 0x2E, 0, 1)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        if is_fcmp == 1 {
            // SETB AL (below = less than for UCOMISD)
            emit_byte(out, pos, 0x0F)
            emit_byte(out, pos, 0x92)
            emit_byte(out, pos, 0xC0)
        }
        if is_fcmp == 2 {
            // SETA AL (above = greater than for UCOMISD)
            emit_byte(out, pos, 0x0F)
            emit_byte(out, pos, 0x97)
            emit_byte(out, pos, 0xC0)
        }
        if is_fcmp == 3 {
            // SETE AL + SETNP CL (equal and not NaN)
            emit_byte(out, pos, 0x0F)
            emit_byte(out, pos, 0x94)
            emit_byte(out, pos, 0xC0)
            emit_byte(out, pos, 0x0F)
            emit_byte(out, pos, 0x9B)
            emit_byte(out, pos, 0xC1)
            // AND AL, CL
            emit_byte(out, pos, 0x20)
            emit_byte(out, pos, 0xC8)
        }
        // MOVZX RAX, AL  (48 0F B6 C0)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0xB6)
        emit_byte(out, pos, 0xC0)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_RAX)
        ret 1
    }

    // OP_FABS: clear sign bit
    if op == OP_FABS {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        // Load 0x7FFFFFFFFFFFFFFF into RAX then XMM1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xB8)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0x7F)
        emit_movq_gpr_to_xmm(out, pos, 1, PHYS_RAX)
        // ANDPD XMM0, XMM1  (66 0F 54 C1)
        emit_byte(out, pos, 0x66)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x54)
        emit_byte(out, pos, 0xC1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_FSIN: sin(x) via x87 FPU
    if op == OP_FSIN {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        // SUB RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEC)
        emit_byte(out, pos, 8)
        // MOVSD [RSP], XMM0  (F2 0F 11 04 24)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLD QWORD [RSP]  (DD 04 24)
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FSIN  (D9 FE)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFE)
        // FSTP QWORD [RSP]  (DD 1C 24)
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x1C)
        emit_byte(out, pos, 0x24)
        // MOVSD XMM0, [RSP]  (F2 0F 10 04 24)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // ADD RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC4)
        emit_byte(out, pos, 8)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_FCOS: cos(x) via x87 FPU
    if op == OP_FCOS {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        // SUB RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEC)
        emit_byte(out, pos, 8)
        // MOVSD [RSP], XMM0
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLD QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FCOS  (D9 FF)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFF)
        // FSTP QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x1C)
        emit_byte(out, pos, 0x24)
        // MOVSD XMM0, [RSP]
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // ADD RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC4)
        emit_byte(out, pos, 8)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_FEXP: exp(x) via x87 FPU (2^(x * log2(e)))
    if op == OP_FEXP {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        // SUB RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEC)
        emit_byte(out, pos, 8)
        // MOVSD [RSP], XMM0
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLD QWORD [RSP]  ST0 = x
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLDL2E  ST0 = log2(e), ST1 = x
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xEA)
        // FMULP ST1, ST0  ST0 = x * log2(e)
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xC9)
        // FLD ST0  duplicate
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xC0)
        // FRNDINT  ST0 = round(t), ST1 = t
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFC)
        // FSUB ST1, ST0  ST1 = frac, ST0 = int
        emit_byte(out, pos, 0xDC)
        emit_byte(out, pos, 0xE9)
        // FXCH  ST0 = frac, ST1 = int
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xC9)
        // F2XM1  ST0 = 2^frac - 1
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xF0)
        // FLD1  ST0 = 1
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xE8)
        // FADDP ST1, ST0  ST0 = 2^frac, ST1 = int
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xC1)
        // FSCALE  ST0 = 2^frac * 2^int = exp(x)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFD)
        // FSTP ST1  pop the integer part
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0xD9)
        // FSTP QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x1C)
        emit_byte(out, pos, 0x24)
        // MOVSD XMM0, [RSP]
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // ADD RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC4)
        emit_byte(out, pos, 8)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_FLOG: log(x) = ln(2) * log2(x) via x87 FYL2X
    if op == OP_FLOG {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        // SUB RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEC)
        emit_byte(out, pos, 8)
        // MOVSD [RSP], XMM0
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLDLN2  ST0 = ln(2)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xED)
        // FLD QWORD [RSP]  ST0 = x, ST1 = ln(2)
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FYL2X  ST0 = ln(2) * log2(x) = ln(x)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xF1)
        // FSTP QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x1C)
        emit_byte(out, pos, 0x24)
        // MOVSD XMM0, [RSP]
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // ADD RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC4)
        emit_byte(out, pos, 8)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_FPOW: pow(x, y) = 2^(y * log2(x)) via x87
    if op == OP_FPOW {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        let b_r = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_movq_gpr_to_xmm(out, pos, 1, b_r)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        // SUB RSP, 16
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEC)
        emit_byte(out, pos, 16)
        // MOVSD [RSP], XMM0  (x)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // MOVSD [RSP+8], XMM1  (y)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 8)
        // FLD QWORD [RSP+8]  ST0 = y
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x44)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 8)
        // FLD QWORD [RSP]  ST0 = x, ST1 = y
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FYL2X  ST0 = y * log2(x)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xF1)
        // 2^ST0 sequence (same as exp)
        // FLD ST0
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xC0)
        // FRNDINT
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFC)
        // FSUB ST1, ST0
        emit_byte(out, pos, 0xDC)
        emit_byte(out, pos, 0xE9)
        // FXCH
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xC9)
        // F2XM1
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xF0)
        // FLD1
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xE8)
        // FADDP ST1, ST0
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xC1)
        // FSCALE
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFD)
        // FSTP ST1
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0xD9)
        // FSTP QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x1C)
        emit_byte(out, pos, 0x24)
        // MOVSD XMM0, [RSP]
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // ADD RSP, 16
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC4)
        emit_byte(out, pos, 16)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_FTANH: tanh(x) = (exp(2x) - 1) / (exp(2x) + 1) via x87
    if op == OP_FTANH {
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)
        consume_use(ctx, ins.operand0)
        // SUB RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEC)
        emit_byte(out, pos, 8)
        // ADDSD XMM0, XMM0  (2x)
        emit_sse_rr(out, pos, 0xF2, 0x58, 0, 0)
        // MOVSD [RSP], XMM0
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLD QWORD [RSP]  ST0 = 2x
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLDL2E  ST0 = log2(e), ST1 = 2x
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xEA)
        // FMULP  ST0 = 2x * log2(e)
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xC9)
        // 2^ST0 sequence
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xC0)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFC)
        emit_byte(out, pos, 0xDC)
        emit_byte(out, pos, 0xE9)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xC9)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xF0)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xE8)
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xC1)
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xFD)
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0xD9)
        // ST0 = exp(2x). Store to [RSP] and reload for numerator/denominator
        // FSTP QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x1C)
        emit_byte(out, pos, 0x24)
        // Load exp(2x) back for numerator: exp(2x) - 1
        // FLD QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLD1
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xE8)
        // FSUBP ST1, ST0  ST0 = exp(2x) - 1
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xE9)
        // Load exp(2x) for denominator: exp(2x) + 1
        // FLD QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // FLD1
        emit_byte(out, pos, 0xD9)
        emit_byte(out, pos, 0xE8)
        // FADDP ST1, ST0  ST0 = exp(2x) + 1, ST1 = exp(2x) - 1
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xC1)
        // FDIVP ST1, ST0  ST0 = (exp(2x) - 1) / (exp(2x) + 1) but reversed!
        // FDIVP divides ST1 / ST0 and stores in ST1, pops ST0
        // We want (exp(2x)-1) / (exp(2x)+1), ST1=exp(2x)-1, ST0=exp(2x)+1
        // FDIVP ST1, ST0 = ST1/ST0 → correct!
        emit_byte(out, pos, 0xDE)
        emit_byte(out, pos, 0xF9)
        // FSTP QWORD [RSP]
        emit_byte(out, pos, 0xDD)
        emit_byte(out, pos, 0x1C)
        emit_byte(out, pos, 0x24)
        // MOVSD XMM0, [RSP]
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // ADD RSP, 8
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC4)
        emit_byte(out, pos, 8)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_movq_xmm_to_gpr(out, pos, dst, 0)
        ret 1
    }

    // OP_PRINT_FLOAT
    if op == OP_PRINT_FLOAT {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let a_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_movq_gpr_to_xmm(out, pos, 0, a_r)

        // sub rsp, 48  (buffer for digits)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xEC)
        emit_byte(out, pos, 48)

        // Check negative: XORPD XMM3,XMM3 then UCOMISD XMM3,XMM0
        emit_sse_rr(out, pos, 0x66, 0x57, 3, 3)
        emit_sse_rr(out, pos, 0x66, 0x2E, 3, 0)
        // JA .is_neg (if 0 > value, value is negative)
        let jbe_pos = pos[0]
        emit_byte(out, pos, 0x77)
        emit_byte(out, pos, 0x00)

        // Not negative, jump ahead
        let jmp_nn = pos[0]
        emit_byte(out, pos, 0xEB)
        emit_byte(out, pos, 0x00)

        // .is_neg: print '-', negate
        let is_neg_pos = pos[0]
        let ja_diff = is_neg_pos - jbe_pos
        let ja_disp = ja_diff - 2
        poke_byte(out, jbe_pos + 1, ja_disp)
        // mov byte [rsp], 45  ('-')
        emit_byte(out, pos, 0xC6)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 45)
        // write(1, rsp, 1): mov rax, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 1)
        // mov rdi, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC7)
        emit_i32_le(out, pos, 1)
        // mov rsi, rsp
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xE6)
        // mov rdx, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC2)
        emit_i32_le(out, pos, 1)
        emit_syscall_instr(out, pos)
        // Negate: MOV RAX, 0x8000000000000000
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xB8)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x00)
        emit_byte(out, pos, 0x80)
        // MOVQ XMM1, RAX  (66 48 0F 6E C8)
        emit_byte(out, pos, 0x66)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x6E)
        emit_byte(out, pos, 0xC8)
        // XORPD XMM0, XMM1
        emit_sse_rr(out, pos, 0x66, 0x57, 0, 1)

        // .not_neg:
        let not_neg_pos = pos[0]
        let nn_diff = not_neg_pos - jmp_nn
        let nn_disp = nn_diff - 2
        poke_byte(out, jmp_nn + 1, nn_disp)

        // CVTTSD2SI R12, XMM0  (F2 4C 0F 2C E0)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x2C)
        emit_byte(out, pos, 0xE0)
        // Get fractional part: MOV RAX, R12
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xE0)
        // CVTSI2SD XMM1, RAX  (F2 48 0F 2A C8)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x2A)
        emit_byte(out, pos, 0xC8)
        // SUBSD XMM0, XMM1
        emit_sse_rr(out, pos, 0xF2, 0x5C, 0, 1)
        // MOVSD [RSP+8], XMM0  (save fractional part)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x11)
        emit_byte(out, pos, 0x44)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 8)

        // Print integer part (R12) using div loop
        // lea rcx, [rsp+47]
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 47)
        // mov byte [rcx], 0
        emit_byte(out, pos, 0xC6)
        emit_byte(out, pos, 0x01)
        emit_byte(out, pos, 0)
        // mov r8, r12
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xE0)
        // mov r9, 10
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC1)
        emit_i32_le(out, pos, 10)
        // digit loop: xor rdx, rdx
        let int_loop = pos[0]
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xD2)
        // mov rax, r8
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xC0)
        // div r9
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xF7)
        emit_byte(out, pos, 0xF1)
        // add dl, 48
        emit_byte(out, pos, 0x80)
        emit_byte(out, pos, 0xC2)
        emit_byte(out, pos, 48)
        // dec rcx
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xC9)
        // mov [rcx], dl
        emit_byte(out, pos, 0x88)
        emit_byte(out, pos, 0x11)
        // mov r8, rax
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xC0)
        // test rax, rax
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x85)
        emit_byte(out, pos, 0xC0)
        let jnz_target = pos[0] + 2
        let jnz_back = int_loop - jnz_target
        emit_byte(out, pos, 0x75)
        emit_byte(out, pos, mod256(jnz_back))
        // write integer part: mov rax, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 1)
        // mov rdi, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC7)
        emit_i32_le(out, pos, 1)
        // mov rsi, rcx
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xCE)
        // lea rdx, [rsp+47]
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x54)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 47)
        // sub rdx, rcx
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x29)
        emit_byte(out, pos, 0xCA)
        emit_syscall_instr(out, pos)

        // Print '.': mov byte [rsp], 46
        emit_byte(out, pos, 0xC6)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 46)
        // mov rax, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 1)
        // mov rdi, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC7)
        emit_i32_le(out, pos, 1)
        // mov rsi, rsp
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xE6)
        // mov rdx, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC2)
        emit_i32_le(out, pos, 1)
        emit_syscall_instr(out, pos)

        // Print 6 fractional digits
        // MOVSD XMM0, [RSP+8]  (reload frac)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x10)
        emit_byte(out, pos, 0x44)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 8)
        // MOV R12, 10
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC4)
        emit_i32_le(out, pos, 10)
        // CVTSI2SD XMM2, R12 (10.0) via RAX
        emit_byte(out, pos, 0x4C)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xE0)
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x2A)
        emit_byte(out, pos, 0xD0)
        // MOV R12, 6 (digit counter)
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC4)
        emit_i32_le(out, pos, 6)
        // frac digit loop
        let frac_loop = pos[0]
        // MULSD XMM0, XMM2
        emit_sse_rr(out, pos, 0xF2, 0x59, 0, 2)
        // CVTTSD2SI RAX, XMM0
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x2C)
        emit_byte(out, pos, 0xC0)
        // add al, 48
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 48)
        // mov [rsp], al
        emit_byte(out, pos, 0x88)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        // sub al, 48  (get digit value back)
        emit_byte(out, pos, 0x2C)
        emit_byte(out, pos, 48)
        // movzx eax, al
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0xB6)
        emit_byte(out, pos, 0xC0)
        // CVTSI2SD XMM1, RAX
        emit_byte(out, pos, 0xF2)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x2A)
        emit_byte(out, pos, 0xC8)
        // SUBSD XMM0, XMM1
        emit_sse_rr(out, pos, 0xF2, 0x5C, 0, 1)
        // write digit: mov rax, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 1)
        // mov rdi, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC7)
        emit_i32_le(out, pos, 1)
        // mov rsi, rsp
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xE6)
        // mov rdx, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC2)
        emit_i32_le(out, pos, 1)
        emit_syscall_instr(out, pos)
        // dec R12
        emit_byte(out, pos, 0x49)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0xCC)
        // test r12, r12
        emit_byte(out, pos, 0x4D)
        emit_byte(out, pos, 0x85)
        emit_byte(out, pos, 0xE4)
        let jnz_ftarget = pos[0] + 2
        let jnz_frac = frac_loop - jnz_ftarget
        emit_byte(out, pos, 0x75)
        emit_byte(out, pos, mod256(jnz_frac))

        // Print newline: mov byte [rsp], 10
        emit_byte(out, pos, 0xC6)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0x24)
        emit_byte(out, pos, 10)
        // mov rax, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 1)
        // mov rdi, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC7)
        emit_i32_le(out, pos, 1)
        // mov rsi, rsp
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xE6)
        // mov rdx, 1
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC2)
        emit_i32_le(out, pos, 1)
        emit_syscall_instr(out, pos)

        // add rsp, 48
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x83)
        emit_byte(out, pos, 0xC4)
        emit_byte(out, pos, 48)
        emit_restore_pool(ctx.ra, out, pos)
        emit_pop_r(out, pos, PHYS_R12)
        consume_use(ctx, ins.operand0)
        ret 1
    }

    ret 0
}

fn lower_tensor_new1(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let len_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_mov_rr(out, pos, PHYS_RDI, len_r)
    // RSI = len * 8 + 80
    emit_mov_rr(out, pos, PHYS_RSI, PHYS_RDI)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE6)
    emit_byte(out, pos, 3)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 80)
    // Save len across mmap
    emit_push_r(out, pos, PHYS_RDI)
    emit_push_r(out, pos, PHYS_RSI)
    emit_mov_imm64(out, pos, PHYS_RAX, 9)
    emit_mov_imm64(out, pos, PHYS_RDI, 0)
    emit_mov_imm64(out, pos, PHYS_RDX, 3)
    emit_mov_imm64(out, pos, PHYS_R10, 0x22)
    emit_mov_imm64(out, pos, PHYS_R8, -1)
    emit_mov_imm64(out, pos, PHYS_R9, 0)
    emit_syscall_instr(out, pos)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDI)
    // RAX = mmap result; RDI = len
    // [RAX+0] = ndim = 1
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x00)
    emit_i32_le(out, pos, 1)
    // [RAX+8] = len
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x78)
    emit_byte(out, pos, 0x08)
    // [RAX+16] = shape[0] = len
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x78)
    emit_byte(out, pos, 0x10)
    // [RAX+48] = strides[0] = 1
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x40)
    emit_byte(out, pos, 0x30)
    emit_i32_le(out, pos, 1)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
}

fn lower_tensor_new2(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDI)
    // RSI = rows * cols
    emit_mov_rr(out, pos, PHYS_RSI, PHYS_RDI)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xAF)
    emit_byte(out, pos, 0xF1)
    // Save rows, cols, total_len across mmap
    emit_push_r(out, pos, PHYS_RDI)
    emit_push_r(out, pos, PHYS_RCX)
    emit_push_r(out, pos, PHYS_RSI)
    // RSI = total_len * 8 + 80
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE6)
    emit_byte(out, pos, 3)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 80)
    emit_mov_imm64(out, pos, PHYS_RAX, 9)
    emit_mov_imm64(out, pos, PHYS_RDI, 0)
    emit_mov_imm64(out, pos, PHYS_RDX, 3)
    emit_mov_imm64(out, pos, PHYS_R10, 0x22)
    emit_mov_imm64(out, pos, PHYS_R8, -1)
    emit_mov_imm64(out, pos, PHYS_R9, 0)
    emit_syscall_instr(out, pos)
    emit_pop_r(out, pos, PHYS_RSI)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDI)
    // RAX = ptr; RDI = rows; RCX = cols; RSI = total_len
    // [RAX+0] = ndim = 2
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x00)
    emit_i32_le(out, pos, 2)
    // [RAX+8] = total_len
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x70)
    emit_byte(out, pos, 0x08)
    // [RAX+16] = shape[0] = rows
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x78)
    emit_byte(out, pos, 0x10)
    // [RAX+24] = shape[1] = cols
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x18)
    // [RAX+48] = strides[0] = cols
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x30)
    // [RAX+56] = strides[1] = 1
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x40)
    emit_byte(out, pos, 0x38)
    emit_i32_le(out, pos, 1)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
}

fn lower_tensor_free(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let t_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_mov_rr(out, pos, PHYS_RDI, t_r)
    // RSI = [RDI+8] (len)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x77)
    emit_byte(out, pos, 0x08)
    // SHL RSI, 3
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE6)
    emit_byte(out, pos, 3)
    // ADD RSI, 80
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 80)
    // munmap(RDI, RSI)
    emit_mov_imm64(out, pos, PHYS_RAX, 11)
    emit_syscall_instr(out, pos)
    emit_restore_pool(ctx.ra, out, pos)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
}

fn lower_tensor_get(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let t_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, t_r)
    let idx_r = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, idx_r)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDI)
    // LEA RAX, [RDI+0x50]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x47)
    emit_byte(out, pos, 0x50)
    // MOV RAX, [RAX+RCX*8]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x04)
    emit_byte(out, pos, 0xC8)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

fn lower_tensor_set(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let t_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, t_r)
    let idx_r = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, idx_r)
    let val_r = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, val_r)
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDI)
    // LEA RAX, [RDI+0x50]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x47)
    emit_byte(out, pos, 0x50)
    // MOV [RAX+RCX*8], RDX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x14)
    emit_byte(out, pos, 0xC8)
    emit_restore_pool(ctx.ra, out, pos)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
}

fn lower_tensor_fill(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let t_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, t_r)
    let val_r = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, val_r)
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RDI)
    // RCX = [RDI+8] (len)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, 0x4F)
    emit_byte(out, pos, 0x08)
    // RSI = RDI + 80 (data area)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x77)
    emit_byte(out, pos, 0x50)
    // RAX = 0 (loop counter)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xC0)
    let loop_off = pos[0]
    // CMP RAX, RCX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x39)
    emit_byte(out, pos, 0xC8)
    let jge_off = pos[0]
    // JGE done
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8D)
    emit_i32_le(out, pos, 0)
    // MOV [RSI+RAX*8], RDX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x14)
    emit_byte(out, pos, 0xC6)
    // INC RAX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC0)
    let jmp_rel = loop_off - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel)
    let done_off = pos[0]
    let jge_rel = done_off - (jge_off + 6)
    poke_byte(out, jge_off + 2, i32_b0(jge_rel))
    poke_byte(out, jge_off + 3, i32_b1(jge_rel))
    poke_byte(out, jge_off + 4, i32_b2(jge_rel))
    poke_byte(out, jge_off + 5, i32_b3(jge_rel))
    emit_restore_pool(ctx.ra, out, pos)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
}

fn lower_tensor_meta(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let op = ins.op
    if op == OP_TLEN {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let t_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_RDI, t_r)
        // MOV RAX, [RDI+8]
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8B)
        emit_byte(out, pos, 0x47)
        emit_byte(out, pos, 0x08)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        consume_use(ctx, ins.operand0)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
        emit_pop_r(out, pos, PHYS_R12)
    }
    if op == OP_TSHAPE {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let t_r2 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, t_r2)
        let dim_r = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, dim_r)
        emit_pop_r(out, pos, PHYS_RCX)
        emit_pop_r(out, pos, PHYS_RDI)
        // LEA RAX, [RDI+0x10]
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x47)
        emit_byte(out, pos, 0x10)
        // MOV RAX, [RAX+RCX*8]
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8B)
        emit_byte(out, pos, 0x04)
        emit_byte(out, pos, 0xC8)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        let dst2 = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst2, PHYS_R12)
        emit_pop_r(out, pos, PHYS_R12)
    }
    if op == OP_TDATA {
        emit_push_r(out, pos, PHYS_R12)
        emit_save_pool(ctx.ra, out, pos)
        let t_r3 = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_mov_rr(out, pos, PHYS_RDI, t_r3)
        // LEA RAX, [RDI+0x50]
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x47)
        emit_byte(out, pos, 0x50)
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        consume_use(ctx, ins.operand0)
        let dst3 = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst3, PHYS_R12)
        emit_pop_r(out, pos, PHYS_R12)
    }
}

// ── AVX-512 lowering ──────────────────────────────────────────────────

fn lower_avx512_check(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // CPUID leaf 7 ECX=0 → EBX bit 16 = AVX-512F
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    // push rbx (CPUID clobbers it)
    emit_push_r(out, pos, PHYS_RBX)
    // xor ecx, ecx  (31 C9)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xC9)
    // mov eax, 7  (B8 07 00 00 00)
    emit_byte(out, pos, 0xB8)
    emit_byte(out, pos, 0x07)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    // cpuid  (0F A2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xA2)
    // bt ebx, 16  (0F BA E3 10)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xBA)
    emit_byte(out, pos, 0xE3)
    emit_byte(out, pos, 0x10)
    // pop rbx
    emit_pop_r(out, pos, PHYS_RBX)
    // sbb rax, rax  (48 19 C0) — sets RAX to -1 if CF=1, 0 if CF=0
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x19)
    emit_byte(out, pos, 0xC0)
    // neg rax  (48 F7 D8) — -1 → 1, 0 → 0
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xF7)
    emit_byte(out, pos, 0xD8)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

// Helper: emit EVEX 4-byte prefix
// mm: map (1=0F, 2=0F38), vvvv: src2 reg (0-7), W: 0 or 1
// reg_hi/rm_hi: 0 for regs 0-7
fn emit_evex(out: &i8, pos: &i64, mm: i64, W: i64, vvvv: i64, LL: i64) {
    // Byte 0: 0x62
    emit_byte(out, pos, 0x62)
    // P0: R~=1 X~=1 B~=1 R'~=1 0 0 mm
    let p0 = 0xF0 + mm
    emit_byte(out, pos, p0)
    // P1: W vvvv~ 1 pp(01=66)
    let nvvvv = 15 - vvvv
    let p1_lo = nvvvv * 8
    let p1 = W * 128 + p1_lo + 5
    emit_byte(out, pos, p1)
    // P2: z=0 L'L b=0 V'~=1 aaa=000
    let p2 = LL * 32 + 8
    emit_byte(out, pos, p2)
}

// Emit EVEX vectorized elementwise: dst[i] = a[i] OP b[i]
// opcode: 0x58=VADDPD, 0x59=VMULPD, 0x5C=VSUBPD
// Args already in RDI=dst, RSI=a, RDX=b, RCX=n
fn emit_avx512_elemwise_body(out: &i8, pos: &i64, opcode: i64) {
    // Main loop: process 8 f64s at a time
    let loop_top = pos[0]
    // CMP RCX, 8  (48 83 F9 08)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x08)
    // JL tail  (0F 8C rel32) — patch later
    let jl_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8C)
    emit_i32_le(out, pos, 0)
    // VMOVUPD ZMM0, [RSI]  — EVEX.mm=1 W=1 vvvv=0 LL=2(512) opcode=0x10
    // ModRM: mod=00 reg=0(zmm0) rm=6(rsi) → 0x06
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x06)
    // VOP ZMM0, ZMM0, [RDX] — EVEX.mm=1 W=1 vvvv=0(zmm0) LL=2
    // ModRM: mod=00 reg=0(zmm0) rm=2(rdx) → 0x02
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, opcode)
    emit_byte(out, pos, 0x02)
    // VMOVUPD [RDI], ZMM0 — opcode=0x11
    // ModRM: mod=00 reg=0(zmm0) rm=7(rdi) → 0x07
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x11)
    emit_byte(out, pos, 0x07)
    // ADD RSI, 64  (48 83 C6 40)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x40)
    // ADD RDX, 64  (48 83 C2 40)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC2)
    emit_byte(out, pos, 0x40)
    // ADD RDI, 64  (48 83 C7 40)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x40)
    // SUB RCX, 8  (48 83 E9 08)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xE9)
    emit_byte(out, pos, 0x08)
    // JMP loop_top
    let jmp_rel = loop_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel)
    // Patch JL forward
    let tail_off = pos[0]
    let jl_rel = tail_off - (jl_off + 6)
    poke_byte(out, jl_off + 2, i32_b0(jl_rel))
    poke_byte(out, jl_off + 3, i32_b1(jl_rel))
    poke_byte(out, jl_off + 4, i32_b2(jl_rel))
    poke_byte(out, jl_off + 5, i32_b3(jl_rel))
    // Scalar tail: process remaining elements one at a time
    // CMP RCX, 0
    let tail_top = pos[0]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x00)
    // JE done (0F 84 rel32)
    let je_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x84)
    emit_i32_le(out, pos, 0)
    // MOVSD XMM0, [RSI]  (F2 0F 10 06)
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x06)
    // scalar op XMM0, [RDX]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    if opcode == 0x58 {
        emit_byte(out, pos, 0x58)
    }
    if opcode == 0x59 {
        emit_byte(out, pos, 0x59)
    }
    if opcode == 0x5C {
        emit_byte(out, pos, 0x5C)
    }
    emit_byte(out, pos, 0x02)
    // MOVSD [RDI], XMM0  (F2 0F 11 07)
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x11)
    emit_byte(out, pos, 0x07)
    // ADD RSI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x08)
    // ADD RDX, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC2)
    emit_byte(out, pos, 0x08)
    // ADD RDI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x08)
    // DEC RCX  (48 FF C9)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC9)
    // JMP tail_top
    let jmp_rel2 = tail_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel2)
    // Patch JE to here
    let done_off = pos[0]
    let je_rel = done_off - (je_off + 6)
    poke_byte(out, je_off + 2, i32_b0(je_rel))
    poke_byte(out, je_off + 3, i32_b1(je_rel))
    poke_byte(out, je_off + 4, i32_b2(je_rel))
    poke_byte(out, je_off + 5, i32_b3(je_rel))
}

fn lower_avx512_add(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // avx512_add_f64(dst_ptr, a_ptr, b_ptr, count)
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, r2)
    let r3 = get_or_load(ctx.ra, out, pos, ins.operand3)
    emit_push_r(out, pos, r3)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RSI)
    emit_pop_r(out, pos, PHYS_RDI)
    emit_avx512_elemwise_body(out, pos, 0x58)
    emit_restore_pool(ctx.ra, out, pos)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
    consume_use(ctx, ins.operand3)
}

fn lower_avx512_mul(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // avx512_mul_f64(dst_ptr, a_ptr, b_ptr, count)
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, r2)
    let r3 = get_or_load(ctx.ra, out, pos, ins.operand3)
    emit_push_r(out, pos, r3)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RSI)
    emit_pop_r(out, pos, PHYS_RDI)
    emit_avx512_elemwise_body(out, pos, 0x59)
    emit_restore_pool(ctx.ra, out, pos)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
    consume_use(ctx, ins.operand3)
}

fn lower_avx512_scale(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // avx512_scale_f64(dst_ptr, a_ptr, scalar_bits, count)
    // Broadcasts scalar to ZMM1, then VMULPD ZMM0, ZMMx, ZMM1
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, r2)
    let r3 = get_or_load(ctx.ra, out, pos, ins.operand3)
    emit_push_r(out, pos, r3)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_R8)
    emit_pop_r(out, pos, PHYS_RSI)
    emit_pop_r(out, pos, PHYS_RDI)
    // Move scalar bits to XMM1: MOVQ XMM1, R8  (66 49 0F 6E C8)
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x6E)
    emit_byte(out, pos, 0xC8)
    // VBROADCASTSD ZMM1, XMM1 — EVEX mm=2 W=1 vvvv=0 LL=2, opcode=0x19
    // ModRM: mod=11 reg=1(zmm1) rm=1(xmm1) → 0xC9
    emit_evex(out, pos, 2, 1, 0, 2)
    emit_byte(out, pos, 0x19)
    emit_byte(out, pos, 0xC9)
    // Main loop
    let loop_top = pos[0]
    // CMP RCX, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x08)
    // JL tail
    let jl_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8C)
    emit_i32_le(out, pos, 0)
    // VMOVUPD ZMM0, [RSI]
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x06)
    // VMULPD ZMM0, ZMM0, ZMM1 — vvvv=0(zmm0), ModRM=11,000,001=0xC1
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x59)
    emit_byte(out, pos, 0xC1)
    // VMOVUPD [RDI], ZMM0
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x11)
    emit_byte(out, pos, 0x07)
    // ADD RSI, 64
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x40)
    // ADD RDI, 64
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x40)
    // SUB RCX, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xE9)
    emit_byte(out, pos, 0x08)
    let jmp_rel = loop_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel)
    // Patch JL
    let tail_off = pos[0]
    let jl_rel = tail_off - (jl_off + 6)
    poke_byte(out, jl_off + 2, i32_b0(jl_rel))
    poke_byte(out, jl_off + 3, i32_b1(jl_rel))
    poke_byte(out, jl_off + 4, i32_b2(jl_rel))
    poke_byte(out, jl_off + 5, i32_b3(jl_rel))
    // Scalar tail
    let tail_top = pos[0]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x00)
    let je_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x84)
    emit_i32_le(out, pos, 0)
    // MOVSD XMM0, [RSI]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x06)
    // MULSD XMM0, XMM1
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x59)
    emit_byte(out, pos, 0xC1)
    // MOVSD [RDI], XMM0
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x11)
    emit_byte(out, pos, 0x07)
    // ADD RSI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x08)
    // ADD RDI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x08)
    // DEC RCX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC9)
    let jmp_rel2 = tail_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel2)
    // Patch JE
    let done_off = pos[0]
    let je_rel = done_off - (je_off + 6)
    poke_byte(out, je_off + 2, i32_b0(je_rel))
    poke_byte(out, je_off + 3, i32_b1(je_rel))
    poke_byte(out, je_off + 4, i32_b2(je_rel))
    poke_byte(out, je_off + 5, i32_b3(je_rel))
    emit_restore_pool(ctx.ra, out, pos)
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
    consume_use(ctx, ins.operand3)
}

fn lower_avx512_sum(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // avx512_sum_f64(a_ptr, count) → f64 bits in i64
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RSI)
    // VXORPD ZMM0, ZMM0, ZMM0 — zero accumulator
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x57)
    emit_byte(out, pos, 0xC0)
    // Main loop
    let loop_top = pos[0]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x08)
    let jl_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8C)
    emit_i32_le(out, pos, 0)
    // VADDPD ZMM0, ZMM0, [RSI]
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0x06)
    // ADD RSI, 64
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x40)
    // SUB RCX, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xE9)
    emit_byte(out, pos, 0x08)
    let jmp_rel = loop_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel)
    // Patch JL
    let tail_off = pos[0]
    let jl_rel = tail_off - (jl_off + 6)
    poke_byte(out, jl_off + 2, i32_b0(jl_rel))
    poke_byte(out, jl_off + 3, i32_b1(jl_rel))
    poke_byte(out, jl_off + 4, i32_b2(jl_rel))
    poke_byte(out, jl_off + 5, i32_b3(jl_rel))
    // Horizontal reduce ZMM0 → XMM0
    // VEXTRACTF64X4 YMM1, ZMM0, 1 — extract upper 256 bits
    // EVEX mm=3 W=1 vvvv=0 LL=2, opcode=0x1B, ModRM=11,000,001=0xC1, imm8=1
    emit_evex(out, pos, 3, 1, 0, 2)
    emit_byte(out, pos, 0x1B)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0x01)
    // VADDPD YMM0, YMM0, YMM1 — LL=1(256)
    emit_evex(out, pos, 1, 1, 0, 1)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // VEXTRACTF128 XMM1, YMM0, 1 — EVEX mm=3 W=0 vvvv=0 LL=1, opcode=0x19
    emit_evex(out, pos, 3, 0, 0, 1)
    emit_byte(out, pos, 0x19)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0x01)
    // ADDPD XMM0, XMM1  (66 0F 58 C1)
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // MOVHLPS XMM1, XMM0  (0F 12 C8)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x12)
    emit_byte(out, pos, 0xC8)
    // ADDSD XMM0, XMM1  (F2 0F 58 C1)
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // Scalar tail: add remaining elements
    let tail_top = pos[0]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x00)
    let je_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x84)
    emit_i32_le(out, pos, 0)
    // ADDSD XMM0, [RSI]  (F2 0F 58 06)
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0x06)
    // ADD RSI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x08)
    // DEC RCX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC9)
    let jmp_rel2 = tail_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel2)
    // Patch JE
    let done_off = pos[0]
    let je_rel = done_off - (je_off + 6)
    poke_byte(out, je_off + 2, i32_b0(je_rel))
    poke_byte(out, je_off + 3, i32_b1(je_rel))
    poke_byte(out, je_off + 4, i32_b2(je_rel))
    poke_byte(out, je_off + 5, i32_b3(je_rel))
    // MOVQ RAX, XMM0  (66 48 0F 7E C0)
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x7E)
    emit_byte(out, pos, 0xC0)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

fn lower_avx512_dot(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // avx512_dot_f64(a_ptr, b_ptr, count) → f64 bits in i64
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, r2)
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RSI)
    // VXORPD ZMM0, ZMM0, ZMM0 — zero accumulator
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x57)
    emit_byte(out, pos, 0xC0)
    // Main loop
    let loop_top = pos[0]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x08)
    let jl_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8C)
    emit_i32_le(out, pos, 0)
    // VMOVUPD ZMM1, [RSI]
    // EVEX reg=1(zmm1) rm=6(rsi) → ModRM 0x0E
    emit_evex(out, pos, 1, 1, 0, 2)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x0E)
    // VFMADD231PD ZMM0, ZMM1, [RDX]
    // acc += a[i] * b[i]: ZMM0 = ZMM1 * [RDX] + ZMM0
    // Map: 0F38 (mm=2), opcode: 0xB8 (VFMADD231PD)
    // vvvv=1(zmm1), ModRM: reg=0(zmm0) rm=2(rdx) → 0x02
    emit_evex(out, pos, 2, 1, 1, 2)
    emit_byte(out, pos, 0xB8)
    emit_byte(out, pos, 0x02)
    // ADD RSI, 64
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x40)
    // ADD RDX, 64
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC2)
    emit_byte(out, pos, 0x40)
    // SUB RCX, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xE9)
    emit_byte(out, pos, 0x08)
    let jmp_rel = loop_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel)
    // Patch JL
    let tail_off = pos[0]
    let jl_rel = tail_off - (jl_off + 6)
    poke_byte(out, jl_off + 2, i32_b0(jl_rel))
    poke_byte(out, jl_off + 3, i32_b1(jl_rel))
    poke_byte(out, jl_off + 4, i32_b2(jl_rel))
    poke_byte(out, jl_off + 5, i32_b3(jl_rel))
    // Horizontal reduce ZMM0 → scalar XMM0
    // VEXTRACTF64X4 YMM1, ZMM0, 1
    emit_evex(out, pos, 3, 1, 0, 2)
    emit_byte(out, pos, 0x1B)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0x01)
    // VADDPD YMM0, YMM0, YMM1
    emit_evex(out, pos, 1, 1, 0, 1)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // VEXTRACTF128 XMM1, YMM0, 1
    emit_evex(out, pos, 3, 0, 0, 1)
    emit_byte(out, pos, 0x19)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0x01)
    // ADDPD XMM0, XMM1
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // MOVHLPS XMM1, XMM0
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x12)
    emit_byte(out, pos, 0xC8)
    // ADDSD XMM0, XMM1
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // Scalar tail: accumulate remaining
    let tail_top = pos[0]
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xF9)
    emit_byte(out, pos, 0x00)
    let je_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x84)
    emit_i32_le(out, pos, 0)
    // MOVSD XMM1, [RSI]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x0E)
    // MULSD XMM1, [RDX]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x59)
    emit_byte(out, pos, 0x0A)
    // ADDSD XMM0, XMM1
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // ADD RSI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x08)
    // ADD RDX, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC2)
    emit_byte(out, pos, 0x08)
    // DEC RCX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC9)
    let jmp_rel2 = tail_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_rel2)
    // Patch JE
    let done_off = pos[0]
    let je_rel = done_off - (je_off + 6)
    poke_byte(out, je_off + 2, i32_b0(je_rel))
    poke_byte(out, je_off + 3, i32_b1(je_rel))
    poke_byte(out, je_off + 4, i32_b2(je_rel))
    poke_byte(out, je_off + 5, i32_b3(je_rel))
    // MOVQ RAX, XMM0
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x7E)
    emit_byte(out, pos, 0xC0)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

// ========== GPU/PTX lowering (CPU fallback) ==========

fn lower_gpu_check(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // Try open("/dev/nvidiactl", O_RDONLY) — returns 1 if NVIDIA driver present, 0 otherwise
    // Branchless: compute result via arithmetic, always close fd (harmless if negative)
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    // SUB RSP, 16
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xEC)
    emit_byte(out, pos, 0x10)
    // MOV DWORD [RSP], 0x7665642F "/dev"
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x04)
    emit_byte(out, pos, 0x24)
    emit_i32_le(out, pos, 0x7665642F)
    // MOV DWORD [RSP+4], 0x69766E2F "/nvi"
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x04)
    emit_i32_le(out, pos, 0x69766E2F)
    // MOV DWORD [RSP+8], 0x63616964 "diac"
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x08)
    emit_i32_le(out, pos, 0x63616964)
    // MOV DWORD [RSP+12], 0x00006C74 "tl\0\0"
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x0C)
    emit_i32_le(out, pos, 0x00006C74)
    // MOV EAX, 2 (SYS_open)
    emit_byte(out, pos, 0xB8)
    emit_i32_le(out, pos, 2)
    // MOV RDI, RSP (filename ptr)
    emit_mov_rr(out, pos, PHYS_RDI, PHYS_RSP)
    // XOR ESI, ESI (O_RDONLY=0)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xF6)
    // XOR EDX, EDX (mode=0)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xD2)
    // SYSCALL
    emit_syscall_instr(out, pos)
    // ADD RSP, 16
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC4)
    emit_byte(out, pos, 0x10)
    // Save fd for close: MOV RDI, RAX
    emit_mov_rr(out, pos, PHYS_RDI, PHYS_RAX)
    // Branchless: has_gpu = NOT(RAX >> 63) & 1
    // SAR RAX, 63 — RAX = 0 if fd>=0, -1 if fd<0
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xF8)
    emit_byte(out, pos, 0x3F)
    // NOT RAX — RAX = -1 if fd>=0, 0 if fd<0
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xF7)
    emit_byte(out, pos, 0xD0)
    // AND EAX, 1 — RAX = 1 if fd>=0, 0 if fd<0
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xE0)
    emit_byte(out, pos, 0x01)
    // PUSH RAX (save result)
    emit_push_r(out, pos, PHYS_RAX)
    // Close fd (harmless if negative — returns -EBADF which we ignore)
    // RDI already has fd
    // MOV EAX, 3 (SYS_close)
    emit_byte(out, pos, 0xB8)
    emit_i32_le(out, pos, 3)
    emit_syscall_instr(out, pos)
    // POP RAX (restore result: 0 or 1)
    emit_pop_r(out, pos, PHYS_RAX)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

fn lower_gpu_vecadd(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // gpu_vecadd(a_tensor, b_tensor, c_tensor, len) → 0
    // CPU fallback: SSE2 ADDSD loop on tensor data (offset 0x50)
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, r2)
    let r3 = get_or_load(ctx.ra, out, pos, ins.operand3)
    emit_push_r(out, pos, r3)
    // Pop: RCX=len, RDX=c, RSI=b, RDI=a
    emit_pop_r(out, pos, PHYS_RCX)
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RSI)
    emit_pop_r(out, pos, PHYS_RDI)
    // Get data pointers: handle + 0x50
    // ADD RDI, 0x50
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x50)
    // ADD RSI, 0x50
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x50)
    // ADD RDX, 0x50
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC2)
    emit_byte(out, pos, 0x50)
    // TEST RCX, RCX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x85)
    emit_byte(out, pos, 0xC9)
    // JE .done
    let je_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x84)
    emit_i32_le(out, pos, 0)
    // .loop:
    let loop_top = pos[0]
    // MOVSD XMM0, [RDI]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x07)
    // ADDSD XMM0, [RSI]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0x06)
    // MOVSD [RDX], XMM0
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x11)
    emit_byte(out, pos, 0x02)
    // ADD RDI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x08)
    // ADD RSI, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC6)
    emit_byte(out, pos, 0x08)
    // ADD RDX, 8
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC2)
    emit_byte(out, pos, 0x08)
    // DEC RCX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC9)
    // JNE .loop (backward)
    let jne_rel = loop_top - (pos[0] + 6)
    emit_jne_rel32(out, pos, jne_rel)
    // .done: patch JE
    let va_done = pos[0]
    let je_rel = va_done - (je_off + 6)
    poke_byte(out, je_off + 2, i32_b0(je_rel))
    poke_byte(out, je_off + 3, i32_b1(je_rel))
    poke_byte(out, je_off + 4, i32_b2(je_rel))
    poke_byte(out, je_off + 5, i32_b3(je_rel))
    // XOR EAX, EAX (return 0)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xC0)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
    consume_use(ctx, ins.operand3)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

fn lower_gpu_matmul(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // gpu_matmul(a, b, c, M, N, K) → 0
    // CPU fallback: triple-loop matmul on tensor data (f64)
    // Stack after push: [RSP+40]=a, [RSP+32]=b, [RSP+24]=c, [RSP+16]=M, [RSP+8]=N, [RSP+0]=K
    // Registers: RDI=i, RSI=j, RDX=k, RAX/RCX=temp, XMM0=acc, XMM1/XMM2=temp
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let r0 = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, r0)
    let r1 = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, r1)
    let r2 = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, r2)
    let r3 = get_or_load(ctx.ra, out, pos, ins.operand3)
    emit_push_r(out, pos, r3)
    let r4 = get_or_load(ctx.ra, out, pos, ins.bb_target0)
    emit_push_r(out, pos, r4)
    let r5 = get_or_load(ctx.ra, out, pos, ins.bb_target1)
    emit_push_r(out, pos, r5)
    // Stack: [RSP+40]=a, [RSP+32]=b, [RSP+24]=c, [RSP+16]=M, [RSP+8]=N, [RSP+0]=K
    // Convert tensor handles to data ptrs (ADD QWORD [RSP+off], 0x50)
    // ADD QWORD [RSP+40], 0x50
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x28)
    emit_byte(out, pos, 0x50)
    // ADD QWORD [RSP+32], 0x50
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x20)
    emit_byte(out, pos, 0x50)
    // ADD QWORD [RSP+24], 0x50
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x18)
    emit_byte(out, pos, 0x50)
    // XOR EDI, EDI (i=0)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xFF)
    // .outer_top:
    let outer_top = pos[0]
    // CMP RDI, [RSP+16] (i < M)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x3B)
    emit_byte(out, pos, 0x7C)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x10)
    // JGE .done
    let jge_done_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8D)
    emit_i32_le(out, pos, 0)
    // XOR ESI, ESI (j=0)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xF6)
    // .mid_top:
    let mid_top = pos[0]
    // CMP RSI, [RSP+8] (j < N)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x3B)
    emit_byte(out, pos, 0x74)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x08)
    // JGE .outer_inc
    let jge_oinc_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8D)
    emit_i32_le(out, pos, 0)
    // XORPD XMM0, XMM0 (acc=0.0)
    emit_byte(out, pos, 0x66)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x57)
    emit_byte(out, pos, 0xC0)
    // XOR EDX, EDX (k=0)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xD2)
    // .inner_top:
    let inner_top = pos[0]
    // CMP RDX, [RSP+0] (k < K)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x3B)
    emit_byte(out, pos, 0x14)
    emit_byte(out, pos, 0x24)
    // JGE .store
    let jge_store_off = pos[0]
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8D)
    emit_i32_le(out, pos, 0)
    // --- Compute a[i*K+k] ---
    // MOV RAX, RDI (i)
    emit_mov_rr(out, pos, PHYS_RAX, PHYS_RDI)
    // IMUL RAX, [RSP+0] (K)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xAF)
    emit_byte(out, pos, 0x04)
    emit_byte(out, pos, 0x24)
    // ADD RAX, RDX (k)
    emit_add_rr(out, pos, PHYS_RAX, PHYS_RDX)
    // SHL RAX, 3
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE0)
    emit_byte(out, pos, 0x03)
    // ADD RAX, [RSP+40] (a_data)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x03)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x28)
    // MOVSD XMM1, [RAX]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x08)
    // --- Compute b[k*N+j] ---
    // MOV RCX, RDX (k)
    emit_mov_rr(out, pos, PHYS_RCX, PHYS_RDX)
    // IMUL RCX, [RSP+8] (N)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xAF)
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x08)
    // ADD RCX, RSI (j)
    emit_add_rr(out, pos, PHYS_RCX, PHYS_RSI)
    // SHL RCX, 3
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE1)
    emit_byte(out, pos, 0x03)
    // ADD RCX, [RSP+32] (b_data)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x03)
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x20)
    // MOVSD XMM2, [RCX]
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x11)
    // MULSD XMM1, XMM2
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x59)
    emit_byte(out, pos, 0xCA)
    // ADDSD XMM0, XMM1
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x58)
    emit_byte(out, pos, 0xC1)
    // INC RDX (k++)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC2)
    // JMP .inner_top
    let jmp_inner = inner_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_inner)
    // .store: patch JGE
    let store_off = pos[0]
    let jge_s_rel = store_off - (jge_store_off + 6)
    poke_byte(out, jge_store_off + 2, i32_b0(jge_s_rel))
    poke_byte(out, jge_store_off + 3, i32_b1(jge_s_rel))
    poke_byte(out, jge_store_off + 4, i32_b2(jge_s_rel))
    poke_byte(out, jge_store_off + 5, i32_b3(jge_s_rel))
    // --- Store c[i*N+j] = XMM0 ---
    // MOV RAX, RDI (i)
    emit_mov_rr(out, pos, PHYS_RAX, PHYS_RDI)
    // IMUL RAX, [RSP+8] (N)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xAF)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x08)
    // ADD RAX, RSI (j)
    emit_add_rr(out, pos, PHYS_RAX, PHYS_RSI)
    // SHL RAX, 3
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE0)
    emit_byte(out, pos, 0x03)
    // ADD RAX, [RSP+24] (c_data)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x03)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x18)
    // MOVSD [RAX], XMM0
    emit_byte(out, pos, 0xF2)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x11)
    emit_byte(out, pos, 0x00)
    // INC RSI (j++)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC6)
    // JMP .mid_top
    let jmp_mid = mid_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_mid)
    // .outer_inc: patch JGE
    let oinc_off = pos[0]
    let jge_o_rel = oinc_off - (jge_oinc_off + 6)
    poke_byte(out, jge_oinc_off + 2, i32_b0(jge_o_rel))
    poke_byte(out, jge_oinc_off + 3, i32_b1(jge_o_rel))
    poke_byte(out, jge_oinc_off + 4, i32_b2(jge_o_rel))
    poke_byte(out, jge_oinc_off + 5, i32_b3(jge_o_rel))
    // INC RDI (i++)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xC7)
    // JMP .outer_top
    let jmp_outer = outer_top - (pos[0] + 5)
    emit_jmp_rel32(out, pos, jmp_outer)
    // .done: patch JGE
    let mm_done = pos[0]
    let jge_d_rel = mm_done - (jge_done_off + 6)
    poke_byte(out, jge_done_off + 2, i32_b0(jge_d_rel))
    poke_byte(out, jge_done_off + 3, i32_b1(jge_d_rel))
    poke_byte(out, jge_done_off + 4, i32_b2(jge_d_rel))
    poke_byte(out, jge_done_off + 5, i32_b3(jge_d_rel))
    // Clean up stack frame (6 pushed qwords = 48 bytes)
    // ADD RSP, 48
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC4)
    emit_byte(out, pos, 0x30)
    // XOR EAX, EAX (return 0)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xC0)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
    consume_use(ctx, ins.operand3)
    consume_use(ctx, ins.bb_target0)
    consume_use(ctx, ins.bb_target1)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

fn lower_instr_gpu(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op
    if op == OP_GPU_CHECK { lower_gpu_check(ins, ctx, out, pos) }
    if op == OP_GPU_CHECK { ret 1 }
    if op == OP_GPU_VECADD { lower_gpu_vecadd(ins, ctx, out, pos) }
    if op == OP_GPU_VECADD { ret 1 }
    if op == OP_GPU_MATMUL { lower_gpu_matmul(ins, ctx, out, pos) }
    if op == OP_GPU_MATMUL { ret 1 }
    ret 0
}

// ========== ROCm/AMD GPU lowering (CPU fallback) ==========

fn lower_rocm_check(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    // Try open("/dev/kfd", O_RDONLY) — returns 1 if AMD KFD driver present, 0 otherwise
    // Branchless: SAR/NOT/AND computes 0/1, always close fd
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    // SUB RSP, 16
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xEC)
    emit_byte(out, pos, 0x10)
    // MOV DWORD [RSP], 0x7665642F "/dev"
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x04)
    emit_byte(out, pos, 0x24)
    emit_i32_le(out, pos, 0x7665642F)
    // MOV DWORD [RSP+4], 0x0064666B2F — wrong, need "/kfd" at bytes 4-7
    // '/' 'k' 'f' 'd' = 0x2F 0x6B 0x66 0x64 → LE DWORD = 0x64666B2F
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x04)
    emit_i32_le(out, pos, 0x64666B2F)
    // MOV DWORD [RSP+8], 0x00000000
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x08)
    emit_i32_le(out, pos, 0)
    // MOV DWORD [RSP+12], 0x00000000
    emit_byte(out, pos, 0xC7)
    emit_byte(out, pos, 0x44)
    emit_byte(out, pos, 0x24)
    emit_byte(out, pos, 0x0C)
    emit_i32_le(out, pos, 0)
    // MOV EAX, 2 (SYS_open)
    emit_byte(out, pos, 0xB8)
    emit_i32_le(out, pos, 2)
    // MOV RDI, RSP
    emit_mov_rr(out, pos, PHYS_RDI, PHYS_RSP)
    // XOR ESI, ESI (O_RDONLY)
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xF6)
    // XOR EDX, EDX
    emit_byte(out, pos, 0x31)
    emit_byte(out, pos, 0xD2)
    // SYSCALL
    emit_syscall_instr(out, pos)
    // ADD RSP, 16
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xC4)
    emit_byte(out, pos, 0x10)
    // Save fd for close: MOV RDI, RAX
    emit_mov_rr(out, pos, PHYS_RDI, PHYS_RAX)
    // SAR RAX, 63
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xF8)
    emit_byte(out, pos, 0x3F)
    // NOT RAX
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0xF7)
    emit_byte(out, pos, 0xD0)
    // AND EAX, 1
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, 0xE0)
    emit_byte(out, pos, 0x01)
    // PUSH RAX (save result)
    emit_push_r(out, pos, PHYS_RAX)
    // MOV EAX, 3 (SYS_close)
    emit_byte(out, pos, 0xB8)
    emit_i32_le(out, pos, 3)
    emit_syscall_instr(out, pos)
    // POP RAX (restore 0 or 1)
    emit_pop_r(out, pos, PHYS_RAX)
    emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
    emit_restore_pool(ctx.ra, out, pos)
    let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
    emit_mov_rr(out, pos, dst, PHYS_R12)
    emit_pop_r(out, pos, PHYS_R12)
}

fn lower_instr_rocm(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op
    if op == OP_ROCM_CHECK { lower_rocm_check(ins, ctx, out, pos) }
    if op == OP_ROCM_CHECK { ret 1 }
    // ROCm vecadd/matmul reuse GPU CPU fallback (same SSE2 loops)
    if op == OP_ROCM_VECADD { lower_gpu_vecadd(ins, ctx, out, pos) }
    if op == OP_ROCM_VECADD { ret 1 }
    if op == OP_ROCM_MATMUL { lower_gpu_matmul(ins, ctx, out, pos) }
    if op == OP_ROCM_MATMUL { ret 1 }
    ret 0
}

fn lower_instr_avx512(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op
    if op == OP_AVX_CHECK { lower_avx512_check(ins, ctx, out, pos) }
    if op == OP_AVX_CHECK { ret 1 }
    if op == OP_AVX_ADDF64 { lower_avx512_add(ins, ctx, out, pos) }
    if op == OP_AVX_ADDF64 { ret 1 }
    if op == OP_AVX_MULF64 { lower_avx512_mul(ins, ctx, out, pos) }
    if op == OP_AVX_MULF64 { ret 1 }
    if op == OP_AVX_SCLF64 { lower_avx512_scale(ins, ctx, out, pos) }
    if op == OP_AVX_SCLF64 { ret 1 }
    if op == OP_AVX_SUMF64 { lower_avx512_sum(ins, ctx, out, pos) }
    if op == OP_AVX_SUMF64 { ret 1 }
    if op == OP_AVX_DOTF64 { lower_avx512_dot(ins, ctx, out, pos) }
    if op == OP_AVX_DOTF64 { ret 1 }
    ret 0
}

fn lower_instr_tensor(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    let op = ins.op
    if op == OP_TNEW1 { lower_tensor_new1(ins, ctx, out, pos) }
    if op == OP_TNEW1 { ret 1 }
    if op == OP_TNEW2 { lower_tensor_new2(ins, ctx, out, pos) }
    if op == OP_TNEW2 { ret 1 }
    if op == OP_TFREE { lower_tensor_free(ins, ctx, out, pos) }
    if op == OP_TFREE { ret 1 }
    if op == OP_TGET { lower_tensor_get(ins, ctx, out, pos) }
    if op == OP_TGET { ret 1 }
    if op == OP_TSET { lower_tensor_set(ins, ctx, out, pos) }
    if op == OP_TSET { ret 1 }
    if op == OP_TFILL { lower_tensor_fill(ins, ctx, out, pos) }
    if op == OP_TFILL { ret 1 }
    if op == OP_TLEN or op == OP_TSHAPE or op == OP_TDATA {
        lower_tensor_meta(ins, ctx, out, pos)
        ret 1
    }
    ret 0
}

fn lower_instr(ins: &Instr, ctx: &LowerCtx, jfn: &JirFunction,
               out: &i8, pos: &i64) {
    if lower_instr_constlike(ins, ctx, jfn, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if ins.op == OP_STRLEN {
        let ptr_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        let dst   = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_rex_w_rr(out, pos, dst, dst)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, modrm_rr(dst, dst))
        let loop_off = pos[0]
        let rx = 0
        if dst >= 8 { rx = 1 }
        let rb = 0
        if ptr_r >= 8 { rb = 1 }
        if rx == 1 or rb == 1 {
            let rex_pfx = 0x40 + (rx * 2) + rb
            emit_byte(out, pos, rex_pfx)
        }
        emit_byte(out, pos, 0x80)
        emit_byte(out, pos, 0x3C)
        let sib = (mod8(dst)) * 8
        let base = mod8(ptr_r)
        sib = sib + base
        emit_byte(out, pos, sib)
        emit_byte(out, pos, 0)
        let je_off = pos[0]
        emit_je_rel32(out, pos, 0)
        let b = 0
        if dst >= 8 { b = 1 }
        emit_byte(out, pos, 72 + b)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, modrm_rr(0, dst))
        let jmp_rel = loop_off - (pos[0] + 5)
        emit_jmp_rel32(out, pos, jmp_rel)
        let done_off = pos[0]
        let je_rel = done_off - (je_off + 6)
        poke_byte(out, je_off + 2, i32_b0(je_rel))
        poke_byte(out, je_off + 3, i32_b1(je_rel))
        poke_byte(out, je_off + 4, i32_b2(je_rel))
        poke_byte(out, je_off + 5, i32_b3(je_rel))
        consume_use(ctx, ins.operand0)
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if ins.op == OP_PRINT_INT {
        lower_print_int(ins, ctx, out, pos)
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if ins.op == OP_ARGV_BASE {
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x85)
        emit_i32_le(out, pos, 16)
        emit_store_spill(out, pos, ins.id, PHYS_RAX)
        ret ok(0)
    }

    if ins.op == OP_ARGC_GET {
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8B)
        emit_byte(out, pos, 0x45)
        emit_byte(out, pos, 0x08)
        emit_store_spill(out, pos, ins.id, PHYS_RAX)
        ret ok(0)
    }

    if lower_instr_mem(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_arith(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_cmpbit(ins, ctx, jfn, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_atomic(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_chan(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_mt(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_epoll(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_deadlock(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_float(ins, ctx, out, pos) == 1 or lower_instr_tensor(ins, ctx, out, pos) == 1 or lower_instr_avx512(ins, ctx, out, pos) == 1 or lower_instr_gpu(ins, ctx, out, pos) == 1 or lower_instr_rocm(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

    if lower_instr_ctrl(ins, ctx, out, pos) == 1 { ret ok(0) }
    if lower_instr_drop(ins, ctx, out, pos) == 1 { ret ok(0) }
    if lower_tail_call(ins, ctx, jfn, out, pos) == 1 { ret ok(0) }
    if lower_instr_callalloc2(ins, ctx, out, pos) == 1 {
        if ctx.use_cnt[ins.id] > 1 { ensure_spilled(ctx.ra, out, pos, ins.id) }
        ret ok(0)
    }

}

fn lower_block(bb: &BasicBlock, ctx: &LowerCtx, jfn: &JirFunction,
               out: &i8, pos: &i64) {
    bb.label_off = pos[0]
    let i = 0
    loop i < bb.instr_cnt {
        g_cur_instr_idx = i
        if jfn.blocks[bb.id].instrs[i].dead == 0 {
            lower_instr(jfn.blocks[bb.id].instrs[i], ctx, jfn, out, pos)
        }
        i = i + 1
    }
    g_cur_instr_idx = -1
}

fn live_compile_let_stmt(toks0: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, cur: i64) -> i64 {
    if g_cur_fn_name_len == 4 {
        if streq(src, g_cur_fn_name_start, 4, "main") == 1 {
            g_dbg_main_lets = g_dbg_main_lets + 1
        }
    }
    g_main_pos = g_main_pos + 1
    let name_start = tok_str_start_at(toks0, g_main_pos)
    let name_len = tok_str_len_at(toks0, g_main_pos)
    g_main_pos = g_main_pos + 1
    let arr_type_tok = 0
    let arr_type_start = 0
    let arr_type_len = 0
    if tok_type_at_raw(toks0, g_main_pos) == TOK_COLON {
        g_main_pos = g_main_pos + 1
        if tok_type_at_raw(toks0, g_main_pos) == TOK_AMP {
            g_main_pos = g_main_pos + 1
        }
        arr_type_tok = tok_type_at_raw(toks0, g_main_pos)
        arr_type_start = tok_str_start_at(toks0, g_main_pos)
        arr_type_len = tok_str_len_at(toks0, g_main_pos)
        g_main_pos = g_main_pos + 1
        if tok_type_at_raw(toks0, g_main_pos) == TOK_LBRACK {
            // Array declaration: let name: type[count]
            let arr_elem_sz = 8
            if arr_type_tok == TOK_I8 { arr_elem_sz = 1 }
            if arr_type_tok == TOK_U8 { arr_elem_sz = 1 }
            if arr_type_tok == TOK_I16 { arr_elem_sz = 2 }
            if arr_type_tok == TOK_U16 { arr_elem_sz = 2 }
            if arr_type_tok == TOK_I32 { arr_elem_sz = 4 }
            if arr_type_tok == TOK_U32 { arr_elem_sz = 4 }
            if arr_type_tok == TOK_I64 { arr_elem_sz = 8 }
            if arr_type_tok == TOK_IDENT {
                let arr_sid = lookup_struct(stab, src, arr_type_start, arr_type_len)
                if arr_sid >= 0 and arr_sid < stab.cnt {
                    arr_elem_sz = stab.sizes[arr_sid]
                }
            }
            let arr_bind_stype = TYPE_PTR_I64
            if arr_type_tok == TOK_I8 { arr_bind_stype = TYPE_PTR_I8 }
            if arr_type_tok == TOK_U8 { arr_bind_stype = TYPE_PTR_U8 }
            if arr_type_tok == TOK_I16 { arr_bind_stype = TYPE_PTR_I16 }
            if arr_type_tok == TOK_U16 { arr_bind_stype = TYPE_PTR_U16 }
            if arr_type_tok == TOK_I32 { arr_bind_stype = TYPE_PTR_I32 }
            if arr_type_tok == TOK_U32 { arr_bind_stype = TYPE_PTR_U32 }
            if arr_type_tok == TOK_U64 { arr_bind_stype = TYPE_PTR_U64 }
            if arr_type_tok == TOK_IDENT {
                let arr_sid2 = lookup_struct(stab, src, arr_type_start, arr_type_len)
                if arr_sid2 >= 0 { arr_bind_stype = arr_sid2 + 1000 }
            }
            g_main_pos = g_main_pos + 1
            let cnt_id = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
            if tok_type_at_raw(toks0, g_main_pos) == TOK_RBRACK {
                g_main_pos = g_main_pos + 1
            }
            let esz_id = emit_const(jfn, cur, TYPE_I64, arr_elem_sz)
            let bytes_id = emit_binop(jfn, cur, OP_MUL, cnt_id, esz_id)
            let c4095_id = emit_const(jfn, cur, TYPE_I64, 4095)
            let c4096_id = emit_const(jfn, cur, TYPE_I64, 4096)
            let padded_id = emit_binop(jfn, cur, OP_ADD, bytes_id, c4095_id)
            let page_bytes_id = emit_binop(jfn, cur, OP_DIV, padded_id, c4096_id)
            let page_sz_id = emit_const(jfn, cur, TYPE_I64, 4096)
            let alloc_sz_id = emit_binop(jfn, cur, OP_MUL, page_bytes_id, page_sz_id)
            let alloc_ins = Instr{}
            alloc_ins.op = OP_ALLOC
            alloc_ins.operand0 = alloc_sz_id
            let arr_rhs_id = emit(jfn, cur, &alloc_ins)
            let arr_slot = bind_name(jfn, name_start, name_len, arr_bind_stype)
            let arr_st = Instr{}
            arr_st.op = OP_STORE
            arr_st.operand0 = arr_rhs_id
            arr_st.operand1 = arr_slot
            emit(jfn, cur, &arr_st)
            ret cur
        }
    }
    g_main_pos = g_main_pos + 1
    let skip_store = 0
    let bind_stype = TYPE_I64
    // Use explicit type annotation if present (e.g. let x: f64 = ...)
    if arr_type_tok == TOK_F64 { bind_stype = TYPE_F64 }
    if arr_type_tok == TOK_F32 { bind_stype = TYPE_F32 }
    if arr_type_tok == TOK_I32 { bind_stype = TYPE_I32 }
    if arr_type_tok == TOK_I8 { bind_stype = TYPE_I8 }
    if arr_type_tok == TOK_I16 { bind_stype = TYPE_I16 }
    if arr_type_tok == TOK_U8 { bind_stype = TYPE_U8 }
    if arr_type_tok == TOK_U16 { bind_stype = TYPE_U16 }
    if arr_type_tok == TOK_U32 { bind_stype = TYPE_U32 }
    if arr_type_tok == TOK_U64 { bind_stype = TYPE_U64 }
    let rhs_id = -1
    let ctrc_pages = 0
    let rhs_t = tok_type_at_raw(toks0, g_main_pos)
    if rhs_t == TOK_STR or rhs_t == TOK_RAW_STR {
        bind_stype = TYPE_PTR_I8
    } else if rhs_t == TOK_IDENT {
        let rhs_start0 = tok_str_start_at(toks0, g_main_pos)
        let rhs_len0 = tok_str_len_at(toks0, g_main_pos)
        let rhs_slot0 = lookup_slot_name(jfn, rhs_start0, rhs_len0)
        if rhs_slot0 != -1 {
            bind_stype = lookup_stype_name(jfn, rhs_start0, rhs_len0)
        } else {
            let rhs_gi0 = lookup_global2(rhs_start0, rhs_len0, src)
            if rhs_gi0 != -1 {
                bind_stype = load_i64_at(g_glob_stype, rhs_gi0)
                if load_i64_at(g_glob_is_addr, rhs_gi0) == 1 and bind_stype < TYPE_PTR_FLAG {
                    bind_stype = ptr_of(bind_stype)
                }
            }
        }
        if rhs_len0 == 11 and streq(src, rhs_start0, 11, "alloc_pages") == 1 {
            bind_stype = TYPE_PTR
            // CTRC: detect alloc_pages(N) with constant pages arg
            if tok_type_at_raw(toks0, g_main_pos + 1) == TOK_LPAREN and tok_type_at_raw(toks0, g_main_pos + 2) == TOK_INT and peek_token(toks0, g_main_pos + 2) == TOK_RPAREN {
                ctrc_pages = tok_imm_at(toks0, g_main_pos + 2)
            }
        } else if rhs_len0 == 8 and streq(src, rhs_start0, 8, "get_argv") == 1 {
            bind_stype = TYPE_PTR_I8
        } else if rhs_len0 == 9 and streq(src, rhs_start0, 9, "arena_new") == 1 {
            bind_stype = TYPE_PTR
        } else if rhs_len0 == 11 and streq(src, rhs_start0, 11, "arena_alloc") == 1 {
            bind_stype = TYPE_PTR
        }
        // Struct init: Foo{} — detect by next token being TOK_LBRACE
        let next_rhs_t = tok_type_at_raw(toks0, g_main_pos + 1)
        if next_rhs_t == TOK_LBRACE {
            let sid_init = lookup_struct(stab, src, rhs_start0, rhs_len0)
            if sid_init >= 0 { bind_stype = sid_init + 1000 }
        }
        // Function call: infer type from return type
        if next_rhs_t == TOK_LPAREN and g_fn_ret_type_tbl != 0 {
            let call_fi = resolve_top_fn_index(src, rhs_start0, rhs_len0, g_fn_name_off_tbl, g_fn_name_len_tbl)
            if call_fi >= 0 and call_fi < 512 {
                let call_rt = load_i64_at(g_fn_ret_type_tbl, call_fi)
                if call_rt != TYPE_VOID { bind_stype = call_rt }
            }
        }
    }
    rhs_id = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
    if g_iter_exit_bb != -1 {
        cur = g_iter_exit_bb
        g_iter_exit_bb = -1
    }
    // ? operator: unwrap Result, early-return on Err
    let let_cur = cur
    if tok_type_at_raw(toks0, g_main_pos) == TOK_QUESTION {
        g_main_pos = g_main_pos + 1
        // Load tag from Result ptr (offset 0)
        let ld_tag = Instr{}
        ld_tag.op = OP_LOAD_MEM
        ld_tag.itype = TYPE_I64
        ld_tag.operand0 = rhs_id
        let tag_val = emit(jfn, let_cur, &ld_tag)
        let one_id = emit_const(jfn, let_cur, TYPE_I64, 1)
        let is_err = emit_binop(jfn, let_cur, OP_CMP_EQ, tag_val, one_id)
        let err_bb = create_block_live(jfn)
        let ok_bb = create_block_live(jfn)
        emit_br(jfn, let_cur, is_err, err_bb, ok_bb)
        // In err_bb: return the Result pointer as-is
        let ret_i = Instr{}
        ret_i.op = OP_RET
        ret_i.operand0 = rhs_id
        emit(jfn, err_bb, &ret_i)
        // Continue in ok_bb: extract the val field (offset 8)
        let off8_id = emit_const(jfn, ok_bb, TYPE_I64, 8)
        let val_ptr = emit_binop(jfn, ok_bb, OP_ADD, rhs_id, off8_id)
        let ld_val = Instr{}
        ld_val.op = OP_LOAD_MEM
        ld_val.itype = TYPE_I64
        ld_val.operand0 = val_ptr
        rhs_id = emit(jfn, ok_bb, &ld_val)
        let_cur = ok_bb
    }
    // Explicit type annotation overrides inferred type
    if arr_type_tok == TOK_F64 { bind_stype = TYPE_F64 }
    if arr_type_tok == TOK_F32 { bind_stype = TYPE_F32 }
    let slot = bind_name(jfn, name_start, name_len, bind_stype)
    // CTRC: mark ownership for alloc_pages(N) with constant arg
    if ctrc_pages > 0 {
        let vidx = jfn.var_cnt - 1
        jfn.var_owned[vidx] = 1
        jfn.var_alloc_sz[vidx] = ctrc_pages * 4096
    }
    // Linear types: mark variable as linear if its struct is linear
    if bind_stype >= 1000 {
        let lin_sid = bind_stype - 1000
        if g_struct_is_linear[lin_sid] == 1 {
            let vidx2 = jfn.var_cnt - 1
            jfn.var_linear[vidx2] = 1
        }
    }
    if skip_store == 0 {
        if rhs_id == -1 {
            rhs_id = emit_const(jfn, let_cur, TYPE_I64, 0)
        }
        let ins = Instr{}
        ins.op = OP_STORE
        ins.operand0 = rhs_id
        ins.operand1 = slot
        emit(jfn, let_cur, &ins)
    }
    ret let_cur
}

// Handles: name.field[idx] = val  AND  name.field[idx].subfield = val
// On entry: pos[0] points to 'name', pos+1=DOT, pos+2=IDENT(field), pos+3=LBRACK
fn compile_dot_bracket_store_case(toks: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    // g_main_pos points at name IDENT. Read name and field before advancing.
    let dbs_name_start = tok_str_start_at(toks, g_main_pos)
    let dbs_name_len   = tok_str_len_at(toks, g_main_pos)
    let dbs_field_start = tok_str_start_at(toks, g_main_pos + 2)
    let dbs_field_len   = tok_str_len_at(toks, g_main_pos + 2)
    g_main_pos = g_main_pos + 4
    let dbs_idx_id = codegen_expr_inline(toks, &g_main_pos, stab, src, jfn, bb)
    if tok_type_at(toks, g_main_pos) == TOK_RBRACK {
        g_main_pos = g_main_pos + 1
    }
    let dbs_sub_field_start = 0
    let dbs_sub_field_len = 0
    let dbs_has_subfield = 0
    if tok_type_at(toks, g_main_pos) == TOK_DOT {
        dbs_sub_field_start = tok_str_start_at(toks, g_main_pos + 1)
        dbs_sub_field_len   = tok_str_len_at(toks, g_main_pos + 1)
        g_main_pos = g_main_pos + 2
        dbs_has_subfield = 1
    }
    if tok_type_at(toks, g_main_pos) != TOK_EQ {
        ret bb
    }
    g_main_pos = g_main_pos + 1
    let dbs_rhs_id = codegen_expr_inline(toks, &g_main_pos, stab, src, jfn, bb)
    if dbs_rhs_id < 0 { dbs_rhs_id = emit_const(jfn, bb, TYPE_I64, 0) }
    let dbs_slot = lookup_slot_name(jfn, dbs_name_start, dbs_name_len)
    let dbs_base_id = -1
    let dbs_base_stype = TYPE_I64
    if dbs_slot != -1 {
        let dbs_ld = Instr{}
        dbs_ld.op = OP_LOAD
        dbs_ld.operand0 = dbs_slot
        dbs_base_id = emit(jfn, bb, &dbs_ld)
        dbs_base_stype = lookup_stype_name(jfn, dbs_name_start, dbs_name_len)
    }
    if dbs_slot == -1 {
        let dbs_gi = lookup_global2(dbs_name_start, dbs_name_len, src)
        if dbs_gi != -1 {
            dbs_base_stype = load_i64_at(g_glob_stype, dbs_gi)
            dbs_base_id = emit_gaddr(jfn, bb, dbs_gi)
            if load_i64_at(g_glob_is_addr, dbs_gi) == 1 {
                let dbs_ldg = Instr{}
                dbs_ldg.op = OP_LOAD_MEM
                dbs_ldg.operand0 = dbs_base_id
                dbs_base_id = emit(jfn, bb, &dbs_ldg)
            }
        }
    }
    if dbs_base_id == -1 { ret bb }
    let dbs_sid = base_type(dbs_base_stype)
    let dbs_fi = lookup_field_idx_flat(dbs_sid, src, dbs_field_start, dbs_field_len)
    if dbs_fi == -1 {
        dbs_fi = lookup_field_idx_any(stab, src, dbs_sid, dbs_field_start, dbs_field_len)
    }
    let dbs_foff = 0
    if dbs_fi >= 0 { dbs_foff = g_field_byte_off[dbs_fi] }
    let dbs_arr_base = dbs_base_id
    if dbs_foff != 0 {
        let dbs_foff_id = emit_const(jfn, bb, TYPE_I64, dbs_foff)
        dbs_arr_base = emit_binop(jfn, bb, OP_ADD, dbs_base_id, dbs_foff_id)
    }
    let dbs_esz = 8
    let dbs_store_itype = TYPE_I64
    if dbs_fi >= 0 {
        if g_field_is_struct[dbs_fi] == 1 {
            let esz2 = g_struct_sizes[g_field_type[dbs_fi]]
            if esz2 > 0 { dbs_esz = esz2 }
        } else {
            dbs_esz = type_sizeof(g_field_type[dbs_fi])
            dbs_store_itype = base_type(g_field_type[dbs_fi])
        }
    }
    let dbs_esz_id = emit_const(jfn, bb, TYPE_I64, dbs_esz)
    let dbs_boff = emit_binop(jfn, bb, OP_MUL, dbs_idx_id, dbs_esz_id)
    let dbs_addr = emit_binop(jfn, bb, OP_ADD, dbs_arr_base, dbs_boff)
    if dbs_has_subfield == 1 {
        if dbs_fi >= 0 {
            let dbs_elem_stype = g_field_type[dbs_fi]
            let sub_fi = lookup_field_idx_flat(dbs_elem_stype, src, dbs_sub_field_start, dbs_sub_field_len)
            if sub_fi == -1 {
                sub_fi = lookup_field_idx_any(stab, src, dbs_elem_stype, dbs_sub_field_start, dbs_sub_field_len)
            }
            if sub_fi >= 0 {
                let sub_foff = g_field_byte_off[sub_fi]
                if sub_foff != 0 {
                    let sub_foff_id = emit_const(jfn, bb, TYPE_I64, sub_foff)
                    dbs_addr = emit_binop(jfn, bb, OP_ADD, dbs_addr, sub_foff_id)
                }
            }
        }
    }
    let dbs_st = Instr{}
    dbs_st.op = OP_STORE_MEM
    dbs_st.itype = dbs_store_itype
    dbs_st.operand0 = dbs_rhs_id
    dbs_st.operand1 = dbs_addr
    emit(jfn, bb, &dbs_st)
    ret bb
}

fn ctrc_emit_drops(jfn: &JirFunction, bb: i64, from: i64, to: i64) {
    let ci = from
    loop ci < to {
        if jfn.var_owned[ci] == 1 {
            emit_drop(jfn, bb, ci)
        }
        ci = ci + 1
    }
}

fn ctrc_emit_drops_clear(jfn: &JirFunction, bb: i64, from: i64, to: i64) {
    let ci = from
    loop ci < to {
        if jfn.var_owned[ci] == 1 {
            emit_drop(jfn, bb, ci)
            jfn.var_owned[ci] = 0
        }
        ci = ci + 1
    }
}

fn live_compile_compound_assign(stab: &StructTable, src: &i8, jfn: &JirFunction, cur: i64, name_start: i64, name_len: i64) -> i64 {
    let toks0 = g_dbg_toks_init
    let t1 = tok_type_at(toks0, g_main_pos + 1)
    g_main_pos = g_main_pos + 2
    let ca_rhs = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
    if ca_rhs < 0 { ca_rhs = emit_const(jfn, cur, TYPE_I64, 0) }
    let ca_slot = lookup_slot_name(jfn, name_start, name_len)
    if ca_slot != -1 {
        let ca_ld = Instr{}
        ca_ld.op = OP_LOAD
        ca_ld.operand0 = ca_slot
        let ca_old = emit(jfn, cur, &ca_ld)
        let ca_stype = lookup_stype_name(jfn, name_start, name_len)
        let ca_op = OP_ADD
        if t1 == TOK_MINUS_EQ { ca_op = OP_SUB }
        if t1 == TOK_STAR_EQ { ca_op = OP_MUL }
        if t1 == TOK_SLASH_EQ { ca_op = OP_DIV }
        if t1 == TOK_PERCENT_EQ { ca_op = OP_MOD }
        if ca_stype == TYPE_F64 or ca_stype == TYPE_F32 {
            if t1 == TOK_PLUS_EQ { ca_op = OP_FADD }
            if t1 == TOK_MINUS_EQ { ca_op = OP_FSUB }
            if t1 == TOK_STAR_EQ { ca_op = OP_FMUL }
            if t1 == TOK_SLASH_EQ { ca_op = OP_FDIV }
        }
        let ca_res = emit_binop(jfn, cur, ca_op, ca_old, ca_rhs)
        let ca_st = Instr{}
        ca_st.op = OP_STORE
        ca_st.operand0 = ca_res
        ca_st.operand1 = ca_slot
        emit(jfn, cur, &ca_st)
    }
    ret cur
}

fn live_compile_block(toks: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let cur = bb
    let saved_var_cnt = jfn.var_cnt
    let keep_going = 1
    loop keep_going == 1 {
        let before_stmt = g_main_pos
        let toks0 = g_dbg_toks_init
        g_panic_pos = g_main_pos
        if g_cur_fn_end > 0 and g_main_pos >= g_cur_fn_end {
            keep_going = 0
        }
        let t = tok_type_at_raw(toks0, g_main_pos)
        if keep_going == 0 {
        } else if t == TOK_RBRACE or t == TOK_EOF {
            keep_going = 0
        } else {
            let asm_argv_taken = 0
            if asm_argv_taken == 0 {
                let skip_asm_taken = 0
                if skip_asm_taken == 0 {
                    if t == TOK_IF {
                        cur = live_compile_if(toks0, stab, src, jfn, cur)
                    } else if t == TOK_MATCH {
                        cur = live_compile_match(toks0, stab, src, jfn, cur)
                    } else if t == TOK_LOOP {
                        cur = live_compile_loop(toks0, stab, src, jfn, cur)
                    } else if t == TOK_FOR {
                        // for i in range(n) { body }
                        // Desugars to: let i = 0; loop i < n { body; i = i + 1 }
                        g_main_pos = g_main_pos + 1
                        // Get loop variable name
                        let for_var_s = tok_str_start_at(toks0, g_main_pos)
                        let for_var_l = tok_str_len_at(toks0, g_main_pos)
                        g_main_pos = g_main_pos + 1
                        // Skip 'in'
                        if tok_type_at_raw(toks0, g_main_pos) == TOK_IDENT { g_main_pos = g_main_pos + 1 }
                        // Skip 'range' and '('
                        if tok_type_at_raw(toks0, g_main_pos) == TOK_IDENT { g_main_pos = g_main_pos + 1 }
                        if tok_type_at_raw(toks0, g_main_pos) == TOK_LPAREN { g_main_pos = g_main_pos + 1 }
                        // Codegen first expression (could be limit or start)
                        let for_first = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                        // Check for range(start, end) two-arg form
                        let for_limit = for_first
                        let for_zero = emit_const(jfn, cur, TYPE_I64, 0)
                        if tok_type_at_raw(toks0, g_main_pos) == TOK_COMMA {
                            g_main_pos = g_main_pos + 1
                            for_limit = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                            for_zero = for_first
                        }
                        // Skip ')'
                        if tok_type_at_raw(toks0, g_main_pos) == TOK_RPAREN { g_main_pos = g_main_pos + 1 }
                        let for_slot = bind_name(jfn, for_var_s, for_var_l, 0)
                        let for_st_init = Instr{}
                        for_st_init.op = OP_STORE
                        for_st_init.operand0 = for_zero
                        for_st_init.operand1 = for_slot
                        emit(jfn, cur, &for_st_init)
                        // Spill limit to stack slot so it survives loop body calls
                        let for_lim_slot = alloc_slot(jfn)
                        let for_st_lim = Instr{}
                        for_st_lim.op = OP_STORE
                        for_st_lim.operand0 = for_limit
                        for_st_lim.operand1 = for_lim_slot
                        emit(jfn, cur, &for_st_lim)
                        // Build loop: cond block, body block, inc block, merge block
                        let for_start = create_block_live(jfn)
                        emit_jmp(jfn, cur, for_start)
                        let for_body = create_block_live(jfn)
                        let for_inc_bb = create_block_live(jfn)
                        let for_merge = create_block_live(jfn)
                        let for_saved_ctrl = g_loop_ctrl
                        let for_saved_head = g_loop_head
                        g_loop_ctrl = for_merge
                        g_loop_head = for_inc_bb
                        // Cond: i < limit (reload limit from stack)
                        let for_ld_cond = Instr{}
                        for_ld_cond.op = OP_LOAD
                        for_ld_cond.operand0 = for_slot
                        let for_cur_val = emit(jfn, for_start, &for_ld_cond)
                        let for_ld_lim = Instr{}
                        for_ld_lim.op = OP_LOAD
                        for_ld_lim.operand0 = for_lim_slot
                        let for_limit_r = emit(jfn, for_start, &for_ld_lim)
                        let for_cmp = emit_binop(jfn, for_start, OP_CMP_LT, for_cur_val, for_limit_r)
                        emit_br(jfn, for_start, for_cmp, for_body, for_merge)
                        // Body
                        if tok_type_at_raw(toks0, g_main_pos) == TOK_LBRACE { g_main_pos = g_main_pos + 1 }
                        let for_body_end = live_compile_block(toks0, stab, src, jfn, for_body)
                        g_loop_ctrl = for_saved_ctrl
                        g_loop_head = for_saved_head
                        if tok_type_at_raw(toks0, g_main_pos) == TOK_RBRACE { g_main_pos = g_main_pos + 1 }
                        // Body end jumps to increment block
                        emit_jmp(jfn, for_body_end, for_inc_bb)
                        // Increment block: i = i + 1, then jump to cond
                        let for_ld_inc = Instr{}
                        for_ld_inc.op = OP_LOAD
                        for_ld_inc.operand0 = for_slot
                        let for_inc_val = emit(jfn, for_inc_bb, &for_ld_inc)
                        let for_one = emit_const(jfn, for_inc_bb, TYPE_I64, 1)
                        let for_next = emit_binop(jfn, for_inc_bb, OP_ADD, for_inc_val, for_one)
                        let for_st_inc = Instr{}
                        for_st_inc.op = OP_STORE
                        for_st_inc.operand0 = for_next
                        for_st_inc.operand1 = for_slot
                        emit(jfn, for_inc_bb, &for_st_inc)
                        emit_jmp(jfn, for_inc_bb, for_start)
                        cur = for_merge
                    } else if t == TOK_LET {
                        cur = live_compile_let_stmt(toks0, stab, src, jfn, cur)
                    } else if t == TOK_RET {
                        g_main_pos = g_main_pos + 1
                        let val_id = emit_const(jfn, cur, TYPE_I64, 0)
                        let rt = tok_type_at_raw(toks0, g_main_pos)
                        if rt == TOK_INT or rt == TOK_FLOAT or rt == TOK_IDENT or rt == TOK_LPAREN or rt == TOK_MINUS or rt == TOK_TILDE or rt == TOK_NOT or rt == TOK_AMP or rt == TOK_SYSCALL or rt == TOK_TRUE or rt == TOK_FALSE or rt == TOK_STR or rt == TOK_RAW_STR {
                            val_id = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                        }
                        defer_emit_calls(toks0, stab, src, jfn, cur)
                        let rins = Instr{}
                        rins.op = OP_RET
                        rins.operand0 = val_id
                        emit(jfn, cur, &rins)
                    } else if t == TOK_PRINT {
                        cur = compile_print_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                    } else if t == TOK_SYSCALL {
                        codegen_syscall_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                    } else if t == TOK_UNSAFE {
                        g_main_pos = g_main_pos + 1
                        expect(TOK_LBRACE)
                        g_unsafe_depth = g_unsafe_depth + 1
                        cur = live_compile_block(toks0, stab, src, jfn, cur)
                        expect(TOK_RBRACE)
                        g_unsafe_depth = g_unsafe_depth - 1
                    } else if t == TOK_IDENT {
                        let pos_before = g_main_pos
                        let name_start = tok_str_start_at(toks0, g_main_pos)
                        let name_len = tok_str_len_at(toks0, g_main_pos)
                        let is_break_stmt = 0
                        if name_len == 5 {
                            if streq(src, name_start, 5, "break") == 1 { is_break_stmt = 1 }
                        }
                        if is_break_stmt == 1 {
                            g_main_pos = g_main_pos + 1
                            // CTRC: drop owned vars from current scope before break
                            ctrc_emit_drops(jfn, cur, saved_var_cnt, jfn.var_cnt)
                            emit_jmp(jfn, cur, g_loop_ctrl)
                            keep_going = 0
                        }
                        let is_continue_stmt = 0
                        if name_len == 8 {
                            if streq(src, name_start, 8, "continue") == 1 { is_continue_stmt = 1 }
                        }
                        if is_continue_stmt == 1 {
                            g_main_pos = g_main_pos + 1
                            emit_jmp(jfn, cur, g_loop_head)
                            keep_going = 0
                        }
                        // Linear types: consume(var) marks a linear variable as consumed
                        let is_consume_stmt = 0
                        if name_len == 7 and streq(src, name_start, 7, "consume") == 1 {
                            if tok_type_at_raw(toks0, g_main_pos + 1) == TOK_LPAREN {
                                is_consume_stmt = 1
                                g_main_pos = g_main_pos + 2
                                let cv_start = tok_str_start_at(toks0, g_main_pos)
                                let cv_len = tok_str_len_at(toks0, g_main_pos)
                                g_main_pos = g_main_pos + 1
                                if tok_type_at_raw(toks0, g_main_pos) == TOK_RPAREN {
                                    g_main_pos = g_main_pos + 1
                                }
                                let cv_idx = lookup_idx_name(jfn, cv_start, cv_len)
                                if cv_idx >= 0 {
                                    jfn.var_consumed[cv_idx] = 1
                                }
                            }
                        }
                        // defer statement: save token position, skip the call
                        let is_defer_stmt = 0
                        if name_len == 5 and is_break_stmt == 0 {
                            if streq(src, name_start, 5, "defer") == 1 {
                                is_defer_stmt = 1
                                g_main_pos = g_main_pos + 1
                                store_i64_at(g_defer_pos, g_defer_count, g_main_pos)
                                g_defer_count = g_defer_count + 1
                                g_main_pos = defer_skip_call(toks0, g_main_pos)
                            }
                        }
                        // Check for compound assignment early to avoid deep nesting
                        let is_compound_assign = 0
                        if is_break_stmt == 0 and is_continue_stmt == 0 and is_consume_stmt == 0 and is_defer_stmt == 0 {
                            let t1_ca = tok_type_at(toks0, g_main_pos + 1)
                            if t1_ca == TOK_PLUS_EQ { is_compound_assign = 1 }
                            if t1_ca == TOK_MINUS_EQ { is_compound_assign = 1 }
                            if t1_ca == TOK_STAR_EQ { is_compound_assign = 1 }
                            if t1_ca == TOK_SLASH_EQ { is_compound_assign = 1 }
                            if t1_ca == TOK_PERCENT_EQ { is_compound_assign = 1 }
                        }
                        if is_compound_assign == 1 {
                            cur = live_compile_compound_assign(stab, src, jfn, cur, name_start, name_len)
                        } else if is_break_stmt == 0 and is_continue_stmt == 0 and is_consume_stmt == 0 and is_defer_stmt == 0 {
                        let fs_has_dot = tok_type_at(toks0, g_main_pos + 1) == TOK_DOT
                        let fs_has_eq = tok_type_at(toks0, g_main_pos + 3) == TOK_EQ
                        if fs_has_dot and fs_has_eq {
                            let field_start = tok_str_start_at(toks0, g_main_pos + 2)
                            let field_len = tok_str_len_at(toks0, g_main_pos + 2)
                            g_main_pos = g_main_pos + 4
                            let rhs_id = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                            if rhs_id < 0 {
                                rhs_id = emit_const(jfn, cur, TYPE_I64, 0)
                            }
                            let slot0 = lookup_slot_name(jfn, name_start, name_len)
                            let has_slot0 = slot0 != -1
                            let slot_base_id = -1
                            let slot_base_stype = -1
                            if has_slot0 {
                                let ld0 = Instr{}
                                ld0.op = OP_LOAD
                                ld0.operand0 = slot0
                                slot_base_id = emit(jfn, cur, &ld0)
                                slot_base_stype = lookup_stype_name(jfn, name_start, name_len)
                            }
                            let gi0 = lookup_global2(name_start, name_len, src)
                            let has_gi0 = gi0 != -1
                            let glob_base_id = -1
                            let glob_base_stype = -1
                            if has_gi0 {
                                glob_base_stype = load_i64_at(g_glob_stype, gi0)
                                glob_base_id = emit_gaddr(jfn, cur, gi0)
                                if load_i64_at(g_glob_is_addr, gi0) == 1 {
                                    let ldg0 = Instr{}
                                    ldg0.op = OP_LOAD_MEM
                                    ldg0.operand0 = glob_base_id
                                    glob_base_id = emit(jfn, cur, &ldg0)
                                }
                            }
                            let base_id = has_slot0 * slot_base_id + (has_slot0 == 0) * glob_base_id
                            let base_stype = has_slot0 * slot_base_stype + (has_slot0 == 0) * glob_base_stype
                            if base_id != -1 {
                                let sid0 = base_type(base_stype)
                                if base_stype >= 1000 and is_pointer_type(base_stype) == 0 { sid0 = base_stype - 1000 }
                                let foff0 = lookup_field_off_flat(sid0, src, field_start, field_len)
                                if foff0 >= 0 {
                                    let off_id0 = emit_const(jfn, cur, TYPE_I64, foff0)
                                    let addr0 = emit_binop(jfn, cur, OP_ADD, base_id, off_id0)
                                    let stf = Instr{}
                                    stf.op = OP_STORE_MEM
                                    stf.itype = TYPE_I64
                                    stf.operand0 = rhs_id
                                    stf.operand1 = addr0
                                    emit(jfn, cur, &stf)
                                }
                            }
                        } else {
                            let t1 = tok_type_at(toks0, g_main_pos + 1)
                            if t1 == TOK_LBRACK {
                                cur = compile_ident_stmt_bracket_case(toks0, &g_main_pos, stab, src, jfn, cur)
                            } else if t1 == TOK_EQ {
                                g_main_pos = g_main_pos + 2
                                let rhs_id = codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                                if rhs_id < 0 {
                                    rhs_id = emit_const(jfn, cur, TYPE_I64, 0)
                                }
                                let slot = lookup_slot_name(jfn, name_start, name_len)
                                if slot != -1 {
                                    let st = Instr{}
                                    st.op = OP_STORE
                                    st.operand0 = rhs_id
                                    st.operand1 = slot
                                    emit(jfn, cur, &st)
                                } else {
                                    let gi = lookup_global2(name_start, name_len, src)
                                    if gi >= 0 {
                                        let fno = load_i64_at(g_glob_name_off, gi)
                                        let fnl = load_i64_at(g_glob_name_len, gi)
                                        if fnl == name_len {
                                        }
                                    }
                                    if gi != -1 {
                                        let gaddr = emit_gaddr(jfn, cur, gi)
                                        let stg = Instr{}
                                        stg.op = OP_STORE_MEM
                                        stg.itype = TYPE_I64
                                        stg.operand0 = rhs_id
                                        stg.operand1 = gaddr
                                        emit(jfn, cur, &stg)
                                    }
                                }
                            } else if t1 == TOK_DOT {
                                let t3 = tok_type_at(toks0, g_main_pos + 3)
                                if t3 == TOK_LBRACK {
                                    cur = compile_dot_bracket_store_case(toks0, stab, src, jfn, cur)
                                } else {
                                    let pos_before2 = g_main_pos
                                    codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                                    if g_main_pos <= pos_before2 and g_main_pos < g_dbg_tok_cnt {
                                        g_main_pos = g_main_pos + 1
                                    }
                                }
                            } else {
                                let pos_before2 = g_main_pos
                                codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                                if g_main_pos <= pos_before2 and g_main_pos < g_dbg_tok_cnt {
                                    g_main_pos = g_main_pos + 1
                                }
                            }
                        }
                        }
                    } else {
                        let pos_before2 = g_main_pos
                        codegen_expr_inline(toks0, &g_main_pos, stab, src, jfn, cur)
                        if g_main_pos <= pos_before2 and g_main_pos < g_dbg_tok_cnt {
                            g_main_pos = g_main_pos + 1
                        }
                    }
                }
            }
        }
        
        if g_iter_exit_bb != -1 {
            cur = g_iter_exit_bb
            g_iter_exit_bb = -1
        }
        if keep_going == 1 {
            if g_main_pos <= before_stmt {
                if g_main_pos < g_dbg_tok_cnt {
                    g_main_pos = g_main_pos + 1
                } else {
                    keep_going = 0
                }
            }
        }
    }
    // Linear types: check all linear vars in this scope are consumed
    let li = saved_var_cnt
    loop li < jfn.var_cnt {
        if jfn.var_linear[li] == 1 and jfn.var_consumed[li] == 0 {
            report_error("linear variable must be consumed before scope exit")
        }
        li = li + 1
    }
    // CTRC: drop owned vars from this scope at block exit
    ctrc_emit_drops_clear(jfn, cur, saved_var_cnt, jfn.var_cnt)
    jfn.var_cnt = saved_var_cnt
    ret cur
}

fn live_compile_block_small0() -> i64 {
    g_panic_pos = g_main_pos
    compile_print_small0()
    if g_main_pos < g_dbg_tok_cnt {
        g_main_pos = g_main_pos + 1
    }
    ret g_small_work_bb
}

