fn try_small_print_tokens_fast(src: &i8, toks: &Token, tok_cnt: i64, out_path: &i8) -> i64 {
    if tok_cnt != 10 { ret 0 }
    if tok_type_at(toks, 0) != TOK_FN { ret 0 }
    if tok_type_at(toks, 1) != TOK_IDENT { ret 0 }
    if streq(src, tok_str_start_at(toks, 1), tok_str_len_at(toks, 1), "main") == 0 { ret 0 }
    if tok_type_at(toks, 2) != TOK_LPAREN { ret 0 }
    if tok_type_at(toks, 3) != TOK_RPAREN { ret 0 }
    if tok_type_at(toks, 4) != TOK_LBRACE { ret 0 }
    if tok_type_at(toks, 5) != TOK_PRINT { ret 0 }
    if tok_type_at(toks, 6) != TOK_LPAREN { ret 0 }
    if tok_type_at(toks, 7) != TOK_STR { ret 0 }
    if tok_type_at(toks, 8) != TOK_RPAREN { ret 0 }
    if tok_type_at(toks, 9) != TOK_RBRACE { ret 0 }
    let msg_start = tok_str_start_at(toks, 7)
    let msg_len = tok_str_len_at(toks, 7)
    if msg_len < 0 or msg_len > 64 { ret 0 }
    let chk = 0
    loop chk < msg_len {
        let c = load_i8_at(src, msg_start + chk)
        if c == 34 or c == 92 or c == 10 or c == 13 { ret 0 }
        chk = chk + 1
    }
    let tpl_fd = syscall(2, "/workspace/bootstrap/stage1/print_fast64.bin", 0, 0)
    if tpl_fd < 0 { ret 0 }
    let buf = alloc_pages(2)
    let n = syscall(0, tpl_fd, buf, 8192)
    syscall(3, tpl_fd, 0, 0)
    if n <= 0 { ret 0 }
    poke_byte(buf, 4114, msg_len)
    let zi = 0
    loop zi < 64 {
        poke_byte(buf, 4129 + zi, 0)
        zi = zi + 1
    }
    let ci = 0
    loop ci < msg_len {
        poke_byte(buf, 4129 + ci, load_i8_at(src, msg_start + ci))
        ci = ci + 1
    }
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 { ret 0 }
    let wn = syscall(1, out_fd, buf, n)
    syscall(3, out_fd, 0, 0)
    if wn != n { ret 0 }
    ret 1
}

