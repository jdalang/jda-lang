    toks[0].type = TOK_FN
    toks[1].type = TOK_IDENT
    toks[1].str_start = 3
    toks[1].str_len = 4
    toks[2].type = TOK_LPAREN
    toks[3].type = TOK_RPAREN
    toks[4].type = TOK_LBRACE
