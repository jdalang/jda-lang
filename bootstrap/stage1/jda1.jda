    st_len.operand0 = len_id
    st_len.operand1 = len_slot
    emit(jfn, bb, &st_len)
    let st_cls = Instr{}
    st_cls.op = OP_STORE
    st_cls.operand0 = cls_id
    st_cls.operand1 = cls_slot
    emit(jfn, bb, &st_cls)
    let st_out = Instr{}
    st_out.op = OP_STORE
    st_out.operand0 = out_ptr
    st_out.operand1 = out_slot
    emit(jfn, bb, &st_out)
    let head = create_block_live(jfn)
    let body = create_block_live(jfn)
    let exit = create_block_live(jfn)
    emit_jmp(jfn, bb, head)
    let ld_idx = Instr{}
    ld_idx.op = OP_LOAD
    ld_idx.operand0 = idx_slot
    let idx = emit(jfn, head, &ld_idx)
    let ld_len = Instr{}
    ld_len.op = OP_LOAD
    ld_len.operand0 = len_slot
    let len_val = emit(jfn, head, &ld_len)
    let cond = emit_binop(jfn, head, OP_CMP_LT, idx, len_val)
    emit_br(jfn, head, cond, body, exit)
    let ld_idx2 = Instr{}
    ld_idx2.op = OP_LOAD
    ld_idx2.operand0 = idx_slot
    let idx2 = emit(jfn, body, &ld_idx2)
    let ld_arr = Instr{}
    ld_arr.op = OP_LOAD
    ld_arr.operand0 = arr_slot
    let arr_val = emit(jfn, body, &ld_arr)
    let ld_cls = Instr{}
    ld_cls.op = OP_LOAD
    ld_cls.operand0 = cls_slot
    let cls_val = emit(jfn, body, &ld_cls)
    let ld_out = Instr{}
    ld_out.op = OP_LOAD
    ld_out.operand0 = out_slot
    let out_val = emit(jfn, body, &ld_out)
    let eight = emit_const(jfn, body, TYPE_I64, 8)
    let off = emit_binop(jfn, body, OP_MUL, idx2, eight)
    let addr = emit_binop(jfn, body, OP_ADD, arr_val, off)
    let ld_elem = Instr{}
    ld_elem.op = OP_LOAD_MEM
    ld_elem.operand0 = addr
    ld_elem.itype = TYPE_I64
    let elem = emit(jfn, body, &ld_elem)
    let result = emit_closure_call_1arg(jfn, body, cls_val, elem)
    let out_addr = emit_binop(jfn, body, OP_ADD, out_val, off)
    let st_out2 = Instr{}
    st_out2.op = OP_STORE_MEM
    st_out2.itype = TYPE_I64
    st_out2.operand0 = result
    st_out2.operand1 = out_addr
    emit(jfn, body, &st_out2)
    let one = emit_const(jfn, body, TYPE_I64, 1)
    let next = emit_binop(jfn, body, OP_ADD, idx2, one)
    let st1 = Instr{}
    st1.op = OP_STORE
    st1.operand0 = next
    st1.operand1 = idx_slot
    emit(jfn, body, &st1)
    emit_jmp(jfn, body, head)
    let ld_out_exit = Instr{}
    ld_out_exit.op = OP_LOAD
    ld_out_exit.operand0 = out_slot
    g_iter_exit_bb = exit
    ret emit(jfn, exit, &ld_out_exit)
}

