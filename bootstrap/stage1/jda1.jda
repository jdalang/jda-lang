; =============================================================================
; Jda Stage 1 Compiler - Written in Jda
; =============================================================================
; This is the first self-hosted Jda compiler.
; It is written in Jda and compiled by the Stage 0 bootstrapper.
;
; Stage 1 supports richer Jda syntax:
;   - Variables: let x = expr
;   - Functions: fn name(params) -> type { body }
;   - Loops: loop condition { body }
;   - Conditionals: if cond { body } else { body }
;   - Structs: struct Name { field: type }
;   - Pattern matching: match x { val => expr }
;   - Result type: ok(val) / err(msg)  (no exceptions)
;   - Print: 
;   - Inline syscall: syscall(nr, a, b, c) -> i64
;
; Stage 1 outputs JIR which is then lowered to x86-64 machine code.
; =============================================================================

; ============================================================
; 0. CONSTANTS
; ============================================================

; Token type constants
const TOK_FN      = 0
const TOK_LET     = 1
const TOK_IF      = 2
const TOK_ELSE    = 3
const TOK_LOOP    = 4
const TOK_RET     = 5
const TOK_STRUCT  = 6
const TOK_MATCH   = 7
const TOK_PRINT   = 8
const TOK_SYSCALL = 9
const TOK_IDENT   = 10
const TOK_INT     = 11
const TOK_STR     = 12
const TOK_LPAREN  = 13
const TOK_RPAREN  = 14
const TOK_LBRACE  = 15
const TOK_RBRACE  = 16
const TOK_LBRACK  = 17
const TOK_RBRACK  = 18
const TOK_COMMA   = 19
const TOK_COLON   = 20
const TOK_SEMI    = 21
const TOK_ARROW   = 22
const TOK_EQ      = 23
const TOK_EQEQ    = 24
const TOK_NEQ     = 25
const TOK_LT      = 26
const TOK_GT      = 27
const TOK_PLUS    = 28
const TOK_MINUS   = 29
const TOK_STAR    = 30
const TOK_SLASH   = 31
const TOK_AMP     = 32
const TOK_DOT     = 33
const TOK_FATARROW= 34
const TOK_GTE     = 35
const TOK_LTE     = 36
const TOK_AND     = 37
const TOK_OR      = 38
const TOK_PIPE    = 39  ; Bitwise OR (|)
const TOK_TILDE   = 40  ; Bitwise NOT token
const TOK_SHR     = 41  ; Right shift (>>)
const TOK_SHL     = 42  ; Left shift (<<)
const TOK_CONST   = 43
const TOK_EOF     = 44
; Type keyword tokens (classified by lexer)
const TOK_I64     = 45
const TOK_I32     = 46
const TOK_I8      = 47
const TOK_F64     = 48

; AST node types
const NODE_FN     = 0
const NODE_LET    = 1
const NODE_IF     = 2
const NODE_LOOP   = 3
const NODE_CALL   = 4
const NODE_BINOP  = 5
const NODE_IDENT  = 6
const NODE_INT    = 7
const NODE_STR    = 8
const NODE_RET    = 9
const NODE_BLOCK  = 10
const NODE_STRUCT = 11
const NODE_FIELD  = 12
const NODE_MATCH  = 13
const NODE_PRINT  = 14
const NODE_SYSCALL= 15
const NODE_FIELD_STORE = 16
const NODE_STRUCT_INIT = 17
const NODE_ADDR   = 18
const NODE_ARRAY_ALLOC = 19
const NODE_INDEX_STORE = 20
const NODE_DEREF  = 21

; Type system
const TYPE_VOID   = 0
const TYPE_I64    = 1
const TYPE_I32    = 2
const TYPE_I8     = 3
const TYPE_F64    = 4
const TYPE_PTR    = 5

; Pointer type flag (bitmask)
const TYPE_PTR_FLAG = 65536

; Helper types for pointers
const TYPE_PTR_I64 = 65537
const TYPE_PTR_I32 = 65538
const TYPE_PTR_I8  = 65539

; JIR opcodes
const OP_CONST    = 0
const OP_ADD      = 1
const OP_SUB      = 2
const OP_MUL      = 3
const OP_DIV      = 4
const OP_NEG      = 5
const OP_CMP_EQ   = 6
const OP_CMP_NE   = 7
const OP_CMP_LT   = 8
const OP_CMP_GT   = 9
const OP_CMP_GTE  = 10
const OP_CMP_LTE  = 11
const OP_AND      = 12
const OP_OR       = 13
const OP_RET      = 14
const OP_BR       = 15
const OP_JMP      = 16
const OP_CALL     = 17
const OP_SYSCALL  = 18
const OP_STRLIT   = 19
const OP_STRLEN   = 20
const OP_STORE    = 21
const OP_LOAD     = 22
const OP_ADDR     = 23
const OP_LOAD_MEM = 24
const OP_STORE_MEM= 25
const OP_ALLOC    = 26
const OP_PRINT_INT= 27
const OP_SHR      = 28  ; Logical right shift
const OP_SHL      = 29  ; Left shift
const OP_GADDR    = 30
const OP_ARGV_BASE= 31
const OP_ARGC_GET = 32

; x86-64 physical register numbers (Intel encoding)
const PHYS_RAX = 0
const PHYS_RCX = 1
const PHYS_RDX = 2
const PHYS_RBX = 3
const PHYS_RSP = 4
const PHYS_RBP = 5
const PHYS_RSI = 6
const PHYS_RDI = 7
const PHYS_R8  = 8
const PHYS_R9  = 9
const PHYS_R10 = 10
const PHYS_R11 = 11
const PHYS_R12 = 12

; Allocatable pool size: rax rcx rdx rbx rsi rdi r10 r11
const N_ALLOC_REGS = 8

; ============================================================
; 1. STRUCT DEFINITIONS
; ============================================================

struct Token {
    type:      i64
    pad:       i64
    str_start: i64
    str_len:   i64
    imm:       i64
}

struct Node {
    node_type: i32
    op:        i32
    imm:       i64
    data_type: i32
    param_cnt: i32
    child_cnt: i32
    ret_type:  i32
    token:     i64
    token2:    i64
    child0:    &Node
    child1:    &Node
    child2:    &Node
    child3:    &Node
    children:  i64
}

struct Instr {
    op:         i32
    itype:      i32
    id:         i64
    dead:       i32
    pad:        i32
    operand0:   i64
    operand1:   i64
    operand2:   i64
    operand3:   i64
    imm:        i64
    str_start:  i64
    str_len:    i64
    bb_target0: i64
    bb_target1: i64
}

struct BasicBlock {
    id:        i64
    instrs:    Instr[256]
    instr_cnt: i64
    label_off: i64
}

struct VarEntry {
    name_start: i64
    name_len:   i64
    slot_off:   i64
    stype:      i64
}

struct JirFunction {
    src:        &i8
    src_len:    i64
    blocks:     BasicBlock[512]
    block_cnt:  i64
    vars:       VarEntry[64]
    var_cnt:    i64
    next_slot_off: i64
    next_id:    i64
    strtab:     i8[4096]
    strtab_pos: i64
    stab:       &StructTable
    param_cnt:  i64
    param_slots:i64[16]
}

struct ConstVal {
    found: i32
    val:   i64
}

struct Fixup {
    code_off:  i64
    target_bb: i64
    kind:      i64
    str_len:   i64
}

struct RegAlloc {
    pool:      i32[8]
    val2reg:   i32[4096]
    reg2val:   i64[8]
    spill_off: i64[4096]
    sp_top:    i64
}

struct LowerCtx {
    ra:         RegAlloc
    fixups:     Fixup[8192]
    fix_cnt:    i64
    bb_offsets: i64[512]
    use_cnt:    i32[4096]
}

struct StructTable {
    cnt:        i64
    names:      i64[64]
    nlens:      i64[64]
    fcnts:      i64[64]
    sizes:      i64[64]
    fbases:     i64[64]
    field_cnt:  i64
    fnames:     i64[4096]
    flens:      i64[4096]
    foffs:      i64[4096]
    ftypes:     i64[4096]
    fis_array:  i64[4096]
    fowners:    i64[4096]
}

; Global constant table pointer (removed ConstTable struct - use separate arrays below)
let g_const_name_off_tbl: &i64 = 0
let g_const_name_len_tbl: &i64 = 0
let g_const_val_tbl: &i64 = 0
let g_const_cnt = 0
; Flat struct name/size tables (avoids jda0 struct-array-field offset bug)
let g_struct_name_off: &i64 = 0
let g_struct_name_len: &i64 = 0
let g_struct_flat_cnt = 0
let g_struct_sizes:    &i64 = 0
; Flat field table (avoids jda0 struct-array-field offset bug in lookup_field_idx_any)
let g_field_owner:    &i64 = 0
let g_field_name_off: &i64 = 0
let g_field_name_len: &i64 = 0
let g_field_byte_off: &i64 = 0
let g_field_type:     &i64 = 0
let g_field_is_arr:   &i64 = 0
let g_field_total_cnt = 0
let g_dbg_fi = 0
let g_dbg_toks: &Token = 0
let g_dbg_toks_init: &Token = 0
let g_dbg_tok_cnt = 0
let g_small_seeded = 0
let g_small_has_main = 0
let g_scan_tok_cnt = 0
let g_more_top = 0
let g_main_pos = 0
let g_panic_pos = 0
let g_cur_fn_name_start = 0
let g_cur_fn_name_len = 0
let g_cur_fn_end = 0
let g_top_fn_cnt = 0
let g_top_main_idx = -1
let g_dbg_main_prints = 0
let g_dbg_main_lets = 0
let g_dbg_main_exprs = 0
let g_dbg_main_steps = 0
let g_small_err_loop = 0
let g_small_err_branch = 0
let g_glob_name_off: &i64 = 0
let g_glob_name_len: &i64 = 0
let g_glob_off: &i64      = 0
let g_glob_size: &i64     = 0
let g_glob_stype: &i64    = 0
let g_glob_is_addr: &i64  = 0
let g_glob_cnt      = 0
let g_glob_total_sz = 0
let g_tmp_let_gidx = 0
let g_tmp_let_stype = 0
let g_tmp_let_is_addr = 0
let g_emit_glob_buf: &i8 = 0
let g_emit_glob_len = 0
let g_cmp_src: &i8 = 0
let g_lex_tmp_emit = 0
let g_lex_tmp_type = 0
let g_lex_tmp_start = 0
let g_lex_tmp_len = 0
let g_cmp_name_start = 0
let g_cmp_name_len = 0
let g_lex_count_ptr = 0
let g_lex_count = 0
let g_lex_src_len = 0
let g_lex_src_ptr: &i8 = 0
let g_lex_pos_i = 0
let g_lower_is_main = 0
let g_fn_lbrace_tmp = 0
let g_fn_rbrace_tmp = -1
let g_skip_fn_body_compile_tmp = 0
let g_small_work_jfn: &JirFunction = 0
let g_small_work_bb = 0
let g_large_mode = 0
let g_fn_name_off_tbl: &i64 = 0
let g_fn_name_len_tbl: &i64 = 0
let g_fn_code_off_tbl: &i64 = 0
let g_last_fn_code_off: i64 = 0
let g_entry_main_idx: i64 = -1
let g_main_str_dbg: i64 = 0
let g_stab_ptr: &StructTable = 0
let g_loop_ctrl: i64 = 0
let g_fix_merged_pos: i64 = 0
let g_argv_base: &i64 = 0
let g_runtime_src_len: i64 = 0
let g_src_buf_ptr: &i8 = 0
let g_small_src_buf_ptr: &i8 = 0
let g_out_path_ptr: &i8 = 0
let g_jfn_heap: &i8 = 0
let g_jfn: &JirFunction = 0
let g_ctx_heap: &i8 = 0
let g_ctx: &LowerCtx = 0

; ============================================================
; 2. LEXER
; ============================================================

fn load_i64_at0(p: &i64) {
    ret p[0]
}

fn store_i64_at0(p: &i64, v: i64) {
    p[0] = v
}

fn inc_i64_at0(p: &i64) {
    let cur = load_i64_at0(p)
    p[0] = cur + 1
}

fn inc_i64_at0_twice(p: &i64) {
    inc_i64_at0(p)
    inc_i64_at0(p)
}

fn load_i64_at(p: &i64, idx: i64) {
    ret p[idx]
}

fn store_i64_at(p: &i64, idx: i64, v: i64) {
    p[idx] = v
}

fn lex_store_tok3(toks: &Token, idx: i64, typ: i64, start: i64, len: i64) {
    toks[idx].type = typ
    toks[idx].str_start = start
    toks[idx].str_len = len
}

fn lex_store_tok1(toks: &Token, idx: i64, typ: i64) {
    toks[idx].type = typ
}

fn tok_type_at_raw(toks: &Token, idx: i64) -> i64 {
    let tokp = (toks as &i8) + (idx * 40)
    ret load_i64_at0(tokp as &i64)
}

fn tok_str_start_at_raw(toks: &Token, idx: i64) -> i64 {
    let tokp = (toks as &i8) + (idx * 40) + 16
    ret load_i64_at0(tokp as &i64)
}

fn tok_str_len_at_raw(toks: &Token, idx: i64) -> i64 {
    let tokp = (toks as &i8) + (idx * 40) + 24
    ret load_i64_at0(tokp as &i64)
}

fn load_i8_at(p: &i8, idx: i64) {
    ret p[idx]
}

fn load_i8_at0(p: &i8, idxp: &i64) {
    ret p[idxp[0]]
}

fn char_at_pos(src: &i8, pos: &i64) {
    ret load_i8_at0(src, pos)
}

fn lex_scan_int(pos: &i64) {
    let val = 0
    loop load_i64_at0(pos) < g_lex_src_len {
        let cur = char_at_pos(g_lex_src_ptr, pos)
        if cur < 48 {
            ret val
        } else if cur > 57 {
            ret val
        } else {
            val = val * 10
            val = val + cur
            val = val - 48
            pos[0] = pos[0] + 1
        }
    }
    ret val
}

fn lex_skip_escaped_char(pos: &i64, src_len: i64) {
    pos[0] = pos[0] + 1
    if load_i64_at0(pos) < src_len {
        pos[0] = pos[0] + 1
    }
}

fn lex_skip_string_body() {
    loop g_lex_pos_i < g_lex_src_len {
        let sc = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
        if sc == 34 {
            ret 0
        } else if sc == 92 {
            g_lex_pos_i = g_lex_pos_i + 1
            if g_lex_pos_i < g_lex_src_len {
                g_lex_pos_i = g_lex_pos_i + 1
            }
        } else {
            g_lex_pos_i = g_lex_pos_i + 1
        }
    }
    ret 0
}

fn lex_set_pos_ptr(pos: &i64) {
    g_lex_pos_i = pos[0]
}

fn lex_sync_pos_ptr(pos: &i64) {
    pos[0] = g_lex_pos_i
}

fn lex_set_pos_i(v: i64) {
    g_lex_pos_i = v
}

fn lex_inc_pos_i() {
    g_lex_pos_i = g_lex_pos_i + 1
}

fn lex_mark_string_start() {
    g_cmp_name_start = g_lex_pos_i
    g_cmp_name_start = g_cmp_name_start + 1
    g_lex_pos_i = g_lex_pos_i + 1
}

fn lex_emit_marked_string(toks: &Token) {
    let len = g_lex_pos_i - g_cmp_name_start
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    let idx = g_lex_count
    toks[idx].type = TOK_STR
    toks[idx].str_start = g_cmp_name_start
    toks[idx].str_len = len
    g_lex_count = g_lex_count + 1
}

fn lex_handle_gt_next(toks: &Token, pos: &i64) {
    let next = load_i64_at0(pos)
    let nxt = load_i8_at(g_lex_src_ptr, next + 1)
    let tok = ((nxt == 62) * TOK_SHR) + ((nxt == 61) * TOK_GTE) + ((nxt != 62 and nxt != 61) * char_to_tok(62))
    toks[g_lex_count].type = tok
    g_lex_count = g_lex_count + 1
    pos[0] = next + 1 + (nxt == 62) + (nxt == 61)
}

fn lex_handle_lt_next(toks: &Token, pos: &i64) {
    let next = load_i64_at0(pos)
    let nxt = load_i8_at(g_lex_src_ptr, next + 1)
    let tok = ((nxt == 60) * TOK_SHL) + ((nxt == 61) * TOK_LTE) + ((nxt != 60 and nxt != 61) * char_to_tok(60))
    toks[g_lex_count].type = tok
    g_lex_count = g_lex_count + 1
    pos[0] = next + 1 + (nxt == 60) + (nxt == 61)
}

fn lex_emit_ident_or_kw(toks: &Token, pos: &i64) {
    let start = pos[0]
    let keep_ident = 1
    loop keep_ident == 1 {
        if pos[0] >= g_lex_src_len {
            keep_ident = 0
        } else {
            let cur = load_i8_at(g_lex_src_ptr, pos[0])
            if is_ident_continue(cur) == 1 {
                pos[0] = pos[0] + 1
            } else {
                keep_ident = 0
            }
        }
    }
    let len = pos[0] - start
    let kw = classify_keyword(g_lex_src_ptr, start, len)
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    let idx = g_lex_count
    toks[idx].type = kw
    toks[idx].str_start = start
    toks[idx].str_len = len
    g_lex_count = g_lex_count + 1
}

fn lex_emit_ident_local(src: &i8, src_len: i64, toks: &Token, pos: &i64, count: i64) -> i64 {
    let start = load_i64_at0(pos)
    let stop = start
    let probe = start
    loop probe < src_len {
        let cur = load_i8_at(src, probe)
        if (cur >= 97 and cur <= 122) or (cur >= 65 and cur <= 90) or (cur >= 48 and cur <= 57) or cur == 95 {
            probe = probe + 1
            stop = probe
        } else {
            probe = src_len
        }
    }
    let len = stop - start
    let kw = classify_keyword(src, start, len)
    if count >= 262143 { panic("Token buffer overflow") }
    toks[count].type = kw
    toks[count].str_start = start
    toks[count].str_len = len
    pos[0] = stop
    ret count + 1
}

fn lex_ident_end(src: &i8, src_len: i64, start: i64) -> i64 {
    let p = start
    let keep_ident = 1
    let guard = 0
    loop keep_ident == 1 {
        guard = guard + 1
        if guard > src_len + 2 {
            keep_ident = 0
        } else
        if p >= src_len {
            keep_ident = 0
        } else {
            let ic = load_i8_at(src, p)
            if (ic >= 97 and ic <= 122) or (ic >= 65 and ic <= 90) or (ic >= 48 and ic <= 57) or ic == 95 {
                p = p + 1
            } else {
                keep_ident = 0
            }
        }
    }
    ret p
}

fn lex_ident_advance_global() {
    let keep_ident = 1
    let guard = 0
    loop keep_ident == 1 {
        guard = guard + 1
        if guard > g_lex_src_len + 2 {
            keep_ident = 0
        } else
        if g_lex_pos_i >= g_lex_src_len {
            keep_ident = 0
        } else {
            let ic = g_lex_src_ptr[g_lex_pos_i]
            if (ic >= 97 and ic <= 122) or (ic >= 65 and ic <= 90) or (ic >= 48 and ic <= 57) or ic == 95 {
                g_lex_pos_i = g_lex_pos_i + 1
            } else {
                keep_ident = 0
            }
        }
    }
}

fn tok_idx_in_range(idx: i64) -> i64 {
    ret idx >= 0 and idx < g_dbg_tok_cnt
}

fn tok_type_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    let raw = tok_type_at_raw(toks, safe_idx)
    ret ok * raw + (ok == 0) * TOK_EOF
}

fn tok_type_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_type_at0(toks, &pos)
}

fn tok_imm_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    let tokp = (toks as &i8) + (safe_idx * 40) + 32
    ret load_i64_at0(tokp as &i64)
}

fn tok_imm_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_imm_at0(toks, &pos)
}

fn tok_str_start_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    ret tok_str_start_at_raw(toks, safe_idx)
}

fn tok_str_start_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_str_start_at0(toks, &pos)
}

fn tok_str_len_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    ret tok_str_len_at_raw(toks, safe_idx)
}

fn tok_str_len_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_str_len_at0(toks, &pos)
}

fn span_in_src(start: i64, len: i64, src_len: i64) -> i64 {
    let end = start + len
    ret start >= 0 and len >= 0 and start <= src_len and len <= src_len and end >= start and end <= src_len
}

fn parse_const_decl(toks: &Token) {
    expect(TOK_CONST)
    let c_name_start = tok_str_start_at(toks, g_main_pos)
    let c_name_len = tok_str_len_at(toks, g_main_pos)
    expect(TOK_IDENT)
    expect(TOK_EQ)
    let c_val = tok_imm_at(toks, g_main_pos)
    expect(TOK_INT)
    let idx = g_const_cnt
    g_const_name_off_tbl[idx] = c_name_start
    g_const_name_len_tbl[idx] = c_name_len
    g_const_val_tbl[idx] = c_val
    g_const_cnt = idx + 1
}

fn is_skip_rhs_int_tok(t: i64) -> i64 {
    ret t == 11
}

fn is_skip_rhs_type_tok(t: i64) -> i64 {
    ret t == 45 or t == 46 or t == 47 or t == 48 or t == 10
}

fn skip_top_level_let_rhs(toks: &Token, stab: &StructTable, src: &i8) {
    let gidx = g_tmp_let_gidx
    let decl_stype = g_tmp_let_stype
    let decl_is_addr = g_tmp_let_is_addr
    let t = tok_type_at_raw(toks, g_main_pos)
    g_glob_size[gidx] = 8
    g_glob_stype[gidx] = decl_stype
    g_glob_is_addr[gidx] = decl_is_addr
    let is_int_tok = is_skip_rhs_int_tok(t)
    if is_int_tok {
        g_glob_is_addr[gidx] = 0  ; pointer global with integer initial value: load value in expressions
        g_main_pos = g_main_pos + 1
        ret ok(0)
    }
    let is_type_tok = is_skip_rhs_type_tok(t)
    if is_type_tok == 1 {
        let elem_sz = 8
        let stype = TYPE_I64
        let is_struct_type_tok = t == 10
        if is_struct_type_tok {
            let type_idx = g_main_pos
            let type_start = tok_str_start_at(toks, type_idx)
            let type_len = tok_str_len_at(toks, type_idx)
            let sid = lookup_struct_name(src, type_start, type_len)
            if sid >= 0 {
                elem_sz = stab.sizes[sid]
                stype = sid
            }
        }
        g_glob_size[gidx] = elem_sz
        g_glob_stype[gidx] = stype
        g_glob_is_addr[gidx] = 1
        g_main_pos = g_main_pos + 1
        let next_idx = g_main_pos
        let next_type = tok_type_at_raw(toks, next_idx)
        let has_array_suffix = next_type == 17
        if has_array_suffix {
            g_main_pos = g_main_pos + 1
            let size_idx = g_main_pos
            let n = tok_imm_at(toks, size_idx)
            g_main_pos = g_main_pos + 1
            expect(TOK_RBRACK)
            g_glob_size[gidx] = elem_sz * n
            ret ok(0)
        }
        let has_empty_braces = next_type == 15
        if has_empty_braces {
            g_main_pos = g_main_pos + 1
            expect(TOK_RBRACE)
            ret ok(0)
        }
        ret ok(0)
    }
    g_main_pos = g_main_pos + 1
}

fn skip_top_level_let(toks: &Token, stab: &StructTable, src: &i8) {
    expect(TOK_LET)
    let name_start = tok_str_start_at(toks, g_main_pos)
    let name_len = tok_str_len_at(toks, g_main_pos)
    
    expect(TOK_IDENT)
    let decl_stype = TYPE_I64
    let decl_is_addr = 0
    let has_type_annot = tok_type_at_raw(toks, g_main_pos) == 20
    if has_type_annot {
        g_main_pos = g_main_pos + 1
        let is_ptr = 0
        let has_ptr_annot = tok_type_at_raw(toks, g_main_pos) == 32
        if has_ptr_annot {
            is_ptr = 1
            g_main_pos = g_main_pos + 1
        }
        let dt = tok_type_at_raw(toks, g_main_pos)
        if dt == 45 { decl_stype = TYPE_I64 }
        if dt == 46 { decl_stype = TYPE_I32 }
        if dt == 47 { decl_stype = TYPE_I8 }
        if dt == 48 { decl_stype = TYPE_F64 }
        if dt == 10 {
            let type_start = tok_str_start_at(toks, g_main_pos)
            let type_len = tok_str_len_at(toks, g_main_pos)
            let sid = lookup_struct_name(src, type_start, type_len)
            if sid >= 0 {
                decl_stype = sid
            }
            if sid < 0 { decl_stype = TYPE_PTR }
        }
        if is_ptr == 1 {
            decl_stype = ptr_of(decl_stype)
            decl_is_addr = 1
        }
        g_main_pos = g_main_pos + 1
    }
    expect(TOK_EQ)
    if g_glob_name_off == 0 { panic("Global table missing") }
    let gidx = g_glob_cnt
    if gidx >= 4096 { panic("Too many globals") }
    g_glob_name_off[gidx] = name_start
    g_glob_name_len[gidx] = name_len
    g_glob_off[gidx] = g_glob_total_sz
    g_tmp_let_gidx = gidx
    g_tmp_let_stype = decl_stype
    g_tmp_let_is_addr = decl_is_addr
    skip_top_level_let_rhs(toks, stab, src)
    let glob_sz = load_i64_at(g_glob_size, gidx)
    
    g_glob_total_sz = g_glob_total_sz + glob_sz
    
    g_glob_cnt = gidx + 1
}

fn panic(msg: &i8) {
    let has_msg = msg != 0
    if has_msg {
        let n = cstr_len_max(msg, 1024)
        syscall(1, 2, msg, n)
        syscall(1, 2, "\n", 1)
    }
    syscall(60, 1, 0, 0)
}

fn cstr_len_max(buf: &i8, max_len: i64) -> i64 {
    let n = 0
    loop n < max_len {
        if buf[n] == 0 { ret n }
        n = n + 1
    }
    ret n
}

fn streq(src: &i8, start: i64, len: i64, kw: &i8) {
    let i = 0
    loop i < len {
        let a = src[start + i]
        let b = kw[i]
        if a != b { ret 0 }
        i = i + 1
    }
    let tail = kw[len]
    if tail != 0 { ret 0 }
    ret 1
}

fn str_match(src: &i8, s1: i64, s2: i64, len: i64) {
    let p1 = s1
    let p2 = s2
    let n = 0
    loop n < len {
        let a = load_i8_at(src, p1)
        let b = load_i8_at(src, p2)
        if a != b { ret 0 }
        p1 = p1 + 1
        p2 = p2 + 1
        n = n + 1
    }
    ret 1
}

fn try_escape(c: i8, next_c: i8) {
    if c == 92 {
        if next_c == 110 { ret 10 }
        if next_c == 116 { ret 9 }
        if next_c == 92 { ret 92 }
        if next_c == 34 { ret 34 }
    }
    ret -1
}

; Type system helpers
fn is_pointer_type(t: i32) {
    ret t >= 65536
}

fn base_type(t: i32) {
    let is_ptr = is_pointer_type(t)
    ret t - (is_ptr * 65536)
}

fn ptr_of(base: i32) {
    ret base + TYPE_PTR_FLAG
}

fn type_sizeof(st: i32) {
    let b = base_type(st)
    let is_i8 = b == 3
    if is_i8 { ret 1 }
    let is_i32 = b == 2
    if is_i32 { ret 4 }
    ret 8
}

fn ok(x: i64) {
    ret x
}

fn lookup_const(src: &i8, name_start: i64, name_len: i64) {
    let i = 0
    loop i < g_const_cnt {
        let cur_len = g_const_name_len_tbl[i]
        let cur_val = g_const_val_tbl[i]
        if cur_len == name_len {
            let cur_off = g_const_name_off_tbl[i]
            let sm = str_match(src, cur_off, name_start, name_len)
            if sm == 1 {
                ret cur_val
            }
        }
        i = i + 1
    }
    ret -1
}

fn print_span(src: &i8, start: i64, len: i64) {
    let has_len = len > 0
    if has_len == 0 { ret 0 }
    syscall(1, 1, src + start, len)
}

fn print(msg: &i8) {
    let has_msg = msg != 0
    if has_msg == 0 { ret 0 }
    let n = cstr_len_max(msg, 1024)
    syscall(1, 1, msg, n)
}

fn eprint(msg: &i8) {
    let has_msg = msg != 0
    if has_msg == 0 { ret 0 }
    let n = cstr_len_max(msg, 1024)
    syscall(1, 2, msg, n)
}

fn eprint_i64(val: i64) {
    if val == 0 {
        
        ret 0
    }
    let v = val
    if v < 0 {
        
        v = 0 - v
    }
    let buf = i8[32]
    let i = 30
    buf[31] = 0
    let safety = 0
    loop v > 0 {
        let q = v / 10
        let digit = v - q * 10
        buf[i] = digit + 48
        v = q
        i = i - 1
        safety = safety + 1
        if safety > 32 { v = 0 }
    }
    let s = &buf[i+1]
    
}

fn live_codegen_expr_inline(bb: i64) -> i64 {
    let r = live_codegen_binop_inline(0, bb)
    ret r
}

fn regalloc_free_old(ra: &RegAlloc, val_id: i64) {
    if val_id < 0 { ret ok(0) }
    if val_id >= 4096 { ret ok(0) }
    let idx = ra.val2reg[val_id]
    if idx == -1 { ret ok(0) }
    if idx < 0 { ret ok(0) }
    
    ra.reg2val[idx]    = -1
    ra.val2reg[val_id] = -1
}

fn is_alpha(c: i8) {
    ret (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
}

fn is_digit(c: i8) {
    ret c >= 48 and c <= 57
}

fn is_space_char(c: i8) {
    ret c == 32 or c == 9 or c == 10 or c == 13
}

fn is_ident_continue(c: i8) {
    ret is_alpha(c) == 1 or is_digit(c) == 1 or c == 95
}

fn is_ident_start(c: i8) {
    ret is_alpha(c) == 1 or c == 95
}

fn char_to_tok_lo(c: i8) {
    ret (c == 38) * TOK_AMP +
        (c == 40) * TOK_LPAREN +
        (c == 41) * TOK_RPAREN +
        (c == 42) * TOK_STAR +
        (c == 43) * TOK_PLUS +
        (c == 44) * TOK_COMMA +
        (c == 45) * TOK_MINUS +
        (c == 46) * TOK_DOT +
        (c == 47) * TOK_SLASH
}

fn char_to_tok_mid(c: i8) {
    ret (c == 58) * TOK_COLON +
        (c == 60) * TOK_LT +
        (c == 61) * TOK_EQ +
        (c == 62) * TOK_GT +
        (c == 91) * TOK_LBRACK +
        (c == 93) * TOK_RBRACK
}

fn char_to_tok_hi(c: i8) {
    ret (c == 123) * TOK_LBRACE +
        (c == 124) * TOK_PIPE +
        (c == 125) * TOK_RBRACE +
        (c == 126) * TOK_TILDE
}

fn char_to_tok(c: i8) {
    let lo = char_to_tok_lo(c)
    let mid = char_to_tok_mid(c)
    let hi = char_to_tok_hi(c)
    let tok = lo + mid + hi
    ret tok + (tok == 0) * TOK_EOF
}

fn classify_keyword_len2(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let tok = ((c0 == 102 and c1 == 110) * TOK_FN) +
        ((c0 == 105 and c1 == 102) * TOK_IF) +
        ((c0 == 111 and c1 == 114) * TOK_OR) +
        ((c0 == 105 and c1 == 56) * TOK_I8)
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len3(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let tok = ((c0 == 108 and c1 == 101 and c2 == 116) * TOK_LET) +
        ((c0 == 114 and c1 == 101 and c2 == 116) * TOK_RET) +
        ((c0 == 97 and c1 == 110 and c2 == 100) * TOK_AND) +
        ((c0 == 105 and c1 == 54 and c2 == 52) * TOK_I64) +
        ((c0 == 105 and c1 == 51 and c2 == 50) * TOK_I32) +
        ((c0 == 102 and c1 == 54 and c2 == 52) * TOK_F64)
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len4(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let tok = ((c0 == 101 and c1 == 108 and c2 == 115 and c3 == 101) * TOK_ELSE) +
        ((c0 == 108 and c1 == 111 and c2 == 111 and c3 == 112) * TOK_LOOP)
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len5(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let c4 = load_i8_at(src, start + 4)
    let tok = ((c0 == 109 and c1 == 97 and c2 == 116 and c3 == 99 and c4 == 104) * TOK_MATCH) +
        ((c0 == 112 and c1 == 114 and c2 == 105 and c3 == 110 and c4 == 116) * TOK_PRINT) +
        ((c0 == 99 and c1 == 111 and c2 == 110 and c3 == 115 and c4 == 116) * TOK_CONST)
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len6(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let c4 = load_i8_at(src, start + 4)
    let c5 = load_i8_at(src, start + 5)
    let tok = (c0 == 115 and c1 == 116 and c2 == 114 and c3 == 117 and c4 == 99 and c5 == 116) * TOK_STRUCT
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len7(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let c4 = load_i8_at(src, start + 4)
    let c5 = load_i8_at(src, start + 5)
    let c6 = load_i8_at(src, start + 6)
    let tok = (c0 == 115 and c1 == 121 and c2 == 115 and c3 == 99 and c4 == 97 and c5 == 108 and c6 == 108) * TOK_SYSCALL
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword(src: &i8, start: i64, len: i64) {
    let t2 = (len == 2) * classify_keyword_len2(src, start, len)
    let t3 = (len == 3) * classify_keyword_len3(src, start, len)
    let t4 = (len == 4) * classify_keyword_len4(src, start, len)
    let t5 = (len == 5) * classify_keyword_len5(src, start, len)
    let t6 = (len == 6) * classify_keyword_len6(src, start, len)
    let t7 = (len == 7) * classify_keyword_len7(src, start, len)
    let tok = t2 + t3 + t4 + t5 + t6 + t7
    ret tok + (tok == 0) * TOK_IDENT
}

fn emit_lex_tok(out_toks: &Token, count: &i64, tok: i32) {
    let cur = load_i64_at0(count)
    if cur >= 262143 {
        panic("Token buffer overflow")
    }
    out_toks[cur].type = tok
    count[0] = cur + 1
}

fn lex_handle_minus(toks: &Token, pos: &i64) {
    let next = load_i64_at0(pos)
    if next + 1 < g_lex_src_len {
        let nxt = load_i8_at(g_lex_src_ptr, next + 1)
        if nxt == 62 {
            if g_lex_count >= 262143 { panic("Token buffer overflow") }
            toks[g_lex_count].type = 22
            g_lex_count = g_lex_count + 1
            pos[0] = pos[0] + 2
            ret
        }
    }
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    toks[g_lex_count].type = char_to_tok(45)
    g_lex_count = g_lex_count + 1
    pos[0] = pos[0] + 1
}

fn lex_handle_eq(toks: &Token, pos: &i64) {
    toks[g_lex_count].type = char_to_tok(61)
    g_lex_count = g_lex_count + 1
    pos[0] = pos[0] + 1
}

fn lex_handle_bang(toks: &Token, pos: &i64) {
    ret ok(0)
}

fn lex_try_space_or_comment(src: &i8, src_len: i64, c: i8) -> i64 {
    ret 0
}

fn lex_try_string(toks: &Token, c: i8) -> i64 {
    ret 0
}

fn lex_try_int(toks: &Token, c: i8) -> i64 {
    ret 0
}

fn lex_try_ident(toks: &Token, src: &i8, src_len: i64, c: i8) -> i64 {
    ret 0
}

fn lex_try_op(toks: &Token, c: i8) -> i64 {
    ret 0
}

fn lex_small_tail_dispatch(toks: &Token, src: &i8, src_len: i64) {
    let c = src[g_lex_pos_i]
    if g_lex_pos_i == 0 {
        g_lex_count = 0
    }
    if g_lex_pos_i == 0 and g_lex_count != 0 { panic("SM_CNT0_SET_BAD") }
    if g_lex_pos_i == 0 {
        g_lex_src_ptr = src
        g_lex_src_len = src_len
        let start = g_lex_pos_i
        let end = lex_ident_end(src, src_len, start)
        let len = end - start
        let kw = classify_keyword(src, start, len)
        g_lex_pos_i = end
        g_lex_tmp_emit = 1
        g_lex_tmp_type = kw
        g_lex_tmp_start = start
        g_lex_tmp_len = len
        if toks == g_dbg_toks {
        } else {
        }
        if toks == g_dbg_toks_init {
        } else {
        }
        g_dbg_toks_init[0].type = kw
        g_dbg_toks_init[0].str_start = start
        g_dbg_toks_init[0].str_len = len
        g_lex_tmp_emit = 0
        g_lex_tmp_emit = 0
        g_lex_count = 1
        g_lex_pos_i = end
        ret 0
    }
    if c >= 97 {
        if c <= 122 {
            g_lex_src_ptr = src
            g_lex_src_len = src_len
            lex_emit_ident_or_kw(toks, &g_lex_pos_i)
            ret 0
        }
    }
    if c >= 65 {
        if c <= 90 {
            g_lex_src_ptr = src
            g_lex_src_len = src_len
            lex_emit_ident_or_kw(toks, &g_lex_pos_i)
            ret 0
        }
    }
    if c == 95 {
        g_lex_src_ptr = src
        g_lex_src_len = src_len
        lex_emit_ident_or_kw(toks, &g_lex_pos_i)
        ret 0
    }
    if lex_try_int(toks, c) == 1 { ret 0 }
    if lex_try_op(toks, c) == 1 { ret 0 }
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    toks[g_lex_count].type = char_to_tok(c)
    g_lex_count = g_lex_count + 1
    g_lex_pos_i = g_lex_pos_i + 1
}

fn lex_small(src: &i8, src_len: i64, toks: &Token) -> i32 {
    let p = 0
    let count = 0
    loop p < src_len {
        let c = src[p]
        if c == 32 or c == 10 or c == 9 or c == 13 {
            p = p + 1
        } else if c == 59 {
            p = p + 1
            loop p < src_len {
                if src[p] == 10 {
                    p = p + 1
                    break
                }
                p = p + 1
            }
        } else if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 {
            let start = p
            g_loop_ctrl = 1
            loop g_loop_ctrl == 1 {
                if p >= src_len {
                    g_loop_ctrl = 0
                } else {
                    let ic = src[p]
                    if (ic >= 97 and ic <= 122) or (ic >= 65 and ic <= 90) or (ic >= 48 and ic <= 57) or ic == 95 {
                        p = p + 1
                    } else {
                        g_loop_ctrl = 0
                    }
                }
            }
            let len = p - start
            let kw = TOK_IDENT
            if len == 2 {
                if src[start] == 102 {
                    if src[start + 1] == 110 {
                        kw = TOK_FN
                    }
                }
            }
            if len == 5 {
                if src[start] == 112 {
                    if src[start + 1] == 114 {
                        if src[start + 2] == 105 {
                            if src[start + 3] == 110 {
                                if src[start + 4] == 116 {
                                    kw = TOK_PRINT
                                }
                            }
                        }
                    }
                }
            }
            toks[count].type = kw
            toks[count].str_start = start
            toks[count].str_len = len
            count = count + 1
        } else if c == 34 {
            let start = p + 1
            p = p + 1
            let in_str = 1
            let guard = 0
            loop in_str == 1 {
                guard = guard + 1
                if guard > src_len + 2 {
                    in_str = 0
                } else
                if p >= src_len {
                    in_str = 0
                } else if src[p] == 34 {
                    in_str = 0
                } else if src[p] == 92 {
                    p = p + 1
                    if p < src_len { p = p + 1 }
                } else {
                    p = p + 1
                }
            }
            toks[count].type = TOK_STR
            toks[count].str_start = start
            toks[count].str_len = p - start
            count = count + 1
            if p < src_len and src[p] == 34 { p = p + 1 }
        } else if c == 45 {
            if p + 1 < src_len and src[p + 1] == 62 {
                toks[count].type = TOK_ARROW
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                count = count + 1
                p = p + 1
            }
        } else if c == 61 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_EQEQ
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = TOK_EQ
                count = count + 1
                p = p + 1
            }
        } else if c == 33 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_NEQ
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                count = count + 1
                p = p + 1
            }
        } else if c == 62 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_GTE
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = TOK_GT
                count = count + 1
                p = p + 1
            }
        } else if c == 60 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_LTE
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = TOK_LT
                count = count + 1
                p = p + 1
            }
        } else {
            toks[count].type = char_to_tok(c)
            count = count + 1
            p = p + 1
        }
    }
    toks[count].type = TOK_EOF
    ret count
}

fn lex_int_store(src: &i8, src_len: i64, p: i64, toks: &Token, count: i64) -> i64 {
    let val = 0
    let p2 = p
    let c0 = load_i8_at(src, p)
    if c0 == 48 and p + 1 < src_len {
        let nc = load_i8_at(src, p + 1)
        if nc == 120 or nc == 88 {
            p2 = p + 2
            loop p2 < src_len {
                let hc = load_i8_at(src, p2)
                let hv = 0
                if hc >= 48 and hc <= 57 {
                    val = val * 16 + (hc - 48)
                    hv = 1
                }
                if hc >= 97 and hc <= 102 {
                    val = val * 16 + (hc - 87)
                    hv = 1
                }
                if hc >= 65 and hc <= 70 {
                    val = val * 16 + (hc - 55)
                    hv = 1
                }
                if hv == 0 { break }
                p2 = p2 + 1
            }
            toks[count].imm = val
            ret p2
        }
    }
    loop p2 < src_len {
        let dc = load_i8_at(src, p2)
        if dc < 48 or dc > 57 { break }
        val = val * 10 + (dc - 48)
        p2 = p2 + 1
    }
    toks[count].imm = val
    ret p2
}

fn lex_small_fast(src: &i8, src_len: i64, toks: &Token) -> i32 {
    let p = 0
    let count = 0
    g_lex_count = 0
    g_small_has_main = small_input_has_main(src, src_len)
    g_scan_tok_cnt = 0
    loop p < src_len {
        let c = load_i8_at(src, p)
        if c == 32 or c == 10 or c == 9 or c == 13 {
            p = p + 1
        } else if c == 59 {
            p = p + 1
            loop p < src_len {
                if load_i8_at(src, p) == 10 {
                    p = p + 1
                    break
                }
                p = p + 1
            }
        } else if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 {
            let start = p
            p = lex_ident_end(src, src_len, start)
            let len = p - start
            let kw = classify_keyword(src, start, len)
            toks[count].type = kw
            toks[count].str_start = start
            toks[count].str_len = len
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
        } else if c == 34 {
            let start = p + 1
            p = p + 1
            let scanning = 1
            let guard = 0
            loop scanning == 1 {
                guard = guard + 1
                if guard > src_len + 2 {
                    scanning = 0
                } else if p >= src_len {
                    scanning = 0
                } else if load_i8_at(src, p) == 34 {
                    scanning = 0
                } else if load_i8_at(src, p) == 92 {
                    p = p + 1
                    if p < src_len { p = p + 1 }
                } else {
                    p = p + 1
                }
            }
            toks[count].type = TOK_STR
            toks[count].str_start = start
            toks[count].str_len = p - start
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
            if p < src_len and load_i8_at(src, p) == 34 {
                p = p + 1
            }
        } else if c == 45 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 62 {
                toks[count].type = TOK_ARROW
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 61 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_EQEQ
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = TOK_EQ
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 33 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_NEQ
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 62 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_GTE
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = TOK_GT
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 60 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_LTE
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = TOK_LT
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c >= 48 and c <= 57 {
            let new_p = lex_int_store(src, src_len, p, toks, count)
            toks[count].type = TOK_INT
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
            p = new_p
        } else {
            toks[count].type = char_to_tok(c)
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
            p = p + 1
        }
    }
    toks[count].type = TOK_EOF
    g_lex_count = count
    g_scan_tok_cnt = count
    ret count
}

fn lex_global_fast() -> i32 {
    g_lex_src_ptr = g_src_buf_ptr
    g_lex_src_len = g_runtime_src_len
    g_lex_pos_i = 0
    g_lex_count = 0
    loop g_lex_pos_i < g_runtime_src_len {
        let c = g_src_buf_ptr[g_lex_pos_i]
        let handled = 0
        if is_space_char(c) == 1 {
            g_lex_pos_i = g_lex_pos_i + 1
            handled = 1
        }
        if handled == 0 and c == 59 {
            g_lex_pos_i = g_lex_pos_i + 1
            loop g_lex_pos_i < g_runtime_src_len {
                if load_i8_at(g_src_buf_ptr, g_lex_pos_i) == 10 {
                    g_lex_pos_i = g_lex_pos_i + 1
                    break
                }
                g_lex_pos_i = g_lex_pos_i + 1
            }
            handled = 1
        }
        if handled == 0 and c == 34 {
            lex_mark_string_start()
            lex_skip_string_body()
            lex_emit_marked_string(g_dbg_toks_init)
            if g_lex_pos_i < g_lex_src_len {
                g_lex_pos_i = g_lex_pos_i + 1
            }
            handled = 1
        }
        if handled == 0 and is_ident_start(c) == 1 {
            g_lex_src_ptr = g_src_buf_ptr
            g_lex_src_len = g_runtime_src_len
            lex_emit_ident_or_kw(g_dbg_toks_init, &g_lex_pos_i)
            handled = 1
        }
        if handled == 0 and is_digit(c) == 1 {
            let val = lex_scan_int(&g_lex_pos_i)
            let out_idx = g_lex_count
            if out_idx >= 262143 { panic("Token buffer overflow") }
            g_dbg_toks_init[out_idx].type = TOK_INT
            g_dbg_toks_init[out_idx].imm = val
            g_lex_count = g_lex_count + 1
            handled = 1
        }
        if handled == 0 and c == 45 {
            lex_handle_minus(g_dbg_toks_init, &g_lex_pos_i)
            handled = 1
        }
        if handled == 0 and c == 61 {
            let next = g_lex_pos_i
            if next + 1 < g_lex_src_len {
                let nxt = load_i8_at(g_lex_src_ptr, next + 1)
                if nxt == 61 {
                    if g_lex_count >= 262143 { panic("Token buffer overflow") }
                    g_dbg_toks_init[g_lex_count].type = 24
                    g_lex_count = g_lex_count + 1
                    g_lex_pos_i = g_lex_pos_i + 2
                } else {
                    lex_handle_eq(g_dbg_toks_init, &g_lex_pos_i)
                }
            } else {
                lex_handle_eq(g_dbg_toks_init, &g_lex_pos_i)
            }
            handled = 1
        }
        if handled == 0 and c == 33 {
            let next = g_lex_pos_i
            if next + 1 < g_lex_src_len {
                let nxt = load_i8_at(g_lex_src_ptr, next + 1)
                if nxt == 61 {
                    if g_lex_count >= 262143 { panic("Token buffer overflow") }
                    g_dbg_toks_init[g_lex_count].type = 25
                    g_lex_count = g_lex_count + 1
                    g_lex_pos_i = g_lex_pos_i + 2
                } else {
                    g_dbg_toks_init[g_lex_count].type = char_to_tok(33)
                    g_lex_count = g_lex_count + 1
                    g_lex_pos_i = g_lex_pos_i + 1
                }
            } else {
                g_dbg_toks_init[g_lex_count].type = char_to_tok(33)
                g_lex_count = g_lex_count + 1
                g_lex_pos_i = g_lex_pos_i + 1
            }
            handled = 1
        }
        if handled == 0 and c == 62 {
            let next = g_lex_pos_i
            if next + 1 < g_lex_src_len {
                let nxt = load_i8_at(g_lex_src_ptr, next + 1)
                let tok = ((nxt == 62) * TOK_SHR) + ((nxt == 61) * TOK_GTE) + ((nxt != 62 and nxt != 61) * char_to_tok(62))
                g_dbg_toks_init[g_lex_count].type = tok
                g_lex_count = g_lex_count + 1
                g_lex_pos_i = next + 1 + (nxt == 62) + (nxt == 61)
            } else {
                if g_lex_count >= 262143 { panic("Token buffer overflow") }
                g_dbg_toks_init[g_lex_count].type = char_to_tok(62)
                g_lex_count = g_lex_count + 1
                g_lex_pos_i = g_lex_pos_i + 1
            }
            handled = 1
        }
        if handled == 0 and c == 60 {
            let next = g_lex_pos_i
            if next + 1 < g_lex_src_len {
                let nxt = load_i8_at(g_lex_src_ptr, next + 1)
                let tok = ((nxt == 60) * TOK_SHL) + ((nxt == 61) * TOK_LTE) + ((nxt != 60 and nxt != 61) * char_to_tok(60))
                g_dbg_toks_init[g_lex_count].type = tok
                g_lex_count = g_lex_count + 1
                g_lex_pos_i = next + 1 + (nxt == 60) + (nxt == 61)
            } else {
                if g_lex_count >= 262143 { panic("Token buffer overflow") }
                g_dbg_toks_init[g_lex_count].type = char_to_tok(60)
                g_lex_count = g_lex_count + 1
                g_lex_pos_i = g_lex_pos_i + 1
            }
            handled = 1
        }
        if handled == 0 {
            if g_lex_count >= 262143 { panic("Token buffer overflow") }
            g_dbg_toks_init[g_lex_count].type = char_to_tok(c)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + 1
        }
    }
    g_dbg_toks_init[g_lex_count].type = TOK_EOF
    g_scan_tok_cnt = g_lex_count
    ret g_lex_count
}

fn lex(src: &i8, src_len: i64, toks: &Token) -> i32 {
    g_src_buf_ptr = src
    g_runtime_src_len = src_len
    g_dbg_toks_init = toks
    let src_big = 0
    if src_len > 524288 {
        src_big = 1
    }
    if src_big == 1 {
        panic("SRC_LEN_BIG")
    }
    ret lex_small_fast(src, src_len, toks)
}

fn lex_main_input() -> i32 {
    ret lex(g_src_buf_ptr, g_runtime_src_len, g_dbg_toks_init)
}

; Minimal runtime repro for LID helper path:
; one ident scan/classify path without token writes.
fn lex_lid_preflight(src: &i8, src_len: i64, toks: &Token) -> i64 {
    let p = 0
    if src_len <= 0 { ret 0 }
    let c = src[0]
    if is_ident_start(c) == 0 { ret 0 }
    p = lex_ident_end(src, src_len, p)
    let len = p
    let kw = classify_keyword(src, 0, len)
    if kw == TOK_EOF { panic("HPF_KW_BAD") }
    ret p
}

fn small_input_has_main(src: &i8, src_len: i64) -> i64 {
    ret 0 }
    if src_len < 7 { ret 0 }
    if load_i8_at(src, 0) != 102 { ret 0 }
    if load_i8_at(src, 1) != 110 { ret 0 }
    if load_i8_at(src, 2) != 32 { ret 0 }
    if load_i8_at(src, 3) != 109 { ret 0 }
    if load_i8_at(src, 4) != 97 { ret 0 }
    if load_i8_at(src, 5) != 105 { ret 0 }
    if load_i8_at(src, 6) != 110 { ret 0 }
    ret 1
}

fn is_top_fn_tok_runtime(toks: &Token, idx: i64, src: &i8, src_len: i64) -> i64 {
    if idx < 0 or idx >= g_scan_tok_cnt { ret 0 }
    let t = tok_type_at_raw(toks, idx)
    if t == TOK_FN { ret 1 }
    let t_start = tok_str_start_at_raw(toks, idx)
    let t_len = tok_str_len_at_raw(toks, idx)
    if t_len == 2 and span_in_src(t_start, t_len, src_len) == 1 {
        if streq(src, t_start, 2, "fn") == 1 { ret 1 }
    }
    ret 0
}

fn tok_name_fields_runtime(toks: &Token, idx: i64, out_type: &i64, out_off: &i64, out_len: &i64) {
    out_type[0] = tok_type_at_raw(toks, idx)
    out_off[0] = tok_str_start_at_raw(toks, idx)
    out_len[0] = tok_str_len_at_raw(toks, idx)
    ret ok(0)
}

