    }
    let wn1 = syscall(1, out_fd, digits_ptr, val_len)
    if wn1 != val_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn2 = syscall(1, out_fd, pad_ptr, pad_len)
    if wn2 != pad_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn3 = syscall(1, out_fd, suffix_ptr, suffix_len)
    syscall(3, out_fd, 0, 0)
    if wn3 != suffix_len {
        ret 0
    }
    ret 1
}

