    if name.str_len == 12 and streq(g_src_buf_ptr, name.str_start, 12, "tensor_shape") == 1 {
        let ins = Instr{}
        ins.op = OP_TSHAPE
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "tensor_data") == 1 {
        let ins = Instr{}
