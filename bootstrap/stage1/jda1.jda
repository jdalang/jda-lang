    if name.str_len == 12 and streq(g_src_buf_ptr, name.str_start, 12, "avx512_check") == 1 {
        let ins = Instr{}
        ins.op = OP_AVX_CHECK
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 14 and streq(g_src_buf_ptr, name.str_start, 14, "avx512_add_f64") == 1 {
        let ins = Instr{}
        ins.op = OP_AVX_ADDF64
        ins.operand0 = arg0
