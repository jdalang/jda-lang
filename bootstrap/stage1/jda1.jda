    let vb1 = i32_b1(val)
    let vb2 = i32_b2(val)
    let vb3 = i32_b3(val)
    poke_byte(buf, 4102, vb0)
    poke_byte(buf, 4103, vb1)
    poke_byte(buf, 4104, vb2)
    poke_byte(buf, 4105, vb3)
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 { ret 0 }
    let wn = syscall(1, out_fd, buf, n)
    syscall(3, out_fd, 0, 0)
    if wn != n { ret 0 }
    ret 1
}

fn live_compile_if(toks: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_IF { report_error("expected 'if'") }
    g_main_pos = g_main_pos + 1
    let cond_id = live_codegen_expr_inline(bb)
    let then_bb = create_block_live(jfn)
    let else_bb = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    emit_br(jfn, bb, cond_id, then_bb, else_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LBRACE {
        report_error("expected '{' after if condition")
    }
    g_main_pos = g_main_pos + 1
    let then_end = live_compile_block(g_dbg_toks_init, stab, src, jfn, then_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_RBRACE {
        report_error("expected '}' to close if block")
    }
    g_main_pos = g_main_pos + 1
    emit_jmp(jfn, then_end, merge_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_ELSE {
        emit_jmp(jfn, else_bb, merge_bb)
        ret merge_bb
    }
    g_main_pos = g_main_pos + 1
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_IF {
        let else_end = live_compile_if(g_dbg_toks_init, stab, src, jfn, else_bb)
        emit_jmp(jfn, else_end, merge_bb)
        ret merge_bb
    }
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LBRACE { report_error("expected '{' after else") }
    g_main_pos = g_main_pos + 1
    let else_end = live_compile_block(g_dbg_toks_init, stab, src, jfn, else_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_RBRACE { report_error("expected '}' to close else block") }
    g_main_pos = g_main_pos + 1
    emit_jmp(jfn, else_end, merge_bb)
    ret merge_bb
}

fn live_compile_loop(toks: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LOOP { report_error("expected 'loop'") }
    g_main_pos = g_main_pos + 1
    let start_bb = create_block_live(jfn)
    emit_jmp(jfn, bb, start_bb)
    let body_bb = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    let saved_loop_ctrl = g_loop_ctrl
    g_loop_ctrl = merge_bb
    let cond_id = live_codegen_expr_inline(start_bb)
    emit_br(jfn, start_bb, cond_id, body_bb, merge_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LBRACE {
        g_loop_ctrl = saved_loop_ctrl
        ret merge_bb
    }
    g_main_pos = g_main_pos + 1
    let body_end = live_compile_block(g_dbg_toks_init, stab, src, jfn, body_bb)
    g_loop_ctrl = saved_loop_ctrl
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_RBRACE {
        g_main_pos = g_main_pos + 1
    } else if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_EOF {
        emit_jmp(jfn, body_end, start_bb)
        ret merge_bb
    } else {
        report_error("expected '}' to close loop block")
    }
    emit_jmp(jfn, body_end, start_bb)
    ret merge_bb
}

fn lower_fn_mark_uses_instr(ctx: &LowerCtx, ins: &Instr) {
    if ins.dead != 0 { ret ok(0) }
    let op = ins.op
    let o0 = ins.operand0
    let o1 = ins.operand1
    let o2 = ins.operand2
    let o3 = ins.operand3
    if op == OP_ADD or op == OP_SUB or op == OP_MUL or op == OP_DIV or
       op == OP_CMP_EQ or op == OP_CMP_NE or op == OP_CMP_LT or op == OP_CMP_GT or
       op == OP_CMP_LTE or op == OP_CMP_GTE or op == OP_AND or op == OP_OR or
       op == OP_SHR or op == OP_SHL {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_RET or op == OP_BR or op == OP_STRLEN or op == OP_STORE or op == OP_PRINT_INT {
        mark_use(ctx, o0)
    }
    if op == OP_LOAD_MEM {
        mark_use(ctx, o0)
    }
    if op == OP_STORE_MEM {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_SYSCALL {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
        mark_use(ctx, o2)
        mark_use(ctx, ins.bb_target0)
    }
    if op == OP_ALLOC {
        mark_use(ctx, o0)
    }
    if op == OP_CALL {
        if o3 >= 1 { mark_use(ctx, o0) }
        if o3 >= 2 { mark_use(ctx, o1) }
        if o3 >= 3 { mark_use(ctx, o2) }
        if o3 >= 4 { mark_use(ctx, ins.bb_target0) }
        if o3 >= 5 { mark_use(ctx, ins.bb_target1) }
        if o3 >= 6 { mark_use(ctx, ins.imm) }
    }
}

fn lower_fn_emit_prologue(jfn: &JirFunction, out: &i8, pos: &i64, is_main: i64) {
    emit_push_r(out, pos, PHYS_RBP)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xE5)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xEC)
    let frame_sz = 524288
    if is_main == 1 {
        frame_sz = 2097152
    }
    emit_i32_le(out, pos, frame_sz)
    ; Stack probe: touch each 4KB page in the frame top-down so the kernel
    ; maps them before we access [RBP - 65544] for parameter storage.
    ; Without this, SUB RSP, 512KB skips the guard page and causes SIGSEGV.
    ;
    ; Emits (22 bytes):
    ;   LEA R11, [RBP - 4096]      ; 4C 8D 9D 00 F0 FF FF
    ; .probe_loop:
    ;   MOV [R11], R11             ; 4B 89 1B
    ;   SUB R11, 4096              ; 49 81 EB 00 10 00 00
    ;   CMP R11, RSP               ; 49 39 E3
    ;   JGE .probe_loop            ; 7D F1  (-15)
    ;
    ; LEA R11, [RBP - 4096]
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x9D)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0xF0)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xFF)
    ; MOV [R11], R11
    emit_byte(out, pos, 0x4B)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x1B)
    ; SUB R11, 4096
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xEB)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    ; CMP R11, RSP
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x39)
    emit_byte(out, pos, 0xE3)
    ; JGE -15
    emit_byte(out, pos, 0x7D)
    emit_byte(out, pos, 0xF1)
    ; After loop, R11 = RSP - 4096. Touch two more pages below RSP.
    ; When RSP is page-aligned, next fn's probe starts 2 pages below us.
    ; Touch 1: MOV [R11], RBX  (R11 = RSP - 4096)
    emit_byte(out, pos, 0x4B)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x1B)
    ; SUB R11, 4096  (R11 = RSP - 8192)
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xEB)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    ; Touch 2: MOV [R11], RBX  (R11 = RSP - 8192)
    emit_byte(out, pos, 0x4B)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x1B)
}

fn lower_fn_store_params(jfn: &JirFunction, out: &i8, pos: &i64) {
    let pcnt = jfn.param_cnt
    let pi = 0
    loop pi < pcnt {
        let pr = PHYS_RDI
        if pi == 1 { pr = PHYS_RSI }
        if pi == 2 { pr = PHYS_RDX }
        if pi == 3 { pr = PHYS_RCX }
        if pi == 4 { pr = PHYS_R8 }
        if pi == 5 { pr = PHYS_R9 }
        let pslot = jfn.param_slots[pi]
        emit_store_spill(out, pos, pslot, pr)
        pi = pi + 1
    }
}

fn lower_fn_collect_uses(jfn: &JirFunction, ctx: &LowerCtx) {
    let ui = 0
    loop ui < 8192 {
        ctx.use_cnt[ui] = 0
        ui = ui + 1
    }
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            lower_fn_mark_uses_instr(ctx, jfn.blocks[bi].instrs[ii])
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn lower_fn_emit_blocks(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let i = 0
    loop i < jfn.block_cnt {
        ctx.bb_offsets[i] = pos[0]
        lower_block(jfn.blocks[i], ctx, jfn, out, pos)
        i = i + 1
    }
}

fn lower_fn_emit_epilogue(out: &i8, pos: &i64, is_main: i64) {
    if is_main == 1 {
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 60)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)
        ret ok(0)
    }
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xEC)
    emit_pop_r(out, pos, PHYS_RBP)
    emit_ret_instr(out, pos)
}

fn lower_fn_patch_fixups(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let fi = 0
    loop fi < ctx.fix_cnt {
        if ctx.fixups[fi].kind == 0 {
            let co = ctx.fixups[fi].code_off
            let tb = ctx.fixups[fi].target_bb
            if tb >= 0 and tb < jfn.block_cnt and tb < 256 and co >= 0 and co + 3 < pos[0] {
                let target_off = ctx.bb_offsets[tb]
                let rel = target_off - (co + 4)
                poke_byte(out, co,     i32_b0(rel))
                poke_byte(out, co + 1, i32_b1(rel))
                poke_byte(out, co + 2, i32_b2(rel))
                poke_byte(out, co + 3, i32_b3(rel))
            }
        }
        fi = fi + 1
    }
}

fn lower_fn(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64, is_main: i64) {
    g_lower_is_main = is_main
    lower_fn_emit_prologue(jfn, out, pos, is_main)
    lower_fn_store_params(jfn, out, pos)
    lower_fn_collect_uses(jfn, ctx)
    lower_fn_emit_blocks(jfn, ctx, out, pos)
    lower_fn_emit_epilogue(out, pos, is_main)
    g_lower_is_main = 0
    lower_fn_patch_fixups(jfn, ctx, out, pos)
}

fn write_elf(out_fd: i64, code: &i8, code_len: i64,
             strtab: &i8, strtab_len: i64) {
    let buf = alloc_pages(1)
    let pos = 0
    let load_va   = 0x400000
    let hdr_size  = 120
    let code_va   = load_va + hdr_size
    let total     = hdr_size + code_len + strtab_len + 1048576

    ; --- ELF Header (64 bytes) ---
    emit_byte(buf, &pos, 0x7F) emit_byte(buf, &pos, 0x45) emit_byte(buf, &pos, 0x4C) emit_byte(buf, &pos, 0x46)
    emit_byte(buf, &pos, 2) emit_byte(buf, &pos, 1) emit_byte(buf, &pos, 1) emit_byte(buf, &pos, 0)
    let pi = 0 loop pi < 8 { emit_byte(buf, &pos, 0) pi = pi + 1 }
    emit_i16_le(buf, &pos, 2)    ; e_type = EXEC
    emit_i16_le(buf, &pos, 0x3E) ; e_machine = X86_64
    emit_i32_le(buf, &pos, 1)    ; e_version
    emit_i64_le(buf, &pos, code_va) ; e_entry
    emit_i64_le(buf, &pos, 64)      ; e_phoff
    emit_i64_le(buf, &pos, 0)       ; e_shoff
    emit_i32_le(buf, &pos, 0)       ; e_flags
    emit_i16_le(buf, &pos, 64)      ; e_ehsize
    emit_i16_le(buf, &pos, 56)      ; e_phentsize
    emit_i16_le(buf, &pos, 1)       ; e_phnum
    emit_i16_le(buf, &pos, 0)       ; e_shentsize
    emit_i16_le(buf, &pos, 0)       ; e_shnum
    emit_i16_le(buf, &pos, 0)       ; e_shstrndx

    ; --- Program Header (56 bytes) ---
    emit_i32_le(buf, &pos, 1) ; p_type = LOAD
    emit_i32_le(buf, &pos, 7) ; p_flags = RWX
    emit_i64_le(buf, &pos, 0) ; p_offset
    emit_i64_le(buf, &pos, load_va) ; p_vaddr
    emit_i64_le(buf, &pos, load_va) ; p_paddr
    emit_i64_le(buf, &pos, total)   ; p_filesz
    emit_i64_le(buf, &pos, total)   ; p_memsz
    emit_i64_le(buf, &pos, 0x200000) ; p_align

    syscall(1, out_fd, buf, pos)
    syscall(1, out_fd, code, code_len)
    if strtab_len > 0 { syscall(1, out_fd, strtab, strtab_len) }
    let zero_buf = alloc_pages(256)
    fill_bytes(zero_buf, 1048576, 0)
    syscall(1, out_fd, zero_buf, 1048576)
}

fn get_argv(base: &i64, n: i64) -> &i8 {
    if base == 0 { ret 0 }
    let val = load_i64_at(base, n)
    ret val
}

; Compare two null-terminated C strings. Returns 1 if equal, 0 otherwise.
fn cstr_eq(a: &i8, b: &i8) -> i64 {
    if a == 0 or b == 0 { ret 0 }
    let i = 0
    let matching = 1
    loop matching == 1 {
        let ca = a[i]
        let cb = b[i]
        if ca != cb { ret 0 }
        if ca == 0 { ret 1 }
        i = i + 1
    }
    ret 1
}

; Strip directory path from filename: "/foo/bar/baz.jda" -> start of "baz.jda"
; Returns pointer into the same string (no allocation).
fn basename(path: &i8) -> &i8 {
    let len = cstr_len_max(path, 1024)
    let last_slash = -1
    let i = 0
    loop i < len {
        if path[i] == 47 { last_slash = i }
        i = i + 1
    }
    if last_slash >= 0 {
        ret path + last_slash + 1
    }
    ret path
}

; Strip .jda extension from a path, write result into buf. Returns length written.
; "foo.jda" -> "foo", "bar" -> "bar"
fn strip_ext(path: &i8, buf: &i8, buf_max: i64) -> i64 {
    let len = cstr_len_max(path, 1024)
    let dot = -1
    let i = 0
    loop i < len {
        if path[i] == 46 { dot = i }
        i = i + 1
    }
    let copy_len = len
    if dot >= 0 { copy_len = dot }
    if copy_len > buf_max - 1 { copy_len = buf_max - 1 }
    i = 0
    loop i < copy_len {
        buf[i] = path[i]
        i = i + 1
    }
    buf[copy_len] = 0
    ret copy_len
}

fn print_version() {
    print("jda 0.1.0-dev\n")
}

fn print_usage() {
    eprint("usage: jda build [--include <lib.jda>] <file.jda> [-o output]\n")
    eprint("       jda run [--include <lib.jda>] <file.jda>\n")
    eprint("       jda <input.jda> <output>   (legacy)\n")
    eprint("       jda --version\n")
    eprint("       jda --help\n")
}

; ============================================================
; 13. ENTRY POINT
; ============================================================

fn main(argc: i64, argv_ptr: &i64) {
    let src_path: &i8 = 0
    let out_path: &i8 = 0
    let include_path: &i8 = 0
    let do_run = 0
    g_argv_base = argv_ptr

    if argc < 2 {
        print_usage()
        syscall(60, 2, 0, 0)
    }

    let arg1 = get_argv(argv_ptr, 1)

    let out_buf = alloc_pages(1) ; 4KB for output path buffer

    ; --help / -h
    if cstr_eq(arg1, "--help") == 1 or cstr_eq(arg1, "-h") == 1 {
        print_usage()
        syscall(60, 0, 0, 0)
    }

    ; --version / -V
    if cstr_eq(arg1, "--version") == 1 or cstr_eq(arg1, "-V") == 1 {
        print_version()
        syscall(60, 0, 0, 0)
    }

    ; jda build [--include <lib>] <file> [-o output]
    if cstr_eq(arg1, "build") == 1 {
        let ai = 2
        if argc > ai {
            let maybe_inc = get_argv(argv_ptr, ai)
            if cstr_eq(maybe_inc, "--include") == 1 {
                ai = ai + 1
                if argc <= ai {
                    eprint("error: --include requires a file path\n")
                    syscall(60, 2, 0, 0)
                }
                include_path = get_argv(argv_ptr, ai)
                ai = ai + 1
            }
        }
        if argc <= ai {
            eprint("error: missing input file\n")
            print_usage()
            syscall(60, 2, 0, 0)
        }
        src_path = get_argv(argv_ptr, ai)
        ai = ai + 1
        ; Check for -o flag
        if argc > ai + 1 {
            let maybe_o = get_argv(argv_ptr, ai)
            if cstr_eq(maybe_o, "-o") == 1 {
                out_path = get_argv(argv_ptr, ai + 1)
            }
        }
        if out_path == 0 {
            strip_ext(src_path, out_buf, 256)
            out_path = out_buf
        }
    } else if cstr_eq(arg1, "run") == 1 {
        ; jda run [--include <lib>] <file>
        let ai = 2
        if argc > ai {
            let maybe_inc = get_argv(argv_ptr, ai)
            if cstr_eq(maybe_inc, "--include") == 1 {
                ai = ai + 1
                if argc <= ai {
                    eprint("error: --include requires a file path\n")
                    syscall(60, 2, 0, 0)
                }
                include_path = get_argv(argv_ptr, ai)
                ai = ai + 1
            }
        }
        if argc <= ai {
            eprint("error: missing input file\n")
            print_usage()
            syscall(60, 2, 0, 0)
        }
        src_path = get_argv(argv_ptr, ai)
        out_path = "/tmp/jda_run_out"
        do_run = 1
    } else if argc >= 3 {
        ; Legacy mode: jda <input> <output>
        src_path = arg1
        out_path = get_argv(argv_ptr, 2)
    } else {
        ; Single arg that isn't a subcommand — treat as build
        src_path = arg1
        strip_ext(src_path, out_buf, 256)
        out_path = out_buf
    }

    g_out_path_ptr = out_path

    let src_buf = alloc_pages(256)  ; 1MB (supports --include prepend)
    g_src_buf_ptr = src_buf
    let buf_off = 0

    ; Read include file first (prepend to source)
    if include_path != 0 {
        let inc_fd = syscall(2, include_path, 0, 0)
        if inc_fd < 0 { panic("open include failed") }
        let inc_len = syscall(0, inc_fd, src_buf, 524288)
        if inc_len < 0 { panic("read include failed") }
        syscall(3, inc_fd, 0, 0)
        buf_off = inc_len
        poke_byte(src_buf, buf_off, 10)
        buf_off = buf_off + 1
    }

    ; Read user source (appended after include)
    let src_fd = syscall(2, src_path, 0, 0)
    if src_fd < 0 { panic("open src failed") }
    let read_len = syscall(0, src_fd, src_buf + buf_off, 1048576 - buf_off)
    if read_len < 0 { panic("read src failed") }
    syscall(3, src_fd, 0, 0)
    let src_len = buf_off + read_len
    g_runtime_src_len = src_len
    let toks = alloc_pages(2048) ; 8MiB
    g_dbg_toks = toks
    g_dbg_toks_init = toks
    let tok_cnt = lex_main_input()
    print("LEX_OK tc=")
    print_i64(g_lex_count)
    print("\n")
    g_dbg_tok_cnt = g_lex_count
    g_scan_tok_cnt = g_lex_count
    print("INIT_STATE\n")
    init_large_post_lex_state()
    print("CONST_PRE\n")
    run_top_const_prelude(g_dbg_toks_init, g_src_buf_ptr, g_runtime_src_len)
    print("STRUCT_PRE\n")
    run_top_struct_prelude(g_dbg_toks_init, g_stab_ptr, g_src_buf_ptr, g_runtime_src_len)
    print("FN_SCAN\n")
    ; Pass 1: Scan for global functions
    let fn_name_off = alloc_pages(1)
    let fn_name_len = alloc_pages(1)
    let fn_code_off = alloc_pages(2) ; 1024 entries
    let fn_ret_types = alloc_pages(1)
    let fn_param_cnts = alloc_pages(1)
    g_fn_name_off_tbl = fn_name_off
    g_fn_name_len_tbl = fn_name_len
    g_fn_param_cnt_tbl = fn_param_cnts
    print("PREP_FN\n")
    prepare_top_fn_scan(toks, src_buf, src_len, fn_name_off, fn_name_len)
    print("PREP_FN_DONE\n")
    ; Prepare output buffers
    let code_buf = alloc_pages(4096) ; 16MB
    let code_len = 0
    let merged_str = alloc_pages(64)  ; 256KB
    let merged_pos = 0
    let glob_buf = alloc_pages(128)  ; 512KB
    print("BUFS_OK\n")
    print("PRE_EMIT\n")
    ; _start: preserve initial stack frame, mmap heap, then call main(argc, argv)
    emit_byte(code_buf, &code_len, 0x48)             ; mov rbp, rsp
    print("E1\n")
    emit_byte(code_buf, &code_len, 0x89)
    print("E2\n")
    emit_byte(code_buf, &code_len, 0xE5)
    print("E3\n")
    emit_byte(code_buf, &code_len, 0xB8)             ; mov eax, 9
    print("E4\n")
    emit_i32_le(code_buf, &code_len, 9)
    print("E5\n")
    emit_byte(code_buf, &code_len, 0x31)             ; xor edi, edi
    print("E6\n")
    emit_byte(code_buf, &code_len, 0xFF)
    print("E7\n")
    emit_byte(code_buf, &code_len, 0xBE)             ; mov esi, 0x59A20
    print("E8\n")
    emit_i32_le(code_buf, &code_len, 367136)
    print("E9\n")
    emit_byte(code_buf, &code_len, 0xBA)             ; mov edx, 3
    print("E10\n")
    emit_i32_le(code_buf, &code_len, 3)
    print("E11\n")
    emit_byte(code_buf, &code_len, 0x41)             ; mov r10d, 0x22
    print("E12\n")
    emit_byte(code_buf, &code_len, 0xBA)
    print("E13\n")
    emit_i32_le(code_buf, &code_len, 34)
    print("E14\n")
    emit_byte(code_buf, &code_len, 0x41)             ; mov r8d, -1
    print("E15\n")
    emit_byte(code_buf, &code_len, 0xB8)
    print("E16\n")
    emit_i32_le(code_buf, &code_len, -1)
    print("E17\n")
    emit_byte(code_buf, &code_len, 0x45)             ; xor r9d, r9d
    print("E18\n")
    emit_byte(code_buf, &code_len, 0x31)
    print("E19\n")
    emit_byte(code_buf, &code_len, 0xC9)
    print("E20\n")
    emit_byte(code_buf, &code_len, 0x0F)             ; syscall
    print("E21\n")
    emit_byte(code_buf, &code_len, 0x05)
    print("E22\n")
    emit_byte(code_buf, &code_len, 0x49)             ; mov r15, rax
    print("E23\n")
    emit_byte(code_buf, &code_len, 0x89)
    print("E24\n")
    emit_byte(code_buf, &code_len, 0xC7)
    print("E25\n")
    emit_byte(code_buf, &code_len, 0x48)             ; mov rdi, [rbp+0]
    print("E26\n")
    emit_byte(code_buf, &code_len, 0x8B)
    print("E27\n")
    emit_byte(code_buf, &code_len, 0x7D)
    print("E28\n")
    emit_byte(code_buf, &code_len, 0x00)
    print("E29\n")
    emit_byte(code_buf, &code_len, 0x48)             ; lea rsi, [rbp+8]
    print("E30\n")
    emit_byte(code_buf, &code_len, 0x8D)
    print("E31\n")
    emit_byte(code_buf, &code_len, 0x75)
    print("E32\n")
    emit_byte(code_buf, &code_len, 0x08)
    print("E33\n")
    emit_byte(code_buf, &code_len, 0xE8)             ; call rel32
    print("E34\n")
    emit_i32_le(code_buf, &code_len, 0)              ; placeholder
    print("E35\n")
    emit_byte(code_buf, &code_len, 0xB8)
    print("E36\n")
    emit_i32_le(code_buf, &code_len, 60)             ; exit(0)
    print("E37\n")
    emit_byte(code_buf, &code_len, 0x31)
    print("E38\n")
    emit_byte(code_buf, &code_len, 0xFF)
    print("E39\n")
    emit_byte(code_buf, &code_len, 0x0F)
    print("E40\n")
    emit_byte(code_buf, &code_len, 0x05)
    print("E41\n")

    ; Fixup arrays
    print("FIXUP_ALLOC\n")
    let gf_strtab_co   = alloc_pages(16)
    let gf_strtab_tgt  = alloc_pages(16)
    let gf_strtab_base = alloc_pages(16)
    let gf_strtab_cnt  = 0
    let gf_call_co     = alloc_pages(16)
    let gf_call_name   = alloc_pages(16)
    let gf_call_nlen   = alloc_pages(16)
    let gf_call_cnt    = 0
    ; JirFunction + LowerCtx heap allocation
    g_jfn_heap = alloc_pages(16384)
    g_jfn = g_jfn_heap as &JirFunction
    g_ctx_heap = alloc_pages(100)
    g_ctx = g_ctx_heap as &LowerCtx
    ; Bootstrap: alloc_pages gives zero-initialized memory so entry 0 is already zero.
    ; Just set the count and total size to skip slot 0 (dummy entry).
    g_glob_cnt      = 1
    g_glob_total_sz = 1024
    let jfn = g_jfn
    let ctx = g_ctx
    g_entry_main_idx = -1
    print("LS_INIT_OK\n")

    ; Main Compilation Loop
    g_main_pos = 0
    print("Z1\n")
    if g_main_pos < g_scan_tok_cnt {
        print("Z4\n")
    }
    print("Z5\n")
    loop g_main_pos < g_scan_tok_cnt {
        print("T")
        let top_t = tok_type_at_raw(toks, g_main_pos)
        let top_start = tok_str_start_at(toks, g_main_pos)
        let top_len = tok_str_len_at(toks, g_main_pos)
        if top_t == TOK_CONST {
            parse_const_decl(toks)
        } else if top_t == TOK_STRUCT {
            parse_struct_decl(toks, g_stab_ptr, src_buf)
        } else if top_t == TOK_FN or (top_len == 2 and streq(src_buf, top_start, 2, "fn") == 1) {
            let fn_tok_pos = g_main_pos
            let cur_name_off = tok_str_start_at(toks, g_main_pos + 1)
            let cur_name_len = tok_str_len_at(toks, g_main_pos + 1)
            ; (debug prints removed)
            g_cur_fn_name_start = cur_name_off
            g_cur_fn_name_len = cur_name_len
            ; Find function bounds
            let fn_rbrace_scan = -1
            let scan_i = fn_tok_pos
            loop scan_i < g_scan_tok_cnt {
                let st = tok_type_at_raw(toks, scan_i)
                if st == TOK_LBRACE {
                    let scan_j = scan_i
                    let depth_j = 0
                    loop scan_j < g_scan_tok_cnt {
                        let st2 = tok_type_at_raw(toks, scan_j)
                        depth_j = depth_j + (st2 == TOK_LBRACE) - (st2 == TOK_RBRACE)
                        if st2 == TOK_RBRACE and depth_j == 0 {
                            fn_rbrace_scan = scan_j
                            scan_j = g_scan_tok_cnt
                        } else {
                            scan_j = scan_j + 1
                        }
                    }
                    scan_i = g_scan_tok_cnt
                } else if st == TOK_SEMI {
                    fn_rbrace_scan = scan_i
                    scan_i = g_scan_tok_cnt
                } else {
                    scan_i = scan_i + 1
                }
            }
            if fn_rbrace_scan == -1 {
                print("fn_tok=")
                print_span(src_buf, top_start, top_len)
                print("\n")
                print("fn_end_fail=")
                print_span(src_buf, cur_name_off, cur_name_len)
                print("\n")
                report_error("could not find end of function")
            }
            g_cur_fn_end = fn_rbrace_scan
            print("COMPILE ")
            print_span(src_buf, cur_name_off, cur_name_len)
            print("\n")
            let fi = resolve_top_fn_index(src_buf, cur_name_off, cur_name_len, fn_name_off, fn_name_len)
            print("FI_OK\n")
            init_top_jfn(jfn, src_buf, src_len, g_stab_ptr)
            print("INIT_OK\n")
                ; Skip 'fn name'
                g_main_pos = fn_tok_pos + 2
                expect(TOK_LPAREN)
                let more_params = 0
                if tok_type_at(toks, g_main_pos) != TOK_RPAREN { more_params = 1 }
                loop more_params == 1 {
                    let p_name_start = tok_str_start_at(toks, g_main_pos)
                    let p_name_len = tok_str_len_at(toks, g_main_pos)
                    expect(TOK_IDENT)
                    let p_stype = TYPE_I64
                    if tok_type_at(toks, g_main_pos) == TOK_COLON {
                        g_main_pos = g_main_pos + 1
                        let is_ptr = 0
                        if tok_type_at(toks, g_main_pos) == TOK_AMP {
                            is_ptr = 1
                            g_main_pos = g_main_pos + 1
                        }
                        let p_type = tok_type_at(toks, g_main_pos)
                        let p_type_start = tok_str_start_at(toks, g_main_pos)
                        let p_type_len = tok_str_len_at(toks, g_main_pos)
                        g_main_pos = g_main_pos + 1
                        if p_type == TOK_IDENT {
                            let sid = lookup_struct_name(src_buf, p_type_start, p_type_len)
                            if sid >= 0 { p_stype = sid }
                            else if is_ptr == 1 { p_stype = ptr_of(TYPE_PTR) }
                            else { p_stype = TYPE_PTR }
                        } else {
                            if is_ptr == 1 {
                                if p_type == TOK_I64 { p_stype = TYPE_PTR_I64 }
                                if p_type == TOK_I32 { p_stype = TYPE_PTR_I32 }
                                if p_type == TOK_I8  { p_stype = TYPE_PTR_I8 }
                                if p_type == TOK_F64 { p_stype = ptr_of(TYPE_F64) }
                            } else {
                                if p_type == TOK_I64 { p_stype = TYPE_I64 }
                                if p_type == TOK_I32 { p_stype = TYPE_I32 }
                                if p_type == TOK_I8  { p_stype = TYPE_I8 }
                                if p_type == TOK_F64 { p_stype = TYPE_F64 }
                            }
                        }
                    }
                        let pslot = bind_name(jfn, p_name_start, p_name_len, p_stype)
                    if jfn.param_cnt < 16 {
                        jfn.param_slots[jfn.param_cnt] = pslot
                        jfn.param_cnt = jfn.param_cnt + 1
                    }
                    let comma_tok = tok_type_at(toks, g_main_pos)
                    if comma_tok == TOK_COMMA { g_main_pos = g_main_pos + 1 }
                    else { more_params = 0 }
                }
                expect(TOK_RPAREN)

                ; Parse return type and store function metadata
                let fn_ret_type = parse_skip_ret_type(toks)
                if fi >= 0 and fi < 512 {
                    store_i64_at(fn_param_cnts, fi, jfn.param_cnt)
                    store_i64_at(fn_ret_types, fi, fn_ret_type)
                }

                expect(TOK_LBRACE)

                let is_main = 0
                if cur_name_len == 4 {
                    if streq(src_buf, cur_name_off, 4, "main") == 1 { is_main = 1 }
                }

                if fi >= 0 and fi < 1024 { fn_code_off[fi] = code_len }
                if is_main == 1 { g_entry_main_idx = code_len }

                regalloc_init(ctx as &RegAlloc)
                ctx.fix_cnt = 0
                let cb = create_block_live(jfn)
                let final_bb = live_compile_block(toks, g_stab_ptr, src_buf, jfn, cb)
                let impl_rv2 = emit_const(jfn, final_bb, TYPE_I64, 0)
                let impl_ri2 = Instr{}
                impl_ri2.op = OP_RET
                impl_ri2.operand0 = impl_rv2
                emit(jfn, final_bb, &impl_ri2)
                if cur_name_len == 15 {
                    if streq(src_buf, cur_name_off, 15, "lex_handle_bang") == 1 {
                        if jfn.block_cnt > 64 { panic("lex_handle_bang block blowup") }
                    }
                }
                if cur_name_len == 16 {
                    if streq(src_buf, cur_name_off, 16, "lex_handle_minus") == 1 {
                        if jfn.block_cnt > 512 { panic("lex_handle_minus block blowup") }
                    }
                }
                lower_fn(jfn, ctx, code_buf, &code_len, is_main)
                ; Collect fixups
                let ci = 0
                loop ci < ctx.fix_cnt {
                    let fk = ctx.fixups[ci].kind
                    if fk == 1 {
                        gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                        gf_strtab_tgt[gf_strtab_cnt]  = ctx.fixups[ci].target_bb
                        gf_strtab_base[gf_strtab_cnt] = merged_pos
                        gf_strtab_cnt = gf_strtab_cnt + 1
                    } else if fk == 3 {
                        let tbb = ctx.fixups[ci].target_bb
                        let neg_tbb = 0 - tbb
                        gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                        gf_strtab_tgt[gf_strtab_cnt]  = neg_tbb - 1
                        gf_strtab_base[gf_strtab_cnt] = 0
                        gf_strtab_cnt = gf_strtab_cnt + 1
                    } else if fk == 2 {
                        gf_call_co[gf_call_cnt]   = ctx.fixups[ci].code_off
                        gf_call_name[gf_call_cnt] = ctx.fixups[ci].target_bb
                        gf_call_nlen[gf_call_cnt] = ctx.fixups[ci].str_len
                        gf_call_cnt = gf_call_cnt + 1
                    }
                    ci = ci + 1
                }

                ; Merge strtab
                let si_copy = 0
                let jfn_str_len = jfn.strtab_pos
                loop si_copy < jfn_str_len {
                    poke_byte(merged_str, merged_pos, jfn.strtab[si_copy])
                    merged_pos = merged_pos + 1
                    si_copy = si_copy + 1
                }
                ; GURANTEED ADVANCE
                g_main_pos = fn_rbrace_scan + 1
        } else if top_t == TOK_LET or (top_len == 3 and streq(src_buf, top_start, 3, "let") == 1) {
            skip_top_level_let(toks, g_stab_ptr, src_buf)
        } else {
            g_main_pos = g_main_pos + 1
        }
    }

    ; ---- Patch Entry Point ----
    let m_off = load_i64_at(fn_code_off, 0)
    if g_entry_main_idx >= 0 { m_off = g_entry_main_idx }
    let entry_call_imm_off = 49
    let entry_call_next_off = 53
    let e_rel = m_off - entry_call_next_off
    poke_byte(code_buf, entry_call_imm_off, i32_b0(e_rel))
    poke_byte(code_buf, entry_call_imm_off + 1, i32_b1(e_rel))
    poke_byte(code_buf, entry_call_imm_off + 2, i32_b2(e_rel))
    poke_byte(code_buf, entry_call_imm_off + 3, i32_b3(e_rel))

    ; ---- Global Fixups (String/Calls) ----
    let str_va = 0x400000 + 120 + code_len
    let si_f = 0
    loop si_f < gf_strtab_cnt {
        let co = gf_strtab_co[si_f]
        let stgt = gf_strtab_tgt[si_f]
        let sbase = gf_strtab_base[si_f]
        let rel_val = 0
        let stgt_pos = stgt >= 0
        if stgt_pos == 1 {
            let lit_va = str_va + sbase
            let tgt_va = lit_va + stgt
            let rip_after = 0x400000 + 120 + co + 4
            rel_val = tgt_va - rip_after
        } else {
            let neg_gf = 0 - stgt
            let gi_f = neg_gf - 1
            let data_va = str_va + merged_pos
            let goff_val = load_i64_at(g_glob_off, gi_f)
            let glob_va = data_va + goff_val
            let rip_after = 0x400000 + 120 + co + 4
            rel_val = glob_va - rip_after
        }
        poke_byte(code_buf, co,     i32_b0(rel_val))
        poke_byte(code_buf, co + 1, i32_b1(rel_val))
        poke_byte(code_buf, co + 2, i32_b2(rel_val))
        poke_byte(code_buf, co + 3, i32_b3(rel_val))
        si_f = si_f + 1
    }

    let ci_f = 0
    loop ci_f < gf_call_cnt {
        let co_f = gf_call_co[ci_f]
        let found = 0
        let call_nlen = gf_call_nlen[ci_f]
        let call_name = gf_call_name[ci_f]
        let ti_f = 0
        loop ti_f < g_top_fn_cnt {
            let fn_nl = load_i64_at(fn_name_len, ti_f)
            let len_eq = fn_nl == call_nlen
            if len_eq == 1 {
                let fn_no = load_i64_at(fn_name_off, ti_f)
                let sm = str_match(src_buf, call_name, fn_no, call_nlen)
                if sm == 1 {
                    let fn_co = load_i64_at(fn_code_off, ti_f)
                    let r_val = fn_co - (co_f + 4)
                    poke_byte(code_buf, co_f,     i32_b0(r_val))
                    poke_byte(code_buf, co_f + 1, i32_b1(r_val))
                    poke_byte(code_buf, co_f + 2, i32_b2(r_val))
                    poke_byte(code_buf, co_f + 3, i32_b3(r_val))
                    found = 1
                    ti_f = g_top_fn_cnt
                }
            }
            ti_f = ti_f + 1
        }
        if found == 0 {
            fill_bytes(code_buf + co_f - 1, 5, 0x90) ; NOP unresolved calls
        }
        ci_f = ci_f + 1
    }
    print("AFTER_LOOP\n")
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 { panic("open output failed") }
    g_emit_glob_buf = glob_buf
    g_emit_glob_len = g_glob_total_sz
    if g_glob_total_sz > 0 { fill_bytes(glob_buf, g_glob_total_sz, 0) }
    
    write_elf(out_fd, code_buf, code_len, merged_str, merged_pos)
    syscall(3, out_fd, 0, 0)

    ; chmod +x the output
    syscall(90, out_path, 493, 0)

    if do_run == 1 {
        ; execve(out_path, argv={out_path, NULL}, envp={NULL})
        let exec_argv = alloc_pages(1)
        store_i64_at(exec_argv, 0, out_path)
        store_i64_at(exec_argv, 1, 0)
        let exec_envp = alloc_pages(1)
        store_i64_at(exec_envp, 0, 0)
        syscall(59, out_path, exec_argv, exec_envp)
        ; If execve returns, it failed
        eprint("error: failed to execute ")
        eprint(out_path)
        eprint("\n")
        syscall(60, 1, 0, 0)
    }
    syscall(60, 0, 0, 0)
}
