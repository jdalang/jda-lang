let g_loop_ctrl: i64 = 0
let g_fix_merged_pos: i64 = 0
let g_argv_base: &i64 = 0
let g_runtime_src_len: i64 = 0
let g_src_buf_ptr: &i8 = 0
let g_small_src_buf_ptr: &i8 = 0
let g_out_path_ptr: &i8 = 0
let g_jfn_heap: &i8 = 0
