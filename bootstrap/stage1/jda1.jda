    }
    if name.str_len == 14 and streq(g_src_buf_ptr, name.str_start, 14, "avx512_mul_f64") == 1 {
        let ins = Instr{}
        ins.op = OP_AVX_MULF64
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ret emit(g_jfn, bb, &ins)
