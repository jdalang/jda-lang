fn emit_any_jir(jfn: &JirFunction, bb: i64, arr_id: i64, len_id: i64, cls_id: i64) -> i64 {
    let idx_slot = alloc_slot(jfn)
    let found_slot = alloc_slot(jfn)
    let arr_slot = alloc_slot(jfn)
    let len_slot = alloc_slot(jfn)
    let cls_slot = alloc_slot(jfn)
    let zero = emit_const(jfn, bb, TYPE_I64, 0)
    let st0 = Instr{}
    st0.op = OP_STORE
    st0.operand0 = zero
    st0.operand1 = idx_slot
    emit(jfn, bb, &st0)
    let st_f = Instr{}
    st_f.op = OP_STORE
    st_f.operand0 = zero
    st_f.operand1 = found_slot
    emit(jfn, bb, &st_f)
    let st_arr = Instr{}
    st_arr.op = OP_STORE
    st_arr.operand0 = arr_id
    st_arr.operand1 = arr_slot
    emit(jfn, bb, &st_arr)
    let st_len = Instr{}
    st_len.op = OP_STORE
    st_len.operand0 = len_id
    st_len.operand1 = len_slot
    emit(jfn, bb, &st_len)
    let st_cls = Instr{}
    st_cls.op = OP_STORE
    st_cls.operand0 = cls_id
    st_cls.operand1 = cls_slot
    emit(jfn, bb, &st_cls)
    let head = create_block_live(jfn)
    let body = create_block_live(jfn)
    let exit = create_block_live(jfn)
    emit_jmp(jfn, bb, head)
    let ld_idx = Instr{}
    ld_idx.op = OP_LOAD
    ld_idx.operand0 = idx_slot
    let idx = emit(jfn, head, &ld_idx)
    let ld_len = Instr{}
    ld_len.op = OP_LOAD
    ld_len.operand0 = len_slot
    let len_val = emit(jfn, head, &ld_len)
    let cond = emit_binop(jfn, head, OP_CMP_LT, idx, len_val)
    emit_br(jfn, head, cond, body, exit)
    let ld_idx2 = Instr{}
    ld_idx2.op = OP_LOAD
    ld_idx2.operand0 = idx_slot
    let idx2 = emit(jfn, body, &ld_idx2)
    let ld_arr = Instr{}
    ld_arr.op = OP_LOAD
    ld_arr.operand0 = arr_slot
    let arr_val = emit(jfn, body, &ld_arr)
    let ld_cls = Instr{}
    ld_cls.op = OP_LOAD
    ld_cls.operand0 = cls_slot
    let cls_val = emit(jfn, body, &ld_cls)
    let eight = emit_const(jfn, body, TYPE_I64, 8)
    let off = emit_binop(jfn, body, OP_MUL, idx2, eight)
    let addr = emit_binop(jfn, body, OP_ADD, arr_val, off)
    let ld_elem = Instr{}
    ld_elem.op = OP_LOAD_MEM
    ld_elem.operand0 = addr
    ld_elem.itype = TYPE_I64
    let elem = emit(jfn, body, &ld_elem)
    let result = emit_closure_call_1arg(jfn, body, cls_val, elem)
    let zero_body = emit_const(jfn, body, TYPE_I64, 0)
    let ne_zero = emit_binop(jfn, body, OP_CMP_NE, result, zero_body)
    let then_blk = create_block_live(jfn)
    let cont_blk = create_block_live(jfn)
    emit_br(jfn, body, ne_zero, then_blk, cont_blk)
    let one_found = emit_const(jfn, then_blk, TYPE_I64, 1)
    let st_found = Instr{}
    st_found.op = OP_STORE
    st_found.operand0 = one_found
    st_found.operand1 = found_slot
    emit(jfn, then_blk, &st_found)
    emit_jmp(jfn, then_blk, exit)
    let one = emit_const(jfn, cont_blk, TYPE_I64, 1)
    let next = emit_binop(jfn, cont_blk, OP_ADD, idx2, one)
    let st3 = Instr{}
    st3.op = OP_STORE
    st3.operand0 = next
    st3.operand1 = idx_slot
    emit(jfn, cont_blk, &st3)
    emit_jmp(jfn, cont_blk, head)
    let ld_result = Instr{}
    ld_result.op = OP_LOAD
    ld_result.operand0 = found_slot
    g_iter_exit_bb = exit
    ret emit(jfn, exit, &ld_result)
}

fn emit_filter_jir(jfn: &JirFunction, bb: i64, arr_id: i64, len_id: i64, cls_id: i64) -> i64 {
    let one_pre = emit_const(jfn, bb, TYPE_I64, 1)
    let len_plus = emit_binop(jfn, bb, OP_ADD, len_id, one_pre)
    let eight_pre = emit_const(jfn, bb, TYPE_I64, 8)
    let alloc_sz = emit_binop(jfn, bb, OP_MUL, len_plus, eight_pre)
    let alloc_ins = Instr{}
    alloc_ins.op = OP_ALLOC
    alloc_ins.operand0 = alloc_sz
    let out_raw = emit(jfn, bb, &alloc_ins)
    let base = emit_binop(jfn, bb, OP_ADD, out_raw, eight_pre)
    let idx_slot = alloc_slot(jfn)
    let oi_slot = alloc_slot(jfn)
    let arr_slot = alloc_slot(jfn)
    let len_slot = alloc_slot(jfn)
    let cls_slot = alloc_slot(jfn)
    let base_slot = alloc_slot(jfn)
    let out_raw_slot = alloc_slot(jfn)
    let elem_slot = alloc_slot(jfn)
    let zero = emit_const(jfn, bb, TYPE_I64, 0)
    let st0 = Instr{}
    st0.op = OP_STORE
    st0.operand0 = zero
    st0.operand1 = idx_slot
    emit(jfn, bb, &st0)
    let st_oi = Instr{}
    st_oi.op = OP_STORE
    st_oi.operand0 = zero
    st_oi.operand1 = oi_slot
    emit(jfn, bb, &st_oi)
    let st_arr = Instr{}
    st_arr.op = OP_STORE
    st_arr.operand0 = arr_id
    st_arr.operand1 = arr_slot
    emit(jfn, bb, &st_arr)
    let st_len = Instr{}
    st_len.op = OP_STORE
    st_len.operand0 = len_id
    st_len.operand1 = len_slot
    emit(jfn, bb, &st_len)
    let st_cls = Instr{}
    st_cls.op = OP_STORE
    st_cls.operand0 = cls_id
    st_cls.operand1 = cls_slot
    emit(jfn, bb, &st_cls)
    let st_base = Instr{}
    st_base.op = OP_STORE
    st_base.operand0 = base
    st_base.operand1 = base_slot
    emit(jfn, bb, &st_base)
    let st_out_raw = Instr{}
    st_out_raw.op = OP_STORE
    st_out_raw.operand0 = out_raw
    st_out_raw.operand1 = out_raw_slot
    emit(jfn, bb, &st_out_raw)
    let head = create_block_live(jfn)
    let body = create_block_live(jfn)
    let exit = create_block_live(jfn)
    emit_jmp(jfn, bb, head)
    let ld_idx = Instr{}
    ld_idx.op = OP_LOAD
    ld_idx.operand0 = idx_slot
    let idx = emit(jfn, head, &ld_idx)
    let ld_len = Instr{}
    ld_len.op = OP_LOAD
    ld_len.operand0 = len_slot
    let len_val = emit(jfn, head, &ld_len)
    let cond = emit_binop(jfn, head, OP_CMP_LT, idx, len_val)
    emit_br(jfn, head, cond, body, exit)
    let ld_idx2 = Instr{}
    ld_idx2.op = OP_LOAD
    ld_idx2.operand0 = idx_slot
    let idx2 = emit(jfn, body, &ld_idx2)
    let ld_arr = Instr{}
    ld_arr.op = OP_LOAD
    ld_arr.operand0 = arr_slot
    let arr_val = emit(jfn, body, &ld_arr)
    let ld_cls = Instr{}
    ld_cls.op = OP_LOAD
    ld_cls.operand0 = cls_slot
    let cls_val = emit(jfn, body, &ld_cls)
    let eight = emit_const(jfn, body, TYPE_I64, 8)
    let off = emit_binop(jfn, body, OP_MUL, idx2, eight)
    let addr = emit_binop(jfn, body, OP_ADD, arr_val, off)
    let ld_elem = Instr{}
    ld_elem.op = OP_LOAD_MEM
    ld_elem.operand0 = addr
    ld_elem.itype = TYPE_I64
    let elem = emit(jfn, body, &ld_elem)
    let st_elem_slot = Instr{}
    st_elem_slot.op = OP_STORE
    st_elem_slot.operand0 = elem
    st_elem_slot.operand1 = elem_slot
    emit(jfn, body, &st_elem_slot)
    let result = emit_closure_call_1arg(jfn, body, cls_val, elem)
    let zero_body = emit_const(jfn, body, TYPE_I64, 0)
    let ne_zero = emit_binop(jfn, body, OP_CMP_NE, result, zero_body)
    let then_blk = create_block_live(jfn)
    let cont_blk = create_block_live(jfn)
    emit_br(jfn, body, ne_zero, then_blk, cont_blk)
    let ld_oi = Instr{}
    ld_oi.op = OP_LOAD
    ld_oi.operand0 = oi_slot
    let oi = emit(jfn, then_blk, &ld_oi)
    let ld_base = Instr{}
    ld_base.op = OP_LOAD
    ld_base.operand0 = base_slot
    let base_val = emit(jfn, then_blk, &ld_base)
    let ld_elem2 = Instr{}
    ld_elem2.op = OP_LOAD
    ld_elem2.operand0 = elem_slot
    let elem2 = emit(jfn, then_blk, &ld_elem2)
    let eight_t = emit_const(jfn, then_blk, TYPE_I64, 8)
    let oi_off = emit_binop(jfn, then_blk, OP_MUL, oi, eight_t)
    let out_addr = emit_binop(jfn, then_blk, OP_ADD, base_val, oi_off)
    let st_elem = Instr{}
    st_elem.op = OP_STORE_MEM
    st_elem.itype = TYPE_I64
    st_elem.operand0 = elem2
    st_elem.operand1 = out_addr
    emit(jfn, then_blk, &st_elem)
    let one_t = emit_const(jfn, then_blk, TYPE_I64, 1)
    let new_oi = emit_binop(jfn, then_blk, OP_ADD, oi, one_t)
    let st_oi2 = Instr{}
    st_oi2.op = OP_STORE
    st_oi2.operand0 = new_oi
    st_oi2.operand1 = oi_slot
    emit(jfn, then_blk, &st_oi2)
    emit_jmp(jfn, then_blk, cont_blk)
    let one = emit_const(jfn, cont_blk, TYPE_I64, 1)
    let next = emit_binop(jfn, cont_blk, OP_ADD, idx2, one)
    let st3 = Instr{}
    st3.op = OP_STORE
    st3.operand0 = next
    st3.operand1 = idx_slot
    emit(jfn, cont_blk, &st3)
    emit_jmp(jfn, cont_blk, head)
    let ld_final_cnt = Instr{}
    ld_final_cnt.op = OP_LOAD
    ld_final_cnt.operand0 = oi_slot
    let final_cnt = emit(jfn, exit, &ld_final_cnt)
    let ld_out_raw = Instr{}
    ld_out_raw.op = OP_LOAD
    ld_out_raw.operand0 = out_raw_slot
    let out_raw_val = emit(jfn, exit, &ld_out_raw)
    let ld_base_exit = Instr{}
    ld_base_exit.op = OP_LOAD
    ld_base_exit.operand0 = base_slot
    let base_exit = emit(jfn, exit, &ld_base_exit)
    let st_cnt = Instr{}
    st_cnt.op = OP_STORE_MEM
    st_cnt.itype = TYPE_I64
    st_cnt.operand0 = final_cnt
    st_cnt.operand1 = out_raw_val
    emit(jfn, exit, &st_cnt)
    g_iter_exit_bb = exit
    ret base_exit
}

// check_iter_dispatch: check if a call is an iterator builtin.
// Uses globals to avoid large arg counts (jda0 4-arg limit).
// Caller sets: g_iter_matched=0, then calls this.
// On match: g_iter_matched=1, g_iter_result=emitted value.
fn check_iter_dispatch(src: &i8, ns: i64, nl: i64) {
    g_iter_matched = 0
    if nl == 4 and streq(src, ns, 4, "each") == 1 {
        g_iter_result = emit_each_jir(g_jfn, g_iter_bb, g_iter_a0, g_iter_a1, g_iter_a2)
        g_iter_matched = 1
        ret ok(0)
    }
    if nl == 3 and streq(src, ns, 3, "map") == 1 {
        g_iter_result = emit_map_jir(g_jfn, g_iter_bb, g_iter_a0, g_iter_a1, g_iter_a2)
        g_iter_matched = 1
        ret ok(0)
    }
    if nl == 6 and streq(src, ns, 6, "reduce") == 1 {
        g_iter_result = emit_reduce_jir(g_jfn, g_iter_bb, g_iter_a0, g_iter_a1, g_iter_a2, g_iter_a3)
        g_iter_matched = 1
        ret ok(0)
    }
    if nl == 6 and streq(src, ns, 6, "filter") == 1 {
        g_iter_result = emit_filter_jir(g_jfn, g_iter_bb, g_iter_a0, g_iter_a1, g_iter_a2)
        g_iter_matched = 1
        ret ok(0)
    }
    if nl == 3 and streq(src, ns, 3, "any") == 1 {
        g_iter_result = emit_any_jir(g_jfn, g_iter_bb, g_iter_a0, g_iter_a1, g_iter_a2)
        g_iter_matched = 1
        ret ok(0)
    }
    if nl == 3 and streq(src, ns, 3, "sum") == 1 {
        g_iter_result = emit_sum_jir(g_jfn, g_iter_bb, g_iter_a0, g_iter_a1)
        g_iter_matched = 1
        ret ok(0)
    }
    if nl == 5 and streq(src, ns, 5, "count") == 1 {
        g_iter_result = emit_count_jir(g_jfn, g_iter_bb, g_iter_a0, g_iter_a1, g_iter_a2)
        g_iter_matched = 1
        ret ok(0)
    }
}

fn alloc_slot(jfn: &JirFunction) -> i64 {
    let old_val = jfn.next_slot_off
    jfn.next_slot_off = old_val + 8
    ret jfn.next_slot_off
}

fn bind(jfn: &JirFunction, tok: &Token, stype: i64) -> i64 {
    let idx = jfn.var_cnt
    let safe_idx = idx * (idx < 256) + 255 * (idx >= 256)
    let so = alloc_slot(jfn)
    var_bind(&jfn.vars[safe_idx], tok.str_start, tok.str_len, so, stype)
    jfn.var_cnt = idx + (idx < 256)
    ret so
}

fn bind_name(jfn: &JirFunction, name_start: i64, name_len: i64, stype: i64) -> i64 {
    let idx = jfn.var_cnt
    let safe_idx = idx * (idx < 256) + 255 * (idx >= 256)
    let so = alloc_slot(jfn)
    var_bind(&jfn.vars[safe_idx], name_start, name_len, so, stype)
    jfn.var_cnt = idx + (idx < 256)
    ret so
}

fn lookup_idx(jfn: &JirFunction, tok: &Token) -> i64 {
    // Walk backwards so innermost binding wins
    let li_src = jfn.src
    let li_str_start = tok.str_start
    let li_str_len = tok.str_len
    let i = jfn.var_cnt - 1
    loop i >= 0 {
        if jfn.vars[i].name_len == li_str_len {
            let li_vns = jfn.vars[i].name_start
            if str_match(li_src, li_str_start, li_vns, li_str_len) {
                ret i
            }
        }
        i = i - 1
    }
    ret -1   // undefined: caller should error
}

fn lookup(jfn: &JirFunction, tok: &Token) -> i64 {
    let idx = lookup_idx(jfn, tok)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].slot_off
}

fn lookup_stype(jfn: &JirFunction, tok: &Token) -> i64 {
    let idx = lookup_idx(jfn, tok)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].stype
}

fn lookup_idx_name(jfn: &JirFunction, name_start: i64, name_len: i64) -> i64 {
    let i = jfn.var_cnt - 1
    loop i >= 0 {
        let cur_nl = jfn.vars[i].name_len
        if cur_nl == name_len {
            let var_ns = jfn.vars[i].name_start
            let call_src = jfn.src
            if str_match(call_src, name_start, var_ns, name_len) == 1 {
                ret i
            }
        }
        i = i - 1
    }
    ret -1
}

fn lookup_slot_name(jfn: &JirFunction, name_start: i64, name_len: i64) -> i64 {
    let idx = lookup_idx_name(jfn, name_start, name_len)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].slot_off
}

fn lookup_stype_name(jfn: &JirFunction, name_start: i64, name_len: i64) -> i64 {
    let idx = lookup_idx_name(jfn, name_start, name_len)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].stype
}

fn lookup_ident_stype(jfn: &JirFunction, tok: &Token) -> i64 {
    let st = lookup_stype(jfn, tok)
    if st != -1 { ret st }
    let gi = lookup_global2(tok.str_start, tok.str_len, jfn.src)
    if gi != -1 { ret load_i64_at(g_glob_stype, gi) }
    ret -1
}

fn codegen_call(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    // Args are stored in node.child0/child1/child2/child3 by parse_call_rest.
    let arg_ids = i64[16]
    if node.child_cnt > 0 { arg_ids[0] = codegen_expr(node.child0, jfn, bb) }
    if node.child_cnt > 1 { arg_ids[1] = codegen_expr(node.child1, jfn, bb) }
    if node.child_cnt > 2 { arg_ids[2] = codegen_expr(node.child2, jfn, bb) }
    if node.child_cnt > 3 { arg_ids[3] = codegen_expr(node.child3, jfn, bb) }
    let ins = Instr{}
    ins.op        = OP_CALL
    ins.operand0  = arg_ids[0]
    ins.operand1  = arg_ids[1]
    ins.operand2  = arg_ids[2]
    ins.operand3  = node.child_cnt
    ins.str_start = node.token
    ins.str_len   = node.token2
    ret emit(jfn, bb, &ins)
}

// ============================================================
// 6. JIR CODE GENERATOR
// ============================================================

fn field_addr_from_base(base_ptr: i64, foff: i64, jfn: &JirFunction, bb: i64) -> i64 {
    let off_id = emit_const(jfn, bb, TYPE_I64, foff)
    ret emit_binop(jfn, bb, OP_ADD, base_ptr, off_id)
}

fn codegen_addr_expr(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    if node.node_type == NODE_IDENT {
        ret codegen_expr(node, jfn, bb)
    }
    if node.node_type == NODE_BINOP and node.op == TOK_LBRACK {
        if node.child0.node_type == NODE_IDENT {
            let arr_sid = lookup_stype(jfn, node.child0.token)
            let base_ptr = codegen_expr(node.child0, jfn, bb)
            let idx = codegen_expr(node.child1, jfn, bb)
            let elem_sz = 8
            if arr_sid >= 0 {
                elem_sz = jfn.stab.sizes[arr_sid]
            }
            let sz_id = emit_const(jfn, bb, TYPE_I64, elem_sz)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
            ret emit_binop(jfn, bb, OP_ADD, base_ptr, byte_off)
        }
    }
    if node.node_type == NODE_FIELD {
        let slot = lookup_slot_name(jfn, node.token, node.child_cnt)
        let ld = Instr{}
        ld.op = OP_LOAD
        ld.operand0 = slot
        let base = emit(jfn, bb, &ld)
        let sid = node.data_type
        if sid < 0 {
            sid = lookup_stype_name(jfn, node.token, node.child_cnt)
        }
        let obj = base
        if node.child0 != null or node.op == 1 or node.op == 3 {
            let idx = 0
            if node.op == 1 {
                let islot = lookup_slot_name(jfn, node.children, node.param_cnt)
                let ild = Instr{}
                ild.op = OP_LOAD
                ild.operand0 = islot
                idx = emit(jfn, bb, &ild)
            } else if node.op == 3 {
                idx = emit_const(jfn, bb, TYPE_I64, node.children)
            } else {
                idx = codegen_expr(node.child0, jfn, bb)
            }
            // Get element size from struct table using array's element type
            let elem_sid = lookup_struct(jfn.stab, jfn.src, node.token, node.child_cnt)
            let elem_sz = 8
            if elem_sid >= 0 and elem_sid < jfn.stab.cnt {
                elem_sz = jfn.stab.sizes[elem_sid]
            }
            let cins = Instr{}
            cins.op = OP_CONST
            cins.itype = TYPE_I64
            cins.imm = elem_sz
            let sz_id = emit(jfn, bb, &cins)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
            obj = emit_binop(jfn, bb, OP_ADD, base, byte_off)
        }
        // Get element type from array allocation
        let elem_sid = node.data_type
        if elem_sid < 0 {
            // Lookup struct type from array declaration
            elem_sid = lookup_struct(jfn.stab, jfn.src, node.token, node.child_cnt)
        }
        if elem_sid < 0 or elem_sid >= jfn.stab.cnt { ret obj }
        if node.token2 < 0 or node.imm <= 0 { ret obj }
        if node.token2 + node.imm > jfn.src_len { ret obj }
        let foff = lookup_field_off_flat(elem_sid, jfn.src, node.token2, node.imm)
        if foff < 0 { ret obj }
        ret field_addr_from_base(obj, foff, jfn, bb)
    }
    ret -1
}

fn codegen_fn(fn_node: &Node, jfn: &JirFunction) {
    jfn.var_cnt       = 0
    jfn.next_slot_off = 0
    jfn.param_cnt     = fn_node.child_cnt
    clear_owned_flags(jfn)
    let pi = 0
    loop pi < fn_node.child_cnt {
        let ptok = Token{}
        ptok.str_start = fn_node.children[pi].token
        ptok.str_len   = fn_node.children[pi].token2
        let pslot = bind(jfn, ptok, fn_node.children[pi].data_type)
        jfn.param_slots[pi] = pslot
        pi = pi + 1
    }
    let entry_bb = create_block_live(jfn)
    codegen_block(fn_node.child0, jfn, entry_bb)
}

fn codegen_block(block: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let cur_bb = bb
    let i = 0
    loop i < block.child_cnt {
        cur_bb = codegen_stmt(block.children[i], jfn, cur_bb)
        i = i + 1
    }
    ret cur_bb
}

fn codegen_stmt(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let nt = node.node_type
    if nt == NODE_LET {
        // Use g_let_val_buf directly instead of node.child0.
        // jda0's ABI compiles `n.child0 = g_let_val_buf` as a field-name copy
        // (n.child0 = g_let_val_buf.child0), not address-of. So child0 is broken.
        // Calling codegen_expr(g_let_val_buf,...) makes jda0 pass &g_let_val_buf,
        // which is what we actually want.
        let val_id = codegen_expr(g_let_val_buf, jfn, bb)
        // node.token = str_start, node.token2 = str_len (stable integers, no dangling ptr)
        let slot = lookup_slot_name(jfn, node.token, node.token2)
        let out_slot = slot
        let out_stype = -1
        if g_let_val_buf.node_type == NODE_STRUCT_INIT {
            out_stype = lookup_struct(jfn.stab, jfn.src, g_let_val_buf.token.str_start, g_let_val_buf.token.str_len)
        }
        if g_let_val_buf.node_type == NODE_ARRAY_ALLOC and g_let_val_buf.imm == 0 and g_let_val_buf.token2 > 0 {
            out_stype = lookup_struct(jfn.stab, jfn.src, g_let_val_buf.token, g_let_val_buf.token2)
        }
        if node.op == 0 {
            // let declaration introduces a new stack slot
            out_slot = bind_name(jfn, node.token, node.token2, out_stype)
        } else {
            // assignment updates existing slot; undefined vars become implicit slots
            if slot == -1 { out_slot = bind_name(jfn, node.token, node.token2, out_stype) }
        }
        let st = Instr{}
        st.op       = OP_STORE
        st.operand0 = val_id
        st.operand1 = out_slot
        emit(jfn, bb, &st)
        ret bb
    }
    if nt == NODE_INDEX_STORE {
        let addr = 0
        if node.token > 0 and node.child_cnt > 0 {
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base = emit(jfn, bb, &bld)
            let idx = 0
            if node.op == 1 {
                let islot = lookup_slot_name(jfn, node.child2, node.child3)
                let ild = Instr{}
                ild.op = OP_LOAD
                ild.operand0 = islot
                idx = emit(jfn, bb, &ild)
            } else if node.op == 3 {
                idx = emit_const(jfn, bb, TYPE_I64, node.children)
            } else {
                idx = codegen_expr(node.child0, jfn, bb)
            }
            let sid = lookup_stype_name(jfn, node.token, node.child_cnt)
            let elem_sz = 8
            if sid >= 0 and sid < jfn.stab.cnt { elem_sz = jfn.stab.sizes[sid] }
            let sz = emit_const(jfn, bb, TYPE_I64, elem_sz)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz)
            addr = emit_binop(jfn, bb, OP_ADD, base, byte_off)
        } else {
            let iexpr = Node{}
            iexpr.node_type = NODE_BINOP
            iexpr.op = TOK_LBRACK
            iexpr.child0 = node.child0
            iexpr.child1 = node.child2
            addr = codegen_addr_expr(iexpr, jfn, bb)
        }
        let rhs = codegen_expr(node.child1, jfn, bb)
        let st = Instr{}
        st.op = OP_STORE_MEM
        st.itype = TYPE_I64
        st.operand0 = rhs
        st.operand1 = addr
        emit(jfn, bb, &st)
        ret bb
    }
    if nt == NODE_FIELD_STORE {
        let faddr = 0
        if node.data_type == 10 {
            // base.field[idx] = rhs: get address of base.field, offset by idx*8
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base_ptr = emit(jfn, bb, &bld)
            let sid_b = lookup_stype_name(jfn, node.token, node.child_cnt)
            let foff = lookup_field_off_flat(sid_b, jfn.src, node.token2, node.imm)
            let field_base = base_ptr
            if foff >= 0 { field_base = field_addr_from_base(base_ptr, foff, jfn, bb) }
            let idx_v = 0
            let fidx_kind = node.children
            if fidx_kind == 1 {
                let islot = lookup_slot_name(jfn, node.child2, node.child3)
                let ild = Instr{}
                ild.op = OP_LOAD
                ild.operand0 = islot
                idx_v = emit(jfn, bb, &ild)
            }
            if fidx_kind == 3 {
                idx_v = emit_const(jfn, bb, TYPE_I64, node.child2)
            }
            if fidx_kind == 2 {
                idx_v = codegen_expr(node.child0, jfn, bb)
            }
            let sz_id = emit_const(jfn, bb, TYPE_I64, 8)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx_v, sz_id)
            let target = emit_binop(jfn, bb, OP_ADD, field_base, byte_off)
            let rhs_v = codegen_expr(node.child1, jfn, bb)
            let st = Instr{}
            st.op = OP_STORE_MEM
            st.itype = TYPE_I64
            st.operand0 = rhs_v
            st.operand1 = target
            emit(jfn, bb, &st)
            ret bb
        }
        if node.data_type == 1 {
            // Direct indexed-lhs field address path to avoid fragile temporary nodes.
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base = emit(jfn, bb, &bld)
            let sid = lookup_stype_name(jfn, node.token, node.child_cnt)
            let islot = lookup_slot_name(jfn, node.child2, node.child3)
            let ild = Instr{}
            ild.op = OP_LOAD
            ild.operand0 = islot
            let idx = emit(jfn, bb, &ild)
            let elem_sz = 8
            if sid >= 0 and sid < jfn.stab.cnt { elem_sz = jfn.stab.sizes[sid] }
            let cins = Instr{}
            cins.op = OP_CONST
            cins.itype = TYPE_I64
            cins.imm = elem_sz
            let sz_id = emit(jfn, bb, &cins)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
            let obj = emit_binop(jfn, bb, OP_ADD, base, byte_off)
            faddr = obj
            if sid >= 0 and sid < jfn.stab.cnt and node.token2 >= 0 and node.imm > 0 and node.token2 + node.imm <= jfn.src_len {
                let foff = lookup_field_off_flat(sid, jfn.src, node.token2, node.imm)
                if foff >= 0 { faddr = field_addr_from_base(obj, foff, jfn, bb) }
            }
        } else {
            let fexpr = Node{}
            fexpr.node_type = NODE_FIELD
            fexpr.token = node.token
            fexpr.child_cnt = node.child_cnt
            fexpr.op = node.data_type
            fexpr.children = 0
            fexpr.param_cnt = 0
            fexpr.token2 = node.token2
            fexpr.imm = node.imm
            fexpr.child0 = null
            fexpr.data_type = -1
            if node.data_type == 2 {
                fexpr.child0 = node.child0
            }
            if node.data_type == 3 {
                fexpr.children = node.child2
            }
            faddr = codegen_addr_expr(fexpr, jfn, bb)
        }
        let rhs = 0
        if node.op == 6 {
            // Direct rhs indexed-field load: rhs_base[idx].field
            let rbslot = lookup_slot_name(jfn, node.children, node.param_cnt)
            let rbld = Instr{}
            rbld.op = OP_LOAD
            rbld.operand0 = rbslot
            let rbase = emit(jfn, bb, &rbld)
            let rsid = lookup_stype_name(jfn, node.children, node.param_cnt)
            let rislot = lookup_slot_name(jfn, node.child2, node.child3)
            let rild = Instr{}
            rild.op = OP_LOAD
            rild.operand0 = rislot
            let ridx = emit(jfn, bb, &rild)
            let relem = 8
            if rsid >= 0 and rsid < jfn.stab.cnt { relem = jfn.stab.sizes[rsid] }
            let rc = Instr{}
            rc.op = OP_CONST
            rc.itype = TYPE_I64
            rc.imm = relem
            let rsz = emit(jfn, bb, &rc)
            let rbyte = emit_binop(jfn, bb, OP_MUL, ridx, rsz)
            let robj = emit_binop(jfn, bb, OP_ADD, rbase, rbyte)
            let raddr = robj
            if rsid >= 0 and rsid < jfn.stab.cnt and node.child1 >= 0 and node.ret_type > 0 and node.child1 + node.ret_type <= jfn.src_len {
                let rfoff = lookup_field_off_flat(rsid, jfn.src, node.child1, node.ret_type)
                if rfoff >= 0 { raddr = field_addr_from_base(robj, rfoff, jfn, bb) }
            }
            let rld = Instr{}
            rld.op = OP_LOAD_MEM
            rld.operand0 = raddr
            rhs = emit(jfn, bb, &rld)
        } else if node.op == 5 {
            let rfield = Node{}
            rfield.node_type = NODE_FIELD
            rfield.token = node.children
            rfield.child_cnt = node.param_cnt
            rfield.token2 = node.child3
            rfield.imm = node.ret_type
            rfield.data_type = -1
            rfield.child0 = null
            rhs = codegen_expr(rfield, jfn, bb)
        } else if node.op == 3 {
            let slot = lookup_slot_name(jfn, node.children, node.param_cnt)
            let ld = Instr{}
            ld.op = OP_LOAD
            ld.operand0 = slot
            rhs = emit(jfn, bb, &ld)
        } else if node.op == 4 {
            rhs = emit_const(jfn, bb, TYPE_I64, node.ret_type)
        } else {
            rhs = codegen_expr(node.child1, jfn, bb)
        }
        let st = Instr{}
        st.op = OP_STORE_MEM
        st.itype = TYPE_I64
        st.operand0 = rhs
        st.operand1 = faddr
        emit(jfn, bb, &st)
        ret bb
    }
    if nt == NODE_RET {
        let val_id = 0
        if node.op == 2 {
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base = emit(jfn, bb, &bld)
            let sid = lookup_stype_name(jfn, node.token, node.child_cnt)
            let obj = base
            if node.ret_type == 1 or node.ret_type == 2 or node.ret_type == 3 {
                let idx = 0
                if node.ret_type == 1 {
                    let islot = lookup_slot_name(jfn, node.children, node.param_cnt)
                    let ild = Instr{}
                    ild.op = OP_LOAD
                    ild.operand0 = islot
                    idx = emit(jfn, bb, &ild)
                } else if node.ret_type == 3 {
                    idx = emit_const(jfn, bb, TYPE_I64, node.children)
                } else {
                    idx = codegen_expr(node.child1, jfn, bb)
                }
                let elem_sz = 8
                if sid >= 0 and sid < jfn.stab.cnt { elem_sz = jfn.stab.sizes[sid] }
                let cins = Instr{}
                cins.op = OP_CONST
                cins.itype = TYPE_I64
                cins.imm = elem_sz
                let sz_id = emit(jfn, bb, &cins)
                let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
                obj = emit_binop(jfn, bb, OP_ADD, base, byte_off)
            }
            let addr = obj
            if sid >= 0 and sid < jfn.stab.cnt and node.token2 >= 0 and node.imm > 0 and node.token2 + node.imm <= jfn.src_len {
                let foff = lookup_field_off_flat(sid, jfn.src, node.token2, node.imm)
                if foff >= 0 { addr = field_addr_from_base(obj, foff, jfn, bb) }
            }
            let fld = Instr{}
            fld.op = OP_LOAD_MEM
            fld.operand0 = addr
            val_id = emit(jfn, bb, &fld)
        } else if node.op == 3 {
            let slot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let ld = Instr{}
            ld.op = OP_LOAD
            ld.operand0 = slot
            val_id = emit(jfn, bb, &ld)
        } else if node.op == 4 {
            val_id = emit_const(jfn, bb, TYPE_I64, node.imm)
        } else {
            val_id = codegen_expr(node.child0, jfn, bb)
        }
        let ret_ins = Instr{}
        ret_ins.op = OP_RET
        ret_ins.operand0 = val_id
        emit(jfn, bb, &ret_ins)
        ret bb
    }
    if nt == NODE_PRINT {
        // Check op field to determine argument type
        // op=7 (NODE_INT) -> integer literal stored in node.imm
        // otherwise -> string or other expression in node.child0
        if node.op == 7 {
            //  -> emit print_int with immediate value
            let val_id = emit_const(jfn, bb, TYPE_I64, node.imm)
            emit_print_int(jfn, bb, val_id)
        } else {
            //  or  -> SYS_WRITE(1, str_ptr, str_len)
            let str_id = codegen_expr(node.child0, jfn, bb)
            let fd_id  = emit_const(jfn, bb, TYPE_I64, 1)        // stdout fd
            let len_ins1 = Instr{}
            len_ins1.op = OP_STRLEN
            len_ins1.operand0 = str_id
            let len_id = emit(jfn, bb, &len_ins1)
            emit_syscall3(jfn, bb, 1, fd_id, str_id, len_id)     // SYS_WRITE=1
        }
        ret bb
    }
    if nt == NODE_IF {
        ret codegen_if(node, jfn, bb)
    }
    if nt == NODE_LOOP {
        ret codegen_loop(node, jfn, bb)
    }
    if nt == NODE_SYSCALL {
        codegen_syscall(node, jfn, bb)
        ret bb
    }
    if nt == NODE_CALL {
        codegen_call(node, jfn, bb)
        ret bb
    }
    ret bb
}

fn codegen_expr(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    if node.node_type == NODE_INT {
        ret emit_const(jfn, bb, TYPE_I64, node.imm)
    }
    if node.node_type == NODE_STR {
        ret emit_strlit_raw(jfn, bb, node.token.str_start, node.token.str_len)
    }
    if node.node_type == NODE_IDENT {
        let slot = lookup(jfn, node.token)
        if slot == -1 {
            // Check constant table
            let cval = lookup_const(jfn.src, node.token.str_start, node.token.str_len)
            if cval != -1 {
                ret emit_const(jfn, bb, TYPE_I64, cval)
            }
        }
        let ld = Instr{}
        ld.op       = OP_LOAD
        ld.operand0 = slot
        ret emit(jfn, bb, &ld)
    }
    if node.node_type == NODE_STRUCT_INIT {
        // Allocation for struct literals is implemented in other roadmap items.
        // Keep parser acceptance so struct syntax can coexist with field support.
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    if node.node_type == NODE_ARRAY_ALLOC {
        let elem_sz = node.imm
        if elem_sz <= 0 and node.token2 > 0 {
            let sid = lookup_struct(jfn.stab, jfn.src, node.token, node.token2)
            if sid >= 0 and sid < jfn.stab.cnt {
                elem_sz = jfn.stab.sizes[sid]
            }
        }
        if elem_sz <= 0 { elem_sz = 8 }
        // node.child0 may be null (jda0 ABI issue: child0 field copy, not address).
        // Fall back to g_let_cnt_buf which always holds the count expression.
        let cnt = codegen_expr(g_let_cnt_buf, jfn, bb)
        let esz = emit_const(jfn, bb, TYPE_I64, elem_sz)
        let bytes = emit_binop(jfn, bb, OP_MUL, cnt, esz)
        let c4095 = emit_const(jfn, bb, TYPE_I64, 4095)
        let c4096 = emit_const(jfn, bb, TYPE_I64, 4096)
        let padded = emit_binop(jfn, bb, OP_ADD, bytes, c4095)
        let page_bytes = emit_binop(jfn, bb, OP_DIV, padded, c4096)
        let page_sz = emit_const(jfn, bb, TYPE_I64, 4096)
        let alloc_sz = emit_binop(jfn, bb, OP_MUL, page_bytes, page_sz)
        let ins = Instr{}
        ins.op = OP_ALLOC
        ins.operand0 = alloc_sz
        ret emit(jfn, bb, &ins)
    }
    if node.node_type == NODE_ADDR {
        if node.child0.node_type == NODE_IDENT {
            let slot = lookup(jfn, node.child0.token)
            let ins = Instr{}
            ins.op = OP_ADDR
            ins.operand0 = slot
            ret emit(jfn, bb, &ins)
        }
        ret codegen_addr_expr(node.child0, jfn, bb)
    }
    if node.node_type == NODE_DEREF {
        let ptr_id = codegen_expr(node.child0, jfn, bb)
        let ld = Instr{}
        ld.op = OP_LOAD_MEM
        ld.operand0 = ptr_id
        ret emit(jfn, bb, &ld)
    }
    if node.node_type == NODE_FIELD {
        let addr = codegen_addr_expr(node, jfn, bb)
        let ld = Instr{}
        ld.op = OP_LOAD_MEM
        ld.operand0 = addr
        ret emit(jfn, bb, &ld)
    }
    if node.node_type == NODE_BINOP {
        if node.op == TOK_LBRACK {
            let addr = codegen_addr_expr(node, jfn, bb)
            let ld = Instr{}
            ld.op = OP_LOAD_MEM
            ld.operand0 = addr
            ret emit(jfn, bb, &ld)
        }
        // Handle unary NOT (bitwise NOT)
        if node.op == TOK_TILDE {
            let a = codegen_expr(node.child0, jfn, bb)
            // For now, implement bitwise-not as -1 - x
            // So just return a as-is (this is a limitation)
            ret a
        }
        let a  = codegen_expr(node.child0, jfn, bb)
        let b  = codegen_expr(node.child1, jfn, bb)
        let op = tok_to_jir_op(node.op)
        ret emit_binop(jfn, bb, op, a, b)
    }
    if node.node_type == NODE_CALL {
        ret codegen_call(node, jfn, bb)
    }
    if node.node_type == NODE_SYSCALL {
        ret codegen_syscall(node, jfn, bb)
    }
    ret -1
}

// -------------------------------------------------------
// Inline compile functions: parse + codegen in one pass.
// Avoids AST dangling-pointer issues from jda0's struct-return ABI.
// -------------------------------------------------------

// Forward declarations needed (compile_if_inline calls compile_stmts_inline
// and vice versa - handled by ordering: stmts first, then if/loop).
fn legacy_compile_stmts_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64//
fn legacy_compile_if_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64//
fn legacy_compile_loop_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64//

// Forward declarations for inline codegen expressions
fn live_codegen_expr_inline_old(bb: i64) -> i64//
fn live_codegen_binop_inline(min_prec: i32, bb: i64) -> i64//
fn live_codegen_binop_rest(min_prec: i32, bb: i64, left_id: i64) -> i64//
fn live_codegen_postfix_inline(bb: i64) -> i64//
fn live_codegen_postfix_rest(bb: i64, expr_id: i64, cur_stype: i64) -> i64//
fn live_codegen_primary2_inline(bb: i64) -> i64//
fn live_codegen_primary_small_inline(tt: i64, bb: i64) -> i64//
fn live_codegen_primary_paren_inline(tt: i64, bb: i64) -> i64//
fn live_codegen_primary_ident_inline(t: &Token, bb: i64) -> i64//
fn live_codegen_primary_inline(bb: i64) -> i64//
fn live_codegen_call_inline(name: &Token, bb: i64) -> i64//
fn live_codegen_method_call(name: &Token, bb: i64, self_id: i64) -> i64//

fn live_codegen_expr_inline_old(bb: i64) -> i64 {
    ret live_codegen_binop_inline(0, bb)
}

fn live_codegen_binop_inline(min_prec: i32, bb: i64) -> i64 {
    let left_id = live_codegen_postfix_inline(bb)
    ret live_codegen_binop_rest(min_prec, bb, left_id)
}

fn live_codegen_binop_rest(min_prec: i32, bb: i64, left_id: i64) -> i64 {
    let op = tok_type_at(g_dbg_toks_init, g_main_pos)
    let prec = op_precedence(op)
    let keep = 1
    if prec == 0 { keep = 0 }
    if prec < min_prec { keep = 0 }
    if keep != 1 { ret left_id }
    let left_stype = g_codegen_stype
    g_main_pos = g_main_pos + 1
    let right_id = live_codegen_binop_inline(prec + 1, bb)
    let jir_op = tok_to_jir_op(op)
    if left_stype == TYPE_F64 or left_stype == TYPE_F32 { jir_op = tok_to_jir_op_f64(op) }
    let next_left = emit_binop(g_jfn, bb, jir_op, left_id, right_id)
    g_codegen_stype = left_stype
    ret live_codegen_binop_rest(min_prec, bb, next_left)
}

fn live_codegen_postfix_inline(bb: i64) -> i64 {
    let start_pos = g_main_pos
    let expr_id = live_codegen_primary2_inline(bb)
    let cur_stype = TYPE_I64
    if tok_type_at(g_dbg_toks_init, start_pos) == TOK_IDENT {
        let ns = tok_str_start_at(g_dbg_toks_init, start_pos)
        let nl = tok_str_len_at(g_dbg_toks_init, start_pos)
        cur_stype = lookup_stype_name(g_jfn, ns, nl)
        let not_found = 0
        if cur_stype == -1 { not_found = 1 }
        if cur_stype >= TYPE_PTR_FLAG {
            // primitive pointer param (&i8, &i64, etc.) — strip flag, keep positive
            cur_stype = base_type(cur_stype)
        } else if cur_stype >= 0 {
            // struct param (no pointer flag due to param storage bug) — encode as negative
            cur_stype = (0 - cur_stype) - 1
        }
        if not_found == 1 {
            let gi = lookup_global2(ns, nl, g_src_buf_ptr)
            if gi != -1 { cur_stype = base_type(load_i64_at(g_glob_stype, gi)) }
        }
    }
    // Track type for f64/f32 operator overloading
    if cur_stype == TYPE_F64 or cur_stype == TYPE_F32 {
        g_codegen_stype = TYPE_F64
    } else if cur_stype != -1 {
        // Known non-f64 type — reset (but if cur_stype == -1, leave g_codegen_stype
        // as-is so call handler's TYPE_F64 survives)
        g_codegen_stype = 0
    }
    ret live_codegen_postfix_rest(bb, expr_id, cur_stype)
}

fn live_codegen_postfix_rest(bb: i64, expr_id: i64, cur_stype: i64) -> i64 {
    let tok_type = tok_type_at(g_dbg_toks_init, g_main_pos)
    let is_dot = 0
    if tok_type == TOK_DOT { is_dot = 1 }
    if is_dot == 1 {
        g_main_pos = g_main_pos + 1
        let field_ss = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
        let field_sl = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
        expect(TOK_IDENT)
        let sid = cur_stype
        if sid < 0 { sid = (0 - sid) - 1 }
        let fi = lookup_field_idx_flat(sid, g_src_buf_ptr, field_ss, field_sl)
        let fi_ok = 1
        if fi == -1 { fi_ok = 0 }
        if fi_ok != 1 {
            // Not a field — check if it's a method call: .method(args)
            if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_LPAREN and g_genfn_buf[200] > 0 {
                let mi = lookup_impl_method(g_src_buf_ptr, field_ss, field_sl)
                if mi >= 0 {
                    let mp = 201 + mi * 6
                    let mm_off = g_genfn_buf[mp + 4]
                    let mm_len = g_genfn_buf[mp + 5]
                    // Build Token with mangled name for call
                    let mt = Token{}
                    mt.str_start = mm_off
                    mt.str_len = mm_len
                    // Emit &self (address of the struct variable) as first arg
                    // expr_id is already the pointer/address of the struct
                    ret live_codegen_method_call(&mt, bb, expr_id)
                }
            }
            // Primitive method dispatch: i64/f64 method syntax
            if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_LPAREN {
                let prim_r = -1
                if cur_stype == TYPE_I64 {
                    prim_r = try_prim_i64(bb, expr_id, field_ss, field_sl)
                }
                if cur_stype == TYPE_F64 or cur_stype == TYPE_F32 {
                    prim_r = try_prim_f64(bb, expr_id, field_ss, field_sl)
                }
                if prim_r != -1 { ret prim_r }
            }
            ret expr_id
        }
        let off_id = emit_const(g_jfn, bb, TYPE_I64, g_field_byte_off[fi])
        let addr = emit_binop(g_jfn, bb, OP_ADD, expr_id, off_id)
        let next_stype = g_field_type[fi]
        let next_expr = addr
        let is_array_field = 0
        if g_field_is_arr[fi] == 1 { is_array_field = 1 }
        if is_array_field != 1 {
            let ld = Instr{}
            ld.op = OP_LOAD_MEM
            ld.itype = base_type(next_stype)
            ld.operand0 = addr
            next_expr = emit(g_jfn, bb, &ld)
            ret live_codegen_postfix_rest(bb, next_expr, next_stype)
        }
        // array field: encode struct element type as negative for struct arrays only
        if g_field_is_struct[fi] == 1 {
            ret live_codegen_postfix_rest(bb, addr, (0 - next_stype) - 1)
        }
        // primitive array: keep positive type for type_sizeof path
        ret live_codegen_postfix_rest(bb, addr, next_stype)
    }
    let is_index = 0
    if tok_type == TOK_LBRACK { is_index = 1 }
    if is_index == 1 {
        g_main_pos = g_main_pos + 1
        let idx_id = live_codegen_expr_inline(bb)
        expect(TOK_RBRACK)
        if cur_stype < 0 {
            // struct element type (negative encoding: struct_sid = -(cur_stype)-1)
            let struct_sid = (0 - cur_stype) - 1
            let elem_sz_i = g_struct_sizes[struct_sid]
            let byte_off = emit_index_scale(bb, idx_id, elem_sz_i)
            let addr = emit_binop(g_jfn, bb, OP_ADD, expr_id, byte_off)
            ret live_codegen_postfix_rest(bb, addr, cur_stype)
        }
        // primitive element type (positive cur_stype)
        let elem_sz_i = type_sizeof(cur_stype)
        let byte_off = emit_index_scale(bb, idx_id, elem_sz_i)
        let addr = emit_binop(g_jfn, bb, OP_ADD, expr_id, byte_off)
        let ld = Instr{}
        ld.op = OP_LOAD_MEM
        ld.itype = cur_stype
        ld.operand0 = addr
        let next_expr = emit(g_jfn, bb, &ld)
        ret live_codegen_postfix_rest(bb, next_expr, cur_stype)
    }
    ret expr_id
}

fn live_codegen_primary2_inline(bb: i64) -> i64 {
    let tt = tok_type_at(g_dbg_toks_init, g_main_pos)
    // Lambda: fn(...) -> T { ... }
    // TOK_FN==0 so keyword classifier can't produce it; fn is lexed as TOK_IDENT
    if tt == TOK_IDENT and tok_str_len_at_raw(g_dbg_toks_init, g_main_pos) == 2 and streq(g_src_buf_ptr, tok_str_start_at_raw(g_dbg_toks_init, g_main_pos), 2, "fn") == 1 and tok_type_at_raw(g_dbg_toks_init, g_main_pos + 1) == TOK_LPAREN {
        g_main_pos = g_main_pos + 1
        ret live_codegen_lambda_inline(bb)
    }
    let is_ident = 0
    if tt == TOK_IDENT { is_ident = 1 }
    if is_ident == 1 {
        let t = Token{}
        t.str_start = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
        t.str_len = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
        ret live_codegen_primary_ident_inline(&t, bb)
    }
    ret live_codegen_primary_small_inline(tt, bb)
}

fn live_codegen_primary_small_inline(tt: i64, bb: i64) -> i64 {
    let is_int = 0
    if tt == TOK_INT { is_int = 1 }
    if is_int == 1 {
        let imm = tok_imm_at(g_dbg_toks_init, g_main_pos)
        g_main_pos = g_main_pos + 1
        ret emit_const(g_jfn, bb, TYPE_I64, imm)
    }
    if tt == TOK_TRUE {
        g_main_pos = g_main_pos + 1
        ret emit_const(g_jfn, bb, TYPE_I64, 1)
    }
    if tt == TOK_FALSE {
        g_main_pos = g_main_pos + 1
        ret emit_const(g_jfn, bb, TYPE_I64, 0)
    }
    if tt == TOK_FLOAT {
        let fimm = tok_imm_at(g_dbg_toks_init, g_main_pos)
        g_main_pos = g_main_pos + 1
        g_codegen_stype = TYPE_F64
        // Unpack: (int_part << 32) | (frac_val << 8) | frac_digits
        let fl_int = fimm >> 32
        let fl_frac = (fimm >> 8) & 16777215
        let fl_dig = fimm & 255
        let fl_sc = 1
        let fl_di = 0
        loop fl_di < fl_dig {
            fl_sc = fl_sc * 10
            fl_di = fl_di + 1
        }
        let fl_c0 = emit_const(g_jfn, bb, TYPE_I64, fl_int)
        let fl_i2f0 = Instr{}
        fl_i2f0.op = OP_I2F
        fl_i2f0.operand0 = fl_c0
        let fl_f0 = emit(g_jfn, bb, &fl_i2f0)
        if fl_frac == 0 { ret fl_f0 }
        let fl_c1 = emit_const(g_jfn, bb, TYPE_I64, fl_frac)
        let fl_i2f1 = Instr{}
        fl_i2f1.op = OP_I2F
        fl_i2f1.operand0 = fl_c1
        let fl_f1 = emit(g_jfn, bb, &fl_i2f1)
        let fl_c2 = emit_const(g_jfn, bb, TYPE_I64, fl_sc)
        let fl_i2f2 = Instr{}
        fl_i2f2.op = OP_I2F
        fl_i2f2.operand0 = fl_c2
        let fl_f2 = emit(g_jfn, bb, &fl_i2f2)
        let fl_div = emit_binop(g_jfn, bb, OP_FDIV, fl_f1, fl_f2)
        ret emit_binop(g_jfn, bb, OP_FADD, fl_f0, fl_div)
    }
    let is_str = 0
    if tt == TOK_STR { is_str = 1 }
    if tt == TOK_RAW_STR { is_str = 1 }
    if is_str == 1 {
        if tt == TOK_RAW_STR { g_raw_str_mode = 1 }
        let ss = tok_str_start_at(g_dbg_toks_init, g_main_pos)
        let sl = tok_str_len_at(g_dbg_toks_init, g_main_pos)
        g_main_pos = g_main_pos + 1
        ret emit_strlit_raw(g_jfn, bb, ss, sl)
    }
    if tt == TOK_MINUS {
        g_main_pos = g_main_pos + 1
        let neg_rhs = live_codegen_postfix_inline(bb)
        if g_codegen_stype == TYPE_F64 {
            let fneg_ins = Instr{}
            fneg_ins.op = OP_FNEG
            fneg_ins.operand0 = neg_rhs
            ret emit(g_jfn, bb, &fneg_ins)
        }
        let zero_id = emit_const(g_jfn, bb, TYPE_I64, 0)
        ret emit_binop(g_jfn, bb, OP_SUB, zero_id, neg_rhs)
    }
    if tt == TOK_TILDE {
        g_main_pos = g_main_pos + 1
        let neg_rhs = live_codegen_postfix_inline(bb)
        let neg1_id = emit_const(g_jfn, bb, TYPE_I64, -1)
        ret emit_binop(g_jfn, bb, OP_SUB, neg1_id, neg_rhs)
    }
    if tt == TOK_NOT {
        g_main_pos = g_main_pos + 1
        let not_rhs = live_codegen_postfix_inline(bb)
        let zero_id = emit_const(g_jfn, bb, TYPE_I64, 0)
        ret emit_binop(g_jfn, bb, OP_CMP_EQ, not_rhs, zero_id)
    }
    if tt == TOK_AMP {
        g_main_pos = g_main_pos + 1
        let amp_tt = tok_type_at_raw(g_dbg_toks_init, g_main_pos)
        if amp_tt != TOK_IDENT {
            if amp_tt != TOK_EOF { g_main_pos = g_main_pos + 1 }
            ret emit_const(g_jfn, bb, TYPE_I64, 0)
        }
        let amp_start = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
        let amp_len = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
        let amp_next = tok_type_at_raw(g_dbg_toks_init, g_main_pos + 1)
        if amp_next == TOK_DOT or amp_next == TOK_LBRACK {
            ret live_codegen_postfix_inline(bb)
        }
        let amp_slot = lookup_slot_name(g_jfn, amp_start, amp_len)
        if amp_slot != -1 {
            let amp_stype = lookup_stype_name(g_jfn, amp_start, amp_len)
            if amp_stype >= 1000 {
                g_main_pos = g_main_pos + 1
                let amp_ld = Instr{}
                amp_ld.op = OP_LOAD
                amp_ld.operand0 = amp_slot
                ret emit(g_jfn, bb, &amp_ld)
            }
            g_main_pos = g_main_pos + 1
            let amp_ins = Instr{}
            amp_ins.op = OP_ADDR
            amp_ins.operand0 = amp_slot
            ret emit(g_jfn, bb, &amp_ins)
        }
        let amp_gi = lookup_global2(amp_start, amp_len, g_src_buf_ptr)
        if amp_gi != -1 {
            g_main_pos = g_main_pos + 1
            ret emit_gaddr(g_jfn, bb, amp_gi)
        }
        g_main_pos = g_main_pos + 1
        ret emit_const(g_jfn, bb, TYPE_I64, 0)
    }
    ret live_codegen_primary_paren_inline(tt, bb)
}

fn live_codegen_primary_paren_inline(tt: i64, bb: i64) -> i64 {
    let is_paren = 0
    if tt == TOK_LPAREN { is_paren = 1 }
    if is_paren == 1 {
        g_main_pos = g_main_pos + 1
        let inner_id = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret inner_id
    }
    ret -1
}

fn live_codegen_primary_inline(bb: i64) -> i64 {
    let ttype = tok_type_at_raw(g_dbg_toks_init, g_main_pos)
    if ttype == TOK_INT {
        let saved_pos = g_main_pos
        g_main_pos = g_main_pos + 1
        ret emit_const(g_jfn, bb, TYPE_I64, tok_imm_at(g_dbg_toks_init, saved_pos))
    }
    if ttype == TOK_STR or ttype == TOK_RAW_STR {
        if ttype == TOK_RAW_STR { g_raw_str_mode = 1 }
        let saved_pos = g_main_pos
        g_main_pos = g_main_pos + 1
        ret emit_strlit_raw(g_jfn, bb, tok_str_start_at_raw(g_dbg_toks_init, saved_pos), tok_str_len_at_raw(g_dbg_toks_init, saved_pos))
    }
    if ttype == TOK_SPAWN {
        g_main_pos = g_main_pos + 1
        let sp_fn_start = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
        let sp_fn_len = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
        g_main_pos = g_main_pos + 1
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        ret emit_spawn_jir(g_jfn, bb, sp_fn_start, sp_fn_len)
    }
    let is_ident = 0
    if ttype == TOK_IDENT { is_ident = 1 }
    if is_ident == 1 {
        let t = Token{}
        t.str_start = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
        t.str_len = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
        ret live_codegen_primary_ident_inline(&t, bb)
    }
    let is_paren = 0
    if ttype == TOK_LPAREN { is_paren = 1 }
    if is_paren == 1 {
        g_main_pos = g_main_pos + 1
        let inner_id = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret inner_id
    }
    ret -1
}

fn live_codegen_primary_ident_inline(t: &Token, bb: i64) -> i64 {
    g_main_pos = g_main_pos + 1
    let is_call = 0
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_LPAREN { is_call = 1 }
    if is_call == 1 {
        // Check if it's an iterator builtin
        if t.str_len >= 3 and t.str_len <= 6 {
            let is_iter = 0
            if t.str_len == 4 and streq(g_src_buf_ptr, t.str_start, 4, "each") == 1 { is_iter = 1 }
            if t.str_len == 3 and streq(g_src_buf_ptr, t.str_start, 3, "map") == 1 { is_iter = 1 }
            if t.str_len == 6 and streq(g_src_buf_ptr, t.str_start, 6, "reduce") == 1 { is_iter = 1 }
            if t.str_len == 6 and streq(g_src_buf_ptr, t.str_start, 6, "filter") == 1 { is_iter = 1 }
            if t.str_len == 3 and streq(g_src_buf_ptr, t.str_start, 3, "any") == 1 { is_iter = 1 }
            if t.str_len == 3 and streq(g_src_buf_ptr, t.str_start, 3, "sum") == 1 { is_iter = 1 }
            if t.str_len == 5 and streq(g_src_buf_ptr, t.str_start, 5, "count") == 1 { is_iter = 1 }
            if is_iter == 1 {
                g_iter_name_start = t.str_start
                g_iter_name_len = t.str_len
                ret codegen_iter_call_inline(g_dbg_toks_init, &g_main_pos, g_stab_ptr, g_src_buf_ptr, g_jfn, bb)
            }
        }
        ret live_codegen_call_inline(t, bb)
    }
    // Generic call: name<type>(args) or name<N>(args) → resolve to mangled name
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_LT and g_genfn_buf[0] > 0 {
        let gc_t2 = tok_type_at_raw(g_dbg_toks_init, g_main_pos + 1)
        let gc_t3 = tok_type_at_raw(g_dbg_toks_init, g_main_pos + 2)
        if (gc_t2 == TOK_I64 or gc_t2 == TOK_I32 or gc_t2 == TOK_I8 or gc_t2 == TOK_INT) and gc_t3 == TOK_GT {
            let gc_gi = lookup_genfn(g_src_buf_ptr, t.str_start, t.str_len)
            if gc_gi >= 0 {
                if gc_t2 == TOK_INT { g_const_gen_val = tok_imm_at(g_dbg_toks_init, g_main_pos + 1) }
                g_main_pos = g_main_pos + 3
                let gp = gc_gi * 7 + 1
                let gfn_off = g_genfn_buf[gp]
                let gfn_len = g_genfn_buf[gp + 1]
                let found2 = find_mangled_fn(gfn_off, gfn_len, gc_t2)
                if found2 == 1 {
                    t.str_start = g_found_mangle_off
                    t.str_len = g_found_mangle_len
                }
                ret live_codegen_call_inline(t, bb)
            }
        }
    }
    // Enum variant: EnumName.Variant or EnumName.Variant(args)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_DOT and g_enum_buf != 0 {
        let ev_start = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos + 1)
        let ev_len = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos + 1)
        let ev_tag = lookup_enum_dot(g_src_buf_ptr, t.str_start, t.str_len, ev_start, ev_len)
        if ev_tag >= 0 {
            g_main_pos = g_main_pos + 2
            if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_LPAREN {
                g_main_pos = g_main_pos + 1
                let ev_mf = lookup_enum_max_fields(g_src_buf_ptr, t.str_start, t.str_len)
                let ev_sz = emit_const(g_jfn, bb, TYPE_I64, (1 + ev_mf) * 8)
                let ev_alloc = Instr{}
                ev_alloc.op = OP_ALLOC
                ev_alloc.operand0 = ev_sz
                let ev_ptr = emit(g_jfn, bb, &ev_alloc)
                let ev_tag_id = emit_const(g_jfn, bb, TYPE_I64, ev_tag)
                let ev_st = Instr{}
                ev_st.op = OP_STORE_MEM
                ev_st.itype = TYPE_I64
                ev_st.operand0 = ev_tag_id
                ev_st.operand1 = ev_ptr
                emit(g_jfn, bb, &ev_st)
                let ev_fi = 0
                loop tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_RPAREN and tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_EOF {
                    let ev_arg = live_codegen_expr_inline(bb)
                    let ev_foff = emit_const(g_jfn, bb, TYPE_I64, (ev_fi + 1) * 8)
                    let ev_faddr = emit_binop(g_jfn, bb, OP_ADD, ev_ptr, ev_foff)
                    let ev_fst = Instr{}
                    ev_fst.op = OP_STORE_MEM
                    ev_fst.itype = TYPE_I64
                    ev_fst.operand0 = ev_arg
                    ev_fst.operand1 = ev_faddr
                    emit(g_jfn, bb, &ev_fst)
                    ev_fi = ev_fi + 1
                    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_COMMA { g_main_pos = g_main_pos + 1 }
                }
                if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_RPAREN { g_main_pos = g_main_pos + 1 }
                ret ev_ptr
            }
            ret emit_const(g_jfn, bb, TYPE_I64, ev_tag)
        }
    }
    // Result.Ok(val) / Result.Err(val) → allocate 16-byte {tag, val}
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_DOT and t.str_len == 6 {
        if streq(g_src_buf_ptr, t.str_start, 6, "Result") == 1 {
            let rv_s = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos + 1)
            let rv_l = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos + 1)
            let rt = -1
            if rv_l == 2 and streq(g_src_buf_ptr, rv_s, 2, "Ok") == 1 { rt = 0 }
            if rv_l == 3 and streq(g_src_buf_ptr, rv_s, 3, "Err") == 1 { rt = 1 }
            if rt >= 0 and tok_type_at_raw(g_dbg_toks_init, g_main_pos + 2) == TOK_LPAREN {
                g_main_pos = g_main_pos + 3
                let rval = live_codegen_expr_inline(bb)
                if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_RPAREN { g_main_pos = g_main_pos + 1 }
                let sz16 = emit_const(g_jfn, bb, TYPE_I64, 16)
                let alloc_i = Instr{}
                alloc_i.op = OP_ALLOC
                alloc_i.operand0 = sz16
                let rptr = emit(g_jfn, bb, &alloc_i)
                let tag_id = emit_const(g_jfn, bb, TYPE_I64, rt)
                let st_tag = Instr{}
                st_tag.op = OP_STORE_MEM
                st_tag.itype = TYPE_I64
                st_tag.operand0 = tag_id
                st_tag.operand1 = rptr
                emit(g_jfn, bb, &st_tag)
                let off8 = emit_const(g_jfn, bb, TYPE_I64, 8)
                let val_addr = emit_binop(g_jfn, bb, OP_ADD, rptr, off8)
                let st_val = Instr{}
                st_val.op = OP_STORE_MEM
                st_val.itype = TYPE_I64
                st_val.operand0 = rval
                st_val.operand1 = val_addr
                emit(g_jfn, bb, &st_val)
                ret rptr
            }
        }
    }
    // Associated function call: StructName.method(args) → StructName_method(args)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_DOT and g_genfn_buf[200] > 0 {
        let af_mn_off = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos + 1)
        let af_mn_len = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos + 1)
        if tok_type_at_raw(g_dbg_toks_init, g_main_pos + 2) == TOK_LPAREN {
            let af_mi = lookup_impl_method2(g_src_buf_ptr, t.str_start, t.str_len, af_mn_off, af_mn_len)
            if af_mi >= 0 {
                g_main_pos = g_main_pos + 2
                let af_mp = 201 + af_mi * 6
                let af_t = Token{}
                af_t.str_start = g_genfn_buf[af_mp + 4]
                af_t.str_len = g_genfn_buf[af_mp + 5]
                ret live_codegen_call_inline(&af_t, bb)
            }
        }
    }
    g_main_pos = g_main_pos - 1
    let slot = lookup(g_jfn, t)
    let slot_missing = 0
    if slot == -1 { slot_missing = 1 }
    if slot_missing == 1 {
        let cval = lookup_const(g_src_buf_ptr, t.str_start, t.str_len)
        let have_const = 0
        if cval != -1 { have_const = 1 }
        if have_const == 1 {
            g_main_pos = g_main_pos + 1
            ret emit_const(g_jfn, bb, TYPE_I64, cval)
        }
        let is_null_lit = 0
        if t.str_len == 4 { if streq(g_src_buf_ptr, t.str_start, 4, "null") == 1 { is_null_lit = 1 } }
        if is_null_lit == 1 {
            g_main_pos = g_main_pos + 1
            ret emit_const(g_jfn, bb, TYPE_I64, 0)
        }
        let gi = lookup_global2(t.str_start, t.str_len, g_src_buf_ptr)
        let have_global = 0
        if gi != -1 { have_global = 1 }
        if have_global == 1 {
            g_main_pos = g_main_pos + 1
            let addr = emit_gaddr(g_jfn, bb, gi)
            let ldg = Instr{}
            ldg.op = OP_LOAD_MEM
            ldg.operand0 = addr
            ret emit(g_jfn, bb, &ldg)
        }
        // StructName[N] — struct array allocation
        if tok_type_at_raw(g_dbg_toks_init, g_main_pos + 1) == TOK_LBRACK {
            let sa_sid = lookup_struct(g_stab_ptr, g_src_buf_ptr, t.str_start, t.str_len)
            if sa_sid >= 0 {
                g_main_pos = g_main_pos + 2
                let sa_count = tok_imm_at(g_dbg_toks_init, g_main_pos)
                g_main_pos = g_main_pos + 1
                if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_RBRACK { g_main_pos = g_main_pos + 1 }
                let sa_elem_sz = g_stab_ptr.sizes[sa_sid]
                let sa_total = sa_count * sa_elem_sz
                let sa_sz_id = emit_const(g_jfn, bb, TYPE_I64, sa_total)
                let sa_ins = Instr{}
                sa_ins.op = OP_ALLOC
                sa_ins.operand0 = sa_sz_id
                ret emit(g_jfn, bb, &sa_ins)
            }
        }
        ret -1
    }
    g_main_pos = g_main_pos + 1
    let ld = Instr{}
    ld.op = OP_LOAD
    ld.operand0 = slot
    ret emit(g_jfn, bb, &ld)
}

// Method call: self_id is the implicit &self, name is the mangled method name.
// Parses (args) and emits call with self_id prepended.
fn live_codegen_method_call(name: &Token, bb: i64, self_id: i64) -> i64 {
    expect(TOK_LPAREN)
    let arg_cnt = 1
    let arg0 = self_id
    let arg1 = -1
    let arg2 = -1
    let arg3 = -1
    let arg4 = -1
    let arg5 = -1
    loop tok_type_at(g_dbg_toks_init, g_main_pos) != TOK_RPAREN and tok_type_at(g_dbg_toks_init, g_main_pos) != TOK_EOF {
        let pos_before = g_main_pos
        let a_id = live_codegen_expr_inline(bb)
        if g_main_pos == pos_before {
            g_main_pos = pos_before + 1
            a_id = emit_const(g_jfn, bb, TYPE_I64, 0)
        }
        if arg_cnt == 1 {
            arg1 = a_id
        } else if arg_cnt == 2 {
            arg2 = a_id
        } else if arg_cnt == 3 {
            arg3 = a_id
        } else if arg_cnt == 4 {
            arg4 = a_id
        } else if arg_cnt == 5 {
            arg5 = a_id
        }
        arg_cnt = arg_cnt + 1
        if arg_cnt > 6 { report_error("method call takes at most 5 explicit arguments") }
        if tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_COMMA {
            g_main_pos = g_main_pos + 1
        }
    }
    expect(TOK_RPAREN)
    let ins = Instr{}
    ins.op        = OP_CALL
    ins.operand0  = arg0
    ins.operand1  = arg1
    ins.operand2  = arg2
    ins.operand3  = arg_cnt
    ins.bb_target0 = arg3
    ins.bb_target1 = arg4
    ins.imm        = arg5
    ins.str_start = name.str_start
    ins.str_len   = name.str_len
    ret emit(g_jfn, bb, &ins)
}

fn live_codegen_lambda_inline(bb: i64) -> i64 {
    // g_main_pos points at TOK_LPAREN (already past TOK_FN due to advance in caller).
    let lam_start = g_main_pos - 1
    // Skip to matching '}' — count brace depth
    let depth = 0
    let found = 0
    loop found == 0 {
        let lt = tok_type_at(g_dbg_toks_init, g_main_pos)
        if lt == TOK_LBRACE { depth = depth + 1 }
        if lt == TOK_RBRACE {
            depth = depth - 1
            if depth == 0 {
                g_main_pos = g_main_pos + 1
                found = 1
            }
        }
        if lt == TOK_EOF { found = 1 }
        if found == 0 { g_main_pos = g_main_pos + 1 }
    }
    let lam_end = g_main_pos
    // Generate name "__lambda_N" in source buffer
    let nm_off = g_runtime_src_len
    // "__lambda_" = 9 chars: 95 95 108 97 109 98 100 97 95
    poke_byte(g_src_buf_ptr, nm_off, 95)
    poke_byte(g_src_buf_ptr, nm_off + 1, 95)
    poke_byte(g_src_buf_ptr, nm_off + 2, 108)
    poke_byte(g_src_buf_ptr, nm_off + 3, 97)
    poke_byte(g_src_buf_ptr, nm_off + 4, 109)
    poke_byte(g_src_buf_ptr, nm_off + 5, 98)
    poke_byte(g_src_buf_ptr, nm_off + 6, 100)
    poke_byte(g_src_buf_ptr, nm_off + 7, 97)
    poke_byte(g_src_buf_ptr, nm_off + 8, 95)
    let nm_len = 9
    // Append digit(s) for g_lambda_cnt
    let lnum = g_lambda_cnt
    if lnum < 10 {
        poke_byte(g_src_buf_ptr, nm_off + nm_len, 48 + lnum)
        nm_len = nm_len + 1
    } else {
        let tens = lnum / 10
        let ones = lnum - (tens * 10)
        poke_byte(g_src_buf_ptr, nm_off + nm_len, 48 + tens)
        nm_len = nm_len + 1
        poke_byte(g_src_buf_ptr, nm_off + nm_len, 48 + ones)
        nm_len = nm_len + 1
    }
    g_runtime_src_len = nm_off + nm_len
    // Capture analysis
    let li = g_lambda_cnt
    let cap_cnt = 0
    let cap_base = li * 8
    // Collect lambda param names
    let pp = lam_start + 2
    let pp_starts: i64[8]
    let pp_lens: i64[8]
    let pp_cnt = 0
    loop tok_type_at(g_dbg_toks_init, pp) != TOK_RPAREN and pp < lam_end {
        if tok_type_at(g_dbg_toks_init, pp) == TOK_IDENT and tok_type_at(g_dbg_toks_init, pp + 1) == TOK_COLON {
            if pp_cnt < 8 {
                pp_starts[pp_cnt] = tok_str_start_at(g_dbg_toks_init, pp)
                pp_lens[pp_cnt] = tok_str_len_at(g_dbg_toks_init, pp)
                pp_cnt = pp_cnt + 1
            }
        }
        pp = pp + 1
    }
    // Find body LBRACE
    let bp = lam_start + 1
    loop tok_type_at(g_dbg_toks_init, bp) != TOK_LBRACE and bp < lam_end { bp = bp + 1 }
    bp = bp + 1
    // Scan body for captures
    loop bp < lam_end - 1 {
        if tok_type_at(g_dbg_toks_init, bp) == TOK_IDENT {
            let cs = tok_str_start_at(g_dbg_toks_init, bp)
            let cl = tok_str_len_at(g_dbg_toks_init, bp)
            let is_p = 0
            let pi = 0
            loop pi < pp_cnt {
                if pp_lens[pi] == cl and str_match(g_src_buf_ptr, pp_starts[pi], cs, cl) == 1 { is_p = 1 }
                pi = pi + 1
            }
            if is_p == 0 {
                let slot = lookup_slot_name(g_jfn, cs, cl)
                if slot != -1 {
                    let dup = 0
                    let di = 0
                    loop di < cap_cnt {
                        let dx = 64 + cap_base + di
                        if g_lambda_name_offs[dx] == cl and str_match(g_src_buf_ptr, g_lambda_ends[dx], cs, cl) == 1 { dup = 1 }
                        di = di + 1
                    }
                    if dup == 0 and cap_cnt < 8 {
                        let cx = 64 + cap_base + cap_cnt
                        g_lambda_ends[cx] = cs
                        g_lambda_name_offs[cx] = cl
                        cap_cnt = cap_cnt + 1
                    }
                }
            }
        }
        bp = bp + 1
    }
    g_lambda_starts[64 + li] = cap_cnt
    // Stash for deferred compilation
    g_lambda_starts[li] = lam_start
    g_lambda_ends[li] = lam_end
    g_lambda_name_offs[li] = nm_off
    g_lambda_name_lens[li] = nm_len
    g_lambda_cnt = g_lambda_cnt + 1
    // Emit fn_addr
    let fins = Instr{}
    fins.op = OP_FN_ADDR
    fins.str_start = nm_off
    fins.str_len = nm_len
    let fn_id = emit(g_jfn, bb, &fins)
    // If no captures and not forced, return fn_addr directly
    if cap_cnt == 0 and g_force_closure_wrap == 0 { ret fn_id }
    // Mark force-wrapped zero-capture lambdas with -1 sentinel
    if cap_cnt == 0 and g_force_closure_wrap == 1 {
        g_lambda_starts[64 + li] = -1
    }
    // Wrap in closure object: [fn_ptr, cap0, ...]
    let sz_id = emit_const(g_jfn, bb, TYPE_I64, (1 + cap_cnt) * 8)
    let cls_alloc = Instr{}
    cls_alloc.op = OP_ALLOC
    cls_alloc.operand0 = sz_id
    let cls_id = emit(g_jfn, bb, &cls_alloc)
    let st0 = Instr{}
    st0.op = OP_STORE_MEM
    st0.operand0 = fn_id
    st0.operand1 = cls_id
    st0.itype = TYPE_I64
    emit(g_jfn, bb, &st0)
    let ci = 0
    loop ci < cap_cnt {
        let cx = 64 + cap_base + ci
        let cslot = lookup_slot_name(g_jfn, g_lambda_ends[cx], g_lambda_name_offs[cx])
        let cld = Instr{}
        cld.op = OP_LOAD
        cld.operand0 = cslot
        let cval = emit(g_jfn, bb, &cld)
        let coff = emit_const(g_jfn, bb, TYPE_I64, (ci + 1) * 8)
        let caddr = emit_binop(g_jfn, bb, OP_ADD, cls_id, coff)
        let cst = Instr{}
        cst.op = OP_STORE_MEM
        cst.operand0 = cval
        cst.operand1 = caddr
        cst.itype = TYPE_I64
        emit(g_jfn, bb, &cst)
        ci = ci + 1
    }
    ret cls_id
}

fn live_codegen_call_closure_inline(bb: i64) -> i64 {
    // call_closure(cls, args...) -> load fn_ptr from [cls+0], call fn_ptr(cls, args...)
    let cls_id = live_codegen_expr_inline(bb)
    let ld = Instr{}
    ld.op = OP_LOAD_MEM
    ld.operand0 = cls_id
    ld.itype = TYPE_I64
    let fn_ptr = emit(g_jfn, bb, &ld)
    let cc_argc = 2
    let cc_a1 = cls_id
    let cc_a2 = -1
    let cc_a3 = -1
    let cc_a4 = -1
    let cc_a5 = -1
    loop tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_COMMA {
        g_main_pos = g_main_pos + 1
        let cc_a = live_codegen_expr_inline(bb)
        if cc_argc == 2 { cc_a2 = cc_a }
        if cc_argc == 3 { cc_a3 = cc_a }
        if cc_argc == 4 { cc_a4 = cc_a }
        if cc_argc == 5 { cc_a5 = cc_a }
        cc_argc = cc_argc + 1
    }
    expect(TOK_RPAREN)
    let cc_ins = Instr{}
    cc_ins.op = OP_CALL_IND
    cc_ins.str_start = -1
    cc_ins.operand0 = fn_ptr
    cc_ins.operand1 = cc_a1
    cc_ins.operand2 = cc_a2
    cc_ins.operand3 = cc_argc
    cc_ins.bb_target0 = cc_a3
    cc_ins.bb_target1 = cc_a4
    cc_ins.imm = cc_a5
    ret emit(g_jfn, bb, &cc_ins)
}

fn live_codegen_call_fn_inline(bb: i64) -> i64 {
    let cf_ptr = live_codegen_expr_inline(bb)
    let cf_argc = 1
    let cf_a1 = -1
    let cf_a2 = -1
    let cf_a3 = -1
    let cf_a4 = -1
    let cf_a5 = -1
    loop tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_COMMA {
        g_main_pos = g_main_pos + 1
        let cf_a = live_codegen_expr_inline(bb)
        if cf_argc == 1 { cf_a1 = cf_a }
        if cf_argc == 2 { cf_a2 = cf_a }
        if cf_argc == 3 { cf_a3 = cf_a }
        if cf_argc == 4 { cf_a4 = cf_a }
        if cf_argc == 5 { cf_a5 = cf_a }
        cf_argc = cf_argc + 1
    }
    expect(TOK_RPAREN)
    let cf_ins = Instr{}
    cf_ins.op = OP_CALL_IND
    cf_ins.str_start = -1
    cf_ins.operand0 = cf_ptr
    cf_ins.operand1 = cf_a1
    cf_ins.operand2 = cf_a2
    cf_ins.operand3 = cf_argc
    cf_ins.bb_target0 = cf_a3
    cf_ins.bb_target1 = cf_a4
    cf_ins.imm = cf_a5
    ret emit(g_jfn, bb, &cf_ins)
}

fn live_codegen_call_inline(name: &Token, bb: i64) -> i64 {
    expect(TOK_LPAREN)
    // fn_addr(name) — argument is function name identifier, not expression
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "fn_addr") == 1 {
        let fa_start = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
        let fa_len = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
        g_main_pos = g_main_pos + 1
        expect(TOK_RPAREN)
        let fins = Instr{}
        fins.op = OP_FN_ADDR
        fins.str_start = fa_start
        fins.str_len = fa_len
        ret emit(g_jfn, bb, &fins)
    }
    // call_fn(fn_ptr, args...) — indirect call via OP_CALL_IND
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "call_fn") == 1 {
        ret live_codegen_call_fn_inline(bb)
    }
    if name.str_len == 12 and streq(g_src_buf_ptr, name.str_start, 12, "call_closure") == 1 {
        ret live_codegen_call_closure_inline(bb)
    }
    let is_alloc_pages = 0
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "alloc_pages") == 1 { is_alloc_pages = 1 }
    if is_alloc_pages == 1 {
        let is_const_single = 0
        if tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_INT and peek_token(g_dbg_toks_init, g_main_pos) == TOK_RPAREN { is_const_single = 1 }
        if is_const_single == 1 {
            let pages = tok_imm_at(g_dbg_toks_init, g_main_pos)
            g_main_pos = g_main_pos + 1
            expect(TOK_RPAREN)
            let alloc_sz = emit_const(g_jfn, bb, TYPE_I64, pages * 4096)
            let ins = Instr{}
            ins.op = OP_ALLOC
            ins.operand0 = alloc_sz
            ret emit(g_jfn, bb, &ins)
        }
    }
    let arg_cnt = 0
    let arg0 = -1
    let arg1 = -1
    let arg2 = -1
    let arg3 = -1
    let arg4 = -1
    let arg5 = -1
    loop tok_type_at(g_dbg_toks_init, g_main_pos) != TOK_RPAREN and tok_type_at(g_dbg_toks_init, g_main_pos) != TOK_EOF {
        let pos_before = g_main_pos
        let a_id = live_codegen_expr_inline(bb)
        if g_main_pos == pos_before {
            g_main_pos = pos_before + 1
            a_id = emit_const(g_jfn, bb, TYPE_I64, 0)
        }
        if arg_cnt == 0 {
            arg0 = a_id
        } else if arg_cnt == 1 {
            arg1 = a_id
        } else if arg_cnt == 2 {
            arg2 = a_id
        } else if arg_cnt == 3 {
            arg3 = a_id
        } else if arg_cnt == 4 {
            arg4 = a_id
        } else if arg_cnt == 5 {
            arg5 = a_id
        }
        arg_cnt = arg_cnt + 1
        if arg_cnt > 6 { report_error("function call takes at most 6 arguments") }
        if tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_COMMA {
            g_main_pos = g_main_pos + 1
        }
    }
    expect(TOK_RPAREN)

    if is_alloc_pages == 1 {
        let pages_id = arg0
        if pages_id == -1 {
            pages_id = emit_const(g_jfn, bb, TYPE_I64, 0)
        }
        let page_sz = emit_const(g_jfn, bb, TYPE_I64, 4096)
        let alloc_sz = emit_binop(g_jfn, bb, OP_MUL, pages_id, page_sz)
        let ins = Instr{}
        ins.op = OP_ALLOC
        ins.operand0 = alloc_sz
        ret emit(g_jfn, bb, &ins)
    }

    if name.str_len == 9 and streq(g_src_buf_ptr, name.str_start, 9, "arena_new") == 1 {
        ret emit_arena_new_jir(g_jfn, bb, arg0)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "arena_alloc") == 1 {
        ret emit_arena_alloc_jir(g_jfn, bb, arg0, arg1)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "arena_reset") == 1 {
        ret emit_arena_reset_jir(g_jfn, bb, arg0)
    }
    if name.str_len == 13 and streq(g_src_buf_ptr, name.str_start, 13, "arena_destroy") == 1 {
        ret emit_arena_destroy_jir(g_jfn, bb, arg0, arg1)
    }

    // Linear types: consume() marks a linear variable as consumed
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "consume") == 1 {
        ret emit_const(g_jfn, bb, TYPE_I64, 0)
    }

    if name.str_len == 9 and streq(g_src_buf_ptr, name.str_start, 9, "print_int") == 1 {
        emit_print_int(g_jfn, bb, arg0)
        ret arg0
    }

    // Atomic builtins
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "atomic_load") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_LOAD
        ins.operand0 = arg0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 12 and streq(g_src_buf_ptr, name.str_start, 12, "atomic_store") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_STORE
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 14 and streq(g_src_buf_ptr, name.str_start, 14, "atomic_cmpxchg") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_CAS
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 16 and streq(g_src_buf_ptr, name.str_start, 16, "atomic_fetch_add") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_ADD
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 5 and streq(g_src_buf_ptr, name.str_start, 5, "rdtsc") == 1 {
        let ins = Instr{}
        ins.op = OP_RDTSC
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "ctx_switch") == 1 {
        let ins = Instr{}
        ins.op = OP_CTX_SWITCH
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }

    // Channel builtins
    if name.str_len == 8 and streq(g_src_buf_ptr, name.str_start, 8, "chan_new") == 1 {
        let ins = Instr{}
        ins.op = OP_CHAN_NEW
        ins.operand0 = arg0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 9 and streq(g_src_buf_ptr, name.str_start, 9, "chan_send") == 1 {
        let ins = Instr{}
        ins.op = OP_CHAN_SEND
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 9 and streq(g_src_buf_ptr, name.str_start, 9, "chan_recv") == 1 {
        let ins = Instr{}
        ins.op = OP_CHAN_RECV
        ins.operand0 = arg0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "chan_close") == 1 {
        let ins = Instr{}
        ins.op = OP_CHAN_CLOSE
        ins.operand0 = arg0
        ret emit(g_jfn, bb, &ins)
    }

    // Thread pool builtins (M6)
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "get_nprocs") == 1 {
        let ins = Instr{}
        ins.op = OP_GET_NPROCS
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 12 and streq(g_src_buf_ptr, name.str_start, 12, "clone_thread") == 1 {
        let ins = Instr{}
        ins.op = OP_CLONE_THREAD
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "futex_wait") == 1 {
        let ins = Instr{}
        ins.op = OP_FUTEX_WAIT
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "futex_wake") == 1 {
        let ins = Instr{}
        ins.op = OP_FUTEX_WAKE
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "get_tid") == 1 {
        let ins = Instr{}
        ins.op = OP_GET_TID
        ret emit(g_jfn, bb, &ins)
    }

    // Epoll builtins (M7)
    if name.str_len == 13 and streq(g_src_buf_ptr, name.str_start, 13, "epoll_create1") == 1 {
        let ins = Instr{}
        ins.op = OP_EPOLL_CREATE
        ins.operand0 = arg0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 9 and streq(g_src_buf_ptr, name.str_start, 9, "epoll_ctl") == 1 {
        let ins = Instr{}
        ins.op = OP_EPOLL_CTL
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.bb_target0 = arg3
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "epoll_wait") == 1 {
        let ins = Instr{}
        ins.op = OP_EPOLL_WAIT
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.bb_target0 = arg3
        ret emit(g_jfn, bb, &ins)
    }
    // Deadlock detection (M8)
    if name.str_len == 14 and streq(g_src_buf_ptr, name.str_start, 14, "deadlock_check") == 1 {
        let ins = Instr{}
        ins.op = OP_DEADLOCK_CHK
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ret emit(g_jfn, bb, &ins)
    }
    // Float builtins (Phase 7 M1)
    if name.str_len == 12 and streq(g_src_buf_ptr, name.str_start, 12, "f64_from_int") == 1 {
        let ins = Instr{}
        ins.op = OP_I2F
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "f64_to_int") == 1 {
        let ins = Instr{}
        ins.op = OP_F2I
        ins.operand0 = arg0
        g_codegen_stype = 0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_add") == 1 {
        let ins = Instr{}
        ins.op = OP_FADD
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_sub") == 1 {
        let ins = Instr{}
        ins.op = OP_FSUB
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_mul") == 1 {
        let ins = Instr{}
        ins.op = OP_FMUL
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_div") == 1 {
        let ins = Instr{}
        ins.op = OP_FDIV
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_neg") == 1 {
        let ins = Instr{}
        ins.op = OP_FNEG
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 8 and streq(g_src_buf_ptr, name.str_start, 8, "f64_sqrt") == 1 {
        let ins = Instr{}
        ins.op = OP_FSQRT
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 6 and streq(g_src_buf_ptr, name.str_start, 6, "f64_lt") == 1 {
        let ins = Instr{}
        ins.op = OP_FCMP_LT
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = 0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 6 and streq(g_src_buf_ptr, name.str_start, 6, "f64_gt") == 1 {
        let ins = Instr{}
        ins.op = OP_FCMP_GT
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = 0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 6 and streq(g_src_buf_ptr, name.str_start, 6, "f64_eq") == 1 {
        let ins = Instr{}
        ins.op = OP_FCMP_EQ
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = 0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "print_float") == 1 {
        let ins = Instr{}
        ins.op = OP_PRINT_FLOAT
        ins.operand0 = arg0
        g_codegen_stype = 0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_abs") == 1 {
        let ins = Instr{}
        ins.op = OP_FABS
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_exp") == 1 {
        let ins = Instr{}
        ins.op = OP_FEXP
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_log") == 1 {
        let ins = Instr{}
        ins.op = OP_FLOG
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_pow") == 1 {
        let ins = Instr{}
        ins.op = OP_FPOW
        ins.operand0 = arg0
        ins.operand1 = arg1
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_sin") == 1 {
        let ins = Instr{}
        ins.op = OP_FSIN
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 7 and streq(g_src_buf_ptr, name.str_start, 7, "f64_cos") == 1 {
        let ins = Instr{}
        ins.op = OP_FCOS
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 8 and streq(g_src_buf_ptr, name.str_start, 8, "f64_tanh") == 1 {
        let ins = Instr{}
        ins.op = OP_FTANH
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "tensor_new1") == 1 {
        let ins = Instr{}
        ins.op = OP_TNEW1
        ins.operand0 = arg0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "tensor_new2") == 1 {
        let ins = Instr{}
        ins.op = OP_TNEW2
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "tensor_free") == 1 {
        let ins = Instr{}
        ins.op = OP_TFREE
        ins.operand0 = arg0
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "tensor_get") == 1 {
        let ins = Instr{}
        ins.op = OP_TGET
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "tensor_set") == 1 {
        let ins = Instr{}
        ins.op = OP_TSET
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 11 and streq(g_src_buf_ptr, name.str_start, 11, "tensor_fill") == 1 {
        let ins = Instr{}
        ins.op = OP_TFILL
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(g_jfn, bb, &ins)
    }
    if name.str_len == 10 and streq(g_src_buf_ptr, name.str_start, 10, "tensor_len") == 1 {
        let ins = Instr{}
