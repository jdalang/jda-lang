    }
    if name_len == 11 and streq(src, name_start, 11, "rocm_matmul") == 1 {
        let ins = Instr{}
        ins.op = OP_ROCM_MATMUL
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ins.bb_target0 = arg4
        ins.bb_target1 = arg5
        ret emit(jfn, bb, &ins)
    }
    if name_len == 11 and streq(src, name_start, 11, "rocm_vecadd") == 1 {
        let ins = Instr{}
        ins.op = OP_ROCM_VECADD
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ret emit(jfn, bb, &ins)
    }

    // General function call — reset f64 type since return type is unknown
    g_codegen_stype = 0
    let ins = Instr{}
    ins.op        = OP_CALL
    ins.operand0  = arg0
    ins.operand1  = arg1
    ins.operand2  = arg2
    ins.operand3  = arg_cnt
    ins.bb_target0 = arg3
    ins.bb_target1 = arg4
    ins.imm        = arg5
    ins.str_start = name_start
    ins.str_len   = name_len
    ret emit(jfn, bb, &ins)
}

fn codegen_syscall_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if g_check_unsafe == 1 and g_unsafe_depth == 0 { report_error("syscall() requires unsafe block") }
    expect(TOK_SYSCALL)
    expect(TOK_LPAREN)
    let nr = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
    let count = 0
    let idx = 0
    loop idx < 7 { g_sc_extra[idx] = -1 idx = idx + 1 }
    g_sc_extra[3] = nr
    loop tok_type_at(toks, pos[0]) == TOK_COMMA {
        pos[0] = pos[0] + 1
        let arg = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
        if count == 0 { g_sc_extra[4] = arg }
        if count == 1 { g_sc_extra[5] = arg }
        if count == 2 { g_sc_extra[6] = arg }
        if count == 3 { g_sc_extra[0] = arg }
        if count == 4 { g_sc_extra[1] = arg }
        if count == 5 { g_sc_extra[2] = arg }
        count = count + 1
        if count > 6 { report_error("syscall takes at most 7 arguments (nr + 6 args)") }
    }
    expect(TOK_RPAREN)
    ret emit_syscall_full(jfn, bb, count)
}

fn emit_print_int(jfn: &JirFunction, bb: i64, val_id: i64) {
    let ins = Instr{}
    ins.op       = OP_PRINT_INT
    ins.operand0 = val_id
    emit(jfn, bb, &ins)
}

fn emit_syscall3(jfn: &JirFunction, bb: i64, nr: i64, a0: i64, a1: i64, a2: i64) -> i64 {
    let nr_id = emit_const(jfn, bb, TYPE_I64, nr)
    ret emit_syscall_raw(jfn, bb, nr_id, a0, a1, a2)
}

fn emit_syscall_raw(jfn: &JirFunction, bb: i64, nr: i64, a0: i64, a1: i64, a2: i64) -> i64 {
    let ins = Instr{}
    ins.op         = OP_SYSCALL
    ins.operand0   = nr
    ins.operand1   = a0
    ins.operand2   = a1
    ins.bb_target0 = a2
    ins.operand3   = 3
    ret emit(jfn, bb, &ins)
}

fn emit_syscall_full(jfn: &JirFunction, bb: i64, count: i64) -> i64 {
    let ins = Instr{}
    ins.op         = OP_SYSCALL
    ins.operand0   = g_sc_extra[3]
    ins.operand1   = g_sc_extra[4]
    ins.operand2   = g_sc_extra[5]
    ins.bb_target0 = g_sc_extra[6]
    ins.bb_target1 = g_sc_extra[0]
    ins.imm        = g_sc_extra[1]
    ins.itype      = g_sc_extra[2]
    ins.operand3   = count
    ret emit(jfn, bb, &ins)
}

// --- Iterator builtin helpers ---

fn emit_closure_call_1arg(jfn: &JirFunction, bb: i64, cls_id: i64, arg_id: i64) -> i64 {
    let ld = Instr{}
    ld.op = OP_LOAD_MEM
    ld.operand0 = cls_id
    ld.itype = TYPE_I64
    let fn_ptr = emit(jfn, bb, &ld)
    let cc = Instr{}
    cc.op = OP_CALL_IND
    cc.str_start = -1
    cc.operand0 = fn_ptr
    cc.operand1 = cls_id
    cc.operand2 = arg_id
    cc.operand3 = 3
    cc.bb_target0 = -1
    cc.bb_target1 = -1
    cc.imm = -1
    ret emit(jfn, bb, &cc)
}

fn emit_closure_call_2arg(jfn: &JirFunction, bb: i64, cls_id: i64, a0: i64, a1: i64) -> i64 {
    let ld = Instr{}
    ld.op = OP_LOAD_MEM
    ld.operand0 = cls_id
    ld.itype = TYPE_I64
    let fn_ptr = emit(jfn, bb, &ld)
    let cc = Instr{}
    cc.op = OP_CALL_IND
    cc.str_start = -1
    cc.operand0 = fn_ptr
    cc.operand1 = cls_id
    cc.operand2 = a0
    cc.operand3 = 4
    cc.bb_target0 = a1
    cc.bb_target1 = -1
    cc.imm = -1
    ret emit(jfn, bb, &cc)
}

fn emit_each_jir(jfn: &JirFunction, bb: i64, arr_id: i64, len_id: i64, cls_id: i64) -> i64 {
    let idx_slot = alloc_slot(jfn)
    let arr_slot = alloc_slot(jfn)
    let len_slot = alloc_slot(jfn)
    let cls_slot = alloc_slot(jfn)
    let zero = emit_const(jfn, bb, TYPE_I64, 0)
    let st0 = Instr{}
    st0.op = OP_STORE
    st0.operand0 = zero
    st0.operand1 = idx_slot
    emit(jfn, bb, &st0)
    let st_arr = Instr{}
    st_arr.op = OP_STORE
    st_arr.operand0 = arr_id
    st_arr.operand1 = arr_slot
    emit(jfn, bb, &st_arr)
    let st_len = Instr{}
    st_len.op = OP_STORE
    st_len.operand0 = len_id
    st_len.operand1 = len_slot
    emit(jfn, bb, &st_len)
    let st_cls = Instr{}
    st_cls.op = OP_STORE
    st_cls.operand0 = cls_id
    st_cls.operand1 = cls_slot
    emit(jfn, bb, &st_cls)
    let head = create_block_live(jfn)
    let body = create_block_live(jfn)
    let exit = create_block_live(jfn)
    emit_jmp(jfn, bb, head)
    let ld_idx = Instr{}
    ld_idx.op = OP_LOAD
    ld_idx.operand0 = idx_slot
    let idx = emit(jfn, head, &ld_idx)
    let ld_len = Instr{}
    ld_len.op = OP_LOAD
    ld_len.operand0 = len_slot
    let len_val = emit(jfn, head, &ld_len)
    let cond = emit_binop(jfn, head, OP_CMP_LT, idx, len_val)
    emit_br(jfn, head, cond, body, exit)
    let ld_idx2 = Instr{}
    ld_idx2.op = OP_LOAD
    ld_idx2.operand0 = idx_slot
    let idx2 = emit(jfn, body, &ld_idx2)
    let ld_arr = Instr{}
    ld_arr.op = OP_LOAD
    ld_arr.operand0 = arr_slot
    let arr_val = emit(jfn, body, &ld_arr)
    let ld_cls = Instr{}
    ld_cls.op = OP_LOAD
    ld_cls.operand0 = cls_slot
    let cls_val = emit(jfn, body, &ld_cls)
    let eight = emit_const(jfn, body, TYPE_I64, 8)
    let off = emit_binop(jfn, body, OP_MUL, idx2, eight)
    let addr = emit_binop(jfn, body, OP_ADD, arr_val, off)
    let ld_elem = Instr{}
    ld_elem.op = OP_LOAD_MEM
    ld_elem.operand0 = addr
    ld_elem.itype = TYPE_I64
    let elem = emit(jfn, body, &ld_elem)
    emit_closure_call_1arg(jfn, body, cls_val, elem)
    let one = emit_const(jfn, body, TYPE_I64, 1)
    let next = emit_binop(jfn, body, OP_ADD, idx2, one)
    let st1 = Instr{}
    st1.op = OP_STORE
    st1.operand0 = next
    st1.operand1 = idx_slot
    emit(jfn, body, &st1)
    emit_jmp(jfn, body, head)
    g_iter_exit_bb = exit
    ret emit_const(jfn, exit, TYPE_I64, 0)
}

fn emit_sum_jir(jfn: &JirFunction, bb: i64, arr_id: i64, len_id: i64) -> i64 {
    let idx_slot = alloc_slot(jfn)
    let acc_slot = alloc_slot(jfn)
    let arr_slot = alloc_slot(jfn)
    let len_slot = alloc_slot(jfn)
    let zero = emit_const(jfn, bb, TYPE_I64, 0)
    let st0 = Instr{}
    st0.op = OP_STORE
    st0.operand0 = zero
    st0.operand1 = idx_slot
    emit(jfn, bb, &st0)
    let st_acc = Instr{}
    st_acc.op = OP_STORE
    st_acc.operand0 = zero
    st_acc.operand1 = acc_slot
    emit(jfn, bb, &st_acc)
    let st_arr = Instr{}
    st_arr.op = OP_STORE
    st_arr.operand0 = arr_id
    st_arr.operand1 = arr_slot
    emit(jfn, bb, &st_arr)
    let st_len = Instr{}
    st_len.op = OP_STORE
