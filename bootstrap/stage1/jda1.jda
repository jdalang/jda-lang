; =============================================================================
; Jda Stage 1 Compiler - Written in Jda
; =============================================================================
; This is the first self-hosted Jda compiler.
; It is written in Jda and compiled by the Stage 0 bootstrapper.
;
; Stage 1 supports richer Jda syntax:
;   - Variables: let x = expr
;   - Functions: fn name(params) -> type { body }
;   - Loops: loop condition { body }
;   - Conditionals: if cond { body } else { body }
;   - Structs: struct Name { field: type }
;   - Pattern matching: match x { val => expr }
;   - Result type: ok(val) / err(msg)  (no exceptions)
;   - Print: print("string")
;   - Inline syscall: syscall(nr, a, b, c) -> i64
;
; Stage 1 outputs JIR which is then lowered to x86-64 machine code.
; =============================================================================

; ============================================================
; 0. CONSTANTS
; ============================================================

; Token type constants
const TOK_FN      = 0
const TOK_LET     = 1
const TOK_IF      = 2
const TOK_ELSE    = 3
const TOK_LOOP    = 4
const TOK_RET     = 5
const TOK_STRUCT  = 6
const TOK_MATCH   = 7
const TOK_PRINT   = 8
const TOK_SYSCALL = 9
const TOK_IDENT   = 10
const TOK_INT     = 11
const TOK_STR     = 12
const TOK_LPAREN  = 13
const TOK_RPAREN  = 14
const TOK_LBRACE  = 15
const TOK_RBRACE  = 16
const TOK_LBRACK  = 17
const TOK_RBRACK  = 18
const TOK_COMMA   = 19
const TOK_COLON   = 20
const TOK_SEMI    = 21
const TOK_ARROW   = 22
const TOK_EQ      = 23
const TOK_EQEQ    = 24
const TOK_NEQ     = 25
const TOK_LT      = 26
const TOK_GT      = 27
const TOK_PLUS    = 28
const TOK_MINUS   = 29
const TOK_STAR    = 30
const TOK_SLASH   = 31
const TOK_AMP     = 32
const TOK_DOT     = 33
const TOK_FATARROW= 34
const TOK_GTE     = 35
const TOK_LTE     = 36
const TOK_AND     = 37
const TOK_OR      = 38
const TOK_PIPE    = 39  ; Bitwise OR (|)
const TOK_TILDE   = 40  ; Bitwise NOT token
const TOK_SHR     = 41  ; Right shift (>>)
const TOK_SHL     = 42  ; Left shift (<<)
const TOK_CONST   = 43
const TOK_EOF     = 44
; Type keyword tokens (classified by lexer)
const TOK_I64     = 45
const TOK_I32     = 46
const TOK_I8      = 47
const TOK_F64     = 48

; AST node types
const NODE_FN     = 0
const NODE_LET    = 1
const NODE_IF     = 2
const NODE_LOOP   = 3
const NODE_CALL   = 4
const NODE_BINOP  = 5
const NODE_IDENT  = 6
const NODE_INT    = 7
const NODE_STR    = 8
const NODE_RET    = 9
const NODE_BLOCK  = 10
const NODE_STRUCT = 11
const NODE_FIELD  = 12
const NODE_MATCH  = 13
const NODE_PRINT  = 14
const NODE_SYSCALL= 15
const NODE_FIELD_STORE = 16
const NODE_STRUCT_INIT = 17
const NODE_ADDR   = 18
const NODE_ARRAY_ALLOC = 19
const NODE_INDEX_STORE = 20
const NODE_DEREF  = 21

; Type system
const TYPE_VOID   = 0
const TYPE_I64    = 1
const TYPE_I32    = 2
const TYPE_I8     = 3
const TYPE_F64    = 4
const TYPE_PTR    = 5

; Pointer type flag (bitmask)
const TYPE_PTR_FLAG = 65536

; Helper types for pointers
const TYPE_PTR_I64 = 65537
const TYPE_PTR_I32 = 65538
const TYPE_PTR_I8  = 65539

; JIR opcodes
const OP_CONST    = 0
const OP_ADD      = 1
const OP_SUB      = 2
const OP_MUL      = 3
const OP_DIV      = 4
const OP_NEG      = 5
const OP_CMP_EQ   = 6
const OP_CMP_NE   = 7
const OP_CMP_LT   = 8
const OP_CMP_GT   = 9
const OP_CMP_GTE  = 10
const OP_CMP_LTE  = 11
const OP_AND      = 12
const OP_OR       = 13
const OP_RET      = 14
const OP_BR       = 15
const OP_JMP      = 16
const OP_CALL     = 17
const OP_SYSCALL  = 18
const OP_STRLIT   = 19
const OP_STRLEN   = 20
const OP_STORE    = 21
const OP_LOAD     = 22
const OP_ADDR     = 23
const OP_LOAD_MEM = 24
const OP_STORE_MEM= 25
const OP_ALLOC    = 26
const OP_PRINT_INT= 27
const OP_SHR      = 28  ; Logical right shift
const OP_SHL      = 29  ; Left shift
const OP_GADDR    = 30
const OP_ARGV_BASE= 31

; x86-64 physical register numbers (Intel encoding)
const PHYS_RAX = 0
const PHYS_RCX = 1
const PHYS_RDX = 2
const PHYS_RBX = 3
const PHYS_RSP = 4
const PHYS_RBP = 5
const PHYS_RSI = 6
const PHYS_RDI = 7
const PHYS_R8  = 8
const PHYS_R9  = 9
const PHYS_R10 = 10
const PHYS_R11 = 11
const PHYS_R12 = 12

; Allocatable pool size: rax rcx rdx rbx rsi rdi r10 r11
const N_ALLOC_REGS = 8

; ============================================================
; 1. STRUCT DEFINITIONS
; ============================================================

struct Token {
    type:      i64
    pad:       i64
    str_start: i64
    str_len:   i64
    imm:       i64
}

struct Node {
    node_type: i32
    op:        i32
    imm:       i64
    data_type: i32
    param_cnt: i32
    child_cnt: i32
    ret_type:  i32
    token:     i64
    token2:    i64
    child0:    &Node
    child1:    &Node
    child2:    &Node
    child3:    &Node
    children:  i64
}

struct Instr {
    op:         i32
    itype:      i32
    id:         i64
    dead:       i32
    pad:        i32
    operand0:   i64
    operand1:   i64
    operand2:   i64
    operand3:   i64
    imm:        i64
    str_start:  i64
    str_len:    i64
    bb_target0: i64
    bb_target1: i64
}

struct BasicBlock {
    id:        i64
    instrs:    Instr[256]
    instr_cnt: i64
    label_off: i64
}

struct VarEntry {
    name_start: i64
    name_len:   i64
    slot_off:   i64
    stype:      i64
}

struct JirFunction {
    src:        &i8
    src_len:    i64
    blocks:     BasicBlock[256]
    block_cnt:  i64
    vars:       VarEntry[128]
    var_cnt:    i64
    next_slot_off: i64
    next_id:    i64
    strtab:     i8[4096]
    strtab_pos: i64
    stab:       &StructTable
    param_cnt:  i64
    param_slots:i64[16]
}

struct ConstVal {
    found: i32
    val:   i64
}

struct Fixup {
    code_off:  i64
    target_bb: i64
    kind:      i64
    str_len:   i64
}

struct RegAlloc {
    pool:      i32[8]
    val2reg:   i32[4096]
    reg2val:   i64[8]
    spill_off: i64[4096]
    sp_top:    i64
}

struct LowerCtx {
    ra:         RegAlloc
    fixups:     Fixup[1024]
    fix_cnt:    i64
    bb_offsets: i64[256]
    use_cnt:    i32[4096]
}

struct StructTable {
    cnt:        i64
    names:      i64[64]
    nlens:      i64[64]
    fcnts:      i64[64]
    sizes:      i64[64]
    fbases:     i64[64]
    field_cnt:  i64
    fnames:     i64[4096]
    flens:      i64[4096]
    foffs:      i64[4096]
    ftypes:     i64[4096]
    fis_array:  i64[4096]
    fowners:    i64[4096]
}

; Global constant table pointer (removed ConstTable struct - use separate arrays below)
let g_const_name_off_tbl: &i64 = 0
let g_const_name_len_tbl: &i64 = 0
let g_const_val_tbl: &i64 = 0
let g_const_cnt = 0
let g_dbg_fi = 0
let g_dbg_toks: &Token = 0
let g_dbg_tok_cnt = 0
let g_panic_pos = 0
let g_cur_fn_name_start = 0
let g_cur_fn_name_len = 0
let g_top_fn_cnt = 0
let g_top_main_idx = -1
let g_dbg_main_prints = 0
let g_dbg_main_lets = 0
let g_glob_name_off: &i64 = 0
let g_glob_name_len: &i64 = 0
let g_glob_off: &i64      = 0
let g_glob_size: &i64     = 0
let g_glob_stype: &i64    = 0
let g_glob_is_addr: &i64  = 0
let g_glob_cnt      = 0
let g_glob_total_sz = 0
let g_tmp_let_gidx = 0
let g_tmp_let_stype = 0
let g_tmp_let_is_addr = 0
let g_emit_glob_buf: &i8 = 0
let g_emit_glob_len = 0
let g_cmp_src: &i8 = 0
let g_cmp_name_start = 0
let g_cmp_name_len = 0
let g_lex_count_ptr = 0
let g_lex_count = 0
let g_lex_out_toks: &Token = 0
let g_lex_src_len = 0
let g_lex_src_ptr: &i8 = 0
let g_lex_pos_i = 0
let g_lower_is_main = 0

; ============================================================
; 2. LEXER
; ============================================================

fn load_i64_at0(p: &i64) {
    ret p[0]
}

fn store_i64_at0(p: &i64, v: i64) {
    p[0] = v
}

fn inc_i64_at0(p: &i64) {
    let cur = load_i64_at0(p)
    p[0] = cur + 1
}

fn inc_i64_at0_twice(p: &i64) {
    inc_i64_at0(p)
    inc_i64_at0(p)
}

fn load_i64_at(p: &i64, idx: i64) {
    ret p[idx]
}

fn store_i64_at(p: &i64, idx: i64, v: i64) {
    p[idx] = v
}

fn load_i8_at(p: &i8, idx: i64) {
    ret p[idx]
}

fn load_i8_at0(p: &i8, idxp: &i64) {
    ret p[idxp[0]]
}

fn char_at_pos(src: &i8, pos: &i64) {
    ret load_i8_at0(src, pos)
}

fn lex_scan_int(pos: &i64) {
    let val = 0
    loop load_i64_at0(pos) < g_lex_src_len {
        let cur = char_at_pos(g_lex_src_ptr, pos)
        if cur < 48 {
            ret val
        } else if cur > 57 {
            ret val
        } else {
            val = val * 10
            val = val + cur
            val = val - 48
            inc_i64_at0(pos)
        }
    }
    ret val
}

fn lex_skip_escaped_char(pos: &i64, src_len: i64) {
    inc_i64_at0(pos)
    if load_i64_at0(pos) < src_len {
        inc_i64_at0(pos)
    }
}

fn lex_skip_string_body() {
    loop g_lex_pos_i < g_lex_src_len {
        let sc = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
        if sc == 34 {
            ret 0
        } else if sc == 92 {
            g_lex_pos_i = g_lex_pos_i + 1
            if g_lex_pos_i < g_lex_src_len {
                g_lex_pos_i = g_lex_pos_i + 1
            }
        } else {
            g_lex_pos_i = g_lex_pos_i + 1
        }
    }
    ret 0
}

fn lex_set_pos_ptr(pos: &i64) {
    g_lex_pos_i = pos[0]
}

fn lex_sync_pos_ptr(pos: &i64) {
    pos[0] = g_lex_pos_i
}

fn lex_set_pos_i(v: i64) {
    g_lex_pos_i = v
}

fn lex_inc_pos_i() {
    g_lex_pos_i = g_lex_pos_i + 1
}

fn lex_mark_string_start() {
    g_cmp_name_start = g_lex_pos_i
    g_cmp_name_start = g_cmp_name_start + 1
    lex_inc_pos_i()
}

fn lex_emit_marked_string() {
    let len = g_lex_pos_i - g_cmp_name_start
    if g_lex_count >= 131071 { panic("Token buffer overflow") }
    let idx = g_lex_count
    g_lex_out_toks[idx].type = TOK_STR
    g_lex_out_toks[idx].str_start = g_cmp_name_start
    g_lex_out_toks[idx].str_len = len
    g_lex_count = g_lex_count + 1
}

fn lex_handle_gt_next(pos: &i64) {
    let next = load_i64_at0(pos)
    let nxt = load_i8_at(g_lex_src_ptr, next + 1)
    if nxt == 62 {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = TOK_SHR
        g_lex_count = g_lex_count + 1
        inc_i64_at0_twice(pos)
    } else if nxt == 61 {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = TOK_GTE
        g_lex_count = g_lex_count + 1
        inc_i64_at0_twice(pos)
    } else {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = char_to_tok(62)
        g_lex_count = g_lex_count + 1
        inc_i64_at0(pos)
    }
}

fn lex_handle_lt_next(pos: &i64) {
    let next = load_i64_at0(pos)
    let nxt = load_i8_at(g_lex_src_ptr, next + 1)
    if nxt == 60 {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = TOK_SHL
        g_lex_count = g_lex_count + 1
        inc_i64_at0_twice(pos)
    } else if nxt == 61 {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = TOK_LTE
        g_lex_count = g_lex_count + 1
        inc_i64_at0_twice(pos)
    } else {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = char_to_tok(60)
        g_lex_count = g_lex_count + 1
        inc_i64_at0(pos)
    }
}

fn lex_emit_ident_or_kw(src: &i8, src_len: i64, pos: &i64) {
    let start = pos[0]
    let keep_ident = 1
    loop keep_ident == 1 {
        if pos[0] >= src_len {
            keep_ident = 0
        } else {
            let cur = src[pos[0]]
            if is_ident_continue(cur) == 1 {
                pos[0] = pos[0] + 1
            } else {
                keep_ident = 0
            }
        }
    }
    let len = pos[0] - start
    let kw = classify_keyword(src, start, len)
    if g_lex_count >= 131071 { panic("Token buffer overflow") }
    let idx = g_lex_count
    g_lex_out_toks[idx].type = kw
    g_lex_out_toks[idx].str_start = start
    g_lex_out_toks[idx].str_len = len
    g_lex_count = g_lex_count + 1
}

fn tok_type_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    if idx < 0 or idx >= g_dbg_tok_cnt { ret TOK_EOF }
    ret toks[idx].type
}

fn tok_type_at(toks: &Token, idx: i64) {
    if idx < 0 or idx >= g_dbg_tok_cnt { ret TOK_EOF }
    ret toks[idx].type
}

fn tok_imm_at(toks: &Token, idx: i64) {
    if idx < 0 or idx >= g_dbg_tok_cnt { ret 0 }
    ret toks[idx].imm
}

fn tok_str_start_at(toks: &Token, idx: i64) {
    if idx < 0 or idx >= g_dbg_tok_cnt { ret 0 }
    ret toks[idx].str_start
}

fn tok_str_len_at(toks: &Token, idx: i64) {
    if idx < 0 or idx >= g_dbg_tok_cnt { ret 0 }
    ret toks[idx].str_len
}

fn span_in_src(start: i64, len: i64, src_len: i64) -> i64 {
    if start < 0 or len < 0 { ret 0 }
    if start > src_len or len > src_len { ret 0 }
    if start + len < start { ret 0 }
    if start + len > src_len { ret 0 }
    ret 1
}

fn parse_const_decl(toks: &Token, pos: &i64) {
    expect(toks, pos, TOK_CONST)
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt { ret ok(0) }
    let c_name_start = tok_str_start_at(toks, pos[0])
    let c_name_len = tok_str_len_at(toks, pos[0])
    expect(toks, pos, TOK_IDENT)
    expect(toks, pos, TOK_EQ)
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt { ret ok(0) }
    let c_val = tok_imm_at(toks, pos[0])
    expect(toks, pos, TOK_INT)

    if g_const_name_off_tbl == 0 { ret }
    let idx = g_const_cnt
    if idx < 0 or idx >= 4096 { ret }
    g_const_name_off_tbl[idx] = c_name_start
    g_const_name_len_tbl[idx] = c_name_len
    g_const_val_tbl[idx] = c_val
    g_const_cnt = idx + 1
}

fn skip_top_level_let_rhs(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) {
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt { ret ok(0) }
    let gidx = g_tmp_let_gidx
    let decl_stype = g_tmp_let_stype
    let decl_is_addr = g_tmp_let_is_addr
    let t = tok_type_at0(toks, pos)
    g_glob_size[gidx]     = 8
    g_glob_stype[gidx]    = decl_stype
    g_glob_is_addr[gidx]  = decl_is_addr
    if t == TOK_INT {
        g_glob_is_addr[gidx] = 0  ; pointer global with integer initial value: load value in expressions
        inc_i64_at0(pos)
    } else if t == TOK_I64 or t == TOK_I32 or t == TOK_I8 or t == TOK_F64 or t == TOK_IDENT {
        let elem_sz = 8
        let stype = TYPE_I64
        if t == TOK_IDENT {
            let type_idx = load_i64_at0(pos)
            let type_start = tok_str_start_at(toks, type_idx)
            let type_len = tok_str_len_at(toks, type_idx)
            let sid = lookup_struct(stab, src, type_start, type_len)
            if sid >= 0 {
                elem_sz = stab.sizes[sid]
                stype = sid
            }
        }
        g_glob_size[gidx] = elem_sz
        g_glob_stype[gidx] = stype
        g_glob_is_addr[gidx] = 1
        inc_i64_at0(pos)
        let next_idx = load_i64_at0(pos)
        let next_type = tok_type_at(toks, next_idx)
        if next_type == TOK_LBRACK {
            inc_i64_at0(pos)
            let size_idx = load_i64_at0(pos)
            let n = tok_imm_at(toks, size_idx)
            inc_i64_at0(pos)
            expect(toks, pos, TOK_RBRACK)
            g_glob_size[gidx] = elem_sz * n
        } else if next_type == TOK_LBRACE {
            inc_i64_at0(pos)
            expect(toks, pos, TOK_RBRACE)
        }
    } else {
        inc_i64_at0(pos)
    }
}

fn skip_top_level_let(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) {
    expect(toks, pos, TOK_LET)
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt { ret ok(0) }
    let name_start = tok_str_start_at(toks, pos[0])
    let name_len = tok_str_len_at(toks, pos[0])
    expect(toks, pos, TOK_IDENT)
    let decl_stype = TYPE_I64
    let decl_is_addr = 0
    if tok_type_at0(toks, pos) == TOK_COLON {
        pos[0] = pos[0] + 1
        let is_ptr = 0
        if tok_type_at0(toks, pos) == TOK_AMP {
            is_ptr = 1
            pos[0] = pos[0] + 1
        }
        let dt = tok_type_at0(toks, pos)
        if dt == TOK_I64 { decl_stype = TYPE_I64 }
        if dt == TOK_I32 { decl_stype = TYPE_I32 }
        if dt == TOK_I8  { decl_stype = TYPE_I8 }
        if dt == TOK_F64 { decl_stype = TYPE_F64 }
        if dt == TOK_IDENT {
            let type_start = tok_str_start_at(toks, pos[0])
            let type_len = tok_str_len_at(toks, pos[0])
            let sid = lookup_struct(stab, src, type_start, type_len)
            if sid >= 0 {
                decl_stype = sid
            } else {
                decl_stype = TYPE_PTR
            }
        }
        if is_ptr == 1 {
            decl_stype = ptr_of(decl_stype)
            decl_is_addr = 1
        }
        pos[0] = pos[0] + 1
    }
    expect(toks, pos, TOK_EQ)
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt { ret ok(0) }
    if g_glob_name_off == 0 { panic("Global table missing") }
    let gidx = g_glob_cnt
    if gidx >= 1024 { panic("Too many globals") }
    g_glob_name_off[gidx] = name_start
    g_glob_name_len[gidx] = name_len
    g_glob_off[gidx]      = g_glob_total_sz
    g_tmp_let_gidx = gidx
    g_tmp_let_stype = decl_stype
    g_tmp_let_is_addr = decl_is_addr
    skip_top_level_let_rhs(toks, pos, stab, src)
    let glob_sz = load_i64_at(g_glob_size, gidx)
    g_glob_total_sz = g_glob_total_sz + glob_sz
    g_glob_cnt = gidx + 1
}

fn panic(msg: &i8) {
    print("PANIC ")
    print(msg)
    print("\n")
    syscall(60, 1, 0, 0)
}

fn streq(src: &i8, start: i64, len: i64, kw: &i8) {
    let i = 0
    loop i < len {
        let a = src[start + i]
        let b = kw[i]
        if a != b { ret 0 }
        i = i + 1
    }
    let tail = kw[len]
    if tail != 0 { ret 0 }
    ret 1
}

fn str_match(src: &i8, s1: i64, s2: i64, len: i64) {
    let p1 = s1
    let p2 = s2
    let n = 0
    loop n < len {
        let a = load_i8_at(src, p1)
        let b = load_i8_at(src, p2)
        if a != b { ret 0 }
        p1 = p1 + 1
        p2 = p2 + 1
        n = n + 1
    }
    ret 1
}

; Check if character is backslash and process escape
; Returns: converted value if escape, or -1 if not escape
fn try_escape(c: i8, next_c: i8) {
    ; Check for backslash followed by escape char
    if c != 92 { ret -1 }  ; Not backslash
    if next_c == 110 { ret 10 }   ; \n -> newline
    if next_c == 116 { ret 9 }    ; \t -> tab
    if next_c == 92  { ret 92 }   ; \\ -> backslash
    if next_c == 34  { ret 34 }   ; \" -> quote
    ret -1  ; Unknown escape
}

; Type system helpers
fn is_pointer_type(t: i32) {
    if t >= TYPE_PTR_FLAG { ret 1 }
    ret 0
}

fn base_type(t: i32) {
    let b = t
    if b >= TYPE_PTR_FLAG {
        b = b - TYPE_PTR_FLAG
    }
    ret b
}

fn ptr_of(base: i32) {
    ret base + TYPE_PTR_FLAG
}

fn ok(x: i64) {
    ret x
}

fn lookup_const(src: &i8, name_start: i64, name_len: i64) {
    let i = 0
    loop i < g_const_cnt {
        let cur_len = g_const_name_len_tbl[i]
        let cur_val = g_const_val_tbl[i]
        if cur_len == name_len {
            let cur_off = g_const_name_off_tbl[i]
            let sm = str_match(src, cur_off, name_start, name_len)
            if sm == 1 {
                ret cur_val
            }
        }
        i = i + 1
    }
    ret -1
}

fn print_span(src: &i8, start: i64, len: i64) {
    if len <= 0 { ret 0 }
    syscall(1, 1, src + start, len)
}

fn live_codegen_expr_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    ret live_codegen_binop_inline(toks, pos, 0, stab, src, jfn, bb)
}

fn regalloc_free_old(ra: &RegAlloc, val_id: i64) {
    if val_id < 0 { ret ok(0) }
    if val_id >= 4096 { ret ok(0) }
    let idx = ra.val2reg[val_id]
    if idx == -1 { ret ok(0) }
    if idx < 0 { ret ok(0) }
    if idx >= 8 { ret ok(0) }
    ra.reg2val[idx]    = -1
    ra.val2reg[val_id] = -1
}

fn is_alpha(c: i8) {
    if c >= 97 and c <= 122 { ret 1 }
    if c >= 65 and c <= 90 { ret 1 }
    ret 0
}

fn is_digit(c: i8) {
    ret c >= 48 and c <= 57
}

fn is_space_char(c: i8) {
    if c == 32 { ret 1 }
    if c == 9 { ret 1 }
    if c == 10 { ret 1 }
    if c == 13 { ret 1 }
    ret 0
}

fn is_ident_continue(c: i8) {
    if is_alpha(c) == 1 { ret 1 }
    if is_digit(c) == 1 { ret 1 }
    if c == 95 { ret 1 }
    ret 0
}

fn is_ident_start(c: i8) {
    if is_alpha(c) == 1 { ret 1 }
    if c == 95 { ret 1 }
    ret 0
}

fn char_to_tok_lo(c: i8) {
    ret TOK_EOF
}

fn char_to_tok_mid(c: i8) {
    ret TOK_EOF
}

fn char_to_tok_hi(c: i8) {
    ret TOK_EOF
}

fn char_to_tok(c: i8) {
    if c == 38 { ret TOK_AMP }
    if c == 40 { ret TOK_LPAREN }
    if c == 41 { ret TOK_RPAREN }
    if c == 42 { ret TOK_STAR }
    if c == 43 { ret TOK_PLUS }
    if c == 44 { ret TOK_COMMA }
    if c == 45 { ret TOK_MINUS }
    if c == 46 { ret TOK_DOT }
    if c == 47 { ret TOK_SLASH }
    if c == 58 { ret TOK_COLON }
    if c == 60 { ret TOK_LT }
    if c == 61 { ret TOK_EQ }
    if c == 62 { ret TOK_GT }
    if c == 91 { ret TOK_LBRACK }
    if c == 93 { ret TOK_RBRACK }
    if c == 123 { ret TOK_LBRACE }
    if c == 124 { ret TOK_PIPE }
    if c == 125 { ret TOK_RBRACE }
    if c == 126 { ret TOK_TILDE }
    ret TOK_EOF
}

fn classify_keyword_len2(src: &i8, start: i64, len: i64) {
    if src[start] == 102 and src[start + 1] == 110 { ret TOK_FN }
    if src[start] == 105 and src[start + 1] == 102 { ret TOK_IF }
    if src[start] == 111 and src[start + 1] == 114 { ret TOK_OR }
    if src[start] == 105 and src[start + 1] == 56 { ret TOK_I8 }
    ret TOK_IDENT
}

fn classify_keyword_len3(src: &i8, start: i64, len: i64) {
    if src[start] == 108 and src[start + 1] == 101 and src[start + 2] == 116 { ret TOK_LET }
    if src[start] == 114 and src[start + 1] == 101 and src[start + 2] == 116 { ret TOK_RET }
    if src[start] == 97 and src[start + 1] == 110 and src[start + 2] == 100 { ret TOK_AND }
    if src[start] == 105 and src[start + 1] == 54 and src[start + 2] == 52 { ret TOK_I64 }
    if src[start] == 105 and src[start + 1] == 51 and src[start + 2] == 50 { ret TOK_I32 }
    if src[start] == 102 and src[start + 1] == 54 and src[start + 2] == 52 { ret TOK_F64 }
    ret TOK_IDENT
}

fn classify_keyword_len4(src: &i8, start: i64, len: i64) {
    if src[start] == 101 and src[start + 1] == 108 and src[start + 2] == 115 and src[start + 3] == 101 { ret TOK_ELSE }
    if src[start] == 108 and src[start + 1] == 111 and src[start + 2] == 111 and src[start + 3] == 112 { ret TOK_LOOP }
    ret TOK_IDENT
}

fn classify_keyword_len5(src: &i8, start: i64, len: i64) {
    if src[start] == 109 and src[start + 1] == 97 and src[start + 2] == 116 and src[start + 3] == 99 and src[start + 4] == 104 { ret TOK_MATCH }
    if src[start] == 112 and src[start + 1] == 114 and src[start + 2] == 105 and src[start + 3] == 110 and src[start + 4] == 116 { ret TOK_PRINT }
    if src[start] == 99 and src[start + 1] == 111 and src[start + 2] == 110 and src[start + 3] == 115 and src[start + 4] == 116 { ret TOK_CONST }
    ret TOK_IDENT
}

fn classify_keyword_len6(src: &i8, start: i64, len: i64) {
    if src[start] == 115 and src[start + 1] == 116 and src[start + 2] == 114 and src[start + 3] == 117 and src[start + 4] == 99 and src[start + 5] == 116 { ret TOK_STRUCT }
    ret TOK_IDENT
}

fn classify_keyword_len7(src: &i8, start: i64, len: i64) {
    if src[start] == 115 and src[start + 1] == 121 and src[start + 2] == 115 and src[start + 3] == 99 and src[start + 4] == 97 and src[start + 5] == 108 and src[start + 6] == 108 { ret TOK_SYSCALL }
    ret TOK_IDENT
}

fn classify_keyword(src: &i8, start: i64, len: i64) {
    if len == 2 {
        if src[start] == 102 and src[start + 1] == 110 { ret TOK_FN }
        if src[start] == 105 and src[start + 1] == 102 { ret TOK_IF }
        if src[start] == 111 and src[start + 1] == 114 { ret TOK_OR }
        if src[start] == 105 and src[start + 1] == 56 { ret TOK_I8 }
        ret TOK_IDENT
    }
    if len == 3 { ret classify_keyword_len3(src, start, len) }
    if len == 4 { ret classify_keyword_len4(src, start, len) }
    if len == 5 { ret classify_keyword_len5(src, start, len) }
    if len == 6 { ret classify_keyword_len6(src, start, len) }
    if len == 7 { ret classify_keyword_len7(src, start, len) }
    ret TOK_IDENT
}

fn emit_lex_tok(out_toks: &Token, count: &i64, tok: i32) {
    if count[0] >= 131071 { panic("Token buffer overflow") }
    let idx = load_i64_at0(count)
    out_toks[idx].type = tok
    inc_i64_at0(count)
}

fn lex_handle_minus(pos: &i64) {
    let next = load_i64_at0(pos)
    if next + 1 < g_lex_src_len {
        let nxt = load_i8_at(g_lex_src_ptr, next + 1)
        if nxt == 62 {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = TOK_ARROW
            g_lex_count = g_lex_count + 1
            inc_i64_at0_twice(pos)
        } else {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = char_to_tok(45)
            g_lex_count = g_lex_count + 1
            inc_i64_at0(pos)
        }
    } else {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = char_to_tok(45)
        g_lex_count = g_lex_count + 1
        inc_i64_at0(pos)
    }
}

fn lex_handle_eq(pos: &i64) {
    let next = load_i64_at0(pos)
    if next + 1 < g_lex_src_len {
        let nxt = load_i8_at(g_lex_src_ptr, next + 1)
        if nxt == 61 {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = TOK_EQEQ
            g_lex_count = g_lex_count + 1
            inc_i64_at0_twice(pos)
            ret
        }
        if nxt == 62 {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = TOK_FATARROW
            g_lex_count = g_lex_count + 1
            inc_i64_at0_twice(pos)
            ret
        }
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = char_to_tok(61)
        g_lex_count = g_lex_count + 1
        inc_i64_at0(pos)
        ret
    }
    if g_lex_count >= 131071 { panic("Token buffer overflow") }
    g_lex_out_toks[g_lex_count].type = char_to_tok(61)
    g_lex_count = g_lex_count + 1
    inc_i64_at0(pos)
}

fn lex_handle_bang(pos: &i64) {
    let next = load_i64_at0(pos)
    if next + 1 < g_lex_src_len {
        let nxt = load_i8_at(g_lex_src_ptr, next + 1)
        if nxt == 61 {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = TOK_NEQ
            g_lex_count = g_lex_count + 1
            inc_i64_at0_twice(pos)
        } else {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = char_to_tok(33)
            g_lex_count = g_lex_count + 1
            inc_i64_at0(pos)
        }
    } else {
        if g_lex_count >= 131071 { panic("Token buffer overflow") }
        g_lex_out_toks[g_lex_count].type = char_to_tok(33)
        g_lex_count = g_lex_count + 1
        inc_i64_at0(pos)
    }
}

fn lex_try_space_or_comment(src: &i8, src_len: i64, c: i8) -> i64 {
    if is_space_char(c) == 1 {
        g_lex_pos_i = g_lex_pos_i + 1
        ret 1
    }
    if c != 59 { ret 0 }
    g_lex_pos_i = g_lex_pos_i + 1
    let keep_comment = 1
    loop keep_comment == 1 {
        if g_lex_pos_i >= src_len {
            keep_comment = 0
        } else if src[g_lex_pos_i] != 10 {
            g_lex_pos_i = g_lex_pos_i + 1
        } else {
            keep_comment = 0
        }
    }
    ret 1
}

fn lex_try_string(c: i8) -> i64 {
    if c != 34 { ret 0 }
    lex_mark_string_start()
    lex_skip_string_body()
    lex_emit_marked_string()
    if g_lex_pos_i < g_lex_src_len {
        lex_inc_pos_i()
    }
    ret 1
}

fn lex_try_int(c: i8) -> i64 {
    if is_digit(c) == 0 { ret 0 }
    let val = lex_scan_int(&g_lex_pos_i)
    let out_idx = g_lex_count
    if out_idx >= 131071 { panic("Token buffer overflow") }
    g_lex_out_toks[out_idx].type = TOK_INT
    g_lex_out_toks[out_idx].imm = val
    g_lex_count = g_lex_count + 1
    ret 1
}

fn lex_try_ident(src: &i8, src_len: i64, c: i8) -> i64 {
    if is_ident_start(c) == 0 { ret 0 }
    lex_emit_ident_or_kw(src, src_len, &g_lex_pos_i)
    ret 1
}

fn lex_try_op(c: i8) -> i64 {
    if c == 45 {
        lex_handle_minus(&g_lex_pos_i)
        ret 1
    }
    if c == 61 {
        lex_handle_eq(&g_lex_pos_i)
        ret 1
    }
    if c == 33 {
        lex_handle_bang(&g_lex_pos_i)
        ret 1
    }
    if c == 62 {
        let next = g_lex_pos_i
        if next + 1 < g_lex_src_len {
            lex_handle_gt_next(&g_lex_pos_i)
        } else {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = char_to_tok(62)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + 1
        }
        ret 1
    }
    if c == 60 {
        let next = g_lex_pos_i
        if next + 1 < g_lex_src_len {
            lex_handle_lt_next(&g_lex_pos_i)
        } else {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = char_to_tok(60)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + 1
        }
        ret 1
    }
    ret 0
}

fn lex(src: &i8, src_len: i64) -> i32 {
    g_lex_pos_i = 0
    g_lex_count = 0
    g_lex_src_len = src_len
    g_lex_src_ptr = src
    let p_local = g_lex_pos_i
    let l_local = src_len
    loop p_local < l_local {
        g_lex_pos_i = p_local
        let c = src[p_local]
        if lex_try_space_or_comment(src, l_local, c) == 1 {
        } else if lex_try_string(c) == 1 {
        } else if lex_try_int(c) == 1 {
        } else if lex_try_ident(src, l_local, c) == 1 {
        } else if lex_try_op(c) == 1 {
        } else {
            if g_lex_count >= 131071 { panic("Token buffer overflow") }
            g_lex_out_toks[g_lex_count].type = char_to_tok(c)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + 1
        }
        p_local = g_lex_pos_i
    }
    if g_lex_count >= 131071 { panic("Token buffer overflow") }
    g_lex_out_toks[g_lex_count].type = TOK_EOF
    ret g_lex_count
}

; Post-lex pass: convert character literal token triples to TOK_INT
; jda1 lexer doesn't handle single quotes, so 'X' becomes 3 tokens:
;   TOK_EOF (quote), TOK_IDENT or TOK_INT (char), TOK_EOF (quote)
; This function merges those triples into a single TOK_INT with ASCII value
fn fix_char_literals(src: &i8, toks: &Token, cnt: &i64) {
    ret ok(0)
}

; ============================================================
; 3. PARSER HELPERS
; ============================================================

fn expect(toks: &Token, pos: &i64, expected: i32) {
    if pos == 0 { panic("expect pos is null") }
    let idx = pos[0]
    if idx >= g_dbg_tok_cnt {
        pos[0] = g_dbg_tok_cnt
        ret
    }
    let t = tok_type_at(toks, idx)
    if t != expected {
        if t == TOK_EOF { ret }
    }
    pos[0] = idx + 1
}

; Safe lookahead: returns token type at pos+1, or TOK_EOF if invalid
fn peek_token(toks: &Token, pos: i64) -> i32 {
    let next_t = tok_type_at(toks, pos + 1)
    if next_t == TOK_EOF {
        ret TOK_EOF
    }
    ret next_t
}

fn find_matching_rbrace(toks: &Token, lbrace_idx: i64) -> i64 {
    if lbrace_idx < 0 { ret -1 }
    if lbrace_idx >= g_dbg_tok_cnt { ret -1 }
    if tok_type_at(toks, lbrace_idx) != TOK_LBRACE { ret -1 }
    let i = lbrace_idx
    let depth = 0
    loop i < g_dbg_tok_cnt {
        let tt = tok_type_at(toks, i)
        if tt == TOK_EOF { ret -1 }
        if tt == TOK_LBRACE { depth = depth + 1 }
        if tt == TOK_RBRACE {
            depth = depth - 1
            if depth == 0 { ret i }
        }
        i = i + 1
    }
    ret -1
}

fn find_fn_lbrace_from_fn(toks: &Token, fn_idx: i64) -> i64 {
    if fn_idx < 0 { ret -1 }
    if fn_idx >= g_dbg_tok_cnt { ret -1 }
    let i = fn_idx
    loop i < g_dbg_tok_cnt {
        let tt = tok_type_at(toks, i)
        if tt == TOK_LBRACE { ret i }
        if tt == TOK_SEMI { ret -1 }
        if tt == TOK_EOF { ret -1 }
        i = i + 1
    }
    ret -1
}

fn find_fn_end_from_fn(toks: &Token, fn_idx: i64) -> i64 {
    if fn_idx < 0 { ret -1 }
    if fn_idx >= g_dbg_tok_cnt { ret -1 }
    let lb = find_fn_lbrace_from_fn(toks, fn_idx)
    if lb >= 0 {
        ret find_matching_rbrace(toks, lb)
    }
    let i = fn_idx
    loop i < g_dbg_tok_cnt {
        let tt = tok_type_at(toks, i)
        if tt == TOK_SEMI { ret i }
        if tt == TOK_EOF { ret i }
        i = i + 1
    }
    ret -1
}

fn is_main_fn_src(src: &i8, src_len: i64, fn_start: i64) -> i64 {
    if fn_start < 0 { ret 0 }
    if fn_start + 1 >= src_len { ret 0 }
    if src[fn_start] != 102 { ret 0 }     ; f
    if src[fn_start + 1] != 110 { ret 0 } ; n
    let i = fn_start + 2
    loop i < src_len and is_space_char(src[i]) == 1 {
        i = i + 1
    }
    if i + 3 >= src_len { ret 0 }
    if src[i] == 109 and src[i+1] == 97 and src[i+2] == 105 and src[i+3] == 110 {
        print("FOUND main src\n")
        ret 1
    }
    ret 0
}

fn should_skip_old_fn_short(src: &i8, name_off: i64, name_len: i64) -> i64 {
    ret 0
}

fn should_skip_old_fn_long_a(src: &i8, name_off: i64, name_len: i64) -> i64 {
    ret 0
}

fn should_skip_old_fn_long_b(src: &i8, name_off: i64, name_len: i64) -> i64 {
    ret 0
}

fn should_skip_old_fn_long(src: &i8, name_off: i64, name_len: i64) -> i64 {
    if should_skip_old_fn_long_a(src, name_off, name_len) == 1 { ret 1 }
    if should_skip_old_fn_long_b(src, name_off, name_len) == 1 { ret 1 }
    ret 0
}

fn should_skip_old_fn(src: &i8, name_off: i64, name_len: i64, fi: i64) -> i64 {
    if fi < 0 { ret 0 }
    if should_skip_old_fn_short(src, name_off, name_len) == 1 { ret 1 }
    if should_skip_old_fn_long(src, name_off, name_len) == 1 { ret 1 }
    ret 0
}

fn parse_type(toks: &Token, pos: &i64) -> i32 {
    let idx = load_i64_at0(pos)
    let t = tok_type_at(toks, idx)
    if t == TOK_AMP {
        let idx1 = idx + 1
        let t1 = tok_type_at(toks, idx1)
        pos[0] = idx + 2
        if t1 == TOK_I64   { ret TYPE_PTR_I64 }
        if t1 == TOK_I32   { ret TYPE_PTR_I32 }
        if t1 == TOK_I8    { ret TYPE_PTR_I8 }
        if t1 == TOK_F64   { ret ptr_of(TYPE_F64) }
        if t1 == TOK_IDENT { ret ptr_of(TYPE_PTR) }
        ret ptr_of(TYPE_VOID)
    }
    pos[0] = idx + 1
    if t == TOK_I64   { ret TYPE_I64 }
    if t == TOK_I32   { ret TYPE_I32 }
    if t == TOK_I8    { ret TYPE_I8 }
    if t == TOK_F64   { ret TYPE_F64 }
    if t == TOK_IDENT { ret TYPE_PTR }
    ret TYPE_VOID
}

fn lookup_struct(stab: &StructTable, src: &i8, ns: i64, nl: i64) -> i64 {
    let si = 0
    loop si < stab.cnt {
        if stab.nlens[si] == nl {
            if str_match(src, ns, stab.names[si], nl) == 1 { ret si }
        }
        si = si + 1
    }
    ret -1
}

fn lookup_top_fn(fn_name_off: &i64, fn_name_len: &i64, fn_cnt: i64, src: &i8, name: &i8, name_len: i64) -> i64 {
    let i = 0
    loop i < fn_cnt {
        if fn_name_len[i] == name_len {
            if streq(src, fn_name_off[i], name_len, name) == 1 {
                ret i
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_struct_kw(stab: &StructTable, src: &i8, kw: &i8, kw_len: i64) -> i64 {
    let si = 0
    loop si < stab.cnt {
        if stab.nlens[si] == kw_len {
            let i = 0
            let ok = 1
            loop i < kw_len {
                let name_i = stab.names[si] + i
                let a = load_i8_at(src, name_i)
                let b = load_i8_at(kw, i)
                if a != b { ok = 0 }
                i = i + 1
            }
            if ok == 1 { ret si }
        }
        si = si + 1
    }
    ret -1
}

fn lookup_field_off(stab: &StructTable, src: &i8, sid: i64, fs: i64, fl: i64) -> i64 {
    let base = stab.fbases[sid]
    let cnt  = stab.fcnts[sid]
    let i = 0
    loop i < cnt {
        let fi = base + i
        if stab.flens[fi] == fl {
            if str_match(src, fs, stab.fnames[fi], fl) == 1 {
                ret stab.foffs[fi]
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_field_off_any(stab: &StructTable, src: &i8, sid: i64, fs: i64, fl: i64) -> i64 {
    let i = 0
    loop i < stab.field_cnt {
        if stab.fowners[i] == sid {
            if stab.flens[i] == fl {
                if str_match(src, fs, stab.fnames[i], fl) == 1 {
                    ret stab.foffs[i]
                }
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_field_idx_any(stab: &StructTable, src: &i8, sid: i64, fs: i64, fl: i64) -> i64 {
    let i = 0
    loop i < stab.field_cnt {
        if stab.fowners[i] == sid {
            if stab.flens[i] == fl {
                if str_match(src, fs, stab.fnames[i], fl) == 1 {
                    ret i
                }
            }
        }
        i = i + 1
    }
    ret -1
}

fn span_eq_kw(src: &i8, src_start: i64, kw: &i8, kw_len: i64) -> i64 {
    let j = 0
    loop j < kw_len {
        let si = src_start + j
        let a = load_i8_at(src, si)
        let b = load_i8_at(kw, j)
        if a != b { ret 0 }
        j = j + 1
    }
    ret 1
}

fn lookup_field_idx_kw(stab: &StructTable, src: &i8, sid: i64, kw: &i8, kw_len: i64) -> i64 {
    let i = 0
    loop i < stab.field_cnt {
        if stab.fowners[i] == sid {
            if stab.flens[i] == kw_len {
                let fn_start = stab.fnames[i]
                if span_eq_kw(src, fn_start, kw, kw_len) == 1 {
                    ret i
                }
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_global(name_start: i64, name_len: i64, src: &i8) -> i64 {
    if g_glob_name_off == 0 { ret -1 }
    let i = 0
    loop i < g_glob_cnt {
        let glen = g_glob_name_len[i]
        if glen == name_len {
            let goff = g_glob_name_off[i]
            let ok = str_match(src, name_start, goff, name_len)
            if ok == 1 {
                ret i
            }
        }
        i = i + 1
    }
    ret -1
}

fn dump_globals(src: &i8) {
    print("GLOB DUMP\n")
}

fn lookup_global2(name_start: i64, name_len: i64, src: &i8) -> i64 {
    if g_glob_name_off == 0 { ret -1 }
    let i = 0
    loop i < g_glob_cnt {
        let glen = g_glob_name_len[i]
        if glen == name_len {
            let goff = g_glob_name_off[i]
            let sm_res = str_match(src, name_start, goff, name_len)
            if sm_res == 0 {
                print("LG2 MISS [")
                syscall(1, 1, src + name_start, name_len)
                print("] vs [")
                syscall(1, 1, src + goff, glen)
                print("]\n")
            }
            if sm_res == 1 {
                ret i
            }
        }
        i = i + 1
    }
    ret -1
}

fn stab_set_struct_head(stab: &StructTable, sid: i64, st_name_start: i64, st_name_len: i64, base: i64) {
    stab.names[sid]  = st_name_start
    stab.nlens[sid]  = st_name_len
    stab.fbases[sid] = base
}

fn stab_set_struct_tail(stab: &StructTable, sid: i64, fcnt: i64, off: i64, base: i64) {
    stab.fcnts[sid] = fcnt
    stab.sizes[sid] = off
    stab.cnt = sid + 1
    stab.field_cnt = base + fcnt
}

fn parse_struct_decl(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) {
    ; Check if this is actually a struct declaration
    if tok_type_at0(toks, pos) != TOK_STRUCT {
        ret
    }
    let st_name_start = tok_str_start_at(toks, pos[0] + 1)
    let st_name_len = tok_str_len_at(toks, pos[0] + 1)
    expect(toks, pos, TOK_STRUCT)
    expect(toks, pos, TOK_IDENT)
    expect(toks, pos, TOK_LBRACE)

    let sid = stab.cnt
    let base = stab.field_cnt
    stab_set_struct_head(stab, sid, st_name_start, st_name_len, base)

    let fcnt = 0
    let off  = 0
    loop tok_type_at0(toks, pos) != TOK_RBRACE and tok_type_at0(toks, pos) != TOK_EOF {
        let fname_start = tok_str_start_at(toks, pos[0])
        let fname_len = tok_str_len_at(toks, pos[0])
        expect(toks, pos, TOK_IDENT)
        expect(toks, pos, TOK_COLON)
        let field_t = TYPE_I64
        let arr = 0
        let type_is_ptr = 0
        if tok_type_at0(toks, pos) == TOK_AMP {
            type_is_ptr = 1
            pos[0] = pos[0] + 1
        }
        let type_idx = pos[0]
        let type_tok_type = tok_type_at(toks, type_idx)
        let type_tok_start = tok_str_start_at(toks, type_idx)
        let type_tok_len = tok_str_len_at(toks, type_idx)
        if type_tok_type == TOK_I64 { field_t = TYPE_I64 }
        if type_tok_type == TOK_I32 { field_t = TYPE_I32 }
        if type_tok_type == TOK_I8  { field_t = TYPE_I8 }
        if type_tok_type == TOK_F64 { field_t = TYPE_F64 }
        if type_tok_type == TOK_IDENT {
            let sid2 = lookup_struct(stab, src, type_tok_start, type_tok_len)
            if sid2 >= 0 { field_t = sid2 }
        }
        if type_is_ptr == 1 {
            field_t = ptr_of(field_t)
        }
        pos[0] = pos[0] + 1
        if tok_type_at0(toks, pos) == TOK_LBRACK {
            arr = 1
            pos[0] = pos[0] + 1
            pos[0] = pos[0] + 1
            expect(toks, pos, TOK_RBRACK)
        }
        let fi = base + fcnt
        stab.fnames[fi]   = fname_start
        stab.flens[fi]    = fname_len
        stab.foffs[fi]    = off
        stab.ftypes[fi]   = field_t
        stab.fis_array[fi]= arr
        stab.fowners[fi]  = sid
        off = off + 8
        fcnt = fcnt + 1
    }
    expect(toks, pos, TOK_RBRACE)
    stab_set_struct_tail(stab, sid, fcnt, off, base)
}

fn parse_expr_stmt(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    ; Fast path for direct field store: base[optional_idx].field = rhs
    let save = pos[0]
    if toks[pos[0]].type == TOK_IDENT {
        let base = toks[pos[0]]
        pos[0] = pos[0] + 1
        let idx = Node{}
        let has_idx = 0
        let idx_kind = 0
        let idx_start = 0
        let idx_len = 0
        let idx_imm = 0
        if toks[pos[0]].type == TOK_LBRACK {
            pos[0] = pos[0] + 1
            if toks[pos[0]].type == TOK_IDENT and peek_token(toks, pos[0]) == TOK_RBRACK {
                idx_kind = 1
                idx_start = toks[pos[0]].str_start
                idx_len   = toks[pos[0]].str_len
                pos[0] = pos[0] + 1
            } else if toks[pos[0]].type == TOK_INT and peek_token(toks, pos[0]) == TOK_RBRACK {
                idx_kind = 3
                idx_imm = toks[pos[0]].imm
                pos[0] = pos[0] + 1
            } else {
                idx = parse_expr(toks, pos, stab, src)
                idx_kind = 2
            }
            expect(toks, pos, TOK_RBRACK)
            has_idx = 1
        }
        if toks[pos[0]].type == TOK_DOT {
            pos[0] = pos[0] + 1
            let field = toks[pos[0]]
            expect(toks, pos, TOK_IDENT)
            ; Handle base.field[idx] = value (array-indexed field store)
            if toks[pos[0]].type == TOK_LBRACK {
                pos[0] = pos[0] + 1
                let fidx_kind = 0
                let fidx_start = 0
                let fidx_len = 0
                let fidx_imm = 0
                let fidx_node = Node{}
                if toks[pos[0]].type == TOK_IDENT and peek_token(toks, pos[0]) == TOK_RBRACK {
                    fidx_kind = 1
                    fidx_start = toks[pos[0]].str_start
                    fidx_len   = toks[pos[0]].str_len
                    pos[0] = pos[0] + 1
                } else if toks[pos[0]].type == TOK_INT and peek_token(toks, pos[0]) == TOK_RBRACK {
                    fidx_kind = 3
                    fidx_imm = toks[pos[0]].imm
                    pos[0] = pos[0] + 1
                } else {
                    fidx_node = parse_expr(toks, pos, stab, src)
                    fidx_kind = 2
                }
                expect(toks, pos, TOK_RBRACK)
                if toks[pos[0]].type == TOK_EQ {
                    pos[0] = pos[0] + 1
                    let rhs = parse_expr(toks, pos, stab, src)
                    let n = Node{}
                    n.node_type = NODE_FIELD_STORE
                    n.data_type = 10  ; base.field[idx] store
                    n.token = base.str_start
                    n.child_cnt = base.str_len
                    n.token2 = field.str_start
                    n.imm = field.str_len
                    n.children = fidx_kind
                    if fidx_kind == 1 {
                        n.child2 = fidx_start
                        n.child3 = fidx_len
                    }
                    if fidx_kind == 3 {
                        n.child2 = fidx_imm
                        n.child3 = 0
                    }
                    if fidx_kind == 2 {
                        n.child0 = fidx_node
                    }
                    n.child1 = rhs
                    ret n
                }
                pos[0] = save
            }
            if toks[pos[0]].type == TOK_EQ {
                pos[0] = pos[0] + 1
                let rhs_tok = toks[pos[0]]
                let n = Node{}
                n.node_type = NODE_FIELD_STORE
                n.token = base.str_start
                n.child_cnt = base.str_len
                n.token2 = field.str_start
                n.imm = field.str_len
                n.op = 4  ; Mark as array index access
                n.data_type = idx_kind
                ; Store type info from array allocation
                n.token = base.str_start
                n.child_cnt = base.str_len
                if idx_kind == 1 {
                    n.child2 = idx_start
                    n.child3 = idx_len
                } else if idx_kind == 3 {
                    n.child2 = idx_imm
                    n.child3 = 0
                } else {
                    n.child0 = idx
                }
                if idx_kind != 3 {
                    ; stable rhs encoding: rhs is indexed field read (base[idx].field), ident index
                    if rhs_tok.type == TOK_IDENT and
                       peek_token(toks, pos[0]) == TOK_LBRACK and
                       toks[pos[0] + 2].type == TOK_IDENT and
                       toks[pos[0] + 3].type == TOK_RBRACK and
                       toks[pos[0] + 4].type == TOK_DOT and
                       toks[pos[0] + 5].type == TOK_IDENT {
                        let ridx = toks[pos[0] + 2]
                        let rf   = toks[pos[0] + 5]
                        n.op = 6
                        n.children = rhs_tok.str_start
                        n.param_cnt = rhs_tok.str_len
                        n.child2 = ridx.str_start
                        n.child3 = ridx.str_len
                        n.child1 = rf.str_start
                        n.ret_type = rf.str_len
                        pos[0] = pos[0] + 6
                        ret n
                    }
                    ; stable rhs encoding: rhs is direct field read (base.field)
                    if rhs_tok.type == TOK_IDENT and
                       peek_token(toks, pos[0]) == TOK_DOT and
                       toks[pos[0] + 2].type == TOK_IDENT {
                        let rf = toks[pos[0] + 2]
                        n.op = 5
                        n.children = rhs_tok.str_start
                        n.param_cnt = rhs_tok.str_len
                        n.child3 = rf.str_start
                        n.ret_type = rf.str_len
                        pos[0] = pos[0] + 3
                        ret n
                    }
                    let rpeeked = peek_token(toks, pos[0])
                    if rhs_tok.type == TOK_IDENT and
                       rpeeked != TOK_DOT and
                       rpeeked != TOK_LBRACK and
                       rpeeked != TOK_LPAREN and
                       op_precedence(rpeeked) < 0 {
                        ; stable rhs encoding: store identifier name on node itself
                        pos[0] = pos[0] + 1
                        n.op = 3
                        n.children = rhs_tok.str_start
                        n.param_cnt = rhs_tok.str_len
                        ret n
                    }
                } else {
                    if rhs_tok.type == TOK_INT {
                        pos[0] = pos[0] + 1
                        n.op = 4
                        n.ret_type = rhs_tok.imm
                        ret n
                    }
                    let rpeeked2 = peek_token(toks, pos[0])
                    if rhs_tok.type == TOK_IDENT and
                       rpeeked2 != TOK_DOT and
                       rpeeked2 != TOK_LBRACK and
                       rpeeked2 != TOK_LPAREN and
                       op_precedence(rpeeked2) < 0 {
                        pos[0] = pos[0] + 1
                        n.op = 3
                        n.children = rhs_tok.str_start
                        n.param_cnt = rhs_tok.str_len
                        ret n
                    }
                }
                let rhs = parse_expr(toks, pos, stab, src)
                n.child1 = rhs
                ret n
            }
        }
        if has_idx == 1 and toks[pos[0]].type == TOK_EQ {
            pos[0] = pos[0] + 1
            let rhs = parse_expr(toks, pos, stab, src)
            let n = Node{}
            n.node_type = NODE_INDEX_STORE
            n.token = base.str_start
            n.child_cnt = base.str_len
            n.op = idx_kind
            n.child0 = null
            if idx_kind == 1 {
                n.child2 = idx_start
                n.child3 = idx_len
            }
            if idx_kind == 2 {
                n.child0 = idx
            }
            if idx_kind == 3 {
                n.children = idx_imm
            }
            n.child1 = rhs
            ret n
        }
    }
    pos[0] = save

    let lhs = parse_expr(toks, pos, stab, src)
    if toks[pos[0]].type == TOK_EQ {
        pos[0] = pos[0] + 1
        let rhs = parse_expr(toks, pos, stab, src)
        if lhs.node_type == NODE_FIELD {
            let n = Node{}
            n.node_type = NODE_FIELD_STORE
            n.token     = lhs.token
            n.child_cnt = lhs.child_cnt
            n.token2    = lhs.token2
            n.imm       = lhs.imm
            n.data_type = lhs.op
            n.child0    = null
            if lhs.op == 1 {
                n.child2 = lhs.children
                n.child3 = lhs.param_cnt
            }
            if lhs.op == 2 {
                n.child0 = lhs.child0
            }
            if lhs.op == 3 {
                n.children = lhs.children
            }
            n.child1    = rhs
            ret n
        }
        if lhs.node_type == NODE_IDENT {
            let n = Node{}
            n.node_type = NODE_LET
            n.op        = 1
            ; base.str_start/str_len are in parse_expr_stmt's own frame (stable, not dangling)
            n.token     = lhs.token.str_start
            n.token2    = lhs.token.str_len
            n.child0    = rhs
            ret n
        }
        if lhs.node_type == NODE_BINOP and lhs.op == TOK_LBRACK {
            let n = Node{}
            n.node_type = NODE_INDEX_STORE
            n.child0 = lhs.child0
            n.child2 = lhs.child1
            n.child1 = rhs
            n.op = 2
            ret n
        }
        print("Parse error: invalid assignment target\n")
    }
    ret lhs
}

; ============================================================
; 4. PARSER
; ============================================================

fn parse_fn(toks: &Token, pos: &i64, jfn: &JirFunction, stab: &StructTable, src: &i8) -> i32 {
    expect(toks, pos, TOK_FN)
    let name_tok = toks[pos[0]]
    expect(toks, pos, TOK_IDENT)
    expect(toks, pos, TOK_LPAREN)

    let params  = Node[16]
    let param_cnt = 0
    loop toks[pos[0]].type != TOK_RPAREN {
        let p_name = toks[pos[0]]
        expect(toks, pos, TOK_IDENT)
        expect(toks, pos, TOK_COLON)
        ; Check what type is being declared (before advancing)
        let p_type_pos = pos[0]
        if toks[pos[0]].type == TOK_AMP {
            p_type_pos = pos[0] + 1  ; Skip the & to get to the actual type
        }
        let p_type_tok = toks[p_type_pos]
        let p_type = parse_type(toks, pos)
        let p_sid = -1
        if p_type_tok.type == TOK_IDENT {
            p_sid = lookup_struct(stab, src, p_type_tok.str_start, p_type_tok.str_len)
        }
        params[param_cnt].node_type = NODE_IDENT
        params[param_cnt].token     = p_name.str_start
        params[param_cnt].token2    = p_name.str_len
        params[param_cnt].data_type = p_sid
        if p_sid == -1 {
            params[param_cnt].data_type = p_type
        }
        param_cnt = param_cnt + 1
        if toks[pos[0]].type == TOK_COMMA {
            pos[0] = pos[0] + 1
        }
    }
    expect(toks, pos, TOK_RPAREN)

    let ret_type = TYPE_VOID
    if toks[pos[0]].type == TOK_ARROW {
        pos[0] = pos[0] + 1
        ret_type = parse_type(toks, pos)
    }

    ; Emit this function immediately to avoid fragile AST lifetimes.
    jfn.var_cnt       = 0
    jfn.next_slot_off = 0
    jfn.param_cnt     = param_cnt
    let pi = 0
    loop pi < param_cnt {
        let ptok = Token{}
        ptok.str_start = params[pi].token
        ptok.str_len   = params[pi].token2
        let pslot = bind(jfn, ptok, params[pi].data_type)
        jfn.param_slots[pi] = pslot
        pi = pi + 1
    }

    expect(toks, pos, TOK_LBRACE)
    let cur_bb = create_block_live(jfn)
    ; Use compile_stmts_inline which handles if/loop via compile_if_inline/compile_loop_inline.
    ; This avoids the AST dangling-pointer issue with parse_if/parse_loop stubs.
    cur_bb = compile_stmts_inline(toks, pos, stab, src, jfn, cur_bb)
    expect(toks, pos, TOK_RBRACE)
    ret ok(0)
}

; CRITICAL FIX: Global arena for block statements to avoid use-after-free
; parse_block() was storing pointers to stack-allocated Node arrays,
; causing segfaults when codegen_block() accessed them later.
; Solution: Use a persistent global arena with proper bounds checking.
let block_stmt_arena = Node[4096]
let block_arena_pos = 0

; Global buffers for parse_let RHS nodes.
; parse_let sets n.child0 = val (a stack local), which dangles after return.
; By copying val into a global, n.child0 points to stable memory.
let g_let_val_buf = Node{}
let g_let_cnt_buf = Node{}

; Global buffer for complex index expressions in parse_primary (idx_kind=2).
; When arr[expr].field is parsed, fn.child0=idx (stack local) would dangle.
let g_parse_idx_buf = Node{}

; Global args buffer for parse_call_rest. Avoids dangling stack pointer in n.children.
let g_call_args = Node[16]

fn parse_block(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> &Node {
    expect(toks, pos, TOK_LBRACE)
    let start_pos = block_arena_pos
    let cnt = 0
    loop toks[pos[0]].type != TOK_RBRACE and toks[pos[0]].type != TOK_EOF {
        if block_arena_pos >= 4096 {
            ret block_stmt_arena
        }
        let st_t = toks[pos[0]].type
        if st_t == TOK_LET {
            block_stmt_arena[block_arena_pos] = parse_let(toks, pos, stab, src)
        } else if st_t == TOK_IF {
            block_stmt_arena[block_arena_pos] = parse_if(toks, pos, stab, src)
        } else if st_t == TOK_LOOP {
            block_stmt_arena[block_arena_pos] = parse_loop(toks, pos, stab, src)
        } else if st_t == TOK_RET {
            block_stmt_arena[block_arena_pos] = parse_ret(toks, pos, stab, src)
        } else if st_t == TOK_PRINT {
            block_stmt_arena[block_arena_pos] = parse_print(toks, pos, stab, src)
        } else {
            block_stmt_arena[block_arena_pos] = parse_expr_stmt(toks, pos, stab, src)
        }
        block_arena_pos = block_arena_pos + 1
        cnt = cnt + 1
    }
    expect(toks, pos, TOK_RBRACE)
    let block = Node{}
    block.node_type = NODE_BLOCK
    block.children  = block_stmt_arena + start_pos
    block.child_cnt = cnt
    ret block
}

fn parse_let(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(toks, pos, TOK_LET)
    let name = toks[pos[0]]
    expect(toks, pos, TOK_IDENT)
    expect(toks, pos, TOK_EQ)
    let val = Node{}
    let arr_decl = 0
    if peek_token(toks, pos[0]) == TOK_LBRACK {
        if toks[pos[0]].type == TOK_I64 or toks[pos[0]].type == TOK_I32 or toks[pos[0]].type == TOK_I8 {
            arr_decl = 1
        } else if toks[pos[0]].type == TOK_IDENT {
            let type_idx = pos[0]
            let type_tok = toks[type_idx]
            let type_start = type_tok.str_start
            let type_len = type_tok.str_len
            let sid = lookup_struct(stab, src, type_start, type_len)
            if sid >= 0 { arr_decl = 1 }
        }
    }
    if arr_decl == 1 {
        let t = toks[pos[0]]
        pos[0] = pos[0] + 2
        ; Store cnt in global buffer so val.child0 stays stable after parse_let returns
        g_let_cnt_buf = parse_expr(toks, pos, stab, src)
        expect(toks, pos, TOK_RBRACK)
        val.node_type = NODE_ARRAY_ALLOC
        val.child0    = g_let_cnt_buf  ; &g_let_cnt_buf (global, stable)
        val.imm       = 8
        val.token     = -1
        val.token2    = 0
        if t.type == TOK_I32 { val.imm = 4 }
        if t.type == TOK_I8  { val.imm = 1 }
        if t.type == TOK_IDENT {
            val.imm   = 0
            val.token = t.str_start
            val.token2 = t.str_len
        }
    } else {
        val = parse_expr(toks, pos, stab, src)
    }
    ; Copy val into global buffer so n.child0 points to stable memory.
    ; Without this, n.child0 = &val (stack local) dangles after parse_let returns,
    ; and codegen_stmt's large frame overwrites it causing segfaults.
    g_let_val_buf = val
    let n = Node{}
    n.node_type = NODE_LET
    n.op        = 0   ; declaration
    ; Store str_start/str_len directly - avoids dangling Token pointer after parse_let returns
    n.token     = name.str_start
    n.token2    = name.str_len
    n.child0    = g_let_val_buf  ; &g_let_val_buf (global, stable)
    ret n
}

fn parse_if(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(toks, pos, TOK_IF)
    let cond   = parse_expr(toks, pos, stab, src)
    ; NOTE: We need to skip the block tokens, not parse the full block body
    ; since parse_block causes crashes when nested.
    ; For now, just skip the block braces
    expect(toks, pos, TOK_LBRACE)
    let depth = 1
    loop depth > 0 and toks[pos[0]].type != TOK_EOF {
        if toks[pos[0]].type == TOK_LBRACE { depth = depth + 1 }
        if toks[pos[0]].type == TOK_RBRACE { depth = depth - 1 }
        pos[0] = pos[0] + 1
    }
    ; Skip else if present
    if toks[pos[0]].type == TOK_ELSE {
        pos[0] = pos[0] + 1
        if toks[pos[0]].type == TOK_IF {
            ; Recursively parse else-if chain
            pos[0] = pos[0] + 1  ; skip 'if'
            let cond2 = parse_expr(toks, pos, stab, src)
            expect(toks, pos, TOK_LBRACE)
            let d = 1
            loop d > 0 and toks[pos[0]].type != TOK_EOF {
                if toks[pos[0]].type == TOK_LBRACE { d = d + 1 }
                if toks[pos[0]].type == TOK_RBRACE { d = d - 1 }
                pos[0] = pos[0] + 1
            }
            ; Handle trailing else or else-if after the else-if block
            if toks[pos[0]].type == TOK_ELSE {
                pos[0] = pos[0] + 1
                expect(toks, pos, TOK_LBRACE)
                let d3 = 1
                loop d3 > 0 and toks[pos[0]].type != TOK_EOF {
                    if toks[pos[0]].type == TOK_LBRACE { d3 = d3 + 1 }
                    if toks[pos[0]].type == TOK_RBRACE { d3 = d3 - 1 }
                    pos[0] = pos[0] + 1
                }
            }
        } else {
            ; Skip else block
            expect(toks, pos, TOK_LBRACE)
            let d = 1
            loop d > 0 and toks[pos[0]].type != TOK_EOF {
                if toks[pos[0]].type == TOK_LBRACE { d = d + 1 }
                if toks[pos[0]].type == TOK_RBRACE { d = d - 1 }
                pos[0] = pos[0] + 1
            }
        }
    }
    let n = Node{}
    n.node_type = NODE_IF
    ret n
}

fn parse_loop(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(toks, pos, TOK_LOOP)
    let cond = parse_expr(toks, pos, stab, src)
    ; NOTE: Skip the block body instead of parsing it with parse_block
    expect(toks, pos, TOK_LBRACE)
    let depth = 1
    loop depth > 0 and toks[pos[0]].type != TOK_EOF {
        if toks[pos[0]].type == TOK_LBRACE { depth = depth + 1 }
        if toks[pos[0]].type == TOK_RBRACE { depth = depth - 1 }
        pos[0] = pos[0] + 1
    }
    let n = Node{}
    n.node_type = NODE_LOOP
    ret n
}

fn parse_ret(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(toks, pos, TOK_RET)
    let t0 = toks[pos[0]]
    if t0.type == TOK_IDENT {
        ; Simple return by identifier only when followed by a non-expression token
        let peeked = peek_token(toks, pos[0])
        if peeked != TOK_DOT and peeked != TOK_LBRACK and
           peeked != TOK_LPAREN and op_precedence(peeked) < 0 {
            pos[0] = pos[0] + 1
            let n = Node{}
            n.node_type = NODE_RET
            n.op = 3
            n.token = t0.str_start
            n.child_cnt = t0.str_len
            ret n
        }
    }
    if t0.type == TOK_INT {
        pos[0] = pos[0] + 1
        let n = Node{}
        n.node_type = NODE_RET
        n.op = 4
        n.imm = t0.imm
        ret n
    }

    ; Fast path for direct field return: ret base[optional_idx].field
    let save = pos[0]
    if toks[pos[0]].type == TOK_IDENT {
        let base = toks[pos[0]]
        pos[0] = pos[0] + 1
        let idx = Node{}
        let has_idx = 0
        let idx_kind = 0
        let idx_start = 0
        let idx_len = 0
        let idx_imm = 0
        if toks[pos[0]].type == TOK_LBRACK {
            pos[0] = pos[0] + 1
            if toks[pos[0]].type == TOK_IDENT and peek_token(toks, pos[0]) == TOK_RBRACK {
                idx_kind = 1
                idx_start = toks[pos[0]].str_start
                idx_len   = toks[pos[0]].str_len
                pos[0] = pos[0] + 1
            } else if toks[pos[0]].type == TOK_INT and peek_token(toks, pos[0]) == TOK_RBRACK {
                idx_kind = 3
                idx_imm = toks[pos[0]].imm
                pos[0] = pos[0] + 1
            } else {
                idx = parse_expr(toks, pos, stab, src)
                idx_kind = 2
            }
            expect(toks, pos, TOK_RBRACK)
            has_idx = 1
        }
        if toks[pos[0]].type == TOK_DOT {
            pos[0] = pos[0] + 1
            let field = toks[pos[0]]
            expect(toks, pos, TOK_IDENT)
            let n = Node{}
            n.node_type = NODE_RET
            n.op = 2
            n.token = base.str_start
            n.child_cnt = base.str_len
            n.token2 = field.str_start
            n.imm = field.str_len
            n.data_type = -1
            n.ret_type = idx_kind
            n.child1 = null
            if idx_kind == 1 {
                n.children = idx_start
                n.param_cnt = idx_len
            }
            if idx_kind == 3 {
                n.children = idx_imm
            }
            if has_idx == 1 and idx_kind == 2 { n.child1 = idx }
            ret n
        }
    }
    pos[0] = save

    let val = parse_expr(toks, pos, stab, src)
    let n = Node{}
    n.node_type = NODE_RET
    n.child0    = val
    ret n
}

fn parse_print(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(toks, pos, TOK_PRINT)
    expect(toks, pos, TOK_LPAREN)
    ; Check if argument is integer literal - handle inline to avoid struct return bug
    let t = toks[pos[0]]
    if t.type == TOK_INT {
        let imm_val = t.imm
        pos[0] = pos[0] + 1
        expect(toks, pos, TOK_RPAREN)
        ; For integer literals, use op field to encode small values (0-255)
        ; Larger values not yet supported due to struct field access bug
        let n = Node{}
        n.node_type = NODE_PRINT
        n.op = 7  ; NODE_INT marker
        n.imm = imm_val  ; Store in imm field (will be read incorrectly, but let's test)
        ret n
    }
    ; For non-integer arguments, use normal parsing
    let arg = parse_expr(toks, pos, stab, src)
    expect(toks, pos, TOK_RPAREN)
    let n = Node{}
    n.node_type = NODE_PRINT
    n.child0 = arg
    ret n
}

fn parse_expr(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    ret parse_binop(toks, pos, 0, stab, src)
}

; Handle postfix operations (array indexing, field access, arrow access)
fn parse_postfix(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    let expr = parse_primary(toks, pos, stab, src)
    let tok_type = toks[pos[0]].type
    if tok_type == TOK_LBRACK {
        pos[0] = pos[0] + 1
        let idx = parse_expr(toks, pos, stab, src)
        expect(toks, pos, TOK_RBRACK)
        let n = Node{}
        n.node_type = NODE_BINOP
        n.op        = TOK_LBRACK
        n.child0    = expr
        n.child1    = idx
        ret n
    }
    if tok_type == TOK_DOT {
        pos[0] = pos[0] + 1
        let field = toks[pos[0]]
        expect(toks, pos, TOK_IDENT)
        let n = Node{}
        n.node_type = NODE_FIELD
        n.token     = field.str_start
        n.imm       = field.str_len
        n.child0    = expr
        ret n
    }
    if tok_type == TOK_ARROW {
        pos[0] = pos[0] + 1
        let field = toks[pos[0]]
        expect(toks, pos, TOK_IDENT)
        let deref = Node{}
        deref.node_type = NODE_DEREF
        deref.child0    = expr
        let n = Node{}
        n.node_type = NODE_FIELD
        n.token     = field.str_start
        n.imm       = field.str_len
        n.child0    = deref
        ret n
    }
    ret expr
}

; Pratt-style precedence climbing
fn parse_binop(toks: &Token, pos: &i64, min_prec: i32, stab: &StructTable, src: &i8) -> Node {
    let left = parse_postfix(toks, pos, stab, src)
    loop {
        let op   = toks[pos[0]].type
        let prec = op_precedence(op)
        if prec < min_prec { ret left }
        pos[0] = pos[0] + 1
        let right = parse_binop(toks, pos, prec + 1, stab, src)
        let n = Node{}
        n.node_type = NODE_BINOP
        n.op        = op
        n.child0    = left
        n.child1    = right
        left = n
    }
    ret left
}

fn op_precedence(op: i32) -> i32 {
    if op == TOK_STAR  or op == TOK_SLASH { ret 6 }
    if op == TOK_PLUS  or op == TOK_MINUS { ret 5 }
    if op == TOK_SHR   or op == TOK_SHL   { ret 5 }
    if op == TOK_LT    or op == TOK_GT or op == TOK_LTE or op == TOK_GTE { ret 4 }
    if op == TOK_EQEQ  or op == TOK_NEQ   { ret 3 }
    if op == TOK_AND   or op == TOK_AMP   { ret 2 }  ; Both logical and bitwise AND
    if op == TOK_OR    or op == TOK_PIPE  { ret 1 }  ; Both logical and bitwise OR
    ret -1
}

fn parse_primary(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    let t = toks[pos[0]]
    if t.type == TOK_MINUS {
        ; Unary minus: -expr
        pos[0] = pos[0] + 1
        let inner = parse_primary(toks, pos, stab, src)
        let zero = Node{}
        zero.node_type = NODE_INT
        zero.imm = 0
        let n = Node{}
        n.node_type = NODE_BINOP
        n.op = TOK_MINUS
        n.child0 = zero
        n.child1 = inner
        ret n
    }
    if t.type == TOK_TILDE {
        ; Unary bitwise NOT: implemented as -1 - expr
        pos[0] = pos[0] + 1
        let inner = parse_primary(toks, pos, stab, src)
        ; For bitwise NOT, we use a temporary approach: just pass it through as a unary operator
        ; by creating a dummy node. Later, we'll handle this in codegen.
        let n = Node{}
        n.node_type = NODE_BINOP
        n.op = TOK_TILDE
        n.child0 = inner
        ret n
    }
    if t.type == TOK_AMP {
        pos[0] = pos[0] + 1
        let inner = parse_primary(toks, pos, stab, src)
        let n = Node{}
        n.node_type = NODE_ADDR
        n.child0 = inner
        ret n
    }
    if t.type == TOK_STAR {
        pos[0] = pos[0] + 1
        let inner = parse_primary(toks, pos, stab, src)
        let n = Node{}
        n.node_type = NODE_DEREF
        n.child0 = inner
        ret n
    }
    if t.type == TOK_INT {
        pos[0] = pos[0] + 1
        let n = Node{}
        n.node_type = NODE_INT
        n.imm       = t.imm
        ret n
    }
    if t.type == TOK_STR {
        pos[0] = pos[0] + 1
        let n = Node{}
        n.node_type = NODE_STR
        n.token     = t
        ret n
    }
    if t.type == TOK_IDENT {
        pos[0] = pos[0] + 1
        if toks[pos[0]].type == TOK_LPAREN {
            ret parse_call_rest(toks, pos, t, stab, src)
        }
        if toks[pos[0]].type == TOK_LBRACE {
            ; Struct literal init: Type{} - only if it's actually a struct type
            let sid = lookup_struct(stab, src, t.str_start, t.str_len)
            if sid >= 0 {
                pos[0] = pos[0] + 1
                expect(toks, pos, TOK_RBRACE)
                let n = Node{}
                n.node_type = NODE_STRUCT_INIT
                n.token     = t
                ret n
            }
        }
        let idx = Node{}
        let has_idx = 0
        let idx_kind = 0
        let idx_start = 0
        let idx_len = 0
        let idx_imm = 0
        if toks[pos[0]].type == TOK_LBRACK {
            pos[0] = pos[0] + 1
            if toks[pos[0]].type == TOK_IDENT and peek_token(toks, pos[0]) == TOK_RBRACK {
                idx_kind = 1
                idx_start = toks[pos[0]].str_start
                idx_len   = toks[pos[0]].str_len
                pos[0] = pos[0] + 1
            } else if toks[pos[0]].type == TOK_INT and peek_token(toks, pos[0]) == TOK_RBRACK {
                idx_kind = 3
                idx_imm = toks[pos[0]].imm
                pos[0] = pos[0] + 1
            } else {
                ; Store complex idx in global so child0 pointer won't dangle after return
                g_parse_idx_buf = parse_expr(toks, pos, stab, src)
                idx_kind = 2
            }
            expect(toks, pos, TOK_RBRACK)
            has_idx = 1
        }
        if toks[pos[0]].type == TOK_DOT {
            pos[0] = pos[0] + 1
            let field = toks[pos[0]]
            expect(toks, pos, TOK_IDENT)
            let fnode = Node{}
            fnode.node_type = NODE_FIELD
            fnode.token     = t.str_start
            fnode.child_cnt = t.str_len
            fnode.token2    = field.str_start
            fnode.imm       = field.str_len
            fnode.data_type = -1
            fnode.child0    = null
            fnode.op        = idx_kind
            if idx_kind == 1 {
                fnode.children = idx_start
                fnode.param_cnt = idx_len
            }
            if idx_kind == 3 {
                fnode.children = idx_imm
            }
            if idx_kind == 2 { fnode.child0 = g_parse_idx_buf }
            ret fnode
        }
        if has_idx == 1 {
            let b = Node{}
            b.node_type = NODE_IDENT
            b.token     = t
            if idx_kind == 1 {
                let it = Token{}
                it.str_start = idx_start
                it.str_len   = idx_len
                idx.node_type = NODE_IDENT
                idx.token = it
            } else if idx_kind == 3 {
                idx.node_type = NODE_INT
                idx.imm = idx_imm
            }
            let in = Node{}
            in.node_type = NODE_BINOP
            in.op        = TOK_LBRACK
            in.child0    = b
            in.child1    = idx
            ret in
        }
        let n = Node{}
        n.node_type = NODE_IDENT
        n.token     = t
        ret n
    }
    if t.type == TOK_SYSCALL {
        ret parse_syscall(toks, pos, stab, src)
    }
    if t.type == TOK_LPAREN {
        pos[0] = pos[0] + 1
        let inner = parse_expr(toks, pos, stab, src)
        expect(toks, pos, TOK_RPAREN)
        ret inner
    }
    print("Parse error: unexpected token\n")
    ret Node{}
}

fn parse_call_rest(toks: &Token, pos: &i64, name: &Token, stab: &StructTable, src: &i8) -> Node {
    expect(toks, pos, TOK_LPAREN)
    let n = Node{}
    n.node_type = NODE_CALL
    n.token     = name.str_start
    n.token2    = name.str_len
    n.child_cnt = 0
    loop toks[pos[0]].type != TOK_RPAREN {
        let a = parse_expr(toks, pos, stab, src)
        if n.child_cnt == 0 { n.child0 = a }
        if n.child_cnt == 1 { n.child1 = a }
        if n.child_cnt == 2 { n.child2 = a }
        if n.child_cnt == 3 { n.child3 = a }
        n.child_cnt = n.child_cnt + 1
        if toks[pos[0]].type == TOK_COMMA {
            pos[0] = pos[0] + 1
        }
    }
    expect(toks, pos, TOK_RPAREN)
    ret n
}

fn parse_syscall(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(toks, pos, TOK_SYSCALL)
    expect(toks, pos, TOK_LPAREN)
    let nr   = parse_expr(toks, pos, stab, src)
    expect(toks, pos, TOK_COMMA)
    let arg0 = parse_expr(toks, pos, stab, src)
    expect(toks, pos, TOK_COMMA)
    let arg1 = parse_expr(toks, pos, stab, src)
    expect(toks, pos, TOK_COMMA)
    let arg2 = parse_expr(toks, pos, stab, src)
    expect(toks, pos, TOK_RPAREN)
    let n = Node{}
    n.node_type = NODE_SYSCALL
    n.child0    = nr
    n.child1    = arg0
    n.child2    = arg1
    n.child3    = arg2
    ret n
}

; ============================================================
; 5. JIR EMISSION HELPERS
; ============================================================

fn new_block(jfn: &JirFunction) -> i64 {
    ret create_block_live(jfn)
}

fn create_block_live(jfn: &JirFunction) -> i64 {
    let id = jfn.block_cnt
    if id >= 256 { ret 255 }
    jfn.blocks[id].id        = id
    jfn.blocks[id].instr_cnt = 0
    jfn.blocks[id].label_off = -1
    jfn.block_cnt = id + 1
    ret id
}

fn create_block(jfn: &JirFunction) -> i64 {
    let id = jfn.block_cnt
    if id < 0 {
        ret 0
    }
    if id >= 256 {
        ret 255
    }
    jfn.blocks[id].id        = id
    jfn.blocks[id].instr_cnt = 0
    jfn.blocks[id].label_off = -1
    jfn.block_cnt = jfn.block_cnt + 1
    ret id
}

fn copy_instr(dst: &Instr, src: &Instr) {
    dst.op         = src.op
    dst.itype      = src.itype
    dst.operand0   = src.operand0
    dst.operand1   = src.operand1
    dst.operand2   = src.operand2
    dst.operand3   = src.operand3
    dst.imm        = src.imm
    dst.str_start  = src.str_start
    dst.str_len    = src.str_len
    dst.bb_target0 = src.bb_target0
    dst.bb_target1 = src.bb_target1
}

fn emit(jfn: &JirFunction, bb: i64, ins: &Instr) -> i64 {
    if bb < 0 or bb >= 256 {
        print("EMIT_BB_OVF bb=")
        print(bb)
        print("\n")
        panic("emit bb overflow")
        ret -1
    }
    let slot = jfn.blocks[bb].instr_cnt
    if slot < 0 or slot >= 256 {
        print("EMIT_SLOT_OVF slot=")
        print(slot)
        print(" bb=")
        print(bb)
        print("\n")
        panic("emit slot overflow")
        ret -1
    }
    copy_instr(&jfn.blocks[bb].instrs[slot], ins)
    jfn.blocks[bb].instrs[slot].dead      = 0
    jfn.blocks[bb].instrs[slot].id = jfn.next_id
    jfn.next_id = jfn.next_id + 1
    jfn.blocks[bb].instr_cnt = slot + 1
    ret jfn.blocks[bb].instrs[slot].id
}

fn emit_const(jfn: &JirFunction, bb: i64, itype: i32, imm: i64) -> i64 {
    let ins = Instr{}
    ins.op    = OP_CONST
    ins.itype = itype
    ins.imm   = imm
    ret emit(jfn, bb, &ins)
}

fn emit_binop(jfn: &JirFunction, bb: i64, op: i32, a: i64, b: i64) -> i64 {
    let ins = Instr{}
    ins.op       = op
    ins.itype    = TYPE_I64
    ins.operand0 = a
    ins.operand1 = b
    ret emit(jfn, bb, &ins)
}

fn emit_br(jfn: &JirFunction, bb: i64, cond: i64, then_bb: i64, else_target: i64) -> i64 {
    let ins = Instr{}
    ins.op         = OP_BR
    ins.operand0   = cond
    ins.bb_target0 = then_bb
    ins.bb_target1 = else_target
    ret emit(jfn, bb, &ins)
}

fn emit_jmp(jfn: &JirFunction, bb: i64, target: i64) -> i64 {
    let ins = Instr{}
    ins.op         = OP_JMP
    ins.bb_target0 = target
    ret emit(jfn, bb, &ins)
}

fn emit_strlit_raw(jfn: &JirFunction, bb: i64, str_start: i64, str_len: i64) -> i64 {
    let off = jfn.strtab_pos
    let i = 0
    let out_len = 0
    loop i < str_len {
        let spos = jfn.strtab_pos
        if spos < 4095 {
            let src_i = str_start + i
            let c = load_i8_at(jfn.src, src_i)
            let consumed = 0
            if c == 92 {
                if i + 1 < str_len {
                    let nc = load_i8_at(jfn.src, src_i + 1)
                    let esc = try_escape(c, nc)
                    if esc != -1 {
                        jfn.strtab[spos] = esc
                        jfn.strtab_pos = spos + 1
                        out_len = out_len + 1
                        i = i + 2
                        consumed = 1
                    }
                }
            }
            if consumed == 0 {
                jfn.strtab[spos] = c
                jfn.strtab_pos = spos + 1
                out_len = out_len + 1
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    let end_pos = jfn.strtab_pos
    if end_pos < 4095 {
        jfn.strtab[end_pos] = 0
        jfn.strtab_pos = end_pos + 1
    }

    let ins = Instr{}
    ins.op        = OP_STRLIT
    ins.str_start = off
    ins.str_len   = out_len
    ret emit(jfn, bb, &ins)
}

fn emit_gaddr(jfn: &JirFunction, bb: i64, gidx: i64) -> i64 {
    let ins = Instr{}
    ins.op  = OP_GADDR
    ins.imm = gidx
    ret emit(jfn, bb, &ins)
}

fn compile_ret_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    print("CR1\n")
    let t0 = tok_type_at0(toks, pos)
    if t0 != TOK_RET {
        if t0 != TOK_EOF { pos[0] = pos[0] + 1 }
        ret bb
    }
    pos[0] = pos[0] + 1
    print("CR2\n")
    let val_id = emit_const(jfn, bb, TYPE_I64, 0)
    let t = tok_type_at0(toks, pos)
    if t == TOK_INT or t == TOK_IDENT or t == TOK_LPAREN or t == TOK_MINUS or t == TOK_TILDE or t == TOK_AMP or t == TOK_SYSCALL {
        print("CR3\n")
        val_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        print("CR4\n")
    }
    let ins = Instr{}
    ins.op = OP_RET
    ins.operand0 = val_id
    print("CR5\n")
    emit(jfn, bb, &ins)
    ret OP_RET
}

fn compile_print_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    pos[0] = pos[0] + 1
    let open_t = tok_type_at0(toks, pos)
    if open_t == TOK_LPAREN { pos[0] = pos[0] + 1 }
    let val_id = emit_const(jfn, bb, TYPE_I64, 0)
    let len_id = -1
    let pt = tok_type_at0(toks, pos)
    if pt == TOK_STR {
        let s_start = tok_str_start_at(toks, pos[0])
        let s_len = tok_str_len_at(toks, pos[0])
        pos[0] = pos[0] + 1
        val_id = emit_strlit_raw(jfn, bb, s_start, s_len)
        len_id = emit_const(jfn, bb, TYPE_I64, s_len)
    } else if pt != TOK_RPAREN and pt != TOK_EOF {
        val_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    }
    let close_t = tok_type_at0(toks, pos)
    if close_t == TOK_RPAREN { pos[0] = pos[0] + 1 }
    let fd_id  = emit_const(jfn, bb, TYPE_I64, 1)
    if len_id == -1 {
        let len_ins0 = Instr{}
        len_ins0.op = OP_STRLEN
        len_ins0.operand0 = val_id
        len_id = emit(jfn, bb, &len_ins0)
    }
    emit_syscall3(jfn, bb, 1, fd_id, val_id, len_id)
    ret bb
}

fn try_compile_field_store_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, name_start: i64, name_len: i64) -> i64 {
    if tok_type_at(toks, pos[0] + 1) != TOK_DOT { ret 0 }
    let field_start = tok_str_start_at(toks, pos[0] + 2)
    let field_len = tok_str_len_at(toks, pos[0] + 2)
    if tok_type_at(toks, pos[0] + 3) != TOK_EQ { ret 0 }
    pos[0] = pos[0] + 4
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let base_id = -1
    let base_stype = -1
    let slot0 = lookup_slot_name(jfn, name_start, name_len)
    if slot0 != -1 {
        let ld0 = Instr{}
        ld0.op = OP_LOAD
        ld0.operand0 = slot0
        base_id = emit(jfn, bb, &ld0)
        base_stype = lookup_stype_name(jfn, name_start, name_len)
    } else {
        let gi0 = lookup_global2(name_start, name_len, src)
        if gi0 != -1 {
            base_stype = g_glob_stype[gi0]
            base_id = emit_gaddr(jfn, bb, gi0)
            if g_glob_is_addr[gi0] == 0 {
                let ldg0 = Instr{}
                ldg0.op = OP_LOAD_MEM
                ldg0.operand0 = base_id
                base_id = emit(jfn, bb, &ldg0)
            }
        }
    }
    if base_id != -1 {
        let sid0 = base_type(base_stype)
        let foff0 = lookup_field_off_any(stab, src, sid0, field_start, field_len)
        if foff0 >= 0 {
            let off_id0 = emit_const(jfn, bb, TYPE_I64, foff0)
            let addr0 = emit_binop(jfn, bb, OP_ADD, base_id, off_id0)
            let stf = Instr{}
            stf.op = OP_STORE_MEM
            stf.operand0 = rhs_id
            stf.operand1 = addr0
            emit(jfn, bb, &stf)
        }
    }
    ret 1
}

fn try_compile_index_store_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, name_start: i64, name_len: i64, pos_before: i64) -> i64 {
    if tok_type_at(toks, pos[0] + 1) != TOK_LBRACK { ret 0 }
    pos[0] = pos[0] + 2
    let idx_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if tok_type_at0(toks, pos) == TOK_RBRACK {
        pos[0] = pos[0] + 1
    }
    if tok_type_at0(toks, pos) != TOK_EQ {
        pos[0] = pos_before
        ret 0
    }
    pos[0] = pos[0] + 1
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let base_id = -1
    let slot_idx = lookup_slot_name(jfn, name_start, name_len)
    if slot_idx != -1 {
        let ld = Instr{}
        ld.op = OP_LOAD
        ld.operand0 = slot_idx
        base_id = emit(jfn, bb, &ld)
    } else {
        let gi2 = lookup_global2(name_start, name_len, src)
        if gi2 != -1 {
            base_id = emit_gaddr(jfn, bb, gi2)
            if g_glob_is_addr[gi2] == 0 {
                let ldg = Instr{}
                ldg.op = OP_LOAD_MEM
                ldg.operand0 = base_id
                base_id = emit(jfn, bb, &ldg)
            }
        }
    }
    if base_id != -1 {
        let elem_sz = emit_const(jfn, bb, TYPE_I64, 8)
        let byte_off = emit_binop(jfn, bb, OP_MUL, idx_id, elem_sz)
        let addr = emit_binop(jfn, bb, OP_ADD, base_id, byte_off)
        let stx = Instr{}
        stx.op = OP_STORE_MEM
        stx.operand0 = rhs_id
        stx.operand1 = addr
        emit(jfn, bb, &stx)
    }
    ret 1
}

fn compile_expr_stmt2_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt { ret bb }
    let pos_before = pos[0]
    let t0 = tok_type_at0(toks, pos)
    if t0 == TOK_IDENT {
        let name_start = tok_str_start_at(toks, pos[0])
        let name_len = tok_str_len_at(toks, pos[0])
        if try_compile_field_store_inline(toks, pos, stab, src, jfn, bb, name_start, name_len) == 1 { ret bb }
        if try_compile_index_store_inline(toks, pos, stab, src, jfn, bb, name_start, name_len, pos_before) == 1 { ret bb }
        let t1 = tok_type_at(toks, pos[0] + 1)
        if t1 == TOK_EQ {
            pos[0] = pos[0] + 2
            let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
            if rhs_id < 0 {
                rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
            }
            let slot = lookup_slot_name(jfn, name_start, name_len)
            if slot != -1 {
                let st = Instr{}
                st.op = OP_STORE
                st.operand0 = rhs_id
                st.operand1 = slot
                emit(jfn, bb, &st)
                ret bb
            }
            let gi = lookup_global2(name_start, name_len, src)
            if gi != -1 {
                let gaddr = emit_gaddr(jfn, bb, gi)
                let stg = Instr{}
                stg.op = OP_STORE_MEM
                stg.operand0 = rhs_id
                stg.operand1 = gaddr
                emit(jfn, bb, &stg)
                ret bb
            }
            ret bb
        }
    }
    codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if pos[0] <= pos_before and pos[0] < g_dbg_tok_cnt {
        pos[0] = pos[0] + 1
    }
    ret bb
}

fn skip_asm_stmt_inline(toks: &Token, pos: &i64, src: &i8) -> i64 {
    if tok_type_at0(toks, pos) != TOK_IDENT { ret 0 }
    let t = toks[pos[0]]
    if t.str_len != 3 { ret 0 }
    if streq(src, t.str_start, t.str_len, "asm") != 1 { ret 0 }
    if tok_type_at(toks, pos[0] + 1) != TOK_LBRACE { ret 0 }
    pos[0] = pos[0] + 2
    let depth = 1
    loop depth > 0 and pos[0] < g_dbg_tok_cnt {
        let tt = tok_type_at0(toks, pos)
        if tt == TOK_LBRACE { depth = depth + 1 }
        if tt == TOK_RBRACE { depth = depth - 1 }
        pos[0] = pos[0] + 1
    }
    ret 1
}

fn compile_asm_argv_inline(toks: &Token, pos: &i64, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at0(toks, pos) != TOK_IDENT { ret 0 }
    let t0 = toks[pos[0]]
    if t0.str_len != 3 { ret 0 }
    if streq(src, t0.str_start, t0.str_len, "asm") != 1 { ret 0 }
    if tok_type_at(toks, pos[0] + 1) != TOK_LBRACE { ret 0 }
    let t_out = toks[pos[0] + 2]
    let t_var = toks[pos[0] + 3]
    let t_eq  = tok_type_at(toks, pos[0] + 4)
    let t_rsi = toks[pos[0] + 5]
    let t_rbrace = tok_type_at(toks, pos[0] + 6)
    if t_out.str_len != 3 { ret 0 }
    if t_eq != TOK_EQ { ret 0 }
    if t_rsi.str_len != 3 { ret 0 }
    if t_rbrace != TOK_RBRACE { ret 0 }
    if streq(src, t_out.str_start, t_out.str_len, "out") != 1 { ret 0 }
    if streq(src, t_rsi.str_start, t_rsi.str_len, "rsi") != 1 { ret 0 }
    let slot = lookup_slot_name(jfn, t_var.str_start, t_var.str_len)
    if slot == -1 { ret 0 }
    let ins = Instr{}
    ins.op = OP_ARGV_BASE
    ins.operand0 = slot
    emit(jfn, bb, &ins)
    pos[0] = pos[0] + 7
    ret 1
}

fn compile_if_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(toks, pos, TOK_IF)
    let cond_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    let then_blk = create_block_live(jfn)
    let alt_blk = create_block_live(jfn)
    let merge_blk = create_block_live(jfn)
    emit_br(jfn, bb, cond_id, then_blk, alt_blk)
    expect(toks, pos, TOK_LBRACE)
    let then_end = compile_stmts_inline(toks, pos, stab, src, jfn, then_blk)
    expect(toks, pos, TOK_RBRACE)
    emit_jmp(jfn, then_end, merge_blk)
    if tok_type_at(toks, pos[0]) != TOK_ELSE {
        emit_jmp(jfn, alt_blk, merge_blk)
        ret merge_blk
    }
    pos[0] = pos[0] + 1
    if tok_type_at(toks, pos[0]) == TOK_IF {
        let alt_end = live_compile_if(toks, pos, stab, src, jfn, alt_blk)
        emit_jmp(jfn, alt_end, merge_blk)
        ret merge_blk
    }
    expect(toks, pos, TOK_LBRACE)
    let alt_end = compile_stmts_inline(toks, pos, stab, src, jfn, alt_blk)
    expect(toks, pos, TOK_RBRACE)
    emit_jmp(jfn, alt_end, merge_blk)
    ret merge_blk
}

fn compile_stmts_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let cur = bb
    let more = 1
    loop more == 1 {
        let t = tok_type_at(toks, pos[0])
        if t == TOK_RBRACE { more = 0 }
        else if t == TOK_EOF { more = 0 }
        else if t == TOK_IF {
            cur = compile_if_inline(toks, pos, stab, src, jfn, cur)
        } else if t == TOK_LOOP {
            expect(toks, pos, TOK_LOOP)
            let head_blk = create_block_live(jfn)
            emit_jmp(jfn, cur, head_blk)
            let body_blk = create_block_live(jfn)
            let exit_blk = create_block_live(jfn)
            let cond_id = codegen_expr_inline(toks, pos, stab, src, jfn, head_blk)
            emit_br(jfn, head_blk, cond_id, body_blk, exit_blk)
            expect(toks, pos, TOK_LBRACE)
            let body_end = live_compile_block(toks, pos, stab, src, jfn, body_blk)
            expect(toks, pos, TOK_RBRACE)
            emit_jmp(jfn, body_end, head_blk)
            cur = exit_blk
        } else if t == TOK_LET {
            pos[0] = pos[0] + 1
            let name_start = tok_str_start_at(toks, pos[0])
            let name_len = tok_str_len_at(toks, pos[0])
            pos[0] = pos[0] + 1
            pos[0] = pos[0] + 1
            let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, cur)
            let slot = bind_name(jfn, name_start, name_len, TYPE_I64)
            let ins = Instr{}
            ins.op = OP_STORE
            ins.operand0 = rhs_id
            ins.operand1 = slot
            emit(jfn, cur, &ins)
        } else if t == TOK_RET {
            pos[0] = pos[0] + 1
            let val_id = emit_const(jfn, cur, TYPE_I64, 0)
            let rt = tok_type_at0(toks, pos)
            if rt == TOK_INT or rt == TOK_IDENT or rt == TOK_LPAREN or rt == TOK_MINUS or rt == TOK_TILDE or rt == TOK_AMP or rt == TOK_SYSCALL {
                val_id = codegen_expr_inline(toks, pos, stab, src, jfn, cur)
            }
            let rins = Instr{}
            rins.op = OP_RET
            rins.operand0 = val_id
            emit(jfn, cur, &rins)
        } else if t == TOK_PRINT {
            cur = compile_print_inline(toks, pos, stab, src, jfn, cur)
        } else {
            cur = compile_expr_stmt2_inline(toks, pos, stab, src, jfn, cur)
        }
    }
    ret cur
}

fn op_precedence(tok: i32) -> i32 {
    if tok == TOK_OR   { ret 10 }
    if tok == TOK_AND  { ret 20 }
    if tok == TOK_EQEQ { ret 30 }
    if tok == TOK_NEQ  { ret 30 }
    if tok == TOK_LT   { ret 40 }
    if tok == TOK_GT   { ret 40 }
    if tok == TOK_LTE  { ret 40 }
    if tok == TOK_GTE  { ret 40 }
    if tok == TOK_PLUS { ret 50 }
    if tok == TOK_MINUS { ret 50 }
    if tok == TOK_STAR { ret 60 }
    if tok == TOK_SLASH { ret 60 }
    ret 0
}

fn is_cmp_tok(tok: i32) -> i64 {
    if tok == TOK_EQEQ { ret 1 }
    if tok == TOK_NEQ { ret 1 }
    if tok == TOK_LT { ret 1 }
    if tok == TOK_GT { ret 1 }
    if tok == TOK_LTE { ret 1 }
    if tok == TOK_GTE { ret 1 }
    ret 0
}

fn is_term_tok(tok: i32) -> i64 {
    if tok == TOK_RPAREN { ret 1 }
    if tok == TOK_RBRACE { ret 1 }
    if tok == TOK_RBRACK { ret 1 }
    if tok == TOK_COMMA { ret 1 }
    if tok == TOK_EOF { ret 1 }
    if tok == TOK_LBRACE { ret 1 }
    ret 0
}

fn codegen_expr_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    print("EXPR1\n")
    ret codegen_or_inline(toks, pos, stab, src, jfn, bb)
}

fn codegen_or_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    print("OR1\n")
    let left_id = codegen_and_inline(toks, pos, stab, src, jfn, bb)
    print("OR2\n")
    loop {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_OR and op != TOK_PIPE {
            ret left_id
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_and_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_and_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    print("AND1\n")
    let left_id = codegen_eq_inline(toks, pos, stab, src, jfn, bb)
    print("AND2\n")
    loop {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_AND and op != TOK_AMP {
            ret left_id
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_eq_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_eq_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    print("EQ1\n")
    let left_id = codegen_rel_inline(toks, pos, stab, src, jfn, bb)
    print("EQ2\n")
    loop {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_EQEQ and op != TOK_NEQ {
            ret left_id
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_rel_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_rel_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_add_inline(toks, pos, stab, src, jfn, bb)
    loop {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_LT and op != TOK_GT and op != TOK_LTE and op != TOK_GTE {
            ret left_id
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_add_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn is_add_like_op(op: i32) -> i64 {
    if op == TOK_PLUS { ret 1 }
    if op == TOK_MINUS { ret 1 }
    ret 0
}

fn is_mul_like_op(op: i32) -> i64 {
    if op == TOK_STAR { ret 1 }
    if op == TOK_SLASH { ret 1 }
    ret 0
}

fn codegen_add_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_mul_inline(toks, pos, stab, src, jfn, bb)
    if left_id < 0 {
        ret left_id
    }
    loop {
        let op = tok_type_at(toks, pos[0])
        if is_add_like_op(op) == 0 {
            ret left_id
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_mul_inline(toks, pos, stab, src, jfn, bb)
        if right_id < 0 {
            ret left_id
        }
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_mul_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_unary_inline(toks, pos, stab, src, jfn, bb)
    if left_id < 0 {
        ret left_id
    }
    loop {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_STAR and op != TOK_SLASH {
            ret left_id
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_unary_inline(toks, pos, stab, src, jfn, bb)
        if right_id < 0 {
            ret left_id
        }
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_unary_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    if pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let tt = tok_type_at0(toks, pos)
    if tt == TOK_SYSCALL {
        ret codegen_syscall_inline(toks, pos, stab, src, jfn, bb)
    }
    if tt == TOK_MINUS {
        pos[0] = pos[0] + 1
        let zero_id = emit_const(jfn, bb, TYPE_I64, 0)
        let rhs_id = codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
        ret emit_binop(jfn, bb, OP_SUB, zero_id, rhs_id)
    }
    if tt == TOK_TILDE {
        pos[0] = pos[0] + 1
        let rhs_id = codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
        let neg1_id = emit_const(jfn, bb, TYPE_I64, -1)
        ret emit_binop(jfn, bb, OP_SUB, neg1_id, rhs_id)
    }
    if tt != TOK_AMP {
        ret codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
    }
    pos[0] = pos[0] + 1
    let addr_tt = tok_type_at0(toks, pos)
    if addr_tt != TOK_IDENT {
        if addr_tt != TOK_EOF { pos[0] = pos[0] + 1 }
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let a_start = tok_str_start_at(toks, pos[0])
    let a_len = tok_str_len_at(toks, pos[0])
    let slot = lookup_slot_name(jfn, a_start, a_len)
    if slot != -1 {
        pos[0] = pos[0] + 1
        let ains = Instr{}
        ains.op = OP_ADDR
        ains.operand0 = slot
        ret emit(jfn, bb, &ains)
    }
    let gi = lookup_global2(a_start, a_len, src)
    if gi != -1 {
        pos[0] = pos[0] + 1
        ret emit_gaddr(jfn, bb, gi)
    }
    pos[0] = pos[0] + 1
    ret emit_const(jfn, bb, TYPE_I64, 0)
}

fn codegen_postfix_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let start_pos = pos[0]
    let expr_id = codegen_primary_inline(toks, pos, stab, src, jfn, bb)
    let cur_stype = TYPE_I64
    if tok_type_at(toks, start_pos) == TOK_IDENT {
        cur_stype = lookup_stype_name(jfn, tok_str_start_at(toks, start_pos), tok_str_len_at(toks, start_pos))
    }
    loop {
        let tok_type = tok_type_at(toks, pos[0])
        if tok_type == TOK_DOT {
            pos[0] = pos[0] + 1
            let field_start = tok_str_start_at(toks, pos[0])
            let field_len = tok_str_len_at(toks, pos[0])
            expect(toks, pos, TOK_IDENT)
            let sid = base_type(cur_stype)
            let fi = lookup_field_idx_any(stab, src, sid, field_start, field_len)
            if fi == -1 {
                ret expr_id
            }
            let off_id = emit_const(jfn, bb, TYPE_I64, stab.foffs[fi])
            let addr = emit_binop(jfn, bb, OP_ADD, expr_id, off_id)
            cur_stype = stab.ftypes[fi]
            if stab.fis_array[fi] == 1 {
                expr_id = addr
            } else {
                let ld = Instr{}
                ld.op = OP_LOAD_MEM
                ld.operand0 = addr
                expr_id = emit(jfn, bb, &ld)
            }
        } else if tok_type == TOK_LBRACK {
            print("X1\n")
            pos[0] = pos[0] + 1
            let idx_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
            print("X2\n")
            expect(toks, pos, TOK_RBRACK)
            print("X3\n")
            let elem_sz = emit_const(jfn, bb, TYPE_I64, 8)
            print("X4\n")
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx_id, elem_sz)
            print("X5\n")
            let addr = emit_binop(jfn, bb, OP_ADD, expr_id, byte_off)
            print("X6\n")
            let ld = Instr{}
            ld.op = OP_LOAD_MEM
            ld.operand0 = addr
            expr_id = emit(jfn, bb, &ld)
            print("X7\n")
        } else {
            ret expr_id
        }
    }
    ret expr_id
}

fn codegen_primary_ident_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    print("P1\n")
    let t_start = tok_str_start_at(toks, pos[0])
    let t_len = tok_str_len_at(toks, pos[0])
    print("P2\n")
    pos[0] = pos[0] + 1
    if tok_type_at(toks, pos[0]) == TOK_LPAREN {
        ret codegen_call_inline(toks, pos, stab, src, jfn, bb)
    }
    print("P3\n")
    pos[0] = pos[0] - 1
    let slot = lookup_slot_name(jfn, t_start, t_len)
    print("P4 slot=\n")
    if slot == -1 {
        print("P5 ident=[")
        syscall(1, 1, src + t_start, t_len)
        print("]\n")
        dump_globals(src)
        let gi = lookup_global2(t_start, t_len, src)
        if gi != -1 {
            pos[0] = pos[0] + 1
            let addr = emit_gaddr(jfn, bb, gi)
            if g_glob_is_addr[gi] == 1 {
                ret addr
            }
            let ldg = Instr{}
            ldg.op = OP_LOAD_MEM
            ldg.operand0 = addr
            ret emit(jfn, bb, &ldg)
        }
        let cval = lookup_const(src, t_start, t_len)
        if cval != -1 {
            pos[0] = pos[0] + 1
            ret emit_const(jfn, bb, TYPE_I64, cval)
        }
        if tok_type_at(toks, pos[0] + 1) == TOK_LBRACE {
            ; Determine if it's a known large struct — emit OP_ALLOC for those
            let struct_alloc_sz = 0
            if t_len == 11 and streq(src, t_start, 11, "JirFunction") == 1 {
                struct_alloc_sz = 6297032
            }
            if t_len == 8 and streq(src, t_start, 8, "LowerCtx") == 1 {
                struct_alloc_sz = 100464
            }
            pos[0] = pos[0] + 2
            let sdepth = 1
            loop sdepth > 0 and pos[0] < g_dbg_tok_cnt {
                let slbt = tok_type_at(toks, pos[0])
                if slbt == TOK_LBRACE { sdepth = sdepth + 1 }
                if slbt == TOK_RBRACE { sdepth = sdepth - 1 }
                pos[0] = pos[0] + 1
            }
            if struct_alloc_sz > 0 {
                let sz_id = emit_const(jfn, bb, TYPE_I64, struct_alloc_sz)
                let ai = Instr{}
                ai.op = OP_ALLOC
                ai.operand0 = sz_id
                ret emit(jfn, bb, &ai)
            }
            ret emit_const(jfn, bb, TYPE_I64, 0)
        }
        ret -1
    }
    print("P6 slot ok\n")
    pos[0] = pos[0] + 1
    let ld = Instr{}
    ld.op = OP_LOAD
    ld.operand0 = slot
    print("P7 calling emit\n")
    let ret_emit = emit(jfn, bb, &ld)
    print("P8 emit ok\n")
    ret ret_emit
}

fn codegen_primary_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let t_type = tok_type_at(toks, pos[0])
    if t_type == TOK_INT {
        let t_imm = tok_imm_at(toks, pos[0])
        pos[0] = pos[0] + 1
        ret emit_const(jfn, bb, TYPE_I64, t_imm)
    }
    if t_type == TOK_IDENT {
        ret codegen_primary_ident_inline(toks, pos, stab, src, jfn, bb)
    }
    if t_type == TOK_LPAREN {
        pos[0] = pos[0] + 1
        let inner_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        expect(toks, pos, TOK_RPAREN)
        ret inner_id
    }
    ret -1
}

fn codegen_arg_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let next_tok = peek_token(toks, pos[0])
    if tok_type_at(toks, pos[0]) == TOK_STR {
        let a_id = emit_strlit_raw(jfn, bb, tok_str_start_at(toks, pos[0]), tok_str_len_at(toks, pos[0]))
        pos[0] = pos[0] + 1
        ret a_id
    }
    if tok_type_at(toks, pos[0]) == TOK_INT and (next_tok == TOK_COMMA or next_tok == TOK_RPAREN) {
        let a_id = emit_const(jfn, bb, TYPE_I64, tok_imm_at(toks, pos[0]))
        pos[0] = pos[0] + 1
        ret a_id
    }
    if tok_type_at(toks, pos[0]) == TOK_IDENT and next_tok != TOK_LPAREN and next_tok != TOK_LBRACK and next_tok != TOK_DOT {
        let a_start = tok_str_start_at(toks, pos[0])
        let a_len = tok_str_len_at(toks, pos[0])
        pos[0] = pos[0] + 1
        let aslot = lookup_slot_name(jfn, a_start, a_len)
        if aslot != -1 {
            let ald = Instr{}
            ald.op = OP_LOAD
            ald.operand0 = aslot
            ret emit(jfn, bb, &ald)
        }
        let agi = lookup_global2(a_start, a_len, src)
        if agi != -1 {
            let aaddr = emit_gaddr(jfn, bb, agi)
            if g_glob_is_addr[agi] == 1 {
                ret aaddr
            }
            let aldg = Instr{}
            aldg.op = OP_LOAD_MEM
            aldg.operand0 = aaddr
            ret emit(jfn, bb, &aldg)
        }
        let acval = lookup_const(src, a_start, a_len)
        if acval != -1 {
            ret emit_const(jfn, bb, TYPE_I64, acval)
        }
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    ret codegen_expr_inline(toks, pos, stab, src, jfn, bb)
}

fn codegen_call_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] <= 0 or pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let name_start = tok_str_start_at(toks, pos[0] - 1)
    let name_len = tok_str_len_at(toks, pos[0] - 1)
    expect(toks, pos, TOK_LPAREN)
    let arg_cnt = 0
    let arg0 = -1
    let arg1 = -1
    let arg2 = -1
    let arg3 = -1
    let arg4 = -1
    let arg5 = -1
    loop tok_type_at(toks, pos[0]) != TOK_RPAREN and tok_type_at(toks, pos[0]) != TOK_EOF {
        let a_id = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
        if arg_cnt == 0 {
            arg0 = a_id
        } else if arg_cnt == 1 {
            arg1 = a_id
        } else if arg_cnt == 2 {
            arg2 = a_id
        } else if arg_cnt == 3 {
            arg3 = a_id
        } else if arg_cnt == 4 {
            arg4 = a_id
        } else if arg_cnt == 5 {
            arg5 = a_id
        }
        arg_cnt = arg_cnt + 1
        if arg_cnt > 6 {
            ; Recovery: skip malformed extra args until call close.
            loop tok_type_at(toks, pos[0]) != TOK_RPAREN and tok_type_at(toks, pos[0]) != TOK_EOF {
                pos[0] = pos[0] + 1
            }
            arg_cnt = 6
        }
        if tok_type_at(toks, pos[0]) == TOK_COMMA {
            pos[0] = pos[0] + 1
        }
    }
    expect(toks, pos, TOK_RPAREN)

    if name_len == 11 and streq(src, name_start, 11, "alloc_pages") == 1 {
        let pages_id = arg0
        if pages_id == -1 {
            pages_id = emit_const(jfn, bb, TYPE_I64, 0)
        }
        let page_sz = emit_const(jfn, bb, TYPE_I64, 4096)
        let alloc_sz = emit_binop(jfn, bb, OP_MUL, pages_id, page_sz)
        let ins = Instr{}
        ins.op = OP_ALLOC
        ins.operand0 = alloc_sz
        ret emit(jfn, bb, &ins)
    }

    let ins = Instr{}
    ins.op        = OP_CALL
    ins.operand0  = arg0
    ins.operand1  = arg1
    ins.operand2  = arg2
    ins.operand3  = arg_cnt
    ins.bb_target0 = arg3
    ins.bb_target1 = arg4
    ins.imm        = arg5
    ins.str_start = name_start
    ins.str_len   = name_len
    ret emit(jfn, bb, &ins)
}

fn codegen_syscall_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(toks, pos, TOK_SYSCALL)
    expect(toks, pos, TOK_LPAREN)
    let nr_id = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
    expect(toks, pos, TOK_COMMA)
    let a0_id = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
    expect(toks, pos, TOK_COMMA)
    let a1_id = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
    expect(toks, pos, TOK_COMMA)
    let a2_id = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
    expect(toks, pos, TOK_RPAREN)
    ret emit_syscall_raw(jfn, bb, nr_id, a0_id, a1_id, a2_id)
}

fn emit_print_int(jfn: &JirFunction, bb: i64, imm_val: i64) {
    let ins = Instr{}
    ins.op       = OP_PRINT_INT
    ins.imm      = imm_val
    emit(jfn, bb, &ins)
}

fn emit_syscall3(jfn: &JirFunction, bb: i64, nr: i64, a0: i64, a1: i64, a2: i64) -> i64 {
    let nr_id = emit_const(jfn, bb, TYPE_I64, nr)
    ret emit_syscall_raw(jfn, bb, nr_id, a0, a1, a2)
}

fn emit_syscall_raw(jfn: &JirFunction, bb: i64, nr: i64, a0: i64, a1: i64, a2: i64) -> i64 {
    let ins = Instr{}
    ins.op       = OP_SYSCALL
    ins.operand0 = nr
    ins.operand1 = a0
    ins.operand2 = a1
    ins.operand3 = a2
    ret emit(jfn, bb, &ins)
}

fn alloc_slot(jfn: &JirFunction) -> i64 {
    jfn.next_slot_off = jfn.next_slot_off + 8
    ret jfn.next_slot_off
}

fn bind(jfn: &JirFunction, tok: &Token, stype: i64) -> i64 {
    let idx = jfn.var_cnt
    if idx >= 32 {
        panic("Too many vars")
        ret -1
    }
    jfn.vars[idx].name_start = tok.str_start
    jfn.vars[idx].name_len   = tok.str_len
    jfn.vars[idx].slot_off   = alloc_slot(jfn)
    jfn.vars[idx].stype      = stype
    jfn.var_cnt = jfn.var_cnt + 1
    ret jfn.vars[idx].slot_off
}

fn bind_name(jfn: &JirFunction, name_start: i64, name_len: i64, stype: i64) -> i64 {
    let idx = jfn.var_cnt
    if idx >= 128 {
        panic("Too many vars")
        ret -1
    }
    jfn.vars[idx].name_start = name_start
    jfn.vars[idx].name_len   = name_len
    jfn.vars[idx].slot_off   = alloc_slot(jfn)
    jfn.vars[idx].stype      = stype
    jfn.var_cnt = jfn.var_cnt + 1
    ret jfn.vars[idx].slot_off
}

fn lookup_idx(jfn: &JirFunction, tok: &Token) -> i64 {
    ; Walk backwards so innermost binding wins
    let i = jfn.var_cnt - 1
    loop i >= 0 {
        if jfn.vars[i].name_len == tok.str_len {
            if str_match(jfn.src, tok.str_start, jfn.vars[i].name_start, tok.str_len) {
                ret i
            }
        }
        i = i - 1
    }
    ret -1   ; undefined: caller should error
}

fn lookup(jfn: &JirFunction, tok: &Token) -> i64 {
    let idx = lookup_idx(jfn, tok)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].slot_off
}

fn lookup_stype(jfn: &JirFunction, tok: &Token) -> i64 {
    let idx = lookup_idx(jfn, tok)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].stype
}

fn lookup_idx_name(jfn: &JirFunction, name_start: i64, name_len: i64) -> i64 {
    let i = jfn.var_cnt - 1
    loop i >= 0 {
        if jfn.vars[i].name_len == name_len {
            if str_match(jfn.src, name_start, jfn.vars[i].name_start, name_len) == 1 {
                ret i
            }
        }
        i = i - 1
    }
    ret -1
}

fn lookup_slot_name(jfn: &JirFunction, name_start: i64, name_len: i64) -> i64 {
    let idx = lookup_idx_name(jfn, name_start, name_len)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].slot_off
}

fn lookup_stype_name(jfn: &JirFunction, name_start: i64, name_len: i64) -> i64 {
    let idx = lookup_idx_name(jfn, name_start, name_len)
    if idx < 0 { ret -1 }
    ret jfn.vars[idx].stype
}

fn lookup_ident_stype(jfn: &JirFunction, tok: &Token) -> i64 {
    let st = lookup_stype(jfn, tok)
    if st != -1 { ret st }
    let gi = lookup_global2(tok.str_start, tok.str_len, jfn.src)
    if gi != -1 { ret g_glob_stype[gi] }
    ret -1
}

fn codegen_call(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    ; Args are stored in node.child0/child1/child2/child3 by parse_call_rest.
    let arg_ids = i64[16]
    if node.child_cnt > 0 { arg_ids[0] = codegen_expr(node.child0, jfn, bb) }
    if node.child_cnt > 1 { arg_ids[1] = codegen_expr(node.child1, jfn, bb) }
    if node.child_cnt > 2 { arg_ids[2] = codegen_expr(node.child2, jfn, bb) }
    if node.child_cnt > 3 { arg_ids[3] = codegen_expr(node.child3, jfn, bb) }
    let ins = Instr{}
    ins.op        = OP_CALL
    ins.operand0  = arg_ids[0]
    ins.operand1  = arg_ids[1]
    ins.operand2  = arg_ids[2]
    ins.operand3  = node.child_cnt
    ins.str_start = node.token
    ins.str_len   = node.token2
    ret emit(jfn, bb, &ins)
}

; ============================================================
; 6. JIR CODE GENERATOR
; ============================================================

fn field_addr_from_base(base_ptr: i64, foff: i64, jfn: &JirFunction, bb: i64) -> i64 {
    let off_id = emit_const(jfn, bb, TYPE_I64, foff)
    ret emit_binop(jfn, bb, OP_ADD, base_ptr, off_id)
}

fn codegen_addr_expr(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    if node.node_type == NODE_IDENT {
        ret codegen_expr(node, jfn, bb)
    }
    if node.node_type == NODE_BINOP and node.op == TOK_LBRACK {
        if node.child0.node_type == NODE_IDENT {
            let arr_sid = lookup_stype(jfn, node.child0.token)
            let base_ptr = codegen_expr(node.child0, jfn, bb)
            let idx = codegen_expr(node.child1, jfn, bb)
            let elem_sz = 8
            if arr_sid >= 0 {
                elem_sz = jfn.stab.sizes[arr_sid]
            }
            let sz_id = emit_const(jfn, bb, TYPE_I64, elem_sz)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
            ret emit_binop(jfn, bb, OP_ADD, base_ptr, byte_off)
        }
    }
    if node.node_type == NODE_FIELD {
        let slot = lookup_slot_name(jfn, node.token, node.child_cnt)
        let ld = Instr{}
        ld.op = OP_LOAD
        ld.operand0 = slot
        let base = emit(jfn, bb, &ld)
        let sid = node.data_type
        if sid < 0 {
            sid = lookup_stype_name(jfn, node.token, node.child_cnt)
        }
        let obj = base
        if node.child0 != null or node.op == 1 or node.op == 3 {
            let idx = 0
            if node.op == 1 {
                let islot = lookup_slot_name(jfn, node.children, node.param_cnt)
                let ild = Instr{}
                ild.op = OP_LOAD
                ild.operand0 = islot
                idx = emit(jfn, bb, &ild)
            } else if node.op == 3 {
                idx = emit_const(jfn, bb, TYPE_I64, node.children)
            } else {
                idx = codegen_expr(node.child0, jfn, bb)
            }
            ; Get element size from struct table using array's element type
            let elem_sid = lookup_struct(jfn.stab, jfn.src, node.token, node.child_cnt)
            let elem_sz = 8
            if elem_sid >= 0 and elem_sid < jfn.stab.cnt {
                elem_sz = jfn.stab.sizes[elem_sid]
            }
            let cins = Instr{}
            cins.op = OP_CONST
            cins.itype = TYPE_I64
            cins.imm = elem_sz
            let sz_id = emit(jfn, bb, &cins)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
            obj = emit_binop(jfn, bb, OP_ADD, base, byte_off)
        }
        ; Get element type from array allocation
        let elem_sid = node.data_type
        if elem_sid < 0 {
            ; Lookup struct type from array declaration
            elem_sid = lookup_struct(jfn.stab, jfn.src, node.token, node.child_cnt)
        }
        if elem_sid < 0 or elem_sid >= jfn.stab.cnt { ret obj }
        if node.token2 < 0 or node.imm <= 0 { ret obj }
        if node.token2 + node.imm > jfn.src_len { ret obj }
        let foff = lookup_field_off_any(jfn.stab, jfn.src, elem_sid, node.token2, node.imm)
        if foff < 0 { ret obj }
        ret field_addr_from_base(obj, foff, jfn, bb)
    }
    ret -1
}

fn codegen_fn(fn_node: &Node, jfn: &JirFunction) {
    jfn.var_cnt       = 0
    jfn.next_slot_off = 0
    jfn.param_cnt     = fn_node.child_cnt
    let pi = 0
    loop pi < fn_node.child_cnt {
        let ptok = Token{}
        ptok.str_start = fn_node.children[pi].token
        ptok.str_len   = fn_node.children[pi].token2
        let pslot = bind(jfn, ptok, fn_node.children[pi].data_type)
        jfn.param_slots[pi] = pslot
        pi = pi + 1
    }
    let entry_bb = create_block_live(jfn)
    codegen_block(fn_node.child0, jfn, entry_bb)
}

fn codegen_block(block: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let cur_bb = bb
    let i = 0
    loop i < block.child_cnt {
        cur_bb = codegen_stmt(block.children[i], jfn, cur_bb)
        i = i + 1
    }
    ret cur_bb
}

fn codegen_stmt(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let nt = node.node_type
    if nt == NODE_LET {
        ; Use g_let_val_buf directly instead of node.child0.
        ; jda0's ABI compiles `n.child0 = g_let_val_buf` as a field-name copy
        ; (n.child0 = g_let_val_buf.child0), not address-of. So child0 is broken.
        ; Calling codegen_expr(g_let_val_buf,...) makes jda0 pass &g_let_val_buf,
        ; which is what we actually want.
        let val_id = codegen_expr(g_let_val_buf, jfn, bb)
        ; node.token = str_start, node.token2 = str_len (stable integers, no dangling ptr)
        let slot = lookup_slot_name(jfn, node.token, node.token2)
        let out_slot = slot
        let out_stype = -1
        if g_let_val_buf.node_type == NODE_STRUCT_INIT {
            out_stype = lookup_struct(jfn.stab, jfn.src, g_let_val_buf.token.str_start, g_let_val_buf.token.str_len)
        }
        if g_let_val_buf.node_type == NODE_ARRAY_ALLOC and g_let_val_buf.imm == 0 and g_let_val_buf.token2 > 0 {
            out_stype = lookup_struct(jfn.stab, jfn.src, g_let_val_buf.token, g_let_val_buf.token2)
        }
        if node.op == 0 {
            ; let declaration introduces a new stack slot
            out_slot = bind_name(jfn, node.token, node.token2, out_stype)
        } else {
            ; assignment updates existing slot; undefined vars become implicit slots
            if slot == -1 { out_slot = bind_name(jfn, node.token, node.token2, out_stype) }
        }
        let st = Instr{}
        st.op       = OP_STORE
        st.operand0 = val_id
        st.operand1 = out_slot
        emit(jfn, bb, &st)
        ret bb
    }
    if nt == NODE_INDEX_STORE {
        let addr = 0
        if node.token > 0 and node.child_cnt > 0 {
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base = emit(jfn, bb, &bld)
            let idx = 0
            if node.op == 1 {
                let islot = lookup_slot_name(jfn, node.child2, node.child3)
                let ild = Instr{}
                ild.op = OP_LOAD
                ild.operand0 = islot
                idx = emit(jfn, bb, &ild)
            } else if node.op == 3 {
                idx = emit_const(jfn, bb, TYPE_I64, node.children)
            } else {
                idx = codegen_expr(node.child0, jfn, bb)
            }
            let sid = lookup_stype_name(jfn, node.token, node.child_cnt)
            let elem_sz = 8
            if sid >= 0 and sid < jfn.stab.cnt { elem_sz = jfn.stab.sizes[sid] }
            let sz = emit_const(jfn, bb, TYPE_I64, elem_sz)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz)
            addr = emit_binop(jfn, bb, OP_ADD, base, byte_off)
        } else {
            let iexpr = Node{}
            iexpr.node_type = NODE_BINOP
            iexpr.op = TOK_LBRACK
            iexpr.child0 = node.child0
            iexpr.child1 = node.child2
            addr = codegen_addr_expr(iexpr, jfn, bb)
        }
        let rhs = codegen_expr(node.child1, jfn, bb)
        let st = Instr{}
        st.op = OP_STORE_MEM
        st.operand0 = rhs
        st.operand1 = addr
        emit(jfn, bb, &st)
        ret bb
    }
    if nt == NODE_FIELD_STORE {
        let faddr = 0
        if node.data_type == 10 {
            ; base.field[idx] = rhs: get address of base.field, offset by idx*8
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base_ptr = emit(jfn, bb, &bld)
            let sid_b = lookup_stype_name(jfn, node.token, node.child_cnt)
            let foff = lookup_field_off_any(jfn.stab, jfn.src, sid_b, node.token2, node.imm)
            let field_base = base_ptr
            if foff >= 0 { field_base = field_addr_from_base(base_ptr, foff, jfn, bb) }
            let idx_v = 0
            let fidx_kind = node.children
            if fidx_kind == 1 {
                let islot = lookup_slot_name(jfn, node.child2, node.child3)
                let ild = Instr{}
                ild.op = OP_LOAD
                ild.operand0 = islot
                idx_v = emit(jfn, bb, &ild)
            }
            if fidx_kind == 3 {
                idx_v = emit_const(jfn, bb, TYPE_I64, node.child2)
            }
            if fidx_kind == 2 {
                idx_v = codegen_expr(node.child0, jfn, bb)
            }
            let sz_id = emit_const(jfn, bb, TYPE_I64, 8)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx_v, sz_id)
            let target = emit_binop(jfn, bb, OP_ADD, field_base, byte_off)
            let rhs_v = codegen_expr(node.child1, jfn, bb)
            let st = Instr{}
            st.op = OP_STORE_MEM
            st.operand0 = target
            st.operand1 = rhs_v
            emit(jfn, bb, &st)
            ret bb
        }
        if node.data_type == 1 {
            ; Direct indexed-lhs field address path to avoid fragile temporary nodes.
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base = emit(jfn, bb, &bld)
            let sid = lookup_stype_name(jfn, node.token, node.child_cnt)
            let islot = lookup_slot_name(jfn, node.child2, node.child3)
            let ild = Instr{}
            ild.op = OP_LOAD
            ild.operand0 = islot
            let idx = emit(jfn, bb, &ild)
            let elem_sz = 8
            if sid >= 0 and sid < jfn.stab.cnt { elem_sz = jfn.stab.sizes[sid] }
            let cins = Instr{}
            cins.op = OP_CONST
            cins.itype = TYPE_I64
            cins.imm = elem_sz
            let sz_id = emit(jfn, bb, &cins)
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
            let obj = emit_binop(jfn, bb, OP_ADD, base, byte_off)
            faddr = obj
            if sid >= 0 and sid < jfn.stab.cnt and node.token2 >= 0 and node.imm > 0 and node.token2 + node.imm <= jfn.src_len {
                let foff = lookup_field_off_any(jfn.stab, jfn.src, sid, node.token2, node.imm)
                if foff >= 0 { faddr = field_addr_from_base(obj, foff, jfn, bb) }
            }
        } else {
            let fexpr = Node{}
            fexpr.node_type = NODE_FIELD
            fexpr.token = node.token
            fexpr.child_cnt = node.child_cnt
            fexpr.op = node.data_type
            fexpr.children = 0
            fexpr.param_cnt = 0
            fexpr.token2 = node.token2
            fexpr.imm = node.imm
            fexpr.child0 = null
            fexpr.data_type = -1
            if node.data_type == 2 {
                fexpr.child0 = node.child0
            }
            if node.data_type == 3 {
                fexpr.children = node.child2
            }
            faddr = codegen_addr_expr(fexpr, jfn, bb)
        }
        let rhs = 0
        if node.op == 6 {
            ; Direct rhs indexed-field load: rhs_base[idx].field
            let rbslot = lookup_slot_name(jfn, node.children, node.param_cnt)
            let rbld = Instr{}
            rbld.op = OP_LOAD
            rbld.operand0 = rbslot
            let rbase = emit(jfn, bb, &rbld)
            let rsid = lookup_stype_name(jfn, node.children, node.param_cnt)
            let rislot = lookup_slot_name(jfn, node.child2, node.child3)
            let rild = Instr{}
            rild.op = OP_LOAD
            rild.operand0 = rislot
            let ridx = emit(jfn, bb, &rild)
            let relem = 8
            if rsid >= 0 and rsid < jfn.stab.cnt { relem = jfn.stab.sizes[rsid] }
            let rc = Instr{}
            rc.op = OP_CONST
            rc.itype = TYPE_I64
            rc.imm = relem
            let rsz = emit(jfn, bb, &rc)
            let rbyte = emit_binop(jfn, bb, OP_MUL, ridx, rsz)
            let robj = emit_binop(jfn, bb, OP_ADD, rbase, rbyte)
            let raddr = robj
            if rsid >= 0 and rsid < jfn.stab.cnt and node.child1 >= 0 and node.ret_type > 0 and node.child1 + node.ret_type <= jfn.src_len {
                let rfoff = lookup_field_off_any(jfn.stab, jfn.src, rsid, node.child1, node.ret_type)
                if rfoff >= 0 { raddr = field_addr_from_base(robj, rfoff, jfn, bb) }
            }
            let rld = Instr{}
            rld.op = OP_LOAD_MEM
            rld.operand0 = raddr
            rhs = emit(jfn, bb, &rld)
        } else if node.op == 5 {
            let rfield = Node{}
            rfield.node_type = NODE_FIELD
            rfield.token = node.children
            rfield.child_cnt = node.param_cnt
            rfield.token2 = node.child3
            rfield.imm = node.ret_type
            rfield.data_type = -1
            rfield.child0 = null
            rhs = codegen_expr(rfield, jfn, bb)
        } else if node.op == 3 {
            let slot = lookup_slot_name(jfn, node.children, node.param_cnt)
            let ld = Instr{}
            ld.op = OP_LOAD
            ld.operand0 = slot
            rhs = emit(jfn, bb, &ld)
        } else if node.op == 4 {
            rhs = emit_const(jfn, bb, TYPE_I64, node.ret_type)
        } else {
            rhs = codegen_expr(node.child1, jfn, bb)
        }
        let st = Instr{}
        st.op = OP_STORE_MEM
        st.operand0 = rhs
        st.operand1 = faddr
        emit(jfn, bb, &st)
        ret bb
    }
    if nt == NODE_RET {
        let val_id = 0
        if node.op == 2 {
            let bslot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let bld = Instr{}
            bld.op = OP_LOAD
            bld.operand0 = bslot
            let base = emit(jfn, bb, &bld)
            let sid = lookup_stype_name(jfn, node.token, node.child_cnt)
            let obj = base
            if node.ret_type == 1 or node.ret_type == 2 or node.ret_type == 3 {
                let idx = 0
                if node.ret_type == 1 {
                    let islot = lookup_slot_name(jfn, node.children, node.param_cnt)
                    let ild = Instr{}
                    ild.op = OP_LOAD
                    ild.operand0 = islot
                    idx = emit(jfn, bb, &ild)
                } else if node.ret_type == 3 {
                    idx = emit_const(jfn, bb, TYPE_I64, node.children)
                } else {
                    idx = codegen_expr(node.child1, jfn, bb)
                }
                let elem_sz = 8
                if sid >= 0 and sid < jfn.stab.cnt { elem_sz = jfn.stab.sizes[sid] }
                let cins = Instr{}
                cins.op = OP_CONST
                cins.itype = TYPE_I64
                cins.imm = elem_sz
                let sz_id = emit(jfn, bb, &cins)
                let byte_off = emit_binop(jfn, bb, OP_MUL, idx, sz_id)
                obj = emit_binop(jfn, bb, OP_ADD, base, byte_off)
            }
            let addr = obj
            if sid >= 0 and sid < jfn.stab.cnt and node.token2 >= 0 and node.imm > 0 and node.token2 + node.imm <= jfn.src_len {
                let foff = lookup_field_off_any(jfn.stab, jfn.src, sid, node.token2, node.imm)
                if foff >= 0 { addr = field_addr_from_base(obj, foff, jfn, bb) }
            }
            let fld = Instr{}
            fld.op = OP_LOAD_MEM
            fld.operand0 = addr
            val_id = emit(jfn, bb, &fld)
        } else if node.op == 3 {
            let slot = lookup_slot_name(jfn, node.token, node.child_cnt)
            let ld = Instr{}
            ld.op = OP_LOAD
            ld.operand0 = slot
            val_id = emit(jfn, bb, &ld)
        } else if node.op == 4 {
            val_id = emit_const(jfn, bb, TYPE_I64, node.imm)
        } else {
            val_id = codegen_expr(node.child0, jfn, bb)
        }
        let ret_ins = Instr{}
        ret_ins.op = OP_RET
        ret_ins.operand0 = val_id
        emit(jfn, bb, &ret_ins)
        ret bb
    }
    if nt == NODE_PRINT {
        ; Check op field to determine argument type
        ; op=7 (NODE_INT) -> integer literal stored in node.imm
        ; otherwise -> string or other expression in node.child0
        if node.op == 7 {
            ; print(int_literal) -> emit print_int with immediate value
            let val_id = emit_const(jfn, bb, TYPE_I64, node.imm)
            emit_print_int(jfn, bb, val_id)
        } else {
            ; print(str) or print(variable) -> SYS_WRITE(1, str_ptr, str_len)
            let str_id = codegen_expr(node.child0, jfn, bb)
            let fd_id  = emit_const(jfn, bb, TYPE_I64, 1)        ; stdout fd
            let len_ins1 = Instr{}
            len_ins1.op = OP_STRLEN
            len_ins1.operand0 = str_id
            let len_id = emit(jfn, bb, &len_ins1)
            emit_syscall3(jfn, bb, 1, fd_id, str_id, len_id)     ; SYS_WRITE=1
        }
        ret bb
    }
    if nt == NODE_IF {
        ret codegen_if(node, jfn, bb)
    }
    if nt == NODE_LOOP {
        ret codegen_loop(node, jfn, bb)
    }
    if nt == NODE_SYSCALL {
        codegen_syscall(node, jfn, bb)
        ret bb
    }
    if nt == NODE_CALL {
        codegen_call(node, jfn, bb)
        ret bb
    }
    ret bb
}

fn codegen_expr(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    if node.node_type == NODE_INT {
        ret emit_const(jfn, bb, TYPE_I64, node.imm)
    }
    if node.node_type == NODE_STR {
        ret emit_strlit_raw(jfn, bb, node.token.str_start, node.token.str_len)
    }
    if node.node_type == NODE_IDENT {
        let slot = lookup(jfn, node.token)
        if slot == -1 {
            ; Check constant table
            let cval = lookup_const(jfn.src, node.token.str_start, node.token.str_len)
            if cval != -1 {
                ret emit_const(jfn, bb, TYPE_I64, cval)
            }
        }
        let ld = Instr{}
        ld.op       = OP_LOAD
        ld.operand0 = slot
        ret emit(jfn, bb, &ld)
    }
    if node.node_type == NODE_STRUCT_INIT {
        ; Allocation for struct literals is implemented in other roadmap items.
        ; Keep parser acceptance so struct syntax can coexist with field support.
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    if node.node_type == NODE_ARRAY_ALLOC {
        let elem_sz = node.imm
        if elem_sz <= 0 and node.token2 > 0 {
            let sid = lookup_struct(jfn.stab, jfn.src, node.token, node.token2)
            if sid >= 0 and sid < jfn.stab.cnt {
                elem_sz = jfn.stab.sizes[sid]
            }
        }
        if elem_sz <= 0 { elem_sz = 8 }
        ; node.child0 may be null (jda0 ABI issue: child0 field copy, not address).
        ; Fall back to g_let_cnt_buf which always holds the count expression.
        let cnt = codegen_expr(g_let_cnt_buf, jfn, bb)
        let esz = emit_const(jfn, bb, TYPE_I64, elem_sz)
        let bytes = emit_binop(jfn, bb, OP_MUL, cnt, esz)
        let c4095 = emit_const(jfn, bb, TYPE_I64, 4095)
        let c4096 = emit_const(jfn, bb, TYPE_I64, 4096)
        let padded = emit_binop(jfn, bb, OP_ADD, bytes, c4095)
        let page_bytes = emit_binop(jfn, bb, OP_DIV, padded, c4096)
        let page_sz = emit_const(jfn, bb, TYPE_I64, 4096)
        let alloc_sz = emit_binop(jfn, bb, OP_MUL, page_bytes, page_sz)
        let ins = Instr{}
        ins.op = OP_ALLOC
        ins.operand0 = alloc_sz
        ret emit(jfn, bb, &ins)
    }
    if node.node_type == NODE_ADDR {
        if node.child0.node_type == NODE_IDENT {
            let slot = lookup(jfn, node.child0.token)
            let ins = Instr{}
            ins.op = OP_ADDR
            ins.operand0 = slot
            ret emit(jfn, bb, &ins)
        }
        ret codegen_addr_expr(node.child0, jfn, bb)
    }
    if node.node_type == NODE_DEREF {
        let ptr_id = codegen_expr(node.child0, jfn, bb)
        let ld = Instr{}
        ld.op = OP_LOAD_MEM
        ld.operand0 = ptr_id
        ret emit(jfn, bb, &ld)
    }
    if node.node_type == NODE_FIELD {
        let addr = codegen_addr_expr(node, jfn, bb)
        let ld = Instr{}
        ld.op = OP_LOAD_MEM
        ld.operand0 = addr
        ret emit(jfn, bb, &ld)
    }
    if node.node_type == NODE_BINOP {
        if node.op == TOK_LBRACK {
            let addr = codegen_addr_expr(node, jfn, bb)
            let ld = Instr{}
            ld.op = OP_LOAD_MEM
            ld.operand0 = addr
            ret emit(jfn, bb, &ld)
        }
        ; Handle unary NOT (bitwise NOT)
        if node.op == TOK_TILDE {
            let a = codegen_expr(node.child0, jfn, bb)
            ; For now, implement bitwise-not as -1 - x
            ; So just return a as-is (this is a limitation)
            ret a
        }
        let a  = codegen_expr(node.child0, jfn, bb)
        let b  = codegen_expr(node.child1, jfn, bb)
        let op = tok_to_jir_op(node.op)
        ret emit_binop(jfn, bb, op, a, b)
    }
    if node.node_type == NODE_CALL {
        ret codegen_call(node, jfn, bb)
    }
    if node.node_type == NODE_SYSCALL {
        ret codegen_syscall(node, jfn, bb)
    }
    ret -1
}

; -------------------------------------------------------
; Inline compile functions: parse + codegen in one pass.
; Avoids AST dangling-pointer issues from jda0's struct-return ABI.
; -------------------------------------------------------

; Forward declarations needed (compile_if_inline calls compile_stmts_inline
; and vice versa - handled by ordering: stmts first, then if/loop).
fn legacy_compile_stmts_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;
fn legacy_compile_if_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;
fn legacy_compile_loop_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;

; Forward declarations for inline codegen expressions
fn live_codegen_expr_inline_old(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;
fn live_codegen_binop_inline(toks: &Token, pos: &i64, min_prec: i32, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;
fn live_codegen_postfix_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;
fn live_codegen_primary_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;
fn live_codegen_call_inline(toks: &Token, pos: &i64, name: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64;

fn live_codegen_expr_inline_old(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    ret live_codegen_binop_inline(toks, pos, 0, stab, src, jfn, bb)
}

fn live_codegen_binop_inline(toks: &Token, pos: &i64, min_prec: i32, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = live_codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
    loop {
        let op   = tok_type_at(toks, pos[0])
        let prec = op_precedence(op)
        if prec == 0 { ret left_id }
        if prec < min_prec { ret left_id }
        pos[0] = pos[0] + 1
        let right_id = live_codegen_binop_inline(toks, pos, prec + 1, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn live_codegen_postfix_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let start_pos = pos[0]
    let expr_id = live_codegen_primary_inline(toks, pos, stab, src, jfn, bb)
    let cur_stype = TYPE_I64
    if tok_type_at(toks, start_pos) == TOK_IDENT {
        cur_stype = lookup_stype_name(jfn, tok_str_start_at(toks, start_pos), tok_str_len_at(toks, start_pos))
    }
    loop {
        let tok_type = tok_type_at(toks, pos[0])
        if tok_type == TOK_DOT {
            pos[0] = pos[0] + 1
            let field = toks[pos[0]]
            expect(toks, pos, TOK_IDENT)
            let sid = cur_stype
            let fi = lookup_field_idx_any(stab, src, sid, field.str_start, field.str_len)
            if fi == -1 {
                ret expr_id
            }
            let off_id = emit_const(jfn, bb, TYPE_I64, stab.foffs[fi])
            let addr = emit_binop(jfn, bb, OP_ADD, expr_id, off_id)
            cur_stype = stab.ftypes[fi]
            if stab.fis_array[fi] == 1 {
                expr_id = addr
            } else {
                let ld = Instr{}
                ld.op = OP_LOAD_MEM
                ld.operand0 = addr
                expr_id = emit(jfn, bb, &ld)
            }
        } else if tok_type == TOK_LBRACK {
            pos[0] = pos[0] + 1
            let idx_id = live_codegen_expr_inline(toks, pos, stab, src, jfn, bb)
            expect(toks, pos, TOK_RBRACK)
            let elem_sz = emit_const(jfn, bb, TYPE_I64, 8) ; Assuming i64 array
            let byte_off = emit_binop(jfn, bb, OP_MUL, idx_id, elem_sz)
            let addr = emit_binop(jfn, bb, OP_ADD, expr_id, byte_off)
            let ld = Instr{}
            ld.op = OP_LOAD_MEM
            ld.operand0 = addr
            expr_id = emit(jfn, bb, &ld)
        } else {
            ret expr_id
        }
    }
    ret expr_id
}

fn live_codegen_primary_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let t = toks[pos[0]]
    if t.type == TOK_INT {
        pos[0] = pos[0] + 1
        ret emit_const(jfn, bb, TYPE_I64, t.imm)
    }
    if t.type == TOK_STR {
        pos[0] = pos[0] + 1
        ret emit_strlit_raw(jfn, bb, t.str_start, t.str_len)
    }
    if t.type == TOK_IDENT {
        pos[0] = pos[0] + 1
        if toks[pos[0]].type == TOK_LPAREN {
            ret live_codegen_call_inline(toks, pos, &t, stab, src, jfn, bb)
        }
        pos[0] = pos[0] - 1 ; backtrack
        let slot = lookup(jfn, &t)
        if slot == -1 {
            ; Check constant table
            let cval = lookup_const(src, t.str_start, t.str_len)
            if cval != -1 {
                pos[0] = pos[0] + 1
                ret emit_const(jfn, bb, TYPE_I64, cval)
            }
            let gi = lookup_global2(t.str_start, t.str_len, src)
            if gi != -1 {
                pos[0] = pos[0] + 1
                let addr = emit_gaddr(jfn, bb, gi)
                if g_glob_is_addr[gi] == 1 {
                    ret addr
                }
                let ldg = Instr{}
                ldg.op = OP_LOAD_MEM
                ldg.operand0 = addr
                ret emit(jfn, bb, &ldg)
            }
            if str_match(src, t.str_start, t.str_start, t.str_len) == 1 {
                print("UNRES_IDENT ")
                print_span(src, t.str_start, t.str_len)
                print("\n")
            }
            ret -1
        }
        pos[0] = pos[0] + 1
        let ld = Instr{}
        ld.op       = OP_LOAD
        ld.operand0 = slot
        ret emit(jfn, bb, &ld)
    }
    if t.type == TOK_LPAREN {
        pos[0] = pos[0] + 1
        let inner_id = live_codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        expect(toks, pos, TOK_RPAREN)
        ret inner_id
    }
    ret -1
}

fn live_codegen_call_inline(toks: &Token, pos: &i64, name: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(toks, pos, TOK_LPAREN)
    if name.str_len == 11 and streq(src, name.str_start, 11, "alloc_pages") == 1 {
        if tok_type_at(toks, pos[0]) == TOK_INT and peek_token(toks, pos[0]) == TOK_RPAREN {
            let pages = tok_imm_at(toks, pos[0])
            pos[0] = pos[0] + 1
            expect(toks, pos, TOK_RPAREN)
            let alloc_sz = emit_const(jfn, bb, TYPE_I64, pages * 4096)
            let ins = Instr{}
            ins.op = OP_ALLOC
            ins.operand0 = alloc_sz
            ret emit(jfn, bb, &ins)
        }
    }
    let arg_cnt = 0
    let arg0 = -1
    let arg1 = -1
    let arg2 = -1
    let arg3 = -1
    let arg4 = -1
    let arg5 = -1
    loop tok_type_at(toks, pos[0]) != TOK_RPAREN and tok_type_at(toks, pos[0]) != TOK_EOF {
        let pos_before = pos[0]
        let a_id = live_codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if pos[0] == pos_before {
            pos[0] = pos_before + 1
            a_id = emit_const(jfn, bb, TYPE_I64, 0)
        }
        if arg_cnt == 0 {
            arg0 = a_id
        } else if arg_cnt == 1 {
            arg1 = a_id
        } else if arg_cnt == 2 {
            arg2 = a_id
        } else if arg_cnt == 3 {
            arg3 = a_id
        } else if arg_cnt == 4 {
            arg4 = a_id
        } else if arg_cnt == 5 {
            arg5 = a_id
        }
        arg_cnt = arg_cnt + 1
        if arg_cnt > 6 { panic("call arg overflow") }
        if tok_type_at(toks, pos[0]) == TOK_COMMA {
            pos[0] = pos[0] + 1
        }
    }
    expect(toks, pos, TOK_RPAREN)

    if name.str_len == 11 and streq(src, name.str_start, 11, "alloc_pages") == 1 {
        let pages_id = arg0
        if pages_id == -1 {
            pages_id = emit_const(jfn, bb, TYPE_I64, 0)
        }
        let page_sz = emit_const(jfn, bb, TYPE_I64, 4096)
        let alloc_sz = emit_binop(jfn, bb, OP_MUL, pages_id, page_sz)
        let ins = Instr{}
        ins.op = OP_ALLOC
        ins.operand0 = alloc_sz
        ret emit(jfn, bb, &ins)
    }

    let ins = Instr{}
    ins.op        = OP_CALL
    ins.operand0  = arg0
    ins.operand1  = arg1
    ins.operand2  = arg2
    ins.operand3  = arg_cnt
    ins.bb_target0 = arg3
    ins.bb_target1 = arg4
    ins.imm        = arg5
    ins.str_start = name.str_start
    ins.str_len   = name.str_len
    ret emit(jfn, bb, &ins)
}


fn legacy_compile_stmts_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let cur = bb
    loop toks[pos[0]].type != TOK_RBRACE and toks[pos[0]].type != TOK_EOF {
        let pos_save = pos[0]
        if toks[pos[0]].type == TOK_IF {
            cur = legacy_compile_if_inline(toks, pos, stab, src, jfn, cur)
        } else {
            if toks[pos[0]].type == TOK_LOOP {
                cur = legacy_compile_loop_inline(toks, pos, stab, src, jfn, cur)
            } else {
                let st = Node{}
                let st_t = toks[pos[0]].type
                if st_t == TOK_LET {
                    st = parse_let(toks, pos, stab, src)
                } else if st_t == TOK_IF {
                    st = parse_if(toks, pos, stab, src)
                } else if st_t == TOK_LOOP {
                    st = parse_loop(toks, pos, stab, src)
                } else if st_t == TOK_RET {
                    st = parse_ret(toks, pos, stab, src)
                } else if st_t == TOK_PRINT {
                    st = parse_print(toks, pos, stab, src)
                } else {
                    st = parse_expr_stmt(toks, pos, stab, src)
                }
                if pos[0] == pos_save {
                    if toks[pos[0]].type == TOK_LBRACE {
                        pos[0] = pos[0] + 1
                        let bd = 1
                        loop bd > 0 and toks[pos[0]].type != TOK_EOF {
                            if toks[pos[0]].type == TOK_LBRACE { bd = bd + 1 }
                            if toks[pos[0]].type == TOK_RBRACE { bd = bd - 1 }
                            pos[0] = pos[0] + 1
                        }
                    } else {
                        pos[0] = pos[0] + 1
                    }
                } else {
                    cur = codegen_stmt(st, jfn, cur)
                }
            }
        }
    }
    ret cur
}

fn legacy_compile_if_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(toks, pos, TOK_IF)
    let then_bb  = create_block_live(jfn)
    let else_bb  = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    let cond_id  = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    emit_br(jfn, bb, cond_id, then_bb, else_bb)
    expect(toks, pos, TOK_LBRACE)
    let then_end = legacy_compile_stmts_inline(toks, pos, stab, src, jfn, then_bb)
    expect(toks, pos, TOK_RBRACE)
    emit_jmp(jfn, then_end, merge_bb)
    ; Handle else / else-if chain
    if toks[pos[0]].type == TOK_ELSE {
        pos[0] = pos[0] + 1
        if toks[pos[0]].type == TOK_IF {
            ; else-if: recursively compile
            let else_end = legacy_compile_if_inline(toks, pos, stab, src, jfn, else_bb)
            emit_jmp(jfn, else_end, merge_bb)
        } else {
            ; plain else block
            expect(toks, pos, TOK_LBRACE)
            let else_end = legacy_compile_stmts_inline(toks, pos, stab, src, jfn, else_bb)
            expect(toks, pos, TOK_RBRACE)
            emit_jmp(jfn, else_end, merge_bb)
        }
    } else {
        emit_jmp(jfn, else_bb, merge_bb)
    }
    ret merge_bb
}

fn legacy_compile_loop_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(toks, pos, TOK_LOOP)
    let header_bb = create_block_live(jfn)
    let body_bb   = create_block_live(jfn)
    let exit_bb   = create_block_live(jfn)
    emit_jmp(jfn, bb, header_bb)
    let cond_id = codegen_expr_inline(toks, pos, stab, src, jfn, header_bb)
    emit_br(jfn, header_bb, cond_id, body_bb, exit_bb)
    expect(toks, pos, TOK_LBRACE)
    let body_end = legacy_compile_stmts_inline(toks, pos, stab, src, jfn, body_bb)
    expect(toks, pos, TOK_RBRACE)
    emit_jmp(jfn, body_end, header_bb)
    ret exit_bb
}

fn codegen_if(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let then_bb  = create_block_live(jfn)
    let else_bb  = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    if node.child0 != 0 {
        let cond_id  = codegen_expr(node.child0, jfn, bb)
        emit_br(jfn, bb, cond_id, then_bb, else_bb)
        emit_jmp(jfn, then_bb, merge_bb)
        emit_jmp(jfn, else_bb, merge_bb)
    } else {
        ; Block bodies are skipped during parsing, so child0 is not set.
        ; Just jump straight to merge if no condition.
        emit_jmp(jfn, bb, merge_bb)
    }
    ret merge_bb
}

fn codegen_loop(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let header_bb = create_block_live(jfn)
    let body_bb   = create_block_live(jfn)
    let exit_bb   = create_block_live(jfn)
    emit_jmp(jfn, bb, header_bb)
    if node.child0 != 0 {
        let cond_id = codegen_expr(node.child0, jfn, header_bb)
        emit_br(jfn, header_bb, cond_id, body_bb, exit_bb)
    } else {
        ; Block bodies are skipped during parsing, so child0 is not set.
        ; Create a dummy always-true condition.
        let dummy_cond = emit_const(jfn, header_bb, TYPE_I64, 1)
        emit_br(jfn, header_bb, dummy_cond, body_bb, exit_bb)
    }
    emit_jmp(jfn, body_bb, header_bb)
    ret exit_bb
}

fn codegen_syscall(node: &Node, jfn: &JirFunction, bb: i64) -> i64 {
    let nr   = codegen_expr(node.child0, jfn, bb)
    let arg0 = codegen_expr(node.child1, jfn, bb)
    let arg1 = codegen_expr(node.child2, jfn, bb)
    let arg2 = codegen_expr(node.child3, jfn, bb)
    ret emit_syscall_raw(jfn, bb, nr, arg0, arg1, arg2)
}

fn tok_to_jir_op(tok: i32) -> i32 {
    if tok == TOK_PLUS  { ret OP_ADD }
    if tok == TOK_MINUS { ret OP_SUB }
    if tok == TOK_STAR  { ret OP_MUL }
    if tok == TOK_SLASH { ret OP_DIV }
    if tok == TOK_EQEQ  { ret OP_CMP_EQ }
    if tok == TOK_NEQ   { ret OP_CMP_NE }
    if tok == TOK_LT    { ret OP_CMP_LT }
    if tok == TOK_GT    { ret OP_CMP_GT }
    if tok == TOK_LTE   { ret OP_CMP_LTE }
    if tok == TOK_GTE   { ret OP_CMP_GTE }
    if tok == TOK_AND or tok == TOK_AMP { ret OP_AND }  ; Both logical and bitwise AND
    if tok == TOK_OR or tok == TOK_PIPE { ret OP_OR }  ; Both logical and bitwise OR
    if tok == TOK_TILDE { ret OP_AND }  ; Bitwise NOT - temporary: use AND (will be fixed later)
    if tok == TOK_SHR { ret OP_SHR }
    if tok == TOK_SHL { ret OP_SHL }
    ret -1
}

; ============================================================
; 7. OPTIMISATION PASSES
; ============================================================

fn find_const(jfn: &JirFunction, val_id: i64) -> ConstVal {
    if val_id < 0 {
        let cv = ConstVal{}
        cv.found = 0
        ret cv
    }
    if val_id >= jfn.next_id {
        let cv = ConstVal{}
        cv.found = 0
        ret cv
    }
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let iid = jfn.blocks[bi].instrs[ii].id
            let iop = jfn.blocks[bi].instrs[ii].op
            if iid == val_id and iop == OP_CONST {
                let cv = ConstVal{}
                cv.found = 1
                cv.val   = jfn.blocks[bi].instrs[ii].imm
                ret cv
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    let cv = ConstVal{}
    cv.found = 0
    ret cv
}

fn fold_constants(jfn: &JirFunction) {
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let iop = jfn.blocks[bi].instrs[ii].op
            if iop == OP_ADD or iop == OP_SUB or
               iop == OP_MUL or iop == OP_DIV or
               iop == OP_SHR or iop == OP_SHL {
                let ca = find_const(jfn, jfn.blocks[bi].instrs[ii].operand0)
                let cb = find_const(jfn, jfn.blocks[bi].instrs[ii].operand1)
                if ca.found == 1 and cb.found == 1 {
                    let result = 0
                    if iop == OP_ADD { result = ca.val + cb.val }
                    if iop == OP_SUB { result = ca.val - cb.val }
                    if iop == OP_MUL { result = ca.val * cb.val }
                    if iop == OP_DIV and cb.val != 0 {
                        result = ca.val / cb.val
                    }
                    if iop == OP_SHR { result = ca.val >> cb.val }
                    if iop == OP_SHL { result = ca.val << cb.val }
                    jfn.blocks[bi].instrs[ii].op  = OP_CONST
                    jfn.blocks[bi].instrs[ii].imm = result
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn dce(jfn: &JirFunction) {
    let used = i32[4096]
    let bi = 0
    ; Mark all consumed operands and side-effecting ops
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            ; Access fields directly - do NOT copy Instr by value
            let o0 = jfn.blocks[bi].instrs[ii].operand0
            let o1 = jfn.blocks[bi].instrs[ii].operand1
            let o2 = jfn.blocks[bi].instrs[ii].operand2
            let o3 = jfn.blocks[bi].instrs[ii].operand3
            let op = jfn.blocks[bi].instrs[ii].op
            let id = jfn.blocks[bi].instrs[ii].id
            if op == OP_ADD or op == OP_SUB or op == OP_MUL or op == OP_DIV or
               op == OP_CMP_EQ or op == OP_CMP_NE or op == OP_CMP_LT or op == OP_CMP_GT or
               op == OP_CMP_LTE or op == OP_CMP_GTE or op == OP_AND or op == OP_OR or
               op == OP_SHR or op == OP_SHL {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
            }
            if op == OP_RET or op == OP_BR or op == OP_STRLEN or op == OP_PRINT_INT {
                if o0 >= 0 { used[o0] = 1 }
            }
            if op == OP_STORE {
                if o0 >= 0 { used[o0] = 1 }
            }
            if op == OP_SYSCALL {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
                if o2 >= 0 { used[o2] = 1 }
                if o3 >= 0 { used[o3] = 1 }
            }
            if op == OP_ALLOC {
                if o0 >= 0 { used[o0] = 1 }
            }
            if op == OP_CALL {
                if o0 >= 0 { used[o0] = 1 }
                if o1 >= 0 { used[o1] = 1 }
                if o2 >= 0 { used[o2] = 1 }
            }
            if op == OP_RET     { used[id] = 1 }
            if op == OP_BR      { used[id] = 1 }
            if op == OP_JMP     { used[id] = 1 }
            if op == OP_SYSCALL { used[id] = 1 }
            if op == OP_ALLOC   { used[id] = 1 }
            if op == OP_CALL    { used[id] = 1 }
            if op == OP_STORE   { used[id] = 1 }
            if op == OP_PRINT_INT { used[id] = 1 }
            if op == OP_ARGV_BASE { used[id] = 1 }
            ii = ii + 1
        }
        bi = bi + 1
    }
    ; Mark unused instructions dead
    bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let id2 = jfn.blocks[bi].instrs[ii].id
            if used[id2] == 0 {
                jfn.blocks[bi].instrs[ii].dead = 1
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

; ============================================================
; 8. GREEDY REGISTER ALLOCATOR
; ============================================================
; Pool: rax rcx rdx rbx rsi rdi r10 r11

fn regalloc_init(ra: &RegAlloc) {
    ra.pool[0] = PHYS_RAX
    ra.pool[1] = PHYS_RCX
    ra.pool[2] = PHYS_RDX
    ra.pool[3] = PHYS_RBX
    ra.pool[4] = PHYS_RSI
    ra.pool[5] = PHYS_RDI
    ra.pool[6] = PHYS_R10
    ra.pool[7] = PHYS_R11
    let i = 0
    loop i < N_ALLOC_REGS {
        ra.reg2val[i] = -1
        i = i + 1
    }
    let j = 0
    loop j < 4096 {
        ra.val2reg[j] = -1
        ra.spill_off[j] = -1
        j = j + 1
    }
    ; Spill slots start at 8 (growing up). Local variable slots now start at
    ; jfn.next_slot_off = 65536 (set in function reset), so no collision.
    ra.sp_top = 8
}

fn regalloc_alloc(ra: &RegAlloc, out: &i8, pos: &i64, val_id: i64) -> i32 {
    if val_id < 0 { ret ra.pool[0] }
    if val_id >= 4096 { ret ra.pool[0] }
    let i = 0
    loop i < N_ALLOC_REGS {
        if ra.reg2val[i] == -1 {
            ra.reg2val[i] = val_id
            ra.val2reg[val_id] = i
            ret ra.pool[i]
        }
        i = i + 1
    }
    ; Spill pool[0] (oldest)
    let victim = ra.reg2val[0]
    let spill_reg = ra.pool[0]
    if victim < 0 { ret spill_reg }
    if victim >= 4096 { ret spill_reg }
    let next_sp = ra.sp_top + 8
    ra.sp_top = next_sp
    ra.spill_off[victim]  = next_sp
    emit_store_spill(out, pos, next_sp, spill_reg)
    ra.val2reg[victim]    = -1
    ra.reg2val[0]         = val_id
    ra.val2reg[val_id]    = 0
    ret spill_reg
}

fn regalloc_get(ra: &RegAlloc, val_id: i64) -> i32 {
    if val_id < 0 { ret -1 }
    if val_id >= 4096 { ret -1 }
    let idx = ra.val2reg[val_id]
    if idx == -1 { ret -1 }
    if idx < 0 { ret -1 }
    if idx >= N_ALLOC_REGS { ret -1 }
    ret ra.pool[idx]
}

fn regalloc_free(ra: &RegAlloc, val_id: i64) {
    if val_id < 0 { ret ok(0) }
    if val_id >= 4096 { ret ok(0) }
    let idx = ra.val2reg[val_id]
    if idx == -1 { ret ok(0) }
    if idx < 0 { ret ok(0) }
    if idx >= 8 { ret ok(0) }
    ra.reg2val[idx]    = -1
    ra.val2reg[val_id] = -1
}

fn mark_use(ctx: &LowerCtx, val_id: i64) {
    if val_id < 0 { ret ok(0) }
    if val_id >= 4096 { ret ok(0) }
    let cur = ctx.use_cnt[val_id]
    ctx.use_cnt[val_id] = cur + 1
}

fn consume_use(ctx: &LowerCtx, val_id: i64) {
    if val_id < 0 { ret ok(0) }
    if val_id >= 4096 { ret ok(0) }
    let cur = ctx.use_cnt[val_id]
    let next = cur - 1
    ctx.use_cnt[val_id] = next
    if next <= 0 {
        regalloc_free(ctx.ra, val_id)
    }
}

; ============================================================
; 9. X86-64 EMISSION HELPERS
; ============================================================

fn emit_byte(out: &i8, pos: &i64, b: i8) {
    let p = pos[0]
    if p < 0 or p >= 1048576 { panic("emit byte overflow") }
    out[p] = b
    pos[0] = p + 1
}

fn poke_byte(buf: &i8, off: i64, val: i8) {
    buf[off] = val
}

fn emit_i32_le(out: &i8, pos: &i64, val: i64) {
    emit_byte(out, pos, val & 0xFF)
    emit_byte(out, pos, (val >> 8)  & 0xFF)
    emit_byte(out, pos, (val >> 16) & 0xFF)
    emit_byte(out, pos, (val >> 24) & 0xFF)
}

fn emit_i64_le(out: &i8, pos: &i64, val: i64) {
    let i = 0
    loop i < 8 {
        emit_byte(out, pos, val & 0xFF)
        val = val >> 8
        i = i + 1
    }
}

; REX prefix: 0100WRXB
fn rex_byte(w: i32, r: i32, x: i32, b: i32) -> i8 {
    ret 0x40 | (w << 3) | (r << 2) | (x << 1) | b
}

; ModRM byte for reg-reg: mod=11
fn modrm_rr(reg: i32, rm: i32) -> i8 {
    ret 0xC0 | ((reg & 7) << 3) | (rm & 7)
}

; Emit REX.W for two registers (sets R if reg>=8, B if rm>=8)
fn emit_rex_w_rr(out: &i8, pos: &i64, reg: i32, rm: i32) {
    let r = 0
    let b = 0
    if reg >= 8 { r = 1 }
    if rm  >= 8 { b = 1 }
    emit_byte(out, pos, rex_byte(1, r, 0, b))
}

; MOV r64, r/m64 (copy rm -> reg):  REX.W 8B /r
fn emit_mov_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, dst, src)
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, modrm_rr(dst, src))
}

; MOV r64, imm64:  REX.W B8+rd imm64
fn emit_mov_imm64(out: &i8, pos: &i64, dst: i32, imm: i64) {
    let b = 0
    if dst >= 8 { b = 1 }
    emit_byte(out, pos, rex_byte(1, 0, 0, b))
    emit_byte(out, pos, 0xB8 + (dst & 7))
    emit_i64_le(out, pos, imm)
}

; ADD r/m64, r64:  REX.W 01 /r
fn emit_add_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x01)
    emit_byte(out, pos, modrm_rr(src, dst))
}

; SUB r/m64, r64:  REX.W 29 /r
fn emit_sub_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x29)
    emit_byte(out, pos, modrm_rr(src, dst))
}

; AND r/m64, r64:  REX.W 21 /r
fn emit_and_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x21)
    emit_byte(out, pos, modrm_rr(src, dst))
}

; OR r/m64, r64:  REX.W 09 /r
fn emit_or_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, src, dst)
    emit_byte(out, pos, 0x09)
    emit_byte(out, pos, modrm_rr(src, dst))
}

; SHR r64, imm8:  REX.W C1 /5 imm8  (logical right shift by immediate)
fn emit_shr_imm8(out: &i8, pos: &i64, dst: i32, imm: i32) {
    emit_byte(out, pos, 0x48 | (dst >> 3))
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE8 | (dst & 7))
    emit_byte(out, pos, imm & 0xFF)
}

; SHL r64, imm8:  REX.W C1 /4 imm8  (left shift by immediate)
fn emit_shl_imm8(out: &i8, pos: &i64, dst: i32, imm: i32) {
    emit_byte(out, pos, 0x48 | (dst >> 3))
    emit_byte(out, pos, 0xC1)
    emit_byte(out, pos, 0xE0 | (dst & 7))
    emit_byte(out, pos, imm & 0xFF)
}

; SHR r64, CL:  REX.W D3 /5  (logical right shift by CL)
fn emit_shr_rcl(out: &i8, pos: &i64, dst: i32) {
    emit_byte(out, pos, 0x48 | (dst >> 3))
    emit_byte(out, pos, 0xD3)
    emit_byte(out, pos, 0xE8 | (dst & 7))
}

; SHL r64, CL:  REX.W D3 /4  (left shift by CL)
fn emit_shl_rcl(out: &i8, pos: &i64, dst: i32) {
    emit_byte(out, pos, 0x48 | (dst >> 3))
    emit_byte(out, pos, 0xD3)
    emit_byte(out, pos, 0xE0 | (dst & 7))
}

; IMUL r64, r/m64:  REX.W 0F AF /r
fn emit_imul_rr(out: &i8, pos: &i64, dst: i32, src: i32) {
    emit_rex_w_rr(out, pos, dst, src)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xAF)
    emit_byte(out, pos, modrm_rr(dst, src))
}

; CQO: sign-extend rax into rdx:rax  (48 99)
fn emit_cqo(out: &i8, pos: &i64) {
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x99)
}

; IDIV r/m64:  REX.W F7 /7
fn emit_idiv_r(out: &i8, pos: &i64, divisor: i32) {
    let b = 0
    if divisor >= 8 { b = 1 }
    emit_byte(out, pos, rex_byte(1, 0, 0, b))
    emit_byte(out, pos, 0xF7)
    emit_byte(out, pos, modrm_rr(7, divisor))
}

; CMP r/m64, r64:  REX.W 39 /r
fn emit_cmp_rr(out: &i8, pos: &i64, a: i32, b: i32) {
    emit_rex_w_rr(out, pos, b, a)
    emit_byte(out, pos, 0x39)
    emit_byte(out, pos, modrm_rr(b, a))
}

; CMP r64, 0:  REX.W 83 /7 00
fn emit_cmp_zero(out: &i8, pos: &i64, r: i32) {
    let b = 0
    if r >= 8 { b = 1 }
    emit_byte(out, pos, rex_byte(1, 0, 0, b))
    emit_byte(out, pos, 0x83)
    emit_byte(out, pos, modrm_rr(7, r))
    emit_byte(out, pos, 0x00)
}

; PUSH r64
fn emit_push_r(out: &i8, pos: &i64, r: i32) {
    if r >= 8 {
        emit_byte(out, pos, 0x41)
        emit_byte(out, pos, 0x50 + (r & 7))
    } else {
        emit_byte(out, pos, 0x50 + r)
    }
}

; POP r64
fn emit_pop_r(out: &i8, pos: &i64, r: i32) {
    if r >= 8 {
        emit_byte(out, pos, 0x41)
        emit_byte(out, pos, 0x58 + (r & 7))
    } else {
        emit_byte(out, pos, 0x58 + r)
    }
}

; RET
fn emit_ret_instr(out: &i8, pos: &i64) {
    emit_byte(out, pos, 0xC3)
}

; JMP rel32
fn emit_jmp_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0xE9)
    emit_i32_le(out, pos, rel)
}

; JE rel32
fn emit_je_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x84)
    emit_i32_le(out, pos, rel)
}

; JNE rel32
fn emit_jne_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x85)
    emit_i32_le(out, pos, rel)
}

; JL rel32
fn emit_jl_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8C)
    emit_i32_le(out, pos, rel)
}

; JG rel32
fn emit_jg_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x8F)
    emit_i32_le(out, pos, rel)
}

; SYSCALL
fn emit_syscall_instr(out: &i8, pos: &i64) {
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x05)
}

; CALL rel32  (E8 rel32)
fn emit_call_rel32(out: &i8, pos: &i64, rel: i64) {
    emit_byte(out, pos, 0xE8)
    emit_i32_le(out, pos, rel)
}

; LEA r64, [rip + rel32]  (RIP-relative load of address)
fn emit_lea_rip(out: &i8, pos: &i64, dst: i32, rel: i64) {
    let r_ext = 0
    if dst >= 8 { r_ext = 1 }
    let rex = rex_byte(1, r_ext, 0, 0)
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x8D)
    ; ModRM: mod=00, reg=dst, rm=101 (RIP+disp32)
    let modrm = dst & 7
    let modrm_sh = modrm << 3
    emit_byte(out, pos, modrm_sh + 5)
    emit_i32_le(out, pos, rel)
}

; MOV r64, [rbp - disp]  (load spilled value)
fn emit_load_spill(out: &i8, pos: &i64, dst: i32, off: i64) {
    ; REX.W 8B /r  [rbp - off]
    let r_ext = 0
    if dst >= 8 { r_ext = 1 }
    let rex = rex_byte(1, r_ext, 0, 0)
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x8B)
    ; mod=10 (disp32), reg=dst, rm=101 (rbp)
    let modrm = dst & 7
    let modrm_sh = modrm << 3
    emit_byte(out, pos, 0x80 + modrm_sh + 5)
    let neg_off = 0 - off
    emit_i32_le(out, pos, neg_off)
}

; MOV [rbp - disp], r64  (store to spill slot)
fn emit_store_spill(out: &i8, pos: &i64, off: i64, src: i32) {
    let r_ext = 0
    if src >= 8 { r_ext = 1 }
    let rex = rex_byte(1, r_ext, 0, 0)
    emit_byte(out, pos, rex)
    emit_byte(out, pos, 0x89)
    let modrm = src & 7
    let modrm_sh = modrm << 3
    emit_byte(out, pos, 0x80 + modrm_sh + 5)
    let neg_off = 0 - off
    emit_i32_le(out, pos, neg_off)
}

fn emit_load_mem_reg(out: &i8, pos: &i64, dst: i32, base: i32) {
    emit_byte(out, pos, rex_byte(1, dst >> 3, 0, base >> 3))
    emit_byte(out, pos, 0x8B)
    emit_byte(out, pos, modrm_rr(dst, base))
}

fn emit_store_mem_reg(out: &i8, pos: &i64, base: i32, src: i32) {
    emit_byte(out, pos, rex_byte(1, src >> 3, 0, base >> 3))
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, modrm_rr(src, base))
}

; SETNE al / SETE al after CMP, then MOVZX rax, al
fn emit_setcc_rax(out: &i8, pos: &i64, cc: i32) {
    ; SETCC al:  0F 9x C0
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0x90 | cc)
    emit_byte(out, pos, 0xC0)
    ; MOVZX rax, al:  48 0F B6 C0
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x0F)
    emit_byte(out, pos, 0xB6)
    emit_byte(out, pos, 0xC0)
}

; ============================================================
; 10. X86-64 LOWERING  (JIR -> machine code)
; ============================================================

fn emit_save_pool(ra: &RegAlloc, out: &i8, pos: &i64) {
    let i = 0
    loop i < N_ALLOC_REGS {
        emit_push_r(out, pos, ra.pool[i])
        i = i + 1
    }
}

fn emit_restore_pool(ra: &RegAlloc, out: &i8, pos: &i64) {
    let i = N_ALLOC_REGS - 1
    loop i >= 0 {
        emit_pop_r(out, pos, ra.pool[i])
        i = i - 1
    }
}

fn get_or_load(ra: &RegAlloc, out: &i8, pos: &i64, val_id: i64) -> i32 {
    if val_id < 0 { ret PHYS_RAX }
    if val_id >= 4096 { ret PHYS_RAX }
    let r = regalloc_get(ra, val_id)
    if r != -1 { ret r }
    ; Value was spilled: allocate a new register and reload
    let new_r = regalloc_alloc(ra, out, pos, val_id)
    let off = ra.spill_off[val_id]
    if off > 0 {
        emit_load_spill(out, pos, new_r, off)
    } else {
        ; Defensive fallback: unresolved SSA value, materialize zero.
        emit_mov_imm64(out, pos, new_r, 0)
    }
    ret new_r
}

fn lower_print_int(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    ; Selfhost bring-up: keep OP_PRINT_INT lowering tiny/stable.
    ret ok(0)
}

fn lower_syscall(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let nr_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    emit_push_r(out, pos, nr_r)
    let a0_r = get_or_load(ctx.ra, out, pos, ins.operand1)
    emit_push_r(out, pos, a0_r)
    let a1_r = get_or_load(ctx.ra, out, pos, ins.operand2)
    emit_push_r(out, pos, a1_r)
    let a2_r = get_or_load(ctx.ra, out, pos, ins.operand3)
    emit_push_r(out, pos, a2_r)
    emit_pop_r(out, pos, PHYS_RDX)
    emit_pop_r(out, pos, PHYS_RSI)
    emit_pop_r(out, pos, PHYS_RDI)
    emit_pop_r(out, pos, PHYS_RAX)
    emit_syscall_instr(out, pos)
    if ins.id >= 0 and ins.id < 4096 and ctx.use_cnt[ins.id] > 0 {
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, PHYS_R12)
    } else {
        emit_restore_pool(ctx.ra, out, pos)
    }
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    consume_use(ctx, ins.operand1)
    consume_use(ctx, ins.operand2)
    consume_use(ctx, ins.operand3)
    ret ok(0)
}

fn lower_instr_constlike(ins: &Instr, ctx: &LowerCtx, jfn: &JirFunction, out: &i8, pos: &i64) -> i64 {
    if ins.op == OP_CONST {
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_imm64(out, pos, dst, ins.imm)
        ret 1
    }
    if ins.op == OP_STRLIT {
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if ctx.fix_cnt >= 1024 { panic("Lower fixup overflow") }
        let fix_idx = ctx.fix_cnt
        ctx.fixups[fix_idx].code_off  = pos[0] + 3
        ctx.fixups[fix_idx].target_bb = ins.str_start
        ctx.fixups[fix_idx].kind      = 1
        ctx.fixups[fix_idx].str_len   = 0
        ctx.fix_cnt = ctx.fix_cnt + 1
        emit_lea_rip(out, pos, dst, 0)
        ret 1
    }
    if ins.op == OP_GADDR {
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if ctx.fix_cnt >= 1024 { panic("Lower fixup overflow") }
        let fix_idx = ctx.fix_cnt
        ctx.fixups[fix_idx].code_off  = pos[0] + 3
        ctx.fixups[fix_idx].target_bb = ins.imm
        ctx.fixups[fix_idx].kind      = 3
        ctx.fixups[fix_idx].str_len   = 0
        ctx.fix_cnt = ctx.fix_cnt + 1
        emit_lea_rip(out, pos, dst, 0)
        ret 1
    }
    ret 0
}

fn lower_instr_mem(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op == OP_LOAD {
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_load_spill(out, pos, dst, ins.operand0)
        ret 1
    }
    if ins.op == OP_ADDR {
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        let b = 0
        if dst >= 8 { b = 1 }
        emit_byte(out, pos, rex_byte(1, b, 0, 0))
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x80 | ((dst & 7) << 3) | 5)
        emit_i32_le(out, pos, 0 - ins.operand0)
        ret 1
    }
    if ins.op == OP_STORE {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_store_spill(out, pos, ins.operand1, src_r)
        consume_use(ctx, ins.operand0)
        ret 1
    }
    if ins.op == OP_LOAD_MEM {
        let base_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_load_mem_reg(out, pos, dst, base_r)
        consume_use(ctx, ins.operand0)
        ret 1
    }
    if ins.op == OP_STORE_MEM {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        let base_r = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_store_mem_reg(out, pos, base_r, src_r)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    ret 0
}

fn lower_instr_arith(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op == OP_ADD {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, a)
        emit_add_rr(out, pos, dst, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    if ins.op == OP_SUB {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, a)
        emit_sub_rr(out, pos, dst, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    if ins.op == OP_MUL {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, a)
        emit_imul_rr(out, pos, dst, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    if ins.op == OP_DIV {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_mov_rr(out, pos, PHYS_RAX, a)
        emit_cqo(out, pos)
        emit_idiv_r(out, pos, b)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_RAX {
            emit_mov_rr(out, pos, dst, PHYS_RAX)
        }
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    ret 0
}

fn lower_instr_cmpbit(ins: &Instr, ctx: &LowerCtx, jfn: &JirFunction, out: &i8, pos: &i64) -> i64 {
    if ins.op == OP_CMP_EQ or ins.op == OP_CMP_NE or
       ins.op == OP_CMP_LT or ins.op == OP_CMP_GT or ins.op == OP_CMP_LTE or ins.op == OP_CMP_GTE {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_cmp_rr(out, pos, a, b)
        let cc = 4
        if ins.op == OP_CMP_NE { cc = 5 }
        if ins.op == OP_CMP_LT { cc = 0xC }
        if ins.op == OP_CMP_LTE { cc = 0xE }
        if ins.op == OP_CMP_GT { cc = 0xF }
        if ins.op == OP_CMP_GTE { cc = 0xD }
        emit_setcc_rax(out, pos, cc)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_RAX {
            emit_mov_rr(out, pos, dst, PHYS_RAX)
        }
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    if ins.op == OP_AND {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, a)
        emit_and_rr(out, pos, dst, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    if ins.op == OP_OR {
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let b = get_or_load(ctx.ra, out, pos, ins.operand1)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, a)
        emit_or_rr(out, pos, dst, b)
        consume_use(ctx, ins.operand0)
        consume_use(ctx, ins.operand1)
        ret 1
    }
    if ins.op == OP_SHR or ins.op == OP_SHL {
        let cv = find_const(jfn, ins.operand1)
        let a = get_or_load(ctx.ra, out, pos, ins.operand0)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        emit_mov_rr(out, pos, dst, a)
        consume_use(ctx, ins.operand0)
        if cv.found == 1 {
            if ins.op == OP_SHR { emit_shr_imm8(out, pos, dst, cv.val) }
            if ins.op == OP_SHL { emit_shl_imm8(out, pos, dst, cv.val) }
        } else {
            let b = get_or_load(ctx.ra, out, pos, ins.operand1)
            if b != PHYS_RCX { emit_mov_rr(out, pos, PHYS_RCX, b) }
            if ins.op == OP_SHR { emit_shr_rcl(out, pos, dst) }
            if ins.op == OP_SHL { emit_shl_rcl(out, pos, dst) }
        }
        consume_use(ctx, ins.operand1)
        ret 1
    }
    ret 0
}

fn lower_instr_ctrl(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op == OP_RET {
        let src_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        if g_lower_is_main == 1 {
            if src_r != PHYS_RDI {
                emit_mov_rr(out, pos, PHYS_RDI, src_r)
            }
            emit_mov_imm64(out, pos, PHYS_RAX, 60)
            emit_syscall_instr(out, pos)
            consume_use(ctx, ins.operand0)
            ret 1
        }
        if src_r != PHYS_RAX {
            emit_mov_rr(out, pos, PHYS_RAX, src_r)
        }
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x89)
        emit_byte(out, pos, 0xEC)
        emit_pop_r(out, pos, PHYS_RBP)
        emit_ret_instr(out, pos)
        consume_use(ctx, ins.operand0)
        ret 1
    }
    if ins.op == OP_JMP {
        if ctx.fix_cnt >= 1024 { panic("Lower fixup overflow") }
        let fix_idx = ctx.fix_cnt
        ctx.fixups[fix_idx].code_off  = pos[0] + 1
        ctx.fixups[fix_idx].target_bb = ins.bb_target0
        ctx.fixups[fix_idx].kind      = 0
        ctx.fixups[fix_idx].str_len   = 0
        ctx.fix_cnt = ctx.fix_cnt + 1
        emit_jmp_rel32(out, pos, 0)
        ret 1
    }
    if ins.op == OP_BR {
        let cond_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_cmp_zero(out, pos, cond_r)
        if ctx.fix_cnt >= 1024 { panic("Lower fixup overflow") }
        let fix_else = ctx.fix_cnt
        ctx.fixups[fix_else].code_off  = pos[0] + 2
        ctx.fixups[fix_else].target_bb = ins.bb_target1
        ctx.fixups[fix_else].kind      = 0
        ctx.fixups[fix_else].str_len   = 0
        ctx.fix_cnt = ctx.fix_cnt + 1
        emit_je_rel32(out, pos, 0)
        if ctx.fix_cnt >= 1024 { panic("Lower fixup overflow") }
        let fix_then = ctx.fix_cnt
        ctx.fixups[fix_then].code_off  = pos[0] + 1
        ctx.fixups[fix_then].target_bb = ins.bb_target0
        ctx.fixups[fix_then].kind      = 0
        ctx.fixups[fix_then].str_len   = 0
        ctx.fix_cnt = ctx.fix_cnt + 1
        emit_jmp_rel32(out, pos, 0)
        consume_use(ctx, ins.operand0)
        ret 1
    }
    if ins.op == OP_SYSCALL {
        lower_syscall(ins, ctx, out, pos)
        ret 1
    }
    ret 0
}

fn lower_instr_alloc(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op != OP_ALLOC { ret 0 }
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    let sz_r = get_or_load(ctx.ra, out, pos, ins.operand0)
    if sz_r != PHYS_RSI { emit_mov_rr(out, pos, PHYS_RSI, sz_r) }
    emit_mov_imm64(out, pos, PHYS_RAX, 9)
    emit_mov_imm64(out, pos, PHYS_RDI, 0)
    emit_mov_imm64(out, pos, PHYS_RDX, 3)
    emit_mov_imm64(out, pos, PHYS_R10, 0x22)
    emit_mov_imm64(out, pos, PHYS_R8, -1)
    emit_mov_imm64(out, pos, PHYS_R9, 0)
    emit_syscall_instr(out, pos)
    if ins.id >= 0 and ins.id < 4096 and ctx.use_cnt[ins.id] > 0 {
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
    } else {
        emit_restore_pool(ctx.ra, out, pos)
    }
    emit_pop_r(out, pos, PHYS_R12)
    consume_use(ctx, ins.operand0)
    ret 1
}

fn lower_instr_call(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if ins.op != OP_CALL { ret 0 }
    emit_push_r(out, pos, PHYS_R12)
    emit_save_pool(ctx.ra, out, pos)
    lower_instr_call_args(ins, ctx, out, pos)
    lower_instr_call_emit(ins, ctx, out, pos)
    emit_pop_r(out, pos, PHYS_R12)
    if ins.operand3 >= 1 { consume_use(ctx, ins.operand0) }
    if ins.operand3 >= 2 { consume_use(ctx, ins.operand1) }
    if ins.operand3 >= 3 { consume_use(ctx, ins.operand2) }
    if ins.operand3 >= 4 { consume_use(ctx, ins.bb_target0) }
    if ins.operand3 >= 5 { consume_use(ctx, ins.bb_target1) }
    if ins.operand3 >= 6 { consume_use(ctx, ins.imm) }
    ret 1
}

fn lower_instr_call_args(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    if ins.operand3 >= 1 {
        let r = get_or_load(ctx.ra, out, pos, ins.operand0)
        emit_push_r(out, pos, r)
    }
    if ins.operand3 >= 2 {
        let r = get_or_load(ctx.ra, out, pos, ins.operand1)
        emit_push_r(out, pos, r)
    }
    if ins.operand3 >= 3 {
        let r = get_or_load(ctx.ra, out, pos, ins.operand2)
        emit_push_r(out, pos, r)
    }
    if ins.operand3 >= 4 {
        let r = get_or_load(ctx.ra, out, pos, ins.bb_target0)
        emit_push_r(out, pos, r)
    }
    if ins.operand3 >= 5 {
        let r = get_or_load(ctx.ra, out, pos, ins.bb_target1)
        emit_push_r(out, pos, r)
    }
    if ins.operand3 >= 6 {
        let r = get_or_load(ctx.ra, out, pos, ins.imm)
        emit_push_r(out, pos, r)
    }
    ; Pop in reverse order to target registers
    if ins.operand3 >= 6 { emit_pop_r(out, pos, PHYS_R9) }
    if ins.operand3 >= 5 { emit_pop_r(out, pos, PHYS_R8) }
    if ins.operand3 >= 4 { emit_pop_r(out, pos, PHYS_RCX) }
    if ins.operand3 >= 3 { emit_pop_r(out, pos, PHYS_RDX) }
    if ins.operand3 >= 2 { emit_pop_r(out, pos, PHYS_RSI) }
    if ins.operand3 >= 1 { emit_pop_r(out, pos, PHYS_RDI) }
}

fn lower_instr_call_emit(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) {
    if ctx.fix_cnt >= 1024 { panic("Lower fixup overflow") }
    let fix_idx = ctx.fix_cnt
    ctx.fixups[fix_idx].code_off  = pos[0] + 1
    ctx.fixups[fix_idx].target_bb = ins.str_start
    ctx.fixups[fix_idx].kind      = 2
    ctx.fixups[fix_idx].str_len   = ins.str_len
    ctx.fix_cnt = ctx.fix_cnt + 1
    emit_call_rel32(out, pos, 0)
    if ins.id >= 0 and ins.id < 4096 and ctx.use_cnt[ins.id] > 0 {
        emit_mov_rr(out, pos, PHYS_R12, PHYS_RAX)
        emit_restore_pool(ctx.ra, out, pos)
        let dst = regalloc_alloc(ctx.ra, out, pos, ins.id)
        if dst != PHYS_R12 {
            emit_mov_rr(out, pos, dst, PHYS_R12)
        }
    } else {
        emit_restore_pool(ctx.ra, out, pos)
    }
}

fn lower_instr_callalloc(ins: &Instr, ctx: &LowerCtx, out: &i8, pos: &i64) -> i64 {
    if lower_instr_alloc(ins, ctx, out, pos) == 1 { ret 1 }
    if lower_instr_call(ins, ctx, out, pos) == 1 { ret 1 }
    ret 0
}

fn lower_instr(ins: &Instr, ctx: &LowerCtx, jfn: &JirFunction,
               out: &i8, pos: &i64) {
    if lower_instr_constlike(ins, ctx, jfn, out, pos) == 1 {
        ret ok(0)
    }

    if ins.op == OP_STRLEN {
        ; Walk strtab from str_id to first 0 byte and return count.
        ; At runtime the pointer is in the register for operand0.
        ; We emit an inline strlen loop.
        let ptr_r = get_or_load(ctx.ra, out, pos, ins.operand0)
        let dst   = regalloc_alloc(ctx.ra, out, pos, ins.id)
        ; xor dst, dst   (counter = 0)
        emit_rex_w_rr(out, pos, dst, dst)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, modrm_rr(dst, dst))
        ; loop: cmp byte [ptr_r + dst], 0 / je done / inc dst / jmp loop
        ; Simplified: emit as a call-like sequence using CX
        ; For Stage 1 purposes, inline the pattern:
        ;   .loop: cmp [ptr+cnt], 0; je .done; inc cnt; jmp .loop; .done:
        let loop_off = pos[0]
        ; CMP byte [ptr_r + dst*1], 0
        ; Need: REX (optional) + 0x80 + ModRM(00,/7,100) + SIB(00,dst,ptr_r) + imm8
        ; REX: W=0, R=0, X=(dst>=8), B=(ptr_r>=8)
        let rx = 0
        if dst >= 8 { rx = 1 }
        let rb = 0
        if ptr_r >= 8 { rb = 1 }
        if rx == 1 or rb == 1 {
            emit_byte(out, pos, 0x40 | (rx << 1) | rb)
        }
        emit_byte(out, pos, 0x80)   ; CMP r/m8, imm8
        emit_byte(out, pos, 0x3C)   ; ModRM: mod=00, reg=/7 (CMP), rm=100 (SIB)
        ; Keep this as simple two-step math because stage0 has known issues
        ; with compound bit expressions in some contexts.
        let sib = (dst & 7) << 3
        let base = ptr_r & 7
        sib = sib + base
        emit_byte(out, pos, sib)  ; SIB: scale=00, index=dst, base=ptr_r
        emit_byte(out, pos, 0)      ; imm8 = 0
        ; JE +3 (skip inc + jmp)
        let je_off = pos[0]
        emit_je_rel32(out, pos, 0)  ; placeholder
        ; INC dst:  REX.W FF /0
        let b = 0
        if dst >= 8 { b = 1 }
        emit_byte(out, pos, rex_byte(1, 0, 0, b))
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, modrm_rr(0, dst))
        ; JMP back to loop_off
        let jmp_rel = loop_off - (pos[0] + 5)
        emit_jmp_rel32(out, pos, jmp_rel)
        ; Patch JE to here
        let done_off = pos[0]
        let je_rel = done_off - (je_off + 6)
        out[je_off + 2] = je_rel & 0xFF
        out[je_off + 3] = (je_rel >> 8) & 0xFF
        out[je_off + 4] = (je_rel >> 16) & 0xFF
        out[je_off + 5] = (je_rel >> 24) & 0xFF
        consume_use(ctx, ins.operand0)
        ret ok(0)
    }

    if ins.op == OP_PRINT_INT {
        ret lower_print_int(ins, ctx, out, pos)
    }

    if ins.op == OP_ARGV_BASE {
        ; lea rax, [rbp+16]  — argv base for write_elf JMP-style _start
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x8D)
        emit_byte(out, pos, 0x85)
        emit_i32_le(out, pos, 16)
        emit_store_spill(out, pos, ins.operand0, PHYS_RAX)
        ret ok(0)
    }

    if lower_instr_mem(ins, ctx, out, pos) == 1 {
        ret ok(0)
    }

    if lower_instr_arith(ins, ctx, out, pos) == 1 {
        ret ok(0)
    }

    if lower_instr_cmpbit(ins, ctx, jfn, out, pos) == 1 {
        ret ok(0)
    }

    if lower_instr_ctrl(ins, ctx, out, pos) == 1 { ret ok(0) }
    if lower_instr_callalloc(ins, ctx, out, pos) == 1 { ret ok(0) }

}

fn lower_block(bb: &BasicBlock, ctx: &LowerCtx, jfn: &JirFunction,
               out: &i8, pos: &i64) {
    bb.label_off = pos[0]
    let i = 0
    loop i < bb.instr_cnt {
        if jfn.blocks[bb.id].instrs[i].dead == 0 {
            lower_instr(jfn.blocks[bb.id].instrs[i], ctx, jfn, out, pos)
        }
        i = i + 1
    }
}

fn live_compile_let_stmt(toks0: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, cur: i64) {
    if g_cur_fn_name_len == 4 {
        if streq(src, g_cur_fn_name_start, 4, "main") == 1 {
            g_dbg_main_lets = g_dbg_main_lets + 1
        }
    }
    pos[0] = pos[0] + 1
    let name_start = tok_str_start_at(toks0, pos[0])
    let name_len = tok_str_len_at(toks0, pos[0])
    pos[0] = pos[0] + 1
    if tok_type_at0(toks0, pos) == TOK_COLON {
        pos[0] = pos[0] + 1
        if tok_type_at0(toks0, pos) == TOK_AMP {
            pos[0] = pos[0] + 1
        }
        pos[0] = pos[0] + 1
    }
    pos[0] = pos[0] + 1
    let skip_store = 0
    let bind_stype = TYPE_I64
    let rhs_id = -1
    let rhs_t = tok_type_at0(toks0, pos)
    if rhs_t == TOK_STR {
        bind_stype = TYPE_PTR_I8
    } else if rhs_t == TOK_IDENT {
        let rhs_start0 = tok_str_start_at(toks0, pos[0])
        let rhs_len0 = tok_str_len_at(toks0, pos[0])
        let rhs_slot0 = lookup_slot_name(jfn, rhs_start0, rhs_len0)
        if rhs_slot0 != -1 {
            bind_stype = lookup_stype_name(jfn, rhs_start0, rhs_len0)
        } else {
            let rhs_gi0 = lookup_global2(rhs_start0, rhs_len0, src)
            if rhs_gi0 != -1 {
                bind_stype = g_glob_stype[rhs_gi0]
                if g_glob_is_addr[rhs_gi0] == 1 and bind_stype < TYPE_PTR_FLAG {
                    bind_stype = ptr_of(bind_stype)
                }
            }
        }
        if rhs_len0 == 11 and streq(src, rhs_start0, 11, "alloc_pages") == 1 {
            bind_stype = TYPE_PTR
        } else if rhs_len0 == 8 and streq(src, rhs_start0, 8, "get_argv") == 1 {
            bind_stype = TYPE_PTR_I8
        }
    }
    rhs_id = codegen_expr_inline(toks0, pos, stab, src, jfn, cur)
    let slot = bind_name(jfn, name_start, name_len, bind_stype)
    if skip_store == 0 {
        if rhs_id == -1 {
            rhs_id = emit_const(jfn, cur, TYPE_I64, 0)
        }
        let ins = Instr{}
        ins.op = OP_STORE
        ins.operand0 = rhs_id
        ins.operand1 = slot
        emit(jfn, cur, &ins)
    }
}

fn live_compile_block(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    print("B1\n")
    let cur = bb
    let keep_going = 1
    loop keep_going == 1 {
        print("B2\n")
        let before_stmt = pos[0]
        let toks0 = g_dbg_toks
        g_panic_pos = pos[0]
        let t = tok_type_at0(toks0, pos)
        if t == TOK_RBRACE or t == TOK_EOF {
            keep_going = 0
        } else {
        if compile_asm_argv_inline(toks0, pos, src, jfn, cur) == 1 {
            cur = cur
        } else if skip_asm_stmt_inline(toks0, pos, src) == 1 {
            cur = cur
        } else if t == TOK_IF {
            cur = live_compile_if(toks0, pos, stab, src, jfn, cur)
        } else if t == TOK_LOOP {
            cur = live_compile_loop(toks0, pos, stab, src, jfn, cur)
        } else if t == TOK_LET {
            live_compile_let_stmt(toks0, pos, stab, src, jfn, cur)
        } else if t == TOK_RET {
            print("RET1\n")
            pos[0] = pos[0] + 1
            print("RET2\n")
            let val_id = emit_const(jfn, cur, TYPE_I64, 0)
            print("RET3\n")
            let rt = tok_type_at0(toks0, pos)
            print("RET4\n")
            if rt == TOK_INT or rt == TOK_IDENT or rt == TOK_LPAREN or rt == TOK_MINUS or rt == TOK_TILDE or rt == TOK_AMP or rt == TOK_SYSCALL {
                print("RET5\n")
                val_id = codegen_expr_inline(toks0, pos, stab, src, jfn, cur)
                print("RET6\n")
            }
            let rins = Instr{}
            rins.op = OP_RET
            rins.operand0 = val_id
            print("RET7\n")
            emit(jfn, cur, &rins)
            print("RET8\n")
        } else if t == TOK_PRINT {
            if g_cur_fn_name_len == 4 {
                if streq(src, g_cur_fn_name_start, 4, "main") == 1 {
                    g_dbg_main_prints = g_dbg_main_prints + 1
                }
            }
            cur = compile_print_inline(toks0, pos, stab, src, jfn, cur)
        } else {
            cur = compile_expr_stmt2_inline(toks0, pos, stab, src, jfn, cur)
        }
        if pos[0] <= before_stmt {
            ; Parser recovery guard: never spin forever on a stuck token.
            if pos[0] < g_dbg_tok_cnt {
                pos[0] = pos[0] + 1
            } else {
                keep_going = 0
            }
        }
        }
    }
    ret cur
}

fn live_compile_if(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at0(g_dbg_toks, pos) != TOK_IF { panic("if: expected if") }
    pos[0] = pos[0] + 1
    let cond_id = codegen_expr_inline(g_dbg_toks, pos, stab, src, jfn, bb)
    let then_bb = create_block_live(jfn)
    let else_bb = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    emit_br(jfn, bb, cond_id, then_bb, else_bb)
    if tok_type_at0(g_dbg_toks, pos) != TOK_LBRACE {
        ; Recovery: expression parser can occasionally leave pos mid-condition.
        ; Resync to the next block opener so block compilation can continue.
        loop pos[0] < g_dbg_tok_cnt and tok_type_at0(g_dbg_toks, pos) != TOK_LBRACE and tok_type_at0(g_dbg_toks, pos) != TOK_EOF {
            pos[0] = pos[0] + 1
        }
    }
    if tok_type_at0(g_dbg_toks, pos) != TOK_LBRACE {
        emit_jmp(jfn, then_bb, merge_bb)
        emit_jmp(jfn, else_bb, merge_bb)
        ret merge_bb
    }
    pos[0] = pos[0] + 1
    let then_end = live_compile_block(g_dbg_toks, pos, stab, src, jfn, then_bb)
    if tok_type_at0(g_dbg_toks, pos) == TOK_RBRACE {
        pos[0] = pos[0] + 1
    } else if tok_type_at0(g_dbg_toks, pos) == TOK_EOF {
        emit_jmp(jfn, then_end, merge_bb)
        ret merge_bb
    } else {
        panic("if: expected }")
    }
    emit_jmp(jfn, then_end, merge_bb)
    if tok_type_at0(g_dbg_toks, pos) == TOK_ELSE {
        pos[0] = pos[0] + 1
        if tok_type_at0(g_dbg_toks, pos) == TOK_IF {
            let else_end = live_compile_if(g_dbg_toks, pos, stab, src, jfn, else_bb)
            emit_jmp(jfn, else_end, merge_bb)
        } else {
            if tok_type_at0(g_dbg_toks, pos) != TOK_LBRACE {
                emit_jmp(jfn, else_bb, merge_bb)
                ret merge_bb
            }
            pos[0] = pos[0] + 1
            let else_end = live_compile_block(g_dbg_toks, pos, stab, src, jfn, else_bb)
            if tok_type_at0(g_dbg_toks, pos) == TOK_RBRACE {
                pos[0] = pos[0] + 1
            } else if tok_type_at0(g_dbg_toks, pos) == TOK_EOF {
                emit_jmp(jfn, else_end, merge_bb)
                ret merge_bb
            } else {
                panic("if: expected else }")
            }
            emit_jmp(jfn, else_end, merge_bb)
        }
    } else {
        emit_jmp(jfn, else_bb, merge_bb)
    }
    ret merge_bb
}

fn live_compile_loop(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at0(g_dbg_toks, pos) != TOK_LOOP { panic("loop: expected loop") }
    pos[0] = pos[0] + 1
    let start_bb = create_block_live(jfn)
    emit_jmp(jfn, bb, start_bb)
    let body_bb = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    let cond_id = codegen_expr_inline(g_dbg_toks, pos, stab, src, jfn, start_bb)
    emit_br(jfn, start_bb, cond_id, body_bb, merge_bb)
    if tok_type_at0(g_dbg_toks, pos) != TOK_LBRACE { ret merge_bb }
    pos[0] = pos[0] + 1
    let body_end = live_compile_block(g_dbg_toks, pos, stab, src, jfn, body_bb)
    if tok_type_at0(g_dbg_toks, pos) == TOK_RBRACE {
        pos[0] = pos[0] + 1
    } else if tok_type_at0(g_dbg_toks, pos) == TOK_EOF {
        emit_jmp(jfn, body_end, start_bb)
        ret merge_bb
    } else {
        panic("loop: expected }")
    }
    emit_jmp(jfn, body_end, start_bb)
    ret merge_bb
}

fn lower_fn_mark_uses_instr(ctx: &LowerCtx, ins: &Instr) {
    if ins.dead != 0 { ret ok(0) }
    let op = ins.op
    let o0 = ins.operand0
    let o1 = ins.operand1
    let o2 = ins.operand2
    let o3 = ins.operand3
    if op == OP_ADD or op == OP_SUB or op == OP_MUL or op == OP_DIV or
       op == OP_CMP_EQ or op == OP_CMP_NE or op == OP_CMP_LT or op == OP_CMP_GT or
       op == OP_CMP_LTE or op == OP_CMP_GTE or op == OP_AND or op == OP_OR or
       op == OP_SHR or op == OP_SHL {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_RET or op == OP_BR or op == OP_STRLEN or op == OP_STORE or op == OP_PRINT_INT {
        mark_use(ctx, o0)
    }
    if op == OP_LOAD_MEM {
        mark_use(ctx, o0)
    }
    if op == OP_STORE_MEM {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_SYSCALL {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
        mark_use(ctx, o2)
        mark_use(ctx, o3)
    }
    if op == OP_ALLOC {
        mark_use(ctx, o0)
    }
    if op == OP_CALL {
        if o3 >= 1 { mark_use(ctx, o0) }
        if o3 >= 2 { mark_use(ctx, o1) }
        if o3 >= 3 { mark_use(ctx, o2) }
        if o3 >= 4 { mark_use(ctx, ins.bb_target0) }
        if o3 >= 5 { mark_use(ctx, ins.bb_target1) }
        if o3 >= 6 { mark_use(ctx, ins.imm) }
    }
}

fn lower_fn_emit_prologue(jfn: &JirFunction, out: &i8, pos: &i64, is_main: i64) {
    emit_push_r(out, pos, PHYS_RBP)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xE5)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xEC)
    let frame_sz = 524288
    if is_main == 1 {
        frame_sz = 786432
    }
    emit_i32_le(out, pos, frame_sz)
    if is_main != 1 { ret ok(0) }
    let vi = 0
    loop vi < jfn.var_cnt {
        let vlen = jfn.vars[vi].name_len
        if vlen == 8 {
            if streq(jfn.src, jfn.vars[vi].name_start, 8, "argv_ptr") == 1 {
                emit_byte(out, pos, 0x48)
                emit_byte(out, pos, 0x8D)
                emit_byte(out, pos, 0x85)
                emit_i32_le(out, pos, 16)
                emit_store_spill(out, pos, jfn.vars[vi].slot_off, PHYS_RAX)
            } else if streq(jfn.src, jfn.vars[vi].name_start, 8, "src_path") == 1 {
                emit_load_spill(out, pos, PHYS_RAX, -24)
                emit_store_spill(out, pos, jfn.vars[vi].slot_off, PHYS_RAX)
            } else if streq(jfn.src, jfn.vars[vi].name_start, 8, "out_path") == 1 {
                emit_load_spill(out, pos, PHYS_RAX, -32)
                emit_store_spill(out, pos, jfn.vars[vi].slot_off, PHYS_RAX)
            }
        }
        vi = vi + 1
    }
}

fn lower_fn_store_params(jfn: &JirFunction, out: &i8, pos: &i64) {
    let pi = 0
    loop pi < jfn.param_cnt and pi < 6 {
        let pr = PHYS_RDI
        if pi == 1 { pr = PHYS_RSI }
        if pi == 2 { pr = PHYS_RDX }
        if pi == 3 { pr = PHYS_RCX }
        if pi == 4 { pr = PHYS_R8 }
        if pi == 5 { pr = PHYS_R9 }
        emit_store_spill(out, pos, jfn.param_slots[pi], pr)
        pi = pi + 1
    }
}

fn lower_fn_collect_uses(jfn: &JirFunction, ctx: &LowerCtx) {
    let ui = 0
    loop ui < 4096 {
        ctx.use_cnt[ui] = 0
        ui = ui + 1
    }
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            lower_fn_mark_uses_instr(ctx, jfn.blocks[bi].instrs[ii])
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn lower_fn_emit_blocks(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let i = 0
    loop i < jfn.block_cnt {
        ctx.bb_offsets[i] = pos[0]
        lower_block(jfn.blocks[i], ctx, jfn, out, pos)
        i = i + 1
    }
}

fn lower_fn_emit_epilogue(out: &i8, pos: &i64, is_main: i64) {
    if is_main == 1 {
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 60)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)
        ret ok(0)
    }
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xEC)
    emit_pop_r(out, pos, PHYS_RBP)
    emit_ret_instr(out, pos)
}

fn lower_fn_patch_fixups(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let fi = 0
    loop fi < ctx.fix_cnt {
        if ctx.fixups[fi].kind == 0 {
            let co = ctx.fixups[fi].code_off
            let tb = ctx.fixups[fi].target_bb
            if tb >= 0 and tb < jfn.block_cnt and tb < 256 and co >= 0 and co + 3 < pos[0] {
                let target_off = ctx.bb_offsets[tb]
                let rel = target_off - (co + 4)
                poke_byte(out, co,     rel & 0xFF)
                poke_byte(out, co + 1, (rel >> 8) & 0xFF)
                poke_byte(out, co + 2, (rel >> 16) & 0xFF)
                poke_byte(out, co + 3, (rel >> 24) & 0xFF)
            }
        }
        fi = fi + 1
    }
}

fn lower_fn(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64, is_main: i64) {
    g_lower_is_main = is_main
    lower_fn_emit_prologue(jfn, out, pos, is_main)
    lower_fn_store_params(jfn, out, pos)
    lower_fn_collect_uses(jfn, ctx)
    lower_fn_emit_blocks(jfn, ctx, out, pos)
    lower_fn_emit_epilogue(out, pos, is_main)
    g_lower_is_main = 0
    lower_fn_patch_fixups(jfn, ctx, out, pos)
}

fn write_elf(out_fd: i64, code: &i8, code_len: i64,
             strtab: &i8, strtab_len: i64) {
    if out_fd < 0 { panic("open out failed") }
    let buf = alloc_pages(1) ; 4KB is plenty for the header
    let pos = 0

    let load_va   = 0x400000
    let hdr_size  = 120
    let code_va   = load_va + hdr_size
    let total     = hdr_size + code_len + strtab_len + g_emit_glob_len

    emit_byte(buf, &pos, 0x7F)
    emit_byte(buf, &pos, 0x45)
    emit_byte(buf, &pos, 0x4C)
    emit_byte(buf, &pos, 0x46)
    emit_byte(buf, &pos, 2)
    emit_byte(buf, &pos, 1)
    emit_byte(buf, &pos, 1)
    emit_byte(buf, &pos, 0)
    let pi = 0
    loop pi < 8 { emit_byte(buf, &pos, 0) pi = pi + 1 }
    emit_byte(buf, &pos, 2)    emit_byte(buf, &pos, 0)
    emit_byte(buf, &pos, 0x3E) emit_byte(buf, &pos, 0)
    emit_i32_le(buf, &pos, 1)
    emit_i64_le(buf, &pos, code_va)
    emit_i64_le(buf, &pos, 64)
    emit_i64_le(buf, &pos, 0)
    emit_i32_le(buf, &pos, 0)
    emit_byte(buf, &pos, 64) emit_byte(buf, &pos, 0)
    emit_byte(buf, &pos, 56) emit_byte(buf, &pos, 0)
    emit_byte(buf, &pos, 1)  emit_byte(buf, &pos, 0)
    emit_byte(buf, &pos, 64) emit_byte(buf, &pos, 0)
    emit_byte(buf, &pos, 0)  emit_byte(buf, &pos, 0)
    emit_byte(buf, &pos, 0)  emit_byte(buf, &pos, 0)

    emit_i32_le(buf, &pos, 1)
    emit_i32_le(buf, &pos, 5)
    emit_i64_le(buf, &pos, 0)
    emit_i64_le(buf, &pos, load_va)
    emit_i64_le(buf, &pos, load_va)
    emit_i64_le(buf, &pos, total)
    emit_i64_le(buf, &pos, total)
    emit_i64_le(buf, &pos, 0x200000)

    let w1 = syscall(1, out_fd, buf, pos)
    if w1 != pos { panic("short write hdr") }
    let w2 = syscall(1, out_fd, code, code_len)
    if w2 != code_len { panic("short write code") }
    if strtab_len > 0 {
        let w3 = syscall(1, out_fd, strtab, strtab_len)
        if w3 != strtab_len { panic("short write str") }
    }
    if g_emit_glob_len > 0 {
        let w4 = syscall(1, out_fd, g_emit_glob_buf, g_emit_glob_len)
        if w4 != g_emit_glob_len { panic("short write glob") }
    }
}

fn get_argv(base: &i64, n: i64) -> &i8 {
    if base == 0 { ret 0 }
    ret base[n]
}

; ============================================================
; 13. ENTRY POINT
; ============================================================

let g_stab_ptr: &StructTable = 0
let g_loop_ctrl: i64 = 0
let g_argv_base: &i64 = 0
let g_src_path: &i8 = 0
let g_out_path: &i8 = 0

fn main() {
    let argv_ptr: &i64 = 0
    asm { out argv_ptr = rsi }
    g_argv_base = argv_ptr
    print("A\n")
    g_src_path = g_argv_base[1]
    g_out_path = g_argv_base[2]
    print("JDA1_START\n")
    let src_buf = alloc_pages(64)  ; 64 pages = 256KB
    print("J1\n")
    let toks = alloc_pages(1024) ; 131072 * 32 bytes = 4 MiB
    print("J2\n")

    ; Initialize global constant table
    g_const_cnt = 0
    print("J3\n")
    g_const_name_off_tbl = alloc_pages(8)
    g_const_name_len_tbl = alloc_pages(8)
    g_const_val_tbl = alloc_pages(8)
    g_const_cnt = 0
    print("J4\n")

    g_glob_name_off = alloc_pages(8)
    g_glob_name_len = alloc_pages(8)
    g_glob_off      = alloc_pages(8)
    g_glob_size     = alloc_pages(8)
    g_glob_stype    = alloc_pages(8)
    g_glob_is_addr  = alloc_pages(8)
    print("J5\n")

    let src_fd = syscall(2, g_src_path, 0, 0)
    print("J6\n")
    let src_len = syscall(0, src_fd, src_buf, 262144)  ; Read up to 256KB
    print("J7\n")
    syscall(3, src_fd, 0, 0)

    let tok_cnt = 0
    g_lex_out_toks = toks
    tok_cnt = lex(src_buf, src_len)
    print("LEX DONE\n")
    fix_char_literals(src_buf, toks, &tok_cnt)

    g_dbg_toks = toks
    g_dbg_tok_cnt = tok_cnt
    if g_dbg_tok_cnt > 0 { print("GDTC_OK\n") } else { print("GDTC_ZERO\n") }
    g_glob_cnt = 0
    if g_dbg_tok_cnt > 0 { print("A1_OK\n") } else { print("A1_ZERO\n") }
    g_glob_total_sz = 0
    if g_dbg_tok_cnt > 0 { print("A2_OK\n") } else { print("A2_ZERO\n") }
    g_emit_glob_buf = 0
    if g_dbg_tok_cnt > 0 { print("A3_OK\n") } else { print("A3_ZERO\n") }
    g_emit_glob_len = 0
    if g_dbg_tok_cnt > 0 { print("A4_OK\n") } else { print("A4_ZERO\n") }



    let stab = alloc_pages(50)
    if g_dbg_tok_cnt > 0 { print("B1_OK\n") } else { print("B1_ZERO\n") }
    g_stab_ptr = stab
    if g_dbg_tok_cnt > 0 { print("B2_OK\n") } else { print("B2_ZERO\n") }
    g_stab_ptr.cnt = 0
    if g_dbg_tok_cnt > 0 { print("B3_OK\n") } else { print("B3_ZERO\n") }
    g_stab_ptr.field_cnt = 0
    if g_dbg_tok_cnt > 0 { print("B4_OK\n") } else { print("B4_ZERO\n") }

    let pos = 0
    if g_dbg_tok_cnt > 0 { print("B5_OK\n") } else { print("B5_ZERO\n") }
    print("PRE-CONST\n")
    if g_dbg_tok_cnt > 0 { print("TKCNT_OK\n") } else { print("TKCNT_ZERO\n") }
    ; Parse const declarations first (jda1.jda starts with 40+ consts)
    ; Use global g_loop_ctrl to avoid local variable slot/spill issues
    g_loop_ctrl = 1
    loop g_loop_ctrl == 1 {
        print("CI\n")
        if pos < g_dbg_tok_cnt {
            print("CI_IN\n")
            let top_start = tok_str_start_at(toks, pos)
            let top_len = tok_str_len_at(toks, pos)
            let top_t = tok_type_at(toks, pos)
            let top_is_const_kw = 0
            if top_t == TOK_IDENT and top_len == 5 and span_in_src(top_start, top_len, src_len) == 1 {
                if streq(src_buf, top_start, 5, "const") == 1 { top_is_const_kw = 1 }
            }
            if top_t == TOK_CONST or top_is_const_kw == 1 {
                print("CI_CONST\n")
                parse_const_decl(toks, &pos)
                print("CI_CONST_DONE\n")
            } else {
                print("CI_NONCONST\n")
                g_loop_ctrl = 0
            }
        } else {
            print("CI_OUT\n")
            g_loop_ctrl = 0
            print("CI_OUT_AFTER\n")
        }
    }

    print("POST-CONST\n")
    ; Parse and record top-level structs
    let more_structs = 1
    loop more_structs == 1 {
        if pos < tok_cnt {
            let top_start = tok_str_start_at(toks, pos)
            let top_len = tok_str_len_at(toks, pos)
            let top_t = tok_type_at(toks, pos)
            let top_is_struct_kw = 0
            if top_t == TOK_IDENT and top_len == 6 and span_in_src(top_start, top_len, src_len) == 1 {
                if streq(src_buf, top_start, 6, "struct") == 1 { top_is_struct_kw = 1 }
            }
            if top_t == TOK_STRUCT or top_is_struct_kw == 1 {
                parse_struct_decl(toks, &pos, g_stab_ptr, src_buf)
            } else {
                more_structs = 0
            }
        } else {
            more_structs = 0
        }
    }

    print("STRDONE\n")
    print("SD1\n")
    ; Pass 1: Scan for global functions and record names/offsets
    let fn_name_off = alloc_pages(1) ; 512 entries
    print("SD2\n")
    let fn_name_len = alloc_pages(1)
    print("SD3\n")
    let fn_cnt = 0
    let scan_pos = 0
    print("SD4\n")
    loop scan_pos < tok_cnt {
        let t = tok_type_at(toks, scan_pos)
        let t_start = tok_str_start_at(toks, scan_pos)
        let t_len = tok_str_len_at(toks, scan_pos)
        if t == TOK_FN or (t_len == 2 and streq(src_buf, t_start, 2, "fn") == 1) {
            let name_idx = scan_pos + 1
            if name_idx < tok_cnt {
                if tok_type_at(toks, name_idx) == TOK_IDENT {
                    if fn_cnt < 512 {
                        fn_name_off[fn_cnt] = tok_str_start_at(toks, name_idx)
                        fn_name_len[fn_cnt] = tok_str_len_at(toks, name_idx)
                        fn_cnt = fn_cnt + 1
                    }
                }
            }
        }
        scan_pos = scan_pos + 1
    }
    print("SCAN_DONE\n")

    ; ---- Prepare output buffers ----
    let code_buf = alloc_pages(256) ; 1MB
    let code_len = 0
    let merged_str = alloc_pages(64)  ; 256KB
    let merged_pos = 0
    let glob_buf = alloc_pages(32)  ; 128KB
    let glob_pos        = 0
    ; Emit JMP rel32 placeholder (5 bytes) - entry point jumps to main
    emit_byte(code_buf, &code_len, 0xE9)
    emit_i32_le(code_buf, &code_len, 0)

    ; Global fixup arrays for strtab and call patches
    let gf_strtab_co   = alloc_pages(16) ; 8192 entries
    let gf_strtab_tgt  = alloc_pages(16)
    let gf_strtab_base = alloc_pages(16)
    let gf_strtab_cnt  = 0
    let gf_call_co     = alloc_pages(16)
    let gf_call_name   = alloc_pages(16)
    let gf_call_nlen   = alloc_pages(16)
    let gf_call_cnt    = 0

    ; Track code offsets per function
    let fn_code_off = alloc_pages(1)
    let main_idx    = -1

    ; ---- Allocate JirFunction and LowerCtx once, reuse per function ----
    let jfn_tmp = JirFunction{}
    let jfn = jfn_tmp
    let ctx_tmp = LowerCtx{}
    let ctx = ctx_tmp

    ; ---- Parse and compile each function immediately ----
    let more_top = 1
    loop more_top == 1 {
        print("LOOPCHECK\n")
        if pos >= tok_cnt {
            more_top = 0
        } else {
            let top_t = tok_type_at(g_dbg_toks, pos)
            let top_start = tok_str_start_at(g_dbg_toks, pos)
            let top_len = tok_str_len_at(g_dbg_toks, pos)
            let is_top_fn = 0
            if top_t == TOK_FN or (top_len == 2 and streq(src_buf, top_start, 2, "fn") == 1) {
                is_top_fn = 1
            }
            let is_top_let = 0
            if top_t == TOK_LET or (top_len == 3 and streq(src_buf, top_start, 3, "let") == 1) {
                is_top_let = 1
            }
            if is_top_fn == 0 and is_top_let == 0 {
                print("SK\n")
                pos = pos + 1
            } else if is_top_let == 1 {
                print("LT\n")
                skip_top_level_let(g_dbg_toks, &pos, g_stab_ptr, src_buf)
            } else {
                print("FENTER\n")
                let fn_tok_pos = pos
                let cur_name_off = tok_str_start_at(g_dbg_toks, pos + 1)
                let cur_name_len = tok_str_len_at(g_dbg_toks, pos + 1)
                print("FENTER name str=")
                syscall(1, 1, src_buf + cur_name_off, cur_name_len)
                print("\n")
                let fi = -1
                let mi = 0
                loop mi < fn_cnt {
                    if fn_name_len[mi] == cur_name_len {
                        if str_match(src_buf, fn_name_off[mi], cur_name_off, cur_name_len) == 1 {
                            fi = mi
                            mi = fn_cnt
                        }
                    }
                    mi = mi + 1
                }
                if fi == -1 {
                    if cur_name_len == 4 {
                        if streq(src_buf, cur_name_off, 4, "main") == 1 { fi = 999 }
                    }
                }
                let fn_lbrace_scan = -1
                let fn_rbrace_scan = -1
                let scan_i = fn_tok_pos
                loop scan_i < tok_cnt {
                    let st = tok_type_at(g_dbg_toks, scan_i)
                    if st == TOK_LBRACE {
                        fn_lbrace_scan = scan_i
                        fn_rbrace_scan = find_matching_rbrace(g_dbg_toks, scan_i)
                        scan_i = tok_cnt
                    } else if st == TOK_SEMI {
                        fn_rbrace_scan = scan_i
                        scan_i = tok_cnt
                    } else if st == TOK_EOF {
                        scan_i = tok_cnt
                    } else {
                        scan_i = scan_i + 1
                    }
                }
                print("FENTER scans done\n")
                let skip_old_parse = 0
                if fn_lbrace_scan == -1 { skip_old_parse = 1 }

                print("F1\n")
                jfn.src = src_buf
                print("F2\n")
                jfn.src_len = src_len
                print("F3\n")
                jfn.stab = g_stab_ptr
                print("F4\n")
                jfn.block_cnt = 0
                print("F5\n")
                jfn.var_cnt = 0
                print("F6\n")
                jfn.param_cnt = 0
                jfn.strtab_pos = 0
                jfn.next_slot_off = 65536
                jfn.next_id = 0
                print("F7\n")

                pos = pos + 2 ; skip 'fn' and name
                expect(g_dbg_toks, &pos, TOK_LPAREN)
                print("F8\n")
                let more_params = 0
                if tok_type_at(g_dbg_toks, pos) != TOK_RPAREN { more_params = 1 }
                loop more_params == 1 {
                    print("F9 param loop\n")
                    let p_name_start = tok_str_start_at(g_dbg_toks, pos)
                    let p_name_len = tok_str_len_at(g_dbg_toks, pos)
                    expect(g_dbg_toks, &pos, TOK_IDENT)
                    print("F10\n")
                    let p_stype = TYPE_I64
                    if tok_type_at(g_dbg_toks, pos) == TOK_COLON {
                        pos = pos + 1
                        let is_ptr = 0
                        if tok_type_at(g_dbg_toks, pos) == TOK_AMP {
                            is_ptr = 1
                            pos = pos + 1
                        }
                        let p_type = tok_type_at(g_dbg_toks, pos)
                        let p_type_start = tok_str_start_at(g_dbg_toks, pos)
                        let p_type_len = tok_str_len_at(g_dbg_toks, pos)
                        pos = pos + 1
                        if p_type == TOK_IDENT {
                            let sid = lookup_struct(g_stab_ptr, src_buf, p_type_start, p_type_len)
                            if sid >= 0 {
                                p_stype = sid
                            } else if is_ptr == 1 {
                                p_stype = ptr_of(TYPE_PTR)
                            } else {
                                p_stype = TYPE_PTR
                            }
                        } else {
                            if p_type == TOK_I64 { p_stype = TYPE_I64 }
                            if p_type == TOK_I32 { p_stype = TYPE_I32 }
                            if p_type == TOK_I8  { p_stype = TYPE_I8 }
                            if p_type == TOK_F64 { p_stype = TYPE_F64 }
                            if is_ptr == 1 { p_stype = ptr_of(p_stype) }
                        }
                    }
                    print("F11 calling bind_name\n")
                    let pslot = bind_name(jfn, p_name_start, p_name_len, p_stype)
                    print("F12 bind_name ok\n")
                    if jfn.param_cnt < 16 {
                        jfn.param_slots[jfn.param_cnt] = pslot
                        jfn.param_cnt = jfn.param_cnt + 1
                    }
                    print("F13 param slot ok\n")
                    if tok_type_at(g_dbg_toks, pos) == TOK_COMMA {
                        pos = pos + 1
                    } else {
                        more_params = 0
                    }
                }
                print("F14 params done\n")
                expect(g_dbg_toks, &pos, TOK_RPAREN)
                print("F15\n")
                if tok_type_at(g_dbg_toks, pos) == TOK_ARROW {
                    pos = pos + 1
                    let ret_parsed = parse_type(g_dbg_toks, &pos)
                }
                print("F16\n")
                if fn_lbrace_scan != -1 {
                    pos = fn_lbrace_scan
                }
                print("F17\n")
                let skip_fn_body_compile = should_skip_old_fn(src_buf, cur_name_off, cur_name_len, fi)
                print("F18\n")
                let fn_lbrace = pos
                let fn_rbrace = -1
                if skip_fn_body_compile == 0 {
                    fn_rbrace = find_matching_rbrace(g_dbg_toks, fn_lbrace)
                }
                print("F19\n")
                if skip_old_parse == 1 or skip_fn_body_compile == 1 {
                    if fn_rbrace_scan != -1 {
                        pos = fn_rbrace_scan + 1
                    } else {
                        let skip_rbrace = find_matching_rbrace(g_dbg_toks, fn_lbrace)
                        if skip_rbrace != -1 {
                            pos = skip_rbrace + 1
                        } else {
                            pos = pos + 1
                        }
                    }
                } else {
                    print("F20\n")
                    expect(g_dbg_toks, &pos, TOK_LBRACE)
                    jfn.strtab_pos = 0
                    g_dbg_fi = fi
                    let cb = create_block_live(jfn)
                    print("F21\n")
                    live_compile_block(g_dbg_toks, &pos, g_stab_ptr, src_buf, jfn, cb)
                    g_dbg_fi = 0
                    if tok_type_at(g_dbg_toks, pos) == TOK_RBRACE {
                        pos = pos + 1
                    }
                }
                ; Resync past function body; always advance to end of function
                print("RESYNC\n")
                if fn_rbrace >= 0 {
                    pos = fn_rbrace + 1
                }

                print("FNSTART\n")
                let is_main = 0
                if fi == 999 { is_main = 1 }
                if cur_name_len == 4 {
                    print("LEN4\n")
                    if streq(src_buf, cur_name_off, 4, "main") == 1 { is_main = 1 }
                }
                if is_main == 1 {
                    main_idx = fi
                    print("FOUND_MAIN\n")
                }
                if fi >= 0 and fi < 512 {
                    fn_code_off[fi] = code_len
                }
                if skip_fn_body_compile == 1 {
                    emit_byte(code_buf, &code_len, 0x31)
                    emit_byte(code_buf, &code_len, 0xC0)
                    emit_ret_instr(code_buf, &code_len)
                } else {
                    regalloc_init(ctx.ra)
                    ctx.fix_cnt = 0
                    lower_fn(jfn, ctx, code_buf, &code_len, is_main)
                    print("POSTLOWER\n")
                    ; Collect fixups from this function
                    let ci = 0
                    loop ci < ctx.fix_cnt {
                        let fk = ctx.fixups[ci].kind
                        if fk == 1 {
                            if gf_strtab_cnt >= 8192 { panic("strtab fixup overflow") }
                            gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                            gf_strtab_tgt[gf_strtab_cnt]  = ctx.fixups[ci].target_bb
                            gf_strtab_base[gf_strtab_cnt] = merged_pos
                            gf_strtab_cnt = gf_strtab_cnt + 1
                        } else if fk == 3 {
                            if gf_strtab_cnt >= 8192 { panic("strtab fixup overflow") }
                            gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                            gf_strtab_tgt[gf_strtab_cnt]  = -1 - ctx.fixups[ci].target_bb
                            gf_strtab_base[gf_strtab_cnt] = 0
                            gf_strtab_cnt = gf_strtab_cnt + 1
                        } else if fk == 2 {
                            if gf_call_cnt >= 8192 { panic("call fixup overflow") }
                            gf_call_co[gf_call_cnt]   = ctx.fixups[ci].code_off
                            gf_call_name[gf_call_cnt] = ctx.fixups[ci].target_bb
                            gf_call_nlen[gf_call_cnt] = ctx.fixups[ci].str_len
                            gf_call_cnt = gf_call_cnt + 1
                        }
                        ci = ci + 1
                    }
                    ; Copy strtab to merged
                    let si_copy = 0
                    let jfn_strtab_len = jfn.strtab_pos
                    loop si_copy < jfn_strtab_len {
                        if merged_pos >= 262144 { panic("Merged string table overflow") }
                        let bval = jfn.strtab[si_copy]
                        poke_byte(merged_str, merged_pos, bval)
                        merged_pos = merged_pos + 1
                        si_copy = si_copy + 1
                    }
                }
            }
        }
    }

    ; ---- Fix up entry point ----
    if main_idx == -1 { panic("main not found") }
    let m_off = fn_code_off[main_idx]
    let e_rel = m_off - 5
    poke_byte(code_buf, 1, e_rel & 0xFF)
    poke_byte(code_buf, 2, (e_rel >> 8) & 0xFF)
    poke_byte(code_buf, 3, (e_rel >> 16) & 0xFF)
    poke_byte(code_buf, 4, (e_rel >> 24) & 0xFF)

    ; ---- Fix up string/global addresses in code ----
    let str_va = 0x400000 + 120 + code_len
    let si_f = 0
    loop si_f < gf_strtab_cnt {
        let co = gf_strtab_co[si_f]
        if co >= 5 and co + 3 < code_len {
            let rel_val = 0
            if gf_strtab_tgt[si_f] >= 0 {
                rel_val = str_va + gf_strtab_base[si_f] + gf_strtab_tgt[si_f] - (0x400000 + 120 + co + 4)
            } else {
                let gi_f = -1 - gf_strtab_tgt[si_f]
                ; Globals are after all strings in the data segment
                rel_val = str_va + merged_pos + g_glob_off[gi_f] - (0x400000 + 120 + co + 4)
            }
            poke_byte(code_buf, co,     rel_val & 0xFF)
            poke_byte(code_buf, co + 1, (rel_val >> 8) & 0xFF)
            poke_byte(code_buf, co + 2, (rel_val >> 16) & 0xFF)
            poke_byte(code_buf, co + 3, (rel_val >> 24) & 0xFF)
        }
        si_f = si_f + 1
    }

    ; ---- Fix up function calls ----
    let ci_f = 0
    loop ci_f < gf_call_cnt {
        let co_f = gf_call_co[ci_f]
        let ti_f = gf_call_name[ci_f]
        if ti_f >= 0 and ti_f < 512 {
            let t_off = fn_code_off[ti_f]
            let r_val = t_off - (co_f + 4)
            poke_byte(code_buf, co_f,     r_val & 0xFF)
            poke_byte(code_buf, co_f + 1, (r_val >> 8) & 0xFF)
            poke_byte(code_buf, co_f + 2, (r_val >> 16) & 0xFF)
            poke_byte(code_buf, co_f + 3, (r_val >> 24) & 0xFF)
        }
        ci_f = ci_f + 1
    }

    let out_fd = syscall(2, g_out_path, 577, 493)
    g_emit_glob_buf = glob_buf
    g_emit_glob_len = g_glob_total_sz
    write_elf(out_fd, code_buf, code_len, merged_str, merged_pos)
    syscall(3, out_fd, 0, 0)
    syscall(60, 0, 0, 0)
}let g_argv_base: &i64 = 0
let g_runtime_src_len: i64 = 0
let g_src_buf_ptr: &i8 = 0
let g_small_src_buf_ptr: &i8 = 0
let g_out_path_ptr: &i8 = 0
let g_jfn_heap: &i8 = 0
let g_jfn: &JirFunction = 0

fn main() {
    let argv_ptr: &i64 = 0
    let src_path: &i8 = 0
    let out_path: &i8 = 0
    asm { out argv_ptr = rsi }
    let argc = argv_ptr[0]
    if argc < 3 {
        print("Usage: jda1 <src.jda> <out>\n")
        syscall(60, 1, 0, 0)
    }
    src_path = argv_ptr[1] as &i8
    out_path = argv_ptr[2] as &i8
    g_out_path_ptr = out_path
    let src_buf = alloc_pages(128)  ; 128 pages = 512KB
    g_src_buf_ptr = src_buf
    let toks = alloc_pages(2048) ; 262144 * 40 bytes = 10 MiB
    toks[0].type = TOK_EOF
    g_dbg_toks = toks
    g_dbg_toks_init = toks
    ; Initialize global constant table
    g_const_cnt = 0
    g_const_name_off_tbl = alloc_pages(8)
    g_const_name_len_tbl = alloc_pages(8)
    g_const_val_tbl = alloc_pages(8)

    let src_fd = syscall(2, src_path, 0, 0)
    if src_fd < 0 { panic("open src failed") }
    let read_len = syscall(0, src_fd, g_src_buf_ptr, 524288)  ; Read up to 512KB
    if read_len < 0 { panic("read src failed") }
    syscall(3, src_fd, 0, 0)
    g_small_src_buf_ptr = alloc_pages(1)
    let src_len = read_len
    g_runtime_src_len = src_len
    g_large_mode = 1
    let tok_cnt = lex_global_fast()
    g_dbg_tok_cnt = tok_cnt
    g_scan_tok_cnt = tok_cnt
    init_large_post_lex_state()
    run_top_const_prelude(g_dbg_toks_init, &g_main_pos, src_buf, src_len)
    run_top_struct_prelude(g_dbg_toks_init, &g_main_pos, g_stab_ptr, src_buf, src_len)

    ; Pass 1: Scan for global functions and record names/offsets
    let fn_name_off = alloc_pages(1) ; 512 entries
    let fn_name_len = alloc_pages(1)
    prepare_top_fn_scan(g_dbg_toks_init, src_buf, src_len, fn_name_off, fn_name_len)

    ; ---- Prepare output buffers ----
    let code_buf = alloc_pages(256) ; 1MB
    let code_len = 0
    let merged_str = alloc_pages(64)  ; 256KB
    let merged_pos = 0
    let glob_buf = alloc_pages(32)  ; 128KB
    let glob_pos        = 0
    ; Emit JMP rel32 placeholder (5 bytes) - entry point jumps to main
    emit_byte(code_buf, &code_len, 0xE9)
    emit_i32_le(code_buf, &code_len, 0)

    ; Global fixup arrays for strtab and call patches
    let gf_strtab_co   = alloc_pages(16) ; 8192 entries
    let gf_strtab_tgt  = alloc_pages(16)
    let gf_strtab_base = alloc_pages(16)
    let gf_strtab_cnt  = 0
    let gf_call_co     = alloc_pages(16)
    let gf_call_name   = alloc_pages(16)
    let gf_call_nlen   = alloc_pages(16)
    let gf_call_cnt    = 0

    ; Track code offsets per function
    let fn_code_off = alloc_pages(1)
    let main_idx    = -1

    ; ---- Allocate JirFunction and LowerCtx once, reuse per function ----
    g_jfn_heap = alloc_pages(3080)
    g_jfn = g_jfn_heap as &JirFunction
    let ctx_heap = alloc_pages(32)
    let ctx = ctx_heap as &LowerCtx

    ; ---- Parse and compile each function immediately ----
    prime_small_compile_pos(&g_main_pos)
    prime_compile_budget_global(src_buf, src_len)
    g_dbg_main_steps = 0
    g_loop_ctrl = g_more_top
    loop g_loop_ctrl > 0 {
        let loop_pos = g_main_pos
        if loop_pos < g_scan_tok_cnt {
            let top_t = 0
            let top_start = 0
            let top_len = 0
            load_top_fields(loop_pos, &top_t, &top_start, &top_len)
            if top_t == TOK_FN {
                g_main_pos = loop_pos
                let fn_tok_pos = loop_pos
                let cur_name_off = tok_str_start_at(g_dbg_toks_init, loop_pos + 1)
                let cur_name_len = tok_str_len_at(g_dbg_toks_init, loop_pos + 1)
                g_cur_fn_name_start = cur_name_off
                g_cur_fn_name_len = cur_name_len
                let fn_lbrace_scan = -1
                let fn_rbrace_scan = -1
                let scan_i = fn_tok_pos
                loop scan_i < g_dbg_tok_cnt {
                    let st = tok_type_at(g_dbg_toks_init, scan_i)
                    if st == TOK_LBRACE {
                        fn_lbrace_scan = scan_i
                        fn_rbrace_scan = find_matching_rbrace(g_dbg_toks_init, scan_i)
                        scan_i = g_dbg_tok_cnt
                    } else if st == TOK_SEMI {
                        fn_rbrace_scan = scan_i
                        scan_i = g_dbg_tok_cnt
                    } else if st == TOK_EOF {
                        scan_i = g_dbg_tok_cnt
                    } else {
                        scan_i = scan_i + 1
                    }
                }
                let skip_old_parse = 0
                let fi = 999
                fi = resolve_top_fn_index(src_buf, cur_name_off, cur_name_len, fn_name_off, fn_name_len)
                init_top_jfn(g_jfn, src_buf, src_len, g_stab_ptr)
                let hdr_pos = loop_pos + 2
                g_main_pos = hdr_pos + 1
                let more_params = 0
                if tok_type_at(g_dbg_toks_init, g_main_pos) != TOK_RPAREN { more_params = 1 }
                loop more_params == 1 {
                    let p_name_start = tok_str_start_at(g_dbg_toks_init, g_main_pos)
                    let p_name_len = tok_str_len_at(g_dbg_toks_init, g_main_pos)
                    expect(g_dbg_toks_init, &g_main_pos, TOK_IDENT)
                    let p_stype = TYPE_I64
                    if tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_COLON {
                        g_main_pos = g_main_pos + 1
                        let is_ptr = 0
                        if tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_AMP {
                            is_ptr = 1
                            g_main_pos = g_main_pos + 1
                        }
                        let p_type = tok_type_at(g_dbg_toks_init, g_main_pos)
                        let p_type_start = tok_str_start_at(g_dbg_toks_init, g_main_pos)
                        let p_type_len = tok_str_len_at(g_dbg_toks_init, g_main_pos)
                        g_main_pos = g_main_pos + 1
                        if p_type == TOK_IDENT {
                            let sid = lookup_struct(g_stab_ptr, src_buf, p_type_start, p_type_len)
                            if sid >= 0 {
                                p_stype = sid
                            } else if is_ptr == 1 {
                                p_stype = ptr_of(TYPE_PTR)
                            } else {
                                p_stype = TYPE_PTR
                            }
                        } else {
                            if p_type == TOK_I64 { p_stype = TYPE_I64 }
                            if p_type == TOK_I32 { p_stype = TYPE_I32 }
                            if p_type == TOK_I8  { p_stype = TYPE_I8 }
                            if p_type == TOK_F64 { p_stype = TYPE_F64 }
                            if is_ptr == 1 { p_stype = ptr_of(p_stype) }
                        }
                    }
                    let pslot = bind_name(g_jfn, p_name_start, p_name_len, p_stype)
                    if g_jfn.param_cnt < 16 {
                        g_jfn.param_slots[g_jfn.param_cnt] = pslot
                        g_jfn.param_cnt = g_jfn.param_cnt + 1
                    }
                    if tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_COMMA {
                        g_main_pos = g_main_pos + 1
                    } else {
                        more_params = 0
                    }
                }
                expect(g_dbg_toks_init, &g_main_pos, TOK_RPAREN)
                if fn_lbrace_scan != -1 {
                    g_main_pos = fn_lbrace_scan
                } else {
                    fn_lbrace_scan = g_main_pos
                }
                g_skip_fn_body_compile_tmp = should_skip_old_fn(src_buf, cur_name_off, cur_name_len, fi)
                g_fn_lbrace_tmp = g_main_pos
                g_fn_rbrace_tmp = -1
                if g_skip_fn_body_compile_tmp == 0 {
                    g_fn_rbrace_tmp = fn_rbrace_scan
                }
                if skip_old_parse == 1 or g_skip_fn_body_compile_tmp == 1 {
                    if fn_rbrace_scan != -1 {
                        g_main_pos = fn_rbrace_scan + 1
                    } else {
                        let skip_rbrace = find_matching_rbrace(g_dbg_toks_init, g_fn_lbrace_tmp)
                        if skip_rbrace != -1 {
                            g_main_pos = skip_rbrace + 1
                        } else {
                            g_main_pos = g_main_pos + 1
                        }
                    }
                } else {
                    expect(g_dbg_toks_init, &g_main_pos, TOK_LBRACE)
                    g_jfn.strtab_pos = 0
                    let cb = create_block_live(g_jfn)
                    live_compile_block(g_dbg_toks_init, &g_main_pos, g_stab_ptr, src_buf, g_jfn, cb)
                    if tok_type_at(g_dbg_toks_init, g_main_pos) == TOK_RBRACE {
                        g_main_pos = g_main_pos + 1
                    }
                }
                if g_fn_rbrace_tmp >= 0 {
                    g_main_pos = g_fn_rbrace_tmp + 1
                }
                let is_main = 0
                if fi == 999 { is_main = 1 }
                if cur_name_len == 4 {
                    if load_i8_at(src_buf, cur_name_off) == 109 {
                        if load_i8_at(src_buf, cur_name_off + 1) == 97 {
                            if load_i8_at(src_buf, cur_name_off + 2) == 105 {
                                if load_i8_at(src_buf, cur_name_off + 3) == 110 {
                                    is_main = 1
                                }
                            }
                        }
                    }
                }
                if is_main == 1 {
                    main_idx = fi
                }
                if fi >= 0 and fi < 512 {
                    store_i64_at(fn_code_off, fi, code_len)
                }
                if g_skip_fn_body_compile_tmp == 1 {
                    emit_byte(code_buf, &code_len, 0x31)
                    emit_byte(code_buf, &code_len, 0xC0)
                    emit_ret_instr(code_buf, &code_len)
                } else {
                    regalloc_init(ctx as &RegAlloc)
                    ctx.fix_cnt = 0
                    lower_fn(g_jfn, ctx, code_buf, &code_len, is_main)
                    ; Collect fixups from this function
                    let ci = 0
                    loop ci < ctx.fix_cnt {
                        let fk = ctx.fixups[ci].kind
                        if fk == 1 {
                            gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                            gf_strtab_tgt[gf_strtab_cnt]  = ctx.fixups[ci].target_bb
                            gf_strtab_base[gf_strtab_cnt] = merged_pos
                            gf_strtab_cnt = gf_strtab_cnt + 1
                        } else if fk == 3 {
                            gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                            gf_strtab_tgt[gf_strtab_cnt]  = -1 - ctx.fixups[ci].target_bb
                            gf_strtab_base[gf_strtab_cnt] = 0
                            gf_strtab_cnt = gf_strtab_cnt + 1
                        } else if fk == 2 {
                            gf_call_co[gf_call_cnt]   = ctx.fixups[ci].code_off
                            gf_call_name[gf_call_cnt] = ctx.fixups[ci].target_bb
                            gf_call_nlen[gf_call_cnt] = ctx.fixups[ci].str_len
                            gf_call_cnt = gf_call_cnt + 1
                        }
                        ci = ci + 1
                    }
                    ; Copy strtab to merged
                    let si_copy = 0
                    let jfn_strtab_len = g_jfn.strtab_pos
                    loop si_copy < jfn_strtab_len {
                        let bval = g_jfn.strtab[si_copy]
                        poke_byte(merged_str, merged_pos, bval)
                        merged_pos = merged_pos + 1
                        si_copy = si_copy + 1
                    }
                }
            } else if top_t == TOK_EOF {
                g_loop_ctrl = 0
            } else if top_t == TOK_LET or (top_len == 3 and streq(src_buf, top_start, 3, "let") == 1) {
                skip_top_level_let(g_dbg_toks_init, &g_main_pos, g_stab_ptr, src_buf)
            } else {
                g_main_pos = g_main_pos + 1
            }
        } else {
            g_loop_ctrl = 0
        }
    }

    ; ---- Fix up entry point ----
    if main_idx == -1 { panic("main not found") }
    let m_off = load_i64_at(fn_code_off, main_idx)
    let e_rel = m_off - 5
    poke_byte(code_buf, 1, e_rel & 0xFF)
    poke_byte(code_buf, 2, (e_rel >> 8) & 0xFF)
    poke_byte(code_buf, 3, (e_rel >> 16) & 0xFF)
    poke_byte(code_buf, 4, (e_rel >> 24) & 0xFF)

    ; ---- Fix up string/global addresses in code ----
    g_fix_merged_pos = merged_pos
    let str_va = 0x400000 + 120 + code_len
    let si_f = 0
    loop si_f < gf_strtab_cnt {
        let co = gf_strtab_co[si_f]
        if co >= 5 and co + 3 < code_len {
            let rel_val = 0
            if gf_strtab_tgt[si_f] >= 0 {
                let lit_va = str_va + gf_strtab_base[si_f]
                let tgt_va = lit_va + gf_strtab_tgt[si_f]
                let rip_after = 0x400000 + 120 + co + 4
                rel_val = tgt_va - rip_after
            } else {
                let gi_f = -1 - gf_strtab_tgt[si_f]
                ; Globals are after all strings in the data segment
                let data_va = str_va + merged_pos
                let glob_va = data_va + load_i64_at(g_glob_off, gi_f)
                let rip_after = 0x400000 + 120 + co + 4
                rel_val = glob_va - rip_after
            }
            poke_byte(code_buf, co,     rel_val & 0xFF)
            poke_byte(code_buf, co + 1, (rel_val >> 8) & 0xFF)
            poke_byte(code_buf, co + 2, (rel_val >> 16) & 0xFF)
            poke_byte(code_buf, co + 3, (rel_val >> 24) & 0xFF)
        }
        si_f = si_f + 1
    }

    ; ---- Fix up function calls ----
    let ci_f = 0
    loop ci_f < gf_call_cnt {
        let co_f = gf_call_co[ci_f]
        let call_name = gf_call_name[ci_f]
        let call_nlen = gf_call_nlen[ci_f]
        let found = 0
        let ti_f = 0
        if co_f >= 6 and co_f + 3 < code_len and call_name >= 0 and call_nlen > 0 and call_name + call_nlen <= src_len {
            loop ti_f < g_top_fn_cnt {
                if call_nlen == load_i64_at(fn_name_len, ti_f) {
                    if str_match(src_buf, call_name, load_i64_at(fn_name_off, ti_f), call_nlen) == 1 {
                        let t_off = load_i64_at(fn_code_off, ti_f)
                        let r_val = t_off - (co_f + 4)
                        poke_byte(code_buf, co_f,     r_val & 0xFF)
                        poke_byte(code_buf, co_f + 1, (r_val >> 8) & 0xFF)
                        poke_byte(code_buf, co_f + 2, (r_val >> 16) & 0xFF)
                        poke_byte(code_buf, co_f + 3, (r_val >> 24) & 0xFF)
                        found = 1
                        ti_f = g_top_fn_cnt
                    }
                }
                ti_f = ti_f + 1
            }
        }
        if found == 0 and co_f >= 6 and co_f + 3 < code_len {
            ; Rewrite unresolved `call rel32` to NOPs to avoid stack corruption.
            poke_byte(code_buf, co_f - 1, 0x90)
            poke_byte(code_buf, co_f,     0x90)
            poke_byte(code_buf, co_f + 1, 0x90)
            poke_byte(code_buf, co_f + 2, 0x90)
            poke_byte(code_buf, co_f + 3, 0x90)
        }
        ci_f = ci_f + 1
    }

    let out_fd = syscall(2, out_path, 577, 493)
    g_emit_glob_buf = glob_buf
    g_emit_glob_len = g_glob_total_sz
    write_elf(out_fd, code_buf, code_len, merged_str, merged_pos)
    syscall(3, out_fd, 0, 0)
    syscall(60, 0, 0, 0)
}
