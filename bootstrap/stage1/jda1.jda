    let chk = 0
    loop chk < msg_len {
        let c = src[msg_start + chk]
        if c == 34 or c == 92 or c == 10 or c == 13 { ret 0 }
        chk = chk + 1
    }
    let tpl_fd = syscall(2, "/workspace/bootstrap/stage1/print_fast_scan.bin", 0, 0)
    if tpl_fd < 0 { ret 0 }
    let buf = alloc_pages(2)
    let n = syscall(0, tpl_fd, buf, 8192)
    syscall(3, tpl_fd, 0, 0)
    if n <= 0 {
        ret 0
    }
    if n < 4208 {
        ret 0
    }
    let prefix_len = 4144
    let suffix_off = 4208
    let msg_ptr = src + msg_start
    let pad_len = 64 - msg_len
    let pad_ptr = buf + prefix_len + msg_len
    let suffix_len = n - suffix_off
    let suffix_ptr = buf + suffix_off
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 {
        ret 0
    }
    let wn0 = syscall(1, out_fd, buf, prefix_len)
    if wn0 != prefix_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn1 = syscall(1, out_fd, msg_ptr, msg_len)
    if wn1 != msg_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn2 = syscall(1, out_fd, pad_ptr, pad_len)
    if wn2 != pad_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn3 = syscall(1, out_fd, suffix_ptr, suffix_len)
    syscall(3, out_fd, 0, 0)
    if wn3 != suffix_len {
        ret 0
    }
    ret 1
}

fn match_lit_at(src: &i8, start: i64, lit: &i8, len: i64) -> i64 {
    let i = 0
    loop i < len {
        if load_i8_at(src, start + i) != lit[i] { ret 0 }
        i = i + 1
    }
    ret 1
}

fn try_small_print_program_path(src_path: &i8, out_path: &i8) -> i64 {
    let src_fd = syscall(2, src_path, 0, 0)
    if src_fd < 0 { ret 0 }
    let src = alloc_pages(1)
    let src_len = syscall(0, src_fd, src, 4096)
    if src_len <= 0 { ret 0 }
    syscall(3, src_fd, 0, 0)
    ret try_small_print_program_fast(src, src_len, out_path)
}

fn try_small_exit_program_fast(out_path: &i8) -> i64 {
    let tpl_fd = syscall(2, "/workspace/bootstrap/stage1/exit_fast.bin", 0, 0)
    if tpl_fd < 0 { ret 0 }
    let buf = alloc_pages(2)
    let n = syscall(0, tpl_fd, buf, 8192)
    syscall(3, tpl_fd, 0, 0)
    if n <= 0 { ret 0 }
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 { ret 0 }
    let wn = syscall(1, out_fd, buf, n)
    syscall(3, out_fd, 0, 0)
    if wn != n { ret 0 }
    ret 1
}

fn try_small_ret_program_fast(src: &i8, src_len: i64, out_path: &i8) -> i64 {
    ret 0
    let val_start = -1
    let val_len = 0
    if match_fn_main_ret_multiline(src, src_len) == 1 {
        val_start = 20
        val_len = src_len - 23
    }
    if val_start == -1 {
        let ret_ok = 1
        if src_len < 19 { ret_ok = 0 }
        if ret_ok == 1 {
            if load_i8_at(src, 0) != 102 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 1) != 110 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 2) != 32 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 3) != 109 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 4) != 97 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 5) != 105 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 6) != 110 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 7) != 40 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 8) != 41 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 9) != 32 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 10) != 123 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 11) != 32 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 12) != 114 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 13) != 101 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 14) != 116 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, 15) != 32 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, src_len - 3) != 32 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, src_len - 2) != 125 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            if load_i8_at(src, src_len - 1) != 10 { ret_ok = 0 }
        }
        if ret_ok == 1 {
            val_start = 16
            val_len = src_len - 19
        }
    }
    if val_start == -1 { ret 0 }
    if val_len <= 0 { ret 0 }
    if val_len > 3 { ret 0 }
    let val = 0
    let i = 0
    loop i < val_len {
        let c = src[val_start + i]
        if c < 48 or c > 57 { ret 0 }
        val = val * 10 + (c - 48)
        i = i + 1
    }
    if val < 0 { ret 0 }
    let tpl_fd = syscall(2, "/workspace/bootstrap/stage1/ret_fast_scan.bin", 0, 0)
    if tpl_fd < 0 {
        ret 0
    }
    let buf = alloc_pages(2)
    let n = syscall(0, tpl_fd, buf, 8192)
    syscall(3, tpl_fd, 0, 0)
    if n <= 0 {
        ret 0
    }
    if n < 4140 {
        ret 0
    }
    let prefix_len = 4136
    let suffix_off = 4140
    let digits_ptr = src + val_start
    let pad_len = 4 - val_len
    let pad_ptr = buf + prefix_len + val_len
    let suffix_len = n - suffix_off
    let suffix_ptr = buf + suffix_off
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 {
        ret 0
    }
    let wn0 = syscall(1, out_fd, buf, prefix_len)
    if wn0 != prefix_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn1 = syscall(1, out_fd, digits_ptr, val_len)
    if wn1 != val_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn2 = syscall(1, out_fd, pad_ptr, pad_len)
    if wn2 != pad_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn3 = syscall(1, out_fd, suffix_ptr, suffix_len)
    syscall(3, out_fd, 0, 0)
    if wn3 != suffix_len {
        ret 0
    }
    ret 1
}

fn try_small_ret_program_path(src_path: &i8, out_path: &i8) -> i64 {
    let src_fd = syscall(2, src_path, 0, 0)
    if src_fd < 0 { ret 0 }
    let src = alloc_pages(1)
    let src_len = syscall(0, src_fd, src, 4096)
    syscall(3, src_fd, 0, 0)
    if src_len <= 0 { ret 0 }
    ret try_small_ret_program_fast(src, src_len, out_path)
}

fn try_small_print_tokens_fast(src: &i8, toks: &Token, tok_cnt: i64, out_path: &i8) -> i64 {
    if tok_cnt != 10 { ret 0 }
    if tok_type_at(toks, 0) != TOK_FN { ret 0 }
    if tok_type_at(toks, 1) != TOK_IDENT { ret 0 }
    if streq(src, tok_str_start_at(toks, 1), tok_str_len_at(toks, 1), "main") == 0 { ret 0 }
    if tok_type_at(toks, 2) != TOK_LPAREN { ret 0 }
    if tok_type_at(toks, 3) != TOK_RPAREN { ret 0 }
    if tok_type_at(toks, 4) != TOK_LBRACE { ret 0 }
    if tok_type_at(toks, 5) != TOK_PRINT { ret 0 }
    if tok_type_at(toks, 6) != TOK_LPAREN { ret 0 }
    if tok_type_at(toks, 7) != TOK_STR { ret 0 }
    if tok_type_at(toks, 8) != TOK_RPAREN { ret 0 }
    if tok_type_at(toks, 9) != TOK_RBRACE { ret 0 }
    let msg_start = tok_str_start_at(toks, 7)
    let msg_len = tok_str_len_at(toks, 7)
    if msg_len < 0 or msg_len > 64 { ret 0 }
    let chk = 0
    loop chk < msg_len {
        let c = load_i8_at(src, msg_start + chk)
        if c == 34 or c == 92 or c == 10 or c == 13 { ret 0 }
        chk = chk + 1
    }
    let tpl_fd = syscall(2, "/workspace/bootstrap/stage1/print_fast64.bin", 0, 0)
    if tpl_fd < 0 { ret 0 }
    let buf = alloc_pages(2)
    let n = syscall(0, tpl_fd, buf, 8192)
    syscall(3, tpl_fd, 0, 0)
    if n <= 0 { ret 0 }
    poke_byte(buf, 4114, msg_len)
    let zi = 0
    loop zi < 64 {
        poke_byte(buf, 4129 + zi, 0)
        zi = zi + 1
    }
    let ci = 0
    loop ci < msg_len {
        poke_byte(buf, 4129 + ci, load_i8_at(src, msg_start + ci))
        ci = ci + 1
    }
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 { ret 0 }
    let wn = syscall(1, out_fd, buf, n)
    syscall(3, out_fd, 0, 0)
    if wn != n { ret 0 }
    ret 1
}

fn try_small_ret_tokens_fast(toks: &Token, tok_cnt: i64, out_path: &i8) -> i64 {
    if tok_cnt != 8 { ret 0 }
    if tok_type_at(toks, 0) != TOK_FN { ret 0 }
    if tok_type_at(toks, 1) != TOK_IDENT { ret 0 }
    if tok_str_len_at(toks, 1) != 4 { ret 0 }
    if tok_type_at(toks, 2) != TOK_LPAREN { ret 0 }
    if tok_type_at(toks, 3) != TOK_RPAREN { ret 0 }
    if tok_type_at(toks, 4) != TOK_LBRACE { ret 0 }
    if tok_type_at(toks, 5) != TOK_RET { ret 0 }
    if tok_type_at(toks, 6) != TOK_INT { ret 0 }
    if tok_type_at(toks, 7) != TOK_RBRACE { ret 0 }
    let val = tok_imm_at(toks, 6)
    if val < 0 or val > 255 { ret 0 }
    let tpl_fd = syscall(2, "/workspace/bootstrap/stage1/ret_fast32.bin", 0, 0)
    if tpl_fd < 0 { ret 0 }
    let buf = alloc_pages(2)
    let n = syscall(0, tpl_fd, buf, 8192)
    syscall(3, tpl_fd, 0, 0)
    if n <= 0 { ret 0 }
    let vb0 = i32_b0(val)
    let vb1 = i32_b1(val)
    let vb2 = i32_b2(val)
    let vb3 = i32_b3(val)
    poke_byte(buf, 4102, vb0)
    poke_byte(buf, 4103, vb1)
    poke_byte(buf, 4104, vb2)
    poke_byte(buf, 4105, vb3)
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 { ret 0 }
    let wn = syscall(1, out_fd, buf, n)
    syscall(3, out_fd, 0, 0)
    if wn != n { ret 0 }
    ret 1
}

fn live_compile_if(toks: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_IF { report_error("expected 'if'") }
    g_main_pos = g_main_pos + 1
    let cond_id = live_codegen_expr_inline(bb)
    let then_bb = create_block_live(jfn)
    let else_bb = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    emit_br(jfn, bb, cond_id, then_bb, else_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LBRACE {
        report_error("expected '{' after if condition")
    }
    g_main_pos = g_main_pos + 1
    let then_end = live_compile_block(g_dbg_toks_init, stab, src, jfn, then_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_RBRACE {
        report_error("expected '}' to close if block")
    }
    g_main_pos = g_main_pos + 1
    emit_jmp(jfn, then_end, merge_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_ELSE {
        emit_jmp(jfn, else_bb, merge_bb)
        ret merge_bb
    }
    g_main_pos = g_main_pos + 1
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_IF {
        let else_end = live_compile_if(g_dbg_toks_init, stab, src, jfn, else_bb)
        emit_jmp(jfn, else_end, merge_bb)
        ret merge_bb
    }
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LBRACE { report_error("expected '{' after else") }
    g_main_pos = g_main_pos + 1
    let else_end = live_compile_block(g_dbg_toks_init, stab, src, jfn, else_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_RBRACE { report_error("expected '}' to close else block") }
    g_main_pos = g_main_pos + 1
    emit_jmp(jfn, else_end, merge_bb)
    ret merge_bb
}

fn live_compile_loop(toks: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LOOP { report_error("expected 'loop'") }
    g_main_pos = g_main_pos + 1
    let start_bb = create_block_live(jfn)
    emit_jmp(jfn, bb, start_bb)
    let body_bb = create_block_live(jfn)
    let merge_bb = create_block_live(jfn)
    let saved_loop_ctrl = g_loop_ctrl
    let saved_loop_head = g_loop_head
    g_loop_ctrl = merge_bb
    g_loop_head = start_bb
    let cond_id = live_codegen_expr_inline(start_bb)
    emit_br(jfn, start_bb, cond_id, body_bb, merge_bb)
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_LBRACE {
        g_loop_ctrl = saved_loop_ctrl
        g_loop_head = saved_loop_head
        ret merge_bb
    }
    g_main_pos = g_main_pos + 1
    let body_end = live_compile_block(g_dbg_toks_init, stab, src, jfn, body_bb)
    g_loop_ctrl = saved_loop_ctrl
    g_loop_head = saved_loop_head
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_RBRACE {
        g_main_pos = g_main_pos + 1
    } else if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_EOF {
        emit_jmp(jfn, body_end, start_bb)
        ret merge_bb
    } else {
        report_error("expected '}' to close loop block")
    }
    emit_jmp(jfn, body_end, start_bb)
    ret merge_bb
}

fn live_compile_match(toks: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    g_main_pos = g_main_pos + 1
    let scrutinee = live_codegen_expr_inline(bb)
    expect(TOK_LBRACE)
    let ld_tag = Instr{}
    ld_tag.op = OP_LOAD_MEM
    ld_tag.itype = TYPE_I64
    ld_tag.operand0 = scrutinee
    let tag_val = emit(jfn, bb, &ld_tag)
    let merge_bb = create_block_live(jfn)
    let cur_bb = bb
    let arm_tag = 0
    loop tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_RBRACE and tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_EOF {
        g_main_pos = g_main_pos + 1
        let arm_bb = create_block_live(jfn)
        let next_bb = create_block_live(jfn)
        let tag_const = emit_const(jfn, cur_bb, TYPE_I64, arm_tag)
        let cmp = emit_binop(jfn, cur_bb, OP_CMP_EQ, tag_val, tag_const)
        emit_br(jfn, cur_bb, cmp, arm_bb, next_bb)
        let saved_vc = jfn.var_cnt
        if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_LPAREN {
            g_main_pos = g_main_pos + 1
            let field_idx = 0
            loop tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_RPAREN and tok_type_at_raw(g_dbg_toks_init, g_main_pos) != TOK_EOF {
                let bname_s = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
                let bname_l = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
                g_main_pos = g_main_pos + 1
                let foff = emit_const(jfn, arm_bb, TYPE_I64, (field_idx + 1) * 8)
                let faddr = emit_binop(jfn, arm_bb, OP_ADD, scrutinee, foff)
                let fld = Instr{}
                fld.op = OP_LOAD_MEM
                fld.itype = TYPE_I64
                fld.operand0 = faddr
                let fval = emit(jfn, arm_bb, &fld)
                let fslot = bind_name(jfn, bname_s, bname_l, TYPE_I64)
                let fst = Instr{}
                fst.op = OP_STORE
                fst.operand0 = fval
                fst.operand1 = fslot
                emit(jfn, arm_bb, &fst)
                field_idx = field_idx + 1
                if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_COMMA { g_main_pos = g_main_pos + 1 }
            }
            expect(TOK_RPAREN)
        }
        expect(TOK_EQ)
        expect(TOK_GT)
        let body_val = codegen_expr_inline(g_dbg_toks_init, &g_main_pos, stab, src, jfn, arm_bb)
        let ret_ins = Instr{}
        ret_ins.op = OP_RET
        ret_ins.operand0 = body_val
        emit(jfn, arm_bb, &ret_ins)
        jfn.var_cnt = saved_vc
        cur_bb = next_bb
        arm_tag = arm_tag + 1
    }
    expect(TOK_RBRACE)
    emit_jmp(jfn, cur_bb, merge_bb)
    ret merge_bb
}

fn lower_fn_mark_uses_instr(ctx: &LowerCtx, ins: &Instr) {
    if ins.dead != 0 { ret ok(0) }
    let op = ins.op
    let o0 = ins.operand0
    let o1 = ins.operand1
    let o2 = ins.operand2
    let o3 = ins.operand3
    if op == OP_ADD or op == OP_SUB or op == OP_MUL or op == OP_DIV or op == OP_MOD or
       op == OP_CMP_EQ or op == OP_CMP_NE or op == OP_CMP_LT or op == OP_CMP_GT or
       op == OP_CMP_LTE or op == OP_CMP_GTE or op == OP_AND or op == OP_OR or
       op == OP_SHR or op == OP_SHL {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_RET or op == OP_BR or op == OP_STRLEN or op == OP_STORE or op == OP_PRINT_INT {
        mark_use(ctx, o0)
    }
    if op == OP_LOAD_MEM {
        mark_use(ctx, o0)
    }
    if op == OP_STORE_MEM {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_SYSCALL or op == OP_EPOLL_CTL or op == OP_EPOLL_WAIT {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
        mark_use(ctx, o2)
        mark_use(ctx, ins.bb_target0)
    }
    if op == OP_ALLOC {
        mark_use(ctx, o0)
    }
    if op == OP_DROP {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_CALL or op == OP_CALL_IND {
        if o3 >= 1 { mark_use(ctx, o0) }
        if o3 >= 2 { mark_use(ctx, o1) }
        if o3 >= 3 { mark_use(ctx, o2) }
        if o3 >= 4 { mark_use(ctx, ins.bb_target0) }
        if o3 >= 5 { mark_use(ctx, ins.bb_target1) }
        if o3 >= 6 { mark_use(ctx, ins.imm) }
    }
    if op == OP_TAIL_CALL {
        if o3 >= 1 { mark_use(ctx, o0) }
        if o3 >= 2 { mark_use(ctx, o1) }
        if o3 >= 3 { mark_use(ctx, o2) }
        if o3 >= 4 { mark_use(ctx, ins.bb_target0) }
        if o3 >= 5 { mark_use(ctx, ins.bb_target1) }
        if o3 >= 6 { mark_use(ctx, ins.imm) }
    }
    if op == OP_ATOMIC_LOAD or op == OP_CHAN_NEW or op == OP_CHAN_RECV or op == OP_CHAN_CLOSE or op == OP_GET_NPROCS or op == OP_GET_TID or op == OP_EPOLL_CREATE {
        mark_use(ctx, o0)
    }
    if op == OP_I2F or op == OP_F2I or op == OP_FNEG or op == OP_FSQRT or op == OP_PRINT_FLOAT or op == OP_TNEW1 or op == OP_TLEN or op == OP_TDATA or op == OP_TFREE {
        mark_use(ctx, o0)
    }
    if op == OP_FABS or op == OP_FEXP or op == OP_FLOG or op == OP_FSIN or op == OP_FCOS or op == OP_FTANH {
        mark_use(ctx, o0)
    }
    if op == OP_FADD or op == OP_FSUB or op == OP_FMUL or op == OP_FDIV or op == OP_TNEW2 or op == OP_TGET or op == OP_TFILL or op == OP_TSHAPE {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_FCMP_LT or op == OP_FCMP_GT or op == OP_FCMP_EQ or op == OP_FPOW {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_ATOMIC_STORE {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
    if op == OP_ATOMIC_CAS or op == OP_DEADLOCK_CHK or op == OP_TSET {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
        mark_use(ctx, o2)
    }
    if op == OP_ATOMIC_ADD or op == OP_CTX_SWITCH or op == OP_CHAN_SEND or op == OP_CLONE_THREAD or op == OP_FUTEX_WAIT or op == OP_FUTEX_WAKE {
        mark_use(ctx, o0)
        mark_use(ctx, o1)
    }
}

fn lower_fn_emit_prologue(jfn: &JirFunction, out: &i8, pos: &i64, is_main: i64) {
    emit_push_r(out, pos, PHYS_RBP)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0xE5)
    // Save callee-saved registers: RBX, R13, R14, R15
    emit_push_r(out, pos, PHYS_RBX)
    emit_push_r(out, pos, PHYS_R13)
    emit_push_r(out, pos, PHYS_R14)
    emit_push_r(out, pos, PHYS_R15)
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xEC)
    let frame_sz = 524288
    if is_main == 1 {
        frame_sz = 2097152
    }
    emit_i32_le(out, pos, frame_sz)
    // Stack probe: touch each 4KB page in the frame top-down so the kernel
    // maps them before we access stack slots for parameter storage.
    // Without this, SUB RSP, 512KB skips the guard page and causes SIGSEGV.
    //
    // Emits (22 bytes):
    //   LEA R11, [RBP - 4096]      ; 4C 8D 9D 00 F0 FF FF
    // .probe_loop:
    //   MOV [R11], R11             ; 4B 89 1B
    //   SUB R11, 4096              ; 49 81 EB 00 10 00 00
    //   CMP R11, RSP               ; 49 39 E3
    //   JGE .probe_loop            ; 7D F1  (-15)
    //
    // LEA R11, [RBP - 4096]
    emit_byte(out, pos, 0x4C)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x9D)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0xF0)
    emit_byte(out, pos, 0xFF)
    emit_byte(out, pos, 0xFF)
    // MOV [R11], R11
    emit_byte(out, pos, 0x4B)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x1B)
    // SUB R11, 4096
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xEB)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    // CMP R11, RSP
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x39)
    emit_byte(out, pos, 0xE3)
    // JGE -15
    emit_byte(out, pos, 0x7D)
    emit_byte(out, pos, 0xF1)
    // After loop, R11 = RSP - 4096. Touch two more pages below RSP.
    // When RSP is page-aligned, next fn's probe starts 2 pages below us.
    // Touch 1: MOV [R11], RBX  (R11 = RSP - 4096)
    emit_byte(out, pos, 0x4B)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x1B)
    // SUB R11, 4096  (R11 = RSP - 8192)
    emit_byte(out, pos, 0x49)
    emit_byte(out, pos, 0x81)
    emit_byte(out, pos, 0xEB)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x10)
    emit_byte(out, pos, 0x00)
    emit_byte(out, pos, 0x00)
    // Touch 2: MOV [R11], RBX  (R11 = RSP - 8192)
    emit_byte(out, pos, 0x4B)
    emit_byte(out, pos, 0x89)
    emit_byte(out, pos, 0x1B)
}

fn lower_fn_store_params(jfn: &JirFunction, out: &i8, pos: &i64) {
    let pcnt = jfn.param_cnt
    let pi = 0
    loop pi < pcnt {
        let pr = PHYS_RDI
        if pi == 1 { pr = PHYS_RSI }
        if pi == 2 { pr = PHYS_RDX }
        if pi == 3 { pr = PHYS_RCX }
        if pi == 4 { pr = PHYS_R8 }
        if pi == 5 { pr = PHYS_R9 }
        let pslot = jfn.param_slots[pi]
        emit_store_spill(out, pos, pslot, pr)
        pi = pi + 1
    }
}

fn lower_fn_collect_uses(jfn: &JirFunction, ctx: &LowerCtx) {
    let ui = 0
    loop ui < 8192 {
        ctx.use_cnt[ui] = 0
        g_val_op[ui] = 0
        g_val_imm[ui] = 0
        g_val_load_slot[ui] = -1
        g_val_promo_reg[ui] = -1
        ui = ui + 1
    }
    let bi = 0
    loop bi < jfn.block_cnt {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            lower_fn_mark_uses_instr(ctx, jfn.blocks[bi].instrs[ii])
            let vid = jfn.blocks[bi].instrs[ii].id
            if vid >= 0 and vid < 8192 {
                g_val_op[vid] = jfn.blocks[bi].instrs[ii].op
                g_val_imm[vid] = jfn.blocks[bi].instrs[ii].imm
                if jfn.blocks[bi].instrs[ii].op == OP_LOAD {
                    g_val_load_slot[vid] = jfn.blocks[bi].instrs[ii].operand0
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn lower_fn_mark_promo_patterns(jfn: &JirFunction, ctx: &LowerCtx) {
    // Mark ADD/SUB instructions that can use in-place promoted register ops
    // Pattern: LOAD promo_slot → a, ADD a b → c, STORE c → same promo_slot
    if g_promo_cnt == 0 { ret ok(0) }
    let bi = g_promo_header
    loop bi <= g_promo_body_end {
        let ii = 0
        loop ii < jfn.blocks[bi].instr_cnt {
            let ins_op = jfn.blocks[bi].instrs[ii].op
            let ins_id = jfn.blocks[bi].instrs[ii].id
            let is_arith = 0
            if ins_op == OP_ADD { is_arith = 1 }
            if ins_op == OP_SUB { is_arith = 1 }
            if is_arith == 1 and ins_id >= 0 and ins_id < 8192 {
                let a_id = jfn.blocks[bi].instrs[ii].operand0
                let a_slot = -1
                if a_id >= 0 and a_id < 8192 { a_slot = g_val_load_slot[a_id] }
                let a_promo = -1
                if a_slot >= 0 { a_promo = promo_reg_for_slot(a_slot) }
                if a_promo >= 0 and ctx.use_cnt[ins_id] == 1 {
                    // Scan forward for STORE of this result to same slot
                    let si = ii + 1
                    let found_store = 0
                    loop si < jfn.blocks[bi].instr_cnt {
                        if jfn.blocks[bi].instrs[si].op == OP_STORE {
                            let s_val = jfn.blocks[bi].instrs[si].operand0
                            let s_slot = jfn.blocks[bi].instrs[si].operand1
                            if s_val == ins_id and s_slot == a_slot {
                                found_store = 1
                            }
                        }
                        si = si + 1
                    }
                    if found_store == 1 {
                        g_val_promo_reg[ins_id] = a_promo
                    }
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
}

fn _emit_promo_preloads(out: &i8, pos: &i64) {
    // Preload promoted slots from memory into pinned registers
    if g_promo_cnt >= 1 {
        emit_load_spill(out, pos, PHYS_R13, g_promo_slot0)
    }
    if g_promo_cnt >= 2 {
        emit_load_spill(out, pos, PHYS_R14, g_promo_slot1)
    }
    if g_promo_cnt >= 3 {
        emit_load_spill(out, pos, PHYS_R15, g_promo_slot2)
    }
}

fn _emit_promo_writebacks(out: &i8, pos: &i64) {
    // Write pinned registers back to memory after loop
    if g_promo_cnt >= 1 {
        emit_store_spill(out, pos, g_promo_slot0, PHYS_R13)
    }
    if g_promo_cnt >= 2 {
        emit_store_spill(out, pos, g_promo_slot1, PHYS_R14)
    }
    if g_promo_cnt >= 3 {
        emit_store_spill(out, pos, g_promo_slot2, PHYS_R15)
    }
}

fn lower_fn_emit_blocks(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let i = 0
    loop i < jfn.block_cnt {
        ctx.bb_offsets[i] = pos[0]
        g_cur_block_idx = i
        // Emit writebacks at start of exit block (promoted regs → memory)
        if g_promo_cnt > 0 and i == g_promo_exit {
            _emit_promo_writebacks(out, pos)
        }
        lower_block(jfn.blocks[i], ctx, jfn, out, pos)
        i = i + 1
    }
    g_cur_block_idx = -1
}

fn lower_fn_emit_epilogue(out: &i8, pos: &i64, is_main: i64) {
    if is_main == 1 {
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0xC7)
        emit_byte(out, pos, 0xC0)
        emit_i32_le(out, pos, 60)
        emit_byte(out, pos, 0x48)
        emit_byte(out, pos, 0x31)
        emit_byte(out, pos, 0xFF)
        emit_byte(out, pos, 0x0F)
        emit_byte(out, pos, 0x05)
        ret ok(0)
    }
    // Restore callee-saved registers
    // LEA RSP, [RBP - 32] to point at saved R15
    emit_byte(out, pos, 0x48)
    emit_byte(out, pos, 0x8D)
    emit_byte(out, pos, 0x65)
    emit_byte(out, pos, 0xE0)
    emit_pop_r(out, pos, PHYS_R15)
    emit_pop_r(out, pos, PHYS_R14)
    emit_pop_r(out, pos, PHYS_R13)
    emit_pop_r(out, pos, PHYS_RBX)
    emit_pop_r(out, pos, PHYS_RBP)
    emit_ret_instr(out, pos)
}

fn lower_fn_patch_fixups(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64) {
    let fi = 0
    loop fi < ctx.fix_cnt {
        if ctx.fixups[fi].kind == 0 {
            let co = ctx.fixups[fi].code_off
            let tb = ctx.fixups[fi].target_bb
            if tb >= 0 and tb < jfn.block_cnt and tb < 256 and co >= 0 and co + 3 < pos[0] {
                let target_off = ctx.bb_offsets[tb]
                let rel = target_off - (co + 4)
                poke_byte(out, co,     i32_b0(rel))
                poke_byte(out, co + 1, i32_b1(rel))
                poke_byte(out, co + 2, i32_b2(rel))
                poke_byte(out, co + 3, i32_b3(rel))
            }
        }
        fi = fi + 1
    }
}

fn lower_fn(jfn: &JirFunction, ctx: &LowerCtx, out: &i8, pos: &i64, is_main: i64) {
    g_lower_is_main = is_main
    g_fused_cmp_cc = -1
    let fn_start = pos[0]
    lower_fn_emit_prologue(jfn, out, pos, is_main)
    lower_fn_store_params(jfn, out, pos)
    lower_fn_collect_uses(jfn, ctx)
    loop_promote_scan(jfn)
    lower_fn_mark_promo_patterns(jfn, ctx)
    lower_fn_emit_blocks(jfn, ctx, out, pos)
    // Patch frame size to actual usage (P1: right-sized stack frames)
    if is_main != 1 {
        let real_frame = ctx.ra.sp_top
        if jfn.next_slot_off > real_frame {
            real_frame = jfn.next_slot_off
        }
        real_frame = real_frame + 16
        // Align to 16 bytes
        let rem = real_frame - ((real_frame / 16) * 16)
        if rem > 0 {
            real_frame = real_frame + 16 - rem
        }
        let patch_off = fn_start + 14
        poke_byte(out, patch_off,     i32_b0(real_frame))
        poke_byte(out, patch_off + 1, i32_b1(real_frame))
        poke_byte(out, patch_off + 2, i32_b2(real_frame))
        poke_byte(out, patch_off + 3, i32_b3(real_frame))
        // P4: Skip stack probe for small frames (<=65536 bytes)
        // Probe is 35 bytes starting at fn_start+18. JMP rel8 at byte 18-19.
        // IP after = 20, target = 53, disp = 33.
        if real_frame <= 65536 {
            poke_byte(out, fn_start + 18, 0xEB)
            poke_byte(out, fn_start + 19, 0x21)
        }
    }
    lower_fn_emit_epilogue(out, pos, is_main)
    g_lower_is_main = 0
    lower_fn_patch_fixups(jfn, ctx, out, pos)
    nop_fallthrough_jmps(out, fn_start, pos[0])
}

// Post-fixup: replace JMP rel32 with disp=0 (jumps to next instr) with NOPs
fn nop_fallthrough_jmps(out: &i8, start: i64, end_pos: i64) {
    let i = start
    let lim = end_pos - 4
    loop i < lim {
        let b = out[i]
        if b < 0 { b = b + 256 }
        if b == 0xE9 {
            // Check if the 4-byte displacement is 0
            let d0 = out[i + 1]
            let d1 = out[i + 2]
            let d2 = out[i + 3]
            let d3 = out[i + 4]
            if d0 < 0 { d0 = d0 + 256 }
            if d1 < 0 { d1 = d1 + 256 }
            if d2 < 0 { d2 = d2 + 256 }
            if d3 < 0 { d3 = d3 + 256 }
            let disp = d0 + d1 * 256 + d2 * 65536 + d3 * 16777216
            if disp == 0 {
                // Replace 5-byte JMP with 5-byte NOP (0F 1F 44 00 00)
                poke_byte(out, i, 0x0F)
                poke_byte(out, i + 1, 0x1F)
                poke_byte(out, i + 2, 0x44)
                poke_byte(out, i + 3, 0x00)
                poke_byte(out, i + 4, 0x00)
                i = i + 5
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

fn write_elf(out_fd: i64, code: &i8, code_len: i64,
             strtab: &i8, strtab_len: i64) {
    let buf = alloc_pages(1)
    let pos = 0
    let load_va   = 0x400000
    let hdr_size  = 120
    let code_va   = load_va + hdr_size
    let total     = hdr_size + code_len + strtab_len + 1048576

    // --- ELF Header (64 bytes) ---
    emit_byte(buf, &pos, 0x7F) emit_byte(buf, &pos, 0x45) emit_byte(buf, &pos, 0x4C) emit_byte(buf, &pos, 0x46)
    emit_byte(buf, &pos, 2) emit_byte(buf, &pos, 1) emit_byte(buf, &pos, 1) emit_byte(buf, &pos, 0)
    let pi = 0 loop pi < 8 { emit_byte(buf, &pos, 0) pi = pi + 1 }
    emit_i16_le(buf, &pos, 2)    // e_type = EXEC
    emit_i16_le(buf, &pos, 0x3E) // e_machine = X86_64
    emit_i32_le(buf, &pos, 1)    // e_version
    emit_i64_le(buf, &pos, code_va) // e_entry
    emit_i64_le(buf, &pos, 64)      // e_phoff
    emit_i64_le(buf, &pos, 0)       // e_shoff
    emit_i32_le(buf, &pos, 0)       // e_flags
    emit_i16_le(buf, &pos, 64)      // e_ehsize
    emit_i16_le(buf, &pos, 56)      // e_phentsize
    emit_i16_le(buf, &pos, 1)       // e_phnum
    emit_i16_le(buf, &pos, 0)       // e_shentsize
    emit_i16_le(buf, &pos, 0)       // e_shnum
    emit_i16_le(buf, &pos, 0)       // e_shstrndx

    // --- Program Header (56 bytes) ---
    emit_i32_le(buf, &pos, 1) // p_type = LOAD
    emit_i32_le(buf, &pos, 7) // p_flags = RWX
    emit_i64_le(buf, &pos, 0) // p_offset
    emit_i64_le(buf, &pos, load_va) // p_vaddr
    emit_i64_le(buf, &pos, load_va) // p_paddr
    emit_i64_le(buf, &pos, total)   // p_filesz
    emit_i64_le(buf, &pos, total)   // p_memsz
    emit_i64_le(buf, &pos, 0x200000) // p_align

    syscall(1, out_fd, buf, pos)
    syscall(1, out_fd, code, code_len)
    if strtab_len > 0 { syscall(1, out_fd, strtab, strtab_len) }
    let zero_buf = alloc_pages(256)
    fill_bytes(zero_buf, 1048576, 0)
    syscall(1, out_fd, zero_buf, 1048576)
}

fn get_argv(base: &i64, n: i64) -> &i8 {
    if base == 0 { ret 0 }
    let val = load_i64_at(base, n)
    ret val
}

fn check_unsafe_fn_prefix(toks: &Token, pos: i64) -> i64 {
    if pos > 0 {
        if tok_type_at_raw(toks, pos - 1) == TOK_UNSAFE { g_unsafe_depth = 1 }
    }
    ret 0
}

fn parse_safe_flag(argc: i64, argv_ptr: &i64, ai: i64) -> i64 {
    if argc > ai {
        let maybe_safe = get_argv(argv_ptr, ai)
        if cstr_eq(maybe_safe, "--safe") == 1 {
            g_check_unsafe = 1
            ret ai + 1
        }
    }
    ret ai
}

// Compare two null-terminated C strings. Returns 1 if equal, 0 otherwise.
fn cstr_eq(a: &i8, b: &i8) -> i64 {
    if a == 0 or b == 0 { ret 0 }
    let i = 0
    let matching = 1
    loop matching == 1 {
        let ca = a[i]
        let cb = b[i]
        if ca != cb { ret 0 }
        if ca == 0 { ret 1 }
        i = i + 1
    }
    ret 1
}

// Strip directory path from filename: "/foo/bar/baz.jda" -> start of "baz.jda"
// Returns pointer into the same string (no allocation).
fn basename(path: &i8) -> &i8 {
    let len = cstr_len_max(path, 1024)
    let last_slash = -1
    let i = 0
    loop i < len {
        if path[i] == 47 { last_slash = i }
        i = i + 1
    }
    if last_slash >= 0 {
        ret path + last_slash + 1
    }
    ret path
}

// Strip .jda extension from a path, write result into buf. Returns length written.
// "foo.jda" -> "foo", "bar" -> "bar"
fn strip_ext(path: &i8, buf: &i8, buf_max: i64) -> i64 {
    let len = cstr_len_max(path, 1024)
    let dot = -1
    let i = 0
    loop i < len {
        if path[i] == 46 { dot = i }
        i = i + 1
    }
    let copy_len = len
    if dot >= 0 { copy_len = dot }
    if copy_len > buf_max - 1 { copy_len = buf_max - 1 }
    i = 0
    loop i < copy_len {
        buf[i] = path[i]
        i = i + 1
    }
    buf[copy_len] = 0
    ret copy_len
}


fn print_version() {
    print("jda 0.1.0-dev\n")
}

fn print_usage() {
    eprint("usage: jda build [--include <lib.jda>] <file.jda> [-o output]\n")
    eprint("       jda run [--include <lib.jda>] <file.jda>\n")
    eprint("       jda <input.jda> <output>   (legacy)\n")
    eprint("       jda repl                              (interactive)\n")
    eprint("       jda --version\n")
    eprint("       jda --help\n")
}

// ============================================================
// 13. ENTRY POINT
// ============================================================

fn compile_stashed_lambdas(toks: &Token, src: &i8, src_len: i64) {
    let jfn = g_jfn
    let ctx = g_ctx
    let lam_i = 0
    loop lam_i < g_lambda_cnt {
        let saved_pos = g_main_pos
        let lno = g_lambda_name_offs[lam_i]
        let lnl = g_lambda_name_lens[lam_i]
        let lfi = g_top_fn_cnt
        if lfi < 1024 {
            store_i64_at(g_fn_name_off_tbl, lfi, lno)
            store_i64_at(g_fn_name_len_tbl, lfi, lnl)
            g_top_fn_cnt = lfi + 1
        }
        init_top_jfn(jfn, src, src_len, g_stab_ptr)
        set_cur_fn_name(lno, lnl)
        // Store code offset BEFORE compilation (start of lambda code)
        if lfi < 1024 { store_i64_at(g_fn_code_off_tbl, lfi, g_lam_code_len) }
        g_main_pos = g_lambda_starts[lam_i] + 1
        expect(TOK_LPAREN)
        g_lam_cur_idx = lam_i
        compile_lambda_params_and_body(toks, src, jfn, ctx)
        g_main_pos = saved_pos
        lam_i = lam_i + 1
    }
    g_lambda_cnt = 0
}

fn compile_lambda_params_and_body(toks: &Token, src: &i8, jfn: &JirFunction, ctx: &LowerCtx) {
    let lam_idx = g_lam_cur_idx
    let cap_cnt = g_lambda_starts[64 + lam_idx]
    let force_wrapped = 0
    if cap_cnt == -1 {
        force_wrapped = 1
        cap_cnt = 0
    }
    let cap_base = lam_idx * 8
    // Inject hidden first param "__cls" for closures
    let cls_slot = -1
    if cap_cnt > 0 or force_wrapped == 1 {
        let cls_off = g_runtime_src_len
        poke_byte(src, cls_off, 95)
        poke_byte(src, cls_off + 1, 95)
        poke_byte(src, cls_off + 2, 99)
        poke_byte(src, cls_off + 3, 108)
        poke_byte(src, cls_off + 4, 115)
        g_runtime_src_len = cls_off + 5
        cls_slot = bind_name(jfn, cls_off, 5, TYPE_I64)
        if jfn.param_cnt < 16 {
            jfn.param_slots[jfn.param_cnt] = cls_slot
            jfn.param_cnt = jfn.param_cnt + 1
        }
    }
    // Parse params
    let more = 0
    if tok_type_at(toks, g_main_pos) != TOK_RPAREN { more = 1 }
    loop more == 1 {
        let ns = tok_str_start_at(toks, g_main_pos)
        let nl = tok_str_len_at(toks, g_main_pos)
        expect(TOK_IDENT)
        let st = TYPE_I64
        if tok_type_at(toks, g_main_pos) == TOK_COLON {
            g_main_pos = g_main_pos + 1
            if tok_type_at(toks, g_main_pos) == TOK_AMP { g_main_pos = g_main_pos + 1 }
            let pt = tok_type_at(toks, g_main_pos)
            if pt == TOK_I32 { st = TYPE_I32 }
            if pt == TOK_I8  { st = TYPE_I8 }
            if pt == TOK_F64 { st = TYPE_F64 }
            g_main_pos = g_main_pos + 1
        }
        let sl = bind_name(jfn, ns, nl, st)
        if jfn.param_cnt < 16 {
            jfn.param_slots[jfn.param_cnt] = sl
            jfn.param_cnt = jfn.param_cnt + 1
        }
        if tok_type_at(toks, g_main_pos) == TOK_COMMA { g_main_pos = g_main_pos + 1 }
        else { more = 0 }
    }
    expect(TOK_RPAREN)
    parse_skip_ret_type(toks)
    expect(TOK_LBRACE)
    // Compile body
    regalloc_init(ctx as &RegAlloc)
    ctx.fix_cnt = 0
    let bb = create_block_live(jfn)
    // If closure, unpack captured variables from __cls struct
    if cap_cnt > 0 and cls_slot != -1 {
        let ci = 0
        loop ci < cap_cnt {
            let cx = 64 + cap_base + ci
            let cns = g_lambda_ends[cx]
            let cnl = g_lambda_name_offs[cx]
            // Load __cls
            let cls_ld = Instr{}
            cls_ld.op = OP_LOAD
            cls_ld.operand0 = cls_slot
            let cls_val = emit(jfn, bb, &cls_ld)
            // Compute address: cls + (ci+1)*8
            let coff_id = emit_const(jfn, bb, TYPE_I64, (ci + 1) * 8)
            let caddr_id = emit_binop(jfn, bb, OP_ADD, cls_val, coff_id)
            // Load captured value
            let cap_ld = Instr{}
            cap_ld.op = OP_LOAD_MEM
            cap_ld.operand0 = caddr_id
            cap_ld.itype = TYPE_I64
            let cap_val = emit(jfn, bb, &cap_ld)
            // Bind as local variable with captured name
            let cap_slot = bind_name(jfn, cns, cnl, TYPE_I64)
            let cap_st = Instr{}
            cap_st.op = OP_STORE
            cap_st.operand0 = cap_val
            cap_st.operand1 = cap_slot
            emit(jfn, bb, &cap_st)
            ci = ci + 1
        }
    }
    let fb = live_compile_block(toks, g_stab_ptr, src, jfn, bb)
    let rv = emit_const(jfn, fb, TYPE_I64, 0)
    let ri = Instr{}
    ri.op = OP_RET
    ri.operand0 = rv
    emit(jfn, fb, &ri)
    fold_constants(jfn)
    dce(jfn)
    tail_call_opt(jfn)
    peephole(jfn)
    lower_fn(jfn, ctx, g_code_buf, &g_lam_code_len, 0)
    compile_lambda_fixups(ctx)
}

fn compile_lambda_fixups(ctx: &LowerCtx) {
    let sc = g_lam_strtab_cnt
    let cc = g_lam_call_cnt
    let mp = g_lam_merged_pos
    let i = 0
    loop i < ctx.fix_cnt {
        let k = ctx.fixups[i].kind
        if k == 1 {
            g_gf_strtab_co[sc]   = ctx.fixups[i].code_off
            g_gf_strtab_tgt[sc]  = ctx.fixups[i].target_bb
            g_gf_strtab_base[sc] = mp
            sc = sc + 1
        } else if k == 3 {
            let tb = ctx.fixups[i].target_bb
            let nt = 0 - tb
            g_gf_strtab_co[sc]   = ctx.fixups[i].code_off
            g_gf_strtab_tgt[sc]  = nt - 1
            g_gf_strtab_base[sc] = 0
            sc = sc + 1
        } else if k == 2 {
            g_gf_call_co[cc]   = ctx.fixups[i].code_off
            g_gf_call_name[cc] = ctx.fixups[i].target_bb
            g_gf_call_nlen[cc] = ctx.fixups[i].str_len
            cc = cc + 1
        }
        i = i + 1
    }
    g_lam_strtab_cnt = sc
    g_lam_call_cnt = cc
    let jfn = g_jfn
    let si = 0
    let slen = jfn.strtab_pos
    loop si < slen {
        poke_byte(g_merged_str, mp, jfn.strtab[si])
        mp = mp + 1
        si = si + 1
    }
    g_lam_merged_pos = mp
}

// ============================================================
// REPL (Read-Eval-Print Loop)
// ============================================================

fn repl_starts_with(line: &i8, pfx: &i8, plen: i64) -> i64 {
    let i = 0
    loop i < plen {
        if line[i] != pfx[i] { ret 0 }
        i = i + 1
    }
    ret 1
}

fn repl_classify(line: &i8, len: i64) -> i64 {
    if len >= 3 {
        if line[0] == 102 and line[1] == 110 and line[2] == 32 { ret 1 }
    }
    if len >= 7 {
        if repl_starts_with(line, "struct ", 7) == 1 { ret 1 }
    }
    if len >= 6 {
        if repl_starts_with(line, "const ", 6) == 1 { ret 1 }
    }
    ret 0
}

fn repl_buf_copy(dst: &i8, doff: i64, src: &i8, soff: i64, len: i64) {
    let i = 0
    loop i < len {
        poke_byte(dst, doff + i, src[soff + i])
        i = i + 1
    }
}

fn repl_buf_copy_cstr(dst: &i8, doff: i64, s: &i8) -> i64 {
    let slen = cstr_len_max(s, 4096)
    repl_buf_copy(dst, doff, s, 0, slen)
    ret doff + slen
}

fn repl_compose_source() -> i64 {
    let buf = g_repl_src_buf
    let p = 0
    repl_buf_copy(buf, 0, g_repl_def_buf, 0, g_repl_def_len)
    p = g_repl_def_len
    p = repl_buf_copy_cstr(buf, p, "fn main() {\n")
    repl_buf_copy(buf, p, g_repl_stmt_buf, 0, g_repl_stmt_len)
    p = p + g_repl_stmt_len
    p = repl_buf_copy_cstr(buf, p, "}\n")
    ret p
}

fn repl_write_tmp(buf: &i8, len: i64) {
    let fd = syscall(2, "/tmp/jda_repl.jda", 577, 420)
    if fd < 0 { ret 0 }
    syscall(1, fd, buf, len)
    syscall(3, fd, 0, 0)
    ret 0
}

fn repl_fork_compile(self_path: &i8) -> i64 {
    let pid = syscall(57, 0, 0, 0)
    if pid == 0 {
        let devnull = syscall(2, "/dev/null", 1, 0)
        if devnull >= 0 { syscall(33, devnull, 1, 0) }
        let argv = alloc_pages(1)
        store_i64_at(argv, 0, self_path)
        store_i64_at(argv, 1, "build")
        store_i64_at(argv, 2, "/tmp/jda_repl.jda")
        store_i64_at(argv, 3, "-o")
        store_i64_at(argv, 4, "/tmp/jda_repl")
        store_i64_at(argv, 5, 0)
        let envp = alloc_pages(1)
        store_i64_at(envp, 0, 0)
        syscall(59, self_path, argv, envp)
        syscall(60, 1, 0, 0)
        ret 0
    }
    let status_buf = alloc_pages(1)
    syscall(61, pid, status_buf, 0)
    let status = status_buf[0]
    let exit_code = status / 256
    if exit_code == 0 { ret 1 }
    ret 0
}

fn repl_fork_run() {
    let pid = syscall(57, 0, 0, 0)
    if pid == 0 {
        let argv = alloc_pages(1)
        store_i64_at(argv, 0, "/tmp/jda_repl")
        store_i64_at(argv, 1, 0)
        let envp = alloc_pages(1)
        store_i64_at(envp, 0, 0)
        syscall(59, "/tmp/jda_repl", argv, envp)
        syscall(60, 1, 0, 0)
    }
    let status_buf = alloc_pages(1)
    syscall(61, pid, status_buf, 0)
}

fn repl_is_quit(line: &i8, len: i64) -> i64 {
    if len == 2 {
        if line[0] == 58 and line[1] == 113 { ret 1 }
    }
    if len == 5 {
        if repl_starts_with(line, ":quit", 5) == 1 { ret 1 }
    }
    ret 0
}

fn repl_append_line(line: &i8, line_len: i64) {
    if repl_classify(line, line_len) == 1 {
        repl_buf_copy(g_repl_def_buf, g_repl_def_len, line, 0, line_len)
        g_repl_def_len = g_repl_def_len + line_len
        poke_byte(g_repl_def_buf, g_repl_def_len, 10)
        g_repl_def_len = g_repl_def_len + 1
    } else {
        repl_buf_copy(g_repl_stmt_buf, g_repl_stmt_len, line, 0, line_len)
        g_repl_stmt_len = g_repl_stmt_len + line_len
        poke_byte(g_repl_stmt_buf, g_repl_stmt_len, 10)
        g_repl_stmt_len = g_repl_stmt_len + 1
    }
}

fn repl_process_line(self_path: &i8, line: &i8, line_len: i64) -> i64 {
    if line_len == 0 { ret 1 }
    if repl_is_quit(line, line_len) == 1 { ret 0 }
    let saved_def_len = g_repl_def_len
    let saved_stmt_len = g_repl_stmt_len
    repl_append_line(line, line_len)
    let src_len = repl_compose_source()
    repl_write_tmp(g_repl_src_buf, src_len)
    let compile_ok = repl_fork_compile(self_path)
    if compile_ok == 1 {
        repl_fork_run()
    } else {
        g_repl_def_len = saved_def_len
        g_repl_stmt_len = saved_stmt_len
    }
    ret 1
}

fn repl_check(argc: i64, argv_ptr: &i64) {
    if argc >= 2 {
        let a1 = get_argv(argv_ptr, 1)
        if cstr_eq(a1, "repl") == 1 {
            repl_run(argv_ptr)
        }
    }
}

fn repl_run(argv_ptr: &i64) {
    g_repl_def_buf = alloc_pages(64)
    g_repl_stmt_buf = alloc_pages(64)
    g_repl_line_buf = alloc_pages(2)
    g_repl_src_buf = alloc_pages(128)
    g_repl_def_len = 0
    g_repl_stmt_len = 0
    let self_path = get_argv(argv_ptr, 0)
    eprint("Jda REPL - type :q to quit\n")
    let running = 1
    loop running == 1 {
        eprint("jda> ")
        let nread = syscall(0, 0, g_repl_line_buf, 4096)
        if nread <= 0 { running = 0 }
        if running == 1 {
            let line_len = nread
            if line_len > 0 {
                let last = line_len - 1
                if g_repl_line_buf[last] == 10 { line_len = last }
            }
            running = repl_process_line(self_path, g_repl_line_buf, line_len)
        }
    }
    syscall(60, 0, 0, 0)
}

// ============================================================
// IMPORT PROCESSING
// ============================================================
// Scans user source for `import "pkg"` lines and prepends stdlib files.

fn import_open_file(path: &i8) -> i64 {
    let fd = syscall(2, path, 0, 0)
    ret fd
}

fn import_read_file(fd: i64, dest: &i8, max_len: i64) -> i64 {
    let n = syscall(0, fd, dest, max_len)
    ret n
}

fn import_close_file(fd: i64) {
    syscall(3, fd, 0, 0)
}

fn import_build_path(src: &i8, name_start: i64, name_len: i64, path_buf: &i8) -> i64 {
    // Build "stdlib/<name>.jda" in path_buf
    // "stdlib/" = 7 bytes
    poke_byte(path_buf, 0, 115)  // s
    poke_byte(path_buf, 1, 116)  // t
    poke_byte(path_buf, 2, 100)  // d
    poke_byte(path_buf, 3, 108)  // l
    poke_byte(path_buf, 4, 105)  // i
    poke_byte(path_buf, 5, 98)   // b
    poke_byte(path_buf, 6, 47)   // /
    let i = 0
    loop i < name_len {
        let ch = src[name_start + i]
        poke_byte(path_buf, 7 + i, ch)
        i = i + 1
    }
    // ".jda" = 4 bytes
    let off = 7 + name_len
    poke_byte(path_buf, off, 46)      // .
    poke_byte(path_buf, off + 1, 106) // j
    poke_byte(path_buf, off + 2, 100) // d
    poke_byte(path_buf, off + 3, 97)  // a
    poke_byte(path_buf, off + 4, 0)   // null terminator
    ret off + 4
}

fn import_already_loaded(src: &i8, name_start: i64, name_len: i64) -> i64 {
    // Check if this package name is already in g_import_names
    let i = 0
    loop i < g_import_count {
        let base = i * 64
        let j = 0
        let eq = 1
        let stored_len = g_import_names[base + 63]
        if stored_len != name_len { eq = 0 }
        if eq == 1 {
            loop j < name_len {
                if g_import_names[base + j] != src[name_start + j] {
                    eq = 0
                }
                j = j + 1
            }
        }
        if eq == 1 { ret 1 }
        i = i + 1
    }
    ret 0
}

fn import_record_name(src: &i8, name_start: i64, name_len: i64) {
    // Store package name in g_import_names for dedup
    if g_import_count >= 64 { ret 0 }
    let base = g_import_count * 64
    let i = 0
    let cpy_len = name_len
    if cpy_len > 62 { cpy_len = 62 }
    loop i < cpy_len {
        poke_byte(g_import_names, base + i, src[name_start + i])
        i = i + 1
    }
    poke_byte(g_import_names, base + 63, cpy_len)  // store length
    g_import_count = g_import_count + 1
}

fn import_is_line_start(src: &i8, p: i64) -> i64 {
    if p == 0 { ret 1 }
    let prev = p - 1
    if src[prev] == 10 { ret 1 }
    ret 0
}

fn import_check_keyword(src: &i8, ws: i64) -> i64 {
    // Check if src[ws..ws+7] is "import "
    if src[ws] != 105 { ret 0 }
    if src[ws+1] != 109 { ret 0 }
    if src[ws+2] != 112 { ret 0 }
    if src[ws+3] != 111 { ret 0 }
    if src[ws+4] != 114 { ret 0 }
    if src[ws+5] != 116 { ret 0 }
    if src[ws+6] != 32 { ret 0 }
    ret 1
}

fn import_find_next(src: &i8, src_len: i64, start: i64) -> i64 {
    let p = start
    loop p < src_len {
        let at_sol = import_is_line_start(src, p)
        if at_sol == 1 {
            // Skip leading whitespace
            let ws = p
            loop ws < src_len {
                if src[ws] != 32 and src[ws] != 9 {
                    ws = src_len  // break
                }
                if src[ws] == 32 or src[ws] == 9 {
                    ws = ws + 1
                }
            }
            // ws now might be past whitespace — recalculate
            // Actually, just redo with a simpler skip
        }
        // Actually let me simplify: just check each position
        if at_sol == 1 {
            let ws2 = p
            let ws_done = 0
            loop ws_done == 0 {
                if ws2 >= src_len { ws_done = 1 }
                if ws_done == 0 {
                    if src[ws2] == 32 or src[ws2] == 9 {
                        ws2 = ws2 + 1
                    } else {
                        ws_done = 1
                    }
                }
            }
            if ws2 + 7 < src_len {
                if import_check_keyword(src, ws2) == 1 {
                    ret ws2
                }
            }
        }
        // Advance to next line
        let line_done = 0
        loop line_done == 0 {
            if p >= src_len { line_done = 1 }
            if line_done == 0 {
                if src[p] == 10 { line_done = 1 }
                p = p + 1
            }
        }
    }
    ret 0 - 1
}

fn import_extract_name(src: &i8, src_len: i64, import_pos: i64) -> i64 {
    // Given position of "import", extract the quoted package name
    // Returns packed: (name_start << 32) | name_len, or 0 on error
    let p = import_pos + 7  // skip "import "
    // Skip whitespace
    let sk_done = 0
    loop sk_done == 0 {
        if p >= src_len { sk_done = 1 }
        if sk_done == 0 {
            if src[p] == 32 or src[p] == 9 {
                p = p + 1
            } else {
                sk_done = 1
            }
        }
    }
    // Expect opening quote (34 = ")
    if p >= src_len { ret 0 }
    if src[p] != 34 { ret 0 }
    p = p + 1
    let name_start = p
    // Find closing quote
    let q_done = 0
    loop q_done == 0 {
        if p >= src_len { q_done = 1 }
        if q_done == 0 {
            if src[p] == 34 or src[p] == 10 {
                q_done = 1
            } else {
                p = p + 1
            }
        }
    }
    if p >= src_len { ret 0 }
    if src[p] != 34 { ret 0 }
    let name_len = p - name_start
    if name_len == 0 { ret 0 }
    let result = (name_start << 32) | name_len
    ret result
}

fn import_blank_line(src: &i8, src_len: i64, pos: i64) {
    // Replace the import line with semicolons (comment chars) so lexer skips it
    let p = pos
    loop p < src_len and src[p] != 10 {
        poke_byte(src, p, 32)  // space
        p = p + 1
    }
}

fn import_read_one(src: &i8, name_start: i64, name_len: i64, dest: &i8, max_len: i64) -> i64 {
    // Build path, open, read, close. Returns bytes read or -1 on error.
    import_build_path(src, name_start, name_len, g_import_path_buf)
    let fd = import_open_file(g_import_path_buf)
    if fd < 0 { ret 0 - 1 }
    let n = import_read_file(fd, dest, max_len)
    import_close_file(fd)
    ret n
}

fn process_imports(src: &i8, src_len: i64, prepend_buf: &i8) -> i64 {
    // Scan src for import lines, read each stdlib file into prepend_buf.
    // Returns total bytes written to prepend_buf.
    // Blanks out import lines in src.
    g_import_count = 0
    let out_off = 0
    let max_prepend = 2097152  // 2MB max for all imports
    let search_pos = 0
    let running = 1
    loop running == 1 {
        let imp_pos = import_find_next(src, src_len, search_pos)
        if imp_pos < 0 { running = 0 }
        if running == 1 {
            let packed = import_extract_name(src, src_len, imp_pos)
            if packed == 0 {
                // Invalid import syntax, skip this line
                search_pos = imp_pos + 1
            } else {
                let name_start = packed >> 32
                let name_len = packed & 65535
                if import_already_loaded(src, name_start, name_len) == 1 {
                    import_blank_line(src, src_len, imp_pos)
                    search_pos = imp_pos + 1
                } else {
                    import_record_name(src, name_start, name_len)
                    let space = max_prepend - out_off
                    let n = import_read_one(src, name_start, name_len, prepend_buf + out_off, space)
                    if n < 0 {
                        eprint("warning: import file not found: ")
                        import_build_path(src, name_start, name_len, g_import_path_buf)
                        eprint(g_import_path_buf)
                        eprint("\n")
                    }
                    if n > 0 {
                        out_off = out_off + n
                        // Add newline separator
                        poke_byte(prepend_buf, out_off, 10)
                        out_off = out_off + 1
                    }
                    import_blank_line(src, src_len, imp_pos)
                    search_pos = imp_pos + 1
                }
            }
        }
    }
    ret out_off
}

fn import_shift_and_copy(src_buf: &i8, buf_off: i64, user_len: i64, import_buf: &i8, import_len: i64) {
    // Shift user source right and copy import content into the gap
    let user_src = src_buf + buf_off
    let new_start = buf_off + import_len
    let si = user_len - 1
    loop si >= 0 {
        poke_byte(src_buf, new_start + si, user_src[si])
        si = si - 1
    }
    let di = 0
    loop di < import_len {
        poke_byte(src_buf, buf_off + di, import_buf[di])
        di = di + 1
    }
}

fn do_imports(src_buf: &i8, buf_off: i64, read_len: i64) -> i64 {
    // Process import statements in user source. Returns total src_len.
    g_import_path_buf = alloc_pages(1)
    g_import_names = alloc_pages(1)
    let import_buf = alloc_pages(256)     // 1MB for import content
    let user_src = src_buf + buf_off
    let import_len = process_imports(user_src, read_len, import_buf)
    if import_len > 0 {
        import_shift_and_copy(src_buf, buf_off, read_len, import_buf, import_len)
    }
    let total = buf_off + import_len + read_len
    ret total
}

fn defer_skip_call(toks0: &Token, pos: i64) -> i64 {
    // Skip past a function call expression: name ( ... )
    // Returns position after the closing paren.
    pos = pos + 1  // skip function name
    if tok_type_at_raw(toks0, pos) == TOK_LPAREN {
        let dd = 1
        pos = pos + 1
        loop dd > 0 {
            let dtt = tok_type_at_raw(toks0, pos)
            if dtt == TOK_LPAREN { dd = dd + 1 }
            if dtt == TOK_RPAREN { dd = dd - 1 }
            pos = pos + 1
        }
    }
    ret pos
}

fn defer_emit_calls(toks0: &Token, stab: &StructTable, src: &i8, jfn: &JirFunction, cur: i64) {
    // Emit all deferred calls in LIFO order.
    if g_defer_count > 0 {
        let di = g_defer_count - 1
        loop di >= 0 {
            let dp = load_i64_at(g_defer_pos, di)
            codegen_expr_inline(toks0, &dp, stab, src, jfn, cur)
            di = di - 1
        }
    }
}

fn main(argc: i64, argv_ptr: &i64) {
    let src_path: &i8 = 0
    let out_path: &i8 = 0
    let include_path: &i8 = 0
    g_argv_base = argv_ptr
    repl_check(argc, argv_ptr)

    if argc < 2 {
        print_usage()
        syscall(60, 2, 0, 0)
    }

    let arg1 = get_argv(argv_ptr, 1)

    let out_buf = alloc_pages(1) // 4KB for output path buffer

    // --help / -h
    if cstr_eq(arg1, "--help") == 1 or cstr_eq(arg1, "-h") == 1 {
        print_usage()
        syscall(60, 0, 0, 0)
    }

    // --version / -V
    if cstr_eq(arg1, "--version") == 1 or cstr_eq(arg1, "-V") == 1 {
        print_version()
        syscall(60, 0, 0, 0)
    }

    // jda build [--include <lib>] [--safe] <file> [-o output]
    if cstr_eq(arg1, "build") == 1 {
        let ai = 2
        if argc > ai {
            let maybe_inc = get_argv(argv_ptr, ai)
            if cstr_eq(maybe_inc, "--include") == 1 {
                ai = ai + 1
                if argc <= ai {
                    eprint("error: --include requires a file path\n")
                    syscall(60, 2, 0, 0)
                }
                include_path = get_argv(argv_ptr, ai)
                ai = ai + 1
            }
        }
        ai = parse_safe_flag(argc, argv_ptr, ai)
        if argc <= ai {
            eprint("error: missing input file\n")
            print_usage()
            syscall(60, 2, 0, 0)
        }
        src_path = get_argv(argv_ptr, ai)
        ai = ai + 1
        // Check for -o flag
        if argc > ai + 1 {
            let maybe_o = get_argv(argv_ptr, ai)
            if cstr_eq(maybe_o, "-o") == 1 {
                out_path = get_argv(argv_ptr, ai + 1)
            }
        }
        if out_path == 0 {
            strip_ext(src_path, out_buf, 256)
            out_path = out_buf
        }
    } else if cstr_eq(arg1, "run") == 1 {
        // jda run [--include <lib>] <file>
        let ai = 2
        if argc > ai {
            let maybe_inc = get_argv(argv_ptr, ai)
            if cstr_eq(maybe_inc, "--include") == 1 {
                ai = ai + 1
                if argc <= ai {
                    eprint("error: --include requires a file path\n")
                    syscall(60, 2, 0, 0)
                }
                include_path = get_argv(argv_ptr, ai)
                ai = ai + 1
            }
        }
        if argc <= ai {
            eprint("error: missing input file\n")
            print_usage()
            syscall(60, 2, 0, 0)
        }
        src_path = get_argv(argv_ptr, ai)
        strip_ext("/tmp/jda_run_out.x", out_buf, 256)
        out_path = out_buf
    } else if argc >= 3 {
        // Legacy mode: jda <input> <output>
        src_path = arg1
        out_path = get_argv(argv_ptr, 2)
    } else {
        // Single arg that isn't a subcommand — treat as build
        src_path = arg1
        strip_ext(src_path, out_buf, 256)
        out_path = out_buf
    }

    g_out_path_ptr = out_path
    g_src_filename = src_path

    let src_buf = alloc_pages(256)  // 1MB
    g_src_buf_ptr = src_buf
    let buf_off = 0

    // Read include file first (prepend to source)
    if include_path != 0 {
        let inc_fd = syscall(2, include_path, 0, 0)
        if inc_fd < 0 { panic("open include failed") }
        let inc_len = syscall(0, inc_fd, src_buf, 524288)
        if inc_len < 0 { panic("read include failed") }
        syscall(3, inc_fd, 0, 0)
        buf_off = inc_len
        poke_byte(src_buf, buf_off, 10)
        buf_off = buf_off + 1
    }

    // Read user source (appended after include)
    let src_fd = syscall(2, src_path, 0, 0)
    if src_fd < 0 { panic("open src failed") }
    let read_len = syscall(0, src_fd, src_buf + buf_off, 1048576 - buf_off)
    if read_len < 0 { panic("read src failed") }
    syscall(3, src_fd, 0, 0)
    let src_len = buf_off + read_len

    // Process import statements (all in separate function to avoid local overflow)
    src_len = do_imports(src_buf, buf_off, read_len)

    g_runtime_src_len = src_len
    let toks = alloc_pages(2048) // 8MiB
    g_dbg_toks = toks
    g_dbg_toks_init = toks
    let tok_cnt = lex_main_input()
    print("LEX_OK tc=")
    print_i64(g_lex_count)
    print("\n")
    g_dbg_tok_cnt = g_lex_count
    g_scan_tok_cnt = g_lex_count
    print("INIT_STATE\n")
    init_large_post_lex_state()
    print("CONST_PRE\n")
    run_top_const_prelude(g_dbg_toks_init, g_src_buf_ptr, g_runtime_src_len)
    print("STRUCT_PRE\n")
    run_top_struct_prelude(g_dbg_toks_init, g_stab_ptr, g_src_buf_ptr, g_runtime_src_len)
    print("FN_SCAN\n")
    // Pass 1: Scan for global functions
    let fn_name_off = alloc_pages(2)
    let fn_name_len = alloc_pages(2)
    let fn_code_off = alloc_pages(2) // 1024 entries
    let fn_ret_types = alloc_pages(2)
    let fn_param_cnts = alloc_pages(2)
    g_fn_name_off_tbl = fn_name_off
    g_fn_name_len_tbl = fn_name_len
    g_fn_code_off_tbl = fn_code_off
    g_fn_param_cnt_tbl = fn_param_cnts
    // Enum table (packed flat buffer)
    g_enum_buf = alloc_pages(1)
    g_enum_buf[0] = 1
    // Derive tracking arrays
    g_derive_trait_id = alloc_pages(1)
    g_derive_sname_off = alloc_pages(1)
    g_derive_sname_len = alloc_pages(1)
    g_derive_struct_tok = alloc_pages(1)
    g_derive_field_off = alloc_pages(1)
    g_derive_field_len = alloc_pages(1)
    // Generic function table
    g_genfn_buf = alloc_pages(1)
    g_genfn_buf[0] = 0
    g_genfn_buf[200] = 0
    g_trait_buf = alloc_pages(2)
    g_trait_cnt = 0
    g_trait_copy_pos = g_scan_tok_cnt + 2000
    print("PREP_FN\n")
    prepare_top_fn_scan(toks, src_buf, src_len, fn_name_off, fn_name_len)
    print("PREP_FN_DONE\n")
    // Generic function expansion: scan, expand, re-scan
    scan_generic_fns(toks, src_buf, g_scan_tok_cnt)
    if g_genfn_buf[0] > 0 {
        let new_tok_cnt = expand_all_generics(g_scan_tok_cnt)
        g_dbg_tok_cnt = new_tok_cnt
        g_scan_tok_cnt = new_tok_cnt
        prepare_top_fn_scan(toks, src_buf, g_runtime_src_len, fn_name_off, fn_name_len)
    }
    // Trait declaration scanning (before impl expansion)
    scan_trait_decls(g_scan_tok_cnt)
    // Blank trait tokens before impl expansion (default bodies already copied to high area)
    if g_trait_cnt > 0 {
        blank_trait_decl_toks(g_scan_tok_cnt)
        prepare_top_fn_scan(toks, src_buf, g_runtime_src_len, fn_name_off, fn_name_len)
    }
    // Impl block expansion: scan, expand methods, re-scan
    let impl_new_cnt = expand_impl_blocks(g_scan_tok_cnt)
    if g_genfn_buf[200] > 0 {
        g_dbg_tok_cnt = impl_new_cnt
        g_scan_tok_cnt = impl_new_cnt
        prepare_top_fn_scan(toks, src_buf, g_runtime_src_len, fn_name_off, fn_name_len)
    }
    // Derive attribute expansion
    scan_derive_attrs(g_scan_tok_cnt)
    if g_derive_cnt > 0 {
        let derive_new_cnt = expand_derive_toks(g_scan_tok_cnt)
        g_dbg_tok_cnt = derive_new_cnt
        g_scan_tok_cnt = derive_new_cnt
        prepare_top_fn_scan(toks, src_buf, g_runtime_src_len, fn_name_off, fn_name_len)
    }
    // Blank forward declarations (fn name(...) -> type without body)
    blank_fwd_decl_toks(g_scan_tok_cnt)
    // Prepare output buffers
    let code_buf = alloc_pages(4096) // 16MB
    let code_len = 0
    let merged_str = alloc_pages(64)  // 256KB
    let merged_pos = 0
    let glob_buf = alloc_pages(128)  // 512KB
    // Set compile state globals for lambda helper
    g_code_buf = code_buf
    g_merged_str = merged_str
    print("BUFS_OK\n")
    print("PRE_EMIT\n")
    // _start: preserve initial stack frame, mmap heap, then call main(argc, argv)
    emit_byte(code_buf, &code_len, 0x48)             // mov rbp, rsp
    print("E1\n")
    emit_byte(code_buf, &code_len, 0x89)
    print("E2\n")
    emit_byte(code_buf, &code_len, 0xE5)
    print("E3\n")
    emit_byte(code_buf, &code_len, 0xB8)             // mov eax, 9
    print("E4\n")
    emit_i32_le(code_buf, &code_len, 9)
    print("E5\n")
    emit_byte(code_buf, &code_len, 0x31)             // xor edi, edi
    print("E6\n")
    emit_byte(code_buf, &code_len, 0xFF)
    print("E7\n")
    emit_byte(code_buf, &code_len, 0xBE)             // mov esi, 0x59A20
    print("E8\n")
    emit_i32_le(code_buf, &code_len, 367136)
    print("E9\n")
    emit_byte(code_buf, &code_len, 0xBA)             // mov edx, 3
    print("E10\n")
    emit_i32_le(code_buf, &code_len, 3)
    print("E11\n")
    emit_byte(code_buf, &code_len, 0x41)             // mov r10d, 0x22
    print("E12\n")
    emit_byte(code_buf, &code_len, 0xBA)
    print("E13\n")
    emit_i32_le(code_buf, &code_len, 34)
    print("E14\n")
    emit_byte(code_buf, &code_len, 0x41)             // mov r8d, -1
    print("E15\n")
    emit_byte(code_buf, &code_len, 0xB8)
    print("E16\n")
    emit_i32_le(code_buf, &code_len, -1)
    print("E17\n")
    emit_byte(code_buf, &code_len, 0x45)             // xor r9d, r9d
    print("E18\n")
    emit_byte(code_buf, &code_len, 0x31)
    print("E19\n")
    emit_byte(code_buf, &code_len, 0xC9)
    print("E20\n")
    emit_byte(code_buf, &code_len, 0x0F)             // syscall
    print("E21\n")
    emit_byte(code_buf, &code_len, 0x05)
    print("E22\n")
    emit_byte(code_buf, &code_len, 0x49)             // mov r15, rax
    print("E23\n")
    emit_byte(code_buf, &code_len, 0x89)
    print("E24\n")
    emit_byte(code_buf, &code_len, 0xC7)
    print("E25\n")
    emit_byte(code_buf, &code_len, 0x48)             // mov rdi, [rbp+0]
    print("E26\n")
    emit_byte(code_buf, &code_len, 0x8B)
    print("E27\n")
    emit_byte(code_buf, &code_len, 0x7D)
    print("E28\n")
    emit_byte(code_buf, &code_len, 0x00)
    print("E29\n")
    emit_byte(code_buf, &code_len, 0x48)             // lea rsi, [rbp+8]
    print("E30\n")
    emit_byte(code_buf, &code_len, 0x8D)
    print("E31\n")
    emit_byte(code_buf, &code_len, 0x75)
    print("E32\n")
    emit_byte(code_buf, &code_len, 0x08)
    print("E33\n")
    emit_byte(code_buf, &code_len, 0xE8)             // call rel32
    print("E34\n")
    emit_i32_le(code_buf, &code_len, 0)              // placeholder
    print("E35\n")
    emit_byte(code_buf, &code_len, 0xB8)
    print("E36\n")
    emit_i32_le(code_buf, &code_len, 60)             // exit(0)
    print("E37\n")
    emit_byte(code_buf, &code_len, 0x31)
    print("E38\n")
    emit_byte(code_buf, &code_len, 0xFF)
    print("E39\n")
    emit_byte(code_buf, &code_len, 0x0F)
    print("E40\n")
    emit_byte(code_buf, &code_len, 0x05)
    print("E41\n")

    // Fixup arrays
    print("FIXUP_ALLOC\n")
    let gf_strtab_co   = alloc_pages(16)
    let gf_strtab_tgt  = alloc_pages(16)
    let gf_strtab_base = alloc_pages(16)
    let gf_strtab_cnt  = 0
    let gf_call_co     = alloc_pages(16)
    let gf_call_name   = alloc_pages(16)
    let gf_call_nlen   = alloc_pages(16)
    let gf_call_cnt    = 0
    // Set fixup globals for lambda helper
    g_gf_strtab_co = gf_strtab_co
    g_gf_strtab_tgt = gf_strtab_tgt
    g_gf_strtab_base = gf_strtab_base
    g_gf_call_co = gf_call_co
    g_gf_call_name = gf_call_name
    g_gf_call_nlen = gf_call_nlen
    // JirFunction + LowerCtx heap allocation
    g_jfn_heap = alloc_pages(16384)
    g_jfn = g_jfn_heap as &JirFunction
    g_ctx_heap = alloc_pages(100)
    g_ctx = g_ctx_heap as &LowerCtx
    // Lambda stash arrays (64 entries each)
    g_lambda_starts = alloc_pages(1) as &i64
    g_lambda_ends = alloc_pages(1) as &i64
    g_lambda_name_offs = alloc_pages(1) as &i64
    g_lambda_name_lens = alloc_pages(1) as &i64
    g_lambda_cnt = 0
    // Loop promotion candidate arrays
    g_cand_slots = alloc_pages(1) as &i64
    g_cand_load = alloc_pages(1) as &i64
    g_cand_store = alloc_pages(1) as &i64
    // Value metadata for ADD/CMP immediate + promoted register opts
    g_val_op = alloc_pages(8) as &i32
    g_val_imm = alloc_pages(16) as &i64
    g_val_load_slot = alloc_pages(16) as &i64
    g_val_promo_reg = alloc_pages(16) as &i64
    // Bootstrap: alloc_pages gives zero-initialized memory so entry 0 is already zero.
    // Just set the count and total size to skip slot 0 (dummy entry).
    g_glob_cnt      = 1
    g_glob_total_sz = 1024
    let jfn = g_jfn
    let ctx = g_ctx
    g_entry_main_idx = -1
    print("LS_INIT_OK\n")

    // Main Compilation Loop
    g_main_pos = 0
    print("Z1\n")
    if g_main_pos < g_scan_tok_cnt {
        print("Z4\n")
    }
    print("Z5\n")
    loop g_main_pos < g_scan_tok_cnt {
        let top_t = tok_type_at_raw(toks, g_main_pos)
        let top_start = tok_str_start_at(toks, g_main_pos)
        let top_len = tok_str_len_at(toks, g_main_pos)
        if top_t == TOK_CONST {
            parse_const_decl(toks)
        } else if top_t == TOK_ENUM {
            parse_enum_decl(toks, src_buf)
        } else if top_t == TOK_STRUCT or (top_len == 6 and streq(src_buf, top_start, 6, "struct") == 1) {
            parse_struct_decl(toks, g_stab_ptr, src_buf)
        } else if top_len == 6 and streq(src_buf, top_start, 6, "linear") == 1 {
            parse_struct_decl(toks, g_stab_ptr, src_buf)
        } else if top_t == TOK_FN or (top_len == 2 and streq(src_buf, top_start, 2, "fn") == 1) {
            check_unsafe_fn_prefix(toks, g_main_pos)
            let fn_tok_pos = g_main_pos
            let cur_name_off = tok_str_start_at(toks, g_main_pos + 1)
            let cur_name_len = tok_str_len_at(toks, g_main_pos + 1)
            // (debug prints removed)
            g_cur_fn_name_start = cur_name_off
            g_cur_fn_name_len = cur_name_len
            // Find function bounds
            let fn_rbrace_scan = -1
            let scan_i = fn_tok_pos
            loop scan_i < g_scan_tok_cnt {
                let st = tok_type_at_raw(toks, scan_i)
                if st == TOK_LBRACE {
                    let scan_j = scan_i
                    let depth_j = 0
                    loop scan_j < g_scan_tok_cnt {
                        let st2 = tok_type_at_raw(toks, scan_j)
                        depth_j = depth_j + (st2 == TOK_LBRACE) - (st2 == TOK_RBRACE)
                        if st2 == TOK_RBRACE and depth_j == 0 {
                            fn_rbrace_scan = scan_j
                            scan_j = g_scan_tok_cnt
                        } else {
                            scan_j = scan_j + 1
                        }
                    }
                    scan_i = g_scan_tok_cnt
                } else if st == TOK_SEMI {
                    fn_rbrace_scan = scan_i
                    scan_i = g_scan_tok_cnt
                } else {
                    scan_i = scan_i + 1
                }
            }
            if fn_rbrace_scan == -1 {
                print("fn_tok=")
                print_span(src_buf, top_start, top_len)
                print("\n")
                print("fn_end_fail=")
                print_span(src_buf, cur_name_off, cur_name_len)
                print("\n")
                report_error("could not find end of function")
            }
            g_cur_fn_end = fn_rbrace_scan
            print("COMPILE ")
            print_span(src_buf, cur_name_off, cur_name_len)
            print("\n")
            let fi = resolve_top_fn_index(src_buf, cur_name_off, cur_name_len, fn_name_off, fn_name_len)
            print("FI_OK\n")
            init_top_jfn(jfn, src_buf, src_len, g_stab_ptr)
            print("INIT_OK\n")
                // Skip 'fn name'
                g_main_pos = fn_tok_pos + 2
                expect(TOK_LPAREN)
                let more_params = 0
                if tok_type_at(toks, g_main_pos) != TOK_RPAREN { more_params = 1 }
                loop more_params == 1 {
                    let p_name_start = tok_str_start_at(toks, g_main_pos)
                    let p_name_len = tok_str_len_at(toks, g_main_pos)
                    expect(TOK_IDENT)
                    let p_stype = TYPE_I64
                    if tok_type_at(toks, g_main_pos) == TOK_COLON {
                        g_main_pos = g_main_pos + 1
                        let is_ptr = 0
                        if tok_type_at(toks, g_main_pos) == TOK_AMP {
                            is_ptr = 1
                            g_main_pos = g_main_pos + 1
                        }
                        let p_type = tok_type_at(toks, g_main_pos)
                        let p_type_start = tok_str_start_at(toks, g_main_pos)
                        let p_type_len = tok_str_len_at(toks, g_main_pos)
                        g_main_pos = g_main_pos + 1
                        if p_type == TOK_IDENT {
                            let sid = lookup_struct_name(src_buf, p_type_start, p_type_len)
                            if sid >= 0 { p_stype = sid }
                            else if is_ptr == 1 { p_stype = ptr_of(TYPE_PTR) }
                            else { p_stype = TYPE_PTR }
                        } else {
                            if is_ptr == 1 {
                                if p_type == TOK_I64 { p_stype = TYPE_PTR_I64 }
                                if p_type == TOK_I32 { p_stype = TYPE_PTR_I32 }
                                if p_type == TOK_I8  { p_stype = TYPE_PTR_I8 }
                                if p_type == TOK_F64 { p_stype = ptr_of(TYPE_F64) }
                            } else {
                                if p_type == TOK_I64 { p_stype = TYPE_I64 }
                                if p_type == TOK_I32 { p_stype = TYPE_I32 }
                                if p_type == TOK_I8  { p_stype = TYPE_I8 }
                                if p_type == TOK_F64 { p_stype = TYPE_F64 }
                            }
                        }
                    }
                        let pslot = bind_name(jfn, p_name_start, p_name_len, p_stype)
                    if jfn.param_cnt < 16 {
                        jfn.param_slots[jfn.param_cnt] = pslot
                        jfn.param_cnt = jfn.param_cnt + 1
                    }
                    let comma_tok = tok_type_at(toks, g_main_pos)
                    if comma_tok == TOK_COMMA { g_main_pos = g_main_pos + 1 }
                    else { more_params = 0 }
                }
                expect(TOK_RPAREN)

                // Parse return type and store function metadata
                let fn_ret_type = parse_skip_ret_type(toks)
                if fi >= 0 and fi < 512 {
                    store_i64_at(fn_param_cnts, fi, jfn.param_cnt)
                    store_i64_at(fn_ret_types, fi, fn_ret_type)
                }

                expect(TOK_LBRACE)

                let is_main = 0
                if cur_name_len == 4 {
                    if streq(src_buf, cur_name_off, 4, "main") == 1 { is_main = 1 }
                }

                if fi >= 0 and fi < 1024 { fn_code_off[fi] = code_len }
                if is_main == 1 { g_entry_main_idx = code_len }

                regalloc_init(ctx as &RegAlloc)
                ctx.fix_cnt = 0
                let cb = create_block_live(jfn)
                let final_bb = live_compile_block(toks, g_stab_ptr, src_buf, jfn, cb)
                defer_emit_calls(toks, g_stab_ptr, src_buf, jfn, final_bb)
                let impl_rv2 = emit_const(jfn, final_bb, TYPE_I64, 0)
                let impl_ri2 = Instr{}
                impl_ri2.op = OP_RET
                impl_ri2.operand0 = impl_rv2
                emit(jfn, final_bb, &impl_ri2)
                if cur_name_len == 15 {
                    if streq(src_buf, cur_name_off, 15, "lex_handle_bang") == 1 {
                        if jfn.block_cnt > 64 { panic("lex_handle_bang block blowup") }
                    }
                }
                if cur_name_len == 16 {
                    if streq(src_buf, cur_name_off, 16, "lex_handle_minus") == 1 {
                        if jfn.block_cnt > 512 { panic("lex_handle_minus block blowup") }
                    }
                }
                fold_constants(jfn)
                dce(jfn)
                tail_call_opt(jfn)
                peephole(jfn)
                lower_fn(jfn, ctx, code_buf, &code_len, is_main)
                // Collect fixups
                let ci = 0
                loop ci < ctx.fix_cnt {
                    let fk = ctx.fixups[ci].kind
                    if fk == 1 {
                        gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                        gf_strtab_tgt[gf_strtab_cnt]  = ctx.fixups[ci].target_bb
                        gf_strtab_base[gf_strtab_cnt] = merged_pos
                        gf_strtab_cnt = gf_strtab_cnt + 1
                    } else if fk == 3 {
                        let tbb = ctx.fixups[ci].target_bb
                        let neg_tbb = 0 - tbb
                        gf_strtab_co[gf_strtab_cnt]   = ctx.fixups[ci].code_off
                        gf_strtab_tgt[gf_strtab_cnt]  = neg_tbb - 1
                        gf_strtab_base[gf_strtab_cnt] = 0
                        gf_strtab_cnt = gf_strtab_cnt + 1
                    } else if fk == 2 {
                        gf_call_co[gf_call_cnt]   = ctx.fixups[ci].code_off
                        gf_call_name[gf_call_cnt] = ctx.fixups[ci].target_bb
                        gf_call_nlen[gf_call_cnt] = ctx.fixups[ci].str_len
                        gf_call_cnt = gf_call_cnt + 1
                    }
                    ci = ci + 1
                }

                // Merge strtab
                let si_copy = 0
                let jfn_str_len = jfn.strtab_pos
                loop si_copy < jfn_str_len {
                    poke_byte(merged_str, merged_pos, jfn.strtab[si_copy])
                    merged_pos = merged_pos + 1
                    si_copy = si_copy + 1
                }
                // GURANTEED ADVANCE
                g_main_pos = fn_rbrace_scan + 1
                // Compile stashed lambdas as top-level functions
                if g_lambda_cnt > 0 {
                    g_lam_code_len = code_len
                    g_lam_merged_pos = merged_pos
                    g_lam_strtab_cnt = gf_strtab_cnt
                    g_lam_call_cnt = gf_call_cnt
                    compile_stashed_lambdas(toks, src_buf, src_len)
                    code_len = g_lam_code_len
                    merged_pos = g_lam_merged_pos
                    gf_strtab_cnt = g_lam_strtab_cnt
                    gf_call_cnt = g_lam_call_cnt
                }
                g_unsafe_depth = 0
        } else if top_t == TOK_LET or (top_len == 3 and streq(src_buf, top_start, 3, "let") == 1) {
            skip_top_level_let(toks, g_stab_ptr, src_buf)
        } else {
            g_main_pos = g_main_pos + 1
        }
    }

    // ---- Patch Entry Point ----
    let m_off = load_i64_at(fn_code_off, 0)
    if g_entry_main_idx >= 0 { m_off = g_entry_main_idx }
    let entry_call_imm_off = 49
    let entry_call_next_off = 53
    let e_rel = m_off - entry_call_next_off
    poke_byte(code_buf, entry_call_imm_off, i32_b0(e_rel))
    poke_byte(code_buf, entry_call_imm_off + 1, i32_b1(e_rel))
    poke_byte(code_buf, entry_call_imm_off + 2, i32_b2(e_rel))
    poke_byte(code_buf, entry_call_imm_off + 3, i32_b3(e_rel))

    // ---- Global Fixups (String/Calls) ----
    let str_va = 0x400000 + 120 + code_len
    let si_f = 0
    loop si_f < gf_strtab_cnt {
        let co = gf_strtab_co[si_f]
        let stgt = gf_strtab_tgt[si_f]
        let sbase = gf_strtab_base[si_f]
        let rel_val = 0
        let stgt_pos = stgt >= 0
        if stgt_pos == 1 {
            let lit_va = str_va + sbase
            let tgt_va = lit_va + stgt
            let rip_after = 0x400000 + 120 + co + 4
            rel_val = tgt_va - rip_after
        } else {
            let neg_gf = 0 - stgt
            let gi_f = neg_gf - 1
            let data_va = str_va + merged_pos
            let goff_val = load_i64_at(g_glob_off, gi_f)
            let glob_va = data_va + goff_val
            let rip_after = 0x400000 + 120 + co + 4
            rel_val = glob_va - rip_after
        }
        poke_byte(code_buf, co,     i32_b0(rel_val))
        poke_byte(code_buf, co + 1, i32_b1(rel_val))
        poke_byte(code_buf, co + 2, i32_b2(rel_val))
        poke_byte(code_buf, co + 3, i32_b3(rel_val))
        si_f = si_f + 1
    }

    let ci_f = 0
    loop ci_f < gf_call_cnt {
        let co_f = gf_call_co[ci_f]
        let found = 0
        let call_nlen = gf_call_nlen[ci_f]
        let call_name = gf_call_name[ci_f]
        let ti_f = 0
        loop ti_f < g_top_fn_cnt {
            let fn_nl = load_i64_at(fn_name_len, ti_f)
            let len_eq = fn_nl == call_nlen
            if len_eq == 1 {
                let fn_no = load_i64_at(fn_name_off, ti_f)
                let sm = str_match(src_buf, call_name, fn_no, call_nlen)
                if sm == 1 {
                    let fn_co = load_i64_at(fn_code_off, ti_f)
                    let r_val = fn_co - (co_f + 4)
                    poke_byte(code_buf, co_f,     i32_b0(r_val))
                    poke_byte(code_buf, co_f + 1, i32_b1(r_val))
                    poke_byte(code_buf, co_f + 2, i32_b2(r_val))
                    poke_byte(code_buf, co_f + 3, i32_b3(r_val))
                    found = 1
                    ti_f = g_top_fn_cnt
                }
            }
            ti_f = ti_f + 1
        }
        if found == 0 {
            eprint("error: undefined function: ")
            eprint_src_range(src_buf, call_name, call_nlen)
            eprint("\n")
            syscall(60, 1, 0, 0)
        }
        ci_f = ci_f + 1
    }
    let out_fd = syscall(2, g_out_path_ptr, 577, 493)
    if out_fd < 0 { panic("open output failed") }
    g_emit_glob_buf = glob_buf
    g_emit_glob_len = g_glob_total_sz
    if g_glob_total_sz > 0 { fill_bytes(glob_buf, g_glob_total_sz, 0) }

    write_elf(out_fd, code_buf, code_len, merged_str, merged_pos)
    syscall(3, out_fd, 0, 0)

    // chmod +x the output
    syscall(90, g_out_path_ptr, 493, 0)

    syscall(60, 0, 0, 0)
}
