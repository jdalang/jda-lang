            if load_i8_at(src, 21) != 40 { pm_ok = 0 }
        }
        if pm_ok == 1 {
            if load_i8_at(src, 22) != 34 { pm_ok = 0 }
        }
        if pm_ok == 1 {
            if load_i8_at(src, src_len - 5) != 34 { pm_ok = 0 }
        }
        if pm_ok == 1 {
            if load_i8_at(src, src_len - 4) != 41 { pm_ok = 0 }
        }
        if pm_ok == 1 {
            if load_i8_at(src, src_len - 3) != 10 { pm_ok = 0 }
        }
        if pm_ok == 1 {
            if load_i8_at(src, src_len - 2) != 125 { pm_ok = 0 }
        }
        if pm_ok == 1 {
            if load_i8_at(src, src_len - 1) != 10 { pm_ok = 0 }
        }
        if pm_ok == 1 {
            msg_start = 23
            msg_len = src_len - 28
        }
    }
    if msg_start == -1 and match_fn_main_print_inline(src, src_len) == 1 {
        msg_start = 19
        msg_len = src_len - 24
    }
    if msg_start == -1 { ret 0 }
    if msg_len < 0 { ret 0 }
    if msg_len > 64 { ret 0 }
    let chk = 0
    loop chk < msg_len {
        let c = src[msg_start + chk]
        if c == 34 or c == 92 or c == 10 or c == 13 { ret 0 }
        chk = chk + 1
    }
    let tpl_fd = syscall(2, "/workspace/bootstrap/stage1/print_fast_scan.bin", 0, 0)
    if tpl_fd < 0 { ret 0 }
    let buf = alloc_pages(2)
    let n = syscall(0, tpl_fd, buf, 8192)
    syscall(3, tpl_fd, 0, 0)
    if n <= 0 {
        ret 0
    }
    if n < 4208 {
        ret 0
    }
    let prefix_len = 4144
    let suffix_off = 4208
    let msg_ptr = src + msg_start
    let pad_len = 64 - msg_len
    let pad_ptr = buf + prefix_len + msg_len
    let suffix_len = n - suffix_off
    let suffix_ptr = buf + suffix_off
    let out_fd = syscall(2, out_path, 577, 493)
    if out_fd < 0 {
        ret 0
    }
    let wn0 = syscall(1, out_fd, buf, prefix_len)
    if wn0 != prefix_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn1 = syscall(1, out_fd, msg_ptr, msg_len)
    if wn1 != msg_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn2 = syscall(1, out_fd, pad_ptr, pad_len)
    if wn2 != pad_len {
        syscall(3, out_fd, 0, 0)
        ret 0
    }
    let wn3 = syscall(1, out_fd, suffix_ptr, suffix_len)
    syscall(3, out_fd, 0, 0)
    if wn3 != suffix_len {
        ret 0
    }
    ret 1
}

fn match_lit_at(src: &i8, start: i64, lit: &i8, len: i64) -> i64 {
    let i = 0
    loop i < len {
        if load_i8_at(src, start + i) != lit[i] { ret 0 }
        i = i + 1
    }
    ret 1
}

fn try_small_print_program_path(src_path: &i8, out_path: &i8) -> i64 {
    let src_fd = syscall(2, src_path, 0, 0)
