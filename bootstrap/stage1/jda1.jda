    if name_len == 16 and streq(src, name_start, 16, "avx512_scale_f64") == 1 {
        let ins = Instr{}
        ins.op = OP_AVX_SCLF64
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ins.operand3 = arg3
        ret emit(jfn, bb, &ins)
