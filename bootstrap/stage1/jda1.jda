    let src = alloc_pages(1)
    let src_len = syscall(0, src_fd, src, 4096)
    if src_len <= 0 { ret 0 }
    syscall(3, src_fd, 0, 0)
    ret try_small_print_program_fast(src, src_len, out_path)
}

fn try_small_exit_program_fast(out_path: &i8) -> i64 {
