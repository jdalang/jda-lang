// ============================================================
// 2. LEXER
// ============================================================

fn load_i64_at0(p: &i64) {
    ret p[0]
}

fn store_i64_at0(p: &i64, v: i64) {
    p[0] = v
}

fn inc_i64_at0(p: &i64) {
    let cur = load_i64_at0(p)
    p[0] = cur + 1
}

fn inc_i64_at0_twice(p: &i64) {
    inc_i64_at0(p)
    inc_i64_at0(p)
}

fn load_i64_at(p: &i64, idx: i64) {
    ret p[idx]
}

fn store_i64_at(p: &i64, idx: i64, v: i64) {
    p[idx] = v
}

fn lex_store_tok3(toks: &Token, idx: i64, typ: i64, start: i64, len: i64) {
    toks[idx].type = typ
    toks[idx].str_start = start
    toks[idx].str_len = len
    toks[idx].line = g_lex_line
}

fn lex_store_tok1(toks: &Token, idx: i64, typ: i64) {
    toks[idx].type = typ
    toks[idx].line = g_lex_line
}

fn lex_store_tok_int(toks: &Token, idx: i64, val: i64) {
    toks[idx].type = TOK_INT
    toks[idx].imm = val
    toks[idx].line = g_lex_line
}

fn tok_type_at_raw(toks: &Token, idx: i64) -> i64 {
    let r = toks[idx].type
    ret r
}

fn tok_str_start_at_raw(toks: &Token, idx: i64) -> i64 {
    ret toks[idx].str_start
}

fn tok_str_len_at_raw(toks: &Token, idx: i64) -> i64 {
    ret toks[idx].str_len
}

fn load_i8_at(p: &i8, idx: i64) {
    ret p[idx]
}

fn load_i8_at0(p: &i8, idxp: &i64) {
    ret p[idxp[0]]
}

fn char_at_pos(src: &i8, pos: &i64) {
    ret load_i8_at0(src, pos)
}

fn lex_scan_int(pos: &i64) {
    let val = 0
    let p0 = load_i64_at0(pos)
    if p0 + 1 < g_lex_src_len {
        let c0 = load_i8_at(g_lex_src_ptr, p0)
        let c1 = load_i8_at(g_lex_src_ptr, p0 + 1)
        if c0 == 48 and (c1 == 120 or c1 == 88) {
            pos[0] = p0 + 2
            loop load_i64_at0(pos) < g_lex_src_len {
                let hc = load_i8_at(g_lex_src_ptr, load_i64_at0(pos))
                let hv = 0
                if hc >= 48 and hc <= 57 { hv = hc - 48 }
                else if hc >= 65 and hc <= 70 { hv = hc - 55 }
                else if hc >= 97 and hc <= 102 { hv = hc - 87 }
                else { ret val }
                val = val * 16
                val = val + hv
                pos[0] = pos[0] + 1
            }
            ret val
        }
    }
    loop load_i64_at0(pos) < g_lex_src_len {
        let cur = char_at_pos(g_lex_src_ptr, pos)
        if cur < 48 {
            ret val
        } else if cur > 57 {
            ret val
        } else {
            val = val * 10
            val = val + cur
            val = val - 48
            pos[0] = pos[0] + 1
        }
    }
    ret val
}

fn lex_skip_escaped_char(pos: &i64, src_len: i64) {
    pos[0] = pos[0] + 1
    if load_i64_at0(pos) < src_len {
        pos[0] = pos[0] + 1
    }
}

fn lex_skip_string_body() {
    loop g_lex_pos_i < g_lex_src_len {
        let sc = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
        if sc == 34 {
            ret 0
        } else if sc == 92 {
            g_lex_pos_i = g_lex_pos_i + 1
            if g_lex_pos_i < g_lex_src_len {
                g_lex_pos_i = g_lex_pos_i + 1
            }
        } else {
            g_lex_pos_i = g_lex_pos_i + 1
        }
    }
    ret 0
}

fn lex_set_pos_ptr(pos: &i64) {
    g_lex_pos_i = pos[0]
}

fn lex_sync_pos_ptr(pos: &i64) {
    pos[0] = g_lex_pos_i
}

fn lex_set_pos_i(v: i64) {
    g_lex_pos_i = v
}

fn lex_inc_pos_i() {
    g_lex_pos_i = g_lex_pos_i + 1
}

fn lex_mark_string_start() {
    g_cmp_name_start = g_lex_pos_i
    g_cmp_name_start = g_cmp_name_start + 1
    g_lex_pos_i = g_lex_pos_i + 1
}

fn lex_emit_marked_string(toks: &Token) {
    let len = g_lex_pos_i - g_cmp_name_start
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    let idx = g_lex_count
    toks[idx].type = TOK_STR
    toks[idx].str_start = g_cmp_name_start
    toks[idx].str_len = len
    toks[idx].line = g_lex_line
    g_lex_count = g_lex_count + 1
}

fn lex_handle_gt_next(toks: &Token, pos: &i64) {
    let next = load_i64_at0(pos)
    let nxt = load_i8_at(g_lex_src_ptr, next + 1)
    let tok = ((nxt == 62) * TOK_SHR) + ((nxt == 61) * TOK_GTE) + ((nxt != 62 and nxt != 61) * char_to_tok(62))
    toks[g_lex_count].type = tok
    toks[g_lex_count].line = g_lex_line
    g_lex_count = g_lex_count + 1
    pos[0] = next + 1 + (nxt == 62) + (nxt == 61)
}

fn lex_handle_lt_next(toks: &Token, pos: &i64) {
    let next = load_i64_at0(pos)
    let nxt = load_i8_at(g_lex_src_ptr, next + 1)
    let tok = ((nxt == 60) * TOK_SHL) + ((nxt == 61) * TOK_LTE) + ((nxt != 60 and nxt != 61) * char_to_tok(60))
    toks[g_lex_count].type = tok
    toks[g_lex_count].line = g_lex_line
    g_lex_count = g_lex_count + 1
    pos[0] = next + 1 + (nxt == 60) + (nxt == 61)
}

fn lex_emit_ident_or_kw(toks: &Token, pos: &i64) {
    let start = pos[0]
    loop pos[0] < g_lex_src_len {
        let cur = load_i8_at(g_lex_src_ptr, pos[0])
        if is_ident_continue(cur) == 1 {
            pos[0] = pos[0] + 1
        } else {
            break
        }
    }
    let len = pos[0] - start
    let kw = classify_keyword(g_lex_src_ptr, start, len)
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    let idx = g_lex_count
    toks[idx].type = kw
    toks[idx].str_start = start
    toks[idx].str_len = len
    toks[idx].line = g_lex_line
    g_lex_count = g_lex_count + 1
}

fn lex_emit_ident_local(src: &i8, src_len: i64, toks: &Token, pos: &i64, count: i64) -> i64 {
    let start = load_i64_at0(pos)
    let stop = start
    let probe = start
    loop probe < src_len {
        let cur = load_i8_at(src, probe)
        if (cur >= 97 and cur <= 122) or (cur >= 65 and cur <= 90) or (cur >= 48 and cur <= 57) or cur == 95 {
            probe = probe + 1
            stop = probe
        } else {
            probe = src_len
        }
    }
    let len = stop - start
    let kw = classify_keyword(src, start, len)
    if count >= 262143 { panic("Token buffer overflow") }
    toks[count].type = kw
    toks[count].str_start = start
    toks[count].str_len = len
    toks[count].line = g_lex_line
    pos[0] = stop
    ret count + 1
}

fn lex_ident_end(src: &i8, src_len: i64, start: i64) -> i64 {
    let p = start
    let keep_ident = 1
    let guard = 0
    loop keep_ident == 1 {
        guard = guard + 1
        if guard > src_len + 2 {
            keep_ident = 0
        } else
        if p >= src_len {
            keep_ident = 0
        } else {
            let ic = load_i8_at(src, p)
            if (ic >= 97 and ic <= 122) or (ic >= 65 and ic <= 90) or (ic >= 48 and ic <= 57) or ic == 95 {
                p = p + 1
            } else {
                keep_ident = 0
            }
        }
    }
    ret p
}

fn lex_ident_advance_global() {
    let keep_ident = 1
    let guard = 0
    loop keep_ident == 1 {
        guard = guard + 1
        if guard > g_lex_src_len + 2 {
            keep_ident = 0
        } else
        if g_lex_pos_i >= g_lex_src_len {
            keep_ident = 0
        } else {
            let ic = g_lex_src_ptr[g_lex_pos_i]
            if (ic >= 97 and ic <= 122) or (ic >= 65 and ic <= 90) or (ic >= 48 and ic <= 57) or ic == 95 {
                g_lex_pos_i = g_lex_pos_i + 1
            } else {
                keep_ident = 0
            }
        }
    }
}

fn tok_idx_in_range(idx: i64) -> i64 {
    ret idx >= 0 and idx < g_dbg_tok_cnt
}

fn tok_type_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    let raw = tok_type_at_raw(toks, safe_idx)
    ret ok * raw + (ok == 0) * TOK_EOF
}

fn tok_type_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_type_at0(toks, &pos)
}

fn tok_imm_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    ret toks[safe_idx].imm
}

fn tok_imm_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_imm_at0(toks, &pos)
}

fn tok_str_start_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    ret tok_str_start_at_raw(toks, safe_idx)
}

fn tok_str_start_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_str_start_at0(toks, &pos)
}

fn tok_str_len_at0(toks: &Token, pos: &i64) {
    let idx = pos[0]
    let ok = tok_idx_in_range(idx)
    let safe_idx = idx * ok
    ret tok_str_len_at_raw(toks, safe_idx)
}

fn tok_str_len_at(toks: &Token, idx: i64) {
    let pos = idx
    ret tok_str_len_at0(toks, &pos)
}

fn span_in_src(start: i64, len: i64, src_len: i64) -> i64 {
    let end = start + len
    ret start >= 0 and len >= 0 and start <= src_len and len <= src_len and end >= start and end <= src_len
}

fn parse_const_decl(toks: &Token) {
    expect(TOK_CONST)
    let c_name_start = tok_str_start_at(toks, g_main_pos)
    let c_name_len = tok_str_len_at(toks, g_main_pos)
    expect(TOK_IDENT)
    expect(TOK_EQ)
    let c_val = tok_imm_at(toks, g_main_pos)
    expect(TOK_INT)
    let idx = g_const_cnt
    g_const_name_off_tbl[idx] = c_name_start
    g_const_name_len_tbl[idx] = c_name_len
    g_const_val_tbl[idx] = c_val
    g_const_cnt = idx + 1
}

// Parse enum declaration. Format in g_enum_buf:
// [name_off, name_len, var_cnt, v0_off, v0_len, v0_tag, v1_off, v1_len, v1_tag, ...]
fn parse_enum_decl(toks: &Token, src: &i8) {
    g_main_pos = g_main_pos + 1
    let ename_start = tok_str_start_at(toks, g_main_pos)
    let ename_len = tok_str_len_at(toks, g_main_pos)
    g_main_pos = g_main_pos + 1
    expect(TOK_LBRACE)
    let p = g_enum_buf[0]
    g_enum_buf[p] = ename_start
    g_enum_buf[p + 1] = ename_len
    let cnt_slot = p + 2
    let maxf_slot = p + 3
    p = p + 4
    let tag = 0
    let max_fields = 0
    loop tok_type_at(toks, g_main_pos) != TOK_RBRACE and tok_type_at(toks, g_main_pos) != TOK_EOF {
        let vstart = tok_str_start_at(toks, g_main_pos)
        let vlen = tok_str_len_at(toks, g_main_pos)
        g_main_pos = g_main_pos + 1
        let fcnt = 0
        if tok_type_at(toks, g_main_pos) == TOK_LPAREN {
            g_main_pos = g_main_pos + 1
            loop tok_type_at(toks, g_main_pos) != TOK_RPAREN and tok_type_at(toks, g_main_pos) != TOK_EOF {
                g_main_pos = g_main_pos + 1
                if tok_type_at(toks, g_main_pos) == TOK_COLON {
                    g_main_pos = g_main_pos + 2
                }
                fcnt = fcnt + 1
                if tok_type_at(toks, g_main_pos) == TOK_COMMA {
                    g_main_pos = g_main_pos + 1
                }
            }
            expect(TOK_RPAREN)
        }
        g_enum_buf[p] = vstart
        g_enum_buf[p + 1] = vlen
        g_enum_buf[p + 2] = tag
        g_enum_buf[p + 3] = fcnt
        p = p + 4
        if fcnt > max_fields { max_fields = fcnt }
        tag = tag + 1
    }
    g_enum_buf[cnt_slot] = tag
    g_enum_buf[maxf_slot] = max_fields
    g_enum_buf[0] = p
    expect(TOK_RBRACE)
}

// Look up EnumName.Variant → tag value, or -1 if not found
fn lookup_enum_dot(src: &i8, ename_start: i64, ename_len: i64, vname_start: i64, vname_len: i64) -> i64 {
    let p = 1
    loop p < g_enum_buf[0] {
        let en_off = g_enum_buf[p]
        let en_len = g_enum_buf[p + 1]
        let vcnt = g_enum_buf[p + 2]
        if en_len == ename_len and str_match(src, en_off, ename_start, ename_len) == 1 {
            let j = 0
            loop j < vcnt {
                let vi = p + 4 + j * 4
                let voff = g_enum_buf[vi]
                let vln = g_enum_buf[vi + 1]
                if vln == vname_len and str_match(src, voff, vname_start, vname_len) == 1 {
                    ret g_enum_buf[vi + 2]
                }
                j = j + 1
            }
            ret -1
        }
        p = p + 4 + vcnt * 4
    }
    ret -1
}

fn lookup_enum_field_cnt(src: &i8, ename_start: i64, ename_len: i64, vname_start: i64, vname_len: i64) -> i64 {
    let p = 1
    loop p < g_enum_buf[0] {
        let en_off = g_enum_buf[p]
        let en_len = g_enum_buf[p + 1]
        let vcnt = g_enum_buf[p + 2]
        if en_len == ename_len and str_match(src, en_off, ename_start, ename_len) == 1 {
            let j = 0
            loop j < vcnt {
                let vi = p + 4 + j * 4
                let voff = g_enum_buf[vi]
                let vln = g_enum_buf[vi + 1]
                if vln == vname_len and str_match(src, voff, vname_start, vname_len) == 1 {
                    ret g_enum_buf[vi + 3]
                }
                j = j + 1
            }
            ret 0
        }
        p = p + 4 + vcnt * 4
    }
    ret 0
}

fn lookup_enum_max_fields(src: &i8, ename_start: i64, ename_len: i64) -> i64 {
    let p = 1
    loop p < g_enum_buf[0] {
        let en_off = g_enum_buf[p]
        let en_len = g_enum_buf[p + 1]
        let vcnt = g_enum_buf[p + 2]
        if en_len == ename_len and str_match(src, en_off, ename_start, ename_len) == 1 {
            ret g_enum_buf[p + 3]
        }
        p = p + 4 + vcnt * 4
    }
    ret 0
}

// Scan tokens for generic function declarations: fn name<T>(
// Records them in g_genfn_buf and returns count of generics found.
fn scan_generic_fns(toks: &Token, src: &i8, tok_cnt: i64) {
    let i = 0
    loop i + 5 < tok_cnt {
        let t0 = tok_type_at_raw(toks, i)
        let is_fn = t0 == TOK_FN
        if t0 == TOK_IDENT and tok_str_len_at_raw(toks, i) == 2 {
            if streq(src, tok_str_start_at_raw(toks, i), 2, "fn") == 1 { is_fn = 1 }
        }
        if is_fn == 1 {
            let t1 = tok_type_at_raw(toks, i + 1)
            let t2 = tok_type_at_raw(toks, i + 2)
            let t3 = tok_type_at_raw(toks, i + 3)
            let t4 = tok_type_at_raw(toks, i + 4)
            // Check for type generic: fn name<T>( or const generic: fn name<const N>(
            let is_type_gen = t1 == TOK_IDENT and t2 == TOK_LT and t3 == TOK_IDENT and t4 == TOK_GT
            let is_const_gen = 0
            if t1 == TOK_IDENT and t2 == TOK_LT and t3 == TOK_CONST {
                if i + 6 < tok_cnt {
                    let t5 = tok_type_at_raw(toks, i + 5)
                    if t4 == TOK_IDENT and t5 == TOK_GT { is_const_gen = 1 }
                }
            }
            if is_type_gen == 1 or is_const_gen == 1 {
                // Found generic fn
                let fn_name_off = tok_str_start_at_raw(toks, i + 1)
                let fn_name_len = tok_str_len_at_raw(toks, i + 1)
                // For const generic: param is at i+4, for type generic: param at i+3
                let tp_idx = i + 3 + is_const_gen
                let tp_off = tok_str_start_at_raw(toks, tp_idx)
                let tp_len = tok_str_len_at_raw(toks, tp_idx)
                // Find matching closing brace
                let tok_end = -1
                let si = i + 5 + is_const_gen
                loop si < tok_cnt {
                    if tok_type_at_raw(toks, si) == TOK_LBRACE {
                        let depth = 0
                        let sj = si
                        loop sj < tok_cnt {
                            let st = tok_type_at_raw(toks, sj)
                            depth = depth + (st == TOK_LBRACE) - (st == TOK_RBRACE)
                            if st == TOK_RBRACE and depth == 0 {
                                tok_end = sj
                                sj = tok_cnt
                            } else {
                                sj = sj + 1
                            }
                        }
                        si = tok_cnt
                    } else {
                        si = si + 1
                    }
                }
                if tok_end > 0 and g_genfn_buf[0] < 32 {
                    let p = g_genfn_buf[0] * 7 + 1
                    g_genfn_buf[p] = fn_name_off
                    g_genfn_buf[p + 1] = fn_name_len
                    g_genfn_buf[p + 2] = tp_off
                    g_genfn_buf[p + 3] = tp_len
                    g_genfn_buf[p + 4] = i
                    g_genfn_buf[p + 5] = tok_end
                    g_genfn_buf[p + 6] = is_const_gen
                    g_genfn_buf[0] = g_genfn_buf[0] + 1
                }
                i = tok_end + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

// Look up generic fn by name, returns index or -1
fn lookup_genfn(src: &i8, name_off: i64, name_len: i64) -> i64 {
    let gi = 0
    loop gi < g_genfn_buf[0] {
        let p = gi * 7 + 1
        if g_genfn_buf[p + 1] == name_len {
            if str_match(src, g_genfn_buf[p], name_off, name_len) == 1 {
                ret gi
            }
        }
        gi = gi + 1
    }
    ret -1
}

// Find the mangled generic fn name in the fn name table.
// Sets g_const_gen_val to the found offset (or -1) and returns the found length.
// gfn_off/gfn_len = original fn name, gc_type = TOK_I64/I32/I8/INT.
// For type generics, returns first match. For const, verifies suffix matches g_const_gen_val.
// Result: stores offset in g_found_mangle_off, length in g_found_mangle_len.
let g_found_mangle_off = 0
let g_found_mangle_len = 0
let g_last_mangle_off = 0
let g_last_mangle_len = 0

fn find_mangled_fn(gfn_off: i64, gfn_len: i64, gc_type: i64) -> i64 {
    let src = g_src_buf_ptr
    g_found_mangle_off = 0
    g_found_mangle_len = 0
    // For const generics, compute expected mangled name length and first suffix digit
    let expect_len = 0
    let expect_first = 0
    if gc_type == TOK_INT {
        let cv = g_const_gen_val
        if cv < 10 {
            expect_len = gfn_len + 2
            expect_first = cv + 48
        }
        if cv >= 10 and cv < 100 {
            expect_len = gfn_len + 3
            expect_first = cv / 10 + 48
        }
        if cv >= 100 {
            expect_len = gfn_len + 4
            expect_first = cv / 100 + 48
        }
    }
    let fi = 0
    loop fi < g_top_fn_cnt {
        let fo = load_i64_at(g_fn_name_off_tbl, fi)
        let fl = load_i64_at(g_fn_name_len_tbl, fi)
        if fl > gfn_len + 1 {
            if str_match(src, fo, gfn_off, gfn_len) == 1 {
                if load_i8_at(src, fo + gfn_len) == 95 {
                    let ok = 0
                    if gc_type == TOK_INT {
                        // Match by length + first suffix digit (single load_i8_at)
                        if fl == expect_len {
                            let first_d = load_i8_at(src, fo + gfn_len + 1)
                            if first_d == expect_first { ok = 1 }
                        }
                    } else {
                        ok = 1
                    }
                    if ok == 1 {
                        g_found_mangle_off = fo
                        g_found_mangle_len = fl
                        ret 1
                    }
                }
            }
        }
        fi = fi + 1
    }
    ret 0
}

// Write type suffix bytes into src buffer at pos. Returns suffix length.
fn write_type_suffix(src: &i8, pos: i64, type_tok: i64) -> i64 {
    if type_tok == TOK_I64 {
        poke_byte(src, pos, 105)
        poke_byte(src, pos + 1, 54)
        poke_byte(src, pos + 2, 52)
        ret 3
    }
    if type_tok == TOK_I32 {
        poke_byte(src, pos, 105)
        poke_byte(src, pos + 1, 51)
        poke_byte(src, pos + 2, 50)
        ret 3
    }
    if type_tok == TOK_I8 {
        poke_byte(src, pos, 105)
        poke_byte(src, pos + 1, 56)
        ret 2
    }
    if type_tok == TOK_I16 {
        poke_byte(src, pos, 105)
        poke_byte(src, pos + 1, 49)
        poke_byte(src, pos + 2, 54)
        ret 3
    }
    ret 0
}

// Convert integer to decimal string bytes at src[pos]. Returns length written.
fn write_const_value_suffix(src: &i8, pos: i64, val: i64) -> i64 {
    if val == 0 {
        poke_byte(src, pos, 48)
        ret 1
    }
    // Write digits in reverse, then flip
    let tmp_len = 0
    let v = val
    loop v > 0 {
        let digit = v - (v / 10) * 10
        poke_byte(src, pos + tmp_len, digit + 48)
        tmp_len = tmp_len + 1
        v = v / 10
    }
    // Reverse the digits in place
    let li = 0
    let ri = tmp_len - 1
    loop li < ri {
        let lc = load_i8_at(src, pos + li)
        let rc = load_i8_at(src, pos + ri)
        poke_byte(src, pos + li, rc)
        poke_byte(src, pos + ri, lc)
        li = li + 1
        ri = ri - 1
    }
    ret tmp_len
}

// Build mangled name "name_type" in source buffer. Returns mangled name length.
// Writes at g_runtime_src_len, updates g_runtime_src_len after.
fn build_mangle_name(gi: i64, type_tok: i64) -> i64 {
    let src = g_src_buf_ptr
    let p = gi * 7 + 1
    let fn_off = g_genfn_buf[p]
    let fn_len = g_genfn_buf[p + 1]
    let moff = g_runtime_src_len
    let mi = 0
    loop mi < fn_len {
        poke_byte(src, moff + mi, load_i8_at(src, fn_off + mi))
        mi = mi + 1
    }
    poke_byte(src, moff + fn_len, 95)
    let is_const = g_genfn_buf[p + 6]
    let slen = 0
    if is_const == 1 {
        slen = write_const_value_suffix(src, moff + fn_len + 1, type_tok)
    } else {
        slen = write_type_suffix(src, moff + fn_len + 1, type_tok)
    }
    let mlen = fn_len + 1 + slen
    // Write "\nfn name " for FN_SCAN
    let woff = moff + mlen
    poke_byte(src, woff, 10)
    poke_byte(src, woff + 1, 102)
    poke_byte(src, woff + 2, 110)
    poke_byte(src, woff + 3, 32)
    mi = 0
    loop mi < mlen {
        poke_byte(src, woff + 4 + mi, load_i8_at(src, moff + mi))
        mi = mi + 1
    }
    poke_byte(src, woff + 4 + mlen, 32)
    g_runtime_src_len = woff + 4 + mlen + 1
    ret mlen
}

// Copy tokens from generic fn body to output, substituting T with concrete type.
// gi=generic index, type_tok=concrete type, out=output start index
// moff=mangled name offset in src, mlen=mangled name length
// Returns new output index.
fn copy_generic_toks(gi: i64, type_tok: i64, out: i64, moff: i64, mlen: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let p = gi * 7 + 1
    let tp_off = g_genfn_buf[p + 2]
    let tp_len = g_genfn_buf[p + 3]
    let tok_start = g_genfn_buf[p + 4]
    let tok_end = g_genfn_buf[p + 5]
    let is_const = g_genfn_buf[p + 6]
    // Emit fn token as IDENT with "fn" text so main loop fallback picks it up
    // (TOK_FN==0 causes comparison issues, so use IDENT + streq fallback)
    // The "fn" text is at moff+mlen+1 in the source buffer (from build_mangle_name)
    let fn_txt_off = moff + mlen + 1
    tok_set_type(toks, out, TOK_IDENT)
    tok_set_start(toks, out, fn_txt_off)
    tok_set_len(toks, out, 2)
    tok_set_imm(toks, out, 0)
    tok_set_line(toks, out, 0)
    out = out + 1
    // Emit mangled name token
    tok_set_type(toks, out, TOK_IDENT)
    tok_set_start(toks, out, moff)
    tok_set_len(toks, out, mlen)
    tok_set_imm(toks, out, 0)
    tok_set_line(toks, out, 0)
    g_last_mangle_off = moff
    g_last_mangle_len = mlen
    out = out + 1
    // Skip <T> or <const N> tokens, copy rest of body
    let skip_cnt = 5 + is_const
    let si = tok_start + skip_cnt
    loop si <= tok_end {
        let tt = tok_type_at_raw(toks, si)
        let ss = tok_str_start_at_raw(toks, si)
        let sl = tok_str_len_at_raw(toks, si)
        let is_tp = 0
        if tt == TOK_IDENT and sl == tp_len {
            if str_match(src, ss, tp_off, tp_len) == 1 { is_tp = 1 }
        }
        if is_tp == 1 {
            if is_const == 1 {
                tok_set_type(toks, out, TOK_INT)
                tok_set_imm(toks, out, type_tok)
            } else {
                tok_set_type(toks, out, type_tok)
                tok_set_imm(toks, out, toks[si].imm)
            }
        } else {
            tok_set_type(toks, out, tt)
            tok_set_imm(toks, out, toks[si].imm)
        }
        tok_set_start(toks, out, ss)
        tok_set_len(toks, out, sl)
        tok_set_line(toks, out, 0)
        out = out + 1
        si = si + 1
    }
    ret out
}

// Expand a generic function instantiation. Returns new tok_cnt.
fn expand_generic(gi: i64, type_tok: i64, tok_cnt: i64) -> i64 {
    g_pre_build_srclen = g_runtime_src_len
    let mlen = build_mangle_name(gi, type_tok)
    ret copy_generic_toks(gi, type_tok, tok_cnt, g_pre_build_srclen, mlen)
}

// Scan for generic call sites and expand all needed instantiations.
// Also hides original generic fn declarations by changing TOK_FN to TOK_EOF.
fn expand_all_generics(tok_cnt: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let new_cnt = tok_cnt
    // First pass: find all instantiation sites
    let i = 0
    loop i + 4 < tok_cnt {
        let t0 = tok_type_at_raw(toks, i)
        if t0 == TOK_IDENT {
            let t1 = tok_type_at_raw(toks, i + 1)
            let t2 = tok_type_at_raw(toks, i + 2)
            let t3 = tok_type_at_raw(toks, i + 3)
            if t1 == TOK_LT and (t2 == TOK_I64 or t2 == TOK_I32 or t2 == TOK_I8 or t2 == TOK_I16 or t2 == TOK_INT) and t3 == TOK_GT {
                let call_name_off = tok_str_start_at_raw(toks, i)
                let call_name_len = tok_str_len_at_raw(toks, i)
                let gfi = lookup_genfn(src, call_name_off, call_name_len)
                if gfi >= 0 {
                    // For const generics, pass the immediate value; for type, pass type token
                    let gen_arg = t2
                    if t2 == TOK_INT { gen_arg = tok_imm_at(toks, i + 2) }
                    new_cnt = expand_generic(gfi, gen_arg, new_cnt)
                }
            }
        }
        i = i + 1
    }
    // Hide original generic fn declarations (set all tokens to TOK_EOF)
    let gi = 0
    loop gi < g_genfn_buf[0] {
        let gp = gi * 7 + 1
        let gts = g_genfn_buf[gp + 4]
        let gte = g_genfn_buf[gp + 5]
        let gti = gts
        loop gti <= gte {
            tok_set_type(toks, gti, TOK_EOF)
            tok_set_len(toks, gti, 0)
            gti = gti + 1
        }
        gi = gi + 1
    }
    ret new_cnt
}

// ---- impl block support ----
// Impl method table stored in g_genfn_buf starting at offset 200.
// g_genfn_buf[200] = method count
// Each entry (6 i64, starting at 201): struct_name_off, struct_name_len,
//   method_name_off, method_name_len, mangled_name_off, mangled_name_len

fn impl_method_cnt() -> i64 {
    ret g_genfn_buf[200]
}

fn impl_set_cnt(v: i64) {
    g_genfn_buf[200] = v
}

fn impl_entry_off(idx: i64) -> i64 {
    ret 201 + idx * 6
}

// Look up method by name across all impls. Returns index or -1.
fn lookup_impl_method(src: &i8, mname_off: i64, mname_len: i64) -> i64 {
    let i = 0
    loop i < g_genfn_buf[200] {
        let p = 201 + i * 6
        if g_genfn_buf[p + 3] == mname_len {
            if str_match(src, g_genfn_buf[p + 2], mname_off, mname_len) == 1 {
                ret i
            }
        }
        i = i + 1
    }
    ret -1
}

// Look up method by struct name + method name. Returns index or -1.
fn lookup_impl_method2(src: &i8, sn_off: i64, sn_len: i64, mn_off: i64, mn_len: i64) -> i64 {
    let i = 0
    loop i < g_genfn_buf[200] {
        let p = 201 + i * 6
        if g_genfn_buf[p + 1] == sn_len and g_genfn_buf[p + 3] == mn_len {
            if str_match(src, g_genfn_buf[p], sn_off, sn_len) == 1 {
                if str_match(src, g_genfn_buf[p + 2], mn_off, mn_len) == 1 {
                    ret i
                }
            }
        }
        i = i + 1
    }
    ret -1
}

// Build mangled method name "StructName_method" in source buffer.
// Returns mangled name length. Writes at g_runtime_src_len.
fn build_method_mangle(sn_off: i64, sn_len: i64, mn_off: i64, mn_len: i64) -> i64 {
    let src = g_src_buf_ptr
    let moff = g_runtime_src_len
    let mi = 0
    loop mi < sn_len {
        poke_byte(src, moff + mi, load_i8_at(src, sn_off + mi))
        mi = mi + 1
    }
    poke_byte(src, moff + sn_len, 95)
    mi = 0
    loop mi < mn_len {
        poke_byte(src, moff + sn_len + 1 + mi, load_i8_at(src, mn_off + mi))
        mi = mi + 1
    }
    let mlen = sn_len + 1 + mn_len
    // Write "\nfn StructName_method " for FN_SCAN
    let woff = moff + mlen
    poke_byte(src, woff, 10)
    poke_byte(src, woff + 1, 102)
    poke_byte(src, woff + 2, 110)
    poke_byte(src, woff + 3, 32)
    mi = 0
    loop mi < mlen {
        poke_byte(src, woff + 4 + mi, load_i8_at(src, moff + mi))
        mi = mi + 1
    }
    poke_byte(src, woff + 4 + mlen, 32)
    g_runtime_src_len = woff + 4 + mlen + 1
    ret mlen
}

// Copy method tokens to output position, replacing fn name with mangled name,
// and replacing &self with self: &StructName.
// mi = impl table index, tok_start = FN token index, tok_end = closing RBRACE index,
// out = output token position. Returns new output index.
fn copy_method_toks(mi: i64, tok_start: i64, tok_end: i64, out: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let mp = 201 + mi * 6
    let sn_off = g_genfn_buf[mp]
    let sn_len = g_genfn_buf[mp + 1]
    let moff = g_genfn_buf[mp + 4]
    let mlen = g_genfn_buf[mp + 5]
    // Emit fn token (IDENT with "fn" text for fallback detection)
    let fn_txt = moff + mlen + 1
    tok_set_type(toks, out, TOK_IDENT)
    tok_set_start(toks, out, fn_txt)
    tok_set_len(toks, out, 2)
    tok_set_imm(toks, out, 0)
    tok_set_line(toks, out, 0)
    out = out + 1
    // Emit mangled name
    tok_set_type(toks, out, TOK_IDENT)
    tok_set_start(toks, out, moff)
    tok_set_len(toks, out, mlen)
    tok_set_imm(toks, out, 0)
    tok_set_line(toks, out, 0)
    out = out + 1
    // Skip original fn + method_name tokens (tok_start, tok_start+1)
    let si = tok_start + 2
    // Now at LPAREN. Copy it.
    tok_set_type(toks, out, tok_type_at_raw(toks, si))
    tok_set_start(toks, out, tok_str_start_at_raw(toks, si))
    tok_set_len(toks, out, tok_str_len_at_raw(toks, si))
    tok_set_imm(toks, out, 0)
    tok_set_line(toks, out, 0)
    out = out + 1
    si = si + 1
    // Check for &self pattern: AMP IDENT("self")
    let has_self = 0
    if tok_type_at_raw(toks, si) == TOK_AMP {
        let ns = tok_str_start_at_raw(toks, si + 1)
        let nl = tok_str_len_at_raw(toks, si + 1)
        if nl == 4 and streq(src, ns, 4, "self") == 1 {
            has_self = 1
        }
    }
    if has_self == 1 {
        // Replace &self with: self : & StructName
        // Emit "self" as IDENT
        tok_set_type(toks, out, TOK_IDENT)
        tok_set_start(toks, out, tok_str_start_at_raw(toks, si + 1))
        tok_set_len(toks, out, 4)
        tok_set_imm(toks, out, 0)
        tok_set_line(toks, out, 0)
        out = out + 1
        // Emit ":"
        tok_set_type(toks, out, TOK_COLON)
        tok_set_start(toks, out, 0)
        tok_set_len(toks, out, 0)
        tok_set_imm(toks, out, 0)
        tok_set_line(toks, out, 0)
        out = out + 1
        // Emit "&"
        tok_set_type(toks, out, TOK_AMP)
        tok_set_start(toks, out, 0)
        tok_set_len(toks, out, 0)
        tok_set_imm(toks, out, 0)
        tok_set_line(toks, out, 0)
        out = out + 1
        // Emit struct name as IDENT
        tok_set_type(toks, out, TOK_IDENT)
        tok_set_start(toks, out, sn_off)
        tok_set_len(toks, out, sn_len)
        tok_set_imm(toks, out, 0)
        tok_set_line(toks, out, 0)
        out = out + 1
        si = si + 2
    }
    // Copy remaining tokens up to and including tok_end
    loop si <= tok_end {
        tok_set_type(toks, out, tok_type_at_raw(toks, si))
        tok_set_start(toks, out, tok_str_start_at_raw(toks, si))
        tok_set_len(toks, out, tok_str_len_at_raw(toks, si))
        tok_set_imm(toks, out, toks[si].imm)
        tok_set_line(toks, out, 0)
        out = out + 1
        si = si + 1
    }
    ret out
}

// --- Trait declaration support ---

// g_trait_buf layout:
//   [tid*4+0] = trait_name_off, [tid*4+1] = trait_name_len
//   [tid*4+2] = method_count,   [tid*4+3] = first_method_slot
// Method sub-array at offset 128:
//   [slot*5+0] = method_name_off, [slot*5+1] = method_name_len
//   [slot*5+2] = has_default_body (0/1)
//   [slot*5+3] = default_tok_start, [slot*5+4] = default_tok_end

fn lookup_trait(src: &i8, name_off: i64, name_len: i64) -> i64 {
    let i = 0
    loop i < g_trait_cnt {
        let p = i * 4
        if g_trait_buf[p + 1] == name_len {
            if str_match(src, g_trait_buf[p], name_off, name_len) == 1 {
                ret i
            }
        }
        i = i + 1
    }
    ret -1
}

fn trait_method_base(tid: i64) -> i64 {
    ret 128 + g_trait_buf[tid * 4 + 3] * 5
}

fn impl_block_has_method(toks: &Token, src: &i8, mn_off: i64, mn_len: i64, lbrace: i64, rbrace: i64) -> i64 {
    let fi = lbrace + 1
    loop fi < rbrace {
        let ft = tok_type_at_raw(toks, fi)
        let is_fn = ft == TOK_FN
        if ft == TOK_IDENT and tok_str_len_at_raw(toks, fi) == 2 {
            if streq(src, tok_str_start_at_raw(toks, fi), 2, "fn") == 1 { is_fn = 1 }
        }
        if is_fn == 1 {
            let fn_noff = tok_str_start_at_raw(toks, fi + 1)
            let fn_nlen = tok_str_len_at_raw(toks, fi + 1)
            if fn_nlen == mn_len {
                if str_match(src, fn_noff, mn_off, mn_len) == 1 { ret 1 }
            }
        }
        fi = fi + 1
    }
    ret 0
}

fn scan_trait_decls(tok_cnt: i64) {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let method_slot = 0
    let i = 0
    loop i < tok_cnt {
        let t0 = tok_type_at_raw(toks, i)
        let is_trait = t0 == TOK_TRAIT
        if t0 == TOK_IDENT and tok_str_len_at_raw(toks, i) == 5 {
            if streq(src, tok_str_start_at_raw(toks, i), 5, "trait") == 1 { is_trait = 1 }
        }
        if is_trait == 1 and g_trait_cnt < 32 {
            let tn_off = tok_str_start_at_raw(toks, i + 1)
            let tn_len = tok_str_len_at_raw(toks, i + 1)
            // Find opening brace
            let lb = -1
            let si = i + 2
            loop si < tok_cnt {
                if tok_type_at_raw(toks, si) == TOK_LBRACE {
                    lb = si
                    si = tok_cnt
                } else {
                    si = si + 1
                }
            }
            if lb >= 0 {
                // Find closing brace
                let rb = -1
                let depth = 1
                si = lb + 1
                loop si < tok_cnt {
                    let st = tok_type_at_raw(toks, si)
                    if st == TOK_LBRACE { depth = depth + 1 }
                    if st == TOK_RBRACE { depth = depth - 1 }
                    if depth == 0 {
                        rb = si
                        si = tok_cnt
                    } else {
                        si = si + 1
                    }
                }
                if rb >= 0 {
                    // Record trait header
                    let tid = g_trait_cnt
                    let tp = tid * 4
                    g_trait_buf[tp] = tn_off
                    g_trait_buf[tp + 1] = tn_len
                    g_trait_buf[tp + 3] = method_slot
                    let mcnt = 0
                    // Scan for fn declarations inside trait
                    let fi = lb + 1
                    loop fi < rb {
                        let ft = tok_type_at_raw(toks, fi)
                        let is_fn = ft == TOK_FN
                        if ft == TOK_IDENT and tok_str_len_at_raw(toks, fi) == 2 {
                            if streq(src, tok_str_start_at_raw(toks, fi), 2, "fn") == 1 { is_fn = 1 }
                        }
                        if is_fn == 1 {
                            let mn_off = tok_str_start_at_raw(toks, fi + 1)
                            let mn_len = tok_str_len_at_raw(toks, fi + 1)
                            // Scan forward: LBRACE means default body, else abstract
                            // Abstract methods end at next fn keyword or trait closing brace
                            let has_body = 0
                            let body_start = 0
                            let body_end = 0
                            let found = 0
                            let si2 = fi + 2
                            loop si2 < rb {
                                let s2t = tok_type_at_raw(toks, si2)
                                if found == 0 and s2t == TOK_LBRACE {
                                    // Has default body — find matching rbrace
                                    has_body = 1
                                    body_start = fi
                                    let bd = 1
                                    let bj = si2 + 1
                                    loop bj < rb + 1 {
                                        let bjt = tok_type_at_raw(toks, bj)
                                        if bjt == TOK_LBRACE { bd = bd + 1 }
                                        if bjt == TOK_RBRACE { bd = bd - 1 }
                                        if bd == 0 {
                                            body_end = bj
                                            bj = rb + 1
                                        } else {
                                            bj = bj + 1
                                        }
                                    }
                                    fi = body_end + 1
                                    found = 1
                                    si2 = rb
                                }
                                if found == 0 {
                                    // Check if next token is fn keyword → end of abstract method
                                    let is_next_fn = s2t == TOK_FN
                                    if s2t == TOK_IDENT and tok_str_len_at_raw(toks, si2) == 2 {
                                        if streq(src, tok_str_start_at_raw(toks, si2), 2, "fn") == 1 { is_next_fn = 1 }
                                    }
                                    if is_next_fn == 1 {
                                        // Abstract method — no body, next fn starts here
                                        fi = si2
                                        found = 1
                                        si2 = rb
                                    }
                                }
                                if found == 0 {
                                    si2 = si2 + 1
                                }
                            }
                            // If loop finished without finding body or next fn, abstract method ends at rb
                            if found == 0 {
                                fi = rb
                            }
                            // Copy default body tokens to high area so they survive blanking
                            let copy_start = body_start
                            let copy_end = body_end
                            if has_body == 1 {
                                copy_start = g_trait_copy_pos
                                let cj = body_start
                                loop cj <= body_end {
                                    tok_set_type(toks, g_trait_copy_pos, tok_type_at_raw(toks, cj))
                                    tok_set_start(toks, g_trait_copy_pos, tok_str_start_at_raw(toks, cj))
                                    tok_set_len(toks, g_trait_copy_pos, tok_str_len_at_raw(toks, cj))
                                    tok_set_imm(toks, g_trait_copy_pos, toks[cj].imm)
                                    tok_set_line(toks, g_trait_copy_pos, 0)
                                    g_trait_copy_pos = g_trait_copy_pos + 1
                                    cj = cj + 1
                                }
                                copy_end = g_trait_copy_pos - 1
                            }
                            // Record method
                            let mp = 128 + method_slot * 5
                            g_trait_buf[mp] = mn_off
                            g_trait_buf[mp + 1] = mn_len
                            g_trait_buf[mp + 2] = has_body
                            g_trait_buf[mp + 3] = copy_start
                            g_trait_buf[mp + 4] = copy_end
                            method_slot = method_slot + 1
                            mcnt = mcnt + 1
                        } else {
                            fi = fi + 1
                        }
                    }
                    g_trait_buf[tp + 2] = mcnt
                    g_trait_cnt = tid + 1
                    // Do NOT blank tokens yet — default method bodies needed during impl expansion
                    i = rb + 1
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

fn blank_trait_decl_toks(tok_cnt: i64) {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let i = 0
    loop i < tok_cnt {
        let t0 = tok_type_at_raw(toks, i)
        let is_trait = t0 == TOK_TRAIT
        if t0 == TOK_IDENT and tok_str_len_at_raw(toks, i) == 5 {
            if streq(src, tok_str_start_at_raw(toks, i), 5, "trait") == 1 { is_trait = 1 }
        }
        if is_trait == 1 {
            // Find closing brace and blank everything
            let si = i + 2
            let rb = -1
            loop si < tok_cnt {
                if tok_type_at_raw(toks, si) == TOK_LBRACE {
                    let depth = 1
                    let sj = si + 1
                    loop sj < tok_cnt {
                        let sjt = tok_type_at_raw(toks, sj)
                        if sjt == TOK_LBRACE { depth = depth + 1 }
                        if sjt == TOK_RBRACE { depth = depth - 1 }
                        if depth == 0 {
                            rb = sj
                            sj = tok_cnt
                        } else {
                            sj = sj + 1
                        }
                    }
                    si = tok_cnt
                } else {
                    si = si + 1
                }
            }
            if rb >= 0 {
                let hi = i
                loop hi <= rb {
                    tok_set_type(toks, hi, TOK_EOF)
                    tok_set_len(toks, hi, 0)
                    hi = hi + 1
                }
                i = rb + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

fn is_fn_tok(toks: &Token, idx: i64, src: &i8) -> i64 {
    let t = tok_type_at_raw(toks, idx)
    if t == TOK_FN { ret 1 }
    if t == TOK_IDENT and tok_str_len_at_raw(toks, idx) == 2 {
        if streq(src, tok_str_start_at_raw(toks, idx), 2, "fn") == 1 { ret 1 }
    }
    ret 0
}

fn blank_fwd_decl_toks(tok_cnt: i64) {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let i = 0
    loop i < tok_cnt {
        let is_fn = is_fn_tok(toks, i, src)
        if is_fn == 1 {
            // Scan from i+2 onward looking for { or fn
            let si = i + 2
            let found_brace = 0
            let next_fn_pos = tok_cnt
            loop si < tok_cnt {
                let st = tok_type_at_raw(toks, si)
                if st == TOK_LBRACE {
                    found_brace = 1
                    si = tok_cnt
                } else {
                    let si_is_fn = is_fn_tok(toks, si, src)
                    if si_is_fn == 1 {
                        next_fn_pos = si
                        si = tok_cnt
                    } else {
                        si = si + 1
                    }
                }
            }
            if found_brace == 0 {
                // No body found — this is a forward declaration, blank it
                let end_i = next_fn_pos
                let hi = i
                loop hi < end_i {
                    tok_set_type(toks, hi, TOK_EOF)
                    tok_set_len(toks, hi, 0)
                    hi = hi + 1
                }
                i = end_i
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

// Scan tokens for impl blocks and expand methods.
// Returns new token count.
fn expand_impl_blocks(tok_cnt: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let new_cnt = tok_cnt
    let i = 0
    loop i + 3 < tok_cnt {
        let t0 = tok_type_at_raw(toks, i)
        let is_impl = t0 == TOK_IMPL
        if t0 == TOK_IDENT and tok_str_len_at_raw(toks, i) == 4 {
            if streq(src, tok_str_start_at_raw(toks, i), 4, "impl") == 1 { is_impl = 1 }
        }
        if is_impl == 1 {
            // Check for: impl Trait for Struct { ... } vs impl Struct { ... }
            let sn_off = tok_str_start_at_raw(toks, i + 1)
            let sn_len = tok_str_len_at_raw(toks, i + 1)
            let is_trait_impl = 0
            let impl_trait_idx = -1
            // Check if token i+2 is "for" (may be TOK_IDENT or TOK_FOR keyword)
            let t_i2 = tok_type_at_raw(toks, i + 2)
            if t_i2 == TOK_IDENT or t_i2 == TOK_FOR {
                if tok_str_len_at_raw(toks, i + 2) == 3 {
                    if streq(src, tok_str_start_at_raw(toks, i + 2), 3, "for") == 1 {
                        // impl Trait for Struct — token i+1=Trait, i+3=Struct
                        is_trait_impl = 1
                        let trait_noff = sn_off
                        let trait_nlen = sn_len
                        impl_trait_idx = lookup_trait(src, trait_noff, trait_nlen)
                        if impl_trait_idx < 0 {
                            eprint("error: unknown trait: ")
                            eprint_src_range(src, trait_noff, trait_nlen)
                            eprint("\n")
                        }
                        // Struct name is at i+3
                        sn_off = tok_str_start_at_raw(toks, i + 3)
                        sn_len = tok_str_len_at_raw(toks, i + 3)
                    }
                }
            }
            // Find the impl block's opening and closing braces
            let impl_lbrace = -1
            let impl_rbrace = -1
            let si = i + 2
            if is_trait_impl == 1 { si = i + 4 }
            loop si < tok_cnt {
                if tok_type_at_raw(toks, si) == TOK_LBRACE {
                    impl_lbrace = si
                    si = tok_cnt
                } else {
                    si = si + 1
                }
            }
            if impl_lbrace >= 0 {
                let depth = 1
                si = impl_lbrace + 1
                loop si < tok_cnt {
                    let st = tok_type_at_raw(toks, si)
                    if st == TOK_LBRACE { depth = depth + 1 }
                    if st == TOK_RBRACE { depth = depth - 1 }
                    if depth == 0 {
                        impl_rbrace = si
                        si = tok_cnt
                    } else {
                        si = si + 1
                    }
                }
            }
            if impl_rbrace >= 0 {
                // Trait validation: check required methods + inject defaults
                if is_trait_impl == 1 and impl_trait_idx >= 0 {
                    let tp2 = impl_trait_idx * 4
                    let tmcnt = g_trait_buf[tp2 + 2]
                    let tms = g_trait_buf[tp2 + 3]
                    let mi2 = 0
                    loop mi2 < tmcnt {
                        let tmp = 128 + (tms + mi2) * 5
                        let tm_off = g_trait_buf[tmp]
                        let tm_len = g_trait_buf[tmp + 1]
                        let tm_has_def = g_trait_buf[tmp + 2]
                        let found = impl_block_has_method(toks, src, tm_off, tm_len, impl_lbrace, impl_rbrace)
                        if found == 0 and tm_has_def == 0 {
                            eprint("error: missing trait method: ")
                            eprint_src_range(src, tm_off, tm_len)
                            eprint("\n")
                        }
                        if found == 0 and tm_has_def == 1 {
                            // Inject default method: copy trait fn tokens to output
                            let def_start = g_trait_buf[tmp + 3]
                            let def_end = g_trait_buf[tmp + 4]
                            if def_end > def_start and g_genfn_buf[200] < 64 {
                                let moff2 = g_runtime_src_len
                                let mlen2 = build_method_mangle(sn_off, sn_len, tm_off, tm_len)
                                let mc2 = g_genfn_buf[200]
                                let mp2 = 201 + mc2 * 6
                                g_genfn_buf[mp2] = sn_off
                                g_genfn_buf[mp2 + 1] = sn_len
                                g_genfn_buf[mp2 + 2] = tm_off
                                g_genfn_buf[mp2 + 3] = tm_len
                                g_genfn_buf[mp2 + 4] = moff2
                                g_genfn_buf[mp2 + 5] = mlen2
                                g_genfn_buf[200] = mc2 + 1
                                new_cnt = copy_method_toks(mc2, def_start, def_end, new_cnt)
                            }
                        }
                        mi2 = mi2 + 1
                    }
                }
                // Scan for fn declarations inside the impl block
                let fi = impl_lbrace + 1
                loop fi < impl_rbrace {
                    let ft = tok_type_at_raw(toks, fi)
                    let is_fn = ft == TOK_FN
                    if ft == TOK_IDENT and tok_str_len_at_raw(toks, fi) == 2 {
                        if streq(src, tok_str_start_at_raw(toks, fi), 2, "fn") == 1 { is_fn = 1 }
                    }
                    if is_fn == 1 {
                        let mn_off = tok_str_start_at_raw(toks, fi + 1)
                        let mn_len = tok_str_len_at_raw(toks, fi + 1)
                        // Find this method's closing brace
                        let fn_end = -1
                        let fsi = fi + 2
                        loop fsi < impl_rbrace {
                            if tok_type_at_raw(toks, fsi) == TOK_LBRACE {
                                let fd = 1
                                let fsj = fsi + 1
                                loop fsj < impl_rbrace + 1 {
                                    let fst = tok_type_at_raw(toks, fsj)
                                    if fst == TOK_LBRACE { fd = fd + 1 }
                                    if fst == TOK_RBRACE { fd = fd - 1 }
                                    if fd == 0 {
                                        fn_end = fsj
                                        fsj = impl_rbrace + 1
                                    } else {
                                        fsj = fsj + 1
                                    }
                                }
                                fsi = impl_rbrace
                            } else {
                                fsi = fsi + 1
                            }
                        }
                        if fn_end >= 0 and g_genfn_buf[200] < 64 {
                            // Build mangled name
                            let moff = g_runtime_src_len
                            let mlen = build_method_mangle(sn_off, sn_len, mn_off, mn_len)
                            // Record in impl table
                            let mc = g_genfn_buf[200]
                            let mp = 201 + mc * 6
                            g_genfn_buf[mp] = sn_off
                            g_genfn_buf[mp + 1] = sn_len
                            g_genfn_buf[mp + 2] = mn_off
                            g_genfn_buf[mp + 3] = mn_len
                            g_genfn_buf[mp + 4] = moff
                            g_genfn_buf[mp + 5] = mlen
                            g_genfn_buf[200] = mc + 1
                            // Copy method tokens to end of token array
                            new_cnt = copy_method_toks(mc, fi, fn_end, new_cnt)
                        }
                        if fn_end >= 0 {
                            fi = fn_end + 1
                        } else {
                            fi = fi + 1
                        }
                    } else {
                        fi = fi + 1
                    }
                }
                // Hide original impl block tokens
                let hi = i
                loop hi <= impl_rbrace {
                    tok_set_type(toks, hi, TOK_EOF)
                    tok_set_len(toks, hi, 0)
                    hi = hi + 1
                }
                i = impl_rbrace + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    ret new_cnt
}

// --- Derive attribute support ---

fn emit_tok(toks: &Token, out: i64, ty: i64, s: i64, l: i64) -> i64 {
    tok_set_type(toks, out, ty)
    tok_set_start(toks, out, s)
    tok_set_len(toks, out, l)
    tok_set_imm(toks, out, 0)
    tok_set_line(toks, out, 0)
    ret out + 1
}

fn write_src_bytes(buf: &i8, text: &i8, len: i64) -> i64 {
    let off = g_runtime_src_len
    let i = 0
    loop i < len {
        poke_byte(buf, off + i, load_i8_at(text, i))
        i = i + 1
    }
    g_runtime_src_len = off + len
    ret off
}

fn write_src_cstr(buf: &i8, text: &i8) -> i64 {
    let off = g_runtime_src_len
    let i = 0
    loop load_i8_at(text, i) != 0 {
        poke_byte(buf, off + i, load_i8_at(text, i))
        i = i + 1
    }
    g_runtime_src_len = off + i
    ret off
}

fn derive_write_mangled(src: &i8, sn_off: i64, sn_len: i64, method: &i8, meth_len: i64) -> i64 {
    let moff = g_runtime_src_len
    let i = 0
    loop i < sn_len {
        poke_byte(src, moff + i, load_i8_at(src, sn_off + i))
        i = i + 1
    }
    poke_byte(src, moff + sn_len, 95)
    i = 0
    loop i < meth_len {
        poke_byte(src, moff + sn_len + 1 + i, load_i8_at(method, i))
        i = i + 1
    }
    let mlen = sn_len + 1 + meth_len
    // Write "\nfn Name " for FN_SCAN
    let woff = moff + mlen
    poke_byte(src, woff, 10)
    poke_byte(src, woff + 1, 102)
    poke_byte(src, woff + 2, 110)
    poke_byte(src, woff + 3, 32)
    i = 0
    loop i < mlen {
        poke_byte(src, woff + 4 + i, load_i8_at(src, moff + i))
        i = i + 1
    }
    poke_byte(src, woff + 4 + mlen, 32)
    g_runtime_src_len = woff + 4 + mlen + 1
    ret moff
}

fn emit_fn_header(toks: &Token, out: i64, src: &i8, moff: i64, mlen: i64) -> i64 {
    let fn_off = moff + mlen + 1
    out = emit_tok(toks, out, TOK_IDENT, fn_off, 2)
    out = emit_tok(toks, out, TOK_IDENT, moff, mlen)
    out = emit_tok(toks, out, TOK_LPAREN, 0, 0)
    ret out
}

// emit_param_ref inlined — 7-arg functions miscompiled by jda0

fn scan_derive_attrs(tok_cnt: i64) {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    g_derive_cnt = 0
    let i = 0
    loop i + 4 < tok_cnt {
        let t0 = tok_type_at_raw(toks, i)
        if t0 == TOK_IDENT and tok_str_len_at_raw(toks, i) == 6 {
            if streq(src, tok_str_start_at_raw(toks, i), 6, "derive") == 1 {
                if tok_type_at_raw(toks, i + 1) == TOK_LPAREN {
                    // Find matching RPAREN
                    let rp = i + 2
                    loop rp < tok_cnt {
                        if tok_type_at_raw(toks, rp) == TOK_RPAREN {
                            rp = tok_cnt + rp
                        } else {
                            rp = rp + 1
                        }
                    }
                    if rp >= tok_cnt {
                        rp = rp - tok_cnt
                    }
                    // Find struct after RPAREN
                    let si = rp + 1
                    let found_struct = 0
                    if si < tok_cnt {
                        let st = tok_type_at_raw(toks, si)
                        if st == TOK_STRUCT { found_struct = 1 }
                        if st == TOK_IDENT and tok_str_len_at_raw(toks, si) == 6 {
                            if streq(src, tok_str_start_at_raw(toks, si), 6, "struct") == 1 {
                                found_struct = 1
                            }
                        }
                    }
                    if found_struct == 1 {
                        let sn_off = tok_str_start_at_raw(toks, si + 1)
                        let sn_len = tok_str_len_at_raw(toks, si + 1)
                        // Parse trait names between parens
                        let ti = i + 2
                        loop ti < rp {
                            let tt = tok_type_at_raw(toks, ti)
                            if tt == TOK_IDENT {
                                let tn_off = tok_str_start_at_raw(toks, ti)
                                let tn_len = tok_str_len_at_raw(toks, ti)
                                let trait_id = 0
                                if tn_len == 5 and streq(src, tn_off, 5, "Debug") == 1 { trait_id = DERIVE_DEBUG }
                                if tn_len == 2 and streq(src, tn_off, 2, "Eq") == 1 { trait_id = DERIVE_EQ }
                                if tn_len == 5 and streq(src, tn_off, 5, "Clone") == 1 { trait_id = DERIVE_CLONE }
                                if tn_len == 4 and streq(src, tn_off, 4, "Hash") == 1 { trait_id = DERIVE_HASH }
                                if tn_len == 4 and streq(src, tn_off, 4, "Zero") == 1 { trait_id = DERIVE_ZERO }
                                if tn_len == 3 and streq(src, tn_off, 3, "Ord") == 1 { trait_id = DERIVE_ORD }
                                if trait_id > 0 and g_derive_cnt < 256 {
                                    g_derive_trait_id[g_derive_cnt] = trait_id
                                    g_derive_sname_off[g_derive_cnt] = sn_off
                                    g_derive_sname_len[g_derive_cnt] = sn_len
                                    g_derive_struct_tok[g_derive_cnt] = si
                                    g_derive_cnt = g_derive_cnt + 1
                                }
                            }
                            ti = ti + 1
                        }
                        // Hide derive(...) tokens
                        let hi = i
                        loop hi <= rp {
                            tok_set_type(toks, hi, TOK_EOF)
                            tok_set_len(toks, hi, 0)
                            hi = hi + 1
                        }
                    }
                    i = rp + 1
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
}

// Parse struct fields from token stream. struct_tok points to STRUCT keyword.
// Calls callback-style: stores field names/lens in temp arrays.
// Returns field count. Field info stored in g_derive_field_off/len arrays.
let g_derive_field_off: &i64 = 0
let g_derive_field_len: &i64 = 0

fn derive_parse_fields(struct_tok: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    // Find LBRACE after struct Name
    let si = struct_tok + 2
    loop tok_type_at_raw(toks, si) != TOK_LBRACE and si < g_dbg_tok_cnt {
        si = si + 1
    }
    si = si + 1
    // Parse fields: IDENT COLON TYPE [LBRACK INT RBRACK]
    let fcnt = 0
    loop tok_type_at_raw(toks, si) != TOK_RBRACE and si < g_dbg_tok_cnt {
        let ft = tok_type_at_raw(toks, si)
        if ft == TOK_IDENT {
            let foff = tok_str_start_at_raw(toks, si)
            let flen = tok_str_len_at_raw(toks, si)
            // Check next is COLON (confirms this is a field, not something else)
            if tok_type_at_raw(toks, si + 1) == TOK_COLON {
                g_derive_field_off[fcnt] = foff
                g_derive_field_len[fcnt] = flen
                fcnt = fcnt + 1
                // Skip: IDENT COLON TYPE
                si = si + 3
                // Skip optional array syntax [N]
                if tok_type_at_raw(toks, si) == TOK_LBRACK {
                    si = si + 1
                    loop tok_type_at_raw(toks, si) != TOK_RBRACK and si < g_dbg_tok_cnt {
                        si = si + 1
                    }
                    si = si + 1
                }
            } else {
                si = si + 1
            }
        } else {
            si = si + 1
        }
    }
    ret fcnt
}

fn gen_derive_debug(struct_tok: i64, sn_off: i64, sn_len: i64, out: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let cnt = derive_parse_fields(struct_tok)
    // Write mangled name
    let moff = derive_write_mangled(src, sn_off, sn_len, "debug", 5)
    let mlen = sn_len + 1 + 5
    let self_off = write_src_cstr(src, "self")
    // fn StructName_debug(self: &StructName) {
    out = emit_fn_header(toks, out, src, moff, mlen)
    out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
    // print("StructName(")
    let hdr_off = g_runtime_src_len
    let hi = 0
    loop hi < sn_len {
        poke_byte(src, g_runtime_src_len, load_i8_at(src, sn_off + hi))
        g_runtime_src_len = g_runtime_src_len + 1
        hi = hi + 1
    }
    poke_byte(src, g_runtime_src_len, 40)
    g_runtime_src_len = g_runtime_src_len + 1
    let hdr_len = g_runtime_src_len - hdr_off
    out = emit_tok(toks, out, TOK_PRINT, 0, 0)
    out = emit_tok(toks, out, TOK_LPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_STR, hdr_off, hdr_len)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    // For each field
    let fi = 0
    loop fi < cnt {
        let fn_off = g_derive_field_off[fi]
        let fn_len = g_derive_field_len[fi]
        // print(", ") if not first
        if fi > 0 {
            let comma_off = write_src_cstr(src, ", ")
            out = emit_tok(toks, out, TOK_PRINT, 0, 0)
            out = emit_tok(toks, out, TOK_LPAREN, 0, 0)
            out = emit_tok(toks, out, TOK_STR, comma_off, 2)
            out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
        }
        // print("fieldname: ")
        let label_off = g_runtime_src_len
        let li = 0
        loop li < fn_len {
            poke_byte(src, g_runtime_src_len, load_i8_at(src, fn_off + li))
            g_runtime_src_len = g_runtime_src_len + 1
            li = li + 1
        }
        poke_byte(src, g_runtime_src_len, 58)
        g_runtime_src_len = g_runtime_src_len + 1
        poke_byte(src, g_runtime_src_len, 32)
        g_runtime_src_len = g_runtime_src_len + 1
        let label_len = g_runtime_src_len - label_off
        out = emit_tok(toks, out, TOK_PRINT, 0, 0)
        out = emit_tok(toks, out, TOK_LPAREN, 0, 0)
        out = emit_tok(toks, out, TOK_STR, label_off, label_len)
        out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
        // let _dN = self.field
        let tmp_off = g_runtime_src_len
        poke_byte(src, g_runtime_src_len, 95)
        g_runtime_src_len = g_runtime_src_len + 1
        poke_byte(src, g_runtime_src_len, 100)
        g_runtime_src_len = g_runtime_src_len + 1
        poke_byte(src, g_runtime_src_len, 48 + fi)
        g_runtime_src_len = g_runtime_src_len + 1
        let tmp_len = 3
        out = emit_tok(toks, out, TOK_LET, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, tmp_off, tmp_len)
        out = emit_tok(toks, out, TOK_EQ, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        // print("{_dN}")
        let interp_off = g_runtime_src_len
        poke_byte(src, g_runtime_src_len, 123)
        g_runtime_src_len = g_runtime_src_len + 1
        poke_byte(src, g_runtime_src_len, 95)
        g_runtime_src_len = g_runtime_src_len + 1
        poke_byte(src, g_runtime_src_len, 100)
        g_runtime_src_len = g_runtime_src_len + 1
        poke_byte(src, g_runtime_src_len, 48 + fi)
        g_runtime_src_len = g_runtime_src_len + 1
        poke_byte(src, g_runtime_src_len, 125)
        g_runtime_src_len = g_runtime_src_len + 1
        let interp_len = 5
        out = emit_tok(toks, out, TOK_PRINT, 0, 0)
        out = emit_tok(toks, out, TOK_LPAREN, 0, 0)
        out = emit_tok(toks, out, TOK_STR, interp_off, interp_len)
        out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
        fi = fi + 1
    }
    // print(")")
    let close_off = write_src_cstr(src, ")")
    out = emit_tok(toks, out, TOK_PRINT, 0, 0)
    out = emit_tok(toks, out, TOK_LPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_STR, close_off, 1)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    // }
    out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
    ret out
}

fn gen_derive_eq(struct_tok: i64, sn_off: i64, sn_len: i64, out: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let cnt = derive_parse_fields(struct_tok)
    let moff = derive_write_mangled(src, sn_off, sn_len, "eq", 2)
    let mlen = sn_len + 1 + 2
    let a_off = write_src_cstr(src, "a")
    let b_off = write_src_cstr(src, "b")
    // fn StructName_eq(a: &StructName, b: &StructName) -> i64 {
    out = emit_fn_header(toks, out, src, moff, mlen)
    out = emit_tok(toks, out, TOK_IDENT, a_off, 1)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_COMMA, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, b_off, 1)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_ARROW, 0, 0)
    out = emit_tok(toks, out, TOK_I64, 0, 0)
    out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
    // For each field: if a.field != b.field { ret 0 }
    let fi = 0
    loop fi < cnt {
        let fn_off = g_derive_field_off[fi]
        let fn_len = g_derive_field_len[fi]
        out = emit_tok(toks, out, TOK_IF, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, a_off, 1)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_NEQ, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, b_off, 1)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
        out = emit_tok(toks, out, TOK_RET, 0, 0)
        let zero_off = write_src_cstr(src, "0")
        tok_set_type(toks, out, TOK_INT)
        tok_set_start(toks, out, zero_off)
        tok_set_len(toks, out, 1)
        tok_set_imm(toks, out, 0)
        tok_set_line(toks, out, 0)
        out = out + 1
        out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
        fi = fi + 1
    }
    // ret 1
    out = emit_tok(toks, out, TOK_RET, 0, 0)
    let one_off = write_src_cstr(src, "1")
    tok_set_type(toks, out, TOK_INT)
    tok_set_start(toks, out, one_off)
    tok_set_len(toks, out, 1)
    tok_set_imm(toks, out, 1)
    tok_set_line(toks, out, 0)
    out = out + 1
    out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
    ret out
}

fn gen_derive_clone(struct_tok: i64, sn_off: i64, sn_len: i64, out: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let cnt = derive_parse_fields(struct_tok)
    let moff = derive_write_mangled(src, sn_off, sn_len, "clone", 5)
    let mlen = sn_len + 1 + 5
    let self_off = write_src_cstr(src, "self")
    let dst_off = write_src_cstr(src, "dst")
    out = emit_fn_header(toks, out, src, moff, mlen)
    out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_COMMA, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, dst_off, 3)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
    let fi = 0
    loop fi < cnt {
        let fn_off = g_derive_field_off[fi]
        let fn_len = g_derive_field_len[fi]
        out = emit_tok(toks, out, TOK_IDENT, dst_off, 3)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_EQ, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        fi = fi + 1
    }
    out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
    ret out
}

fn gen_derive_zero(struct_tok: i64, sn_off: i64, sn_len: i64, out: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let cnt = derive_parse_fields(struct_tok)
    let moff = derive_write_mangled(src, sn_off, sn_len, "zero", 4)
    let mlen = sn_len + 1 + 4
    let self_off = write_src_cstr(src, "self")
    out = emit_fn_header(toks, out, src, moff, mlen)
    out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
    let fi = 0
    loop fi < cnt {
        let fn_off = g_derive_field_off[fi]
        let fn_len = g_derive_field_len[fi]
        out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_EQ, 0, 0)
        let zero_off = write_src_cstr(src, "0")
        tok_set_type(toks, out, TOK_INT)
        tok_set_start(toks, out, zero_off)
        tok_set_len(toks, out, 1)
        tok_set_imm(toks, out, 0)
        tok_set_line(toks, out, 0)
        out = out + 1
        fi = fi + 1
    }
    out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
    ret out
}

fn gen_derive_hash(struct_tok: i64, sn_off: i64, sn_len: i64, out: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let cnt = derive_parse_fields(struct_tok)
    let moff = derive_write_mangled(src, sn_off, sn_len, "hash", 4)
    let mlen = sn_len + 1 + 4
    let self_off = write_src_cstr(src, "self")
    out = emit_fn_header(toks, out, src, moff, mlen)
    out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_ARROW, 0, 0)
    out = emit_tok(toks, out, TOK_I64, 0, 0)
    out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
    // let h = 2166136261
    let h_off = write_src_cstr(src, "h")
    out = emit_tok(toks, out, TOK_LET, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, h_off, 1)
    out = emit_tok(toks, out, TOK_EQ, 0, 0)
    let fnv_off = write_src_cstr(src, "2166136261")
    tok_set_type(toks, out, TOK_INT)
    tok_set_start(toks, out, fnv_off)
    tok_set_len(toks, out, 10)
    tok_set_imm(toks, out, 2166136261)
    tok_set_line(toks, out, 0)
    out = out + 1
    let fi = 0
    loop fi < cnt {
        let fn_off = g_derive_field_off[fi]
        let fn_len = g_derive_field_len[fi]
        // h = h * 16777619
        out = emit_tok(toks, out, TOK_IDENT, h_off, 1)
        out = emit_tok(toks, out, TOK_EQ, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, h_off, 1)
        out = emit_tok(toks, out, TOK_STAR, 0, 0)
        let prime_off = write_src_cstr(src, "16777619")
        tok_set_type(toks, out, TOK_INT)
        tok_set_start(toks, out, prime_off)
        tok_set_len(toks, out, 8)
        tok_set_imm(toks, out, 16777619)
        tok_set_line(toks, out, 0)
        out = out + 1
        // h = h + self.field
        out = emit_tok(toks, out, TOK_IDENT, h_off, 1)
        out = emit_tok(toks, out, TOK_EQ, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, h_off, 1)
        out = emit_tok(toks, out, TOK_PLUS, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, self_off, 4)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        fi = fi + 1
    }
    out = emit_tok(toks, out, TOK_RET, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, h_off, 1)
    out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
    ret out
}

fn gen_derive_ord(struct_tok: i64, sn_off: i64, sn_len: i64, out: i64) -> i64 {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let cnt = derive_parse_fields(struct_tok)
    let moff = derive_write_mangled(src, sn_off, sn_len, "lt", 2)
    let mlen = sn_len + 1 + 2
    let a_off = write_src_cstr(src, "a")
    let b_off = write_src_cstr(src, "b")
    // fn StructName_lt(a: &StructName, b: &StructName) -> i64 {
    out = emit_fn_header(toks, out, src, moff, mlen)
    out = emit_tok(toks, out, TOK_IDENT, a_off, 1)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_COMMA, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, b_off, 1)
    out = emit_tok(toks, out, TOK_COLON, 0, 0)
    out = emit_tok(toks, out, TOK_AMP, 0, 0)
    out = emit_tok(toks, out, TOK_IDENT, sn_off, sn_len)
    out = emit_tok(toks, out, TOK_RPAREN, 0, 0)
    out = emit_tok(toks, out, TOK_ARROW, 0, 0)
    out = emit_tok(toks, out, TOK_I64, 0, 0)
    out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
    // For each field: if a.field < b.field { ret 1 } if a.field > b.field { ret 0 }
    let fi = 0
    loop fi < cnt {
        let fn_off = g_derive_field_off[fi]
        let fn_len = g_derive_field_len[fi]
        // if a.field < b.field { ret 1 }
        out = emit_tok(toks, out, TOK_IF, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, a_off, 1)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_LT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, b_off, 1)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
        out = emit_tok(toks, out, TOK_RET, 0, 0)
        let one_off = write_src_cstr(src, "1")
        tok_set_type(toks, out, TOK_INT)
        tok_set_start(toks, out, one_off)
        tok_set_len(toks, out, 1)
        tok_set_imm(toks, out, 1)
        tok_set_line(toks, out, 0)
        out = out + 1
        out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
        // if a.field > b.field { ret 0 }
        out = emit_tok(toks, out, TOK_IF, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, a_off, 1)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_GT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, b_off, 1)
        out = emit_tok(toks, out, TOK_DOT, 0, 0)
        out = emit_tok(toks, out, TOK_IDENT, fn_off, fn_len)
        out = emit_tok(toks, out, TOK_LBRACE, 0, 0)
        out = emit_tok(toks, out, TOK_RET, 0, 0)
        let zero_off = write_src_cstr(src, "0")
        tok_set_type(toks, out, TOK_INT)
        tok_set_start(toks, out, zero_off)
        tok_set_len(toks, out, 1)
        tok_set_imm(toks, out, 0)
        tok_set_line(toks, out, 0)
        out = out + 1
        out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
        fi = fi + 1
    }
    // ret 0 (equal)
    out = emit_tok(toks, out, TOK_RET, 0, 0)
    let zero_off2 = write_src_cstr(src, "0")
    tok_set_type(toks, out, TOK_INT)
    tok_set_start(toks, out, zero_off2)
    tok_set_len(toks, out, 1)
    tok_set_imm(toks, out, 0)
    tok_set_line(toks, out, 0)
    out = out + 1
    out = emit_tok(toks, out, TOK_RBRACE, 0, 0)
    ret out
}

fn expand_derive_toks(tok_cnt: i64) -> i64 {
    let out = tok_cnt
    let di = 0
    loop di < g_derive_cnt {
        let trait_id = g_derive_trait_id[di]
        let sn_off = g_derive_sname_off[di]
        let sn_len = g_derive_sname_len[di]
        let struct_tok = g_derive_struct_tok[di]
        if trait_id == DERIVE_DEBUG { out = gen_derive_debug(struct_tok, sn_off, sn_len, out) }
        if trait_id == DERIVE_EQ { out = gen_derive_eq(struct_tok, sn_off, sn_len, out) }
        if trait_id == DERIVE_CLONE { out = gen_derive_clone(struct_tok, sn_off, sn_len, out) }
        if trait_id == DERIVE_HASH { out = gen_derive_hash(struct_tok, sn_off, sn_len, out) }
        if trait_id == DERIVE_ZERO { out = gen_derive_zero(struct_tok, sn_off, sn_len, out) }
        if trait_id == DERIVE_ORD { out = gen_derive_ord(struct_tok, sn_off, sn_len, out) }
        di = di + 1
    }
    ret out
}

// --- End derive attribute support ---

fn is_skip_rhs_int_tok(t: i64) -> i64 {
    ret t == 11
}

fn is_skip_rhs_type_tok(t: i64) -> i64 {
    ret t == 45 or t == 46 or t == 47 or t == 48 or t == 71 or t == 72 or t == 10
}

fn skip_top_level_let_rhs(toks: &Token, stab: &StructTable, src: &i8) {
    let gidx = g_tmp_let_gidx
    let decl_stype = g_tmp_let_stype
    let decl_is_addr = g_tmp_let_is_addr
    let t = tok_type_at_raw(toks, g_main_pos)
    g_glob_size[gidx] = 8
    g_glob_stype[gidx] = decl_stype
    g_glob_is_addr[gidx] = decl_is_addr
    let is_int_tok = is_skip_rhs_int_tok(t)
    if is_int_tok {
        g_main_pos = g_main_pos + 1
        ret ok(0)
    }
    let is_type_tok = is_skip_rhs_type_tok(t)
    if is_type_tok == 1 {
        let elem_sz = 8
        let stype = TYPE_I64
        let is_struct_type_tok = t == 10
        if is_struct_type_tok {
            let type_idx = g_main_pos
            let type_start = tok_str_start_at(toks, type_idx)
            let type_len = tok_str_len_at(toks, type_idx)
            let sid = lookup_struct_name(src, type_start, type_len)
            if sid >= 0 {
                elem_sz = stab.sizes[sid]
                stype = sid
            }
        }
        g_glob_size[gidx] = elem_sz
        g_glob_stype[gidx] = stype
        g_glob_is_addr[gidx] = 1
        g_main_pos = g_main_pos + 1
        let next_idx = g_main_pos
        let next_type = tok_type_at_raw(toks, next_idx)
        let has_array_suffix = next_type == 17
        if has_array_suffix {
            g_main_pos = g_main_pos + 1
            let size_idx = g_main_pos
            let n = tok_imm_at(toks, size_idx)
            g_main_pos = g_main_pos + 1
            expect(TOK_RBRACK)
            g_glob_size[gidx] = elem_sz * n
            ret ok(0)
        }
        let has_empty_braces = next_type == 15
        if has_empty_braces {
            g_main_pos = g_main_pos + 1
            expect(TOK_RBRACE)
            ret ok(0)
        }
        ret ok(0)
    }
    g_main_pos = g_main_pos + 1
}

fn skip_top_level_let(toks: &Token, stab: &StructTable, src: &i8) {
    let pre_pos = g_main_pos
    let pre_tok_t = tok_type_at_raw(toks, g_main_pos)
    expect(TOK_LET)
    let name_start = tok_str_start_at(toks, g_main_pos)
    let name_len = tok_str_len_at(toks, g_main_pos)
    
    expect(TOK_IDENT)
    let decl_stype = TYPE_I64
    let decl_is_addr = 0
    let has_type_annot = tok_type_at_raw(toks, g_main_pos) == 20
    if has_type_annot {
        g_main_pos = g_main_pos + 1
        let is_ptr = 0
        let has_ptr_annot = tok_type_at_raw(toks, g_main_pos) == 32
        if has_ptr_annot {
            is_ptr = 1
            g_main_pos = g_main_pos + 1
        }
        let dt = tok_type_at_raw(toks, g_main_pos)
        if dt == 45 { decl_stype = TYPE_I64 }
        if dt == 46 { decl_stype = TYPE_I32 }
        if dt == 47 { decl_stype = TYPE_I8 }
        if dt == 71 { decl_stype = TYPE_I16 }
        if dt == 48 { decl_stype = TYPE_F64 }
        if dt == 72 { decl_stype = TYPE_F32 }
        if dt == 10 {
            let type_start = tok_str_start_at(toks, g_main_pos)
            let type_len = tok_str_len_at(toks, g_main_pos)
            let sid = lookup_struct_name(src, type_start, type_len)
            if sid >= 0 {
                decl_stype = sid
            }
            if sid < 0 { decl_stype = TYPE_PTR }
        }
        if is_ptr == 1 {
            decl_stype = ptr_of(decl_stype)
            decl_is_addr = 1
        }
        g_main_pos = g_main_pos + 1
    }
    if g_glob_name_off == 0 { panic("Global table missing") }
    let gidx = g_glob_cnt
    if gidx >= 200 { panic("Too many globals") }
    g_glob_name_off[gidx] = name_start
    g_glob_name_len[gidx] = name_len
    g_glob_off[gidx] = g_glob_total_sz
    g_tmp_let_gidx = gidx
    g_tmp_let_stype = decl_stype
    g_tmp_let_is_addr = decl_is_addr
    let eq_tok = tok_type_at_raw(toks, g_main_pos)
    if eq_tok == TOK_EQ {
        g_main_pos = g_main_pos + 1
        skip_top_level_let_rhs(toks, stab, src)
    } else {
        g_glob_size[gidx] = 8
        g_glob_stype[gidx] = decl_stype
        g_glob_is_addr[gidx] = decl_is_addr
    }
    let glob_sz = load_i64_at(g_glob_size, gidx)
    
    g_glob_total_sz = g_glob_total_sz + glob_sz
    
    g_glob_cnt = gidx + 1
}

fn panic(msg: &i8) {
    let has_msg = msg != 0
    if has_msg {
        let n = cstr_len_max(msg, 1024)
        syscall(1, 2, msg, n)
        syscall(1, 2, "\n", 1)
    }
    syscall(60, 1, 0, 0)
}

fn cstr_len_max(buf: &i8, max_len: i64) -> i64 {
    let n = 0
    loop n < max_len {
        if buf[n] == 0 { ret n }
        n = n + 1
    }
    ret n
}

fn streq(src: &i8, start: i64, len: i64, kw: &i8) {
    let i = 0
    loop i < len {
        let a = src[start + i]
        let b = kw[i]
        if a != b { ret 0 }
        i = i + 1
    }
    let tail = kw[len]
    if tail != 0 { ret 0 }
    ret 1
}

fn str_match(src: &i8, s1: i64, s2: i64, len: i64) {
    let p1 = s1
    let p2 = s2
    let n = 0
    loop n < len {
        let a = load_i8_at(src, p1)
        let b = load_i8_at(src, p2)
        if a != b { ret 0 }
        p1 = p1 + 1
        p2 = p2 + 1
        n = n + 1
    }
    ret 1
}

fn try_escape(c: i8, next_c: i8) {
    if c == 92 {
        if next_c == 110 { ret 10 }
        if next_c == 114 { ret 13 }
        if next_c == 116 { ret 9 }
        if next_c == 48 { ret 0 }
        if next_c == 92 { ret 92 }
        if next_c == 34 { ret 34 }
    }
    ret -1
}

// Type system helpers
fn is_pointer_type(t: i32) {
    ret t >= 65536
}

fn base_type(t: i32) {
    let is_ptr = is_pointer_type(t)
    ret t - (is_ptr * 65536)
}

fn ptr_of(base: i32) {
    ret base + TYPE_PTR_FLAG
}

fn type_sizeof(st: i32) {
    let b = base_type(st)
    if b == TYPE_I8 { ret 1 }
    if b == TYPE_U8 { ret 1 }
    if b == TYPE_U16 { ret 2 }
    if b == TYPE_I16 { ret 2 }
    if b == TYPE_I32 { ret 4 }
    if b == TYPE_U32 { ret 4 }
    ret 8
}

fn is_unsigned_type(t: i64) -> i64 {
    let b = base_type(t)
    if b == TYPE_U8 { ret 1 }
    if b == TYPE_U16 { ret 1 }
    if b == TYPE_U32 { ret 1 }
    if b == TYPE_U64 { ret 1 }
    ret 0
}

fn mod256(x: i64) -> i64 {
    ret x - (x / 256) * 256
}

fn mod8(x: i64) -> i64 {
    ret x - (x / 8) * 8
}

fn i32_b0(val: i64) -> i64 {
    let v = val
    if v < 0 { v = v + 4294967296 }
    ret mod256(v)
}
fn i32_b1(val: i64) -> i64 {
    let v = val
    if v < 0 { v = v + 4294967296 }
    let b0 = mod256(v)
    ret mod256((v - b0) / 256)
}
fn i32_b2(val: i64) -> i64 {
    let v = val
    if v < 0 { v = v + 4294967296 }
    let b0 = mod256(v)
    let v1 = (v - b0) / 256
    let b1 = mod256(v1)
    ret mod256((v1 - b1) / 256)
}
fn i32_b3(val: i64) -> i64 {
    let v = val
    if v < 0 { v = v + 4294967296 }
    let b0 = mod256(v)
    let v1 = (v - b0) / 256
    let b1 = mod256(v1)
    let v2 = (v1 - b1) / 256
    let b2 = mod256(v2)
    ret mod256((v2 - b2) / 256)
}

fn ok(x: i64) {
    ret x
}

fn lookup_const(src: &i8, name_start: i64, name_len: i64) {
    let i = 0
    loop i < g_const_cnt {
        let cur_len = g_const_name_len_tbl[i]
        let cur_val = g_const_val_tbl[i]
        if cur_len == name_len {
            let cur_off = g_const_name_off_tbl[i]
            let sm = str_match(src, cur_off, name_start, name_len)
            if sm == 1 {
                ret cur_val
            }
        }
        i = i + 1
    }
    ret -1
}

fn print_span(src: &i8, start: i64, len: i64) {
    let has_len = len > 0
    if has_len == 0 { ret 0 }
    syscall(1, 1, src + start, len)
}

fn print(msg: &i8) {
    let has_msg = msg != 0
    if has_msg == 0 { ret 0 }
    let n = cstr_len_max(msg, 1024)
    syscall(1, 1, msg, n)
}

fn print_i64_dig(v: i64) {
    if v == 0 { ret 0 }
    let q = v / 10
    let digit = v - q * 10
    print_i64_dig(q)
    g_pi64_char = digit + 48
    syscall(1, 1, &g_pi64_char, 1)
    ret 0
}

fn print_i64(val: i64) {
    if val == 0 {
        print("0")
        ret 0
    }
    let v = val
    if v < 0 {
        print("-")
        v = 0 - v
    }
    print_i64_dig(v)
    ret 0
}

fn eprint(msg: &i8) {
    let has_msg = msg != 0
    if has_msg == 0 { ret 0 }
    let n = cstr_len_max(msg, 1024)
    syscall(1, 2, msg, n)
}

fn eprint_i64(val: i64) {
    if val == 0 {
        eprint("0")
        ret 0
    }
    let v = val
    if v < 0 {
        eprint("-")
        v = 0 - v
    }
    print_i64_dig(v)
    ret 0
}

// ============================================================
// Error reporting with source context
// ============================================================

// Find start of line containing byte offset `pos` in source
fn find_line_start(src: &i8, pos: i64) -> i64 {
    let p = pos
    let searching = 1
    loop searching == 1 {
        if p <= 0 {
            searching = 0
        } else {
            let c = load_i8_at(src, p - 1)
            if c == 10 {
                searching = 0
            } else {
                p = p - 1
            }
        }
    }
    ret p
}

// Find end of line containing byte offset `pos` in source
fn find_line_end(src: &i8, src_len: i64, pos: i64) -> i64 {
    let p = pos
    loop p < src_len {
        let c = load_i8_at(src, p)
        if c == 10 { ret p }
        p = p + 1
    }
    ret p
}

// Print N spaces to stderr
fn eprint_spaces(n: i64) {
    let i = 0
    loop i < n {
        syscall(1, 2, " ", 1)
        i = i + 1
    }
}

// Print N characters from src starting at offset to stderr
fn eprint_src_range(src: &i8, start: i64, len: i64) {
    if len > 0 {
        let buf_ptr = src + start
        syscall(1, 2, buf_ptr, len)
    }
}

// Print N caret (^) characters to stderr
fn eprint_carets(n: i64) {
    let i = 0
    let cnt = n
    if cnt < 1 { cnt = 1 }
    loop i < cnt {
        syscall(1, 2, "^", 1)
        i = i + 1
    }
}

// Report an error at the given token index with a message.
// Output format:
//   error: <message>
//     --> <line>:<col>
//      |
//   NN | <source line>
//      |  ^^^
fn report_error_at(tok_idx: i64, msg: &i8) {
    let toks = g_dbg_toks_init
    let src = g_src_buf_ptr
    let src_len = g_runtime_src_len

    // Get token location
    let line = tok_line_at(toks, tok_idx)
    let str_start = tok_str_start_at_raw(toks, tok_idx)
    let str_len = tok_str_len_at_raw(toks, tok_idx)

    // Compute column from str_start
    let line_start = find_line_start(src, str_start)
    let line_end = find_line_end(src, src_len, str_start)
    let col = str_start - line_start + 1
    let line_len = line_end - line_start

    // Clamp line_len to avoid huge output
    if line_len > 200 { line_len = 200 }

    // file.jda:line:col: error: <message>
    if g_src_filename != 0 {
        eprint(g_src_filename)
        eprint(":")
    }
    eprint_i64(line)
    eprint(":")
    eprint_i64(col)
    eprint(": error: ")
    eprint(msg)
    eprint("\n")

    // --> <line>:<col>
    eprint("  --> ")
    if g_src_filename != 0 {
        eprint(g_src_filename)
        eprint(":")
    }
    eprint_i64(line)
    eprint(":")
    eprint_i64(col)
    eprint("\n")

    // line number gutter
    eprint("   |\n")

    // NN | <source line>
    eprint_i64(line)
    eprint(" | ")
    eprint_src_range(src, line_start, line_len)
    eprint("\n")

    //    |  ^^^
    eprint("   | ")
    eprint_spaces(col - 1)
    eprint_carets(str_len)
    eprint("\n")

    // Exit with error
    syscall(60, 1, 0, 0)
}

// Report error at current parser position (g_main_pos)
fn report_error(msg: &i8) {
    report_error_at(g_main_pos, msg)
}

fn live_codegen_expr_inline(bb: i64) -> i64 {
    let r = live_codegen_binop_inline(0, bb)
    // Handle 'as <type>' cast — skip type annotation, return expression value unchanged
    if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_IDENT {
        let as_s = tok_str_start_at_raw(g_dbg_toks_init, g_main_pos)
        let as_l = tok_str_len_at_raw(g_dbg_toks_init, g_main_pos)
        if as_l == 2 and streq(g_src_buf_ptr, as_s, 2, "as") == 1 {
            g_main_pos = g_main_pos + 1
            // Skip '&' if present (pointer cast) — requires unsafe
            if tok_type_at_raw(g_dbg_toks_init, g_main_pos) == TOK_AMP {
                if g_check_unsafe == 1 and g_unsafe_depth == 0 { report_error("pointer cast requires unsafe block") }
                g_main_pos = g_main_pos + 1
            }
            // Skip the type token
            g_main_pos = g_main_pos + 1
        }
    }
    ret r
}

fn regalloc_free_old(ra: &RegAlloc, val_id: i64) {
    if val_id < 0 { ret ok(0) }
    if val_id >= 8192 { ret ok(0) }
    let idx = ra.val2reg[val_id]
    if idx == -1 { ret ok(0) }
    if idx < 0 { ret ok(0) }
    
    ra.reg2val[idx]    = -1
    ra.val2reg[val_id] = -1
}

fn is_alpha(c: i8) {
    ret (c >= 97 and c <= 122) or (c >= 65 and c <= 90)
}

fn is_digit(c: i8) {
    ret c >= 48 and c <= 57
}

fn is_space_char(c: i8) {
    ret c == 32 or c == 9 or c == 10 or c == 13
}

fn is_ident_continue(c: i8) {
    ret is_alpha(c) == 1 or is_digit(c) == 1 or c == 95
}

fn is_ident_start(c: i8) {
    ret is_alpha(c) == 1 or c == 95
}

fn char_to_tok_lo(c: i8) {
    if c == 37 { ret TOK_PERCENT }
    if c == 38 { ret TOK_AMP }
    if c == 40 { ret TOK_LPAREN }
    if c == 41 { ret TOK_RPAREN }
    if c == 42 { ret TOK_STAR }
    if c == 43 { ret TOK_PLUS }
    if c == 44 { ret TOK_COMMA }
    if c == 45 { ret TOK_MINUS }
    if c == 46 { ret TOK_DOT }
    if c == 47 { ret TOK_SLASH }
    ret 0
}

fn char_to_tok_mid(c: i8) {
    if c == 58 { ret TOK_COLON }
    if c == 60 { ret TOK_LT }
    if c == 61 { ret TOK_EQ }
    if c == 62 { ret TOK_GT }
    if c == 63 { ret TOK_QUESTION }
    if c == 91 { ret TOK_LBRACK }
    if c == 93 { ret TOK_RBRACK }
    ret 0
}

fn char_to_tok_hi(c: i8) {
    if c == 123 { ret TOK_LBRACE }
    if c == 124 { ret TOK_PIPE }
    if c == 125 { ret TOK_RBRACE }
    if c == 126 { ret TOK_TILDE }
    ret 0
}

fn char_to_tok(c: i8) {
    let lo = char_to_tok_lo(c)
    let mid = char_to_tok_mid(c)
    let hi = char_to_tok_hi(c)
    let tok = lo + mid + hi
    ret tok + (tok == 0) * TOK_EOF
}

fn classify_keyword_len2(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let fn_ok = 0
    if c0 == 102 { if c1 == 110 { fn_ok = 1 } }
    let m_fn = fn_ok * TOK_FN
    let if_ok = 0
    if c0 == 105 { if c1 == 102 { if_ok = 1 } }
    let m_if = if_ok * TOK_IF
    let or_ok = 0
    if c0 == 111 { if c1 == 114 { or_ok = 1 } }
    let m_or = or_ok * TOK_OR
    let i8_ok = 0
    if c0 == 105 { if c1 == 56 { i8_ok = 1 } }
    let m_i8 = i8_ok * TOK_I8
    // 'u8' = 117,56
    let u8_ok = 0
    if c0 == 117 { if c1 == 56 { u8_ok = 1 } }
    let m_u8 = u8_ok * TOK_U8
    let tok = m_fn + m_if + m_or + m_i8 + m_u8
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len3(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let let_ok = 0
    if c0 == 108 { if c1 == 101 { if c2 == 116 { let_ok = 1 } } }
    let m_let = let_ok * TOK_LET
    let ret_ok = 0
    if c0 == 114 { if c1 == 101 { if c2 == 116 { ret_ok = 1 } } }
    let m_ret = ret_ok * TOK_RET
    let and_ok = 0
    if c0 == 97 { if c1 == 110 { if c2 == 100 { and_ok = 1 } } }
    let m_and = and_ok * TOK_AND
    let i64_ok = 0
    if c0 == 105 { if c1 == 54 { if c2 == 52 { i64_ok = 1 } } }
    let m_i64 = i64_ok * TOK_I64
    let i32_ok = 0
    if c0 == 105 { if c1 == 51 { if c2 == 50 { i32_ok = 1 } } }
    let m_i32 = i32_ok * TOK_I32
    let f64_ok = 0
    if c0 == 102 { if c1 == 54 { if c2 == 52 { f64_ok = 1 } } }
    let m_f64 = f64_ok * TOK_F64
    // 'for' = 102,111,114
    let for_ok = 0
    if c0 == 102 { if c1 == 111 { if c2 == 114 { for_ok = 1 } } }
    let m_for = for_ok * TOK_FOR
    // 'not' = 110,111,116
    let not_ok = 0
    if c0 == 110 { if c1 == 111 { if c2 == 116 { not_ok = 1 } } }
    let m_not = not_ok * TOK_NOT
    // 'u64' = 117,54,52
    let u64_ok = 0
    if c0 == 117 { if c1 == 54 { if c2 == 52 { u64_ok = 1 } } }
    let m_u64 = u64_ok * TOK_U64
    // 'u32' = 117,51,50
    let u32_ok = 0
    if c0 == 117 { if c1 == 51 { if c2 == 50 { u32_ok = 1 } } }
    let m_u32 = u32_ok * TOK_U32
    // 'u16' = 117,49,54
    let u16_ok = 0
    if c0 == 117 { if c1 == 49 { if c2 == 54 { u16_ok = 1 } } }
    let m_u16 = u16_ok * TOK_U16
    // 'i16' = 105,49,54
    let i16_ok = 0
    if c0 == 105 { if c1 == 49 { if c2 == 54 { i16_ok = 1 } } }
    let m_i16 = i16_ok * TOK_I16
    // 'f32' = 102,51,50
    let f32_ok = 0
    if c0 == 102 { if c1 == 51 { if c2 == 50 { f32_ok = 1 } } }
    let m_f32 = f32_ok * TOK_F32
    let tok_a = m_let + m_ret + m_and + m_i64 + m_i32
    let tok_b = m_f64 + m_for + m_not + m_u64 + m_u32
    let tok_c = m_u16 + m_i16 + m_f32
    let tok = tok_a + tok_b + tok_c
    ret tok + (tok == 0) * TOK_IDENT
}

fn char_escape_val(esc_c: i64) -> i64 {
    // Map escape character to value using branchless multiply
    // \n=10, \t=9, \r=13, \0=0, \\=92, \'=39
    let is_n = (esc_c == 110)
    let is_t = (esc_c == 116)
    let is_r = (esc_c == 114)
    let is_0 = (esc_c == 48)
    let is_bs = (esc_c == 92)
    let is_sq = (esc_c == 39)
    let known = is_n + is_t + is_r + is_0 + is_bs + is_sq
    let val = is_n * 10 + is_t * 9 + is_r * 13 + is_bs * 92 + is_sq * 39
    // If not a known escape, use the char itself
    if known == 0 { val = esc_c }
    ret val
}

fn classify_keyword_len4(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let else_ok = 0
    if c0 == 101 { if c1 == 108 { if c2 == 115 { if c3 == 101 { else_ok = 1 } } } }
    let m_else = else_ok * TOK_ELSE
    let loop_ok = 0
    if c0 == 108 { if c1 == 111 { if c2 == 111 { if c3 == 112 { loop_ok = 1 } } } }
    let m_loop = loop_ok * TOK_LOOP
    let enum_ok = 0
    if c0 == 101 { if c1 == 110 { if c2 == 117 { if c3 == 109 { enum_ok = 1 } } } }
    let m_enum = enum_ok * TOK_ENUM
    let impl_ok = 0
    if c0 == 105 { if c1 == 109 { if c2 == 112 { if c3 == 108 { impl_ok = 1 } } } }
    let m_impl = impl_ok * TOK_IMPL
    let true_ok = 0
    if c0 == 116 { if c1 == 114 { if c2 == 117 { if c3 == 101 { true_ok = 1 } } } }
    let m_true = true_ok * TOK_TRUE
    let tok = m_else + m_loop + m_enum + m_impl + m_true
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len5(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let c4 = load_i8_at(src, start + 4)
    let print_ok = 0
    if c0 == 112 { if c1 == 114 { if c2 == 105 { if c3 == 110 { if c4 == 116 { print_ok = 1 } } } } }
    let m_print = print_ok * TOK_PRINT
    let match_ok = 0
    if c0 == 109 { if c1 == 97 { if c2 == 116 { if c3 == 99 { if c4 == 104 { match_ok = 1 } } } } }
    let m_match = match_ok * TOK_MATCH
    let const_ok = 0
    if c0 == 99 { if c1 == 111 { if c2 == 110 { if c3 == 115 { if c4 == 116 { const_ok = 1 } } } } }
    let m_const = const_ok * TOK_CONST
    let spawn_ok = 0
    if c0 == 115 { if c1 == 112 { if c2 == 97 { if c3 == 119 { if c4 == 110 { spawn_ok = 1 } } } } }
    let m_spawn = spawn_ok * TOK_SPAWN
    let trait_ok = 0
    if c0 == 116 { if c1 == 114 { if c2 == 97 { if c3 == 105 { if c4 == 116 { trait_ok = 1 } } } } }
    let m_trait = trait_ok * TOK_TRAIT
    let false_ok = 0
    if c0 == 102 { if c1 == 97 { if c2 == 108 { if c3 == 115 { if c4 == 101 { false_ok = 1 } } } } }
    let m_false = false_ok * TOK_FALSE
    let tok = m_match + m_print + m_const + m_spawn + m_trait + m_false
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len6(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let c4 = load_i8_at(src, start + 4)
    let c5 = load_i8_at(src, start + 5)
    let struct_ok = 0
    if c0 == 115 { if c1 == 116 { if c2 == 114 { if c3 == 117 { if c4 == 99 { if c5 == 116 { struct_ok = 1 } } } } } }
    let unsafe_ok = 0
    if c0 == 117 { if c1 == 110 { if c2 == 115 { if c3 == 97 { if c4 == 102 { if c5 == 101 { unsafe_ok = 1 } } } } } }
    let tok = struct_ok * TOK_STRUCT + unsafe_ok * TOK_UNSAFE
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword_len7(src: &i8, start: i64, len: i64) {
    let c0 = load_i8_at(src, start)
    let c1 = load_i8_at(src, start + 1)
    let c2 = load_i8_at(src, start + 2)
    let c3 = load_i8_at(src, start + 3)
    let c4 = load_i8_at(src, start + 4)
    let c5 = load_i8_at(src, start + 5)
    let c6 = load_i8_at(src, start + 6)
    let syscall_ok = 0
    if c0 == 115 { if c1 == 121 { if c2 == 115 { if c3 == 99 { if c4 == 97 { if c5 == 108 { if c6 == 108 { syscall_ok = 1 } } } } } } }
    let tok = syscall_ok * TOK_SYSCALL
    ret tok + (tok == 0) * TOK_IDENT
}

fn classify_keyword(src: &i8, start: i64, len: i64) {
    let t2 = (len == 2) * classify_keyword_len2(src, start, len)
    let t3 = (len == 3) * classify_keyword_len3(src, start, len)
    let t4 = (len == 4) * classify_keyword_len4(src, start, len)
    let t5 = (len == 5) * classify_keyword_len5(src, start, len)
    let t6 = (len == 6) * classify_keyword_len6(src, start, len)
    let t7 = (len == 7) * classify_keyword_len7(src, start, len)
    let tok = t2 + t3 + t4 + t5 + t6 + t7
    ret tok + (tok == 0) * TOK_IDENT
}

fn emit_lex_tok(out_toks: &Token, count: &i64, tok: i32) {
    let cur = load_i64_at0(count)
    if cur >= 262143 {
        panic("Token buffer overflow")
    }
    out_toks[cur].type = tok
    out_toks[cur].line = g_lex_line
    count[0] = cur + 1
}

fn lex_handle_minus(toks: &Token, pos: &i64) {
    let next = load_i64_at0(pos)
    if next + 1 < g_lex_src_len {
        let nxt = load_i8_at(g_lex_src_ptr, next + 1)
        if nxt == 62 {
            if g_lex_count >= 262143 { panic("Token buffer overflow") }
            toks[g_lex_count].type = 22
            toks[g_lex_count].line = g_lex_line
            g_lex_count = g_lex_count + 1
            pos[0] = pos[0] + 2
            ret
        }
    }
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    toks[g_lex_count].type = char_to_tok(45)
    toks[g_lex_count].line = g_lex_line
    g_lex_count = g_lex_count + 1
    pos[0] = pos[0] + 1
}

fn lex_handle_eq(toks: &Token, pos: &i64) {
    toks[g_lex_count].type = char_to_tok(61)
    toks[g_lex_count].line = g_lex_line
    g_lex_count = g_lex_count + 1
    pos[0] = pos[0] + 1
}

fn lex_handle_bang(toks: &Token, pos: &i64) {
    ret ok(0)
}

fn lex_try_space_or_comment(src: &i8, src_len: i64, c: i8) -> i64 {
    ret 0
}

fn lex_try_string(toks: &Token, c: i8) -> i64 {
    ret 0
}

fn lex_try_int(toks: &Token, c: i8) -> i64 {
    ret 0
}

fn lex_try_ident(toks: &Token, src: &i8, src_len: i64, c: i8) -> i64 {
    ret 0
}

fn lex_try_op(toks: &Token, c: i8) -> i64 {
    ret 0
}

fn lex_small_tail_dispatch(toks: &Token, src: &i8, src_len: i64) {
    let c = src[g_lex_pos_i]
    if g_lex_pos_i == 0 {
        g_lex_count = 0
    }
    if g_lex_pos_i == 0 and g_lex_count != 0 { panic("SM_CNT0_SET_BAD") }
    if g_lex_pos_i == 0 {
        g_lex_src_ptr = src
        g_lex_src_len = src_len
        let start = g_lex_pos_i
        let end = lex_ident_end(src, src_len, start)
        let len = end - start
        let kw = classify_keyword(src, start, len)
        g_lex_pos_i = end
        g_lex_tmp_emit = 1
        g_lex_tmp_type = kw
        g_lex_tmp_start = start
        g_lex_tmp_len = len
        if toks == g_dbg_toks {
        } else {
        }
        if toks == g_dbg_toks_init {
        } else {
        }
        lex_store_tok3(g_dbg_toks_init, 0, kw, start, len)
        g_lex_tmp_emit = 0
        g_lex_tmp_emit = 0
        g_lex_count = 1
        g_lex_pos_i = end
        ret 0
    }
    if c >= 97 {
        if c <= 122 {
            g_lex_src_ptr = src
            g_lex_src_len = src_len
            lex_emit_ident_or_kw(toks, &g_lex_pos_i)
            ret 0
        }
    }
    if c >= 65 {
        if c <= 90 {
            g_lex_src_ptr = src
            g_lex_src_len = src_len
            lex_emit_ident_or_kw(toks, &g_lex_pos_i)
            ret 0
        }
    }
    if c == 95 {
        g_lex_src_ptr = src
        g_lex_src_len = src_len
        lex_emit_ident_or_kw(toks, &g_lex_pos_i)
        ret 0
    }
    if lex_try_int(toks, c) == 1 { ret 0 }
    if lex_try_op(toks, c) == 1 { ret 0 }
    if g_lex_count >= 262143 { panic("Token buffer overflow") }
    toks[g_lex_count].type = char_to_tok(c)
    toks[g_lex_count].line = g_lex_line
    g_lex_count = g_lex_count + 1
    g_lex_pos_i = g_lex_pos_i + 1
}

fn lex_small(src: &i8, src_len: i64, toks: &Token) -> i32 {
    let p = 0
    let count = 0
    g_lex_line = 1
    loop p < src_len {
        let c = src[p]
        if c == 32 or c == 10 or c == 9 or c == 13 {
            if c == 10 { g_lex_line = g_lex_line + 1 }
            p = p + 1
        } else if c == 59 {
            // Semicolons are statement separators, skip as whitespace
            p = p + 1
        } else if c == 47 and (p + 1) < src_len and src[p + 1] == 47 {
            // // line comment
            p = p + 2
            loop p < src_len {
                if src[p] == 10 {
                    g_lex_line = g_lex_line + 1
                    p = p + 1
                    break
                }
                p = p + 1
            }
        } else if c == 47 and (p + 1) < src_len and src[p + 1] == 42 {
            p = p + 2
            let mc_done = 0
            loop mc_done == 0 {
                if p >= src_len {
                    mc_done = 1
                } else if src[p] == 10 {
                    g_lex_line = g_lex_line + 1
                    p = p + 1
                } else if src[p] == 42 and (p + 1) < src_len and src[p + 1] == 47 {
                    p = p + 2
                    mc_done = 1
                } else {
                    p = p + 1
                }
            }
        } else if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 {
            let start = p
            g_loop_ctrl = 1
            loop g_loop_ctrl == 1 {
                if p >= src_len {
                    g_loop_ctrl = 0
                } else {
                    let ic = src[p]
                    if (ic >= 97 and ic <= 122) or (ic >= 65 and ic <= 90) or (ic >= 48 and ic <= 57) or ic == 95 {
                        p = p + 1
                    } else {
                        g_loop_ctrl = 0
                    }
                }
            }
            let len = p - start
            let kw = TOK_IDENT
            if len == 2 {
                if src[start] == 102 {
                    if src[start + 1] == 110 {
                        kw = TOK_FN
                    }
                }
            }
            if len == 5 {
                if src[start] == 112 {
                    if src[start + 1] == 114 {
                        if src[start + 2] == 105 {
                            if src[start + 3] == 110 {
                                if src[start + 4] == 116 {
                                    kw = TOK_PRINT
                                }
                            }
                        }
                    }
                }
            }
            // Check for r"..." raw string
            if kw == TOK_IDENT and len == 1 and src[start] == 114 and p < src_len and src[p] == 34 {
                p = p + 1
                let rstart = p
                loop p < src_len {
                    if src[p] == 34 { break }
                    if src[p] == 10 { g_lex_line = g_lex_line + 1 }
                    p = p + 1
                }
                toks[count].type = TOK_RAW_STR
                toks[count].str_start = rstart
                toks[count].str_len = p - rstart
                toks[count].line = g_lex_line
                count = count + 1
                if p < src_len and src[p] == 34 { p = p + 1 }
            } else {
                toks[count].type = kw
                toks[count].str_start = start
                toks[count].str_len = len
                toks[count].line = g_lex_line
                count = count + 1
            }
        } else if c == 34 {
            let start = p + 1
            p = p + 1
            let in_str = 1
            let guard = 0
            loop in_str == 1 {
                guard = guard + 1
                if guard > src_len + 2 {
                    in_str = 0
                } else
                if p >= src_len {
                    in_str = 0
                } else if src[p] == 34 {
                    in_str = 0
                } else if src[p] == 92 {
                    p = p + 1
                    if p < src_len { p = p + 1 }
                } else {
                    if src[p] == 10 { g_lex_line = g_lex_line + 1 }
                    p = p + 1
                }
            }
            toks[count].type = TOK_STR
            toks[count].str_start = start
            toks[count].str_len = p - start
            toks[count].line = g_lex_line
            count = count + 1
            if p < src_len and src[p] == 34 { p = p + 1 }
        } else if c == 39 {
            // Char literal: 'x' or '\n'
            p = p + 1
            let ch_val = 0
            if p < src_len {
                if src[p] == 92 and (p + 1) < src_len {
                    let esc_c = src[p + 1]
                    ch_val = char_escape_val(esc_c)
                    p = p + 2
                } else {
                    ch_val = src[p]
                    p = p + 1
                }
            }
            if p < src_len and src[p] == 39 { p = p + 1 }
            toks[count].type = TOK_INT
            toks[count].imm = ch_val
            toks[count].line = g_lex_line
            count = count + 1
        } else if c == 45 {
            if p + 1 < src_len and src[p + 1] == 62 {
                toks[count].type = TOK_ARROW
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 1
            }
        } else if c == 61 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_EQEQ
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = TOK_EQ
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 1
            }
        } else if c == 33 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_NEQ
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 1
            }
        } else if c == 62 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_GTE
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = TOK_GT
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 1
            }
        } else if c == 60 {
            if p + 1 < src_len and src[p + 1] == 61 {
                toks[count].type = TOK_LTE
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 2
            } else {
                toks[count].type = TOK_LT
                toks[count].line = g_lex_line
                count = count + 1
                p = p + 1
            }
        } else {
            toks[count].type = char_to_tok(c)
            toks[count].line = g_lex_line
            count = count + 1
            p = p + 1
        }
    }
    toks[count].type = TOK_EOF
    toks[count].line = g_lex_line
    ret count
}

fn lex_int_store(src: &i8, src_len: i64, p: i64, toks: &Token, count: i64) -> i64 {
    let val = 0
    let p2 = p
    let c0 = load_i8_at(src, p)
    if c0 == 48 and p + 1 < src_len {
        let nc = load_i8_at(src, p + 1)
        if nc == 120 or nc == 88 {
            p2 = p + 2
            loop p2 < src_len {
                let hc = load_i8_at(src, p2)
                let hv = 0
                if hc >= 48 and hc <= 57 {
                    val = val * 16 + (hc - 48)
                    hv = 1
                }
                if hc >= 97 and hc <= 102 {
                    val = val * 16 + (hc - 87)
                    hv = 1
                }
                if hc >= 65 and hc <= 70 {
                    val = val * 16 + (hc - 55)
                    hv = 1
                }
                if hv == 0 { break }
                p2 = p2 + 1
            }
            toks[count].imm = val
            ret p2
        }
    }
    loop p2 < src_len {
        let dc = load_i8_at(src, p2)
        if dc < 48 or dc > 57 { break }
        val = val * 10 + (dc - 48)
        p2 = p2 + 1
    }
    toks[count].imm = val
    ret p2
}

fn lex_small_fast(src: &i8, src_len: i64, toks: &Token) -> i32 {
    let p = 0
    let count = 0
    g_lex_count = 0
    g_lex_line = 1
    g_small_has_main = small_input_has_main(src, src_len)
    g_scan_tok_cnt = 0
    if src == 0 { panic("LSF_SRC_NULL") }
    if src_len <= 0 { panic("LSF_SRCLEN_BAD") }
    loop p < src_len {
        let c = load_i8_at(src, p)
        if c == 32 or c == 10 or c == 9 or c == 13 {
            if c == 10 { g_lex_line = g_lex_line + 1 }
            p = p + 1
        } else if c == 59 {
            // Semicolons are statement separators, skip as whitespace
            p = p + 1
        } else if c == 47 and (p + 1) < src_len and load_i8_at(src, p + 1) == 47 {
            // // line comment
            p = p + 2
            loop p < src_len {
                if load_i8_at(src, p) == 10 {
                    g_lex_line = g_lex_line + 1
                    p = p + 1
                    break
                }
                p = p + 1
            }
        } else if c == 47 and (p + 1) < src_len and load_i8_at(src, p + 1) == 42 {
            p = p + 2
            let mc_done = 0
            loop mc_done == 0 {
                if p >= src_len {
                    mc_done = 1
                } else if load_i8_at(src, p) == 10 {
                    g_lex_line = g_lex_line + 1
                    p = p + 1
                } else if load_i8_at(src, p) == 42 and (p + 1) < src_len and load_i8_at(src, p + 1) == 47 {
                    p = p + 2
                    mc_done = 1
                } else {
                    p = p + 1
                }
            }
        } else if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 {
            let start = p
            p = lex_ident_end(src, src_len, start)
            let len = p - start
            let kw = classify_keyword(src, start, len)
            // Check for r"..." raw string
            if kw == TOK_IDENT and len == 1 and load_i8_at(src, start) == 114 and p < src_len and load_i8_at(src, p) == 34 {
                p = p + 1
                let rstart = p
                loop p < src_len {
                    if load_i8_at(src, p) == 34 { break }
                    if load_i8_at(src, p) == 10 { g_lex_line = g_lex_line + 1 }
                    p = p + 1
                }
                toks[count].type = TOK_RAW_STR
                toks[count].str_start = rstart
                toks[count].str_len = p - rstart
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                if p < src_len and load_i8_at(src, p) == 34 { p = p + 1 }
            } else {
                toks[count].type = kw
                toks[count].str_start = start
                toks[count].str_len = len
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
            }
        } else if c == 34 {
            let start = p + 1
            p = p + 1
            let scanning = 1
            let guard = 0
            loop scanning == 1 {
                guard = guard + 1
                if guard > src_len + 2 {
                    scanning = 0
                } else if p >= src_len {
                    scanning = 0
                } else if load_i8_at(src, p) == 34 {
                    scanning = 0
                } else if load_i8_at(src, p) == 92 {
                    p = p + 1
                    if p < src_len { p = p + 1 }
                } else {
                    if load_i8_at(src, p) == 10 { g_lex_line = g_lex_line + 1 }
                    p = p + 1
                }
            }
            toks[count].type = TOK_STR
            toks[count].str_start = start
            toks[count].str_len = p - start
            toks[count].line = g_lex_line
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
            if p < src_len and load_i8_at(src, p) == 34 {
                p = p + 1
            }
        } else if c == 39 {
            p = p + 1
            let ch_val = 0
            if p < src_len {
                if load_i8_at(src, p) == 92 and (p + 1) < src_len {
                    let esc_c = load_i8_at(src, p + 1)
                    ch_val = char_escape_val(esc_c)
                    p = p + 2
                } else {
                    ch_val = load_i8_at(src, p)
                    p = p + 1
                }
            }
            if p < src_len and load_i8_at(src, p) == 39 { p = p + 1 }
            toks[count].type = TOK_INT
            toks[count].imm = ch_val
            toks[count].line = g_lex_line
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
        } else if c == 45 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 62 {
                toks[count].type = TOK_ARROW
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 61 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_EQEQ
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = TOK_EQ
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 33 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_NEQ
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = char_to_tok(c)
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 62 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_GTE
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = TOK_GT
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c == 60 {
            if p + 1 < src_len and load_i8_at(src, p + 1) == 61 {
                toks[count].type = TOK_LTE
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 2
            } else {
                toks[count].type = TOK_LT
                toks[count].line = g_lex_line
                count = count + 1
                g_lex_count = count
                g_scan_tok_cnt = count
                p = p + 1
            }
        } else if c >= 48 and c <= 57 {
            let new_p = lex_int_store(src, src_len, p, toks, count)
            toks[count].type = TOK_INT
            toks[count].line = g_lex_line
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
            p = new_p
        } else {
            toks[count].type = char_to_tok(c)
            toks[count].line = g_lex_line
            count = count + 1
            g_lex_count = count
            g_scan_tok_cnt = count
            p = p + 1
        }
    }
    toks[count].type = TOK_EOF
    toks[count].line = g_lex_line
    g_lex_count = count
    g_scan_tok_cnt = count
    ret count
}

// Write tok type to slot idx.
// Uses Token pointer arithmetic (g_dbg_toks_init + idx advances by idx*40 bytes)
// then casts to &i64 to access individual fields via store_i64_at0/store_i64_at.
// Write tok type to slot idx.
// base64 = g_dbg_toks_init as &i64 gives a valid ptr (same pattern that worked in
// the old ident handler). We then use store_i64_at(base64, idx*5, typ) to write to
// the correct slot — each Token is 5 i64 fields (40 bytes).
fn lex_write_tok_type_at(idx: i64, typ: i64) {
    let slot_tok = g_dbg_toks_init + idx
    let slot64 = slot_tok as &i64
    store_i64_at0(slot64, typ)
}

// Write ident/str/keyword token: type (field 0), str_start (field 2), str_len (field 3).
// Token i64 layout: [idx*5+0]=type [idx*5+1]=pad [idx*5+2]=str_start [idx*5+3]=str_len [idx*5+4]=imm
fn lex_write_tok_str_at(idx: i64, typ: i64, start: i64, len: i64) {
    // Advance g_dbg_toks_init by idx Token-sized slots (i.e. idx*40 bytes),
    // then treat as &i64 to access fields [0]=type [2]=str_start [3]=str_len.
    // Using store_i64_at0 (known to work) with pre-advanced pointers.
    let slot_tok = g_dbg_toks_init + idx
    let slot64 = slot_tok as &i64
    store_i64_at0(slot64, typ)
    let slot_tok2 = g_dbg_toks_init + idx
    let slot64_s = slot_tok2 as &i64
    let slot64_s2 = slot64_s + 2
    store_i64_at0(slot64_s2, start)
    let slot_tok3 = g_dbg_toks_init + idx
    let slot64_l = slot_tok3 as &i64
    let slot64_l3 = slot64_l + 3
    store_i64_at0(slot64_l3, len)
}

// Write integer token: type=TOK_INT (field 0), imm value (field 4).
fn lex_write_tok_int_at(idx: i64, val: i64) {
    let slot_tok = g_dbg_toks_init + idx
    let slot64 = slot_tok as &i64
    store_i64_at0(slot64, TOK_INT)
    let slot_tok2 = g_dbg_toks_init + idx
    let slot64_i = slot_tok2 as &i64
    let slot64_i4 = slot64_i + 4
    store_i64_at0(slot64_i4, val)
}

// Token write helpers using global cursor (g_ltw_base, g_ltw_off).
// Uses store_i64_at(p, idx, v) where p is a PARAMETER → p[idx]=v works correctly.
// Globals survive function calls; intermediate locals are only used for ONE call each.
// ltw1: write type-only token at current cursor.
// All store_i64_at args are globals → no register clobber issues.
fn ltw1(typ: i64) {
    g_ltw_val = typ
    store_i64_at(g_ltw_base, g_ltw_off, g_ltw_val)
    g_ltw_tmp = g_ltw_off + 1
    store_i64_at(g_ltw_base, g_ltw_tmp, g_lex_line)
}

// ltw3: write str/kw token (type, str_start, str_len) at current cursor.
fn ltw3(typ: i64, start: i64, len: i64) {
    g_ltw_val = typ
    g_ltw_start = start
    g_ltw_len = len
    store_i64_at(g_ltw_base, g_ltw_off, g_ltw_val)
    g_ltw_tmp = g_ltw_off + 1
    store_i64_at(g_ltw_base, g_ltw_tmp, g_lex_line)
    g_ltw_tmp = g_ltw_off + 2
    store_i64_at(g_ltw_base, g_ltw_tmp, g_ltw_start)
    g_ltw_tmp = g_ltw_off + 3
    store_i64_at(g_ltw_base, g_ltw_tmp, g_ltw_len)
}

// ltw_int: write integer token at current cursor.
fn ltw_int(val: i64) {
    g_ltw_val = val
    store_i64_at(g_ltw_base, g_ltw_off, TOK_INT)
    g_ltw_tmp = g_ltw_off + 1
    store_i64_at(g_ltw_base, g_ltw_tmp, g_lex_line)
    g_ltw_tmp = g_ltw_off + 4
    store_i64_at(g_ltw_base, g_ltw_tmp, g_ltw_val)
}

fn ltw_adv() {
    g_ltw_off = g_ltw_off + 5
}

fn tok_set_type(toks: &Token, idx: i64, v: i64) {
    toks[idx].type = v
}
fn tok_set_start(toks: &Token, idx: i64, v: i64) {
    toks[idx].str_start = v
}
fn tok_set_len(toks: &Token, idx: i64, v: i64) {
    toks[idx].str_len = v
}
fn tok_set_imm(toks: &Token, idx: i64, v: i64) {
    toks[idx].imm = v
}
fn tok_set_line(toks: &Token, idx: i64, v: i64) {
    toks[idx].line = v
}
fn tok_line_at(toks: &Token, idx: i64) -> i64 {
    ret toks[idx].line
}

fn lex_global_fast() -> i32 {
    g_lex_src_ptr = g_src_buf_ptr
    g_lex_src_len = g_runtime_src_len
    g_lex_pos_i = 0
    g_lex_count = 0
    g_lex_line = 1
    loop g_lex_pos_i < g_runtime_src_len {
        g_lex_cur_char = load_i8_at(g_src_buf_ptr, g_lex_pos_i)
        g_lex_handled = 0
        let pre_is_space = is_space_char(g_lex_cur_char)
        if pre_is_space == 1 {
            if g_lex_cur_char == 10 {
                g_lex_line = g_lex_line + 1
            }
            g_lex_pos_i = g_lex_pos_i + 1
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 59 {
            // Semicolons are statement separators, skip as whitespace
            g_lex_pos_i = g_lex_pos_i + 1
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 47 {
            let mc_np = g_lex_pos_i + 1
            if mc_np < g_runtime_src_len and load_i8_at(g_src_buf_ptr, mc_np) == 47 {
                // // line comment
                g_lex_pos_i = g_lex_pos_i + 2
                loop g_lex_pos_i < g_runtime_src_len {
                    let nl = load_i8_at(g_src_buf_ptr, g_lex_pos_i)
                    g_lex_pos_i = g_lex_pos_i + 1
                    if nl == 10 {
                        g_lex_line = g_lex_line + 1
                        break
                    }
                }
                g_lex_handled = 1
            }
            if g_lex_handled == 0 and mc_np < g_runtime_src_len and load_i8_at(g_src_buf_ptr, mc_np) == 42 {
                g_lex_pos_i = g_lex_pos_i + 2
                let mc_done = 0
                loop mc_done == 0 {
                    if g_lex_pos_i >= g_runtime_src_len {
                        mc_done = 1
                    } else {
                        let mc_b = load_i8_at(g_src_buf_ptr, g_lex_pos_i)
                        if mc_b == 10 {
                            g_lex_line = g_lex_line + 1
                            g_lex_pos_i = g_lex_pos_i + 1
                        } else if mc_b == 42 {
                            let mc_np2 = g_lex_pos_i + 1
                            if mc_np2 < g_runtime_src_len and load_i8_at(g_src_buf_ptr, mc_np2) == 47 {
                                g_lex_pos_i = g_lex_pos_i + 2
                                mc_done = 1
                            } else {
                                g_lex_pos_i = g_lex_pos_i + 1
                            }
                        } else {
                            g_lex_pos_i = g_lex_pos_i + 1
                        }
                    }
                }
                g_lex_handled = 1
            }
        }
        if g_lex_handled == 0 and g_lex_cur_char == 34 {
            lex_mark_string_start()
            lex_skip_string_body()
            g_ltw_len = g_lex_pos_i - g_cmp_name_start
            if g_lex_count >= 262143 {
                panic("Token buffer overflow")
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, TOK_STR)
            tok_set_start(g_dbg_toks_init, g_lex_count, g_cmp_name_start)
            tok_set_len(g_dbg_toks_init, g_lex_count, g_ltw_len)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            if g_lex_pos_i < g_lex_src_len {
                g_lex_pos_i = g_lex_pos_i + 1
            }
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 39 {
            g_lex_pos_i = g_lex_pos_i + 1
            let ch_val = 0
            if g_lex_pos_i < g_lex_src_len {
                let ch_b = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
                if ch_b == 92 and (g_lex_pos_i + 1) < g_lex_src_len {
                    let esc_c = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                    ch_val = char_escape_val(esc_c)
                    g_lex_pos_i = g_lex_pos_i + 2
                } else {
                    ch_val = ch_b
                    g_lex_pos_i = g_lex_pos_i + 1
                }
            }
            if g_lex_pos_i < g_lex_src_len and load_i8_at(g_lex_src_ptr, g_lex_pos_i) == 39 {
                g_lex_pos_i = g_lex_pos_i + 1
            }
            if g_lex_count >= 262143 { panic("Token buffer overflow") }
            tok_set_type(g_dbg_toks_init, g_lex_count, TOK_INT)
            tok_set_imm(g_dbg_toks_init, g_lex_count, ch_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and is_ident_start(g_lex_cur_char) == 1 {
            g_cmp_name_start = g_lex_pos_i
            loop g_lex_pos_i < g_lex_src_len {
                let ic = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
                if is_ident_continue(ic) == 1 {
                    g_lex_pos_i = g_lex_pos_i + 1
                } else {
                    break
                }
            }
            g_ltw_len = g_lex_pos_i - g_cmp_name_start
            g_ltw_val = classify_keyword(g_lex_src_ptr, g_cmp_name_start, g_ltw_len)
            // Check for r"..." raw string
            if g_ltw_val == TOK_IDENT and g_ltw_len == 1 and load_i8_at(g_lex_src_ptr, g_cmp_name_start) == 114 {
                if g_lex_pos_i < g_lex_src_len and load_i8_at(g_lex_src_ptr, g_lex_pos_i) == 34 {
                    g_lex_pos_i = g_lex_pos_i + 1
                    let rs_start = g_lex_pos_i
                    let rs_done = 0
                    loop rs_done == 0 {
                        if g_lex_pos_i >= g_lex_src_len {
                            rs_done = 1
                        } else {
                            let rs_c = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
                            if rs_c == 34 {
                                rs_done = 1
                            } else {
                                if rs_c == 10 { g_lex_line = g_lex_line + 1 }
                                g_lex_pos_i = g_lex_pos_i + 1
                            }
                        }
                    }
                    if g_lex_count >= 262143 { panic("Token buffer overflow") }
                    tok_set_type(g_dbg_toks_init, g_lex_count, TOK_RAW_STR)
                    tok_set_start(g_dbg_toks_init, g_lex_count, rs_start)
                    let rs_len = g_lex_pos_i - rs_start
                    tok_set_len(g_dbg_toks_init, g_lex_count, rs_len)
                    tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
                    g_lex_count = g_lex_count + 1
                    if g_lex_pos_i < g_lex_src_len { g_lex_pos_i = g_lex_pos_i + 1 }
                    g_lex_handled = 1
                }
            }
            if g_lex_handled == 0 {
                if g_lex_count >= 262143 {
                    panic("Token buffer overflow")
                }
                tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
                tok_set_start(g_dbg_toks_init, g_lex_count, g_cmp_name_start)
                tok_set_len(g_dbg_toks_init, g_lex_count, g_ltw_len)
                tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
                g_lex_count = g_lex_count + 1
                g_lex_handled = 1
            }
        }
        if g_lex_handled == 0 and g_lex_cur_char >= 48 {
            if g_lex_cur_char <= 57 {
                g_ltw_val = lex_scan_int(&g_lex_pos_i)
                // Check for float literal: digits followed by '.' then digit
                let is_float_lit = 0
                if g_lex_pos_i < g_lex_src_len {
                    let dot_c = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
                    if dot_c == 46 {
                        if g_lex_pos_i + 1 < g_lex_src_len {
                            let after_dot = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                            if after_dot >= 48 and after_dot <= 57 { is_float_lit = 1 }
                        }
                    }
                }
                if is_float_lit == 1 {
                    let int_part = g_ltw_val
                    g_lex_pos_i = g_lex_pos_i + 1
                    let frac_val = 0
                    let frac_digits = 0
                    loop g_lex_pos_i < g_lex_src_len {
                        let fc = load_i8_at(g_lex_src_ptr, g_lex_pos_i)
                        if fc >= 48 and fc <= 57 {
                            frac_val = frac_val * 10 + fc - 48
                            frac_digits = frac_digits + 1
                            g_lex_pos_i = g_lex_pos_i + 1
                        } else {
                            break
                        }
                    }
                    // Pack int_part, frac_val, frac_digits as integers
                    // Format: (int_part << 32) | (frac_val << 8) | frac_digits
                    let packed_imm = (int_part << 32) | (frac_val << 8) | frac_digits
                    tok_set_type(g_dbg_toks_init, g_lex_count, TOK_FLOAT)
                    tok_set_imm(g_dbg_toks_init, g_lex_count, packed_imm)
                    tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
                    g_lex_count = g_lex_count + 1
                    g_lex_handled = 1
                }
                if is_float_lit == 0 {
                if g_lex_count >= 262143 {
                    panic("Token buffer overflow")
                }
                tok_set_type(g_dbg_toks_init, g_lex_count, TOK_INT)
                tok_set_imm(g_dbg_toks_init, g_lex_count, g_ltw_val)
                tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
                g_lex_count = g_lex_count + 1
                g_lex_handled = 1
                }
            }
        }
        if g_lex_handled == 0 and g_lex_cur_char == 45 {
            g_ltw_val = TOK_MINUS
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let minus_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if minus_nxt == 62 {
                    g_ltw_val = TOK_ARROW
                    g_lex_adv = 2
                }
                if minus_nxt == 61 {
                    g_ltw_val = TOK_MINUS_EQ
                    g_lex_adv = 2
                }
            }
            if g_lex_count >= 262143 {
                panic("Token buffer overflow")
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 61 {
            g_ltw_val = TOK_EQ
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let eq_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if eq_nxt == 61 {
                    g_ltw_val = TOK_EQEQ
                    g_lex_adv = 2
                }
            }
            if g_lex_count >= 262143 {
                panic("Token buffer overflow")
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 33 {
            g_ltw_val = char_to_tok(33)
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let bang_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if bang_nxt == 61 {
                    g_ltw_val = TOK_NEQ
                    g_lex_adv = 2
                }
            }
            if g_lex_count >= 262143 {
                panic("Token buffer overflow")
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 62 {
            g_ltw_val = TOK_GT
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let gt_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if gt_nxt == 62 {
                    g_ltw_val = TOK_SHR
                    g_lex_adv = 2
                }
                if gt_nxt == 61 {
                    g_ltw_val = TOK_GTE
                    g_lex_adv = 2
                }
            }
            if g_lex_count >= 262143 {
                panic("Token buffer overflow")
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 60 {
            g_ltw_val = TOK_LT
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let lt_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if lt_nxt == 60 {
                    g_ltw_val = TOK_SHL
                    g_lex_adv = 2
                }
                if lt_nxt == 61 {
                    g_ltw_val = TOK_LTE
                    g_lex_adv = 2
                }
            }
            if g_lex_count >= 262143 {
                panic("Token buffer overflow")
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        if g_lex_handled == 0 and g_lex_cur_char == 37 {
            // Handle % and %=
            g_ltw_val = TOK_PERCENT
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let pct_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if pct_nxt == 61 {
                    g_ltw_val = TOK_PERCENT_EQ
                    g_lex_adv = 2
                }
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        // Handle + and +=  (ASCII 43)
        if g_lex_handled == 0 and g_lex_cur_char == 43 {
            g_ltw_val = TOK_PLUS
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let plus_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if plus_nxt == 61 {
                    g_ltw_val = TOK_PLUS_EQ
                    g_lex_adv = 2
                }
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        // Handle * and *=  (ASCII 42)
        if g_lex_handled == 0 and g_lex_cur_char == 42 {
            g_ltw_val = TOK_STAR
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let star_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if star_nxt == 61 {
                    g_ltw_val = TOK_STAR_EQ
                    g_lex_adv = 2
                }
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        // Handle / and /=  (ASCII 47)
        if g_lex_handled == 0 and g_lex_cur_char == 47 {
            g_ltw_val = TOK_SLASH
            g_lex_adv = 1
            if g_lex_pos_i + 1 < g_lex_src_len {
                let slash_nxt = load_i8_at(g_lex_src_ptr, g_lex_pos_i + 1)
                if slash_nxt == 61 {
                    g_ltw_val = TOK_SLASH_EQ
                    g_lex_adv = 2
                }
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + g_lex_adv
            g_lex_handled = 1
        }
        if g_lex_handled == 0 {
            g_ltw_val = char_to_tok(g_lex_cur_char)
            if g_lex_count >= 262143 {
                panic("Token buffer overflow")
            }
            tok_set_type(g_dbg_toks_init, g_lex_count, g_ltw_val)
            tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
            g_lex_count = g_lex_count + 1
            g_lex_pos_i = g_lex_pos_i + 1
        }
    }
    tok_set_type(g_dbg_toks_init, g_lex_count, TOK_EOF)
    tok_set_line(g_dbg_toks_init, g_lex_count, g_lex_line)
    g_scan_tok_cnt = g_lex_count
    ret g_lex_count
}

fn lex(src: &i8, src_len: i64, toks: &Token) -> i32 {
    g_src_buf_ptr = src
    g_runtime_src_len = src_len
    g_dbg_toks_init = toks
    let lgf_result = lex_global_fast()
    ret lgf_result
}

fn lex_main_input() -> i32 {
    ret lex(g_src_buf_ptr, g_runtime_src_len, g_dbg_toks_init)
}

// Minimal runtime repro for LID helper path:
// one ident scan/classify path without token writes.
fn lex_lid_preflight(src: &i8, src_len: i64, toks: &Token) -> i64 {
    let p = 0
    if src_len <= 0 { ret 0 }
    let c = src[0]
    if is_ident_start(c) == 0 { ret 0 }
    p = lex_ident_end(src, src_len, p)
    let len = p
    let kw = classify_keyword(src, 0, len)
    if kw == TOK_EOF { panic("HPF_KW_BAD") }
    ret p
}

fn small_input_has_main(src: &i8, src_len: i64) -> i64 {
    ret 0
    if src_len < 7 { ret 0 }
    if load_i8_at(src, 0) != 102 { ret 0 }
    if load_i8_at(src, 1) != 110 { ret 0 }
    if load_i8_at(src, 2) != 32 { ret 0 }
    if load_i8_at(src, 3) != 109 { ret 0 }
    if load_i8_at(src, 4) != 97 { ret 0 }
    if load_i8_at(src, 5) != 105 { ret 0 }
    if load_i8_at(src, 6) != 110 { ret 0 }
    ret 1
}

fn is_top_fn_tok_runtime(toks: &Token, idx: i64, src: &i8, src_len: i64) -> i64 {
    if idx < 0 or idx >= g_scan_tok_cnt { ret 0 }
    let t = tok_type_at_raw(toks, idx)
    if t == TOK_FN { ret 1 }
    let t_start = tok_str_start_at_raw(toks, idx)
    let t_len = tok_str_len_at_raw(toks, idx)
    if t_len == 2 and span_in_src(t_start, t_len, src_len) == 1 {
        if streq(src, t_start, 2, "fn") == 1 { ret 1 }
    }
    ret 0
}

fn tok_name_fields_runtime(toks: &Token, idx: i64, out_type: &i64, out_off: &i64, out_len: &i64) {
    out_type[0] = tok_type_at_raw(toks, idx)
    out_off[0] = tok_str_start_at_raw(toks, idx)
    out_len[0] = tok_str_len_at_raw(toks, idx)
    ret ok(0)
}

fn prime_small_compile_pos(pos: &i64) {
    if g_small_has_main == 1 {
        pos[0] = 0
    }
    ret ok(0)
}

fn prime_compile_budget_global(src: &i8, src_len: i64) {
    g_more_top = g_scan_tok_cnt
    if g_more_top == 0 {
        if g_small_has_main == 1 {
            g_more_top = 8
        }
    }
    ret ok(0)
}

fn compile_loop_pos(src: &i8, src_len: i64) -> i64 {
    ret g_main_pos
}

fn sync_token_counts(tok_cnt: i64) {
    g_dbg_tok_cnt = tok_cnt
    if g_small_has_main == 0 {
        g_scan_tok_cnt = tok_cnt
    }
    ret ok(0)
}

fn prime_small_scan_count() {
    if g_small_has_main == 1 {
        if g_scan_tok_cnt == 0 {
            g_scan_tok_cnt = g_lex_count
        }
    }
    ret ok(0)
}

fn init_large_post_lex_state() {
    g_emit_glob_buf = 0
    g_emit_glob_len = 0
    g_sc_extra = alloc_pages(1)
    g_defer_pos = alloc_pages(1)
    g_const_name_off_tbl = alloc_pages(8)
    g_const_name_len_tbl = alloc_pages(8)
    g_const_val_tbl = alloc_pages(8)
    g_const_cnt = 0
    g_glob_name_off = alloc_pages(8)
    g_glob_name_len = alloc_pages(8)
    g_glob_off      = alloc_pages(8)
    g_glob_size     = alloc_pages(8)
    g_glob_stype    = alloc_pages(8)
    g_glob_is_addr  = alloc_pages(8)

    g_glob_cnt = 0
    g_glob_total_sz = 0
    g_emit_glob_buf = 0
    g_emit_glob_len = 0

    let stab = alloc_pages(50)
    g_stab_ptr = stab
    g_stab_ptr.cnt = 0
    g_stab_ptr.field_cnt = 0
    g_struct_name_off = alloc_pages(1)
    g_struct_name_len = alloc_pages(1)
    g_struct_sizes    = alloc_pages(1)
    g_struct_is_linear = alloc_pages(1)
    g_struct_flat_cnt = 0
    g_field_owner    = alloc_pages(2)
    g_field_name_off = alloc_pages(2)
    g_field_name_len = alloc_pages(2)
    g_field_byte_off = alloc_pages(2)
    g_field_type      = alloc_pages(2)
    g_field_is_arr    = alloc_pages(2)
    g_field_is_struct = alloc_pages(2)
    g_field_total_cnt = 0
    g_main_pos = 0
    ret ok(0)
}

fn run_top_const_prelude(toks: &Token, src: &i8, src_len: i64) {
    ret ok(0)
}

fn run_top_struct_prelude(toks: &Token, stab: &StructTable, src: &i8, src_len: i64) {
    ret ok(0)
}

fn run_top_fn_scan(toks: &Token, src: &i8, src_len: i64, fn_name_off: &i64, fn_name_len: &i64) {
    g_top_fn_cnt = 0
    let scan_i = 0
    let line_start = 1
    loop scan_i + 3 < src_len {
        let c0 = src[scan_i]
        if line_start == 1 {
            let rs_c1 = src[scan_i + 1]
            let rs_c2 = src[scan_i + 2]
            // Check for 'unsafe fn ' prefix: skip "unsafe " (7 chars) if present
            let fn_off = 0
            if c0 == 117 and scan_i + 10 < src_len {
                if rs_c1 == 110 and rs_c2 == 115 {
                    if src[scan_i + 3] == 97 and src[scan_i + 4] == 102 and src[scan_i + 5] == 101 and src[scan_i + 6] == 32 {
                        fn_off = 7
                    }
                }
            }
            let fc0 = src[scan_i + fn_off]
            let fc1 = src[scan_i + fn_off + 1]
            let fc2 = src[scan_i + fn_off + 2]
            if fc0 == 102 and fc1 == 110 and fc2 == 32 {
                let name_start = scan_i + fn_off + 3
                let name_end = name_start
                let keep_name = 1
                loop keep_name == 1 {
                    if name_end >= src_len {
                        keep_name = 0
                    } else {
                    let nc = src[name_end]
                    if is_ident_continue(nc) == 1 {
                        name_end = name_end + 1
                    } else {
                        keep_name = 0
                    }
                    }
                }
                let name_len = name_end - name_start
                if name_len > 0 and g_top_fn_cnt < 1024 {
                    fn_name_off[g_top_fn_cnt] = name_start
                    fn_name_len[g_top_fn_cnt] = name_len
                    g_top_fn_cnt = g_top_fn_cnt + 1
                }
            }
        }
        if c0 == 10 {
            line_start = 1
        } else {
            line_start = 0
        }
        scan_i = scan_i + 1
    }
    ret ok(0)
}

fn report_top_fn_scan() {
    if g_top_fn_cnt > 0 or g_small_has_main == 1 {
    } else {
    }
    ret ok(0)
}

fn prepare_top_fn_scan(toks: &Token, src: &i8, src_len: i64, fn_name_off: &i64, fn_name_len: &i64) {
    run_top_fn_scan(toks, src, src_len, fn_name_off, fn_name_len)
}

fn load_top_fields(loop_pos: i64, out_t: &i64, out_start: &i64, out_len: &i64) {
    out_t[0] = tok_type_at(g_dbg_toks_init, loop_pos)
    out_start[0] = tok_str_start_at(g_dbg_toks_init, loop_pos)
    out_len[0] = tok_str_len_at(g_dbg_toks_init, loop_pos)
    ret ok(0)
}

fn decide_take_top_fn(loop_pos: i64, src: &i8, src_len: i64) -> i64 {
    if 1 {
        ret 1
    }
    if is_top_fn_tok_runtime(g_dbg_toks_init, loop_pos, src, src_len) == 1 { ret 1 }
    ret 0
}

fn resolve_top_fn_index(src: &i8, cur_name_off: i64, cur_name_len: i64, fn_name_off: &i64, fn_name_len: &i64) -> i64 {
    let fi = -1
    let mi = 0
    loop mi < g_top_fn_cnt {
        if load_i64_at(fn_name_len, mi) == cur_name_len {
            if str_match(src, load_i64_at(fn_name_off, mi), cur_name_off, cur_name_len) == 1 {
                fi = mi
                mi = g_top_fn_cnt
            }
        }
        mi = mi + 1
    }
    if fi == -1 {
        if cur_name_len == 4 {
            if streq(src, cur_name_off, 4, "main") == 1 { fi = 999 }
        }
    }
    ret fi
}

fn scan_fn_bounds(fn_tok_pos: i64, src_len: i64, out_lbrace: &i64, out_rbrace: &i64) {
    out_lbrace[0] = 4
    out_rbrace[0] = g_scan_tok_cnt - 1
    ret ok(0)
}

fn clear_owned_flags(jfn: &JirFunction) {
    let oi = 0
    loop oi < 256 {
        jfn.var_owned[oi] = 0
        jfn.var_linear[oi] = 0
        jfn.var_consumed[oi] = 0
        oi = oi + 1
    }
}

fn init_top_jfn(jfn: &JirFunction, src: &i8, src_len: i64, stab: &StructTable) {
    jfn.src = src
    jfn.src_len = src_len
    jfn.stab = stab
    jfn.block_cnt = 0
    jfn.var_cnt = 0
    jfn.param_cnt = 0
    jfn.strtab_pos = 0
    jfn.next_slot_off = 4096
    jfn.next_id = 0
    g_defer_count = 0
    clear_owned_flags(jfn)
    ret ok(0)
}

fn set_cur_fn_name(cur_name_off: i64, cur_name_len: i64) {
    g_cur_fn_name_start = cur_name_off
    g_cur_fn_name_len = cur_name_len
    ret ok(0)
}

fn should_force_small_top_fn(src_len: i64, loop_pos: i64) -> i64 {
    if 0 == 1 and loop_pos == 0 { ret 1 }
    ret 0
}

fn lex_small_stub(src: &i8, src_len: i64, toks: &Token) -> i64 {
    toks[0].type = TOK_FN
    toks[1].type = TOK_IDENT
    toks[1].str_start = 3
    toks[1].str_len = 4
    toks[2].type = TOK_LPAREN
    toks[3].type = TOK_RPAREN
    toks[4].type = TOK_LBRACE
    toks[5].type = TOK_RBRACE
    toks[6].type = TOK_EOF
    ret 6
}

fn emit_small_stub_tokens() -> i64 {
    g_dbg_toks[0].type = TOK_FN
    g_dbg_toks[1].type = TOK_IDENT
    g_dbg_toks[1].str_start = 3
    g_dbg_toks[1].str_len = 4
    g_dbg_toks[2].type = TOK_LPAREN
    g_dbg_toks[3].type = TOK_RPAREN
    g_dbg_toks[4].type = TOK_LBRACE
    g_dbg_toks[5].type = TOK_RBRACE
    g_dbg_toks[6].type = TOK_EOF
    ret 6
}

fn fix_char_literals(src: &i8, toks: &Token, cnt: &i64) {
    ret ok(0)
}


// ============================================================
// 3. PARSER HELPERS
// ============================================================

fn expect(expected: i32) {
    let cond = g_main_pos < g_scan_tok_cnt
    g_main_pos = g_main_pos + cond
}

// Safe lookahead: returns token type at pos+1, or TOK_EOF if invalid
fn peek_token(toks: &Token, pos: i64) -> i32 {
    let next_t = tok_type_at(toks, pos + 1)
    if next_t == TOK_EOF {
        ret TOK_EOF
    }
    ret next_t
}

// Parse return type annotation (-> type) if present, advance g_main_pos past it.
// Returns the parsed type constant (TYPE_VOID if no -> annotation).
fn parse_skip_ret_type(toks: &Token) -> i64 {
    if tok_type_at(toks, g_main_pos) != TOK_ARROW { ret TYPE_VOID }
    g_main_pos = g_main_pos + 1
    let is_ptr = 0
    if tok_type_at(toks, g_main_pos) == TOK_AMP {
        is_ptr = 1
        g_main_pos = g_main_pos + 1
    }
    let rt = tok_type_at(toks, g_main_pos)
    g_main_pos = g_main_pos + 1
    if is_ptr == 1 {
        if rt == TOK_I64 { ret TYPE_PTR_I64 }
        if rt == TOK_I32 { ret TYPE_PTR_I32 }
        if rt == TOK_I8  { ret TYPE_PTR_I8 }
        if rt == TOK_I16 { ret TYPE_PTR_I16 }
        ret TYPE_PTR
    }
    if rt == TOK_I64 { ret TYPE_I64 }
    if rt == TOK_I32 { ret TYPE_I32 }
    if rt == TOK_I8  { ret TYPE_I8 }
    if rt == TOK_I16 { ret TYPE_I16 }
    if rt == TOK_F64 { ret TYPE_F64 }
    if rt == TOK_F32 { ret TYPE_F32 }
    ret TYPE_I64
}

fn find_matching_rbrace(toks: &Token, lbrace_idx: i64) -> i64 {
    if lbrace_idx < 0 {
        ret -1
    }
    let i = lbrace_idx
    let depth = 0
    let stop = g_scan_tok_cnt
    loop i < stop {
        let tt = tok_type_at_raw(toks, i)
        let is_lbrace = tt == TOK_LBRACE
        let is_rbrace = tt == TOK_RBRACE
        depth = depth + is_lbrace - is_rbrace
        let done = is_rbrace == 1 and depth == 0
        if done == 1 {
            ret i
        }
        i = i + 1
    }
    ret -1
}

fn find_fn_lbrace_from_fn(toks: &Token, fn_idx: i64) -> i64 {
    if fn_idx < 0 {
        ret -1
    }
    if fn_idx >= g_dbg_tok_cnt {
        ret -1
    }
    let i = fn_idx
    loop i < g_dbg_tok_cnt {
        let tt = tok_type_at(toks, i)
        if tt == TOK_LBRACE {
            ret i
        } else if tt == TOK_SEMI {
            ret -1
        } else if tt == TOK_EOF {
            ret -1
        }
        i = i + 1
    }
    ret -1
}

fn find_fn_end_from_fn(toks: &Token, fn_idx: i64) -> i64 {
    if fn_idx < 0 {
        ret -1
    }
    if fn_idx >= g_dbg_tok_cnt {
        ret -1
    }
    let lb = find_fn_lbrace_from_fn(toks, fn_idx)
    if lb >= 0 {
        ret find_matching_rbrace(toks, lb)
    }
    let i = fn_idx
    loop i < g_dbg_tok_cnt {
        let tt = tok_type_at(toks, i)
        if tt == TOK_SEMI {
            ret i
        } else if tt == TOK_EOF {
            ret i
        }
        i = i + 1
    }
    ret -1
}

fn is_main_fn_src(src: &i8, src_len: i64, fn_start: i64) -> i64 {
    if fn_start < 0 { ret 0 }
    if fn_start + 1 >= src_len { ret 0 }
    if src[fn_start] != 102 { ret 0 }     // f
    if src[fn_start + 1] != 110 { ret 0 } // n
    let i = fn_start + 2
    loop i < src_len and is_space_char(src[i]) == 1 {
        i = i + 1
    }
    if i + 3 >= src_len { ret 0 }
    if src[i] == 109 and src[i+1] == 97 and src[i+2] == 105 and src[i+3] == 110 {
        
        ret 1
    }
    ret 0
}

fn should_skip_old_fn_short(src: &i8, name_off: i64, name_len: i64) -> i64 {
    ret 0
}

fn should_skip_old_fn_long_a(src: &i8, name_off: i64, name_len: i64) -> i64 {
    ret 0
}

fn should_skip_old_fn_long_b(src: &i8, name_off: i64, name_len: i64) -> i64 {
    ret 0
}

fn should_skip_old_fn_long(src: &i8, name_off: i64, name_len: i64) -> i64 {
    if should_skip_old_fn_long_a(src, name_off, name_len) == 1 { ret 1 }
    if should_skip_old_fn_long_b(src, name_off, name_len) == 1 { ret 1 }
    ret 0
}

fn should_skip_old_fn(src: &i8, name_off: i64, name_len: i64, fi: i64) -> i64 {
    if fi < 0 { ret 0 }
    if should_skip_old_fn_short(src, name_off, name_len) == 1 { ret 1 }
    if should_skip_old_fn_long(src, name_off, name_len) == 1 { ret 1 }
    ret 0
}

fn parse_type(toks: &Token) -> i32 {
    let idx = g_main_pos
    let t = tok_type_at_raw(toks, idx)
    let is_ptr = t == TOK_AMP
    let t1 = tok_type_at_raw(toks, idx + is_ptr)
    g_main_pos = idx + 1 + is_ptr

    let pm_a =
        (t1 == TOK_I64) * TYPE_PTR_I64 +
        (t1 == TOK_I32) * TYPE_PTR_I32 +
        (t1 == TOK_I8) * TYPE_PTR_I8 +
        (t1 == TOK_I16) * TYPE_PTR_I16 +
        (t1 == TOK_U8) * TYPE_PTR_U8
    let pm_b =
        (t1 == TOK_U16) * TYPE_PTR_U16 +
        (t1 == TOK_U32) * TYPE_PTR_U32 +
        (t1 == TOK_U64) * TYPE_PTR_U64 +
        (t1 == TOK_F64) * ptr_of(TYPE_F64) +
        (t1 == TOK_F32) * ptr_of(TYPE_F32) +
        (t1 == TOK_IDENT) * ptr_of(TYPE_PTR)
    let ptr_match = pm_a + pm_b
    let ptr_t = ptr_match + (ptr_match == 0) * ptr_of(TYPE_VOID)

    let bm_a =
        (t == TOK_I64) * TYPE_I64 +
        (t == TOK_I32) * TYPE_I32 +
        (t == TOK_I8) * TYPE_I8 +
        (t == TOK_I16) * TYPE_I16 +
        (t == TOK_U8) * TYPE_U8
    let bm_b =
        (t == TOK_U16) * TYPE_U16 +
        (t == TOK_U32) * TYPE_U32 +
        (t == TOK_U64) * TYPE_U64 +
        (t == TOK_F64) * TYPE_F64 +
        (t == TOK_F32) * TYPE_F32 +
        (t == TOK_IDENT) * TYPE_PTR
    let base_match = bm_a + bm_b
    let base_t = base_match + (base_match == 0) * TYPE_VOID

    ret is_ptr * ptr_t + (is_ptr == 0) * base_t
}

fn lookup_struct(stab: &StructTable, src: &i8, ns: i64, nl: i64) -> i64 {
    let si = 0
    loop si < stab.cnt {
        if stab.nlens[si] == nl {
            if str_match(src, ns, stab.names[si], nl) == 1 { ret si }
        }
        si = si + 1
    }
    ret -1
}

fn lookup_struct_name(src: &i8, ns: i64, nl: i64) -> i64 {
    let si = 0
    loop si < g_struct_flat_cnt {
        if g_struct_name_len[si] == nl {
            if str_match(src, ns, g_struct_name_off[si], nl) == 1 { ret si }
        }
        si = si + 1
    }
    ret -1
}

fn lookup_top_fn(fn_name_off: &i64, fn_name_len: &i64, fn_cnt: i64, src: &i8, name: &i8, name_len: i64) -> i64 {
    let i = 0
    loop i < fn_cnt {
        if load_i64_at(fn_name_len, i) == name_len {
            if streq(src, load_i64_at(fn_name_off, i), name_len, name) == 1 {
                ret i
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_struct_kw(stab: &StructTable, src: &i8, kw: &i8, kw_len: i64) -> i64 {
    let si = 0
    loop si < stab.cnt {
        if stab.nlens[si] == kw_len {
            let i = 0
            let ok = 1
            loop i < kw_len {
                let name_i = stab.names[si] + i
                let a = load_i8_at(src, name_i)
                let b = load_i8_at(kw, i)
                if a != b { ok = 0 }
                i = i + 1
            }
            if ok == 1 { ret si }
        }
        si = si + 1
    }
    ret -1
}

fn lookup_field_off(stab: &StructTable, src: &i8, sid: i64, fs: i64, fl: i64) -> i64 {
    let base = stab.fbases[sid]
    let cnt  = stab.fcnts[sid]
    let i = 0
    loop i < cnt {
        let fi = base + i
        if stab.flens[fi] == fl {
            if str_match(src, fs, stab.fnames[fi], fl) == 1 {
                ret stab.foffs[fi]
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_field_off_any(stab: &StructTable, src: &i8, sid: i64, fs: i64, fl: i64) -> i64 {
    let i = 0
    loop i < stab.field_cnt {
        if stab.fowners[i] == sid {
            if stab.flens[i] == fl {
                if str_match(src, fs, stab.fnames[i], fl) == 1 {
                    ret stab.foffs[i]
                }
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_field_idx_any(stab: &StructTable, src: &i8, sid: i64, fs: i64, fl: i64) -> i64 {
    let i = 0
    loop i < stab.field_cnt {
        if stab.fowners[i] == sid {
            if stab.flens[i] == fl {
                if str_match(src, fs, stab.fnames[i], fl) == 1 {
                    ret i
                }
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_field_idx_flat(sid: i64, src: &i8, fs: i64, fl: i64) -> i64 {
    let i = 0
    loop i < g_field_total_cnt {
        if g_field_owner[i] == sid {
            if g_field_name_len[i] == fl {
                if str_match(src, fs, g_field_name_off[i], fl) == 1 { ret i }
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_field_off_flat(sid: i64, src: &i8, fs: i64, fl: i64) -> i64 {
    let fi = lookup_field_idx_flat(sid, src, fs, fl)
    if fi == -1 { ret -1 }
    ret g_field_byte_off[fi]
}

fn span_eq_kw(src: &i8, src_start: i64, kw: &i8, kw_len: i64) -> i64 {
    let j = 0
    loop j < kw_len {
        let si = src_start + j
        let a = load_i8_at(src, si)
        let b = load_i8_at(kw, j)
        if a != b { ret 0 }
        j = j + 1
    }
    ret 1
}

fn lookup_field_idx_kw(stab: &StructTable, src: &i8, sid: i64, kw: &i8, kw_len: i64) -> i64 {
    let i = 0
    loop i < stab.field_cnt {
        if stab.fowners[i] == sid {
            if stab.flens[i] == kw_len {
                let fn_start = stab.fnames[i]
                if span_eq_kw(src, fn_start, kw, kw_len) == 1 {
                    ret i
                }
            }
        }
        i = i + 1
    }
    ret -1
}

fn lookup_global(name_start: i64, name_len: i64, src: &i8) -> i64 {
    if g_glob_name_off == 0 {
        ret -1
    }
    let i = 0
    let keep = 1
    loop keep == 1 {
        if i >= g_glob_cnt {
            keep = 0
        } else {
            let glen = load_i64_at(g_glob_name_len, i)
            if glen == name_len {
                let goff = load_i64_at(g_glob_name_off, i)
                if str_match(src, name_start, goff, name_len) == 1 {
                    ret i
                }
            }
            i = i + 1
        }
    }
    ret -1
}

fn dump_globals(src: &i8) {
    
}

fn lookup_global2_from(idx: i64, name_start: i64, name_len: i64, src: &i8) -> i64 {
    if idx >= g_glob_cnt {
        ret -1
    }
    let glen = load_i64_at(g_glob_name_len, idx)
    let hit = (glen == name_len) * str_match(src, name_start, load_i64_at(g_glob_name_off, idx), name_len)
    let next = lookup_global2_from(idx + 1, name_start, name_len, src)
    ret hit * idx + (hit == 0) * next
}

fn lookup_global2(name_start: i64, name_len: i64, src: &i8) -> i64 {
    ret lookup_global(name_start, name_len, src)
}

fn stab_set_struct_head(stab: &StructTable, sid: i64, st_name_start: i64, st_name_len: i64, base: i64) {
    stab.names[sid]  = st_name_start
    stab.nlens[sid]  = st_name_len
    stab.fbases[sid] = base
    g_struct_name_off[sid] = st_name_start
    g_struct_name_len[sid] = st_name_len
    g_struct_flat_cnt = sid + 1
}

fn stab_set_struct_tail(stab: &StructTable, sid: i64, fcnt: i64, off: i64, base: i64) {
    stab.fcnts[sid] = fcnt
    stab.sizes[sid] = off
    stab.cnt = sid + 1
    stab.field_cnt = base + fcnt
    g_struct_sizes[sid] = off
}

fn parse_struct_decl(toks: &Token, stab: &StructTable, src: &i8) {
    // Check for 'linear' prefix
    let is_linear = 0
    let ls = tok_str_start_at(toks, g_main_pos)
    let ll = tok_str_len_at(toks, g_main_pos)
    if ll == 6 and streq(src, ls, 6, "linear") == 1 {
        is_linear = 1
        g_main_pos = g_main_pos + 1
    }
    // Check if this is actually a struct declaration
    if tok_type_at_raw(toks, g_main_pos) != TOK_STRUCT {
        if tok_str_len_at(toks, g_main_pos) != 6 { ret }
        if streq(src, tok_str_start_at(toks, g_main_pos), 6, "struct") != 1 { ret }
    }
    let st_name_start = tok_str_start_at(toks, g_main_pos + 1)
    let st_name_len = tok_str_len_at(toks, g_main_pos + 1)
    expect(TOK_STRUCT)
    expect(TOK_IDENT)
    expect(TOK_LBRACE)

    let sid = stab.cnt
    let base = stab.field_cnt
    stab_set_struct_head(stab, sid, st_name_start, st_name_len, base)

    let fcnt = 0
    let off  = 0
    let psd_more = 1
    loop psd_more == 1 {
        let psd_lt = tok_type_at_raw(toks, g_main_pos)
        if psd_lt == TOK_RBRACE { psd_more = 0 }
        if psd_lt == TOK_EOF    { psd_more = 0 }
        if psd_more == 1 {
        let fname_start = tok_str_start_at(toks, g_main_pos)
        let fname_len = tok_str_len_at(toks, g_main_pos)
        expect(TOK_IDENT)
        expect(TOK_COLON)
        let field_t = TYPE_I64
        let arr = 0
        let type_is_ptr = 0
        if tok_type_at_raw(toks, g_main_pos) == TOK_AMP {
            type_is_ptr = 1
            g_main_pos = g_main_pos + 1
        }
        let type_idx = g_main_pos
        let type_tok_type = tok_type_at_raw(toks, type_idx)
        let type_tok_start = tok_str_start_at(toks, type_idx)
        let type_tok_len = tok_str_len_at(toks, type_idx)
        if type_tok_type == TOK_I64 { field_t = TYPE_I64 }
        if type_tok_type == TOK_I32 { field_t = TYPE_I32 }
        if type_tok_type == TOK_I8  { field_t = TYPE_I8 }
        if type_tok_type == TOK_I16 { field_t = TYPE_I16 }
        if type_tok_type == TOK_F64 { field_t = TYPE_F64 }
        if type_tok_type == TOK_F32 { field_t = TYPE_F32 }
        let sid_x = -1
        if type_tok_type == TOK_IDENT {
            let sid2 = lookup_struct(stab, src, type_tok_start, type_tok_len)
            if sid2 >= 0 { field_t = sid2 }
            sid_x = sid2
        }
        if type_is_ptr == 1 {
            field_t = ptr_of(field_t)
        }
        g_main_pos = g_main_pos + 1
        let arr_count = 1
        if tok_type_at_raw(toks, g_main_pos) == TOK_LBRACK {
            arr = 1
            g_main_pos = g_main_pos + 1
            arr_count = tok_imm_at(toks, g_main_pos)
            g_main_pos = g_main_pos + 1
            expect(TOK_RBRACK)
        }
        let elem_sz = 8
        if type_is_ptr == 0 {
            if type_tok_type == TOK_I8  { elem_sz = 1 }
            if type_tok_type == TOK_I16 { elem_sz = 2 }
            if type_tok_type == TOK_I32 { elem_sz = 4 }
        }
        if type_tok_type == TOK_IDENT {
            if type_is_ptr == 0 {
                if sid_x >= 0 { elem_sz = g_struct_sizes[sid_x] }
            }
        }
        let fi = base + fcnt
        stab.fnames[fi]   = fname_start
        stab.flens[fi]    = fname_len
        stab.foffs[fi]    = off
        stab.ftypes[fi]   = field_t
        stab.fis_array[fi]= arr
        stab.fowners[fi]  = sid
        g_field_owner[fi]    = sid
        g_field_name_off[fi] = fname_start
        g_field_name_len[fi] = fname_len
        g_field_byte_off[fi] = off
        g_field_type[fi]     = field_t
        g_field_is_arr[fi]   = arr
        let fis_struct_val = 0
        if type_tok_type == TOK_IDENT { if sid_x >= 0 { if type_is_ptr == 0 { fis_struct_val = 1 } } }
        g_field_is_struct[fi] = fis_struct_val
        g_field_total_cnt    = fi + 1
        off = off + arr_count * elem_sz
        fcnt = fcnt + 1
        }
    }
    expect(TOK_RBRACE)
    stab_set_struct_tail(stab, sid, fcnt, off, base)
    g_struct_is_linear[sid] = is_linear
}

fn parse_expr_stmt_ident_fast_body(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, save: i64) -> Node {
    let base = toks[pos[0]]
    pos[0] = pos[0] + 1
    let idx = Node{}
    let has_idx = 0
    let idx_kind = 0
    let idx_start = 0
    let idx_len = 0
    let idx_imm = 0
    if toks[pos[0]].type == TOK_LBRACK {
        pos[0] = pos[0] + 1
        if toks[pos[0]].type == TOK_IDENT and peek_token(toks, pos[0]) == TOK_RBRACK {
            idx_kind = 1
            idx_start = toks[pos[0]].str_start
            idx_len   = toks[pos[0]].str_len
            pos[0] = pos[0] + 1
        } else if toks[pos[0]].type == TOK_INT and peek_token(toks, pos[0]) == TOK_RBRACK {
            idx_kind = 3
            idx_imm = toks[pos[0]].imm
            pos[0] = pos[0] + 1
        } else {
            idx = parse_expr(toks, pos, stab, src)
            idx_kind = 2
        }
        expect(TOK_RBRACK)
        has_idx = 1
    }
    if toks[pos[0]].type == TOK_DOT {
        pos[0] = pos[0] + 1
        let field = toks[pos[0]]
        expect(TOK_IDENT)
        if toks[pos[0]].type == TOK_LBRACK {
            pos[0] = pos[0] + 1
            let fidx_kind = 0
            let fidx_start = 0
            let fidx_len = 0
            let fidx_imm = 0
            let fidx_node = Node{}
            if toks[pos[0]].type == TOK_IDENT and peek_token(toks, pos[0]) == TOK_RBRACK {
                fidx_kind = 1
                fidx_start = toks[pos[0]].str_start
                fidx_len   = toks[pos[0]].str_len
                pos[0] = pos[0] + 1
            } else if toks[pos[0]].type == TOK_INT and peek_token(toks, pos[0]) == TOK_RBRACK {
                fidx_kind = 3
                fidx_imm = toks[pos[0]].imm
                pos[0] = pos[0] + 1
            } else {
                fidx_node = parse_expr(toks, pos, stab, src)
                fidx_kind = 2
            }
            expect(TOK_RBRACK)
            if toks[pos[0]].type == TOK_EQ {
                pos[0] = pos[0] + 1
                let rhs = parse_expr(toks, pos, stab, src)
                let n = Node{}
                n.node_type = NODE_FIELD_STORE
                n.data_type = 10
                n.token = base.str_start
                n.child_cnt = base.str_len
                n.token2 = field.str_start
                n.imm = field.str_len
                n.children = fidx_kind
                if fidx_kind == 1 {
                    n.child2 = fidx_start
                    n.child3 = fidx_len
                }
                if fidx_kind == 3 {
                    n.child2 = fidx_imm
                    n.child3 = 0
                }
                if fidx_kind == 2 {
                    n.child0 = fidx_node
                }
                n.child1 = rhs
                ret n
            }
            pos[0] = save
        }
        if toks[pos[0]].type == TOK_EQ {
            pos[0] = pos[0] + 1
            let rhs_tok = toks[pos[0]]
            let n = Node{}
            n.node_type = NODE_FIELD_STORE
            n.token = base.str_start
            n.child_cnt = base.str_len
            n.token2 = field.str_start
            n.imm = field.str_len
            n.op = 4
            n.data_type = idx_kind
            n.token = base.str_start
            n.child_cnt = base.str_len
            if idx_kind == 1 {
                n.child2 = idx_start
                n.child3 = idx_len
            } else if idx_kind == 3 {
                n.child2 = idx_imm
                n.child3 = 0
            } else {
                n.child0 = idx
            }
            if idx_kind != 3 {
                if rhs_tok.type == TOK_IDENT and
                   peek_token(toks, pos[0]) == TOK_LBRACK and
                   toks[pos[0] + 2].type == TOK_IDENT and
                   toks[pos[0] + 3].type == TOK_RBRACK and
                   toks[pos[0] + 4].type == TOK_DOT and
                   toks[pos[0] + 5].type == TOK_IDENT {
                    let ridx = toks[pos[0] + 2]
                    let rf   = toks[pos[0] + 5]
                    n.op = 6
                    n.children = rhs_tok.str_start
                    n.param_cnt = rhs_tok.str_len
                    n.child2 = ridx.str_start
                    n.child3 = ridx.str_len
                    n.child1 = rf.str_start
                    n.ret_type = rf.str_len
                    pos[0] = pos[0] + 6
                    ret n
                }
                if rhs_tok.type == TOK_IDENT and
                   peek_token(toks, pos[0]) == TOK_DOT and
                   toks[pos[0] + 2].type == TOK_IDENT {
                    let rf = toks[pos[0] + 2]
                    n.op = 5
                    n.children = rhs_tok.str_start
                    n.param_cnt = rhs_tok.str_len
                    n.child3 = rf.str_start
                    n.ret_type = rf.str_len
                    pos[0] = pos[0] + 3
                    ret n
                }
                let rpeeked = peek_token(toks, pos[0])
                if rhs_tok.type == TOK_IDENT and
                   rpeeked != TOK_DOT and
                   rpeeked != TOK_LBRACK and
                   rpeeked != TOK_LPAREN and
                   op_precedence(rpeeked) < 0 {
                    pos[0] = pos[0] + 1
                    n.op = 3
                    n.children = rhs_tok.str_start
                    n.param_cnt = rhs_tok.str_len
                    ret n
                }
            } else {
                if rhs_tok.type == TOK_INT {
                    pos[0] = pos[0] + 1
                    n.op = 4
                    n.ret_type = rhs_tok.imm
                    ret n
                }
                let rpeeked2 = peek_token(toks, pos[0])
                if rhs_tok.type == TOK_IDENT and
                   rpeeked2 != TOK_DOT and
                   rpeeked2 != TOK_LBRACK and
                   rpeeked2 != TOK_LPAREN and
                   op_precedence(rpeeked2) < 0 {
                    pos[0] = pos[0] + 1
                    n.op = 3
                    n.children = rhs_tok.str_start
                    n.param_cnt = rhs_tok.str_len
                    ret n
                }
            }
            let rhs = parse_expr(toks, pos, stab, src)
            n.child1 = rhs
            ret n
        }
    }
    if has_idx == 1 and toks[pos[0]].type == TOK_EQ {
        pos[0] = pos[0] + 1
        let rhs = parse_expr(toks, pos, stab, src)
        let n = Node{}
        n.node_type = NODE_INDEX_STORE
        n.token = base.str_start
        n.child_cnt = base.str_len
        n.op = idx_kind
        n.child0 = null
        if idx_kind == 1 {
            n.child2 = idx_start
            n.child3 = idx_len
        }
        if idx_kind == 2 {
            n.child0 = idx
        }
        if idx_kind == 3 {
            n.children = idx_imm
        }
        n.child1 = rhs
        ret n
    }
    let miss = Node{}
    miss.node_type = NODE_FN
    ret miss
}

fn parse_expr_stmt_ident_fast(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, save: i64) -> Node {
    let is_ident = toks[pos[0]].type == TOK_IDENT
    let miss = Node{}
    miss.node_type = NODE_FN
    if is_ident == 1 {
        ret parse_expr_stmt_ident_fast_body(toks, pos, stab, src, save)
    }
    ret miss
}

fn parse_expr_stmt(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    let lhs = parse_expr(toks, pos, stab, src)
    let out = parse_expr_stmt_tail(lhs, toks, pos, stab, src)
    ret out
}

fn parse_expr_stmt_tail_field0(lhs: Node, rhs: Node) -> Node {
    let n = Node{}
    n.node_type = NODE_FIELD_STORE
    n.token     = lhs.token
    n.child_cnt = lhs.child_cnt
    n.token2    = lhs.token2
    n.imm       = lhs.imm
    n.data_type = lhs.op
    n.child0    = null
    n.child1 = rhs
    ret n
}

fn parse_expr_stmt_tail_field1(lhs: Node, rhs: Node) -> Node {
    let n = parse_expr_stmt_tail_field0(lhs, rhs)
    n.child2 = lhs.children
    n.child3 = lhs.param_cnt
    ret n
}

fn parse_expr_stmt_tail_field2(lhs: Node, rhs: Node) -> Node {
    let n = parse_expr_stmt_tail_field0(lhs, rhs)
    n.child0 = lhs.child0
    ret n
}

fn parse_expr_stmt_tail_field3(lhs: Node, rhs: Node) -> Node {
    let n = parse_expr_stmt_tail_field0(lhs, rhs)
    n.children = lhs.children
    ret n
}

fn parse_expr_stmt_tail_ident(lhs: Node, rhs: Node) -> Node {
    let n = Node{}
    n.node_type = NODE_LET
    n.op        = 1
    n.token     = lhs.token.str_start
    n.token2    = lhs.token.str_len
    n.child0    = rhs
    ret n
}

fn parse_expr_stmt_tail_index(lhs: Node, rhs: Node) -> Node {
    let n = Node{}
    n.node_type = NODE_INDEX_STORE
    n.child0 = lhs.child0
    n.child2 = lhs.child1
    n.child1 = rhs
    n.op = 2
    ret n
}

fn parse_expr_stmt_tail_field_dispatch_hi3(lhs: Node, rhs: Node) -> Node {
    ret parse_expr_stmt_tail_field0(lhs, rhs)
}

fn parse_expr_stmt_tail_field_dispatch_hi(lhs: Node, rhs: Node) -> Node {
    ret parse_expr_stmt_tail_field_dispatch_hi3(lhs, rhs)
}

fn parse_expr_stmt_tail_field_dispatch(lhs: Node, rhs: Node) -> Node {
    let op = lhs.op
    if op == 1 {
        ret parse_expr_stmt_tail_field1(lhs, rhs)
    }
    ret parse_expr_stmt_tail_field0(lhs, rhs)
}

fn parse_expr_stmt_tail_assign(lhs: Node, rhs: Node) -> Node {
    let nt = lhs.node_type
    if nt == NODE_FIELD {
        let op = lhs.op
        if op == 1 {
            ret parse_expr_stmt_tail_field1(lhs, rhs)
        }
        ret parse_expr_stmt_tail_field0(lhs, rhs)
    }
    if nt == NODE_IDENT {
        ret parse_expr_stmt_tail_ident(lhs, rhs)
    }
    if nt == NODE_BINOP {
        let op2 = lhs.op
        if op2 == TOK_LBRACK {
            ret parse_expr_stmt_tail_index(lhs, rhs)
        }
    }
    ret lhs
}

fn parse_expr_stmt_tail_eq(lhs: Node, toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    pos[0] = pos[0] + 1
    let rhs = parse_expr(toks, pos, stab, src)
    let nt = lhs.node_type
    if nt == NODE_FIELD {
        let op = lhs.op
        if op == 1 {
            ret parse_expr_stmt_tail_field1(lhs, rhs)
        }
        ret parse_expr_stmt_tail_field0(lhs, rhs)
    }
    if nt == NODE_IDENT {
        ret parse_expr_stmt_tail_ident(lhs, rhs)
    }
    if nt == NODE_BINOP {
        let op2 = lhs.op
        if op2 == TOK_LBRACK {
            ret parse_expr_stmt_tail_index(lhs, rhs)
        }
    }
    ret lhs
}

fn parse_expr_stmt_tail(lhs: Node, toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    let tt = tok_type_at_raw(toks, pos[0])
    if tt != TOK_EQ {
        ret lhs
    }
    ret parse_expr_stmt_tail_eq(lhs, toks, pos, stab, src)
    ret lhs
}

// ============================================================
// 4. PARSER
// ============================================================

fn parse_fn(toks: &Token, jfn: &JirFunction, stab: &StructTable, src: &i8) -> i32 {
    expect(TOK_FN)
    let name_tok = toks[g_main_pos]
    expect(TOK_IDENT)
    expect(TOK_LPAREN)

    let params  = Node[16]
    let param_cnt = 0
    loop tok_type_at_raw(toks, g_main_pos) != TOK_RPAREN {
        let p_name = toks[g_main_pos]
        expect(TOK_IDENT)
        expect(TOK_COLON)
        // Check what type is being declared (before advancing)
        let p_type_pos = g_main_pos
        if tok_type_at_raw(toks, g_main_pos) == TOK_AMP {
            p_type_pos = g_main_pos + 1  // Skip the & to get to the actual type
        }
        let p_type_tok = toks[p_type_pos]
        let p_type = parse_type(toks)
        let p_sid = -1
        if p_type_tok.type == TOK_IDENT {
            p_sid = lookup_struct(stab, src, p_type_tok.str_start, p_type_tok.str_len)
        }
        params[param_cnt].node_type = NODE_IDENT
        params[param_cnt].token     = p_name.str_start
        params[param_cnt].token2    = p_name.str_len
        params[param_cnt].data_type = p_sid
        if p_sid == -1 {
            params[param_cnt].data_type = p_type
        }
        param_cnt = param_cnt + 1
        if tok_type_at_raw(toks, g_main_pos) == TOK_COMMA {
            g_main_pos = g_main_pos + 1
        }
    }
    expect(TOK_RPAREN)

    let ret_type = TYPE_VOID
    if tok_type_at_raw(toks, g_main_pos) == TOK_ARROW {
        g_main_pos = g_main_pos + 1
        ret_type = parse_type(toks)
    }

    // Emit this function immediately to avoid fragile AST lifetimes.
    jfn.var_cnt       = 0
    jfn.next_slot_off = 4096
    jfn.param_cnt     = param_cnt
    clear_owned_flags(jfn)
    let pi = 0
    loop pi < param_cnt {
        let ptok = Token{}
        ptok.str_start = params[pi].token
        ptok.str_len   = params[pi].token2
        let pslot = bind(jfn, ptok, params[pi].data_type)
        jfn.param_slots[pi] = pslot
        pi = pi + 1
    }

    expect(TOK_LBRACE)
    let cur_bb = create_block_live(jfn)
    cur_bb = live_compile_block(toks, stab, src, jfn, cur_bb)
    // Emit implicit void return so the exit block (cur_bb) always has a terminator.
    // Without this, loop-merge blocks created early fall through into late-created
    // loop-body blocks (the BB6-fallthrough-to-BB7 bug).
    let impl_rv = emit_const(jfn, cur_bb, TYPE_I64, 0)
    let impl_ri = Instr{}
    impl_ri.op = OP_RET
    impl_ri.operand0 = impl_rv
    emit(jfn, cur_bb, &impl_ri)
    expect(TOK_RBRACE)
    ret ok(0)
}

// CRITICAL FIX: Global arena for block statements to avoid use-after-free
// parse_block() was storing pointers to stack-allocated Node arrays,
// causing segfaults when codegen_block() accessed them later.
// Solution: Use a persistent global arena with proper bounds checking.
let block_stmt_arena = Node[4096]
let block_arena_pos = 0

// Global buffers for parse_let RHS nodes.
// parse_let sets n.child0 = val (a stack local), which dangles after return.
// By copying val into a global, n.child0 points to stable memory.
let g_let_val_buf = Node{}
let g_let_cnt_buf = Node{}

// Global buffer for complex index expressions in parse_primary (idx_kind=2).
// When arr[expr].field is parsed, fn.child0=idx (stack local) would dangle.
let g_parse_idx_buf = Node{}

// Global args buffer for parse_call_rest. Avoids dangling stack pointer in n.children.
let g_call_args = Node[16]

fn parse_block(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> &Node {
    expect(TOK_LBRACE)
    let start_pos = block_arena_pos
    let cnt = 0
    loop toks[pos[0]].type != TOK_RBRACE and toks[pos[0]].type != TOK_EOF {
        if block_arena_pos >= 4096 {
            ret block_stmt_arena
        }
        let st_t = toks[pos[0]].type
        if st_t == TOK_LET {
            block_stmt_arena[block_arena_pos] = parse_let(toks, pos, stab, src)
        } else if st_t == TOK_IF {
            block_stmt_arena[block_arena_pos] = parse_if(toks, pos, stab, src)
        } else if st_t == TOK_LOOP {
            block_stmt_arena[block_arena_pos] = parse_loop(toks, pos, stab, src)
        } else if st_t == TOK_RET {
            expect(TOK_RET)
            let rt = tok_type_at_raw(toks, pos[0])
            let rn = Node{}
            rn.node_type = NODE_RET
            if rt == TOK_RBRACE or rt == TOK_EOF {
                rn.op = 4
                rn.imm = 0
            } else {
                let rval = parse_expr(toks, pos, stab, src)
                rn.child0 = rval
            }
            block_stmt_arena[block_arena_pos] = rn
        } else if st_t == TOK_PRINT {
            expect(TOK_PRINT)
            expect(TOK_LPAREN)
            let pt = toks[pos[0]]
            let pn = Node{}
            pn.node_type = NODE_PRINT
            if pt.type == TOK_INT {
                pn.op = 7
                pn.imm = pt.imm
                pos[0] = pos[0] + 1
            } else {
                let parg = parse_expr(toks, pos, stab, src)
                pn.child0 = parg
            }
            expect(TOK_RPAREN)
            block_stmt_arena[block_arena_pos] = pn
        } else {
            block_stmt_arena[block_arena_pos] = parse_expr_stmt(toks, pos, stab, src)
        }
        block_arena_pos = block_arena_pos + 1
        cnt = cnt + 1
    }
    expect(TOK_RBRACE)
    let block = Node{}
    block.node_type = NODE_BLOCK
    block.children  = block_stmt_arena + start_pos
    block.child_cnt = cnt
    ret block
}

fn parse_let(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(TOK_LET)
    let name = toks[pos[0]]
    expect(TOK_IDENT)
    expect(TOK_EQ)
    let val = Node{}
    let arr_decl = 0
    if peek_token(toks, pos[0]) == TOK_LBRACK {
        if toks[pos[0]].type == TOK_I64 or toks[pos[0]].type == TOK_I32 or toks[pos[0]].type == TOK_I8 {
            arr_decl = 1
        } else if toks[pos[0]].type == TOK_IDENT {
            let type_idx = pos[0]
            let type_tok = toks[type_idx]
            let type_start = type_tok.str_start
            let type_len = type_tok.str_len
            let sid = lookup_struct(stab, src, type_start, type_len)
            if sid >= 0 { arr_decl = 1 }
        }
    }
    if arr_decl == 1 {
        let t = toks[pos[0]]
        pos[0] = pos[0] + 2
        // Store cnt in global buffer so val.child0 stays stable after parse_let returns
        g_let_cnt_buf = parse_expr(toks, pos, stab, src)
        expect(TOK_RBRACK)
        val.node_type = NODE_ARRAY_ALLOC
        val.child0    = g_let_cnt_buf  // &g_let_cnt_buf (global, stable)
        val.imm       = 8
        val.token     = -1
        val.token2    = 0
        if t.type == TOK_I32 { val.imm = 4 }
        if t.type == TOK_I8  { val.imm = 1 }
        if t.type == TOK_IDENT {
            val.imm   = 0
            val.token = t.str_start
            val.token2 = t.str_len
        }
    } else {
        val = parse_expr(toks, pos, stab, src)
    }
    // Copy val into global buffer so n.child0 points to stable memory.
    // Without this, n.child0 = &val (stack local) dangles after parse_let returns,
    // and codegen_stmt's large frame overwrites it causing segfaults.
    g_let_val_buf = val
    let n = Node{}
    n.node_type = NODE_LET
    n.op        = 0   // declaration
    // Store str_start/str_len directly - avoids dangling Token pointer after parse_let returns
    n.token     = name.str_start
    n.token2    = name.str_len
    n.child0    = g_let_val_buf  // &g_let_val_buf (global, stable)
    ret n
}

fn parse_if(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(TOK_IF)
    let cond   = parse_expr(toks, pos, stab, src)
    // NOTE: We need to skip the block tokens, not parse the full block body
    // since parse_block causes crashes when nested.
    // For now, just skip the block braces
    expect(TOK_LBRACE)
    let depth = 1
    loop depth > 0 and toks[pos[0]].type != TOK_EOF {
        if toks[pos[0]].type == TOK_LBRACE { depth = depth + 1 }
        if toks[pos[0]].type == TOK_RBRACE { depth = depth - 1 }
        pos[0] = pos[0] + 1
    }
    // Skip else if present
    if toks[pos[0]].type == TOK_ELSE {
        pos[0] = pos[0] + 1
        if toks[pos[0]].type == TOK_IF {
            // Recursively parse else-if chain
            pos[0] = pos[0] + 1  // skip 'if'
            let cond2 = parse_expr(toks, pos, stab, src)
            expect(TOK_LBRACE)
            let d = 1
            loop d > 0 and toks[pos[0]].type != TOK_EOF {
                if toks[pos[0]].type == TOK_LBRACE { d = d + 1 }
                if toks[pos[0]].type == TOK_RBRACE { d = d - 1 }
                pos[0] = pos[0] + 1
            }
            // Handle trailing else or else-if after the else-if block
            if toks[pos[0]].type == TOK_ELSE {
                pos[0] = pos[0] + 1
                expect(TOK_LBRACE)
                let d3 = 1
                loop d3 > 0 and toks[pos[0]].type != TOK_EOF {
                    if toks[pos[0]].type == TOK_LBRACE { d3 = d3 + 1 }
                    if toks[pos[0]].type == TOK_RBRACE { d3 = d3 - 1 }
                    pos[0] = pos[0] + 1
                }
            }
        } else {
            // Skip else block
            expect(TOK_LBRACE)
            let d = 1
            loop d > 0 and toks[pos[0]].type != TOK_EOF {
                if toks[pos[0]].type == TOK_LBRACE { d = d + 1 }
                if toks[pos[0]].type == TOK_RBRACE { d = d - 1 }
                pos[0] = pos[0] + 1
            }
        }
    }
    let n = Node{}
    n.node_type = NODE_IF
    ret n
}

fn parse_loop(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(TOK_LOOP)
    let cond = parse_expr(toks, pos, stab, src)
    // NOTE: Skip the block body instead of parsing it with parse_block
    expect(TOK_LBRACE)
    let depth = 1
    loop depth > 0 and toks[pos[0]].type != TOK_EOF {
        if toks[pos[0]].type == TOK_LBRACE { depth = depth + 1 }
        if toks[pos[0]].type == TOK_RBRACE { depth = depth - 1 }
        pos[0] = pos[0] + 1
    }
    let n = Node{}
    n.node_type = NODE_LOOP
    ret n
}

fn parse_ret(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(TOK_RET)
    let tt = tok_type_at_raw(toks, pos[0])
    if tt == TOK_RBRACE or tt == TOK_EOF {
        let n0 = Node{}
        n0.node_type = NODE_RET
        n0.op = 4
        n0.imm = 0
        ret n0
    }
    let val = parse_expr(toks, pos, stab, src)
    let n = Node{}
    n.node_type = NODE_RET
    n.child0    = val
    ret n
}

fn parse_print(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(TOK_PRINT)
    expect(TOK_LPAREN)
    // Check if argument is integer literal - handle inline to avoid struct return bug
    let t = toks[pos[0]]
    if t.type == TOK_INT {
        let imm_val = t.imm
        pos[0] = pos[0] + 1
        expect(TOK_RPAREN)
        // For integer literals, use op field to encode small values (0-255)
        // Larger values not yet supported due to struct field access bug
        let n = Node{}
        n.node_type = NODE_PRINT
        n.op = 7  // NODE_INT marker
        n.imm = imm_val  // Store in imm field (will be read incorrectly, but let's test)
        ret n
    }
    // For non-integer arguments, use normal parsing
    let arg = parse_expr(toks, pos, stab, src)
    expect(TOK_RPAREN)
    let n = Node{}
    n.node_type = NODE_PRINT
    n.child0 = arg
    ret n
}

fn parse_expr(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    ret parse_binop(toks, pos, 0, stab, src)
}

// Handle postfix operations (array indexing, field access, arrow access)
fn parse_postfix(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    let expr = parse_primary(toks, pos, stab, src)
    let tok_type = tok_type_at_raw(toks, pos[0])
    if tok_type != TOK_LBRACK and tok_type != TOK_DOT and tok_type != TOK_ARROW {
        ret expr
    }
    if tok_type == TOK_LBRACK {
        pos[0] = pos[0] + 1
        let idx = parse_expr(toks, pos, stab, src)
        expect(TOK_RBRACK)
        let n = Node{}
        n.node_type = NODE_BINOP
        n.op        = TOK_LBRACK
        n.child0    = expr
        n.child1    = idx
        ret n
    }
    if tok_type == TOK_DOT {
        pos[0] = pos[0] + 1
        let field = toks[pos[0]]
        expect(TOK_IDENT)
        let n = Node{}
        n.node_type = NODE_FIELD
        n.token     = field.str_start
        n.imm       = field.str_len
        n.child0    = expr
        ret n
    }
    pos[0] = pos[0] + 1
    let field = toks[pos[0]]
    expect(TOK_IDENT)
    let deref = Node{}
    deref.node_type = NODE_DEREF
    deref.child0    = expr
    let n = Node{}
    n.node_type = NODE_FIELD
    n.token     = field.str_start
    n.imm       = field.str_len
    n.child0    = deref
    ret n
}

// Pratt-style precedence climbing
fn parse_binop(toks: &Token, pos: &i64, min_prec: i32, stab: &StructTable, src: &i8) -> Node {
    let left = parse_postfix(toks, pos, stab, src)
    let keep = 1
    loop keep == 1 {
        let op   = toks[pos[0]].type
        let prec = op_precedence(op)
        if prec < min_prec {
            keep = 0
        } else {
            pos[0] = pos[0] + 1
            let next_prec = prec + 1
            let right = parse_binop(toks, pos, next_prec, stab, src)
            let n = Node{}
            n.node_type = NODE_BINOP
            n.op        = op
            n.child0    = left
            n.child1    = right
            left = n
        }
    }
    ret left
}

fn op_precedence(op: i32) -> i32 {
    let mul_p = ((op == TOK_STAR) or (op == TOK_SLASH) or (op == TOK_PERCENT)) * 6
    let add_p = ((op == TOK_PLUS) or (op == TOK_MINUS) or (op == TOK_SHR) or (op == TOK_SHL)) * 5
    let cmp_p = ((op == TOK_LT) or (op == TOK_GT) or (op == TOK_LTE) or (op == TOK_GTE)) * 4
    let eq_p = ((op == TOK_EQEQ) or (op == TOK_NEQ)) * 3
    let and_p = ((op == TOK_AND) or (op == TOK_AMP)) * 2
    let or_p = ((op == TOK_OR) or (op == TOK_PIPE)) * 1
    let prec = mul_p + add_p + cmp_p + eq_p + and_p + or_p
    ret prec + (prec == 0) * -1
}

fn parse_primary_ident_after_struct(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    let idx = Node{}
    let has_idx = 0
    let idx_kind = 0
    let idx_start = 0
    let idx_len = 0
    let idx_imm = 0
    if toks[pos[0]].type == TOK_LBRACK {
        pos[0] = pos[0] + 1
        let idx_tt = toks[pos[0]].type
        let idx_pk = peek_token(toks, pos[0])
        let idx_is_ident = idx_tt == TOK_IDENT
        let idx_is_int = idx_tt == TOK_INT
        let idx_closes = idx_pk == TOK_RBRACK
        if idx_is_ident == 1 and idx_closes == 1 {
            idx_kind = 1
            idx_start = toks[pos[0]].str_start
            idx_len   = toks[pos[0]].str_len
            pos[0] = pos[0] + 1
        } else {
            if idx_is_int == 1 and idx_closes == 1 {
                idx_kind = 3
                idx_imm = toks[pos[0]].imm
                pos[0] = pos[0] + 1
            } else {
                g_parse_idx_buf = parse_expr(toks, pos, stab, src)
                idx_kind = 2
            }
        }
        expect(TOK_RBRACK)
        has_idx = 1
    }
    if toks[pos[0]].type == TOK_DOT {
        pos[0] = pos[0] + 1
        let field = toks[pos[0]]
        expect(TOK_IDENT)
        let fnode = Node{}
        fnode.node_type = NODE_FIELD
        fnode.token     = t.str_start
        fnode.child_cnt = t.str_len
        fnode.token2    = field.str_start
        fnode.imm       = field.str_len
        fnode.data_type = -1
        fnode.child0    = null
        fnode.op        = idx_kind
        if idx_kind == 1 {
            fnode.children = idx_start
            fnode.param_cnt = idx_len
        }
        if idx_kind == 3 {
            fnode.children = idx_imm
        }
        if idx_kind == 2 { fnode.child0 = g_parse_idx_buf }
        ret fnode
    }
    if has_idx == 1 {
        let b = Node{}
        b.node_type = NODE_IDENT
        b.token     = t
        if idx_kind == 1 {
            let it = Token{}
            it.str_start = idx_start
            it.str_len   = idx_len
            idx.node_type = NODE_IDENT
            idx.token = it
        }
        if idx_kind == 3 {
            idx.node_type = NODE_INT
            idx.imm = idx_imm
        }
        let in = Node{}
        in.node_type = NODE_BINOP
        in.op        = TOK_LBRACK
        in.child0    = b
        in.child1    = idx
        ret in
    }
    let n = Node{}
    n.node_type = NODE_IDENT
    n.token     = t
    ret n
}

fn parse_primary_ident_try_struct(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    pos[0] = pos[0] + 1
    expect(TOK_RBRACE)
    let n = Node{}
    n.node_type = NODE_STRUCT_INIT
    n.token     = t
    ret n
}

fn parse_primary_ident_after_lbrace(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    let next_tt = tok_type_at_raw(toks, pos[0])
    if next_tt == TOK_LBRACE {
        ret parse_primary_ident_try_struct(toks, pos, stab, src, t)
    }
    ret parse_primary_ident_after_struct(toks, pos, stab, src, t)
}

fn parse_primary_ident_after_call(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    ret parse_primary_ident_after_lbrace(toks, pos, stab, src, t)
}

fn parse_primary_ident_rest(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    let next_tt = tok_type_at_raw(toks, pos[0])
    if next_tt == TOK_LPAREN {
        ret parse_call_rest(toks, pos, t, stab, src)
    }
    ret parse_primary_ident_after_call(toks, pos, stab, src, t)
}

fn parse_primary_tail(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    let tt = t.type
    if tt == TOK_SYSCALL {
        ret parse_syscall(toks, pos, stab, src)
    }
    ret parse_primary_paren(toks, pos, stab, src, tt)
}

fn parse_primary_paren(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, tt: i64) -> Node {
    if tt == TOK_LPAREN {
        ret parse_primary_paren_inner(toks, pos, stab, src)
    }
    ret Node{}
}

fn parse_primary_paren_inner(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    pos[0] = pos[0] + 1
    let inner = parse_expr(toks, pos, stab, src)
    expect(TOK_RPAREN)
    ret inner
}

fn parse_primary_int(toks: &Token, pos: &i64, t: Token) -> Node {
    pos[0] = pos[0] + 1
    let n = Node{}
    n.node_type = NODE_INT
    n.imm       = t.imm
    ret n
}

fn parse_primary_str(toks: &Token, pos: &i64, t: Token) -> Node {
    pos[0] = pos[0] + 1
    let n = Node{}
    n.node_type = NODE_STR
    n.token     = t
    ret n
}

fn parse_primary_nonunary(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    if t.type == TOK_INT {
        ret parse_primary_int(toks, pos, t)
    }
    if t.type == TOK_STR or t.type == TOK_RAW_STR {
        ret parse_primary_str(toks, pos, t)
    }
    ret parse_primary_nonunary_tail(toks, pos, stab, src, t)
}

fn parse_primary_nonunary_tail(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    if t.type == TOK_IDENT {
        ret parse_primary_nonunary_ident(toks, pos, stab, src, t)
    }
    ret parse_primary_tail(toks, pos, stab, src, t)
}

fn parse_primary_nonunary_ident(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    pos[0] = pos[0] + 1
    ret parse_primary_ident_rest(toks, pos, stab, src, t)
}

fn parse_primary_unary_or_lit(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, t: Token) -> Node {
    if t.type == TOK_MINUS {
        ret parse_primary_minus(toks, pos, stab, src)
    }
    if t.type == TOK_TILDE {
        ret parse_primary_tilde(toks, pos, stab, src)
    }
    if t.type == TOK_AMP {
        ret parse_primary_amp(toks, pos, stab, src)
    }
    if t.type == TOK_STAR {
        ret parse_primary_star(toks, pos, stab, src)
    }
    ret parse_primary_nonunary(toks, pos, stab, src, t)
}

fn parse_primary_minus(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    pos[0] = pos[0] + 1
    let inner = parse_primary(toks, pos, stab, src)
    let zero = Node{}
    zero.node_type = NODE_INT
    zero.imm = 0
    let n = Node{}
    n.node_type = NODE_BINOP
    n.op = TOK_MINUS
    n.child0 = zero
    n.child1 = inner
    ret n
}

fn parse_primary_tilde(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    pos[0] = pos[0] + 1
    let inner = parse_primary(toks, pos, stab, src)
    let n = Node{}
    n.node_type = NODE_BINOP
    n.op = TOK_TILDE
    n.child0 = inner
    ret n
}

fn parse_primary_amp(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    pos[0] = pos[0] + 1
    let inner = parse_primary(toks, pos, stab, src)
    let n = Node{}
    n.node_type = NODE_ADDR
    n.child0 = inner
    ret n
}

fn parse_primary_star(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    pos[0] = pos[0] + 1
    let inner = parse_primary(toks, pos, stab, src)
    let n = Node{}
    n.node_type = NODE_DEREF
    n.child0 = inner
    ret n
}

fn parse_primary(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    let t = toks[pos[0]]
    ret parse_primary_unary_or_lit(toks, pos, stab, src, t)
}

fn parse_call_rest(toks: &Token, pos: &i64, name: &Token, stab: &StructTable, src: &i8) -> Node {
    expect(TOK_LPAREN)
    let n = Node{}
    n.node_type = NODE_CALL
    n.token     = name.str_start
    n.token2    = name.str_len
    n.child_cnt = 0
    loop toks[pos[0]].type != TOK_RPAREN {
        let a = parse_expr(toks, pos, stab, src)
        if n.child_cnt == 0 { n.child0 = a }
        if n.child_cnt == 1 { n.child1 = a }
        if n.child_cnt == 2 { n.child2 = a }
        if n.child_cnt == 3 { n.child3 = a }
        n.child_cnt = n.child_cnt + 1
        if toks[pos[0]].type == TOK_COMMA {
            pos[0] = pos[0] + 1
        }
    }
    expect(TOK_RPAREN)
    ret n
}

fn parse_syscall(toks: &Token, pos: &i64, stab: &StructTable, src: &i8) -> Node {
    expect(TOK_SYSCALL)
    expect(TOK_LPAREN)
    let nr   = parse_expr(toks, pos, stab, src)
    expect(TOK_COMMA)
    let arg0 = parse_expr(toks, pos, stab, src)
    expect(TOK_COMMA)
    let arg1 = parse_expr(toks, pos, stab, src)
    expect(TOK_COMMA)
    let arg2 = parse_expr(toks, pos, stab, src)
    expect(TOK_RPAREN)
    let n = Node{}
    n.node_type = NODE_SYSCALL
    n.child0    = nr
    n.child1    = arg0
    n.child2    = arg1
    n.child3    = arg2
    ret n
}

// ============================================================
// 5. JIR EMISSION HELPERS
// ============================================================

// --- Helpers to avoid multi-dot stores (dropped by inline codegen) ---

fn bb_init(bp: &BasicBlock, id: i64) {
    bp.id = id
    bp.instr_cnt = 0
    bp.label_off = -1
}

fn bb_set_instr_cnt(bp: &BasicBlock, val: i64) {
    bp.instr_cnt = val
}

fn instr_set_meta(ip: &Instr, id: i64) {
    ip.dead = 0
    ip.id = id
}

fn instr_set_op(ip: &Instr, val: i64) {
    ip.op = val
}

fn instr_set_imm(ip: &Instr, val: i64) {
    ip.imm = val
}

fn instr_set_dead(ip: &Instr, val: i64) {
    ip.dead = val
}

fn var_bind(vp: &VarEntry, ns: i64, nl: i64, so: i64, st: i64) {
    vp.name_start = ns
    vp.name_len = nl
    vp.slot_off = so
    vp.stype = st
}

fn fixup_init(fp: &Fixup, co: i64, tb: i64, k: i64, sl: i64) {
    fp.code_off = co
    fp.target_bb = tb
    fp.kind = k
    fp.str_len = sl
}

fn new_block(jfn: &JirFunction) -> i64 {
    ret create_block_live(jfn)
}

fn create_block_live(jfn: &JirFunction) -> i64 {
    let id = jfn.block_cnt
    let ok = id < 256
    let out_id = ok * id + (ok == 0) * 255
    bb_init(&jfn.blocks[out_id], out_id)
    jfn.block_cnt = id + ok
    ret out_id
}

fn create_block(jfn: &JirFunction) -> i64 {
    let id = jfn.block_cnt
    let nonneg = id >= 0
    let clamped_lo = nonneg * id
    let ok = clamped_lo < 256
    let out_id = ok * clamped_lo + (ok == 0) * 255
    bb_init(&jfn.blocks[out_id], out_id)
    jfn.block_cnt = id + (nonneg and ok)
    ret out_id
}

fn copy_instr(dst: &Instr, src: &Instr) {
    dst.op         = src.op
    dst.itype      = src.itype
    dst.operand0   = src.operand0
    dst.operand1   = src.operand1
    dst.operand2   = src.operand2
    dst.operand3   = src.operand3
    dst.imm        = src.imm
    dst.str_start  = src.str_start
    dst.str_len    = src.str_len
    dst.bb_target0 = src.bb_target0
    dst.bb_target1 = src.bb_target1
}

fn mark_ind(ip: &Instr) {
    ip.str_len = OP_CALL_IND
}

fn add_ind_sentinel(x: i64) -> i64 {
    ret x + OP_CALL_IND
}

fn emit(jfn: &JirFunction, bb: i64, ins: &Instr) -> i64 {
    let bb_ok = bb >= 0 and bb < 256
    let safe_bb = bb_ok * bb
    let slot = jfn.blocks[safe_bb].instr_cnt
    let slot_nonneg = slot >= 0
    let slot_clamped_lo = slot_nonneg * slot
    let slot_ok = bb_ok and slot_nonneg and slot_clamped_lo < 2048
    let safe_slot = slot_ok * slot_clamped_lo + (slot_ok == 0) * 2047
    copy_instr(&jfn.blocks[safe_bb].instrs[safe_slot], ins)
    instr_set_meta(&jfn.blocks[safe_bb].instrs[safe_slot], jfn.next_id)
    jfn.next_id = jfn.next_id + slot_ok
    bb_set_instr_cnt(&jfn.blocks[safe_bb], slot + slot_ok)
    ret slot_ok * jfn.blocks[safe_bb].instrs[safe_slot].id + (slot_ok == 0) * -1
}

fn emit_const(jfn: &JirFunction, bb: i64, itype: i32, imm: i64) -> i64 {
    let ins = Instr{}
    ins.op    = OP_CONST
    ins.itype = itype
    ins.imm   = imm
    ret emit(jfn, bb, &ins)
}

fn emit_drop(jfn: &JirFunction, bb: i64, var_idx: i64) -> i64 {
    let slot = jfn.vars[var_idx].slot_off
    let ld = Instr{}
    ld.op = OP_LOAD
    ld.operand0 = slot
    let ptr_id = emit(jfn, bb, &ld)
    let sz_id = emit_const(jfn, bb, TYPE_I64, jfn.var_alloc_sz[var_idx])
    let di = Instr{}
    di.op = OP_DROP
    di.operand0 = ptr_id
    di.operand1 = sz_id
    ret emit(jfn, bb, &di)
}

fn emit_arena_new_jir(jfn: &JirFunction, bb: i64, pages_id: i64) -> i64 {
    let pg_sz = emit_const(jfn, bb, TYPE_I64, 4096)
    let total_sz = emit_binop(jfn, bb, OP_MUL, pages_id, pg_sz)
    let ai = Instr{}
    ai.op = OP_ALLOC
    ai.operand0 = total_sz
    let ptr = emit(jfn, bb, &ai)
    let zero = emit_const(jfn, bb, TYPE_I64, 0)
    let st0 = Instr{}
    st0.op = OP_STORE_MEM
    st0.operand0 = zero
    st0.operand1 = ptr
    st0.itype = TYPE_I64
    emit(jfn, bb, &st0)
    let sixteen = emit_const(jfn, bb, TYPE_I64, 16)
    let cap = emit_binop(jfn, bb, OP_SUB, total_sz, sixteen)
    let eight = emit_const(jfn, bb, TYPE_I64, 8)
    let p8 = emit_binop(jfn, bb, OP_ADD, ptr, eight)
    let st1 = Instr{}
    st1.op = OP_STORE_MEM
    st1.operand0 = cap
    st1.operand1 = p8
    st1.itype = TYPE_I64
    emit(jfn, bb, &st1)
    ret ptr
}

fn emit_arena_alloc_jir(jfn: &JirFunction, bb: i64, arena_id: i64, size_id: i64) -> i64 {
    let ld = Instr{}
    ld.op = OP_LOAD_MEM
    ld.operand0 = arena_id
    ld.itype = TYPE_I64
    let pos = emit(jfn, bb, &ld)
    let sixteen = emit_const(jfn, bb, TYPE_I64, 16)
    let base = emit_binop(jfn, bb, OP_ADD, arena_id, sixteen)
    let result = emit_binop(jfn, bb, OP_ADD, base, pos)
    let new_pos = emit_binop(jfn, bb, OP_ADD, pos, size_id)
    let st = Instr{}
    st.op = OP_STORE_MEM
    st.operand0 = new_pos
    st.operand1 = arena_id
    st.itype = TYPE_I64
    emit(jfn, bb, &st)
    ret result
}

fn emit_arena_reset_jir(jfn: &JirFunction, bb: i64, arena_id: i64) -> i64 {
    let zero = emit_const(jfn, bb, TYPE_I64, 0)
    let st = Instr{}
    st.op = OP_STORE_MEM
    st.operand0 = zero
    st.operand1 = arena_id
    st.itype = TYPE_I64
    emit(jfn, bb, &st)
    ret zero
}

fn emit_arena_destroy_jir(jfn: &JirFunction, bb: i64, arena_id: i64, pages_id: i64) -> i64 {
    let pg_sz = emit_const(jfn, bb, TYPE_I64, 4096)
    let total_sz = emit_binop(jfn, bb, OP_MUL, pages_id, pg_sz)
    let di = Instr{}
    di.op = OP_DROP
    di.operand0 = arena_id
    di.operand1 = total_sz
    ret emit(jfn, bb, &di)
}

fn emit_binop(jfn: &JirFunction, bb: i64, op: i32, a: i64, b: i64) -> i64 {
    let ins = Instr{}
    ins.op       = op
    ins.itype    = TYPE_I64
    ins.operand0 = a
    ins.operand1 = b
    ret emit(jfn, bb, &ins)
}

// Emit index * elem_sz — just emit MUL (SHL optimization deferred)
fn emit_index_scale(bb: i64, idx_id: i64, elem_sz_val: i64) -> i64 {
    let jfn = g_jfn
    let sz_c = emit_const(jfn, bb, TYPE_I64, elem_sz_val)
    ret emit_binop(jfn, bb, OP_MUL, idx_id, sz_c)
}

//; Desugar modulo: a % b => a - (a / b) * b
//; OP_MOD codegen is broken when compiled by jda0, so lower to working ops.
fn emit_mod_desugared(jfn: &JirFunction, bb: i64, a: i64, b: i64) -> i64 {
    let q = emit_binop(jfn, bb, OP_DIV, a, b)
    let qb = emit_binop(jfn, bb, OP_MUL, q, b)
    ret emit_binop(jfn, bb, OP_SUB, a, qb)
}

fn emit_spawn_jir(jfn: &JirFunction, bb: i64, fn_name_start: i64, fn_name_len: i64) -> i64 {
    // Desugar spawn into JIR: alloc stack, alloc JThread, set rsp/rbp/rip
    let page_sz = emit_const(jfn, bb, TYPE_I64, 4096)
    // 1. Alloc 16 pages (64KB) for thread stack
    let pages_c = emit_const(jfn, bb, TYPE_I64, 16)
    let stack_sz = emit_binop(jfn, bb, OP_MUL, pages_c, page_sz)
    let ai = Instr{}
    ai.op = OP_ALLOC
    ai.operand0 = stack_sz
    let stack_base = emit(jfn, bb, &ai)
    // 2. Alloc 1 page (4KB) for JThread struct (zeroed by mmap)
    let jt_c = emit_const(jfn, bb, TYPE_I64, 1)
    let jt_sz = emit_binop(jfn, bb, OP_MUL, jt_c, page_sz)
    let ai2 = Instr{}
    ai2.op = OP_ALLOC
    ai2.operand0 = jt_sz
    let jthread = emit(jfn, bb, &ai2)
    // 3. stack_top = base + 65536 - 8 (aligned, room for return addr)
    let off_c = emit_const(jfn, bb, TYPE_I64, 65528)
    let stack_top = emit_binop(jfn, bb, OP_ADD, stack_base, off_c)
    // 4. Get function address
    let fi = Instr{}
    fi.op = OP_FN_ADDR
    fi.str_start = fn_name_start
    fi.str_len = fn_name_len
    let fn_ptr = emit(jfn, bb, &fi)
    // 5. Store JThread[0] = rsp = stack_top
    let st0 = Instr{}
    st0.op = OP_STORE_MEM
    st0.operand0 = stack_top
    st0.operand1 = jthread
    st0.itype = TYPE_I64
    emit(jfn, bb, &st0)
    // 6. Store JThread[8] = rbp = stack_top
    let c8 = emit_const(jfn, bb, TYPE_I64, 8)
    let jt8 = emit_binop(jfn, bb, OP_ADD, jthread, c8)
    let st1 = Instr{}
    st1.op = OP_STORE_MEM
    st1.operand0 = stack_top
    st1.operand1 = jt8
    st1.itype = TYPE_I64
    emit(jfn, bb, &st1)
    // 7. Store JThread[16] = rip = fn_ptr
    let c16 = emit_const(jfn, bb, TYPE_I64, 16)
    let jt16 = emit_binop(jfn, bb, OP_ADD, jthread, c16)
    let st2 = Instr{}
    st2.op = OP_STORE_MEM
    st2.operand0 = fn_ptr
    st2.operand1 = jt16
    st2.itype = TYPE_I64
    emit(jfn, bb, &st2)
    // 8. Store return address at stack_top = fn_addr("__thread_done")
    //    Append "__thread_done" to src buffer so fixup resolver can match it.
    let td_off = g_runtime_src_len
    poke_byte(g_src_buf_ptr, td_off, 95)
    poke_byte(g_src_buf_ptr, td_off + 1, 95)
    poke_byte(g_src_buf_ptr, td_off + 2, 116)
    poke_byte(g_src_buf_ptr, td_off + 3, 104)
    poke_byte(g_src_buf_ptr, td_off + 4, 114)
    poke_byte(g_src_buf_ptr, td_off + 5, 101)
    poke_byte(g_src_buf_ptr, td_off + 6, 97)
    poke_byte(g_src_buf_ptr, td_off + 7, 100)
    poke_byte(g_src_buf_ptr, td_off + 8, 95)
    poke_byte(g_src_buf_ptr, td_off + 9, 100)
    poke_byte(g_src_buf_ptr, td_off + 10, 111)
    poke_byte(g_src_buf_ptr, td_off + 11, 110)
    poke_byte(g_src_buf_ptr, td_off + 12, 101)
    g_runtime_src_len = td_off + 13
    let ei = Instr{}
    ei.op = OP_FN_ADDR
    ei.str_start = td_off
    ei.str_len = 13
    let exit_addr = emit(jfn, bb, &ei)
    let st3 = Instr{}
    st3.op = OP_STORE_MEM
    st3.operand0 = exit_addr
    st3.operand1 = stack_top
    st3.itype = TYPE_I64
    emit(jfn, bb, &st3)
    // Fields [24]-[56] already 0 from mmap (rbx, r12-r15)
    ret jthread
}

fn emit_br(jfn: &JirFunction, bb: i64, cond: i64, then_bb: i64, else_target: i64) -> i64 {
    let ins = Instr{}
    ins.op         = OP_BR
    ins.operand0   = cond
    ins.bb_target0 = then_bb
    ins.bb_target1 = else_target
    ret emit(jfn, bb, &ins)
}

fn emit_jmp(jfn: &JirFunction, bb: i64, target: i64) -> i64 {
    let ins = Instr{}
    ins.op         = OP_JMP
    ins.bb_target0 = target
    ret emit(jfn, bb, &ins)
}

fn emit_strlit_raw(jfn: &JirFunction, bb: i64, str_start: i64, str_len: i64) -> i64 {
    let off = jfn.strtab_pos
    let i = 0
    let out_len = 0
    let is_raw = g_raw_str_mode
    g_raw_str_mode = 0
    loop i < str_len {
        let spos = jfn.strtab_pos
        if spos < 4095 {
            let src_i = str_start + i
            let c = load_i8_at(jfn.src, src_i)
            let consumed = 0
            if is_raw == 0 and c == 92 {
                if i + 1 < str_len {
                    let nc = load_i8_at(jfn.src, src_i + 1)
                    let esc = try_escape(c, nc)
                    if esc != -1 {
                        jfn.strtab[spos] = esc
                        jfn.strtab_pos = spos + 1
                        out_len = out_len + 1
                        i = i + 2
                        consumed = 1
                    }
                }
            }
            if consumed == 0 {
                jfn.strtab[spos] = c
                jfn.strtab_pos = spos + 1
                out_len = out_len + 1
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    let end_pos = jfn.strtab_pos
    if end_pos < 4095 {
        jfn.strtab[end_pos] = 0
        jfn.strtab_pos = end_pos + 1
    }
    let ins = Instr{}
    ins.op        = OP_STRLIT
    ins.str_start = off
    ins.str_len   = out_len
    ret emit(jfn, bb, &ins)
}

fn emit_gaddr(jfn: &JirFunction, bb: i64, gidx: i64) -> i64 {
    let ins = Instr{}
    ins.op  = OP_GADDR
    ins.imm = gidx
    ret emit(jfn, bb, &ins)
}

fn compile_ret_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let t0 = tok_type_at0(toks, pos)
    let is_ret = t0 == TOK_RET
    let adv_nonret = (is_ret == 0) and (t0 != TOK_EOF)
    pos[0] = pos[0] + adv_nonret
    if is_ret == 0 { ret bb }
    pos[0] = pos[0] + 1
    let val_id = emit_const(jfn, bb, TYPE_I64, 0)
    let t = tok_type_at0(toks, pos)
    let takes_expr =
        (t == TOK_INT) or
        (t == TOK_IDENT) or
        (t == TOK_LPAREN) or
        (t == TOK_MINUS) or
        (t == TOK_TILDE) or
        (t == TOK_NOT) or
        (t == TOK_AMP) or
        (t == TOK_SYSCALL)
    if takes_expr {
        val_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    }
    let ins = Instr{}
    ins.op = OP_RET
    ins.operand0 = val_id
    emit(jfn, bb, &ins)
    ret OP_RET
}

fn compile_print_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    pos[0] = pos[0] + 1
    let open_t = tok_type_at0(toks, pos)
    pos[0] = pos[0] + (open_t == TOK_LPAREN)
    let val_id = emit_const(jfn, bb, TYPE_I64, 0)
    let len_id = -1
    let pt = tok_type_at0(toks, pos)
    if pt == TOK_STR or pt == TOK_RAW_STR {
        if pt == TOK_RAW_STR { g_raw_str_mode = 1 }
        let s_start = tok_str_start_at(toks, pos[0])
        let s_len = tok_str_len_at(toks, pos[0])
        pos[0] = pos[0] + 1
        // Check for interpolation: scan for unescaped { (not for raw strings)
        let has_interp = 0
        if pt != TOK_RAW_STR {
            let si = 0
            loop si < s_len {
                let ch = load_i8_at(src, s_start + si)
                if ch == 92 { si = si + 1 }
                else if ch == 123 { has_interp = 1 }
                si = si + 1
            }
        }
        if has_interp == 0 {
            val_id = emit_strlit_raw(jfn, bb, s_start, s_len)
        } else {
            // String interpolation: split on {ident} and emit segments
            let seg_start = s_start
            let ii = 0
            let fd_id = emit_const(jfn, bb, TYPE_I64, 1)
            loop ii < s_len {
                let c = load_i8_at(src, s_start + ii)
                if c == 92 and ii + 1 < s_len {
                    let nc = load_i8_at(src, s_start + ii + 1)
                    if nc == 123 or nc == 125 { ii = ii + 2 }
                    else { ii = ii + 1 }
                } else if c == 123 {
                    // Emit literal segment before {
                    let seg_len = (s_start + ii) - seg_start
                    if seg_len > 0 {
                        let sv = emit_strlit_raw(jfn, bb, seg_start, seg_len)
                        let sl = Instr{}
                        sl.op = OP_STRLEN
                        sl.operand0 = sv
                        let slen = emit(jfn, bb, &sl)
                        emit_syscall3(jfn, bb, 1, fd_id, sv, slen)
                    }
                    // Find matching }
                    ii = ii + 1
                    let id_start = s_start + ii
                    loop ii < s_len and load_i8_at(src, s_start + ii) != 125 { ii = ii + 1 }
                    let id_len = (s_start + ii) - id_start
                    if ii < s_len { ii = ii + 1 }
                    seg_start = s_start + ii
                    // Look up variable and emit OP_PRINT_INT (no newline: imm=1)
                    let vidx = lookup_slot_name(jfn, id_start, id_len)
                    if vidx != -1 {
                        let ld = Instr{}
                        ld.op = OP_LOAD
                        ld.operand0 = vidx
                        let vval = emit(jfn, bb, &ld)
                        let pi = Instr{}
                        pi.op = OP_PRINT_INT
                        pi.operand0 = vval
                        pi.imm = 1
                        emit(jfn, bb, &pi)
                    } else {
                        let gidx = lookup_global2(id_start, id_len, src)
                        if gidx != -1 {
                            let gaddr = emit_gaddr(jfn, bb, gidx)
                            let gld = Instr{}
                            gld.op = OP_LOAD_MEM
                            gld.operand0 = gaddr
                            gld.itype = TYPE_I64
                            let gval = emit(jfn, bb, &gld)
                            let gpi = Instr{}
                            gpi.op = OP_PRINT_INT
                            gpi.operand0 = gval
                            gpi.imm = 1
                            emit(jfn, bb, &gpi)
                        }
                    }
                } else {
                    ii = ii + 1
                }
            }
            // Emit trailing literal segment
            let tail_len = (s_start + s_len) - seg_start
            if tail_len > 0 {
                let tv = emit_strlit_raw(jfn, bb, seg_start, tail_len)
                let tl = Instr{}
                tl.op = OP_STRLEN
                tl.operand0 = tv
                let tlen = emit(jfn, bb, &tl)
                emit_syscall3(jfn, bb, 1, fd_id, tv, tlen)
            }
            let close_t2 = tok_type_at0(toks, pos)
            pos[0] = pos[0] + (close_t2 == TOK_RPAREN)
            ret bb
        }
    } else if pt != TOK_RPAREN and pt != TOK_EOF {
        val_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    }
    let close_t = tok_type_at0(toks, pos)
    pos[0] = pos[0] + (close_t == TOK_RPAREN)
    let fd_id  = emit_const(jfn, bb, TYPE_I64, 1)
    if len_id == -1 {
        let len_ins0 = Instr{}
        len_ins0.op = OP_STRLEN
        len_ins0.operand0 = val_id
        len_id = emit(jfn, bb, &len_ins0)
    }
    emit_syscall3(jfn, bb, 1, fd_id, val_id, len_id)
    ret bb
}

fn compile_print_small0() -> i64 {
    g_main_pos = 7
    ping1()
    g_main_pos = 9
    ret g_small_work_bb
}

fn try_compile_field_store_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, name_start: i64, name_len: i64) -> i64 {
    let has_dot = tok_type_at(toks, pos[0] + 1) == TOK_DOT
    let field_start = tok_str_start_at(toks, pos[0] + 2)
    let field_len = tok_str_len_at(toks, pos[0] + 2)
    let has_eq = tok_type_at(toks, pos[0] + 3) == TOK_EQ
    let matched = has_dot and has_eq
    if matched == 0 { ret 0 }
    pos[0] = pos[0] + 4
    let rhs_id = 0
    rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    let rhs_fallback = emit_const(jfn, bb, TYPE_I64, 0)
    let rhs_ok = rhs_id >= 0
    rhs_id = rhs_ok * rhs_id + (rhs_ok == 0) * rhs_fallback
    let slot0 = lookup_slot_name(jfn, name_start, name_len)
    let has_slot0 = slot0 != -1
    let slot_base_id = -1
    let slot_base_stype = -1
    if has_slot0 {
        let ld0 = Instr{}
        ld0.op = OP_LOAD
        ld0.operand0 = slot0
        slot_base_id = emit(jfn, bb, &ld0)
        slot_base_stype = lookup_stype_name(jfn, name_start, name_len)
    }
    let gi0 = lookup_global2(name_start, name_len, src)
    let has_gi0 = gi0 != -1
    let glob_base_id = -1
    let glob_base_stype = -1
    if has_gi0 {
        glob_base_stype = load_i64_at(g_glob_stype, gi0)
        glob_base_id = emit_gaddr(jfn, bb, gi0)
        let glob_is_addr = load_i64_at(g_glob_is_addr, gi0) == 1
        if glob_is_addr {
            let ldg0 = Instr{}
            ldg0.op = OP_LOAD_MEM
            ldg0.operand0 = glob_base_id
            glob_base_id = emit(jfn, bb, &ldg0)
        }
    }
    let base_id = has_slot0 * slot_base_id + (has_slot0 == 0) * glob_base_id
    let base_stype = has_slot0 * slot_base_stype + (has_slot0 == 0) * glob_base_stype
    let has_base = base_id != -1
    if has_base {
        let sid0 = base_type(base_stype)
        if base_stype >= 1000 and is_pointer_type(base_stype) == 0 { sid0 = base_stype - 1000 }
        let foff0 = lookup_field_off_flat(sid0, src, field_start, field_len)
        if foff0 >= 0 {
            let off_id0 = emit_const(jfn, bb, TYPE_I64, foff0)
            let addr0 = emit_binop(jfn, bb, OP_ADD, base_id, off_id0)
            let stf = Instr{}
            stf.op = OP_STORE_MEM
            stf.itype = TYPE_I64
            stf.operand0 = rhs_id
            stf.operand1 = addr0
            emit(jfn, bb, &stf)
        }
    }
    ret 1
}

fn try_compile_index_store_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, name_start: i64, name_len: i64, pos_before: i64) -> i64 {
    if tok_type_at(toks, pos[0] + 1) != TOK_LBRACK { ret 0 }
    pos[0] = pos[0] + 2
    let idx_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if tok_type_at0(toks, pos) == TOK_RBRACK {
        pos[0] = pos[0] + 1
    }
    if tok_type_at0(toks, pos) != TOK_EQ {
        pos[0] = pos_before
        ret 0
    }
    pos[0] = pos[0] + 1
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let base_id = -1
    let slot_idx = lookup_slot_name(jfn, name_start, name_len)
    if slot_idx != -1 {
        let ld = Instr{}
        ld.op = OP_LOAD
        ld.operand0 = slot_idx
        base_id = emit(jfn, bb, &ld)
    } else {
        let gi2 = lookup_global2(name_start, name_len, src)
        if gi2 != -1 {
            base_id = emit_gaddr(jfn, bb, gi2)
            if load_i64_at(g_glob_is_addr, gi2) == 1 {
                let ldg = Instr{}
                ldg.op = OP_LOAD_MEM
                ldg.operand0 = base_id
                base_id = emit(jfn, bb, &ldg)
            }
        }
    }
    if base_id != -1 {
        let var_stype = lookup_stype_name(jfn, name_start, name_len)
        if var_stype == -1 {
            let vgi = lookup_global2(name_start, name_len, src)
            if vgi != -1 { var_stype = load_i64_at(g_glob_stype, vgi) }
        }
        let store_elem_sz = 8
        let store_itype = TYPE_I64
        if var_stype == TYPE_PTR_I8 { store_elem_sz = 1 store_itype = TYPE_I8 }
        if var_stype == TYPE_PTR_I32 { store_elem_sz = 4 store_itype = TYPE_I32 }
        let byte_off = emit_index_scale(bb, idx_id, store_elem_sz)
        let addr = emit_binop(jfn, bb, OP_ADD, base_id, byte_off)
        let stx = Instr{}
        stx.op = OP_STORE_MEM
        stx.operand0 = rhs_id
        stx.operand1 = addr
        stx.itype = store_itype
        emit(jfn, bb, &stx)
    }
    ret 1
}

fn try_compile_index_field_store_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, name_start: i64, name_len: i64, pos_before: i64) -> i64 {
    if tok_type_at(toks, pos[0] + 1) != TOK_LBRACK { ret 0 }
    pos[0] = pos[0] + 2
    let idx_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if tok_type_at0(toks, pos) == TOK_RBRACK {
        pos[0] = pos[0] + 1
    }
    if tok_type_at0(toks, pos) != TOK_DOT {
        pos[0] = pos_before
        ret 0
    }
    pos[0] = pos[0] + 1
    let field_start = tok_str_start_at(toks, pos[0])
    let field_len = tok_str_len_at(toks, pos[0])
    if tok_type_at0(toks, pos) != TOK_IDENT {
        pos[0] = pos_before
        ret 0
    }
    pos[0] = pos[0] + 1
    if tok_type_at0(toks, pos) != TOK_EQ {
        pos[0] = pos_before
        ret 0
    }
    pos[0] = pos[0] + 1
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let base_id = -1
    let base_stype = -1
    let slot_idx = lookup_slot_name(jfn, name_start, name_len)
    if slot_idx != -1 {
        let ld = Instr{}
        ld.op = OP_LOAD
        ld.operand0 = slot_idx
        base_id = emit(jfn, bb, &ld)
        base_stype = lookup_stype_name(jfn, name_start, name_len)
    } else {
        let gi2 = lookup_global2(name_start, name_len, src)
        if gi2 != -1 {
            base_stype = load_i64_at(g_glob_stype, gi2)
            base_id = emit_gaddr(jfn, bb, gi2)
            if load_i64_at(g_glob_is_addr, gi2) == 1 {
                let ldg = Instr{}
                ldg.op = OP_LOAD_MEM
                ldg.operand0 = base_id
                base_id = emit(jfn, bb, &ldg)
            }
        }
    }
    if base_id == -1 {
        ret 1
    }
    let sid = base_type(base_stype)
    let elem_sz = 8
    if sid >= 0 and sid < stab.cnt {
        elem_sz = stab.sizes[sid]
    }
    let byte_off = emit_index_scale(bb, idx_id, elem_sz)
    let obj_addr = emit_binop(jfn, bb, OP_ADD, base_id, byte_off)
    let field_off = lookup_field_off_flat(sid, src, field_start, field_len)
    let target = obj_addr
    if field_off > 0 {
        let field_off_id = emit_const(jfn, bb, TYPE_I64, field_off)
        target = emit_binop(jfn, bb, OP_ADD, obj_addr, field_off_id)
    }
    let stf = Instr{}
    stf.op = OP_STORE_MEM
    stf.itype = TYPE_I64
    stf.operand0 = rhs_id
    stf.operand1 = target
    emit(jfn, bb, &stf)
    ret 1
}

fn compile_ident_stmt_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, pos_before: i64) -> i64 {
    let name_start = tok_str_start_at(toks, pos[0])
    let name_len = tok_str_len_at(toks, pos[0])
    let field_done = compile_ident_stmt_field_case(toks, pos, stab, src, jfn, bb, name_start, name_len)
    if field_done != -1 { ret field_done }
    let assign_done = compile_ident_stmt_assign_case(toks, pos, stab, src, jfn, bb, pos_before)
    if assign_done != -1 { ret assign_done }
    // Compound assignment: x += expr, x -= expr, etc.
    let ca_tok = tok_type_at(toks, pos[0] + 1)
    if ca_tok == TOK_PLUS_EQ or ca_tok == TOK_MINUS_EQ or ca_tok == TOK_STAR_EQ or ca_tok == TOK_SLASH_EQ or ca_tok == TOK_PERCENT_EQ {
        let ca_ns = tok_str_start_at(toks, pos_before)
        let ca_nl = tok_str_len_at(toks, pos_before)
        pos[0] = pos[0] + 2
        let ca_rhs = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if ca_rhs < 0 { ca_rhs = emit_const(jfn, bb, TYPE_I64, 0) }
        let ca_slot = lookup_slot_name(jfn, ca_ns, ca_nl)
        if ca_slot != -1 {
            let ca_ld = Instr{}
            ca_ld.op = OP_LOAD
            ca_ld.operand0 = ca_slot
            let ca_old = emit(jfn, bb, &ca_ld)
            let ca_stype = lookup_stype_name(jfn, ca_ns, ca_nl)
            let ca_op = OP_ADD
            if ca_tok == TOK_MINUS_EQ { ca_op = OP_SUB }
            if ca_tok == TOK_STAR_EQ { ca_op = OP_MUL }
            if ca_tok == TOK_SLASH_EQ { ca_op = OP_DIV }
            if ca_tok == TOK_PERCENT_EQ { ca_op = OP_MOD }
            if ca_stype == TYPE_F64 or ca_stype == TYPE_F32 {
                if ca_tok == TOK_PLUS_EQ { ca_op = OP_FADD }
                if ca_tok == TOK_MINUS_EQ { ca_op = OP_FSUB }
                if ca_tok == TOK_STAR_EQ { ca_op = OP_FMUL }
                if ca_tok == TOK_SLASH_EQ { ca_op = OP_FDIV }
            }
            let ca_res = emit_binop(jfn, bb, ca_op, ca_old, ca_rhs)
            let ca_st = Instr{}
            ca_st.op = OP_STORE
            ca_st.operand0 = ca_res
            ca_st.operand1 = ca_slot
            emit(jfn, bb, &ca_st)
            ret bb
        }
        ret bb
    }
    codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if pos[0] <= pos_before and pos[0] < g_dbg_tok_cnt {
        pos[0] = pos[0] + 1
    }
    ret bb
}

fn compile_ident_stmt_field_case(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, name_start: i64, name_len: i64) -> i64 {
    let fs_has_dot = tok_type_at(toks, pos[0] + 1) == TOK_DOT
    let fs_has_eq = tok_type_at(toks, pos[0] + 3) == TOK_EQ
    if fs_has_dot == 0 or fs_has_eq == 0 { ret -1 }
    let field_start = tok_str_start_at(toks, pos[0] + 2)
    let field_len = tok_str_len_at(toks, pos[0] + 2)
    pos[0] = pos[0] + 4
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let slot0 = lookup_slot_name(jfn, name_start, name_len)
    let has_slot0 = slot0 != -1
    let slot_base_id = -1
    let slot_base_stype = -1
    if has_slot0 {
        let ld0 = Instr{}
        ld0.op = OP_LOAD
        ld0.operand0 = slot0
        slot_base_id = emit(jfn, bb, &ld0)
        slot_base_stype = lookup_stype_name(jfn, name_start, name_len)
    }
    let gi0 = lookup_global2(name_start, name_len, src)
    let has_gi0 = gi0 != -1
    let glob_base_id = -1
    let glob_base_stype = -1
    if has_gi0 {
        glob_base_stype = load_i64_at(g_glob_stype, gi0)
        glob_base_id = emit_gaddr(jfn, bb, gi0)
        if load_i64_at(g_glob_is_addr, gi0) == 1 {
            let ldg0 = Instr{}
            ldg0.op = OP_LOAD_MEM
            ldg0.operand0 = glob_base_id
            glob_base_id = emit(jfn, bb, &ldg0)
        }
    }
    let base_id = has_slot0 * slot_base_id + (has_slot0 == 0) * glob_base_id
    let base_stype = has_slot0 * slot_base_stype + (has_slot0 == 0) * glob_base_stype
    if base_id != -1 {
        let sid0 = base_type(base_stype)
        if base_stype >= 1000 and is_pointer_type(base_stype) == 0 { sid0 = base_stype - 1000 }
        let foff0 = lookup_field_off_flat(sid0, src, field_start, field_len)
        if foff0 >= 0 {
            let off_id0 = emit_const(jfn, bb, TYPE_I64, foff0)
            let addr0 = emit_binop(jfn, bb, OP_ADD, base_id, off_id0)
            let stf = Instr{}
            stf.op = OP_STORE_MEM
            stf.itype = TYPE_I64
            stf.operand0 = rhs_id
            stf.operand1 = addr0
            emit(jfn, bb, &stf)
        }
    }
    ret bb
}

fn compile_ident_stmt_index_field_case(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, pos_before: i64) -> i64 {
    let is_index_field_store = tok_type_at(toks, pos[0] + 1) == TOK_LBRACK
    if is_index_field_store == 0 { ret -1 }
    let name_start = tok_str_start_at(toks, pos_before)
    let name_len = tok_str_len_at(toks, pos_before)
    pos[0] = pos[0] + 2
    let idx_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if tok_type_at0(toks, pos) == TOK_RBRACK {
        pos[0] = pos[0] + 1
    }
    if tok_type_at0(toks, pos) != TOK_DOT {
        pos[0] = pos_before
        ret -1
    }
    pos[0] = pos[0] + 1
    let field_start = tok_str_start_at(toks, pos[0])
    let field_len = tok_str_len_at(toks, pos[0])
    if tok_type_at0(toks, pos) != TOK_IDENT {
        pos[0] = pos_before
        ret -1
    }
    pos[0] = pos[0] + 1
    if tok_type_at0(toks, pos) != TOK_EQ {
        pos[0] = pos_before
        ret -1
    }
    pos[0] = pos[0] + 1
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let slot_idx = lookup_slot_name(jfn, name_start, name_len)
    let has_slot_idx = slot_idx != -1
    let slot_base_id = -1
    let slot_base_stype = -1
    if has_slot_idx {
        let ld = Instr{}
        ld.op = OP_LOAD
        ld.operand0 = slot_idx
        slot_base_id = emit(jfn, bb, &ld)
        slot_base_stype = lookup_stype_name(jfn, name_start, name_len)
    }
    let gi2 = lookup_global2(name_start, name_len, src)
    let has_gi2 = gi2 != -1
    let glob_base_id = -1
    let glob_base_stype = -1
    if has_gi2 {
        glob_base_stype = load_i64_at(g_glob_stype, gi2)
        glob_base_id = emit_gaddr(jfn, bb, gi2)
        if load_i64_at(g_glob_is_addr, gi2) == 1 {
            let ldg = Instr{}
            ldg.op = OP_LOAD_MEM
            ldg.operand0 = glob_base_id
            glob_base_id = emit(jfn, bb, &ldg)
        }
    }
    let base_id = has_slot_idx * slot_base_id + (has_slot_idx == 0) * glob_base_id
    let base_stype = has_slot_idx * slot_base_stype + (has_slot_idx == 0) * glob_base_stype
    if base_id == -1 { ret bb }
    let sid = base_type(base_stype)
    if base_stype >= 1000 and is_pointer_type(base_stype) == 0 { sid = base_stype - 1000 }
    let elem_sz = 8
    if is_pointer_type(base_stype) { elem_sz = type_sizeof(base_stype) }
    let byte_off = emit_index_scale(bb, idx_id, elem_sz)
    let obj_addr = emit_binop(jfn, bb, OP_ADD, base_id, byte_off)
    let field_off = lookup_field_off_flat(sid, src, field_start, field_len)
    let target = obj_addr
    if field_off > 0 {
        let field_off_id = emit_const(jfn, bb, TYPE_I64, field_off)
        target = emit_binop(jfn, bb, OP_ADD, obj_addr, field_off_id)
    }
    let stf = Instr{}
    stf.op = OP_STORE_MEM
    stf.itype = TYPE_I64
    stf.operand0 = rhs_id
    stf.operand1 = target
    emit(jfn, bb, &stf)
    ret bb
}

fn compile_ident_stmt_bracket_case(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let pos_before = pos[0]
    let name_start = tok_str_start_at(toks, pos_before)
    let name_len = tok_str_len_at(toks, pos_before)
    pos[0] = pos[0] + 2
    let idx_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if tok_type_at0(toks, pos) == TOK_RBRACK {
        pos[0] = pos[0] + 1
    }
    if tok_type_at0(toks, pos) == TOK_DOT {
        pos[0] = pos[0] + 1
        let field_start = tok_str_start_at(toks, pos[0])
        let field_len = tok_str_len_at(toks, pos[0])
        if tok_type_at0(toks, pos) != TOK_IDENT {
            pos[0] = pos_before
            ret bb
        }
        pos[0] = pos[0] + 1
        if tok_type_at0(toks, pos) != TOK_EQ {
            pos[0] = pos_before
            ret bb
        }
        pos[0] = pos[0] + 1
        let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if rhs_id < 0 {
            rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
        }
        let slot_idx = lookup_slot_name(jfn, name_start, name_len)
        let has_slot_idx = slot_idx != -1
        let slot_base_id = -1
        let slot_base_stype = -1
        if has_slot_idx {
            let ld = Instr{}
            ld.op = OP_LOAD
            ld.operand0 = slot_idx
            slot_base_id = emit(jfn, bb, &ld)
            slot_base_stype = lookup_stype_name(jfn, name_start, name_len)
        }
        let gi2 = lookup_global2(name_start, name_len, src)
        let has_gi2 = gi2 != -1
        let glob_base_id = -1
        let glob_base_stype = -1
        if has_gi2 {
            glob_base_stype = load_i64_at(g_glob_stype, gi2)
            glob_base_id = emit_gaddr(jfn, bb, gi2)
            if load_i64_at(g_glob_is_addr, gi2) == 1 {
                let ldg = Instr{}
                ldg.op = OP_LOAD_MEM
                ldg.operand0 = glob_base_id
                glob_base_id = emit(jfn, bb, &ldg)
            }
        }
        let base_id = has_slot_idx * slot_base_id + (has_slot_idx == 0) * glob_base_id
        let base_stype = has_slot_idx * slot_base_stype + (has_slot_idx == 0) * glob_base_stype
        if base_id == -1 { ret bb }
        let sid = base_type(base_stype)
        if base_stype >= 1000 and is_pointer_type(base_stype) == 0 { sid = base_stype - 1000 }
        let elem_sz = 8
        if sid >= 0 and sid < stab.cnt { elem_sz = stab.sizes[sid] }
        if is_pointer_type(base_stype) { elem_sz = type_sizeof(base_stype) }
        let byte_off = emit_index_scale(bb, idx_id, elem_sz)
        let obj_addr = emit_binop(jfn, bb, OP_ADD, base_id, byte_off)
        let field_off = lookup_field_off_flat(sid, src, field_start, field_len)
        let target = obj_addr
        if field_off > 0 {
            let field_off_id = emit_const(jfn, bb, TYPE_I64, field_off)
            target = emit_binop(jfn, bb, OP_ADD, obj_addr, field_off_id)
        }
        let stf = Instr{}
        stf.op = OP_STORE_MEM
        stf.itype = TYPE_I64
        stf.operand0 = rhs_id
        stf.operand1 = target
        emit(jfn, bb, &stf)
        ret bb
    }
    if tok_type_at0(toks, pos) != TOK_EQ {
        pos[0] = pos_before
        codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if pos[0] <= pos_before and pos[0] < g_dbg_tok_cnt {
            pos[0] = pos[0] + 1
        }
        ret bb
    }
    pos[0] = pos[0] + 1
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let slot_idx = lookup_slot_name(jfn, name_start, name_len)
    let has_slot_idx = slot_idx != -1
    let slot_base_id = -1
    let slot_base_stype = TYPE_I64
    if has_slot_idx {
        let ld = Instr{}
        ld.op = OP_LOAD
        ld.operand0 = slot_idx
        slot_base_id = emit(jfn, bb, &ld)
        slot_base_stype = lookup_stype_name(jfn, name_start, name_len)
    }
    let gi2 = lookup_global2(name_start, name_len, src)
    let has_gi2 = gi2 != -1
    let glob_base_id = -1
    let glob_base_stype = TYPE_I64
    if has_gi2 {
        glob_base_stype = load_i64_at(g_glob_stype, gi2)
        glob_base_id = emit_gaddr(jfn, bb, gi2)
        if load_i64_at(g_glob_is_addr, gi2) == 1 {
            let ldg = Instr{}
            ldg.op = OP_LOAD_MEM
            ldg.operand0 = glob_base_id
            glob_base_id = emit(jfn, bb, &ldg)
        }
    }
    let base_id = has_slot_idx * slot_base_id + (has_slot_idx == 0) * glob_base_id
    let base_stype = has_slot_idx * slot_base_stype + (has_slot_idx == 0) * glob_base_stype
    if base_id != -1 {
        let elem_sz_val = 8
        let store_itype2 = TYPE_I64
        if is_pointer_type(base_stype) {
            elem_sz_val = type_sizeof(base_stype)
            store_itype2 = base_type(base_stype)
        }
        let byte_off = emit_index_scale(bb, idx_id, elem_sz_val)
        let addr = emit_binop(jfn, bb, OP_ADD, base_id, byte_off)
        let stx = Instr{}
        stx.op = OP_STORE_MEM
        stx.operand0 = rhs_id
        stx.operand1 = addr
        stx.itype = store_itype2
        emit(jfn, bb, &stx)
    }
    ret bb
}

fn compile_ident_stmt_assign_case(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64, pos_before: i64) -> i64 {
    if tok_type_at(toks, pos[0] + 1) != TOK_EQ { ret -1 }
    let name_start = tok_str_start_at(toks, pos_before)
    let name_len = tok_str_len_at(toks, pos_before)
    pos[0] = pos[0] + 2
    let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if rhs_id < 0 {
        rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
    }
    let slot = lookup_slot_name(jfn, name_start, name_len)
    if slot != -1 {
        let st = Instr{}
        st.op = OP_STORE
        st.operand0 = rhs_id
        st.operand1 = slot
        emit(jfn, bb, &st)
        ret bb
    }
    let gi = lookup_global2(name_start, name_len, src)
    if gi != -1 {
        let gaddr = emit_gaddr(jfn, bb, gi)
        let stg = Instr{}
        stg.op = OP_STORE_MEM
        stg.itype = TYPE_I64
        stg.operand0 = rhs_id
        stg.operand1 = gaddr
        emit(jfn, bb, &stg)
        ret bb
    }
    ret bb
}

fn compile_expr_stmt_ident_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let pos_before = pos[0]
    let name_start = tok_str_start_at(toks, pos[0])
    let name_len = tok_str_len_at(toks, pos[0])
    let fs_has_dot = tok_type_at(toks, pos[0] + 1) == TOK_DOT
    let fs_has_eq = tok_type_at(toks, pos[0] + 3) == TOK_EQ
    if fs_has_dot and fs_has_eq {
        let field_start = tok_str_start_at(toks, pos[0] + 2)
        let field_len = tok_str_len_at(toks, pos[0] + 2)
        pos[0] = pos[0] + 4
        let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if rhs_id < 0 {
            rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
        }
        let slot0 = lookup_slot_name(jfn, name_start, name_len)
        let has_slot0 = slot0 != -1
        let slot_base_id = -1
        let slot_base_stype = -1
        if has_slot0 {
            let ld0 = Instr{}
            ld0.op = OP_LOAD
            ld0.operand0 = slot0
            slot_base_id = emit(jfn, bb, &ld0)
            slot_base_stype = lookup_stype_name(jfn, name_start, name_len)
        }
        let gi0 = lookup_global2(name_start, name_len, src)
        let has_gi0 = gi0 != -1
        let glob_base_id = -1
        let glob_base_stype = -1
        if has_gi0 {
            glob_base_stype = load_i64_at(g_glob_stype, gi0)
            glob_base_id = emit_gaddr(jfn, bb, gi0)
            if load_i64_at(g_glob_is_addr, gi0) == 1 {
                let ldg0 = Instr{}
                ldg0.op = OP_LOAD_MEM
                ldg0.operand0 = glob_base_id
                glob_base_id = emit(jfn, bb, &ldg0)
            }
        }
        let base_id = has_slot0 * slot_base_id + (has_slot0 == 0) * glob_base_id
        let base_stype = has_slot0 * slot_base_stype + (has_slot0 == 0) * glob_base_stype
        if base_id != -1 {
            let sid0 = base_type(base_stype)
            if base_stype >= 1000 and is_pointer_type(base_stype) == 0 { sid0 = base_stype - 1000 }
            let foff0 = lookup_field_off_flat(sid0, src, field_start, field_len)
            if foff0 >= 0 {
                let off_id0 = emit_const(jfn, bb, TYPE_I64, foff0)
                let addr0 = emit_binop(jfn, bb, OP_ADD, base_id, off_id0)
                let stf = Instr{}
                stf.op = OP_STORE_MEM
                stf.itype = TYPE_I64
                stf.operand0 = rhs_id
                stf.operand1 = addr0
                emit(jfn, bb, &stf)
            }
        }
        ret bb
    }
    let t1 = tok_type_at(toks, pos[0] + 1)
    if t1 == TOK_LBRACK {
        ret compile_ident_stmt_bracket_case(toks, pos, stab, src, jfn, bb)
    }
    if t1 == TOK_EQ {
        pos[0] = pos[0] + 2
        let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if rhs_id < 0 {
            rhs_id = emit_const(jfn, bb, TYPE_I64, 0)
        }
        let slot = lookup_slot_name(jfn, name_start, name_len)
        if slot != -1 {
            let st = Instr{}
            st.op = OP_STORE
            st.operand0 = rhs_id
            st.operand1 = slot
            emit(jfn, bb, &st)
            ret bb
        }
        let gi = lookup_global2(name_start, name_len, src)
        if gi != -1 {
            let gaddr = emit_gaddr(jfn, bb, gi)
            let stg = Instr{}
            stg.op = OP_STORE_MEM
            stg.itype = TYPE_I64
            stg.operand0 = rhs_id
            stg.operand1 = gaddr
            emit(jfn, bb, &stg)
            ret bb
        }
        ret bb
    }
    // Compound assignment: x += expr, etc.
    if t1 == TOK_PLUS_EQ or t1 == TOK_MINUS_EQ or t1 == TOK_STAR_EQ or t1 == TOK_SLASH_EQ or t1 == TOK_PERCENT_EQ {
        pos[0] = pos[0] + 2
        let ca_rhs2 = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if ca_rhs2 < 0 { ca_rhs2 = emit_const(jfn, bb, TYPE_I64, 0) }
        let ca_slot2 = lookup_slot_name(jfn, name_start, name_len)
        if ca_slot2 != -1 {
            let ca_ld2 = Instr{}
            ca_ld2.op = OP_LOAD
            ca_ld2.operand0 = ca_slot2
            let ca_old2 = emit(jfn, bb, &ca_ld2)
            let ca_stype2 = lookup_stype_name(jfn, name_start, name_len)
            let ca_op2 = OP_ADD
            if t1 == TOK_MINUS_EQ { ca_op2 = OP_SUB }
            if t1 == TOK_STAR_EQ { ca_op2 = OP_MUL }
            if t1 == TOK_SLASH_EQ { ca_op2 = OP_DIV }
            if t1 == TOK_PERCENT_EQ { ca_op2 = OP_MOD }
            if ca_stype2 == TYPE_F64 or ca_stype2 == TYPE_F32 {
                if t1 == TOK_PLUS_EQ { ca_op2 = OP_FADD }
                if t1 == TOK_MINUS_EQ { ca_op2 = OP_FSUB }
                if t1 == TOK_STAR_EQ { ca_op2 = OP_FMUL }
                if t1 == TOK_SLASH_EQ { ca_op2 = OP_FDIV }
            }
            let ca_res2 = emit_binop(jfn, bb, ca_op2, ca_old2, ca_rhs2)
            let ca_st2 = Instr{}
            ca_st2.op = OP_STORE
            ca_st2.operand0 = ca_res2
            ca_st2.operand1 = ca_slot2
            emit(jfn, bb, &ca_st2)
            ret bb
        }
        ret bb
    }
    codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if pos[0] <= pos_before and pos[0] < g_dbg_tok_cnt {
        pos[0] = pos[0] + 1
    }
    if g_iter_exit_bb != -1 {
        let exit_bb = g_iter_exit_bb
        g_iter_exit_bb = -1
        ret exit_bb
    }
    ret bb
}

fn compile_expr_stmt2_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt { ret bb }
    let pos_before = pos[0]
    codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    if pos[0] <= pos_before and pos[0] < g_dbg_tok_cnt {
        pos[0] = pos[0] + 1
    }
    if g_iter_exit_bb != -1 {
        let exit_bb = g_iter_exit_bb
        g_iter_exit_bb = -1
        ret exit_bb
    }
    ret bb
}

fn skip_asm_stmt_inline(toks: &Token, pos: &i64, src: &i8) -> i64 {
    if tok_type_at0(toks, pos) != TOK_IDENT { ret 0 }
    let t = toks[pos[0]]
    if t.str_len != 3 { ret 0 }
    if streq(src, t.str_start, t.str_len, "asm") != 1 { ret 0 }
    if g_check_unsafe == 1 and g_unsafe_depth == 0 { report_error("asm block requires unsafe") }
    if tok_type_at(toks, pos[0] + 1) != TOK_LBRACE { ret 0 }
    pos[0] = pos[0] + 2
    let depth = 1
    loop depth > 0 and pos[0] < g_dbg_tok_cnt {
        let tt = tok_type_at0(toks, pos)
        if tt == TOK_LBRACE { depth = depth + 1 }
        if tt == TOK_RBRACE { depth = depth - 1 }
        pos[0] = pos[0] + 1
    }
    ret 1
}

fn compile_asm_argv_inline(toks: &Token, pos: &i64, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if tok_type_at0(toks, pos) != TOK_IDENT { ret 0 }
    let t0 = toks[pos[0]]
    if t0.str_len != 3 { ret 0 }
    if streq(src, t0.str_start, t0.str_len, "asm") != 1 { ret 0 }
    if tok_type_at(toks, pos[0] + 1) != TOK_LBRACE { ret 0 }
    let t_out = toks[pos[0] + 2]
    let t_var = toks[pos[0] + 3]
    let t_eq  = tok_type_at(toks, pos[0] + 4)
    let t_reg = toks[pos[0] + 5]
    let t_rbrace = tok_type_at(toks, pos[0] + 6)
    if t_out.str_len != 3 { ret 0 }
    if t_eq != TOK_EQ { ret 0 }
    if t_reg.str_len != 3 { ret 0 }
    if t_rbrace != TOK_RBRACE { ret 0 }
    if streq(src, t_out.str_start, t_out.str_len, "out") != 1 { ret 0 }
    
    let op = -1
    if streq(src, t_reg.str_start, t_reg.str_len, "rsi") == 1 {
        op = OP_ARGV_BASE
    } else if streq(src, t_reg.str_start, t_reg.str_len, "rdi") == 1 {
        op = OP_ARGC_GET
    }
    if op == -1 { ret 0 }

    let slot = lookup_slot_name(jfn, t_var.str_start, t_var.str_len)
    if slot == -1 { ret 0 }
    let ins = Instr{}
    ins.op = op
    ins.operand0 = slot
    emit(jfn, bb, &ins)
    pos[0] = pos[0] + 7
    ret 1
}

fn compile_if_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    expect(TOK_IF)
    let cond_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
    let then_blk = create_block_live(jfn)
    let alt_blk = create_block_live(jfn)
    let merge_blk = create_block_live(jfn)
    emit_br(jfn, bb, cond_id, then_blk, alt_blk)
    expect(TOK_LBRACE)
    let then_end = compile_stmts_inline(toks, pos, stab, src, jfn, then_blk)
    expect(TOK_RBRACE)
    emit_jmp(jfn, then_end, merge_blk)
    if tok_type_at(toks, pos[0]) != TOK_ELSE {
        emit_jmp(jfn, alt_blk, merge_blk)
        ret merge_blk
    }
    pos[0] = pos[0] + 1
    if tok_type_at(toks, pos[0]) == TOK_IF {
        let alt_end = live_compile_if(toks, pos, stab, src, jfn, alt_blk)
        emit_jmp(jfn, alt_end, merge_blk)
        ret merge_blk
    }
    expect(TOK_LBRACE)
    let alt_end = compile_stmts_inline(toks, pos, stab, src, jfn, alt_blk)
    expect(TOK_RBRACE)
    emit_jmp(jfn, alt_end, merge_blk)
    ret merge_blk
}

fn compile_stmts_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let cur = bb
    let more = 1
    loop more == 1 {
        let t = tok_type_at(toks, pos[0])
        if t == TOK_RBRACE { more = 0 }
        else if t == TOK_EOF { more = 0 }
        else if t == TOK_IF {
            cur = compile_if_inline(toks, pos, stab, src, jfn, cur)
        } else if t == TOK_LOOP {
            expect(TOK_LOOP)
            let head_blk = create_block_live(jfn)
            emit_jmp(jfn, cur, head_blk)
            let body_blk = create_block_live(jfn)
            let exit_blk = create_block_live(jfn)
            let cond_id = codegen_expr_inline(toks, pos, stab, src, jfn, head_blk)
            emit_br(jfn, head_blk, cond_id, body_blk, exit_blk)
            expect(TOK_LBRACE)
            let body_end = live_compile_block(toks, pos, stab, src, jfn, body_blk)
            expect(TOK_RBRACE)
            emit_jmp(jfn, body_end, head_blk)
            cur = exit_blk
        } else if t == TOK_LET {
            pos[0] = pos[0] + 1
            let name_start = tok_str_start_at(toks, pos[0])
            let name_len = tok_str_len_at(toks, pos[0])
            pos[0] = pos[0] + 1
            pos[0] = pos[0] + 1
            let let_struct_id = -1
            if tok_type_at(toks, pos[0]) == TOK_IDENT {
                if tok_type_at(toks, pos[0] + 1) == TOK_LBRACE {
                    let lrs = tok_str_start_at(toks, pos[0])
                    let lrl = tok_str_len_at(toks, pos[0])
                    let_struct_id = lookup_struct(stab, src, lrs, lrl)
                }
            }
            let rhs_id = codegen_expr_inline(toks, pos, stab, src, jfn, cur)
            if g_iter_exit_bb != -1 {
                cur = g_iter_exit_bb
                g_iter_exit_bb = -1
            }
            let bind_stype = TYPE_I64
            if let_struct_id >= 0 { bind_stype = let_struct_id + 1000 }
            let slot = bind_name(jfn, name_start, name_len, bind_stype)
            let ins = Instr{}
            ins.op = OP_STORE
            ins.operand0 = rhs_id
            ins.operand1 = slot
            emit(jfn, cur, &ins)
        } else if t == TOK_RET {
            pos[0] = pos[0] + 1
            let val_id = emit_const(jfn, cur, TYPE_I64, 0)
            let rt = tok_type_at0(toks, pos)
            if rt == TOK_INT or rt == TOK_FLOAT or rt == TOK_IDENT or rt == TOK_LPAREN or rt == TOK_MINUS or rt == TOK_TILDE or rt == TOK_NOT or rt == TOK_AMP or rt == TOK_SYSCALL or rt == TOK_TRUE or rt == TOK_FALSE or rt == TOK_STR or rt == TOK_RAW_STR {
                val_id = codegen_expr_inline(toks, pos, stab, src, jfn, cur)
            }
            let rins = Instr{}
            rins.op = OP_RET
            rins.operand0 = val_id
            emit(jfn, cur, &rins)
        } else if t == TOK_PRINT {
            cur = compile_print_inline(toks, pos, stab, src, jfn, cur)
        } else if t == TOK_UNSAFE {
            pos[0] = pos[0] + 1
            expect(TOK_LBRACE)
            g_unsafe_depth = g_unsafe_depth + 1
            cur = compile_stmts_inline(toks, pos, stab, src, jfn, cur)
            expect(TOK_RBRACE)
            g_unsafe_depth = g_unsafe_depth - 1
        } else if t == TOK_FOR {
            // for i in range(n) { body } — desugars to loop
            pos[0] = pos[0] + 1
            let for_vs = tok_str_start_at(toks, pos[0])
            let for_vl = tok_str_len_at(toks, pos[0])
            pos[0] = pos[0] + 1
            if tok_type_at(toks, pos[0]) == TOK_IDENT { pos[0] = pos[0] + 1 }
            if tok_type_at(toks, pos[0]) == TOK_IDENT { pos[0] = pos[0] + 1 }
            if tok_type_at(toks, pos[0]) == TOK_LPAREN { pos[0] = pos[0] + 1 }
            let for_first2 = codegen_expr_inline(toks, pos, stab, src, jfn, cur)
            let for_lim = for_first2
            let for_z = emit_const(jfn, cur, TYPE_I64, 0)
            if tok_type_at(toks, pos[0]) == TOK_COMMA {
                pos[0] = pos[0] + 1
                for_lim = codegen_expr_inline(toks, pos, stab, src, jfn, cur)
                for_z = for_first2
            }
            if tok_type_at(toks, pos[0]) == TOK_RPAREN { pos[0] = pos[0] + 1 }
            let for_s = bind_name(jfn, for_vs, for_vl, 0)
            let for_si = Instr{}
            for_si.op = OP_STORE
            for_si.operand0 = for_z
            for_si.operand1 = for_s
            emit(jfn, cur, &for_si)
            // Spill limit to stack slot so it survives loop body calls
            let for_ls = alloc_slot(jfn)
            let for_sl = Instr{}
            for_sl.op = OP_STORE
            for_sl.operand0 = for_lim
            for_sl.operand1 = for_ls
            emit(jfn, cur, &for_sl)
            let for_hd = create_block_live(jfn)
            emit_jmp(jfn, cur, for_hd)
            let for_bd = create_block_live(jfn)
            let for_ex = create_block_live(jfn)
            let for_ldc = Instr{}
            for_ldc.op = OP_LOAD
            for_ldc.operand0 = for_s
            let for_cv = emit(jfn, for_hd, &for_ldc)
            let for_lld = Instr{}
            for_lld.op = OP_LOAD
            for_lld.operand0 = for_ls
            let for_lim_r = emit(jfn, for_hd, &for_lld)
            let for_cmp = emit_binop(jfn, for_hd, OP_CMP_LT, for_cv, for_lim_r)
            emit_br(jfn, for_hd, for_cmp, for_bd, for_ex)
            if tok_type_at(toks, pos[0]) == TOK_LBRACE { pos[0] = pos[0] + 1 }
            let for_be = live_compile_block(toks, pos, stab, src, jfn, for_bd)
            if tok_type_at(toks, pos[0]) == TOK_RBRACE { pos[0] = pos[0] + 1 }
            let for_ldi = Instr{}
            for_ldi.op = OP_LOAD
            for_ldi.operand0 = for_s
            let for_iv = emit(jfn, for_be, &for_ldi)
            let for_1 = emit_const(jfn, for_be, TYPE_I64, 1)
            let for_nv = emit_binop(jfn, for_be, OP_ADD, for_iv, for_1)
            let for_sti = Instr{}
            for_sti.op = OP_STORE
            for_sti.operand0 = for_nv
            for_sti.operand1 = for_s
            emit(jfn, for_be, &for_sti)
            emit_jmp(jfn, for_be, for_hd)
            cur = for_ex
        } else if t == TOK_IDENT {
            cur = compile_expr_stmt_ident_inline(toks, pos, stab, src, jfn, cur)
        } else {
            cur = compile_expr_stmt2_inline(toks, pos, stab, src, jfn, cur)
        }
    }
    ret cur
}

fn op_precedence(tok: i32) -> i32 {
    let mul_p = ((tok == TOK_STAR) or (tok == TOK_SLASH) or (tok == TOK_PERCENT)) * 60
    let add_p = ((tok == TOK_PLUS) or (tok == TOK_MINUS)) * 50
    let cmp_p = ((tok == TOK_LT) or (tok == TOK_GT) or (tok == TOK_LTE) or (tok == TOK_GTE)) * 40
    let eq_p = ((tok == TOK_EQEQ) or (tok == TOK_NEQ)) * 30
    let and_p = (tok == TOK_AND) * 20
    let or_p = (tok == TOK_OR) * 10
    ret mul_p + add_p + cmp_p + eq_p + and_p + or_p
}

fn is_cmp_tok(tok: i32) -> i64 {
    if tok == TOK_EQEQ { ret 1 }
    if tok == TOK_NEQ { ret 1 }
    if tok == TOK_LT { ret 1 }
    if tok == TOK_GT { ret 1 }
    if tok == TOK_LTE { ret 1 }
    if tok == TOK_GTE { ret 1 }
    ret 0
}

fn is_term_tok(tok: i32) -> i64 {
    if tok == TOK_RPAREN { ret 1 }
    if tok == TOK_RBRACE { ret 1 }
    if tok == TOK_RBRACK { ret 1 }
    if tok == TOK_COMMA { ret 1 }
    if tok == TOK_EOF { ret 1 }
    if tok == TOK_LBRACE { ret 1 }
    ret 0
}

fn codegen_expr_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let result = codegen_or_inline(toks, pos, stab, src, jfn, bb)
    // Handle 'as <type>' cast — skip type annotation, return expression value unchanged
    if tok_type_at(toks, pos[0]) == TOK_IDENT {
        let as_s = tok_str_start_at(toks, pos[0])
        let as_l = tok_str_len_at(toks, pos[0])
        if as_l == 2 and streq(src, as_s, 2, "as") == 1 {
            pos[0] = pos[0] + 1
            // Check for pointer cast (as &T) — requires unsafe
            if tok_type_at(toks, pos[0]) == TOK_AMP {
                if g_check_unsafe == 1 and g_unsafe_depth == 0 { report_error("pointer cast requires unsafe block") }
                pos[0] = pos[0] + 1
            }
            // Skip the type token (i64, i32, i8, or ident)
            pos[0] = pos[0] + 1
        }
    }
    ret result
}

fn codegen_or_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_and_inline(toks, pos, stab, src, jfn, bb)
    let or_more = 1
    loop or_more == 1 {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_OR {
            if op != TOK_PIPE {
                or_more = 0
                ret left_id
            }
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_and_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_and_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_eq_inline(toks, pos, stab, src, jfn, bb)
    let and_more = 1
    loop and_more == 1 {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_AND {
            if op != TOK_AMP {
                and_more = 0
                ret left_id
            }
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_eq_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_eq_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_rel_inline(toks, pos, stab, src, jfn, bb)
    let eq_left_stype = g_codegen_stype
    let eq_more = 1
    loop eq_more == 1 {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_EQEQ {
            if op != TOK_NEQ {
                eq_more = 0
                ret left_id
            }
        }
        pos[0] = pos[0] + 1
        let right_id = codegen_rel_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        if eq_left_stype == TYPE_F64 or eq_left_stype == TYPE_F32 { jir_op = tok_to_jir_op_f64(op) }
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn codegen_rel_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = fold_add_chain_inline(toks, pos, stab, src, jfn, bb)
    let rel_left_stype = g_codegen_stype
    let rel_more = 1
    loop rel_more == 1 {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_LT {
            if op != TOK_GT {
                if op != TOK_LTE {
                    if op != TOK_GTE {
                        rel_more = 0
                        ret left_id
                    }
                }
            }
        }
        pos[0] = pos[0] + 1
        let right_id = fold_add_chain_inline(toks, pos, stab, src, jfn, bb)
        let jir_op = tok_to_jir_op(op)
        if rel_left_stype == TYPE_F64 or rel_left_stype == TYPE_F32 { jir_op = tok_to_jir_op_f64(op) }
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
    }
    ret left_id
}

fn fold_add_chain_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_mul_inline(toks, pos, stab, src, jfn, bb)
    if left_id < 0 {
        ret left_id
    }
    let left_stype = g_codegen_stype
    let op = tok_type_at(toks, pos[0])
    let add_like = is_add_like_op(op)
    loop add_like == 1 {
        pos[0] = pos[0] + 1
        let right_id = codegen_mul_inline(toks, pos, stab, src, jfn, bb)
        let right_bad = right_id < 0
        if right_bad {
            ret left_id
        }
        let jir_op = tok_to_jir_op(op)
        if left_stype == TYPE_F64 or left_stype == TYPE_F32 { jir_op = tok_to_jir_op_f64(op) }
        g_codegen_stype = left_stype
        left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
        op = tok_type_at(toks, pos[0])
        add_like = is_add_like_op(op)
    }
    ret left_id
}

fn is_add_like_op(op: i32) -> i64 {
    ret (op == TOK_PLUS) or (op == TOK_MINUS) or (op == TOK_SHR) or (op == TOK_SHL)
}

fn is_mul_like_op(op: i32) -> i64 {
    ret (op == TOK_STAR) or (op == TOK_SLASH) or (op == TOK_PERCENT)
}

fn codegen_add_inline_tail(left_id: i64, toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if left_id < 0 {
        ret left_id
    }
    let op = tok_type_at(toks, pos[0])
    if op != TOK_PLUS {
        if op != TOK_MINUS {
            ret left_id
        }
    }
    ret codegen_add_inline_step(left_id, op, toks, pos, stab, src, jfn, bb)
}

fn codegen_add_inline_step(left_id: i64, op: i64, toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    pos[0] = pos[0] + 1
    let right_id = codegen_mul_inline(toks, pos, stab, src, jfn, bb)
    let right_bad = right_id < 0
    if right_bad {
        ret left_id
    }
    let jir_op = tok_to_jir_op(op)
    let next_left = emit_binop(jfn, bb, jir_op, left_id, right_id)
    ret codegen_add_inline_tail(next_left, toks, pos, stab, src, jfn, bb)
}

fn codegen_add_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_mul_inline(toks, pos, stab, src, jfn, bb)
    if left_id < 0 {
        ret left_id
    }
    let add_more = 1
    loop add_more == 1 {
        let op = tok_type_at(toks, pos[0])
        if op != TOK_PLUS {
            if op != TOK_MINUS {
                add_more = 0
            }
        }
        if add_more == 1 {
            pos[0] = pos[0] + 1
            let right_id = codegen_mul_inline(toks, pos, stab, src, jfn, bb)
            let right_bad = right_id < 0
            if right_bad {
                add_more = 0
            }
            if add_more == 1 {
                let jir_op = tok_to_jir_op(op)
                left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
            }
        }
    }
    ret left_id
}

fn codegen_mul_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let left_id = codegen_unary_inline(toks, pos, stab, src, jfn, bb)
    if left_id < 0 {
        ret left_id
    }
    let mul_left_stype = g_codegen_stype
    let mul_more = 1
    loop mul_more == 1 {
        let op = tok_type_at(toks, pos[0])
        let keep = (op == TOK_STAR) or (op == TOK_SLASH) or (op == TOK_PERCENT)
        if keep == 0 {
            mul_more = 0
        }
        if mul_more == 1 {
            pos[0] = pos[0] + 1
            let right_id = codegen_unary_inline(toks, pos, stab, src, jfn, bb)
            let right_bad = right_id < 0
            if right_bad {
                mul_more = 0
            }
            if mul_more == 1 {
                let jir_op = tok_to_jir_op(op)
                if mul_left_stype == TYPE_F64 or mul_left_stype == TYPE_F32 { jir_op = tok_to_jir_op_f64(op) }
                left_id = emit_binop(jfn, bb, jir_op, left_id, right_id)
                g_codegen_stype = mul_left_stype
            }
        }
    }
    ret left_id
}

fn codegen_unary_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    if pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let tt = tok_type_at0(toks, pos)
    if tt == TOK_SYSCALL {
        ret codegen_syscall_inline(toks, pos, stab, src, jfn, bb)
    }
    if tt == TOK_MINUS {
        pos[0] = pos[0] + 1
        let rhs_id = codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
        if g_codegen_stype == TYPE_F64 or g_codegen_stype == TYPE_F32 {
            let neg_ins = Instr{}
            neg_ins.op = OP_FNEG
            neg_ins.operand0 = rhs_id
            ret emit(jfn, bb, &neg_ins)
        }
        let zero_id = emit_const(jfn, bb, TYPE_I64, 0)
        ret emit_binop(jfn, bb, OP_SUB, zero_id, rhs_id)
    }
    if tt == TOK_TILDE {
        pos[0] = pos[0] + 1
        let rhs_id = codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
        let neg1_id = emit_const(jfn, bb, TYPE_I64, -1)
        ret emit_binop(jfn, bb, OP_SUB, neg1_id, rhs_id)
    }
    if tt == TOK_NOT {
        pos[0] = pos[0] + 1
        let rhs_id = codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
        let zero_id = emit_const(jfn, bb, TYPE_I64, 0)
        ret emit_binop(jfn, bb, OP_CMP_EQ, rhs_id, zero_id)
    }
    if tt != TOK_AMP {
        ret codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
    }
    pos[0] = pos[0] + 1
    let addr_tt = tok_type_at0(toks, pos)
    if addr_tt != TOK_IDENT {
        if addr_tt != TOK_EOF { pos[0] = pos[0] + 1 }
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let a_start = tok_str_start_at(toks, pos[0])
    let a_len = tok_str_len_at(toks, pos[0])
    // If &name is followed by . or [, delegate to postfix codegen which returns
    // addresses for struct-array chains (e.g. &jfn.blocks[bb].instrs[slot])
    let a_next_t = tok_type_at(toks, pos[0] + 1)
    if a_next_t == TOK_DOT or a_next_t == TOK_LBRACK {
        ret codegen_postfix_inline(toks, pos, stab, src, jfn, bb)
    }
    let slot = lookup_slot_name(jfn, a_start, a_len)
    if slot != -1 {
        let a_stype = lookup_stype_name(jfn, a_start, a_len)
        if a_stype >= 1000 {
            pos[0] = pos[0] + 1
            let ald = Instr{}
            ald.op = OP_LOAD
            ald.operand0 = slot
            ret emit(jfn, bb, &ald)
        }
        pos[0] = pos[0] + 1
        let ains = Instr{}
        ains.op = OP_ADDR
        ains.operand0 = slot
        ret emit(jfn, bb, &ains)
    }
    let gi = lookup_global2(a_start, a_len, src)
    if gi != -1 {
        pos[0] = pos[0] + 1
        ret emit_gaddr(jfn, bb, gi)
    }
    pos[0] = pos[0] + 1
    ret emit_const(jfn, bb, TYPE_I64, 0)
}

// ── Primitive method dispatch (branchless, single BB) ────────────────
fn try_prim_i64(bb: i64, self_id: i64, fs: i64, fl: i64) -> i64 {
    let src = g_src_buf_ptr
    if streq(src, fs, fl, "abs") {
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        // abs(x) = x * ((x > 0) * 2 - 1)
        let zero = emit_const(g_jfn, bb, TYPE_I64, 0)
        let gt = emit_binop(g_jfn, bb, OP_CMP_GT, self_id, zero)
        let two = emit_const(g_jfn, bb, TYPE_I64, 2)
        let gt2 = emit_binop(g_jfn, bb, OP_MUL, gt, two)
        let one = emit_const(g_jfn, bb, TYPE_I64, 1)
        let sign = emit_binop(g_jfn, bb, OP_SUB, gt2, one)
        ret emit_binop(g_jfn, bb, OP_MUL, self_id, sign)
    }
    if streq(src, fs, fl, "neg") {
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        let zero = emit_const(g_jfn, bb, TYPE_I64, 0)
        ret emit_binop(g_jfn, bb, OP_SUB, zero, self_id)
    }
    if streq(src, fs, fl, "min") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        // min(a, b) = b + (a - b) * (a < b)
        let diff = emit_binop(g_jfn, bb, OP_SUB, self_id, other)
        let lt = emit_binop(g_jfn, bb, OP_CMP_LT, self_id, other)
        let sel = emit_binop(g_jfn, bb, OP_MUL, diff, lt)
        ret emit_binop(g_jfn, bb, OP_ADD, other, sel)
    }
    if streq(src, fs, fl, "max") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        // max(a, b) = a + (b - a) * (a < b)
        let diff = emit_binop(g_jfn, bb, OP_SUB, other, self_id)
        let lt = emit_binop(g_jfn, bb, OP_CMP_LT, self_id, other)
        let sel = emit_binop(g_jfn, bb, OP_MUL, diff, lt)
        ret emit_binop(g_jfn, bb, OP_ADD, self_id, sel)
    }
    if streq(src, fs, fl, "clamp") {
        expect(TOK_LPAREN)
        let lo = live_codegen_expr_inline(bb)
        expect(TOK_COMMA)
        let hi = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        // clamp = max(lo, min(self, hi))
        // min(self, hi) = hi + (self - hi) * (self < hi)
        let d1 = emit_binop(g_jfn, bb, OP_SUB, self_id, hi)
        let lt1 = emit_binop(g_jfn, bb, OP_CMP_LT, self_id, hi)
        let s1 = emit_binop(g_jfn, bb, OP_MUL, d1, lt1)
        let mn = emit_binop(g_jfn, bb, OP_ADD, hi, s1)
        // max(lo, mn) = lo + (mn - lo) * (lo < mn)
        let d2 = emit_binop(g_jfn, bb, OP_SUB, mn, lo)
        let lt2 = emit_binop(g_jfn, bb, OP_CMP_LT, lo, mn)
        let s2 = emit_binop(g_jfn, bb, OP_MUL, d2, lt2)
        ret emit_binop(g_jfn, bb, OP_ADD, lo, s2)
    }
    if streq(src, fs, fl, "to_f64") {
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        let ins = Instr{}
        ins.op = OP_I2F
        ins.operand0 = self_id
        ins.itype = TYPE_F64
        ret emit(g_jfn, bb, &ins)
    }
    ret -1
}

fn try_prim_f64(bb: i64, self_id: i64, fs: i64, fl: i64) -> i64 {
    let src = g_src_buf_ptr
    if streq(src, fs, fl, "abs") {
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        let ins = Instr{}
        ins.op = OP_FABS
        ins.operand0 = self_id
        ret emit(g_jfn, bb, &ins)
    }
    if streq(src, fs, fl, "neg") {
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        let ins = Instr{}
        ins.op = OP_FNEG
        ins.operand0 = self_id
        ret emit(g_jfn, bb, &ins)
    }
    if streq(src, fs, fl, "sqrt") {
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        let ins = Instr{}
        ins.op = OP_FSQRT
        ins.operand0 = self_id
        ret emit(g_jfn, bb, &ins)
    }
    if streq(src, fs, fl, "add") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret emit_binop(g_jfn, bb, OP_FADD, self_id, other)
    }
    if streq(src, fs, fl, "sub") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret emit_binop(g_jfn, bb, OP_FSUB, self_id, other)
    }
    if streq(src, fs, fl, "mul") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret emit_binop(g_jfn, bb, OP_FMUL, self_id, other)
    }
    if streq(src, fs, fl, "div") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret emit_binop(g_jfn, bb, OP_FDIV, self_id, other)
    }
    if streq(src, fs, fl, "lt") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret emit_binop(g_jfn, bb, OP_FCMP_LT, self_id, other)
    }
    if streq(src, fs, fl, "gt") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret emit_binop(g_jfn, bb, OP_FCMP_GT, self_id, other)
    }
    if streq(src, fs, fl, "eq") {
        expect(TOK_LPAREN)
        let other = live_codegen_expr_inline(bb)
        expect(TOK_RPAREN)
        ret emit_binop(g_jfn, bb, OP_FCMP_EQ, self_id, other)
    }
    if streq(src, fs, fl, "to_i64") {
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        let ins = Instr{}
        ins.op = OP_F2I
        ins.operand0 = self_id
        ins.itype = TYPE_I64
        ret emit(g_jfn, bb, &ins)
    }
    ret -1
}

fn codegen_postfix_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let start_pos = pos[0]
    g_codegen_stype = 0
    let expr_id = codegen_primary_inline(toks, pos, stab, src, jfn, bb)
    let cur_stype = TYPE_I64
    let cur_is_struct = 0
    if tok_type_at(toks, start_pos) == TOK_IDENT {
        cur_stype = lookup_stype_name(jfn, tok_str_start_at(toks, start_pos), tok_str_len_at(toks, start_pos))
        if cur_stype == -1 {
            let cps_gi = lookup_global2(tok_str_start_at(toks, start_pos), tok_str_len_at(toks, start_pos), src)
            if cps_gi != -1 { cur_stype = load_i64_at(g_glob_stype, cps_gi) }
        }
        // Override g_codegen_stype if variable/global lookup succeeded
        // For function calls (cur_stype==-1), keep what f64 builtins set
        if cur_stype != -1 {
            g_codegen_stype = cur_stype
        }
    }
    let cpi_more = 1
    loop cpi_more == 1 {
        let tok_type = tok_type_at(toks, pos[0])
        if tok_type == TOK_DOT {
            pos[0] = pos[0] + 1
            let field_start = tok_str_start_at(toks, pos[0])
            let field_len = tok_str_len_at(toks, pos[0])
            pos[0] = pos[0] + 1
            let sid = base_type(cur_stype)
            if sid >= 1000 and is_pointer_type(cur_stype) == 0 { sid = sid - 1000 }
            let fi = lookup_field_idx_any(stab, src, sid, field_start, field_len)
            if fi == -1 {
                // Method call dispatch: .method(args) → StructName_method(&self, args)
                if tok_type_at(toks, pos[0]) == TOK_LPAREN and g_genfn_buf[200] > 0 {
                    let mi = lookup_impl_method(src, field_start, field_len)
                    if mi >= 0 {
                        let mp = 201 + mi * 6
                        let mm_off = g_genfn_buf[mp + 4]
                        let mm_len = g_genfn_buf[mp + 5]
                        let mt = Token{}
                        mt.str_start = mm_off
                        mt.str_len = mm_len
                        let save_pos = g_main_pos
                        g_main_pos = pos[0]
                        let mc_result = live_codegen_method_call(&mt, bb, expr_id)
                        pos[0] = g_main_pos
                        g_main_pos = save_pos
                        ret mc_result
                    }
                }
                // Primitive method dispatch: i64/f64 method syntax
                if tok_type_at(toks, pos[0]) == TOK_LPAREN {
                    let prim_r = -1
                    if cur_stype == TYPE_I64 {
                        let sp = g_main_pos
                        g_main_pos = pos[0]
                        prim_r = try_prim_i64(bb, expr_id, field_start, field_len)
                        pos[0] = g_main_pos
                        g_main_pos = sp
                    }
                    if cur_stype == TYPE_F64 or cur_stype == TYPE_F32 {
                        let sp2 = g_main_pos
                        g_main_pos = pos[0]
                        prim_r = try_prim_f64(bb, expr_id, field_start, field_len)
                        pos[0] = g_main_pos
                        g_main_pos = sp2
                    }
                    if prim_r != -1 { ret prim_r }
                }
                ret expr_id
            }
            let off_id = emit_const(jfn, bb, TYPE_I64, g_field_byte_off[fi])
            let addr = emit_binop(jfn, bb, OP_ADD, expr_id, off_id)
            cur_stype = g_field_type[fi]
            cur_is_struct = g_field_is_struct[fi]
            let is_embedded_struct = 0
            if g_field_is_arr[fi] == 0 {
                if cur_is_struct == 1 { is_embedded_struct = 1 }
            }
            if g_field_is_arr[fi] == 1 or is_embedded_struct == 1 {
                expr_id = addr
            } else {
                cur_is_struct = 0
                let ld = Instr{}
                ld.op = OP_LOAD_MEM
                ld.operand0 = addr
                let raw_stype = cur_stype
                let load_itype = base_type(raw_stype)
                if is_pointer_type(raw_stype) { load_itype = TYPE_I64 }
                ld.itype = load_itype
                expr_id = emit(jfn, bb, &ld)
            }
        } else if tok_type == TOK_LBRACK {
            pos[0] = pos[0] + 1
            let idx_tok_pos = pos[0]
            let is_int_fast = tok_type_at(toks, idx_tok_pos) == TOK_INT and tok_type_at(toks, idx_tok_pos + 1) == TOK_RBRACK
            let imm_off = 0
            let idx_id = -1
            if is_int_fast {
                imm_off = tok_imm_at(toks, idx_tok_pos)
                pos[0] = pos[0] + 1
                pos[0] = pos[0] + 1
            } else {
                idx_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
                pos[0] = pos[0] + 1
            }
            let next_is_dot = tok_type_at(toks, pos[0]) == TOK_DOT
            let elem_sz_i = type_sizeof(cur_stype)
            // For struct element arrays, use the actual struct size
            if cur_is_struct == 1 {
                let gsz = g_struct_sizes[cur_stype]
                if gsz > 0 { elem_sz_i = gsz }
            }
            if next_is_dot {
                let bst = base_type(cur_stype)
                if bst >= 0 and bst < stab.cnt {
                    let struct_sz = stab.sizes[bst]
                    if struct_sz > 0 {
                        elem_sz_i = struct_sz
                    }
                }
            }
            if next_is_dot or cur_is_struct == 1 {
                let dot_addr = -1
                if is_int_fast {
                    let c = emit_const(jfn, bb, TYPE_I64, imm_off * elem_sz_i)
                    dot_addr = emit_binop(jfn, bb, OP_ADD, expr_id, c)
                } else {
                    let byte_off = emit_index_scale(bb, idx_id, elem_sz_i)
                    dot_addr = emit_binop(jfn, bb, OP_ADD, expr_id, byte_off)
                }
                expr_id = dot_addr
            } else {
                let ld = Instr{}
                ld.op = OP_LOAD_MEM
                ld.itype = base_type(cur_stype)
                if is_int_fast {
                    ld.operand0 = expr_id
                    ld.imm = imm_off * elem_sz_i
                    expr_id = emit(jfn, bb, &ld)
                } else {
                    let byte_off = emit_index_scale(bb, idx_id, elem_sz_i)
                    let arr_addr = emit_binop(jfn, bb, OP_ADD, expr_id, byte_off)
                    ld.operand0 = arr_addr
                    expr_id = emit(jfn, bb, &ld)
                }
            }
            cur_stype = base_type(cur_stype)
        } else {
            cpi_more = 0
        }
    }
    ret expr_id
}

// Handle generic call: name<type/N>(args). Called when < follows an identifier.
// pos[0] points to < token. t_start/t_len = identifier before <.
fn codegen_generic_call_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let gc2 = tok_type_at(toks, pos[0] + 1)
    let gc3 = tok_type_at(toks, pos[0] + 2)
    let t_start = tok_str_start_at(toks, pos[0] - 1)
    let t_len = tok_str_len_at(toks, pos[0] - 1)
    if (gc2 == TOK_I64 or gc2 == TOK_I32 or gc2 == TOK_I8 or gc2 == TOK_INT) and gc3 == TOK_GT {
        let gc_gi = lookup_genfn(src, t_start, t_len)
        if gc_gi >= 0 {
            if gc2 == TOK_INT { g_const_gen_val = tok_imm_at(toks, pos[0] + 1) }
            pos[0] = pos[0] + 3
            let gp = gc_gi * 7 + 1
            let gfn_off = g_genfn_buf[gp]
            let gfn_len = g_genfn_buf[gp + 1]
            let found = find_mangled_fn(gfn_off, gfn_len, gc2)
            if found == 1 {
                tok_set_type(toks, pos[0] - 1, TOK_IDENT)
                tok_set_start(toks, pos[0] - 1, g_found_mangle_off)
                tok_set_len(toks, pos[0] - 1, g_found_mangle_len)
            }
            ret codegen_call_inline(toks, pos, stab, src, jfn, bb)
        }
    }
    ret -1
}

fn codegen_primary_ident_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let t_start = tok_str_start_at(toks, pos[0])
    let t_len = tok_str_len_at(toks, pos[0])
    pos[0] = pos[0] + 1
    if tok_type_at(toks, pos[0]) == TOK_LPAREN {
        // Check if it's an iterator builtin before calling codegen_call_inline
        if t_len >= 3 and t_len <= 6 {
            let is_iter = 0
            if t_len == 4 and streq(src, t_start, 4, "each") == 1 { is_iter = 1 }
            if t_len == 3 and streq(src, t_start, 3, "map") == 1 { is_iter = 1 }
            if t_len == 6 and streq(src, t_start, 6, "reduce") == 1 { is_iter = 1 }
            if t_len == 6 and streq(src, t_start, 6, "filter") == 1 { is_iter = 1 }
            if t_len == 3 and streq(src, t_start, 3, "any") == 1 { is_iter = 1 }
            if t_len == 3 and streq(src, t_start, 3, "sum") == 1 { is_iter = 1 }
            if t_len == 5 and streq(src, t_start, 5, "count") == 1 { is_iter = 1 }
            if is_iter == 1 {
                g_iter_name_start = t_start
                g_iter_name_len = t_len
                ret codegen_iter_call_inline(toks, pos, stab, src, jfn, bb)
            }
        }
        ret codegen_call_inline(toks, pos, stab, src, jfn, bb)
    }
    // Generic call: name<type>(args) or name<N>(args) → skip <type/N>, call mangled name
    if tok_type_at(toks, pos[0]) == TOK_LT and g_genfn_buf[0] > 0 {
        let gc_result = codegen_generic_call_inline(toks, pos, stab, src, jfn, bb)
        if gc_result != -1 { ret gc_result }
    }
    pos[0] = pos[0] - 1
    let slot = lookup_slot_name(jfn, t_start, t_len)
    if slot == -1 {
        let gi = lookup_global2(t_start, t_len, src)
        if gi != -1 {
            pos[0] = pos[0] + 1
            let addr = emit_gaddr(jfn, bb, gi)
            let ldg = Instr{}
            ldg.op = OP_LOAD_MEM
            ldg.operand0 = addr
            ldg.itype = TYPE_I64
            ret emit(jfn, bb, &ldg)
        }
        let cval = lookup_const(src, t_start, t_len)
        if cval != -1 {
            pos[0] = pos[0] + 1
            ret emit_const(jfn, bb, TYPE_I64, cval)
        }
        // null literal
        if t_len == 4 and streq(src, t_start, 4, "null") == 1 {
            pos[0] = pos[0] + 1
            ret emit_const(jfn, bb, TYPE_I64, 0)
        }
        // true/false literals
        if t_len == 4 and streq(src, t_start, 4, "true") == 1 {
            pos[0] = pos[0] + 1
            ret emit_const(jfn, bb, TYPE_I64, 1)
        }
        if t_len == 5 and streq(src, t_start, 5, "false") == 1 {
            pos[0] = pos[0] + 1
            ret emit_const(jfn, bb, TYPE_I64, 0)
        }
        // Enum variant: EnumName.Variant or EnumName.Variant(args)
        if tok_type_at(toks, pos[0] + 1) == TOK_DOT and g_enum_buf != 0 {
            let ev_start = tok_str_start_at(toks, pos[0] + 2)
            let ev_len = tok_str_len_at(toks, pos[0] + 2)
            let ev_tag = lookup_enum_dot(src, t_start, t_len, ev_start, ev_len)
            if ev_tag >= 0 {
                pos[0] = pos[0] + 3
                if tok_type_at(toks, pos[0]) == TOK_LPAREN {
                    pos[0] = pos[0] + 1
                    let ev_mf = lookup_enum_max_fields(src, t_start, t_len)
                    let ev_sz = emit_const(jfn, bb, TYPE_I64, (1 + ev_mf) * 8)
                    let ev_alloc = Instr{}
                    ev_alloc.op = OP_ALLOC
                    ev_alloc.operand0 = ev_sz
                    let ev_ptr = emit(jfn, bb, &ev_alloc)
                    let ev_tag_id = emit_const(jfn, bb, TYPE_I64, ev_tag)
                    let ev_st = Instr{}
                    ev_st.op = OP_STORE_MEM
                    ev_st.itype = TYPE_I64
                    ev_st.operand0 = ev_tag_id
                    ev_st.operand1 = ev_ptr
                    emit(jfn, bb, &ev_st)
                    let ev_fi = 0
                    loop tok_type_at(toks, pos[0]) != TOK_RPAREN and tok_type_at(toks, pos[0]) != TOK_EOF {
                        let ev_arg = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
                        let ev_foff = emit_const(jfn, bb, TYPE_I64, (ev_fi + 1) * 8)
                        let ev_faddr = emit_binop(jfn, bb, OP_ADD, ev_ptr, ev_foff)
                        let ev_fst = Instr{}
                        ev_fst.op = OP_STORE_MEM
                        ev_fst.itype = TYPE_I64
                        ev_fst.operand0 = ev_arg
                        ev_fst.operand1 = ev_faddr
                        emit(jfn, bb, &ev_fst)
                        ev_fi = ev_fi + 1
                        if tok_type_at(toks, pos[0]) == TOK_COMMA { pos[0] = pos[0] + 1 }
                    }
                    if tok_type_at(toks, pos[0]) == TOK_RPAREN { pos[0] = pos[0] + 1 }
                    ret ev_ptr
                }
                ret emit_const(jfn, bb, TYPE_I64, ev_tag)
            }
        }
        // Result.Ok(val) / Result.Err(val) → allocate 16-byte struct {tag, val}
        if t_len == 6 and streq(src, t_start, 6, "Result") == 1 {
            if tok_type_at(toks, pos[0] + 1) == TOK_DOT {
                let rv_start = tok_str_start_at(toks, pos[0] + 2)
                let rv_len = tok_str_len_at(toks, pos[0] + 2)
                let res_tag = -1
                if rv_len == 2 and streq(src, rv_start, 2, "Ok") == 1 { res_tag = 0 }
                if rv_len == 3 and streq(src, rv_start, 3, "Err") == 1 { res_tag = 1 }
                if res_tag >= 0 and tok_type_at(toks, pos[0] + 3) == TOK_LPAREN {
                    pos[0] = pos[0] + 4
                    let res_val = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
                    if tok_type_at(toks, pos[0]) == TOK_RPAREN { pos[0] = pos[0] + 1 }
                    let sz16 = emit_const(jfn, bb, TYPE_I64, 16)
                    let alloc_i = Instr{}
                    alloc_i.op = OP_ALLOC
                    alloc_i.operand0 = sz16
                    let rptr = emit(jfn, bb, &alloc_i)
                    let tag_id = emit_const(jfn, bb, TYPE_I64, res_tag)
                    let st_tag = Instr{}
                    st_tag.op = OP_STORE_MEM
                    st_tag.itype = TYPE_I64
                    st_tag.operand0 = tag_id
                    st_tag.operand1 = rptr
                    emit(jfn, bb, &st_tag)
                    let off8 = emit_const(jfn, bb, TYPE_I64, 8)
                    let val_addr = emit_binop(jfn, bb, OP_ADD, rptr, off8)
                    let st_val = Instr{}
                    st_val.op = OP_STORE_MEM
                    st_val.itype = TYPE_I64
                    st_val.operand0 = res_val
                    st_val.operand1 = val_addr
                    emit(jfn, bb, &st_val)
                    ret rptr
                }
            }
        }
        // Associated function: StructName.method(args) in non-live path
        if tok_type_at(toks, pos[0] + 1) == TOK_DOT and g_genfn_buf[200] > 0 {
            let afn_off = tok_str_start_at(toks, pos[0] + 2)
            let afn_len = tok_str_len_at(toks, pos[0] + 2)
            if tok_type_at(toks, pos[0] + 3) == TOK_LPAREN {
                let afn_mi = lookup_impl_method2(src, t_start, t_len, afn_off, afn_len)
                if afn_mi >= 0 {
                    pos[0] = pos[0] + 3
                    let afn_mp = 201 + afn_mi * 6
                    tok_set_type(toks, pos[0] - 1, TOK_IDENT)
                    tok_set_start(toks, pos[0] - 1, g_genfn_buf[afn_mp + 4])
                    tok_set_len(toks, pos[0] - 1, g_genfn_buf[afn_mp + 5])
                    ret codegen_call_inline(toks, pos, stab, src, jfn, bb)
                }
            }
        }
        let nxt_tok_t = tok_type_at(toks, pos[0] + 1)
        if nxt_tok_t == TOK_LBRACE {
            let struct_alloc_sz = 0
            let ssid = lookup_struct(stab, src, t_start, t_len)
            if ssid >= 0 { struct_alloc_sz = stab.sizes[ssid] }
            pos[0] = pos[0] + 2
            let sdepth = 1
            loop sdepth > 0 and pos[0] < g_dbg_tok_cnt {
                let slbt = tok_type_at(toks, pos[0])
                if slbt == TOK_LBRACE { sdepth = sdepth + 1 }
                if slbt == TOK_RBRACE { sdepth = sdepth - 1 }
                pos[0] = pos[0] + 1
            }
            if struct_alloc_sz > 0 {
                let sz_id = emit_const(jfn, bb, TYPE_I64, struct_alloc_sz)
                let ai = Instr{}
                ai.op = OP_ALLOC
                ai.operand0 = sz_id
                ret emit(jfn, bb, &ai)
            }
            ret emit_const(jfn, bb, TYPE_I64, 0)
        }
        // StructName[N] — struct array allocation
        if tok_type_at(toks, pos[0] + 1) == TOK_LBRACK {
            let sa_sid = lookup_struct(stab, src, t_start, t_len)
            if sa_sid >= 0 {
                pos[0] = pos[0] + 2
                let sa_count = tok_imm_at(toks, pos[0])
                pos[0] = pos[0] + 1
                if tok_type_at(toks, pos[0]) == TOK_RBRACK { pos[0] = pos[0] + 1 }
                let sa_elem_sz = stab.sizes[sa_sid]
                let sa_total = sa_count * sa_elem_sz
                let sa_sz_id = emit_const(jfn, bb, TYPE_I64, sa_total)
                let sa_ins = Instr{}
                sa_ins.op = OP_ALLOC
                sa_ins.operand0 = sa_sz_id
                ret emit(jfn, bb, &sa_ins)
            }
        }
        ret -1
    }
    pos[0] = pos[0] + 1
    let ld = Instr{}
    ld.op = OP_LOAD
    ld.operand0 = slot
    let ret_emit = emit(jfn, bb, &ld)
    ret ret_emit
}

fn codegen_primary_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] < 0 or pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let t_type = tok_type_at(toks, pos[0])
    if t_type == TOK_INT {
        let t_imm = tok_imm_at(toks, pos[0])
        pos[0] = pos[0] + 1
        ret emit_const(jfn, bb, TYPE_I64, t_imm)
    }
    if t_type == TOK_TRUE {
        pos[0] = pos[0] + 1
        ret emit_const(jfn, bb, TYPE_I64, 1)
    }
    if t_type == TOK_FALSE {
        pos[0] = pos[0] + 1
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    if t_type == TOK_FLOAT {
        let t_fimm = tok_imm_at(toks, pos[0])
        pos[0] = pos[0] + 1
        g_codegen_stype = TYPE_F64
        let fl2_int = t_fimm >> 32
        let fl2_frac = (t_fimm >> 8) & 16777215
        let fl2_dig = t_fimm & 255
        let fl2_sc = 1
        let fl2_di = 0
        loop fl2_di < fl2_dig {
            fl2_sc = fl2_sc * 10
            fl2_di = fl2_di + 1
        }
        let fl2_c0 = emit_const(jfn, bb, TYPE_I64, fl2_int)
        let fl2_i2f0 = Instr{}
        fl2_i2f0.op = OP_I2F
        fl2_i2f0.operand0 = fl2_c0
        let fl2_f0 = emit(jfn, bb, &fl2_i2f0)
        if fl2_frac == 0 { ret fl2_f0 }
        let fl2_c1 = emit_const(jfn, bb, TYPE_I64, fl2_frac)
        let fl2_i2f1 = Instr{}
        fl2_i2f1.op = OP_I2F
        fl2_i2f1.operand0 = fl2_c1
        let fl2_f1 = emit(jfn, bb, &fl2_i2f1)
        let fl2_c2 = emit_const(jfn, bb, TYPE_I64, fl2_sc)
        let fl2_i2f2 = Instr{}
        fl2_i2f2.op = OP_I2F
        fl2_i2f2.operand0 = fl2_c2
        let fl2_f2 = emit(jfn, bb, &fl2_i2f2)
        let fl2_dv = emit_binop(jfn, bb, OP_FDIV, fl2_f1, fl2_f2)
        ret emit_binop(jfn, bb, OP_FADD, fl2_f0, fl2_dv)
    }
    // Lambda: fn(...) -> T { ... }
    // TOK_FN==0 so keyword classifier can't produce it; fn is lexed as TOK_IDENT
    if t_type == TOK_IDENT and tok_str_len_at(toks, pos[0]) == 2 and streq(src, tok_str_start_at(toks, pos[0]), 2, "fn") == 1 and tok_type_at(toks, pos[0] + 1) == TOK_LPAREN {
        ret codegen_lambda_inline(toks, pos, src, jfn, bb)
    }
    if t_type == TOK_IDENT {
        ret codegen_primary_ident_inline(toks, pos, stab, src, jfn, bb)
    }
    if t_type == TOK_SPAWN {
        pos[0] = pos[0] + 1
        let sp_fn_start = tok_str_start_at(toks, pos[0])
        let sp_fn_len = tok_str_len_at(toks, pos[0])
        pos[0] = pos[0] + 1
        expect(TOK_LPAREN)
        expect(TOK_RPAREN)
        ret emit_spawn_jir(jfn, bb, sp_fn_start, sp_fn_len)
    }
    if t_type == TOK_LPAREN {
        pos[0] = pos[0] + 1
        let inner_id = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        expect(TOK_RPAREN)
        ret inner_id
    }
    if t_type == TOK_STR or t_type == TOK_RAW_STR {
        if t_type == TOK_RAW_STR { g_raw_str_mode = 1 }
        let s_id = emit_strlit_raw(jfn, bb, tok_str_start_at(toks, pos[0]), tok_str_len_at(toks, pos[0]))
        pos[0] = pos[0] + 1
        ret s_id
    }
    // Local array: type[N] — e.g. let regs = i32[7]
    if t_type == TOK_I64 or t_type == TOK_I32 or t_type == TOK_I8 {
        let arr_next_t = tok_type_at(toks, pos[0] + 1)
        if arr_next_t == TOK_LBRACK {
            let arr_elem_sz = 8
            if t_type == TOK_I32 { arr_elem_sz = 4 }
            if t_type == TOK_I8  { arr_elem_sz = 1 }
            pos[0] = pos[0] + 2
            let arr_count = tok_imm_at(toks, pos[0])
            pos[0] = pos[0] + 1
            pos[0] = pos[0] + 1
            let arr_total = arr_count * arr_elem_sz
            let arr_sz_id = emit_const(jfn, bb, TYPE_I64, arr_total)
            let arr_ins = Instr{}
            arr_ins.op = OP_ALLOC
            arr_ins.operand0 = arr_sz_id
            ret emit(jfn, bb, &arr_ins)
        }
    }
    ret -1
}

fn codegen_arg_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let next_tok = peek_token(toks, pos[0])
    let arg_tt = tok_type_at(toks, pos[0])
    if arg_tt == TOK_STR or arg_tt == TOK_RAW_STR {
        if arg_tt == TOK_RAW_STR { g_raw_str_mode = 1 }
        let a_id = emit_strlit_raw(jfn, bb, tok_str_start_at(toks, pos[0]), tok_str_len_at(toks, pos[0]))
        pos[0] = pos[0] + 1
        ret a_id
    }
    if tok_type_at(toks, pos[0]) == TOK_INT and (next_tok == TOK_COMMA or next_tok == TOK_RPAREN) {
        let a_id = emit_const(jfn, bb, TYPE_I64, tok_imm_at(toks, pos[0]))
        pos[0] = pos[0] + 1
        ret a_id
    }
    if tok_type_at(toks, pos[0]) == TOK_IDENT and (next_tok == TOK_COMMA or next_tok == TOK_RPAREN) {
        let a_start = tok_str_start_at(toks, pos[0])
        let a_len = tok_str_len_at(toks, pos[0])
        pos[0] = pos[0] + 1
        let aslot = lookup_slot_name(jfn, a_start, a_len)
        if aslot != -1 {
            let ald = Instr{}
            ald.op = OP_LOAD
            ald.operand0 = aslot
            ret emit(jfn, bb, &ald)
        }
        let agi = lookup_global2(a_start, a_len, src)
        if agi != -1 {
            let aaddr = emit_gaddr(jfn, bb, agi)
            let aldg = Instr{}
            aldg.op = OP_LOAD_MEM
            aldg.operand0 = aaddr
            ret emit(jfn, bb, &aldg)
        }
        let acval = lookup_const(src, a_start, a_len)
        if acval != -1 {
            ret emit_const(jfn, bb, TYPE_I64, acval)
        }
        // null literal
        if a_len == 4 and streq(src, a_start, 4, "null") == 1 {
            ret emit_const(jfn, bb, TYPE_I64, 0)
        }
        // true/false literals
        if a_len == 4 and streq(src, a_start, 4, "true") == 1 {
            ret emit_const(jfn, bb, TYPE_I64, 1)
        }
        if a_len == 5 and streq(src, a_start, 5, "false") == 1 {
            ret emit_const(jfn, bb, TYPE_I64, 0)
        }
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    ret codegen_expr_inline(toks, pos, stab, src, jfn, bb)
}

fn codegen_lambda_inline(toks: &Token, pos: &i64, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    // pos[0] points at TOK_FN. Next is TOK_LPAREN.
    let lam_start = pos[0]
    pos[0] = pos[0] + 1
    // Skip to matching '}'
    let depth = 0
    let found = 0
    loop found == 0 {
        let lt = tok_type_at(toks, pos[0])
        if lt == TOK_LBRACE { depth = depth + 1 }
        if lt == TOK_RBRACE {
            depth = depth - 1
            if depth == 0 {
                pos[0] = pos[0] + 1
                found = 1
            }
        }
        if lt == TOK_EOF { found = 1 }
        if found == 0 { pos[0] = pos[0] + 1 }
    }
    let lam_end = pos[0]
    // Generate name "__lambda_N" in source buffer
    let nm_off = g_runtime_src_len
    poke_byte(src, nm_off, 95)
    poke_byte(src, nm_off + 1, 95)
    poke_byte(src, nm_off + 2, 108)
    poke_byte(src, nm_off + 3, 97)
    poke_byte(src, nm_off + 4, 109)
    poke_byte(src, nm_off + 5, 98)
    poke_byte(src, nm_off + 6, 100)
    poke_byte(src, nm_off + 7, 97)
    poke_byte(src, nm_off + 8, 95)
    let nm_len = 9
    let lnum = g_lambda_cnt
    if lnum < 10 {
        poke_byte(src, nm_off + nm_len, 48 + lnum)
        nm_len = nm_len + 1
    } else {
        let tens = lnum / 10
        let ones = lnum - (tens * 10)
        poke_byte(src, nm_off + nm_len, 48 + tens)
        nm_len = nm_len + 1
        poke_byte(src, nm_off + nm_len, 48 + ones)
        nm_len = nm_len + 1
    }
    g_runtime_src_len = nm_off + nm_len
    // Capture analysis: find enclosing-scope vars used in lambda body
    let li = g_lambda_cnt
    let cap_cnt = 0
    let cap_base = li * 8
    // Collect lambda param names (between first LPAREN and RPAREN)
    let pp = lam_start + 2
    let pp_starts: i64[8]
    let pp_lens: i64[8]
    let pp_cnt = 0
    loop tok_type_at(toks, pp) != TOK_RPAREN and pp < lam_end {
        if tok_type_at(toks, pp) == TOK_IDENT and tok_type_at(toks, pp + 1) == TOK_COLON {
            if pp_cnt < 8 {
                pp_starts[pp_cnt] = tok_str_start_at(toks, pp)
                pp_lens[pp_cnt] = tok_str_len_at(toks, pp)
                pp_cnt = pp_cnt + 1
            }
        }
        pp = pp + 1
    }
    // Find body start (first LBRACE)
    let bp = lam_start + 1
    loop tok_type_at(toks, bp) != TOK_LBRACE and bp < lam_end { bp = bp + 1 }
    bp = bp + 1
    // Scan body for captured variables
    loop bp < lam_end - 1 {
        if tok_type_at(toks, bp) == TOK_IDENT {
            let cs = tok_str_start_at(toks, bp)
            let cl = tok_str_len_at(toks, bp)
            // Skip if it's a lambda param
            let is_p = 0
            let pi = 0
            loop pi < pp_cnt {
                if pp_lens[pi] == cl and str_match(src, pp_starts[pi], cs, cl) == 1 { is_p = 1 }
                pi = pi + 1
            }
            if is_p == 0 {
                // Check if in enclosing function's var table
                let slot = lookup_slot_name(jfn, cs, cl)
                if slot != -1 {
                    // Check not already captured
                    let dup = 0
                    let di = 0
                    loop di < cap_cnt {
                        let dx = 64 + cap_base + di
                        if g_lambda_name_offs[dx] == cl and str_match(src, g_lambda_ends[dx], cs, cl) == 1 { dup = 1 }
                        di = di + 1
                    }
                    if dup == 0 and cap_cnt < 8 {
                        let cx = 64 + cap_base + cap_cnt
                        g_lambda_ends[cx] = cs
                        g_lambda_name_offs[cx] = cl
                        cap_cnt = cap_cnt + 1
                    }
                }
            }
        }
        bp = bp + 1
    }
    g_lambda_starts[64 + li] = cap_cnt
    // Stash for deferred compilation
    g_lambda_starts[li] = lam_start
    g_lambda_ends[li] = lam_end
    g_lambda_name_offs[li] = nm_off
    g_lambda_name_lens[li] = nm_len
    g_lambda_cnt = g_lambda_cnt + 1
    // Emit fn_addr for the lambda
    let fins = Instr{}
    fins.op = OP_FN_ADDR
    fins.str_start = nm_off
    fins.str_len = nm_len
    let fn_id = emit(jfn, bb, &fins)
    // If no captures and not forced, return fn_addr directly
    if cap_cnt == 0 and g_force_closure_wrap == 0 { ret fn_id }
    // Mark force-wrapped zero-capture lambdas with -1 sentinel
    if cap_cnt == 0 and g_force_closure_wrap == 1 {
        g_lambda_starts[64 + li] = -1
    }
    // Wrap in closure object: [fn_ptr, cap0, cap1, ...]
    let sz_id = emit_const(jfn, bb, TYPE_I64, (1 + cap_cnt) * 8)
    let cls_alloc = Instr{}
    cls_alloc.op = OP_ALLOC
    cls_alloc.operand0 = sz_id
    let cls_id = emit(jfn, bb, &cls_alloc)
    // Store fn_ptr at [cls + 0]
    let st0 = Instr{}
    st0.op = OP_STORE_MEM
    st0.operand0 = fn_id
    st0.operand1 = cls_id
    st0.itype = TYPE_I64
    emit(jfn, bb, &st0)
    // Store each captured value
    let ci = 0
    loop ci < cap_cnt {
        let cx = 64 + cap_base + ci
        let cslot = lookup_slot_name(jfn, g_lambda_ends[cx], g_lambda_name_offs[cx])
        let cld = Instr{}
        cld.op = OP_LOAD
        cld.operand0 = cslot
        let cval = emit(jfn, bb, &cld)
        let coff = emit_const(jfn, bb, TYPE_I64, (ci + 1) * 8)
        let caddr = emit_binop(jfn, bb, OP_ADD, cls_id, coff)
        let cst = Instr{}
        cst.op = OP_STORE_MEM
        cst.operand0 = cval
        cst.operand1 = caddr
        cst.itype = TYPE_I64
        emit(jfn, bb, &cst)
        ci = ci + 1
    }
    ret cls_id
}

fn codegen_call_closure_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    // call_closure(cls, args...) -> load fn_ptr from [cls+0], call fn_ptr(cls, args...)
    let cls_id = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
    // Load fn_ptr from [cls + 0]
    let ld = Instr{}
    ld.op = OP_LOAD_MEM
    ld.operand0 = cls_id
    ld.itype = TYPE_I64
    let fn_ptr = emit(jfn, bb, &ld)
    // cls is the first arg to the thunk
    let cc_argc = 2
    let cc_a1 = cls_id
    let cc_a2 = -1
    let cc_a3 = -1
    let cc_a4 = -1
    let cc_a5 = -1
    loop tok_type_at(toks, pos[0]) == TOK_COMMA {
        pos[0] = pos[0] + 1
        let cc_a = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
        if cc_argc == 2 { cc_a2 = cc_a }
        if cc_argc == 3 { cc_a3 = cc_a }
        if cc_argc == 4 { cc_a4 = cc_a }
        if cc_argc == 5 { cc_a5 = cc_a }
        cc_argc = cc_argc + 1
    }
    expect(TOK_RPAREN)
    let cc_ins = Instr{}
    cc_ins.op = OP_CALL_IND
    cc_ins.str_start = -1
    cc_ins.operand0 = fn_ptr
    cc_ins.operand1 = cc_a1
    cc_ins.operand2 = cc_a2
    cc_ins.operand3 = cc_argc
    cc_ins.bb_target0 = cc_a3
    cc_ins.bb_target1 = cc_a4
    cc_ins.imm = cc_a5
    ret emit(jfn, bb, &cc_ins)
}

fn codegen_call_fn_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    let cf_ptr = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
    let cf_argc = 1
    let cf_a1 = -1
    let cf_a2 = -1
    let cf_a3 = -1
    let cf_a4 = -1
    let cf_a5 = -1
    loop tok_type_at(toks, pos[0]) == TOK_COMMA {
        pos[0] = pos[0] + 1
        let cf_a = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
        if cf_argc == 1 { cf_a1 = cf_a }
        if cf_argc == 2 { cf_a2 = cf_a }
        if cf_argc == 3 { cf_a3 = cf_a }
        if cf_argc == 4 { cf_a4 = cf_a }
        if cf_argc == 5 { cf_a5 = cf_a }
        cf_argc = cf_argc + 1
    }
    expect(TOK_RPAREN)
    let cf_ins = Instr{}
    cf_ins.op = OP_CALL_IND
    cf_ins.str_start = -1
    cf_ins.operand0 = cf_ptr
    cf_ins.operand1 = cf_a1
    cf_ins.operand2 = cf_a2
    cf_ins.operand3 = cf_argc
    cf_ins.bb_target0 = cf_a3
    cf_ins.bb_target1 = cf_a4
    cf_ins.imm = cf_a5
    ret emit(jfn, bb, &cf_ins)
}

fn codegen_iter_call_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    // Parse arguments for iterator builtins (2-4 args)
    // Force closure wrapping for lambda args so iterator emit functions can use OP_CALL_IND
    g_force_closure_wrap = 1
    pos[0] = pos[0] + 1
    let arg_cnt = 0
    let arg0 = -1
    let arg1 = -1
    let arg2 = -1
    let arg3 = -1
    loop tok_type_at(toks, pos[0]) != TOK_RPAREN and pos[0] < g_dbg_tok_cnt {
        let a = codegen_expr_inline(toks, pos, stab, src, jfn, bb)
        if arg_cnt == 0 { arg0 = a }
        if arg_cnt == 1 { arg1 = a }
        if arg_cnt == 2 { arg2 = a }
        if arg_cnt == 3 { arg3 = a }
        arg_cnt = arg_cnt + 1
        if tok_type_at(toks, pos[0]) == TOK_COMMA {
            pos[0] = pos[0] + 1
        }
    }
    g_force_closure_wrap = 0
    pos[0] = pos[0] + 1
    g_jfn = jfn
    g_iter_bb = bb
    g_iter_a0 = arg0
    g_iter_a1 = arg1
    g_iter_a2 = arg2
    g_iter_a3 = arg3
    let ns_val = g_iter_name_start
    let nl_val = g_iter_name_len
    check_iter_dispatch(src, ns_val, nl_val)
    ret g_iter_result
}

fn codegen_call_inline(toks: &Token, pos: &i64, stab: &StructTable, src: &i8, jfn: &JirFunction, bb: i64) -> i64 {
    if pos[0] <= 0 or pos[0] >= g_dbg_tok_cnt {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }
    let name_start = tok_str_start_at(toks, pos[0] - 1)
    let name_len = tok_str_len_at(toks, pos[0] - 1)
    expect(TOK_LPAREN)
    // fn_addr(name) — argument is function name identifier, not expression
    if name_len == 7 and streq(src, name_start, 7, "fn_addr") == 1 {
        let fa_start = tok_str_start_at(toks, pos[0])
        let fa_len = tok_str_len_at(toks, pos[0])
        pos[0] = pos[0] + 1
        expect(TOK_RPAREN)
        let fins = Instr{}
        fins.op = OP_FN_ADDR
        fins.str_start = fa_start
        fins.str_len = fa_len
        ret emit(jfn, bb, &fins)
    }
    // call_fn(fn_ptr, args...) — indirect call via OP_CALL_IND
    if name_len == 7 and streq(src, name_start, 7, "call_fn") == 1 {
        ret codegen_call_fn_inline(toks, pos, stab, src, jfn, bb)
    }
    if name_len == 12 and streq(src, name_start, 12, "call_closure") == 1 {
        ret codegen_call_closure_inline(toks, pos, stab, src, jfn, bb)
    }
    let arg_cnt = 0
    let arg0 = -1
    let arg1 = -1
    let arg2 = -1
    let arg3 = -1
    let arg4 = -1
    let arg5 = -1
    loop tok_type_at(toks, pos[0]) != TOK_RPAREN and tok_type_at(toks, pos[0]) != TOK_EOF {
        let a_id = codegen_arg_inline(toks, pos, stab, src, jfn, bb)
        if arg_cnt == 0 {
            arg0 = a_id
        } else if arg_cnt == 1 {
            arg1 = a_id
        } else if arg_cnt == 2 {
            arg2 = a_id
        } else if arg_cnt == 3 {
            arg3 = a_id
        } else if arg_cnt == 4 {
            arg4 = a_id
        } else if arg_cnt == 5 {
            arg5 = a_id
        }
        arg_cnt = arg_cnt + 1
        if arg_cnt > 6 {
            // Recovery: skip malformed extra args until call close.
            loop tok_type_at(toks, pos[0]) != TOK_RPAREN and tok_type_at(toks, pos[0]) != TOK_EOF {
                pos[0] = pos[0] + 1
            }
            arg_cnt = 6
        }
        if tok_type_at(toks, pos[0]) == TOK_COMMA {
            pos[0] = pos[0] + 1
        }
    }
    expect(TOK_RPAREN)

    // Iterator builtins — dispatch via helper to keep function size small
    // Iterator dispatch — return moved outside nested if
    if name_len >= 3 and name_len <= 6 {
        g_jfn = jfn
        g_iter_bb = bb
        g_iter_a0 = arg0
        g_iter_a1 = arg1
        g_iter_a2 = arg2
        g_iter_a3 = arg3
        check_iter_dispatch(src, name_start, name_len)
    }
    // Type check: verify argument count (skip if either side exceeds 6-arg codegen limit)
    if g_fn_param_cnt_tbl != 0 {
        let tc_fi = resolve_top_fn_index(src, name_start, name_len, g_fn_name_off_tbl, g_fn_name_len_tbl)
        if tc_fi >= 0 and tc_fi < 512 {
            let expected_cnt = load_i64_at(g_fn_param_cnt_tbl, tc_fi)
            if expected_cnt > 0 and expected_cnt <= 6 and arg_cnt < expected_cnt {
                report_error("too few arguments in function call")
            }
        }
    }

    if name_len == 11 and streq(src, name_start, 11, "alloc_pages") == 1 {
        let pages_id = arg0
        if pages_id == -1 {
            pages_id = emit_const(jfn, bb, TYPE_I64, 0)
        }
        let page_sz = emit_const(jfn, bb, TYPE_I64, 4096)
        let alloc_sz = emit_binop(jfn, bb, OP_MUL, pages_id, page_sz)
        let ins = Instr{}
        ins.op = OP_ALLOC
        ins.operand0 = alloc_sz
        ret emit(jfn, bb, &ins)
    }

    if name_len == 9 and streq(src, name_start, 9, "arena_new") == 1 {
        ret emit_arena_new_jir(jfn, bb, arg0)
    }
    if name_len == 11 and streq(src, name_start, 11, "arena_alloc") == 1 {
        ret emit_arena_alloc_jir(jfn, bb, arg0, arg1)
    }
    if name_len == 11 and streq(src, name_start, 11, "arena_reset") == 1 {
        ret emit_arena_reset_jir(jfn, bb, arg0)
    }
    if name_len == 13 and streq(src, name_start, 13, "arena_destroy") == 1 {
        ret emit_arena_destroy_jir(jfn, bb, arg0, arg1)
    }

    // Linear types: consume() marks a linear variable as consumed
    if name_len == 7 and streq(src, name_start, 7, "consume") == 1 {
        ret emit_const(jfn, bb, TYPE_I64, 0)
    }

    if name_len == 9 and streq(src, name_start, 9, "print_int") == 1 {
        emit_print_int(jfn, bb, arg0)
        ret arg0
    }

    // Atomic builtins
    if name_len == 11 and streq(src, name_start, 11, "atomic_load") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_LOAD
        ins.operand0 = arg0
        ret emit(jfn, bb, &ins)
    }
    if name_len == 12 and streq(src, name_start, 12, "atomic_store") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_STORE
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(jfn, bb, &ins)
    }
    if name_len == 14 and streq(src, name_start, 14, "atomic_cmpxchg") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_CAS
        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ret emit(jfn, bb, &ins)
    }
    if name_len == 16 and streq(src, name_start, 16, "atomic_fetch_add") == 1 {
        let ins = Instr{}
        ins.op = OP_ATOMIC_ADD
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(jfn, bb, &ins)
    }
    if name_len == 5 and streq(src, name_start, 5, "rdtsc") == 1 {
        let ins = Instr{}
        ins.op = OP_RDTSC
        ret emit(jfn, bb, &ins)
    }
    if name_len == 10 and streq(src, name_start, 10, "ctx_switch") == 1 {
        let ins = Instr{}
        ins.op = OP_CTX_SWITCH
        ins.operand0 = arg0
        ins.operand1 = arg1
        ret emit(jfn, bb, &ins)
    }

    // Channel builtins
    if name_len == 8 and streq(src, name_start, 8, "chan_new") == 1 {
