; =============================================================================
; Jda Stage 1 Compiler - Written in Jda
; =============================================================================
; This is the first self-hosted Jda compiler.
; It is written in Jda and compiled by the Stage 0 bootstrapper.
;
; Stage 1 supports richer Jda syntax:
;   - Variables: let x = expr
;   - Functions: fn name(params) -> type { body }
;   - Loops: loop condition { body }
;   - Conditionals: if cond { body } else { body }
;   - Structs: struct Name { field: type }
;   - Pattern matching: match x { val => expr }
;   - Result type: ok(val) / err(msg)  (no exceptions)
;   - Print: 
;   - Inline syscall: syscall(nr, a, b, c) -> i64
;
; Stage 1 outputs JIR which is then lowered to x86-64 machine code.
; =============================================================================

; ============================================================
; 0. CONSTANTS
; ============================================================

; Token type constants
const TOK_FN      = 0
const TOK_LET     = 1
const TOK_IF      = 2
const TOK_ELSE    = 3
const TOK_LOOP    = 4
const TOK_RET     = 5
const TOK_STRUCT  = 6
const TOK_MATCH   = 7
const TOK_PRINT   = 8
const TOK_SYSCALL = 9
const TOK_IDENT   = 10
const TOK_INT     = 11
const TOK_STR     = 12
const TOK_LPAREN  = 13
const TOK_RPAREN  = 14
const TOK_LBRACE  = 15
const TOK_RBRACE  = 16
const TOK_LBRACK  = 17
const TOK_RBRACK  = 18
const TOK_COMMA   = 19
const TOK_COLON   = 20
const TOK_SEMI    = 21
const TOK_ARROW   = 22
const TOK_EQ      = 23
const TOK_EQEQ    = 24
const TOK_NEQ     = 25
const TOK_LT      = 26
const TOK_GT      = 27
const TOK_PLUS    = 28
const TOK_MINUS   = 29
const TOK_STAR    = 30
const TOK_SLASH   = 31
const TOK_AMP     = 32
const TOK_DOT     = 33
const TOK_FATARROW= 34
const TOK_GTE     = 35
const TOK_LTE     = 36
const TOK_AND     = 37
const TOK_OR      = 38
const TOK_PIPE    = 39  ; Bitwise OR (|)
const TOK_TILDE   = 40  ; Bitwise NOT token
const TOK_SHR     = 41  ; Right shift (>>)
const TOK_SHL     = 42  ; Left shift (<<)
const TOK_CONST   = 43
const TOK_EOF     = 44
; Type keyword tokens (classified by lexer)
const TOK_I64     = 45
const TOK_I32     = 46
const TOK_I8      = 47
const TOK_F64     = 48

; AST node types
const NODE_FN     = 0
const NODE_LET    = 1
const NODE_IF     = 2
const NODE_LOOP   = 3
const NODE_CALL   = 4
const NODE_BINOP  = 5
const NODE_IDENT  = 6
const NODE_INT    = 7
const NODE_STR    = 8
const NODE_RET    = 9
const NODE_BLOCK  = 10
const NODE_STRUCT = 11
const NODE_FIELD  = 12
const NODE_MATCH  = 13
const NODE_PRINT  = 14
const NODE_SYSCALL= 15
const NODE_FIELD_STORE = 16
const NODE_STRUCT_INIT = 17
const NODE_ADDR   = 18
const NODE_ARRAY_ALLOC = 19
const NODE_INDEX_STORE = 20
const NODE_DEREF  = 21

; Type system
const TYPE_VOID   = 0
const TYPE_I64    = 1
const TYPE_I32    = 2
const TYPE_I8     = 3
const TYPE_F64    = 4
const TYPE_PTR    = 5

; Pointer type flag (bitmask)
const TYPE_PTR_FLAG = 65536

; Helper types for pointers
const TYPE_PTR_I64 = 65537
const TYPE_PTR_I32 = 65538
const TYPE_PTR_I8  = 65539

; JIR opcodes
const OP_CONST    = 0
const OP_ADD      = 1
const OP_SUB      = 2
const OP_MUL      = 3
const OP_DIV      = 4
const OP_NEG      = 5
const OP_CMP_EQ   = 6
const OP_CMP_NE   = 7
const OP_CMP_LT   = 8
const OP_CMP_GT   = 9
const OP_CMP_GTE  = 10
const OP_CMP_LTE  = 11
const OP_AND      = 12
const OP_OR       = 13
const OP_RET      = 14
const OP_BR       = 15
const OP_JMP      = 16
const OP_CALL     = 17
const OP_SYSCALL  = 18
const OP_STRLIT   = 19
const OP_STRLEN   = 20
const OP_STORE    = 21
const OP_LOAD     = 22
const OP_ADDR     = 23
const OP_LOAD_MEM = 24
const OP_STORE_MEM= 25
const OP_ALLOC    = 26
const OP_PRINT_INT= 27
const OP_SHR      = 28  ; Logical right shift
const OP_SHL      = 29  ; Left shift
const OP_GADDR    = 30
const OP_ARGV_BASE= 31
const OP_ARGC_GET = 32

; x86-64 physical register numbers (Intel encoding)
const PHYS_RAX = 0
const PHYS_RCX = 1
const PHYS_RDX = 2
const PHYS_RBX = 3
const PHYS_RSP = 4
const PHYS_RBP = 5
const PHYS_RSI = 6
const PHYS_RDI = 7
const PHYS_R8  = 8
const PHYS_R9  = 9
const PHYS_R10 = 10
const PHYS_R11 = 11
const PHYS_R12 = 12

; Allocatable pool size: rax rcx rdx rsi rdi r10 r11  (rbx excluded: not saved by emit_save_pool)
const N_ALLOC_REGS = 7

; ============================================================
; 1. STRUCT DEFINITIONS
; ============================================================

struct Token {
    type:      i64
    line:      i64
    str_start: i64
    str_len:   i64
    imm:       i64
}

struct Node {
    node_type: i64
    op:        i64
    imm:       i64
    data_type: i64
    param_cnt: i64
    child_cnt: i64
    ret_type:  i64
    token:     i64
    token2:    i64
    child0:    &Node
    child1:    &Node
    child2:    &Node
    child3:    &Node
    children:  i64
}

struct Instr {
    op:         i64
    itype:      i64
    id:         i64
    dead:       i64
    operand0:   i64
    operand1:   i64
    operand2:   i64
    operand3:   i64
    imm:        i64
    str_start:  i64
    str_len:    i64
    bb_target0: i64
    bb_target1: i64
}

struct BasicBlock {
    id:        i64
    instrs:    Instr[2048]
    instr_cnt: i64
    label_off: i64
}

struct VarEntry {
    name_start: i64
    name_len:   i64
    slot_off:   i64
    stype:      i64
}

struct JirFunction {
    src:        &i8
    src_len:    i64
    blocks:     BasicBlock[256]
    block_cnt:  i64
    vars:       VarEntry[256]
    var_cnt:    i64
    next_slot_off: i64
    next_id:    i64
    strtab:     i8[4096]
    strtab_pos: i64
    stab:       &StructTable
    param_cnt:  i64
    param_slots:i64[16]
}

struct ConstVal {
    found: i64
    val:   i64
}

struct Fixup {
    code_off:  i64
    target_bb: i64
    kind:      i64
    str_len:   i64
}

struct RegAlloc {
    pool:      i32[8]
    val2reg:   i32[8192]
    reg2val:   i64[8]
    spill_off: i64[8192]
    sp_top:    i64
}

struct LowerCtx {
    ra:         RegAlloc
    fixups:     Fixup[8192]
    fix_cnt:    i64
    bb_offsets: i64[256]
    use_cnt:    i32[8192]
}

struct StructTable {
    cnt:        i64
    names:      i64[64]
    nlens:      i64[64]
    fcnts:      i64[64]
    sizes:      i64[64]
    fbases:     i64[64]
    field_cnt:  i64
    fnames:     i64[4096]
    flens:      i64[4096]
    foffs:      i64[4096]
    ftypes:     i64[4096]
    fis_array:  i64[4096]
    fowners:    i64[4096]
}

; Global constant table pointer (removed ConstTable struct - use separate arrays below)
let g_const_name_off_tbl: &i64 = 0
let g_const_name_len_tbl: &i64 = 0
let g_const_val_tbl: &i64 = 0
let g_const_cnt = 0
; Flat struct name/size tables (avoids jda0 struct-array-field offset bug)
let g_struct_name_off: &i64 = 0
let g_struct_name_len: &i64 = 0
let g_struct_flat_cnt = 0
let g_struct_sizes:    &i64 = 0
; Flat field table (avoids jda0 struct-array-field offset bug in lookup_field_idx_any)
let g_field_owner:    &i64 = 0
let g_field_name_off: &i64 = 0
let g_field_name_len: &i64 = 0
let g_field_byte_off: &i64 = 0
let g_field_type:     &i64 = 0
let g_field_is_arr:    &i64 = 0
let g_field_is_struct: &i64 = 0
let g_field_total_cnt = 0
let g_dbg_fi = 0
let g_dbg_toks: &Token = 0
let g_dbg_toks_init: &Token = 0
let g_dbg_tok_cnt = 0
let g_small_seeded = 0
let g_small_has_main = 0
let g_scan_tok_cnt = 0
let g_more_top = 0
let g_main_pos = 0
let g_panic_pos = 0
let g_cur_fn_name_start = 0
let g_cur_fn_name_len = 0
let g_cur_fn_end = 0
let g_top_fn_cnt = 0
let g_top_main_idx = -1
let g_dbg_main_prints = 0
let g_dbg_main_lets = 0
let g_dbg_main_exprs = 0
let g_dbg_main_steps = 0
let g_small_err_loop = 0
let g_small_err_branch = 0
let g_glob_name_off: &i64 = 0
let g_glob_name_len: &i64 = 0
let g_glob_off: &i64      = 0
let g_glob_size: &i64     = 0
let g_glob_stype: &i64    = 0
let g_glob_is_addr: &i64  = 0
let g_glob_cnt      = 0
let g_glob_total_sz = 0
let g_tmp_let_gidx = 0
let g_tmp_let_stype = 0
let g_tmp_let_is_addr = 0
let g_emit_glob_buf: &i8 = 0
let g_emit_glob_len = 0
let g_cmp_src: &i8 = 0
let g_lex_tmp_emit = 0
let g_lex_tmp_type = 0
let g_lex_tmp_start = 0
let g_lex_tmp_len = 0
let g_cmp_name_start = 0
let g_cmp_name_len = 0
let g_lex_count_ptr = 0
let g_lex_count = 0
let g_lex_src_len = 0
let g_lex_src_ptr: &i8 = 0
let g_lex_pos_i = 0
let g_lex_cur_char: i64 = 0
let g_lex_handled: i64 = 0
let g_lower_is_main = 0
; Token write cursor (avoids 5-arg calls and local-ptr bugs)
let g_ltw_base: &i64 = 0
let g_ltw_off: i64 = 0
let g_ltw_start: i64 = 0
let g_ltw_len: i64 = 0
let g_ltw_val: i64 = 0
let g_ltw_tmp: i64 = 0
let g_lex_adv: i64 = 0
let g_lex_line: i64 = 1
let g_fn_lbrace_tmp = 0
let g_fn_rbrace_tmp = -1
let g_skip_fn_body_compile_tmp = 0
let g_small_work_jfn: &JirFunction = 0
let g_small_work_bb = 0
let g_large_mode = 0
let g_fn_name_off_tbl: &i64 = 0
let g_fn_name_len_tbl: &i64 = 0
let g_fn_code_off_tbl: &i64 = 0
let g_fn_ret_type_tbl: &i64 = 0
let g_fn_param_cnt_tbl: &i64 = 0
let g_last_fn_code_off: i64 = 0
let g_cur_fn_ret_type: i64 = 0
