// ============================================================
// 1. STRUCT DEFINITIONS
// ============================================================

struct Token {
    type:      i64
    line:      i64
    str_start: i64
    str_len:   i64
    imm:       i64
}

struct Node {
    node_type: i64
    op:        i64
    imm:       i64
    data_type: i64
    param_cnt: i64
    child_cnt: i64
    ret_type:  i64
    token:     i64
    token2:    i64
    child0:    &Node
    child1:    &Node
    child2:    &Node
    child3:    &Node
    children:  i64
}

struct Instr {
    op:         i64
    itype:      i64
    id:         i64
    dead:       i64
    operand0:   i64
    operand1:   i64
    operand2:   i64
    operand3:   i64
    imm:        i64
    str_start:  i64
    str_len:    i64
    bb_target0: i64
    bb_target1: i64
}

struct BasicBlock {
    id:        i64
    instrs:    Instr[2048]
    instr_cnt: i64
    label_off: i64
}

struct VarEntry {
    name_start: i64
    name_len:   i64
    slot_off:   i64
    stype:      i64
}

struct JirFunction {
    src:        &i8
    src_len:    i64
    blocks:     BasicBlock[256]
    block_cnt:  i64
    vars:       VarEntry[256]
    var_cnt:    i64
    next_slot_off: i64
    next_id:    i64
    strtab:     i8[4096]
    strtab_pos: i64
    stab:       &StructTable
    param_cnt:  i64
    param_slots:i64[16]
    var_owned:  i64[256]
    var_alloc_sz: i64[256]
    var_linear: i64[256]
    var_consumed: i64[256]
}

struct ConstVal {
    found: i64
    val:   i64
}

struct Fixup {
    code_off:  i64
    target_bb: i64
    kind:      i64
    str_len:   i64
}

struct RegAlloc {
    pool:      i32[16]
    val2reg:   i32[8192]
    reg2val:   i64[16]
    spill_off: i64[8192]
    sp_top:    i64
    evict_idx: i64
}

struct LowerCtx {
    ra:         RegAlloc
    fixups:     Fixup[8192]
    fix_cnt:    i64
    bb_offsets: i64[256]
    use_cnt:    i32[8192]
}

struct StructTable {
    cnt:        i64
    names:      i64[64]
    nlens:      i64[64]
    fcnts:      i64[64]
    sizes:      i64[64]
    fbases:     i64[64]
    field_cnt:  i64
    fnames:     i64[4096]
    flens:      i64[4096]
    foffs:      i64[4096]
    ftypes:     i64[4096]
    fis_array:  i64[4096]
    fowners:    i64[4096]
}

