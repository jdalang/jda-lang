        ins.operand0 = arg0
        ins.operand1 = arg1
        ins.operand2 = arg2
        ret emit(jfn, bb, &ins)
    }
    // Float builtins (Phase 7 M1) — set g_codegen_stype for operator overloading
    if name_len == 12 and streq(src, name_start, 12, "f64_from_int") == 1 {
        let ins = Instr{}
        ins.op = OP_I2F
        ins.operand0 = arg0
        g_codegen_stype = TYPE_F64
        ret emit(jfn, bb, &ins)
    }
    if name_len == 10 and streq(src, name_start, 10, "f64_to_int") == 1 {
        let ins = Instr{}
