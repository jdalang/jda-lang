struct Token {
    type:  i64
    pad:   i64
    start: i64
    len:   i64
    imm:   i64
}

let g_toks: &Token = 0

fn write_tok0() {
    g_toks[0].type = 11
    g_toks[0].start = 22
    g_toks[0].len = 33
    g_toks[0].imm = 44
}

fn main() {
    let toks = Token[4]
    g_toks = toks
    write_tok0()
    print(g_toks[0].type)
    print(g_toks[0].start)
    print(g_toks[0].len)
    print(g_toks[0].imm)
}
