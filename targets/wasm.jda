// =============================================================================
// jda::targets::wasm — WebAssembly Binary Format Backend
// =============================================================================
// Compiles JIR directly to a valid .wasm binary module (WebAssembly 1.0 / 2.0).
// No LLVM. No Emscripten. No wasm-pack.
//
// The output is a self-contained .wasm file that can be:
//   • Loaded in any browser via WebAssembly.instantiate()
//   • Run with wasmtime, wasmer, or wasm3 on the command line
//   • Linked with WASI for file I/O and network (via WASI syscall shim)
//
// WebAssembly Binary Format structure:
//   \0asm  version=1          magic + version
//   §1  Type section          function signatures
//   §2  Import section        WASI imports (optional)
//   §3  Function section      type indices for each function
//   §5  Memory section        linear memory declaration
//   §6  Global section        globals (stack pointer, heap base)
//   §7  Export section        exported functions + memory
//   §10 Code section          function bodies (locals + opcodes)
//   §11 Data section          static data segments
//
// WASI syscall shim (when targeting WASI):
//   All jda syscalls are translated to WASI preview1 host function imports:
//     fd_write, fd_read, path_open, path_remove_file, clock_time_get, proc_exit
//
// Type encoding (LEB128):
//   i32 = 0x7F   i64 = 0x7E   f32 = 0x7D   f64 = 0x7C
//   funcref = 0x70   externref = 0x6F   void = 0x40
// =============================================================================

import jda::ir::jir::{ JirModule, JirFn, JirInstr, JirValue, Op, JirType }
import jda::fs::{ file_write }

// =============================================================================
// LEB128 encoding helpers
// =============================================================================

fn write_uleb128(buf: []mut i8, pos: &mut i64, v: u64) {
    loop {
        let byte = (v & 0x7F) as i8
        v = v >> 7
        if v != 0 { byte = byte | 0x80 as i8 }
        buf[pos[0]] = byte
        pos[0] = pos[0] + 1
        if v == 0 { break }
    }
}

fn write_sleb128(buf: []mut i8, pos: &mut i64, v: i64) {
    let more = true
    loop more {
        let byte = (v & 0x7F) as i8
        v = v >> 7
        let sign_bit = byte & 0x40
        if (v == 0 and sign_bit == 0) or (v == -1 and sign_bit != 0) {
            more = false
        } else {
            byte = byte | 0x80 as i8
        }
        buf[pos[0]] = byte
        pos[0] = pos[0] + 1
    }
}

fn write_u8(buf: []mut i8, pos: &mut i64, v: u8) {
    buf[pos[0]] = v as i8   pos[0] = pos[0] + 1
}

fn write_u32_le(buf: []mut i8, pos: &mut i64, v: u32) {
    loop i in 0..4 {
        buf[pos[0]] = ((v >> (i * 8)) & 0xFF) as i8
        pos[0] = pos[0] + 1
    }
}

// Write a byte vector prefixed with its LEB128 length
fn write_vec_u8(out: []mut i8, pos: &mut i64, data: ref []i8) {
    write_uleb128(out, pos, data.len as u64)
    loop i in 0..data.len { out[pos[0]] = data[i]   pos[0] = pos[0] + 1 }
}

// Write a string (wasm name = u32 length + UTF-8 bytes)
fn write_name(out: []mut i8, pos: &mut i64, s: ref []i8) {
    write_uleb128(out, pos, s.len as u64)
    loop i in 0..s.len { out[pos[0]] = s[i]   pos[0] = pos[0] + 1 }
}

// =============================================================================
// Wasm value types and opcodes
// =============================================================================

// Value types
const WASM_I32   : i8 = 0x7F
const WASM_I64   : i8 = 0x7E
const WASM_F32   : i8 = 0x7D
const WASM_F64   : i8 = 0x7C
const WASM_VOID  : i8 = 0x40

// Opcodes
const OP_UNREACHABLE  : i8 = 0x00
const OP_NOP          : i8 = 0x01
const OP_BLOCK        : i8 = 0x02
const OP_LOOP         : i8 = 0x03
const OP_IF           : i8 = 0x04
const OP_ELSE         : i8 = 0x05
const OP_END          : i8 = 0x0B
const OP_BR           : i8 = 0x0C
const OP_BR_IF        : i8 = 0x0D
const OP_RETURN       : i8 = 0x0F
const OP_CALL         : i8 = 0x10
const OP_CALL_INDIRECT: i8 = 0x11
const OP_DROP         : i8 = 0x1A
const OP_SELECT       : i8 = 0x1B

const OP_LOCAL_GET    : i8 = 0x20
const OP_LOCAL_SET    : i8 = 0x21
const OP_LOCAL_TEE    : i8 = 0x22
const OP_GLOBAL_GET   : i8 = 0x23
const OP_GLOBAL_SET   : i8 = 0x24

const OP_I32_LOAD     : i8 = 0x28
const OP_I64_LOAD     : i8 = 0x29
const OP_F32_LOAD     : i8 = 0x2A
const OP_F64_LOAD     : i8 = 0x2B
const OP_I32_STORE    : i8 = 0x36
const OP_I64_STORE    : i8 = 0x37
const OP_F32_STORE    : i8 = 0x38
const OP_F64_STORE    : i8 = 0x39

const OP_I32_CONST    : i8 = 0x41
const OP_I64_CONST    : i8 = 0x42
const OP_F32_CONST    : i8 = 0x43
const OP_F64_CONST    : i8 = 0x44

const OP_I32_EQZ      : i8 = 0x45
const OP_I32_EQ       : i8 = 0x46
const OP_I32_NE       : i8 = 0x47
const OP_I32_LT_S     : i8 = 0x48
const OP_I32_GE_S     : i8 = 0x4E

const OP_I64_EQ       : i8 = 0x51
const OP_I64_NE       : i8 = 0x52
const OP_I64_LT_S     : i8 = 0x53
const OP_I64_GE_S     : i8 = 0x59

const OP_F32_EQ       : i8 = 0x5B
const OP_F32_LT       : i8 = 0x5D
const OP_F32_GT       : i8 = 0x5E

const OP_I32_ADD      : i8 = 0x6A
const OP_I32_SUB      : i8 = 0x6B
const OP_I32_MUL      : i8 = 0x6C
const OP_I32_DIV_S    : i8 = 0x6D
const OP_I32_AND      : i8 = 0x71
const OP_I32_OR       : i8 = 0x72
const OP_I32_XOR      : i8 = 0x73
const OP_I32_SHL      : i8 = 0x74
const OP_I32_SHR_S    : i8 = 0x75

const OP_I64_ADD      : i8 = 0x7C
const OP_I64_SUB      : i8 = 0x7D
const OP_I64_MUL      : i8 = 0x7E
const OP_I64_DIV_S    : i8 = 0x7F
const OP_I64_AND      : i8 = 0x83
const OP_I64_OR       : i8 = 0x84
const OP_I64_SHL      : i8 = 0x86
const OP_I64_SHR_S    : i8 = 0x87

const OP_F32_ADD      : i8 = 0x92
const OP_F32_SUB      : i8 = 0x93
const OP_F32_MUL      : i8 = 0x94
const OP_F32_DIV      : i8 = 0x95

const OP_F64_ADD      : i8 = 0xA0
const OP_F64_SUB      : i8 = 0xA1
const OP_F64_MUL      : i8 = 0xA2
const OP_F64_DIV      : i8 = 0xA3

const OP_I32_WRAP_I64       : i8 = 0xA7
const OP_I64_EXTEND_I32_S   : i8 = 0xAC
const OP_F32_CONVERT_I64_S  : i8 = 0xB4
const OP_F64_CONVERT_I64_S  : i8 = 0xB9
const OP_I32_TRUNC_F32_S    : i8 = 0xA8
const OP_I64_TRUNC_F64_S    : i8 = 0xB0

// Section IDs
const SEC_TYPE     : u8 = 1
const SEC_IMPORT   : u8 = 2
const SEC_FUNCTION : u8 = 3
const SEC_TABLE    : u8 = 4
const SEC_MEMORY   : u8 = 5
const SEC_GLOBAL   : u8 = 6
const SEC_EXPORT   : u8 = 7
const SEC_CODE     : u8 = 10
const SEC_DATA     : u8 = 11

// =============================================================================
// Wasm module builder
// =============================================================================
struct WasmModule {
    types:   []WasmFuncType
    imports: []WasmImport
    funcs:   []WasmFunc
    exports: []WasmExport
    data:    []WasmData
    n_types:   i64
    n_imports: i64
    n_funcs:   i64
    n_exports: i64
    n_data:    i64
}

struct WasmFuncType {
    params:  []i8    // value types
    results: []i8
}

struct WasmImport {
    module: []i8
    name:   []i8
    type_idx: i64
}

struct WasmFunc {
    type_idx: i64
    locals:   []i8        // additional local value types
    body:     [65536]i8
    body_len: i64
}

struct WasmExport {
    name:     []i8
    kind:     u8    // 0=func, 1=table, 2=mem, 3=global
    index:    i64
}

struct WasmData {
    offset: i64
    bytes:  []i8
}

impl WasmModule {
    fn new() -> own WasmModule {
        ret WasmModule {
            types:   [256]WasmFuncType,
            imports: [64]WasmImport,
            funcs:   [1024]WasmFunc,
            exports: [256]WasmExport,
            data:    [64]WasmData,
            n_types: 0, n_imports: 0, n_funcs: 0,
            n_exports: 0, n_data: 0,
        }
    }

    fn add_type(self, params: ref []i8, results: ref []i8) -> i64 {
        let idx = self.n_types
        self.types[idx] = WasmFuncType { params: params, results: results }
        self.n_types = self.n_types + 1
        ret idx
    }

    fn add_import(self, module: ref []i8, name: ref []i8, type_idx: i64) -> i64 {
        let idx = self.n_imports
        self.imports[idx] = WasmImport { module: module, name: name,
                                          type_idx: type_idx }
        self.n_imports = self.n_imports + 1
        ret idx + 1000000   // sentinel to distinguish from local funcs
    }

    fn add_func(self, type_idx: i64) -> i64 {
        let idx = self.n_funcs
        self.funcs[idx] = WasmFunc {
            type_idx: type_idx,
            locals:   "",
            body:     [0; 65536],
            body_len: 0,
        }
        self.n_funcs = self.n_funcs + 1
        ret idx
    }

    fn add_export(self, name: ref []i8, kind: u8, index: i64) {
        self.exports[self.n_exports] = WasmExport {
            name: name, kind: kind, index: index
        }
        self.n_exports = self.n_exports + 1
    }

    fn emit_to_buf(self, out: []mut i8, cap: i64) -> i64 {
        let pos = 0i64

        // Magic + version
        out[pos+0] = 0x00   out[pos+1] = 0x61
        out[pos+2] = 0x73   out[pos+3] = 0x6D   // \0asm
        out[pos+4] = 0x01   out[pos+5] = 0x00
        out[pos+6] = 0x00   out[pos+7] = 0x00   // version = 1
        pos = pos + 8

        // Type section
        pos = self.emit_section(out, pos, SEC_TYPE, fn(b: []mut i8, p: &mut i64) {
            write_uleb128(b, p, self.n_types as u64)
            loop i in 0..self.n_types {
                let t = &self.types[i]
                write_u8(b, p, 0x60)   // func type tag
                write_uleb128(b, p, t.params.len as u64)
                for vt in t.params { write_u8(b, p, vt as u8) }
                write_uleb128(b, p, t.results.len as u64)
                for vt in t.results { write_u8(b, p, vt as u8) }
            }
        })

        // Import section
        if self.n_imports > 0 {
            pos = self.emit_section(out, pos, SEC_IMPORT, fn(b, p) {
                write_uleb128(b, p, self.n_imports as u64)
                loop i in 0..self.n_imports {
                    let im = &self.imports[i]
                    write_name(b, p, im.module)
                    write_name(b, p, im.name)
                    write_u8(b, p, 0x00)   // func import
                    write_uleb128(b, p, im.type_idx as u64)
                }
            })
        }

        // Function section
        pos = self.emit_section(out, pos, SEC_FUNCTION, fn(b, p) {
            write_uleb128(b, p, self.n_funcs as u64)
            loop i in 0..self.n_funcs {
                write_uleb128(b, p, self.funcs[i].type_idx as u64)
            }
        })

        // Memory section — 1 page (64 KB), growable up to 256 pages (16 MB)
        pos = self.emit_section(out, pos, SEC_MEMORY, fn(b, p) {
            write_uleb128(b, p, 1)   // 1 memory
            write_u8(b, p, 0x01)     // has max
            write_uleb128(b, p, 1)   // min = 1 page
            write_uleb128(b, p, 256) // max = 256 pages
        })

        // Global section — stack pointer (mutable i32)
        pos = self.emit_section(out, pos, SEC_GLOBAL, fn(b, p) {
            write_uleb128(b, p, 1)             // 1 global
            write_u8(b, p, WASM_I32 as u8)    // type i32
            write_u8(b, p, 1)                  // mutable
            write_u8(b, p, OP_I32_CONST as u8)
            write_sleb128(b, p, 65536 - 1024)  // initial SP near top of page
            write_u8(b, p, OP_END as u8)
        })

        // Export section
        pos = self.emit_section(out, pos, SEC_EXPORT, fn(b, p) {
            // Always export memory as "memory"
            let export_count = self.n_exports + 1
            write_uleb128(b, p, export_count as u64)
            write_name(b, p, "memory")
            write_u8(b, p, 2)   // memory export
            write_uleb128(b, p, 0)

            loop i in 0..self.n_exports {
                let ex = &self.exports[i]
                write_name(b, p, ex.name)
                write_u8(b, p, ex.kind)
                write_uleb128(b, p, (ex.index + self.n_imports) as u64)
            }
        })

        // Code section
        pos = self.emit_section(out, pos, SEC_CODE, fn(b, p) {
            write_uleb128(b, p, self.n_funcs as u64)
            loop i in 0..self.n_funcs {
                let f = &self.funcs[i]
                // function body = locals_count + locals + opcodes + end
                let fbuf = [65536]i8
                let fp   = 0i64
                write_uleb128(fbuf, &mut fp, 0)   // 0 local declarations
                loop j in 0..f.body_len { fbuf[fp] = f.body[j]   fp = fp + 1 }
                write_u8(fbuf, &mut fp, OP_END as u8)
                write_uleb128(b, p, fp as u64)
                loop j in 0..fp { b[p[0]] = fbuf[j]   p[0] = p[0] + 1 }
            }
        })

        // Data section
        if self.n_data > 0 {
            pos = self.emit_section(out, pos, SEC_DATA, fn(b, p) {
                write_uleb128(b, p, self.n_data as u64)
                loop i in 0..self.n_data {
                    let d = &self.data[i]
                    write_u8(b, p, 0)   // active segment, memory 0
                    write_u8(b, p, OP_I32_CONST as u8)
                    write_sleb128(b, p, d.offset)
                    write_u8(b, p, OP_END as u8)
                    write_uleb128(b, p, d.bytes.len as u64)
                    loop j in 0..d.bytes.len { b[p[0]] = d.bytes[j]   p[0] = p[0] + 1 }
                }
            })
        }

        ret pos
    }

    fn emit_section(self, out: []mut i8, pos: i64, id: u8,
                    body: fn([]mut i8, &mut i64)) -> i64 {
        let p    = pos
        out[p]   = id as i8   p = p + 1

        // Write body into a temp buffer to get its size
        let tmp  = [65536]i8
        let tp   = 0i64
        body(tmp, &mut tp)

        // Write size then body
        write_uleb128(out, &mut p, tp as u64)
        loop i in 0..tp { out[p] = tmp[i]   p = p + 1 }
        ret p
    }
}

// =============================================================================
// JIR → Wasm code generator
// =============================================================================

fn jir_type_to_wasm(ty: JirType) -> i8 {
    match ty {
        JirType::I32 => WASM_I32
        JirType::I64 => WASM_I64
        JirType::F32 => WASM_F32
        JirType::F64 => WASM_F64
        _             => WASM_I64   // default
    }
}

fn lower_jir_fn(fn_: ref JirFn, func: &mut WasmFunc) {
    let b   = func.body
    let pos = &mut func.body_len

    for bb in fn_.blocks {
        for instr in bb.instrs {
            match instr.op {
                Op::Const => {
                    match instr.type_ {
                        JirType::I32 => {
                            write_u8(b, pos, OP_I32_CONST as u8)
                            write_sleb128(b, pos, instr.imm_i64)
                        }
                        JirType::I64 => {
                            write_u8(b, pos, OP_I64_CONST as u8)
                            write_sleb128(b, pos, instr.imm_i64)
                        }
                        JirType::F32 => {
                            write_u8(b, pos, OP_F32_CONST as u8)
                            write_u32_le(b, pos, instr.imm_f32.to_bits())
                        }
                        JirType::F64 => {
                            write_u8(b, pos, OP_F64_CONST as u8)
                            // write 8 bytes little-endian f64
                            let bits = instr.imm_f64.to_bits()
                            loop i in 0..8 {
                                b[pos[0]] = ((bits >> (i*8)) & 0xFF) as i8
                                pos[0] = pos[0] + 1
                            }
                        }
                        _ => {}
                    }
                    write_u8(b, pos, OP_LOCAL_SET as u8)
                    write_uleb128(b, pos, instr.dst as u64)
                }
                Op::Add => {
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src0 as u64)
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src1 as u64)
                    match instr.type_ {
                        JirType::I32 => write_u8(b, pos, OP_I32_ADD as u8)
                        JirType::F32 => write_u8(b, pos, OP_F32_ADD as u8)
                        JirType::F64 => write_u8(b, pos, OP_F64_ADD as u8)
                        _            => write_u8(b, pos, OP_I64_ADD as u8)
                    }
                    write_u8(b, pos, OP_LOCAL_SET as u8)
                    write_uleb128(b, pos, instr.dst as u64)
                }
                Op::Sub => {
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src0 as u64)
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src1 as u64)
                    match instr.type_ {
                        JirType::I32 => write_u8(b, pos, OP_I32_SUB as u8)
                        JirType::F32 => write_u8(b, pos, OP_F32_SUB as u8)
                        JirType::F64 => write_u8(b, pos, OP_F64_SUB as u8)
                        _            => write_u8(b, pos, OP_I64_SUB as u8)
                    }
                    write_u8(b, pos, OP_LOCAL_SET as u8)
                    write_uleb128(b, pos, instr.dst as u64)
                }
                Op::Mul => {
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src0 as u64)
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src1 as u64)
                    match instr.type_ {
                        JirType::I32 => write_u8(b, pos, OP_I32_MUL as u8)
                        JirType::F32 => write_u8(b, pos, OP_F32_MUL as u8)
                        JirType::F64 => write_u8(b, pos, OP_F64_MUL as u8)
                        _            => write_u8(b, pos, OP_I64_MUL as u8)
                    }
                    write_u8(b, pos, OP_LOCAL_SET as u8)
                    write_uleb128(b, pos, instr.dst as u64)
                }
                Op::Load => {
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src0 as u64)
                    match instr.type_ {
                        JirType::I32 => write_u8(b, pos, OP_I32_LOAD as u8)
                        JirType::F32 => write_u8(b, pos, OP_F32_LOAD as u8)
                        JirType::F64 => write_u8(b, pos, OP_F64_LOAD as u8)
                        _            => write_u8(b, pos, OP_I64_LOAD as u8)
                    }
                    write_uleb128(b, pos, 3)   // alignment (8-byte)
                    write_uleb128(b, pos, 0)   // offset 0
                    write_u8(b, pos, OP_LOCAL_SET as u8)
                    write_uleb128(b, pos, instr.dst as u64)
                }
                Op::Store => {
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src1 as u64)   // address
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src0 as u64)   // value
                    match instr.type_ {
                        JirType::I32 => write_u8(b, pos, OP_I32_STORE as u8)
                        JirType::F32 => write_u8(b, pos, OP_F32_STORE as u8)
                        JirType::F64 => write_u8(b, pos, OP_F64_STORE as u8)
                        _            => write_u8(b, pos, OP_I64_STORE as u8)
                    }
                    write_uleb128(b, pos, 3)
                    write_uleb128(b, pos, 0)
                }
                Op::Call => {
                    // Push arguments
                    for arg in instr.args {
                        write_u8(b, pos, OP_LOCAL_GET as u8)
                        write_uleb128(b, pos, arg as u64)
                    }
                    write_u8(b, pos, OP_CALL as u8)
                    write_uleb128(b, pos, instr.callee_idx as u64)
                    if instr.dst >= 0 {
                        write_u8(b, pos, OP_LOCAL_SET as u8)
                        write_uleb128(b, pos, instr.dst as u64)
                    } else {
                        write_u8(b, pos, OP_DROP as u8)
                    }
                }
                Op::Ret => {
                    if instr.src0 >= 0 {
                        write_u8(b, pos, OP_LOCAL_GET as u8)
                        write_uleb128(b, pos, instr.src0 as u64)
                    }
                    write_u8(b, pos, OP_RETURN as u8)
                }
                Op::Br => {
                    write_u8(b, pos, OP_BR as u8)
                    write_uleb128(b, pos, instr.target_depth as u64)
                }
                Op::BrCond => {
                    write_u8(b, pos, OP_LOCAL_GET as u8)
                    write_uleb128(b, pos, instr.src0 as u64)
                    write_u8(b, pos, OP_BR_IF as u8)
                    write_uleb128(b, pos, instr.target_depth as u64)
                }
                _ => {
                    write_u8(b, pos, OP_NOP as u8)
                }
            }
        }
    }
}

// =============================================================================
// WASI syscall import table
// =============================================================================
// WASI Preview 1 — maps jda syscall numbers to WASI host functions
fn add_wasi_imports(m: &mut WasmModule) {
    // fd_write(fd, iovs_ptr, iovs_len, nwritten_ptr) -> errno
    let t_fd_write = m.add_type([WASM_I32, WASM_I32, WASM_I32, WASM_I32],
                                 [WASM_I32])
    m.add_import("wasi_snapshot_preview1", "fd_write", t_fd_write)

    // fd_read(fd, iovs_ptr, iovs_len, nread_ptr) -> errno
    let t_fd_read = m.add_type([WASM_I32, WASM_I32, WASM_I32, WASM_I32],
                                [WASM_I32])
    m.add_import("wasi_snapshot_preview1", "fd_read", t_fd_read)

    // proc_exit(exit_code)
    let t_exit = m.add_type([WASM_I32], [])
    m.add_import("wasi_snapshot_preview1", "proc_exit", t_exit)

    // clock_time_get(clock_id, precision, time_ptr) -> errno
    let t_clock = m.add_type([WASM_I32, WASM_I64, WASM_I32], [WASM_I32])
    m.add_import("wasi_snapshot_preview1", "clock_time_get", t_clock)
}

// =============================================================================
// Top-level compile function
// =============================================================================
fn wasm_compile(module: ref JirModule, out_path: ref []i8,
                wasi: bool) -> Result<(), []i8> {
    let m = WasmModule::new()

    if wasi { add_wasi_imports(&mut m) }

    // Register function types and functions
    for fn_ in module.functions {
        let params = [fn_.params.len]i8
        loop i in 0..fn_.params.len {
            params[i] = jir_type_to_wasm(fn_.params[i].type_)
        }
        let results = if fn_.ret_type == JirType::Void {
            ""
        } else {
            let r = [1]i8 { jir_type_to_wasm(fn_.ret_type) }
            r[0..1]
        }
        let type_idx = m.add_type(params[0..fn_.params.len], results)
        let func_idx = m.add_func(type_idx)

        // Lower the function body
        lower_jir_fn(fn_, &mut m.funcs[func_idx])

        // Export public functions
        if fn_.is_public {
            m.add_export(fn_.name, 0, func_idx)
        }
    }

    // Emit binary to buffer
    let out_buf = [1048576]i8   // 1 MB
    let out_len = m.emit_to_buf(out_buf, 1048576)

    file_write(out_path, out_buf[0..out_len])?
    ret ok(())
}

// =============================================================================
// JavaScript / HTML loader snippet (emitted alongside the .wasm)
// =============================================================================
fn emit_js_loader(wasm_name: ref []i8, out_path: ref []i8) -> Result<(), []i8> {
    let js = fmt_str(
"// Auto-generated by jda wasm backend
const jda = await WebAssembly.instantiateStreaming(fetch('{0}'), {{}});
const {{ memory, main }} = jda.instance.exports;
main();
", [ArgStr(wasm_name)])
    ret file_write(out_path, js)
}

fn emit_html_harness(wasm_name: ref []i8, out_path: ref []i8) -> Result<(), []i8> {
    let html = fmt_str(
"<!DOCTYPE html><html><head><title>Jda WASM</title></head>
<body>
<canvas id='c' width='800' height='600'></canvas>
<script type='module'>
import init from './{0}.js';
await init();
</script>
</body></html>
", [ArgStr(wasm_name)])
    ret file_write(out_path, html)
}
