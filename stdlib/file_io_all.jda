// =============================================================================
// jda::fs -- Minimal File I/O
// =============================================================================
// Direct Linux syscalls. No libc.

// IMPORTANT: Each helper function contains at most ONE syscall call.
// Multiple syscalls in a single function cause register corruption
// in the current compiler.

// Functions:
//   fs_read_file(path, buf, max) -> bytes read (-1 on error)
//   fs_write_file(path, data, len) -> bytes written (-1 on error)
//   fs_append_file(path, data, len) -> bytes written (-1 on error)
//   fs_exists(path) -> 1 if file exists, 0 otherwise
//   fs_unlink(path) -> 0 on success, -1 on error
//   fs_mkdir(path) -> 0 on success, -1 on error
//   fs_file_size(path) -> size in bytes (-1 on error)
// =============================================================================

// --- Single-syscall primitives ---

fn _fs_open_read(path: &i8) -> i64 {
    ret syscall(2, path, 0, 0)
}

fn _fs_open_write(path: &i8) -> i64 {
    // O_WRONLY | O_CREAT | O_TRUNC = 577, mode 0644 = 420
    ret syscall(2, path, 577, 420)
}

fn _fs_open_append(path: &i8) -> i64 {
    // O_WRONLY | O_CREAT | O_APPEND = 1089, mode 0644 = 420
    ret syscall(2, path, 1089, 420)
}

fn _fs_close(fd: i64) -> i64 {
    ret syscall(3, fd, 0, 0)
}

fn _fs_write(fd: i64, data: &i8, len: i64) -> i64 {
    ret syscall(1, fd, data, len)
}

fn _fs_read(fd: i64, buf: &i8, max: i64) -> i64 {
    ret syscall(0, fd, buf, max)
}

fn _fs_access(path: &i8) -> i64 {
    ret syscall(21, path, 0, 0)
}

fn _fs_unlink_raw(path: &i8) -> i64 {
    ret syscall(87, path, 0, 0)
}

fn _fs_mkdir_raw(path: &i8) -> i64 {
    // mkdir(path, 0755=493)
    ret syscall(83, path, 493, 0)
}

fn _fs_stat(path: &i8, statbuf: &i8) -> i64 {
    ret syscall(4, path, statbuf, 0)
}

fn _fs_rename_raw(src: &i8, dst: &i8) -> i64 {
    ret syscall(82, src, dst, 0)
}

// --- High-level functions (no syscalls, only call single-syscall helpers) ---

fn fs_read_file(path: &i8, buf: &i8, max_bytes: i64) -> i64 {
    let fd = _fs_open_read(path)
    if fd < 0 { ret -1 }
    let total = 0
    let keep = 1
    loop keep == 1 {
        let remaining = max_bytes - total
        if remaining < 1 { keep = 0 }
        if keep == 1 {
            let n = _fs_read(fd, buf + total, remaining)
            if n < 1 {
                keep = 0
            } else {
                total = total + n
            }
        }
    }
    _fs_close(fd)
    ret total
}

fn fs_write_file(path: &i8, data: &i8, len: i64) -> i64 {
    let fd = _fs_open_write(path)
    if fd < 0 { ret -1 }
    let n = _fs_write(fd, data, len)
    _fs_close(fd)
    ret n
}

fn fs_append_file(path: &i8, data: &i8, len: i64) -> i64 {
    let fd = _fs_open_append(path)
    if fd < 0 { ret -1 }
    let n = _fs_write(fd, data, len)
    _fs_close(fd)
    ret n
}

fn fs_exists(path: &i8) -> i64 {
    let r = _fs_access(path)
    if r == 0 { ret 1 }
    ret 0
}

fn fs_unlink(path: &i8) -> i64 {
    let r = _fs_unlink_raw(path)
    if r < 0 { ret -1 }
    ret 0
}

fn fs_mkdir(path: &i8) -> i64 {
    let r = _fs_mkdir_raw(path)
    if r < 0 { ret -1 }
    ret 0
}

fn fs_file_size(path: &i8) -> i64 {
    let statbuf = alloc_pages(1)
    let r = _fs_stat(path, statbuf)
    if r < 0 { ret -1 }
    let size_ptr: &i64 = statbuf + 48
    let size = size_ptr[0]
    ret size
}
// =============================================================================
// jda::file_io -- High-Level File I/O Helpers
// =============================================================================
// Ergonomic wrappers around fs.jda's raw syscall functions.
// Depends on: stdlib/fs.jda

// Equivalent mapping:
//   open(f).read()              -> fs_slurp(path, &buf, &len)
//   open(f).readlines()         -> fs_read_lines(path, &lines, &count)
//   open(f,'w').write(s)        -> fs_write_str(path, str, len)
//   shutil.copy(src, dst)       -> fs_copy(src, dst)
//   os.rename(src, dst)         -> fs_rename(src, dst)
//   os.path.join(a, b)         -> path_join(a, alen, b, blen, out) -> len
//   os.path.basename(p)        -> path_basename(path, len) -> (start, blen)
//   os.path.splitext(p)        -> path_ext(path, len) -> offset of '.'
//   tempfile.mktemp()           -> fs_tmpname(out) -> len

// All functions use &i8 for paths (null-terminated C strings).
// Zero compiler changes.
// =============================================================================

// --- Read entire file into auto-allocated buffer ---
// Returns bytes read. Allocates buffer internally via alloc_pages.
// Caller gets buffer via out_buf pointer.
// Usage: let buf: &i8 = 0
//        let n = fs_slurp("/tmp/test.txt", &buf)
//        ; buf now points to file contents, n = byte count

// Since we can't do &buf easily, we use a two-step approach:
//   1. fs_file_size to get size
//   2. alloc_pages for buffer
//   3. fs_read_file into buffer
//   Returns: buffer pointer (cast to i64), or 0 on error
//   Caller must also call fs_slurp_len() to get length.

// Read file into new buffer. Returns pointer to buffer (as i64).
// Use fs_slurp_len() after to get the length.
// Returns 0 on error.
fn fs_slurp(path: &i8) -> i64 {
    let size = fs_file_size(path)
    if size < 0 { ret 0 }
    // Allocate enough pages
    let pages = size / 4096 + 1
    let buf: &i8 = alloc_pages(pages)
    let n = fs_read_file(path, buf, size)
    if n < 0 { ret 0 }
    // Store length in the page after data (metadata)
    // Actually, just return buf and let caller use fs_file_size separately
    ret buf
}

// --- Write string to file (convenience) ---
// Like Python: open(f, 'w').write(data)
fn fs_write_str(path: &i8, data: &i8, len: i64) -> i64 {
    ret fs_write_file(path, data, len)
}

// --- Append string to file ---
// Like Python: open(f, 'a').write(data)
fn fs_append_str(path: &i8, data: &i8, len: i64) -> i64 {
    ret fs_append_file(path, data, len)
}

// --- Count lines in a buffer ---
// Returns number of newline characters + 1 (if buffer doesn't end with newline)
fn buf_count_lines(buf: &i8, len: i64) -> i64 {
    let count = 0
    let i = 0
    loop i < len {
        if buf[i] == 10 { count = count + 1 }
        i = i + 1
    }
    // If last char is not newline, there's one more line
    if len > 0 {
        let last_idx = len - 1
        let last = buf[last_idx]
        if last != 10 { count = count + 1 }
    }
    ret count
}

// --- Get line start offset and length ---
// Returns start offset of line N (0-indexed) in buf.
// Sets line length via out parameter pattern (caller passes &i64).
fn buf_line_start(buf: &i8, len: i64, line_idx: i64) -> i64 {
    let cur_line = 0
    let i = 0
    loop i < len {
        if cur_line == line_idx { ret i }
        if buf[i] == 10 { cur_line = cur_line + 1 }
        i = i + 1
    }
    ret len
}

// Get length of line at given start offset (excludes newline)
fn buf_line_len(buf: &i8, total_len: i64, start: i64) -> i64 {
    let i = start
    loop i < total_len {
        if buf[i] == 10 { ret i - start }
        i = i + 1
    }
    ret total_len - start
}

// --- Copy file ---
// Like Python: shutil.copy(src, dst)
fn fs_copy(src: &i8, dst: &i8) -> i64 {
    let size = fs_file_size(src)
    if size < 0 { ret -1 }
    let pages = size / 4096 + 1
    let buf: &i8 = alloc_pages(pages)
    let n = fs_read_file(src, buf, size)
    if n < 0 { ret -1 }
    let w = fs_write_file(dst, buf, n)
    ret w
}

// --- Rename file ---
// Like Python: os.rename(src, dst)
// Uses Linux rename syscall (82)
fn fs_rename(src: &i8, dst: &i8) -> i64 {
    let r = _fs_rename_raw(src, dst)
    if r < 0 { ret -1 }
    ret 0
}

// --- Temp file name ---
// Writes a temp file path to out buffer.
// Returns path length.
// Path format: /tmp/jda_NNNN where NNNN is from clock.
fn fs_tmpname(out: &i8, suffix: i64) -> i64 {
    // "/tmp/jda_"
    out[0] = 47   // /
    out[1] = 116  // t
    out[2] = 109  // m
    out[3] = 112  // p
    out[4] = 47   // /
    out[5] = 106  // j
    out[6] = 100  // d
    out[7] = 97   // a
    out[8] = 95   // _
    // Write suffix digits
    let val = suffix
    if val < 0 { val = 0 - val }
    // Convert to decimal digits in reverse
    let digits: &i8 = alloc_pages(1)
    let dc = 0
    if val == 0 {
        digits[0] = 48
        dc = 1
    } else {
        loop val > 0 {
            let d = val - (val / 10) * 10
            digits[dc] = 48 + d
            dc = dc + 1
            val = val / 10
        }
    }
    // Write digits in reverse order
    let pos = 9
    let j = dc - 1
    loop j >= 0 {
        out[pos] = digits[j]
        pos = pos + 1
        j = j - 1
    }
    out[pos] = 0  // null terminate
    ret pos
}

// --- Path helpers ---

// Get length of a null-terminated string
fn cstr_length(s: &i8) -> i64 {
    let i = 0
    loop s[i] != 0 {
        i = i + 1
    }
    ret i
}

// path_join: join directory and filename with /
// out must be large enough. Returns length of result.
fn path_join(dir: &i8, dir_len: i64, name: &i8, name_len: i64, out: &i8) -> i64 {
    let i = 0
    loop i < dir_len {
        out[i] = dir[i]
        i = i + 1
    }
    // Add / if dir doesn't end with one
    if dir_len > 0 {
        let last_idx = dir_len - 1
        let last = dir[last_idx]
        if last != 47 {
            out[i] = 47
            i = i + 1
        }
    }
    let j = 0
    loop j < name_len {
        out[i] = name[j]
        i = i + 1
        j = j + 1
    }
    out[i] = 0  // null terminate
    ret i
}

// path_basename: find start of filename in path
// Returns offset where basename starts.
// E.g. "/foo/bar/baz.txt" -> 9 (points to 'b' of 'baz.txt')
fn path_basename(path: &i8, len: i64) -> i64 {
    let last_slash = 0
    let i = 0
    loop i < len {
        if path[i] == 47 { last_slash = i + 1 }
        i = i + 1
    }
    ret last_slash
}

// path_ext: find the extension dot position
// Returns offset of the last '.' in filename portion, or len if no extension.
// E.g. "/foo/bar.txt" -> 8 (offset of '.')
fn path_ext(path: &i8, len: i64) -> i64 {
    let base = path_basename(path, len)
    let last_dot = len
    let i = base
    loop i < len {
        if path[i] == 46 { last_dot = i }
        i = i + 1
    }
    ret last_dot
}

// --- Byte comparison ---
// Compare n bytes. Returns 1 if equal, 0 otherwise.
fn buf_eq(a: &i8, b: &i8, n: i64) -> i64 {
    let i = 0
    loop i < n {
        if a[i] != b[i] { ret 0 }
        i = i + 1
    }
    ret 1
}

// --- Read file as lines into a vec of (start, len) pairs ---
// Returns a flat vec: [start0, len0, start1, len1, ...]
// buf and buf_len are the raw file contents.
// Requires vec.jda (via comprehension_all.jda or standalone).
// Commented out — depends on vec.jda which may not be included.
// Callers can use buf_count_lines + buf_line_start + buf_line_len instead.
