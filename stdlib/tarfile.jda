// =============================================================================
// jda::tarfile -- POSIX ustar Tar Archive Format
// =============================================================================
// Read and write tar archives using 512-byte block headers.
// Supports regular file entries with names up to 100 chars.

// Write handle layout (&i64):
//   [0] output buffer (&i8)
//   [1] current write position
//   [2] entry count

// Read handle layout (&i64):
//   [0] input buffer (&i8)
//   [1] input length
//   [2] current offset (position of current entry header)
//   [3] entry count (total discovered)

// Functions:
//   tar_create(out)              -> &i64  create write handle
//   tar_add_file(h, name, nlen, data, dlen) -> i64  add file entry
//   tar_finish(h)                -> i64   write end markers, return total len
//   tar_open(buf, len)           -> &i64  open for reading
//   tar_next(h)                  -> i64   advance to next entry (1=ok, 0=end)
//   tar_entry_name(h, out)       -> i64   copy entry name, return length
//   tar_entry_size(h)            -> i64   size of current entry data
//   tar_entry_data(h, out)       -> i64   copy entry data, return length
// =============================================================================

// Internal byte reader.
fn _tar_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

// Internal: write octal string (zero-padded, len chars) at position.
// Writes right-to-left directly into output to avoid alloc_pages.
fn _tar_write_octal(out: &i8, pos: i64, val: i64, len: i64) -> i64 {
    // Null terminator at last position
    poke_byte(out, pos + len - 1, 0)
    // Write digits right-to-left starting from pos + len - 2
    let v = val
    let wp = pos + len - 2
    if v == 0 {
        poke_byte(out, wp, 48)
        wp = wp - 1
    } else {
        loop v > 0 and wp >= pos {
            let rem = v - (v / 8) * 8
            poke_byte(out, wp, rem + 48)
            v = v / 8
            wp = wp - 1
        }
    }
    // Zero-pad remaining positions
    loop wp >= pos {
        poke_byte(out, wp, 48)
        wp = wp - 1
    }
    ret pos + len
}

// Internal: read octal number from buffer.
fn _tar_read_octal(buf: &i8, pos: i64, len: i64) -> i64 {
    let result = 0
    let i = 0
    loop i < len {
        let ch = _tar_byte_at(buf, pos + i)
        if ch < 0 { ch = ch + 256 }
        if ch >= 48 and ch <= 55 {
            result = result * 8 + ch - 48
        }
        i = i + 1
    }
    ret result
}

// Internal: compute header checksum.
fn _tar_checksum(buf: &i8, pos: i64) -> i64 {
    let sum = 0
    let i = 0
    loop i < 512 {
        // Checksum field at offset 148-155 treated as spaces
        if i >= 148 and i < 156 {
            sum = sum + 32
        } else {
            let b = _tar_byte_at(buf, pos + i)
            if b < 0 { b = b + 256 }
            sum = sum + b
        }
        i = i + 1
    }
    ret sum
}

// Internal: zero-fill a 512-byte block.
fn _tar_zero_block(buf: &i8, pos: i64) -> i64 {
    let i = 0
    loop i < 512 {
        poke_byte(buf, pos + i, 0)
        i = i + 1
    }
    ret 512
}

// Create a write handle. out is the output buffer.
fn tar_create(out: &i8) -> &i64 {
    let h: &i64 = alloc_pages(1)
    h[0] = out
    h[1] = 0
    h[2] = 0
    ret h
}

// Add a file entry to the tar archive.
fn tar_add_file(h: &i64, name: &i8, nlen: i64, data: &i8, dlen: i64) -> i64 {
    let out: &i8 = h[0]
    let pos = h[1]

    // Zero the header block
    _tar_zero_block(out, pos)

    // Name (offset 0, 100 bytes)
    let ni = 0
    let name_max = nlen
    if name_max > 99 { name_max = 99 }
    loop ni < name_max {
        let ch = _tar_byte_at(name, ni)
        poke_byte(out, pos + ni, ch)
        ni = ni + 1
    }

    // Mode (offset 100, 8 bytes) = 0000644
    _tar_write_octal(out, pos + 100, 420, 8)

    // UID (offset 108, 8 bytes) = 0
    _tar_write_octal(out, pos + 108, 0, 8)

    // GID (offset 116, 8 bytes) = 0
    _tar_write_octal(out, pos + 116, 0, 8)

    // Size (offset 124, 12 bytes)
    _tar_write_octal(out, pos + 124, dlen, 12)

    // Mtime (offset 136, 12 bytes) = 0
    _tar_write_octal(out, pos + 136, 0, 12)

    // Typeflag (offset 156) = '0' (regular file)
    poke_byte(out, pos + 156, 48)

    // ustar magic (offset 257, 6 bytes)
    poke_byte(out, pos + 257, 117)  // 'u'
    poke_byte(out, pos + 258, 115)  // 's'
    poke_byte(out, pos + 259, 116)  // 't'
    poke_byte(out, pos + 260, 97)   // 'a'
    poke_byte(out, pos + 261, 114)  // 'r'
    poke_byte(out, pos + 262, 0)

    // ustar version (offset 263, 2 bytes) = "00"
    poke_byte(out, pos + 263, 48)
    poke_byte(out, pos + 264, 48)

    // Compute and write checksum (offset 148, 8 bytes)
    let cksum = _tar_checksum(out, pos)
    _tar_write_octal(out, pos + 148, cksum, 7)
    poke_byte(out, pos + 155, 32)  // space after checksum

    pos = pos + 512

    // Write data
    let di = 0
    loop di < dlen {
        let db = _tar_byte_at(data, di)
        poke_byte(out, pos + di, db)
        di = di + 1
    }
    pos = pos + dlen

    // Pad to 512-byte boundary
    let remainder = dlen - (dlen / 512) * 512
    if remainder > 0 {
        let pad = 512 - remainder
        let pi = 0
        loop pi < pad {
            poke_byte(out, pos, 0)
            pos = pos + 1
            pi = pi + 1
        }
    }

    h[1] = pos
    h[2] = h[2] + 1
    ret 1
}

// Write two zero blocks to finish the archive. Returns total length.
fn tar_finish(h: &i64) -> i64 {
    let out: &i8 = h[0]
    let pos = h[1]
    _tar_zero_block(out, pos)
    pos = pos + 512
    _tar_zero_block(out, pos)
    pos = pos + 512
    h[1] = pos
    ret pos
}

// Open a tar archive for reading.
fn tar_open(buf: &i8, len: i64) -> &i64 {
    let h: &i64 = alloc_pages(1)
    h[0] = buf
    h[1] = len
    h[2] = 0     // current offset starts before first entry
    h[3] = 0
    // Set to -512 so first tar_next advances to offset 0
    h[2] = 0 - 512
    ret h
}

// Advance to next entry. Returns 1 if entry found, 0 if end of archive.
fn tar_next(h: &i64) -> i64 {
    let buf: &i8 = h[0]
    let blen = h[1]
    let cur = h[2]

    // If first call, advance to 0; otherwise skip current entry
    if cur < 0 {
        h[2] = 0
        cur = 0
    } else {
        // Skip header + data of current entry
        let size = _tar_read_octal(buf, cur + 124, 12)
        let data_blocks = size / 512
        let rem = size - data_blocks * 512
        if rem > 0 { data_blocks = data_blocks + 1 }
        cur = cur + 512 + data_blocks * 512
        h[2] = cur
    }

    if cur + 512 > blen { ret 0 }

    // Check for zero block (end of archive)
    let first = _tar_byte_at(buf, cur)
    if first < 0 { first = first + 256 }
    if first == 0 {
        // Check if entire block is zero
        let all_zero = 1
        let ci = 0
        loop ci < 512 and all_zero == 1 {
            let cb = _tar_byte_at(buf, cur + ci)
            if cb < 0 { cb = cb + 256 }
            if cb != 0 { all_zero = 0 }
            ci = ci + 1
        }
        if all_zero == 1 { ret 0 }
    }

    h[3] = h[3] + 1
    ret 1
}

// Copy current entry name to out. Returns length.
fn tar_entry_name(h: &i64, out: &i8) -> i64 {
    let buf: &i8 = h[0]
    let cur = h[2]
    let len = 0
    loop len < 100 {
        let ch = _tar_byte_at(buf, cur + len)
        if ch < 0 { ch = ch + 256 }
        if ch == 0 { ret len }
        poke_byte(out, len, ch)
        len = len + 1
    }
    ret len
}

// Get size of current entry data.
fn tar_entry_size(h: &i64) -> i64 {
    let buf: &i8 = h[0]
    let cur = h[2]
    ret _tar_read_octal(buf, cur + 124, 12)
}

// Copy current entry data to out. Returns length.
fn tar_entry_data(h: &i64, out: &i8) -> i64 {
    let buf: &i8 = h[0]
    let cur = h[2]
    let size = _tar_read_octal(buf, cur + 124, 12)
    let data_off = cur + 512
    let i = 0
    loop i < size {
        let b = _tar_byte_at(buf, data_off + i)
        poke_byte(out, i, b)
        i = i + 1
    }
    ret size
}
