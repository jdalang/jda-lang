// =============================================================================
// jda::kvstore -- Simple Key-Value Store
// =============================================================================
// In-memory key-value store using linear scan arrays.

// Memory layout per KvHandle (&i64):
//   [0] count
//   [1] keys_buf      (&i8)
//   [2] key_offs      (&i64)
//   [3] key_lens      (&i64)
//   [4] vals_buf      (&i8)
//   [5] val_offs      (&i64)
//   [6] val_lens      (&i64)
//   [7] keys_buf_pos
//   [8] vals_buf_pos

// Functions:
//   kv_new()                           -> &i64   create new store
//   kv_put(h, key, klen, val, vlen)    -> i64    insert or update
//   kv_get(h, key, klen, out)          -> i64    get value, returns length
//   kv_del(h, key, klen)               -> i64    delete key, returns 1/0
//   kv_has(h, key, klen)               -> i64    1 if key exists
//   kv_count(h)                        -> i64    number of entries
//   kv_keys(h, out, max)               -> i64    copy key offsets to out
// =============================================================================

// Internal byte reader.
fn _kv_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

// Internal: copy bytes.
fn _kv_copy(dst: &i8, doff: i64, src: &i8, soff: i64, len: i64) -> i64 {
    let i = 0
    loop i < len {
        let ch = _kv_byte_at(src, soff + i)
        poke_byte(dst, doff + i, ch)
        i = i + 1
    }
    ret len
}

// Internal: compare two byte ranges.
fn _kv_eq(a: &i8, aoff: i64, alen: i64, b: &i8, boff: i64, blen: i64) -> i64 {
    if alen != blen { ret 0 }
    let i = 0
    loop i < alen {
        let ca = _kv_byte_at(a, aoff + i)
        let cb = _kv_byte_at(b, boff + i)
        if ca != cb { ret 0 }
        i = i + 1
    }
    ret 1
}

// Internal: find key index, returns -1 if not found.
fn _kv_find(h: &i64, key: &i8, klen: i64) -> i64 {
    let count = h[0]
    let keys_buf: &i8 = h[1]
    let key_offs: &i64 = h[2]
    let key_lens: &i64 = h[3]
    let i = 0
    loop i < count {
        let koff = key_offs[i]
        let kl = key_lens[i]
        if kl >= 0 {
            let eq = _kv_eq(keys_buf, koff, kl, key, 0, klen)
            if eq == 1 { ret i }
        }
        i = i + 1
    }
    ret 0 - 1
}

// Create a new key-value store.
fn kv_new() -> &i64 {
    let h: &i64 = alloc_pages(1)
    let keys_buf: &i8 = alloc_pages(4)
    let key_offs: &i64 = alloc_pages(1)
    let key_lens: &i64 = alloc_pages(1)
    let vals_buf: &i8 = alloc_pages(4)
    let val_offs: &i64 = alloc_pages(1)
    let val_lens: &i64 = alloc_pages(1)
    h[0] = 0
    h[1] = keys_buf
    h[2] = key_offs
    h[3] = key_lens
    h[4] = vals_buf
    h[5] = val_offs
    h[6] = val_lens
    h[7] = 0
    h[8] = 0
    ret h
}

// Insert or update a key-value pair. Returns 1 on update, 0 on insert.
fn kv_put(h: &i64, key: &i8, klen: i64, val: &i8, vlen: i64) -> i64 {
    let idx = _kv_find(h, key, klen)
    let vals_buf: &i8 = h[4]
    let val_offs: &i64 = h[5]
    let val_lens: &i64 = h[6]
    if idx >= 0 {
        // Update existing — append new value at end of vals_buf
        let vpos = h[8]
        _kv_copy(vals_buf, vpos, val, 0, vlen)
        val_offs[idx] = vpos
        val_lens[idx] = vlen
        h[8] = vpos + vlen
        ret 1
    }
    // Insert new entry
    let count = h[0]
    let keys_buf: &i8 = h[1]
    let key_offs: &i64 = h[2]
    let key_lens: &i64 = h[3]
    let kpos = h[7]
    _kv_copy(keys_buf, kpos, key, 0, klen)
    key_offs[count] = kpos
    key_lens[count] = klen
    h[7] = kpos + klen
    let vpos2 = h[8]
    _kv_copy(vals_buf, vpos2, val, 0, vlen)
    val_offs[count] = vpos2
    val_lens[count] = vlen
    h[8] = vpos2 + vlen
    h[0] = count + 1
    ret 0
}

// Get value for a key. Copies to out buffer. Returns length, or -1 if not found.
fn kv_get(h: &i64, key: &i8, klen: i64, out: &i8) -> i64 {
    let idx = _kv_find(h, key, klen)
    if idx < 0 { ret 0 - 1 }
    let vals_buf: &i8 = h[4]
    let val_offs: &i64 = h[5]
    let val_lens: &i64 = h[6]
    let voff = val_offs[idx]
    let vlen = val_lens[idx]
    _kv_copy(out, 0, vals_buf, voff, vlen)
    ret vlen
}

// Delete a key. Returns 1 if found, 0 if not found.
fn kv_del(h: &i64, key: &i8, klen: i64) -> i64 {
    let idx = _kv_find(h, key, klen)
    if idx < 0 { ret 0 }
    // Mark as deleted by setting key_len to -1
    let key_lens: &i64 = h[3]
    key_lens[idx] = 0 - 1
    ret 1
}

// Check if key exists. Returns 1 or 0.
fn kv_has(h: &i64, key: &i8, klen: i64) -> i64 {
    let idx = _kv_find(h, key, klen)
    if idx >= 0 { ret 1 }
    ret 0
}

// Return the number of active entries.
fn kv_count(h: &i64) -> i64 {
    let total = h[0]
    let key_lens: &i64 = h[3]
    let count = 0
    let i = 0
    loop i < total {
        let kl = key_lens[i]
        if kl >= 0 { count = count + 1 }
        i = i + 1
    }
    ret count
}

// Copy key data into out buffer. Returns number of keys written.
// For each key: writes offset into keys_buf and length.
// out[i*2] = offset, out[i*2+1] = length
fn kv_keys(h: &i64, out: &i64, max: i64) -> i64 {
    let total = h[0]
    let key_offs: &i64 = h[2]
    let key_lens: &i64 = h[3]
    let written = 0
    let i = 0
    loop i < total {
        if written >= max {
            ret written
        }
        let kl = key_lens[i]
        if kl >= 0 {
            let w2 = written * 2
            let w2p1 = w2 + 1
            out[w2] = key_offs[i]
            out[w2p1] = kl
            written = written + 1
        }
        i = i + 1
    }
    ret written
}

// Copy key bytes to output buffer given index from kv_keys.
fn kv_key_copy(h: &i64, koff: i64, klen: i64, out: &i8) -> i64 {
    let keys_buf: &i8 = h[1]
    _kv_copy(out, 0, keys_buf, koff, klen)
    ret klen
}
