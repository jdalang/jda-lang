// =============================================================================
// jda::ml::metrics — Model Evaluation Metrics
// =============================================================================
// Classification:
//   accuracy, precision, recall, f1_score, f1_macro, f1_weighted
//   confusion_matrix, roc_auc, average_precision
//
// Regression:
//   mae, mse, rmse, r_squared, mape, huber_loss
//
// Multi-label:
//   hamming_loss, subset_accuracy, multilabel_f1
//
// All functions operate on plain []f32 or []i64 slices — zero allocations
// beyond the confusion matrix buffer (caller-supplied).
// =============================================================================

// =============================================================================
// Binary classification — expects labels in {0, 1}
// =============================================================================

// ---- confusion matrix cells (binary) ----------------------------------------
fn true_positives(pred: ref []i64, true: ref []i64) -> i64 {
    let tp = 0i64
    loop i in 0..pred.len {
        if pred[i] == 1 and true[i] == 1 { tp = tp + 1 }
    }
    ret tp
}
fn true_negatives(pred: ref []i64, true: ref []i64) -> i64 {
    let tn = 0i64
    loop i in 0..pred.len {
        if pred[i] == 0 and true[i] == 0 { tn = tn + 1 }
    }
    ret tn
}
fn false_positives(pred: ref []i64, true: ref []i64) -> i64 {
    let fp = 0i64
    loop i in 0..pred.len {
        if pred[i] == 1 and true[i] == 0 { fp = fp + 1 }
    }
    ret fp
}
fn false_negatives(pred: ref []i64, true: ref []i64) -> i64 {
    let fn_ = 0i64
    loop i in 0..pred.len {
        if pred[i] == 0 and true[i] == 1 { fn_ = fn_ + 1 }
    }
    ret fn_
}

// ---- accuracy ---------------------------------------------------------------
fn accuracy(pred: ref []i64, true: ref []i64) -> f64 {
    let correct = 0i64
    loop i in 0..pred.len {
        if pred[i] == true[i] { correct = correct + 1 }
    }
    ret correct as f64 / pred.len as f64
}

// ---- precision, recall, F1 --------------------------------------------------
fn precision(pred: ref []i64, true: ref []i64) -> f64 {
    let tp = true_positives(pred, true)
    let fp = false_positives(pred, true)
    if tp + fp == 0 { ret 0.0 }
    ret tp as f64 / (tp + fp) as f64
}

fn recall(pred: ref []i64, true: ref []i64) -> f64 {
    let tp = true_positives(pred, true)
    let fn_ = false_negatives(pred, true)
    if tp + fn_ == 0 { ret 0.0 }
    ret tp as f64 / (tp + fn_) as f64
}

fn f1_score(pred: ref []i64, true: ref []i64) -> f64 {
    let p = precision(pred, true)
    let r = recall(pred, true)
    if p + r < 1e-12 { ret 0.0 }
    ret 2.0 * p * r / (p + r)
}

// F-beta: beta=2 weights recall higher; beta=0.5 weights precision higher
fn f_beta(pred: ref []i64, true: ref []i64, beta: f64) -> f64 {
    let p = precision(pred, true)
    let r = recall(pred, true)
    let b2 = beta * beta
    let denom = b2 * p + r
    if denom < 1e-12 { ret 0.0 }
    ret (1.0 + b2) * p * r / denom
}

fn specificity(pred: ref []i64, true: ref []i64) -> f64 {
    let tn = true_negatives(pred, true)
    let fp = false_positives(pred, true)
    if tn + fp == 0 { ret 0.0 }
    ret tn as f64 / (tn + fp) as f64
}

fn matthews_corrcoef(pred: ref []i64, true: ref []i64) -> f64 {
    let tp = true_positives(pred, true)  as f64
    let tn = true_negatives(pred, true)  as f64
    let fp = false_positives(pred, true) as f64
    let fn_ = false_negatives(pred, true) as f64
    let denom = sqrt((tp+fp)*(tp+fn_)*(tn+fp)*(tn+fn_))
    if denom < 1e-12 { ret 0.0 }
    ret (tp * tn - fp * fn_) / denom
}

// =============================================================================
// Multi-class confusion matrix
// =============================================================================
// buf must be [n_classes * n_classes]i64 zeroed by caller
fn confusion_matrix(pred: ref []i64, true: ref []i64,
                    n_classes: i64, buf: []mut i64) {
    loop i in 0..n_classes * n_classes { buf[i] = 0 }
    loop i in 0..pred.len {
        let t = true[i]
        let p = pred[i]
        if t >= 0 and t < n_classes and p >= 0 and p < n_classes {
            buf[t * n_classes + p] = buf[t * n_classes + p] + 1
        }
    }
}

// Per-class precision from confusion matrix (col-normalised)
fn cm_precision(cm: ref []i64, c: i64, n_classes: i64) -> f64 {
    let tp = cm[c * n_classes + c]
    let col_sum = 0i64
    loop r in 0..n_classes { col_sum = col_sum + cm[r * n_classes + c] }
    if col_sum == 0 { ret 0.0 }
    ret tp as f64 / col_sum as f64
}

// Per-class recall from confusion matrix (row-normalised)
fn cm_recall(cm: ref []i64, c: i64, n_classes: i64) -> f64 {
    let tp = cm[c * n_classes + c]
    let row_sum = 0i64
    loop k in 0..n_classes { row_sum = row_sum + cm[c * n_classes + k] }
    if row_sum == 0 { ret 0.0 }
    ret tp as f64 / row_sum as f64
}

// Macro-F1: unweighted average of per-class F1
fn f1_macro(pred: ref []i64, true: ref []i64, n_classes: i64) -> f64 {
    let cm  = [n_classes * n_classes]i64
    confusion_matrix(pred, true, n_classes, cm)
    let sum = 0.0f64
    loop c in 0..n_classes {
        let p = cm_precision(cm, c, n_classes)
        let r = cm_recall(cm, c, n_classes)
        let f = if p + r < 1e-12 { 0.0 } else { 2.0 * p * r / (p + r) }
        sum = sum + f
    }
    ret sum / n_classes as f64
}

// Weighted-F1: weighted by class support
fn f1_weighted(pred: ref []i64, true: ref []i64, n_classes: i64) -> f64 {
    let cm  = [n_classes * n_classes]i64
    confusion_matrix(pred, true, n_classes, cm)
    let total = pred.len as f64
    let sum   = 0.0f64
    loop c in 0..n_classes {
        let support = 0i64
        loop k in 0..n_classes { support = support + cm[c * n_classes + k] }
        let p = cm_precision(cm, c, n_classes)
        let r = cm_recall(cm, c, n_classes)
        let f = if p + r < 1e-12 { 0.0 } else { 2.0 * p * r / (p + r) }
        sum = sum + f * support as f64
    }
    ret sum / total
}

// Micro-F1: aggregate TP/FP/FN across all classes
fn f1_micro(pred: ref []i64, true: ref []i64, n_classes: i64) -> f64 {
    let tp_all = 0i64
    let fp_all = 0i64
    let fn_all = 0i64
    loop c in 0..n_classes {
        loop i in 0..pred.len {
            let is_p = pred[i] == c
            let is_t = true[i] == c
            if is_p  and is_t  { tp_all = tp_all + 1 }
            if is_p  and not is_t { fp_all = fp_all + 1 }
            if not is_p and is_t  { fn_all = fn_all + 1 }
        }
    }
    let p = if tp_all + fp_all == 0 { 0.0 } else { tp_all as f64 / (tp_all + fp_all) as f64 }
    let r = if tp_all + fn_all == 0 { 0.0 } else { tp_all as f64 / (tp_all + fn_all) as f64 }
    if p + r < 1e-12 { ret 0.0 }
    ret 2.0 * p * r / (p + r)
}

// =============================================================================
// ROC-AUC (binary) — trapezoidal rule
// =============================================================================
// scores: predicted probabilities for class 1  ([0.0, 1.0])
// true:   binary ground-truth labels {0, 1}
//
// Complexity: O(n log n) sort + O(n) integration
fn roc_auc(scores: ref []f32, true: ref []i64) -> f64 {
    let n = scores.len

    // argsort scores descending
    let order = [n]i64
    loop i in 0..n { order[i] = i }
    // insertion sort (simple; use mergesort for large n in production)
    loop i in 1..n {
        let key_i = order[i]
        let key_s = scores[key_i]
        let j = i - 1
        loop j >= 0 and scores[order[j]] < key_s {
            order[j+1] = order[j]
            j = j - 1
        }
        order[j+1] = key_i
    }

    let pos = 0i64   // total positives
    loop i in 0..n { if true[i] == 1 { pos = pos + 1 } }
    let neg = n - pos

    if pos == 0 or neg == 0 { ret 0.5 }

    let tpr = 0.0f64   // true  positive rate (recall)
    let fpr = 0.0f64   // false positive rate
    let auc = 0.0f64
    let prev_tpr = 0.0f64
    let prev_fpr = 0.0f64
    let prev_score = scores[order[0]] + 1.0f32  // sentinel

    loop i in 0..n {
        let idx = order[i]
        let s   = scores[idx]
        if s != prev_score {
            // integrate trapezoid
            auc = auc + (fpr - prev_fpr) * (tpr + prev_tpr) / 2.0
            prev_tpr   = tpr
            prev_fpr   = fpr
            prev_score = s
        }
        if true[idx] == 1 {
            tpr = tpr + 1.0 / pos as f64
        } else {
            fpr = fpr + 1.0 / neg as f64
        }
    }
    // final trapezoid to (1,1)
    auc = auc + (fpr - prev_fpr) * (tpr + prev_tpr) / 2.0
    auc = auc + (1.0 - fpr) * (tpr + 1.0) / 2.0
    ret auc
}

// Average precision (area under PR curve)
fn average_precision(scores: ref []f32, true: ref []i64) -> f64 {
    let n = scores.len
    let order = [n]i64
    loop i in 0..n { order[i] = i }
    // sort descending by score (insertion sort)
    loop i in 1..n {
        let ki = order[i]
        let ks = scores[ki]
        let j  = i - 1
        loop j >= 0 and scores[order[j]] < ks {
            order[j+1] = order[j]
            j = j - 1
        }
        order[j+1] = ki
    }
    let tp  = 0.0f64
    let ap  = 0.0f64
    loop i in 0..n {
        if true[order[i]] == 1 {
            tp = tp + 1.0
            ap = ap + tp / (i + 1) as f64
        }
    }
    let pos = 0i64
    loop i in 0..n { if true[i] == 1 { pos = pos + 1 } }
    if pos == 0 { ret 0.0 }
    ret ap / pos as f64
}

// =============================================================================
// Regression metrics
// =============================================================================

fn mae(pred: ref []f32, true: ref []f32) -> f64 {
    let s = 0.0f64
    loop i in 0..pred.len { s = s + abs(pred[i] - true[i]) as f64 }
    ret s / pred.len as f64
}

fn mse(pred: ref []f32, true: ref []f32) -> f64 {
    let s = 0.0f64
    loop i in 0..pred.len {
        let d = (pred[i] - true[i]) as f64
        s = s + d * d
    }
    ret s / pred.len as f64
}

fn rmse(pred: ref []f32, true: ref []f32) -> f64 {
    ret sqrt(mse(pred, true))
}

fn r_squared(pred: ref []f32, true: ref []f32) -> f64 {
    let mean_true = 0.0f64
    for v in true { mean_true = mean_true + v as f64 }
    mean_true = mean_true / true.len as f64

    let ss_res = 0.0f64   // residual sum of squares
    let ss_tot = 0.0f64   // total sum of squares
    loop i in 0..pred.len {
        let d_res = (pred[i] - true[i]) as f64
        let d_tot = true[i] as f64 - mean_true
        ss_res = ss_res + d_res * d_res
        ss_tot = ss_tot + d_tot * d_tot
    }
    if ss_tot < 1e-12 { ret 1.0 }
    ret 1.0 - ss_res / ss_tot
}

// Mean Absolute Percentage Error (in %)
fn mape(pred: ref []f32, true: ref []f32) -> f64 {
    let s = 0.0f64
    let n = 0i64
    loop i in 0..pred.len {
        if abs(true[i]) > 1e-6 {
            s = s + abs((pred[i] - true[i]) / true[i]) as f64
            n = n + 1
        }
    }
    if n == 0 { ret 0.0 }
    ret s / n as f64 * 100.0
}

// Huber loss (robust to outliers, delta=1.0 by default)
fn huber_loss(pred: ref []f32, true: ref []f32, delta: f32) -> f64 {
    let s = 0.0f64
    loop i in 0..pred.len {
        let a = abs(pred[i] - true[i])
        if a <= delta {
            s = s + 0.5 * (a * a) as f64
        } else {
            s = s + (delta as f64 * (a as f64 - 0.5 * delta as f64))
        }
    }
    ret s / pred.len as f64
}

fn median_absolute_error(pred: ref []f32, true: ref []f32) -> f64 {
    let n = pred.len
    let errs = [n]f32
    loop i in 0..n { errs[i] = abs(pred[i] - true[i]) }
    // partial insertion sort to find median
    loop i in 1..n {
        let key = errs[i]
        let j   = i - 1
        loop j >= 0 and errs[j] > key {
            errs[j+1] = errs[j]
            j = j - 1
        }
        errs[j+1] = key
    }
    if n % 2 == 1 {
        ret errs[n / 2] as f64
    }
    ret (errs[n/2 - 1] + errs[n/2]) as f64 / 2.0
}

// =============================================================================
// Multi-label classification metrics
// =============================================================================

// Hamming loss: fraction of labels that are incorrectly predicted
fn hamming_loss(pred: ref [][]i64, true: ref [][]i64) -> f64 {
    let n = pred.len
    let k = pred[0].len    // number of labels
    let wrong = 0i64
    loop i in 0..n {
        loop j in 0..k {
            if pred[i][j] != true[i][j] { wrong = wrong + 1 }
        }
    }
    ret wrong as f64 / (n * k) as f64
}

// Subset accuracy: fraction of samples where ALL labels are correct
fn subset_accuracy(pred: ref [][]i64, true: ref [][]i64) -> f64 {
    let n = pred.len
    let k = pred[0].len
    let exact = 0i64
    loop i in 0..n {
        let all_ok = true
        loop j in 0..k {
            if pred[i][j] != true[i][j] { all_ok = false   break }
        }
        if all_ok { exact = exact + 1 }
    }
    ret exact as f64 / n as f64
}

// =============================================================================
// Pretty-print helpers
// =============================================================================
fn print_classification_report(pred: ref []i64, true: ref []i64,
                                n_classes: i64,
                                class_names: ref [][]i8) {
    let cm = [n_classes * n_classes]i64
    confusion_matrix(pred, true, n_classes, cm)

    print("              precision    recall  f1-score   support\n")
    loop c in 0..n_classes {
        let p     = cm_precision(cm, c, n_classes)
        let r     = cm_recall(cm, c, n_classes)
        let f     = if p + r < 1e-12 { 0.0 } else { 2.0 * p * r / (p + r) }
        let sup   = 0i64
        loop k in 0..n_classes { sup = sup + cm[c * n_classes + k] }
        let name  = if c < class_names.len { class_names[c] } else { "?" }
        print(fmt_str("{:<14} {:>9.2f} {:>9.2f} {:>9.2f} {:>9}\n",
              [ArgStr(name), ArgF64(p), ArgF64(r), ArgF64(f), ArgI64(sup)]))
    }
    print("\n")
    let acc = accuracy(pred, true)
    print(fmt_str("    accuracy                          {:>9.2f} {:>9}\n",
          [ArgF64(acc), ArgI64(pred.len)]))
    print(fmt_str("   macro avg  {:>9.2f} {:>9.2f} {:>9.2f} {:>9}\n",
          [ArgF64(0.0), ArgF64(0.0),
           ArgF64(f1_macro(pred, true, n_classes)),
           ArgI64(pred.len)]))
}

fn print_confusion_matrix(cm: ref []i64, n_classes: i64,
                           class_names: ref [][]i8) {
    print("Confusion Matrix:\n")
    print("Predicted →\n")
    loop r in 0..n_classes {
        let name = if r < class_names.len { class_names[r] } else { "?" }
        print(fmt_str("{:<10}", [ArgStr(name)]))
        loop c in 0..n_classes {
            print(fmt_str("{:>6}", [ArgI64(cm[r * n_classes + c])]))
        }
        print("\n")
    }
}

// =============================================================================
// Usage example
// =============================================================================
//
//   let true_labels = [0i64, 1, 1, 0, 2, 1, 0, 2, 2]
//   let pred_labels = [0i64, 1, 0, 0, 2, 1, 1, 2, 1]
//
//   print("accuracy:  ", accuracy(&pred_labels, &true_labels))   // 0.667
//   print("macro-F1:  ", f1_macro(&pred_labels, &true_labels, 3))
//
//   let scores = [0.9f32, 0.8, 0.3, 0.1, 0.7, 0.6, 0.4, 0.2, 0.5]
//   let binary  = [1i64,  1,   0,   0,   1,   1,   0,   0,   0]
//   print("ROC-AUC:   ", roc_auc(&scores, &binary))
//
//   let pred_f = [2.5f32, 0.0, 2.1, 7.8]
//   let true_f = [3.0f32, -0.5, 2.0, 7.0]
//   print("MAE:  ", mae(&pred_f, &true_f))
//   print("RMSE: ", rmse(&pred_f, &true_f))
//   print("R²:   ", r_squared(&pred_f, &true_f))
