// =============================================================================
// jda::ml::nn — Native Neural Network Standard Library
// =============================================================================
// Built entirely on jda's native Tensor primitives and compile-time Autograd.
// No C++. No Python. No PyTorch. No runtime overhead.
//
// Modules:
//   Linear   — fully-connected layer  (weight matrix + bias)
//   ReLU     — rectified linear unit activation
//   Sigmoid  — logistic activation
//   Tanh     — hyperbolic tangent activation
//   Softmax  — normalised exponential (for classification output)
//   MSELoss  — mean squared error
//   CELoss   — cross-entropy loss
//   Adam     — adaptive moment estimation optimizer
//   SGD      — stochastic gradient descent optimizer
// =============================================================================

import jda::ml::tensor

// =============================================================================
// Trait: Layer<In, Out>
// =============================================================================
// All layers implement this trait.
// `forward` is marked @differentiable so the compiler generates backward.
trait Layer<const In: i64, const Out: i64> {
    @differentiable
    fn forward(self, x: ref Tensor<[dyn, In], f32>) -> Tensor<[dyn, Out], f32>

    fn parameters(self) -> []&mut Tensor<dyn, f32>
}

// =============================================================================
// Linear — y = x @ W.T + b
// =============================================================================
struct Linear<const In: i64, const Out: i64> {
    W: Tensor<[Out, In], f32>    // weight matrix  [out_features × in_features]
    b: Tensor<[Out], f32>        // bias vector    [out_features]
}

impl<const In: i64, const Out: i64> Linear<In, Out> {
    // He initialisation (good for ReLU networks)
    fn new() -> own Linear<In, Out> {
        let scale = sqrt(2.0 / In as f32)
        ret Linear {
            W: Tensor<[Out, In], f32>::randn() * scale,
            b: Tensor<[Out], f32>::zeros(),
        }
    }

    // Xavier / Glorot initialisation (good for tanh/sigmoid)
    fn new_xavier() -> own Linear<In, Out> {
        let limit = sqrt(6.0 / (In + Out) as f32)
        ret Linear {
            W: Tensor<[Out, In], f32>::rand(-limit, limit),
            b: Tensor<[Out], f32>::zeros(),
        }
    }

    @differentiable
    fn forward(self, x: ref Tensor<[dyn, In], f32>) -> Tensor<[dyn, Out], f32> {
        ret x @ self.W.T + self.b    // [B, In] @ [In, Out] + [Out] = [B, Out]
    }
    // Compiler generates `forward_grad`:
    //   dL/dx = grad @ W          (backprop through matmul)
    //   dL/dW = x.T @ grad        (weight gradient)
    //   dL/db = grad.sum(dim: 0)  (bias gradient)

    fn parameters(self) -> []&mut Tensor<dyn, f32> {
        ret [&mut self.W, &mut self.b]
    }
}

// =============================================================================
// Activation Functions
// =============================================================================

struct ReLU {}
impl ReLU {
    @differentiable
    fn forward(self, x: ref Tensor<dyn, f32>) -> Tensor<dyn, f32> {
        ret x.max(0.0)    // element-wise max(x, 0)
    }
    // Grad: dy/dx = x > 0 ? 1 : 0  (generated by compiler)
}

struct Sigmoid {}
impl Sigmoid {
    @differentiable
    fn forward(self, x: ref Tensor<dyn, f32>) -> Tensor<dyn, f32> {
        ret 1.0 / (1.0 + (-x).exp())
    }
    // Grad: dy/dx = y * (1 - y)  (generated by compiler)
}

struct Tanh {}
impl Tanh {
    @differentiable
    fn forward(self, x: ref Tensor<dyn, f32>) -> Tensor<dyn, f32> {
        ret x.tanh()
    }
    // Grad: dy/dx = 1 - tanh(x)^2  (generated by compiler)
}

fn softmax(x: ref Tensor<dyn, f32>, dim: i32) -> Tensor<dyn, f32> {
    let e = (x - x.max(dim: dim).unsqueeze(dim)).exp()
    ret e / e.sum(dim: dim).unsqueeze(dim)
}

// =============================================================================
// Loss Functions
// =============================================================================

@differentiable
fn mse_loss(pred: ref Tensor<dyn, f32>,
            target: ref Tensor<dyn, f32>) -> Tensor<[], f32> {
    let d = pred - target
    ret (d * d).mean()
}

@differentiable
fn cross_entropy_loss(logits: ref Tensor<[dyn, dyn], f32>,
                      labels: ref Tensor<[dyn], i32>) -> Tensor<[], f32> {
    let B    = logits.shape[0] as f32
    let probs = softmax(logits, dim: 1)
    let oh   = one_hot(labels, logits.shape[1])    // [B, C]
    ret -(probs.log() * oh).sum() / B
}

fn one_hot(labels: ref Tensor<[dyn], i32>, n_classes: i64) -> Tensor<[dyn, dyn], f32> {
    let B   = labels.shape[0]
    let out = Tensor<[B, n_classes], f32>::zeros()
    loop i in 0..B {
        out[i, labels[i] as i64] = 1.0
    }
    ret out
}

// =============================================================================
// Adam Optimizer
// =============================================================================
// Adaptive Moment Estimation — by far the most common optimizer in deep learning.
//
// Update rule:
//   m = β1 * m + (1 - β1) * g          (first moment — momentum)
//   v = β2 * v + (1 - β2) * g²         (second moment — RMSProp)
//   m̂ = m / (1 - β1^t)                 (bias correction)
//   v̂ = v / (1 - β2^t)                 (bias correction)
//   θ = θ - lr * m̂ / (sqrt(v̂) + ε)    (parameter update)

struct AdamState {
    m:   Tensor<dyn, f32>   // first moment
    v:   Tensor<dyn, f32>   // second moment
}

struct Adam {
    lr:     f32             // learning rate (default: 1e-3)
    beta1:  f32             // (default: 0.9)
    beta2:  f32             // (default: 0.999)
    eps:    f32             // numerical stability (default: 1e-8)
    t:      i64             // step counter
    states: []AdamState     // one state per parameter tensor
}

impl Adam {
    fn new(lr: f32) -> own Adam {
        ret Adam { lr: lr, beta1: 0.9, beta2: 0.999, eps: 1e-8, t: 0, states: [] }
    }

    fn init(mut self, params: []&mut Tensor<dyn, f32>) {
        for p in params {
            self.states.push(AdamState {
                m: Tensor::zeros_like(p),
                v: Tensor::zeros_like(p),
            })
        }
    }

    fn step(mut self, params: []&mut Tensor<dyn, f32>,
            grads:  []ref  Tensor<dyn, f32>) {
        self.t = self.t + 1
        let t  = self.t as f32
        let b1 = self.beta1
        let b2 = self.beta2

        loop i in 0..params.len {
            let p = params[i]
            let g = grads[i]
            let s = &mut self.states[i]

            // Moment updates
            s.m = b1 * s.m + (1.0 - b1) * g
            s.v = b2 * s.v + (1.0 - b2) * (g * g)

            // Bias-corrected moments
            let m_hat = s.m / (1.0 - b1 ^ t)
            let v_hat = s.v / (1.0 - b2 ^ t)

            // Parameter update
            p[0] = p[0] - self.lr * m_hat / (v_hat.sqrt() + self.eps)
        }
    }

    fn zero_grad(grads: []&mut Tensor<dyn, f32>) {
        for g in grads { g[0] = Tensor::zeros_like(g) }
    }
}

// =============================================================================
// SGD with momentum
// =============================================================================
struct SGD {
    lr:       f32
    momentum: f32
    velocity: []Tensor<dyn, f32>
}

impl SGD {
    fn new(lr: f32, momentum: f32) -> own SGD {
        ret SGD { lr: lr, momentum: momentum, velocity: [] }
    }

    fn step(mut self, params: []&mut Tensor<dyn, f32>,
            grads:  []ref  Tensor<dyn, f32>) {
        loop i in 0..params.len {
            self.velocity[i] = self.momentum * self.velocity[i] + grads[i]
            params[i][0] = params[i][0] - self.lr * self.velocity[i]
        }
    }
}
