; =============================================================================
; jda::time -- Clocks & Sleep
; =============================================================================
; Direct Linux syscalls. No libc.
;
; Functions:
;   time_now_ns() -> nanoseconds (monotonic clock)
;   time_now_us() -> microseconds (monotonic clock)
;   time_now_ms() -> milliseconds (monotonic clock)
;   time_sleep_ns(ns) -- sleep for nanoseconds
;   time_sleep_ms(ms) -- sleep for milliseconds
;   time_elapsed_ns(start_ns) -> nanoseconds since start_ns
;   time_unix_secs() -> seconds since Unix epoch (wall clock)
; =============================================================================

struct Timespec {
    tv_sec: i64
    tv_nsec: i64
}

fn time_now_ns() -> i64 {
    ; clock_gettime(CLOCK_MONOTONIC=1, &ts)
    let ts = Timespec{}
    syscall(228, 1, &ts, 0)
    ret ts.tv_sec * 1000000000 + ts.tv_nsec
}

fn time_now_us() -> i64 {
    let ns = time_now_ns()
    ret ns / 1000
}

fn time_now_ms() -> i64 {
    let ns = time_now_ns()
    ret ns / 1000000
}

fn time_sleep_ns(ns: i64) {
    let req = Timespec{}
    req.tv_sec = ns / 1000000000
    req.tv_nsec = ns - req.tv_sec * 1000000000
    syscall(35, &req, 0, 0)
}

fn time_sleep_ms(ms: i64) {
    time_sleep_ns(ms * 1000000)
}

fn time_elapsed_ns(start_ns: i64) -> i64 {
    let now = time_now_ns()
    ret now - start_ns
}

fn time_unix_secs() -> i64 {
    ; clock_gettime(CLOCK_REALTIME=0, &ts)
    let ts = Timespec{}
    syscall(228, 0, &ts, 0)
    ret ts.tv_sec
}
