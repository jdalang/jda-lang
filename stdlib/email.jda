// =============================================================================
// jda::email -- Email Message Parser/Composer
// =============================================================================
// Parses RFC 2822-style email messages into headers and body.
// Headers are separated from body by a blank line (\n\n).
// Each header is "Name: Value\n".

// Memory layout per EmailHandle (&i64):
//   [0] header_count
//   [1] hdr_name_offs   (&i64 — byte offsets into data)
//   [2] hdr_name_lens   (&i64)
//   [3] hdr_val_offs    (&i64)
//   [4] hdr_val_lens    (&i64)
//   [5] body_off
//   [6] body_len
//   [7] data            (&i8 — copy of source)
//   [8] data_len

// Functions:
//   email_parse(buf, len)                   -> &i64  parse email
//   email_from(h, out)                      -> i64   copy From value
//   email_to(h, out)                        -> i64   copy To value
//   email_subject(h, out)                   -> i64   copy Subject value
//   email_body(h, out)                      -> i64   copy body
//   email_header(h, name, nlen, out)        -> i64   copy header value by name
//   email_header_count(h)                   -> i64   number of headers
// =============================================================================

// Internal byte reader.
fn _email_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

// Internal: copy bytes.
fn _email_copy(dst: &i8, src: &i8, off: i64, len: i64) -> i64 {
    let i = 0
    loop i < len {
        let ch = _email_byte_at(src, off + i)
        poke_byte(dst, i, ch)
        i = i + 1
    }
    ret len
}

// Internal: case-insensitive compare single bytes.
fn _email_lower(ch: i64) -> i64 {
    if ch >= 65 and ch <= 90 {
        let r = ch + 32
        ret r
    }
    ret ch
}

// Internal: case-insensitive compare.
fn _email_eq_ci(a: &i8, aoff: i64, alen: i64, b: &i8, boff: i64, blen: i64) -> i64 {
    if alen != blen { ret 0 }
    let i = 0
    loop i < alen {
        let ca = _email_byte_at(a, aoff + i)
        let cb = _email_byte_at(b, boff + i)
        if ca < 0 { ca = ca + 256 }
        if cb < 0 { cb = cb + 256 }
        ca = _email_lower(ca)
        cb = _email_lower(cb)
        if ca != cb { ret 0 }
        i = i + 1
    }
    ret 1
}

// Internal: find the blank line separating headers from body.
// Returns offset of body start, or len if no blank line.
fn _email_find_body(buf: &i8, len: i64) -> i64 {
    let i = 0
    let limit = len - 1
    loop i < limit {
        let ch = _email_byte_at(buf, i)
        if ch == 10 {
            let next = _email_byte_at(buf, i + 1)
            if next == 10 {
                let r = i + 2
                ret r
            }
            // Check for \n\r\n
            if next == 13 and i + 2 < len {
                let nn = _email_byte_at(buf, i + 2)
                if nn == 10 {
                    let r = i + 3
                    ret r
                }
            }
        }
        i = i + 1
    }
    ret len
}

// Internal: parse one header line starting at pos.
// Sets name_off, name_len, val_off, val_len via handle slots.
// Returns position after the header line (after \n).
fn _email_parse_hdr(buf: &i8, pos: i64, hdr_end: i64, h: &i64, idx: i64) -> i64 {
    let name_offs: &i64 = h[1]
    let name_lens: &i64 = h[2]
    let val_offs: &i64 = h[3]
    let val_lens: &i64 = h[4]
    // Find colon
    let cpos = pos
    let found_colon = 0
    loop cpos < hdr_end {
        let ch = _email_byte_at(buf, cpos)
        if ch == 58 { found_colon = 1 }
        if ch == 10 { found_colon = 0 }
        if found_colon == 1 or ch == 10 {
            cpos = hdr_end  // break
        } else {
            cpos = cpos + 1
        }
    }
    if found_colon == 0 {
        // Skip to next line
        let sk = pos
        loop sk < hdr_end {
            let ch = _email_byte_at(buf, sk)
            if ch == 10 {
                let r = sk + 1
                ret r
            }
            sk = sk + 1
        }
        ret hdr_end
    }
    // cpos points to just before colon; re-find it
    let cp = pos
    loop cp < hdr_end {
        let ch = _email_byte_at(buf, cp)
        if ch == 58 {
            name_offs[idx] = pos
            let nlen = cp - pos
            name_lens[idx] = nlen
            // Skip colon and optional space
            cp = cp + 1
            if cp < hdr_end {
                let sp = _email_byte_at(buf, cp)
                if sp == 32 { cp = cp + 1 }
            }
            // Value runs to end of line
            let vs = cp
            loop cp < hdr_end {
                let ch2 = _email_byte_at(buf, cp)
                if ch2 == 10 {
                    let vlen = cp - vs
                    // Strip trailing \r
                    if vlen > 0 {
                        let last = vs + vlen - 1
                        let lc = _email_byte_at(buf, last)
                        if lc == 13 { vlen = vlen - 1 }
                    }
                    val_offs[idx] = vs
                    val_lens[idx] = vlen
                    let r = cp + 1
                    ret r
                }
                cp = cp + 1
            }
            // No newline at end
            let vlen = cp - vs
            val_offs[idx] = vs
            val_lens[idx] = vlen
            ret cp
        }
        cp = cp + 1
    }
    ret hdr_end
}

// Parse an email message. Returns handle.
fn email_parse(buf: &i8, len: i64) -> &i64 {
    let h: &i64 = alloc_pages(1)
    let name_offs: &i64 = alloc_pages(1)
    let name_lens: &i64 = alloc_pages(1)
    let val_offs: &i64 = alloc_pages(1)
    let val_lens: &i64 = alloc_pages(1)
    let data: &i8 = alloc_pages(2)
    // Copy source
    let ci = 0
    loop ci < len {
        let cb = _email_byte_at(buf, ci)
        poke_byte(data, ci, cb)
        ci = ci + 1
    }
    h[0] = 0
    h[1] = name_offs
    h[2] = name_lens
    h[3] = val_offs
    h[4] = val_lens
    h[5] = 0
    h[6] = 0
    h[7] = data
    h[8] = len
    // Find body start
    let body_start = _email_find_body(data, len)
    h[5] = body_start
    let blen = len - body_start
    if blen < 0 { blen = 0 }
    h[6] = blen
    // Parse headers
    let pos = 0
    let hdr_count = 0
    let running = 1
    loop running == 1 {
        if pos >= body_start { running = 0 }
        if running == 1 {
            // Skip blank lines
            let ch = _email_byte_at(data, pos)
            if ch == 10 {
                pos = pos + 1
            } else {
                if ch == 13 {
                    pos = pos + 1
                } else {
                    pos = _email_parse_hdr(data, pos, body_start, h, hdr_count)
                    hdr_count = hdr_count + 1
                }
            }
        }
    }
    h[0] = hdr_count
    ret h
}

// Internal: find header by name (case-insensitive), copy value to out.
fn _email_get_hdr(h: &i64, name: &i8, nlen: i64, out: &i8) -> i64 {
    let count = h[0]
    let name_offs: &i64 = h[1]
    let name_lens: &i64 = h[2]
    let val_offs: &i64 = h[3]
    let val_lens: &i64 = h[4]
    let data: &i8 = h[7]
    let i = 0
    loop i < count {
        let eq = _email_eq_ci(data, name_offs[i], name_lens[i], name, 0, nlen)
        if eq == 1 {
            let vlen = val_lens[i]
            let voff = val_offs[i]
            let copied = _email_copy(out, data, voff, vlen)
            ret copied
        }
        i = i + 1
    }
    ret 0
}

// Get From header value.
fn email_from(h: &i64, out: &i8) -> i64 {
    // Build "From" key: F=70, r=114, o=111, m=109
    let key: &i8 = h  // reuse handle memory temporarily... no, use stack trick
    // We need a small buffer for the key name. Use pointer arithmetic.
    // Actually, just inline the comparison in _email_get_hdr with a temp buf.
    // Since we can't alloc here (no alloc_pages in helpers), we pass through.
    // Workaround: build key on caller's stack — but jda has no stack arrays.
    // Solution: use the data buffer's unused tail area as scratch.
    let data: &i8 = h[7]
    let dlen = h[8]
    // Write "From" at dlen offset (scratch area)
    poke_byte(data, dlen, 70)
    poke_byte(data, dlen + 1, 114)
    poke_byte(data, dlen + 2, 111)
    poke_byte(data, dlen + 3, 109)
    let key: &i8 = data + dlen
    let r = _email_get_hdr(h, key, 4, out)
    ret r
}

// Get To header value.
fn email_to(h: &i64, out: &i8) -> i64 {
    let data: &i8 = h[7]
    let dlen = h[8]
    // "To" = 84, 111
    poke_byte(data, dlen, 84)
    poke_byte(data, dlen + 1, 111)
    let key: &i8 = data + dlen
    let r = _email_get_hdr(h, key, 2, out)
    ret r
}

// Get Subject header value.
fn email_subject(h: &i64, out: &i8) -> i64 {
    let data: &i8 = h[7]
    let dlen = h[8]
    // "Subject" = 83,117,98,106,101,99,116
    poke_byte(data, dlen, 83)
    poke_byte(data, dlen + 1, 117)
    poke_byte(data, dlen + 2, 98)
    poke_byte(data, dlen + 3, 106)
    poke_byte(data, dlen + 4, 101)
    poke_byte(data, dlen + 5, 99)
    poke_byte(data, dlen + 6, 116)
    let key: &i8 = data + dlen
    let r = _email_get_hdr(h, key, 7, out)
    ret r
}

// Get email body.
fn email_body(h: &i64, out: &i8) -> i64 {
    let data: &i8 = h[7]
    let body_off = h[5]
    let body_len = h[6]
    let copied = _email_copy(out, data, body_off, body_len)
    ret copied
}

// Get any header value by name.
fn email_header(h: &i64, name: &i8, nlen: i64, out: &i8) -> i64 {
    let r = _email_get_hdr(h, name, nlen, out)
    ret r
}

// Return number of headers.
fn email_header_count(h: &i64) -> i64 {
    ret h[0]
}
