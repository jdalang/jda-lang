; =============================================================================
; jda::lint -- Code Style Checker / Linter Helpers
; =============================================================================
; Convention-based linting utilities for Jda code. Checks naming conventions,
; common style rules, and reports warnings. Can be used by tools or called
; from test code to enforce project style.
;
; Naming rules:
;   - Functions: snake_case (lowercase + underscores)
;   - Constants: UPPER_SNAKE (uppercase + underscores + digits)
;   - Variables: snake_case
;   - Struct types: PascalCase (uppercase first letter)
;   - Private: leading underscore
;
; Functions:
;   lint_init()                          initialize linter (call once)
;   lint_is_snake(name)      -> i64      1 if valid snake_case
;   lint_is_upper(name)      -> i64      1 if valid UPPER_SNAKE
;   lint_is_pascal(name)     -> i64      1 if valid PascalCase
;   lint_check_fn(name)      -> i64      1 if valid function name
;   lint_check_const(name)   -> i64      1 if valid constant name
;   lint_check_struct(name)  -> i64      1 if valid struct name
;   lint_check_var(name)     -> i64      1 if valid variable name
;   lint_warn(name, msg)                 print "[LINT] name: msg"
;   lint_add_warning(msg)                add to warning count
;   lint_warning_count()     -> i64      get total warnings
;   lint_reset()                         reset warning count
;   lint_summary()                       print summary
;   lint_check_line_len(line, max)  -> i64  1 if line within max chars
;   lint_has_trailing_ws(line)      -> i64  1 if trailing whitespace
; =============================================================================

let _lint_warnings: i64 = 0
let _lint_inited: i64 = 0

; --- Internal helpers ---

fn _lint_cstr_len(s: &i8) -> i64 {
    let n = 0
    loop n < 512 {
        if s[n] == 0 { ret n }
        n = n + 1
    }
    ret 512
}

fn _lint_write(s: &i8, len: i64) {
    syscall(1, 1, s, len)
}

fn _lint_print_str(s: &i8) {
    let n = _lint_cstr_len(s)
    _lint_write(s, n)
}

fn _lint_byte_at(buf: &i8, idx: i64) -> i64 {
    ret buf[idx]
}

fn _lint_is_lower(ch: i64) -> i64 {
    if ch >= 97 {
        if ch <= 122 { ret 1 }
    }
    ret 0
}

fn _lint_is_upper_ch(ch: i64) -> i64 {
    if ch >= 65 {
        if ch <= 90 { ret 1 }
    }
    ret 0
}

fn _lint_is_digit(ch: i64) -> i64 {
    if ch >= 48 {
        if ch <= 57 { ret 1 }
    }
    ret 0
}

fn _lint_is_underscore(ch: i64) -> i64 {
    if ch == 95 { ret 1 }
    ret 0
}

; --- Initialization ---

;; Initialize the linter.
fn lint_init() {
    if _lint_inited == 1 { ret }
    _lint_warnings = 0
    _lint_inited = 1
}

;; Reset warning count.
fn lint_reset() {
    _lint_warnings = 0
}

; --- Naming checks ---

;; Check if name is valid snake_case: lowercase, digits, underscores.
;; First char must be lowercase or underscore.
fn lint_is_snake(name: &i8) -> i64 {
    let len = _lint_cstr_len(name)
    if len == 0 { ret 0 }
    let ch0 = name[0]
    let ok0 = _lint_is_lower(ch0)
    let us0 = _lint_is_underscore(ch0)
    if ok0 == 0 {
        if us0 == 0 { ret 0 }
    }
    let i = 1
    loop i < len {
        let ch = name[i]
        let lo = _lint_is_lower(ch)
        let di = _lint_is_digit(ch)
        let us = _lint_is_underscore(ch)
        if lo == 0 {
            if di == 0 {
                if us == 0 { ret 0 }
            }
        }
        i = i + 1
    }
    ret 1
}

;; Check if name is valid UPPER_SNAKE: uppercase, digits, underscores.
fn lint_is_upper(name: &i8) -> i64 {
    let len = _lint_cstr_len(name)
    if len == 0 { ret 0 }
    let i = 0
    loop i < len {
        let ch = name[i]
        let up = _lint_is_upper_ch(ch)
        let di = _lint_is_digit(ch)
        let us = _lint_is_underscore(ch)
        if up == 0 {
            if di == 0 {
                if us == 0 { ret 0 }
            }
        }
        i = i + 1
    }
    ret 1
}

;; Check if name is valid PascalCase: starts with uppercase, then letters/digits.
fn lint_is_pascal(name: &i8) -> i64 {
    let len = _lint_cstr_len(name)
    if len == 0 { ret 0 }
    let ch0 = name[0]
    let up0 = _lint_is_upper_ch(ch0)
    if up0 == 0 { ret 0 }
    let i = 1
    loop i < len {
        let ch = name[i]
        let lo = _lint_is_lower(ch)
        let up = _lint_is_upper_ch(ch)
        let di = _lint_is_digit(ch)
        if lo == 0 {
            if up == 0 {
                if di == 0 { ret 0 }
            }
        }
        i = i + 1
    }
    ret 1
}

;; Check if valid function name: snake_case.
fn lint_check_fn(name: &i8) -> i64 {
    ret lint_is_snake(name)
}

;; Check if valid constant name: UPPER_SNAKE.
fn lint_check_const(name: &i8) -> i64 {
    ret lint_is_upper(name)
}

;; Check if valid struct name: PascalCase.
fn lint_check_struct(name: &i8) -> i64 {
    ret lint_is_pascal(name)
}

;; Check if valid variable name: snake_case.
fn lint_check_var(name: &i8) -> i64 {
    ret lint_is_snake(name)
}

; --- Warnings ---

;; Print a lint warning: "[LINT] name: msg"
fn lint_warn(name: &i8, msg: &i8) {
    _lint_write("[LINT] ", 7)
    _lint_print_str(name)
    _lint_write(": ", 2)
    _lint_print_str(msg)
    _lint_write("\n", 1)
    _lint_warnings = _lint_warnings + 1
}

;; Add to warning count (silent).
fn lint_add_warning(msg: &i8) {
    _lint_warnings = _lint_warnings + 1
}

;; Get total warning count.
fn lint_warning_count() -> i64 {
    ret _lint_warnings
}

; --- Line checks ---

;; Check if line length is within max chars. Returns 1 if ok.
fn lint_check_line_len(line: &i8, maxlen: i64) -> i64 {
    let len = _lint_cstr_len(line)
    if len <= maxlen { ret 1 }
    ret 0
}

;; Check if line has trailing whitespace (space or tab before null).
fn lint_has_trailing_ws(line: &i8) -> i64 {
    let len = _lint_cstr_len(line)
    if len == 0 { ret 0 }
    let last = len - 1
    let ch = line[last]
    if ch == 32 { ret 1 }
    if ch == 9 { ret 1 }
    ret 0
}

; --- Summary ---

;; Print lint summary.
fn lint_summary() {
    _lint_write("[LINT] ", 7)
    let w = _lint_warnings
    print("{w}")
    if _lint_warnings == 1 {
        _lint_write(" warning\n", 9)
    } else {
        _lint_write(" warnings\n", 10)
    }
}
