// =============================================================================
// jda::zipfile -- ZIP Archive Format (Stored Only)
// =============================================================================
// Read and write ZIP archives with stored (uncompressed) entries.
// Implements local file headers, central directory, and EOCD.

// Write handle layout (&i64):
//   [0] output buffer (&i8)
//   [1] current write position
//   [2] entry count
//   [3] name_offsets   (&i64 — offset of local header for each entry)
//   [4] name_lens      (&i64)
//   [5] data_lens      (&i64)
//   [6] name_buf       (&i8 — stored names)
//   [7] name_buf_pos

// Read handle layout (&i64):
//   [0] input buffer (&i8)
//   [1] input length
//   [2] entry count
//   [3] local_offsets  (&i64 — offset of each local file header)
//   [4] name_lens      (&i64)
//   [5] data_lens      (&i64)

// Functions:
//   zip_create(out)                    -> &i64  create write handle
//   zip_add(h, name, nlen, data, dlen) -> i64   add stored entry
//   zip_finish(h)                      -> i64   write central dir + EOCD, ret len
//   zip_open(buf, len)                 -> &i64  open for reading
//   zip_count(h)                       -> i64   number of entries
//   zip_entry_name(h, idx, out)        -> i64   copy name, return length
//   zip_entry_size(h, idx)             -> i64   data size
//   zip_entry_data(h, idx, out)        -> i64   copy data, return length
// =============================================================================

// Internal byte reader.
fn _zip_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

// Internal: write little-endian 16-bit.
fn _zip_w16(out: &i8, pos: i64, val: i64) -> i64 {
    let lo = val - (val / 256) * 256
    let hi = (val / 256) - (val / 65536) * 256
    poke_byte(out, pos, lo)
    poke_byte(out, pos + 1, hi)
    ret pos + 2
}

// Internal: write little-endian 32-bit.
fn _zip_w32(out: &i8, pos: i64, val: i64) -> i64 {
    let b0 = val - (val / 256) * 256
    let v1 = val / 256
    let b1 = v1 - (v1 / 256) * 256
    let v2 = val / 65536
    let b2 = v2 - (v2 / 256) * 256
    let v3 = val / 16777216
    let b3 = v3 - (v3 / 256) * 256
    poke_byte(out, pos, b0)
    poke_byte(out, pos + 1, b1)
    poke_byte(out, pos + 2, b2)
    poke_byte(out, pos + 3, b3)
    ret pos + 4
}

// Internal: read little-endian 16-bit.
fn _zip_r16(buf: &i8, pos: i64) -> i64 {
    let b0 = _zip_byte_at(buf, pos)
    let b1 = _zip_byte_at(buf, pos + 1)
    if b0 < 0 { b0 = b0 + 256 }
    if b1 < 0 { b1 = b1 + 256 }
    ret b0 + b1 * 256
}

// Internal: read little-endian 32-bit.
fn _zip_r32(buf: &i8, pos: i64) -> i64 {
    let b0 = _zip_byte_at(buf, pos)
    let b1 = _zip_byte_at(buf, pos + 1)
    let b2 = _zip_byte_at(buf, pos + 2)
    let b3 = _zip_byte_at(buf, pos + 3)
    if b0 < 0 { b0 = b0 + 256 }
    if b1 < 0 { b1 = b1 + 256 }
    if b2 < 0 { b2 = b2 + 256 }
    if b3 < 0 { b3 = b3 + 256 }
    ret b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

// Simple CRC-32 for ZIP (same algorithm as gzip).
fn _zip_crc32_byte(crc: i64, byte_val: i64) -> i64 {
    // XOR byte into CRC
    let xval = 0
    let bit = 0
    let aa = crc
    let bb = byte_val
    loop bit < 32 {
        let a_bit = aa - (aa / 2) * 2
        let b_bit = bb - (bb / 2) * 2
        let x_bit = a_bit + b_bit
        let tmp = x_bit - (x_bit / 2) * 2
        let shift = 1
        let si = 0
        loop si < bit { shift = shift * 2 si = si + 1 }
        xval = xval + tmp * shift
        aa = aa / 2
        bb = bb / 2
        bit = bit + 1
    }
    let c = xval
    let bi = 0
    loop bi < 8 {
        let low_bit = c - (c / 2) * 2
        if low_bit == 1 {
            c = c / 2
            let poly = 3988292384
            let xr = 0
            let b2 = 0
            let ac = c
            let pc = poly
            loop b2 < 32 {
                let ab = ac - (ac / 2) * 2
                let pb = pc - (pc / 2) * 2
                let xb = ab + pb
                let tmp2 = xb - (xb / 2) * 2
                let sh = 1
                let s2 = 0
                loop s2 < b2 { sh = sh * 2 s2 = s2 + 1 }
                xr = xr + tmp2 * sh
                ac = ac / 2
                pc = pc / 2
                b2 = b2 + 1
            }
            c = xr
        } else {
            c = c / 2
        }
        bi = bi + 1
    }
    ret c
}

// Compute CRC-32 for data.
fn _zip_crc32(buf: &i8, len: i64) -> i64 {
    let crc = 4294967295
    let i = 0
    loop i < len {
        let b = _zip_byte_at(buf, i)
        if b < 0 { b = b + 256 }
        crc = _zip_crc32_byte(crc, b)
        i = i + 1
    }
    // Final XOR with 0xFFFFFFFF
    let result = 0
    let bit = 0
    let ac = crc
    let fc = 4294967295
    loop bit < 32 {
        let ab = ac - (ac / 2) * 2
        let fb = fc - (fc / 2) * 2
        let xb = ab + fb
        let tmp = xb - (xb / 2) * 2
        let sh = 1
        let si = 0
        loop si < bit { sh = sh * 2 si = si + 1 }
        result = result + tmp * sh
        ac = ac / 2
        fc = fc / 2
        bit = bit + 1
    }
    ret result
}

// Create a write handle.
fn zip_create(out: &i8) -> &i64 {
    let h: &i64 = alloc_pages(1)
    h[0] = out
    h[1] = 0
    h[2] = 0
    let offs: &i64 = alloc_pages(1)
    let nlens: &i64 = alloc_pages(1)
    let dlens: &i64 = alloc_pages(1)
    let nbuf: &i8 = alloc_pages(2)
    h[3] = offs
    h[4] = nlens
    h[5] = dlens
    h[6] = nbuf
    h[7] = 0
    // Also store CRC values for central directory
    let crcs: &i64 = alloc_pages(1)
    h[8] = crcs
    ret h
}

// Add a stored file entry to the ZIP.
fn zip_add(h: &i64, name: &i8, nlen: i64, data: &i8, dlen: i64) -> i64 {
    let out: &i8 = h[0]
    let pos = h[1]
    let count = h[2]
    let offs: &i64 = h[3]
    let nlens: &i64 = h[4]
    let dlens: &i64 = h[5]
    let nbuf: &i8 = h[6]
    let nbpos = h[7]
    let crcs: &i64 = h[8]

    // Remember this entry's local header offset
    offs[count] = pos

    // Compute CRC-32
    let crc = _zip_crc32(data, dlen)
    crcs[count] = crc

    // Store name for central directory
    let ni = 0
    loop ni < nlen {
        let nc = _zip_byte_at(name, ni)
        poke_byte(nbuf, nbpos + ni, nc)
        ni = ni + 1
    }
    nlens[count] = nlen
    dlens[count] = dlen
    h[7] = nbpos + nlen

    // Local file header (30 bytes + name + data)
    // Signature: PK\x03\x04
    poke_byte(out, pos, 80)      // 'P'
    poke_byte(out, pos + 1, 75)  // 'K'
    poke_byte(out, pos + 2, 3)
    poke_byte(out, pos + 3, 4)
    pos = pos + 4

    // Version needed (20 = 2.0)
    pos = _zip_w16(out, pos, 20)
    // General purpose flags
    pos = _zip_w16(out, pos, 0)
    // Compression method (0 = stored)
    pos = _zip_w16(out, pos, 0)
    // Mod time
    pos = _zip_w16(out, pos, 0)
    // Mod date
    pos = _zip_w16(out, pos, 0)
    // CRC-32
    pos = _zip_w32(out, pos, crc)
    // Compressed size
    pos = _zip_w32(out, pos, dlen)
    // Uncompressed size
    pos = _zip_w32(out, pos, dlen)
    // Filename length
    pos = _zip_w16(out, pos, nlen)
    // Extra field length
    pos = _zip_w16(out, pos, 0)

    // Filename
    let fi = 0
    loop fi < nlen {
        let fc = _zip_byte_at(name, fi)
        poke_byte(out, pos, fc)
        pos = pos + 1
        fi = fi + 1
    }

    // File data
    let di = 0
    loop di < dlen {
        let db = _zip_byte_at(data, di)
        poke_byte(out, pos, db)
        pos = pos + 1
        di = di + 1
    }

    h[1] = pos
    h[2] = count + 1
    ret 1
}

// Write central directory and EOCD. Returns total archive length.
fn zip_finish(h: &i64) -> i64 {
    let out: &i8 = h[0]
    let pos = h[1]
    let count = h[2]
    let offs: &i64 = h[3]
    let nlens: &i64 = h[4]
    let dlens: &i64 = h[5]
    let nbuf: &i8 = h[6]
    let crcs: &i64 = h[8]

    let cd_start = pos
    let name_pos = 0

    // Write central directory entries
    let i = 0
    loop i < count {
        // Signature: PK\x01\x02
        poke_byte(out, pos, 80)
        poke_byte(out, pos + 1, 75)
        poke_byte(out, pos + 2, 1)
        poke_byte(out, pos + 3, 2)
        pos = pos + 4

        // Version made by (20)
        pos = _zip_w16(out, pos, 20)
        // Version needed (20)
        pos = _zip_w16(out, pos, 20)
        // Flags
        pos = _zip_w16(out, pos, 0)
        // Compression (stored)
        pos = _zip_w16(out, pos, 0)
        // Mod time
        pos = _zip_w16(out, pos, 0)
        // Mod date
        pos = _zip_w16(out, pos, 0)
        // CRC-32
        pos = _zip_w32(out, pos, crcs[i])
        // Compressed size
        pos = _zip_w32(out, pos, dlens[i])
        // Uncompressed size
        pos = _zip_w32(out, pos, dlens[i])
        // Filename length
        let nlen = nlens[i]
        pos = _zip_w16(out, pos, nlen)
        // Extra field length
        pos = _zip_w16(out, pos, 0)
        // File comment length
        pos = _zip_w16(out, pos, 0)
        // Disk number start
        pos = _zip_w16(out, pos, 0)
        // Internal file attributes
        pos = _zip_w16(out, pos, 0)
        // External file attributes
        pos = _zip_w32(out, pos, 0)
        // Relative offset of local header
        pos = _zip_w32(out, pos, offs[i])

        // Filename
        let ni = 0
        loop ni < nlen {
            let nc = _zip_byte_at(nbuf, name_pos + ni)
            poke_byte(out, pos, nc)
            pos = pos + 1
            ni = ni + 1
        }
        name_pos = name_pos + nlen
        i = i + 1
    }

    let cd_size = pos - cd_start

    // EOCD record
    // Signature: PK\x05\x06
    poke_byte(out, pos, 80)
    poke_byte(out, pos + 1, 75)
    poke_byte(out, pos + 2, 5)
    poke_byte(out, pos + 3, 6)
    pos = pos + 4

    // Disk number
    pos = _zip_w16(out, pos, 0)
    // Disk with central directory
    pos = _zip_w16(out, pos, 0)
    // Entries on this disk
    pos = _zip_w16(out, pos, count)
    // Total entries
    pos = _zip_w16(out, pos, count)
    // Size of central directory
    pos = _zip_w32(out, pos, cd_size)
    // Offset of central directory
    pos = _zip_w32(out, pos, cd_start)
    // Comment length
    pos = _zip_w16(out, pos, 0)

    h[1] = pos
    ret pos
}

// Internal: scan for EOCD to find central directory.
fn _zip_find_eocd(buf: &i8, len: i64) -> i64 {
    // Search backwards for PK\x05\x06
    let pos = len - 22
    loop pos >= 0 {
        let b0 = _zip_byte_at(buf, pos)
        if b0 < 0 { b0 = b0 + 256 }
        if b0 == 80 {
            let b1 = _zip_byte_at(buf, pos + 1)
            let b2 = _zip_byte_at(buf, pos + 2)
            let b3 = _zip_byte_at(buf, pos + 3)
            if b1 < 0 { b1 = b1 + 256 }
            if b2 < 0 { b2 = b2 + 256 }
            if b3 < 0 { b3 = b3 + 256 }
            if b1 == 75 and b2 == 5 and b3 == 6 { ret pos }
        }
        pos = pos - 1
    }
    ret 0 - 1
}

// Open a ZIP archive for reading.
fn zip_open(buf: &i8, len: i64) -> &i64 {
    let h: &i64 = alloc_pages(1)
    h[0] = buf
    h[1] = len

    // Find EOCD
    let eocd = _zip_find_eocd(buf, len)
    if eocd < 0 {
        h[2] = 0
        ret h
    }

    let count = _zip_r16(buf, eocd + 10)
    h[2] = count

    let local_offs: &i64 = alloc_pages(1)
    let name_lens: &i64 = alloc_pages(1)
    let data_lens: &i64 = alloc_pages(1)
    h[3] = local_offs
    h[4] = name_lens
    h[5] = data_lens

    // Read central directory
    let cd_off = _zip_r32(buf, eocd + 16)
    let pos = cd_off
    let i = 0
    loop i < count {
        // Skip signature (4) + versions (4) + flags (2) + method (2) + time (4) + crc (4)
        // = 20 bytes to compressed size
        let nlen = _zip_r16(buf, pos + 28)
        let extra_len = _zip_r16(buf, pos + 30)
        let comment_len = _zip_r16(buf, pos + 32)
        let local_off = _zip_r32(buf, pos + 42)
        let dlen = _zip_r32(buf, pos + 20)

        local_offs[i] = local_off
        name_lens[i] = nlen
        data_lens[i] = dlen

        pos = pos + 46 + nlen + extra_len + comment_len
        i = i + 1
    }

    ret h
}

// Number of entries in the ZIP.
fn zip_count(h: &i64) -> i64 {
    ret h[2]
}

// Copy entry name at index to out. Returns length.
fn zip_entry_name(h: &i64, idx: i64, out: &i8) -> i64 {
    let buf: &i8 = h[0]
    let local_offs: &i64 = h[3]
    let name_lens: &i64 = h[4]
    let loff = local_offs[idx]
    let nlen = name_lens[idx]
    // Name starts at offset 30 in local file header
    let name_off = loff + 30
    let i = 0
    loop i < nlen {
        let ch = _zip_byte_at(buf, name_off + i)
        poke_byte(out, i, ch)
        i = i + 1
    }
    ret nlen
}

// Get data size for entry at index.
fn zip_entry_size(h: &i64, idx: i64) -> i64 {
    let data_lens: &i64 = h[5]
    ret data_lens[idx]
}

// Copy entry data at index to out. Returns length.
fn zip_entry_data(h: &i64, idx: i64, out: &i8) -> i64 {
    let buf: &i8 = h[0]
    let local_offs: &i64 = h[3]
    let name_lens: &i64 = h[4]
    let data_lens: &i64 = h[5]
    let loff = local_offs[idx]
    let nlen = name_lens[idx]
    let dlen = data_lens[idx]
    // Data starts after local header (30 bytes) + name + extra field
    let extra_len = _zip_r16(buf, loff + 28)
    let data_off = loff + 30 + nlen + extra_len
    let i = 0
    loop i < dlen {
        let b = _zip_byte_at(buf, data_off + i)
        poke_byte(out, i, b)
        i = i + 1
    }
    ret dlen
}
