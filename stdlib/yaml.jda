// =============================================================================
// jda::yaml -- YAML Parser/Emitter (Subset)
// =============================================================================
// Parse and emit YAML documents (flat key:value, lists, comments).

// Supported YAML subset:
//   key: value           (string values)
//   key: 42              (integer values)
//   list:
//     - item1
//     - item2
//   # comments
//   "quoted strings"

// Memory layout per YamlDoc (&i64):
//   [0] count        (number of entries)
//   [1] keys_buf     (&i8)
//   [2] vals_buf     (&i8)
//   [3] key_offs     (&i64)
//   [4] key_lens     (&i64)
//   [5] val_offs     (&i64)
//   [6] val_lens     (&i64)
//   [7] keys_pos     (write cursor)
//   [8] vals_pos     (write cursor)

// Functions:
//   yaml_parse(src, slen)                -> &i64  parse YAML to doc
//   yaml_get(doc, key, klen, out)        -> i64   get string value
//   yaml_get_i64(doc, key, klen)         -> i64   get integer value
//   yaml_count(doc)                      -> i64   number of entries
//   yaml_key_at(doc, idx, out)           -> i64   get key at index
//   yaml_val_at(doc, idx, out)           -> i64   get value at index
//   yaml_emit(doc, out, max)             -> i64   emit YAML string
// =============================================================================

fn _yaml_copy(dst: &i8, doff: i64, src: &i8, soff: i64, n: i64) {
    let i = 0
    loop i < n {
        poke_byte(dst, doff + i, src[soff + i])
        i = i + 1
    }
}

fn _yaml_streq(a: &i8, aoff: i64, alen: i64, b: &i8, boff: i64, blen: i64) -> i64 {
    if alen != blen { ret 0 }
    let i = 0
    loop i < alen {
        if a[aoff + i] != b[boff + i] { ret 0 }
        i = i + 1
    }
    ret 1
}

// Internal: add a key-value pair to the document.
fn _yaml_add(doc: &i64, key: &i8, koff: i64, klen: i64, val: &i8, voff: i64, vlen: i64) {
    let count = doc[0]
    let keys: &i8 = doc[1]
    let vals: &i8 = doc[2]
    let k_offs: &i64 = doc[3]
    let k_lens: &i64 = doc[4]
    let v_offs: &i64 = doc[5]
    let v_lens: &i64 = doc[6]
    let kpos = doc[7]
    let vpos = doc[8]

    _yaml_copy(keys, kpos, key, koff, klen)
    k_offs[count] = kpos
    k_lens[count] = klen
    doc[7] = kpos + klen

    _yaml_copy(vals, vpos, val, voff, vlen)
    v_offs[count] = vpos
    v_lens[count] = vlen
    doc[8] = vpos + vlen

    doc[0] = count + 1
}

// Parse YAML string into document. Returns doc pointer.
fn yaml_parse(src: &i8, slen: i64) -> &i64 {
    let doc: &i64 = alloc_pages(2)
    doc[0] = 0
    doc[1] = alloc_pages(4)  // keys
    doc[2] = alloc_pages(4)  // vals
    doc[3] = alloc_pages(1)  // key_offs
    doc[4] = alloc_pages(1)  // key_lens
    doc[5] = alloc_pages(1)  // val_offs
    doc[6] = alloc_pages(1)  // val_lens
    doc[7] = 0
    doc[8] = 0

    let i = 0
    loop i < slen {
        // Skip whitespace at line start
        loop i < slen and (src[i] == 32 or src[i] == 9) {
            i = i + 1
        }
        if i >= slen { ret doc }

        let c = src[i]

        // Skip comments
        if c == 35 {  // '#'
            loop i < slen and src[i] != 10 { i = i + 1 }
            if i < slen { i = i + 1 }
        } else {
            if c == 10 {
                // Empty line
                i = i + 1
            } else {
                if c == 45 and i + 1 < slen and src[i + 1] == 32 {
                    // List item: "- value"
                    i = i + 2
                    let vstart = i
                    loop i < slen and src[i] != 10 { i = i + 1 }
                    let vlen = i - vstart
                    // Trim trailing whitespace
                    loop vlen > 0 and src[vstart + vlen - 1] == 32 {
                        vlen = vlen - 1
                    }
                    // Use index as key for list items
                    let idx_str: &i8 = alloc_pages(1)
                    let idx = doc[0]
                    let di = 0
                    if idx == 0 {
                        poke_byte(idx_str, 0, 48)
                        di = 1
                    } else {
                        let tmp_v = idx
                        loop tmp_v > 0 {
                            poke_byte(idx_str, di, 48 + (tmp_v - (tmp_v / 10) * 10))
                            tmp_v = tmp_v / 10
                            di = di + 1
                        }
                        // Reverse
                        let lo = 0
                        let hi = di - 1
                        loop lo < hi {
                            let t = idx_str[lo]
                            poke_byte(idx_str, lo, idx_str[hi])
                            poke_byte(idx_str, hi, t)
                            lo = lo + 1
                            hi = hi - 1
                        }
                    }
                    _yaml_add(doc, idx_str, 0, di, src, vstart, vlen)
                    if i < slen { i = i + 1 }
                } else {
                    // Key: value
                    let kstart = i
                    loop i < slen and src[i] != 58 and src[i] != 10 {
                        i = i + 1
                    }
                    if i < slen and src[i] == 58 {
                        let klen = i - kstart
                        // Trim key trailing whitespace
                        loop klen > 0 and src[kstart + klen - 1] == 32 {
                            klen = klen - 1
                        }
                        i = i + 1  // skip ':'
                        // Skip space after colon
                        loop i < slen and src[i] == 32 { i = i + 1 }
                        let vstart = i
                        loop i < slen and src[i] != 10 { i = i + 1 }
                        let vlen = i - vstart
                        // Trim trailing whitespace
                        loop vlen > 0 and src[vstart + vlen - 1] == 32 {
                            vlen = vlen - 1
                        }
                        // Handle quoted values
                        if vlen >= 2 {
                            if src[vstart] == 34 and src[vstart + vlen - 1] == 34 {
                                vstart = vstart + 1
                                vlen = vlen - 2
                            }
                        }
                        _yaml_add(doc, src, kstart, klen, src, vstart, vlen)
                    }
                    if i < slen { i = i + 1 }
                }
            }
        }
    }
    ret doc
}

// Get string value by key. Copies to out, returns length. 0 if not found.
fn yaml_get(doc: &i64, key: &i8, klen: i64, out: &i8) -> i64 {
    let count = doc[0]
    let keys: &i8 = doc[1]
    let vals: &i8 = doc[2]
    let k_offs: &i64 = doc[3]
    let k_lens: &i64 = doc[4]
    let v_offs: &i64 = doc[5]
    let v_lens: &i64 = doc[6]

    let i = 0
    loop i < count {
        if _yaml_streq(keys, k_offs[i], k_lens[i], key, 0, klen) == 1 {
            _yaml_copy(out, 0, vals, v_offs[i], v_lens[i])
            ret v_lens[i]
        }
        i = i + 1
    }
    ret 0
}

// Get integer value by key.
fn yaml_get_i64(doc: &i64, key: &i8, klen: i64) -> i64 {
    let buf: &i8 = alloc_pages(1)
    let vlen = yaml_get(doc, key, klen, buf)
    if vlen == 0 { ret 0 }
    // Parse integer
    let neg = 0
    let start = 0
    if buf[0] == 45 { neg = 1   start = 1 }
    let val = 0
    let i = start
    loop i < vlen {
        let c = buf[i]
        if c >= 48 and c <= 57 {
            val = val * 10 + (c - 48)
        }
        i = i + 1
    }
    if neg == 1 { val = 0 - val }
    ret val
}

// Number of entries.
fn yaml_count(doc: &i64) -> i64 {
    ret doc[0]
}

// Get key at index. Returns key length.
fn yaml_key_at(doc: &i64, idx: i64, out: &i8) -> i64 {
    if idx >= doc[0] { ret 0 }
    let keys: &i8 = doc[1]
    let k_offs: &i64 = doc[3]
    let k_lens: &i64 = doc[4]
    _yaml_copy(out, 0, keys, k_offs[idx], k_lens[idx])
    ret k_lens[idx]
}

// Get value at index. Returns value length.
fn yaml_val_at(doc: &i64, idx: i64, out: &i8) -> i64 {
    if idx >= doc[0] { ret 0 }
    let vals: &i8 = doc[2]
    let v_offs: &i64 = doc[5]
    let v_lens: &i64 = doc[6]
    _yaml_copy(out, 0, vals, v_offs[idx], v_lens[idx])
    ret v_lens[idx]
}

// Emit YAML from document. Returns output length.
fn yaml_emit(doc: &i64, out: &i8, max: i64) -> i64 {
    let count = doc[0]
    let keys: &i8 = doc[1]
    let vals: &i8 = doc[2]
    let k_offs: &i64 = doc[3]
    let k_lens: &i64 = doc[4]
    let v_offs: &i64 = doc[5]
    let v_lens: &i64 = doc[6]
    let pos = 0

    let i = 0
    loop i < count and pos < max - 10 {
        // Write key
        let kl = k_lens[i]
        _yaml_copy(out, pos, keys, k_offs[i], kl)
        pos = pos + kl
        poke_byte(out, pos, 58)   // ':'
        poke_byte(out, pos + 1, 32)  // ' '
        pos = pos + 2
        // Write value
        let vl = v_lens[i]
        _yaml_copy(out, pos, vals, v_offs[i], vl)
        pos = pos + vl
        poke_byte(out, pos, 10)  // newline
        pos = pos + 1
        i = i + 1
    }
    ret pos
}
