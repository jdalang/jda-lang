; =============================================================================
; jda::option -- Option Type (nullable values)
; =============================================================================
; Safe nullable values using tagged &i64 pairs. Avoids null pointer
; dereference by requiring explicit unwrap or default.
;
; Memory layout (&i64):
;   [0] tag    (0 = None, 1 = Some)
;   [1] value  (the inner value if Some)
;
; Functions:
;   some(val)                -> &i64   wrap a value
;   none()                   -> &i64   no value
;   opt_is_some(o)           -> i64    1 if Some
;   opt_is_none(o)           -> i64    1 if None
;   opt_unwrap(o)            -> i64    value (0 if None)
;   opt_expect(o, msg)       -> i64    value or panic with msg
;   opt_unwrap_or(o, def)    -> i64    value or default
;   opt_or(o, other)         -> &i64   o if Some, else other
;   opt_eq(a, b)             -> i64    structural equality
;   opt_print(o)                       print as Some(v) or None
;   opt_println(o)                     print + newline
; =============================================================================

;; Internal: compute c-string length.
fn _opt_cstr_len(s: &i8) -> i64 {
    let n = 0
    loop n < 256 {
        if s[n] == 0 { ret n }
        n = n + 1
    }
    ret 256
}

;; Internal: write to stderr.
fn _opt_write_err(s: &i8, len: i64) {
    syscall(1, 2, s, len)
}

;; Internal: exit with code 1.
fn _opt_exit() {
    syscall(60, 1, 0, 0)
}

;; Internal: panic with message (write to stderr + exit).
fn _opt_panic(msg: &i8) {
    let n = _opt_cstr_len(msg)
    _opt_write_err(msg, n)
    _opt_write_err("\n", 1)
    _opt_exit()
}

;; Create a Some value.
fn some(val: i64) -> &i64 {
    let o: &i64 = alloc_pages(1)
    o[0] = 1
    o[1] = val
    ret o
}

;; Create a None value.
fn none() -> &i64 {
    let o: &i64 = alloc_pages(1)
    o[0] = 0
    o[1] = 0
    ret o
}

;; Check if option is Some.
fn opt_is_some(o: &i64) -> i64 {
    if o[0] == 1 { ret 1 }
    ret 0
}

;; Check if option is None.
fn opt_is_none(o: &i64) -> i64 {
    if o[0] == 0 { ret 1 }
    ret 0
}

;; Get the value. Panics if None.
fn opt_unwrap(o: &i64) -> i64 {
    if o[0] == 0 { _opt_panic("unwrap called on None") }
    ret o[1]
}

;; Get the value, or panic with a custom message if None.
fn opt_expect(o: &i64, msg: &i8) -> i64 {
    if o[0] == 0 { _opt_panic(msg) }
    ret o[1]
}

;; Get the value, or return default if None.
fn opt_unwrap_or(o: &i64, def: i64) -> i64 {
    if o[0] == 1 { ret o[1] }
    ret def
}

;; Return o if Some, otherwise return other.
fn opt_or(o: &i64, other: &i64) -> &i64 {
    if o[0] == 1 { ret o }
    ret other
}

;; Structural equality: both None, or both Some with same value.
fn opt_eq(a: &i64, b: &i64) -> i64 {
    if a[0] != b[0] { ret 0 }
    if a[0] == 0 { ret 1 }
    if a[1] == b[1] { ret 1 }
    ret 0
}

;; Print as Some(v) or None.
fn opt_print(o: &i64) {
    if o[0] == 1 {
        let v = o[1]
        print("Some({v})")
    } else {
        print("None")
    }
}

;; Print + newline.
fn opt_println(o: &i64) {
    opt_print(o)
    print("\n")
}
