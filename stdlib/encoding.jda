; =============================================================================
; jda::encoding -- Character Encoding Utilities
; =============================================================================
; UTF-8 validation, character counting, ASCII operations, Latin-1 conversion.
;
; Functions:
;   enc_utf8_valid(buf, len)              -> i64  1 if valid UTF-8
;   enc_utf8_char_count(buf, len)         -> i64  number of codepoints
;   enc_utf8_byte_len(buf, len, nchars)   -> i64  bytes for first N chars
;   enc_is_ascii(buf, len)                -> i64  1 if all ASCII
;   enc_to_upper(buf, len, out)           -> i64  ASCII uppercase
;   enc_to_lower(buf, len, out)           -> i64  ASCII lowercase
;   enc_latin1_to_utf8(src, slen, out)    -> i64  convert Latin-1 to UTF-8
;   enc_utf8_codepoint_at(buf, off)       -> i64  read codepoint at byte offset
;   enc_utf8_next(buf, off, len)          -> i64  next byte offset after codepoint
; =============================================================================

;; Validate UTF-8 byte sequence. Returns 1 if valid, 0 if invalid.
fn enc_utf8_valid(buf: &i8, len: i64) -> i64 {
    let i = 0
    loop i < len {
        let b = buf[i]
        if b < 0 { b = b + 256 }

        if b < 128 {
            ; ASCII: 0xxxxxxx
            i = i + 1
        } else {
            if b < 192 {
                ; Invalid: continuation byte at start
                ret 0
            }
            if b < 224 {
                ; 2-byte: 110xxxxx 10xxxxxx
                if i + 1 >= len { ret 0 }
                let c1 = buf[i + 1]
                if c1 < 0 { c1 = c1 + 256 }
                if c1 < 128 or c1 >= 192 { ret 0 }
                i = i + 2
            } else {
                if b < 240 {
                    ; 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
                    if i + 2 >= len { ret 0 }
                    let c1 = buf[i + 1]
                    let c2 = buf[i + 2]
                    if c1 < 0 { c1 = c1 + 256 }
                    if c2 < 0 { c2 = c2 + 256 }
                    if c1 < 128 or c1 >= 192 { ret 0 }
                    if c2 < 128 or c2 >= 192 { ret 0 }
                    i = i + 3
                } else {
                    if b < 248 {
                        ; 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
                        if i + 3 >= len { ret 0 }
                        let c1 = buf[i + 1]
                        let c2 = buf[i + 2]
                        let c3 = buf[i + 3]
                        if c1 < 0 { c1 = c1 + 256 }
                        if c2 < 0 { c2 = c2 + 256 }
                        if c3 < 0 { c3 = c3 + 256 }
                        if c1 < 128 or c1 >= 192 { ret 0 }
                        if c2 < 128 or c2 >= 192 { ret 0 }
                        if c3 < 128 or c3 >= 192 { ret 0 }
                        i = i + 4
                    } else {
                        ret 0
                    }
                }
            }
        }
    }
    ret 1
}

;; Count UTF-8 codepoints in buffer.
fn enc_utf8_char_count(buf: &i8, len: i64) -> i64 {
    let count = 0
    let i = 0
    loop i < len {
        let b = buf[i]
        if b < 0 { b = b + 256 }
        ; Count non-continuation bytes (not 10xxxxxx)
        if b < 128 or b >= 192 {
            count = count + 1
        }
        i = i + 1
    }
    ret count
}

;; Byte length of first nchars codepoints.
fn enc_utf8_byte_len(buf: &i8, len: i64, nchars: i64) -> i64 {
    let chars = 0
    let i = 0
    loop i < len and chars < nchars {
        let b = buf[i]
        if b < 0 { b = b + 256 }
        if b < 128 {
            i = i + 1
        } else {
            if b < 224 { i = i + 2 }
            else {
                if b < 240 { i = i + 3 }
                else { i = i + 4 }
            }
        }
        chars = chars + 1
    }
    ret i
}

;; Check if all bytes are ASCII (< 128).
fn enc_is_ascii(buf: &i8, len: i64) -> i64 {
    let i = 0
    loop i < len {
        let b = buf[i]
        if b < 0 { ret 0 }  ; negative means >= 128 in signed byte
        if b >= 128 { ret 0 }
        i = i + 1
    }
    ret 1
}

;; Convert ASCII lowercase to uppercase. Returns length.
fn enc_to_upper(buf: &i8, len: i64, out: &i8) -> i64 {
    let i = 0
    loop i < len {
        let c = buf[i]
        if c >= 97 and c <= 122 { c = c - 32 }
        poke_byte(out, i, c)
        i = i + 1
    }
    ret len
}

;; Convert ASCII uppercase to lowercase. Returns length.
fn enc_to_lower(buf: &i8, len: i64, out: &i8) -> i64 {
    let i = 0
    loop i < len {
        let c = buf[i]
        if c >= 65 and c <= 90 { c = c + 32 }
        poke_byte(out, i, c)
        i = i + 1
    }
    ret len
}

;; Convert Latin-1 (ISO 8859-1) to UTF-8. Returns output length.
fn enc_latin1_to_utf8(src: &i8, slen: i64, out: &i8) -> i64 {
    let oi = 0
    let i = 0
    loop i < slen {
        let b = src[i]
        if b < 0 { b = b + 256 }
        if b < 128 {
            poke_byte(out, oi, b)
            oi = oi + 1
        } else {
            ; 2-byte UTF-8: 110xxxxx 10xxxxxx
            poke_byte(out, oi, 192 + b / 64)
            poke_byte(out, oi + 1, 128 + (b - (b / 64) * 64))
            oi = oi + 2
        }
        i = i + 1
    }
    ret oi
}

;; Read UTF-8 codepoint at byte offset. Returns codepoint value.
fn enc_utf8_codepoint_at(buf: &i8, off: i64) -> i64 {
    let b = buf[off]
    if b < 0 { b = b + 256 }
    if b < 128 { ret b }
    if b < 224 {
        let c1 = buf[off + 1]
        if c1 < 0 { c1 = c1 + 256 }
        ret (b - 192) * 64 + (c1 - 128)
    }
    if b < 240 {
        let c1 = buf[off + 1]
        let c2 = buf[off + 2]
        if c1 < 0 { c1 = c1 + 256 }
        if c2 < 0 { c2 = c2 + 256 }
        ret (b - 224) * 4096 + (c1 - 128) * 64 + (c2 - 128)
    }
    let c1 = buf[off + 1]
    let c2 = buf[off + 2]
    let c3 = buf[off + 3]
    if c1 < 0 { c1 = c1 + 256 }
    if c2 < 0 { c2 = c2 + 256 }
    if c3 < 0 { c3 = c3 + 256 }
    ret (b - 240) * 262144 + (c1 - 128) * 4096 + (c2 - 128) * 64 + (c3 - 128)
}

;; Get next byte offset after codepoint at given offset.
fn enc_utf8_next(buf: &i8, off: i64, len: i64) -> i64 {
    if off >= len { ret off }
    let b = buf[off]
    if b < 0 { b = b + 256 }
    if b < 128 { ret off + 1 }
    if b < 224 { ret off + 2 }
    if b < 240 { ret off + 3 }
    ret off + 4
}
