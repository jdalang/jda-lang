; =============================================================================
; jda::fileutils -- High-Level File Utilities
; =============================================================================
; Recursive copy, remove, mkdir -p, chmod, touch.
; Depends on: stdlib/fs.jda
;
; Functions:
;   fu_mkdir_p(path)                -> i64  recursive mkdir (0=ok, -1=err)
;   fu_rm_rf(path)                  -> i64  recursive delete
;   fu_cp(src, dst)                 -> i64  copy single file
;   fu_mv(src, dst)                 -> i64  rename/move
;   fu_touch(path)                  -> i64  create empty file
;   fu_chmod(path, mode)            -> i64  change permissions
;   fu_rmdir(path)                  -> i64  remove empty directory
;   fu_file_eq(a, b)               -> i64  compare file contents
; =============================================================================

;; Internal: single-syscall wrappers

fn _fu_rename(old: &i8, new_path: &i8) -> i64 {
    ret syscall(82, old, new_path, 0)
}

fn _fu_chmod_raw(path: &i8, mode: i64) -> i64 {
    ret syscall(90, path, mode, 0)
}

fn _fu_rmdir_raw(path: &i8) -> i64 {
    ret syscall(84, path, 0, 0)
}

fn _fu_open_creat(path: &i8) -> i64 {
    ; O_WRONLY | O_CREAT | O_TRUNC = 577, mode 0644 = 420
    ret syscall(2, path, 577, 420)
}

fn _fu_close(fd: i64) -> i64 {
    ret syscall(3, fd, 0, 0)
}

fn _fu_mkdir(path: &i8) -> i64 {
    ret syscall(83, path, 493, 0)
}

fn _fu_access(path: &i8) -> i64 {
    ret syscall(21, path, 0, 0)
}

fn _fu_unlink(path: &i8) -> i64 {
    ret syscall(87, path, 0, 0)
}

fn _fu_open_read(path: &i8) -> i64 {
    ret syscall(2, path, 0, 0)
}

fn _fu_read(fd: i64, buf: &i8, max: i64) -> i64 {
    ret syscall(0, fd, buf, max)
}

fn _fu_open_write(path: &i8) -> i64 {
    ret syscall(2, path, 577, 420)
}

fn _fu_write(fd: i64, data: &i8, len: i64) -> i64 {
    ret syscall(1, fd, data, len)
}

fn _fu_getdents(fd: i64, buf: &i8, size: i64) -> i64 {
    ret syscall(217, fd, buf, size)
}

fn _fu_strlen(s: &i8) -> i64 {
    let i = 0
    loop s[i] != 0 { i = i + 1 }
    ret i
}

fn _fu_copy_bytes(dst: &i8, doff: i64, src: &i8, soff: i64, n: i64) {
    let i = 0
    loop i < n {
        poke_byte(dst, doff + i, src[soff + i])
        i = i + 1
    }
}

;; Recursive mkdir -p. Creates all intermediate directories.
;; Path must be null-terminated. Returns 0 on success.
fn fu_mkdir_p(path: &i8) -> i64 {
    let len = _fu_strlen(path)
    let tmp: &i8 = alloc_pages(1)
    _fu_copy_bytes(tmp, 0, path, 0, len)
    poke_byte(tmp, len, 0)

    let i = 1
    loop i < len {
        if tmp[i] == 47 {
            poke_byte(tmp, i, 0)
            let r = _fu_mkdir(tmp)
            ; Ignore EEXIST (-17)
            poke_byte(tmp, i, 47)
        }
        i = i + 1
    }
    let r2 = _fu_mkdir(tmp)
    ret 0
}

;; Remove empty directory.
fn fu_rmdir(path: &i8) -> i64 {
    ret _fu_rmdir_raw(path)
}

;; Recursive rm -rf. Removes files and directories.
fn fu_rm_rf(path: &i8) -> i64 {
    let buf: &i8 = alloc_pages(2)
    let fd = _fu_open_read(path)
    if fd < 0 {
        ; Not a directory, try unlink as file
        ret _fu_unlink(path)
    }
    let n = _fu_getdents(fd, buf, 8192)
    _fu_close(fd)

    if n <= 0 {
        ; Empty directory or error — try rmdir
        ret _fu_rmdir_raw(path)
    }

    ; Parse getdents64 entries
    let plen = _fu_strlen(path)
    let child: &i8 = alloc_pages(1)
    let off = 0
    loop off < n {
        ; d_reclen at offset 16 (2 bytes)
        let reclen_lo = buf[off + 16]
        let reclen_hi = buf[off + 17]
        let reclen = reclen_lo + reclen_hi * 256
        ; d_type at offset 18
        let d_type = buf[off + 18]
        ; d_name at offset 19
        let name_off = off + 19
        let nlen = _fu_strlen(buf + name_off)

        ; Skip . and ..
        let skip = 0
        if nlen == 1 {
            if buf[name_off] == 46 { skip = 1 }
        }
        if nlen == 2 {
            if buf[name_off] == 46 {
                if buf[name_off + 1] == 46 { skip = 1 }
            }
        }

        if skip == 0 {
            ; Build child path: path/name
            _fu_copy_bytes(child, 0, path, 0, plen)
            poke_byte(child, plen, 47)
            _fu_copy_bytes(child, plen + 1, buf, name_off, nlen)
            poke_byte(child, plen + 1 + nlen, 0)

            if d_type == 4 {
                fu_rm_rf(child)
            } else {
                _fu_unlink(child)
            }
        }
        off = off + reclen
    }
    ret _fu_rmdir_raw(path)
}

;; Copy a single file. Returns bytes copied or -1 on error.
fn fu_cp(src: &i8, dst: &i8) -> i64 {
    let fd_in = _fu_open_read(src)
    if fd_in < 0 { ret -1 }
    let fd_out = _fu_open_write(dst)
    if fd_out < 0 {
        _fu_close(fd_in)
        ret -1
    }
    let buf: &i8 = alloc_pages(1)
    let total = 0
    let done = 0
    loop done == 0 {
        let n = _fu_read(fd_in, buf, 4096)
        if n <= 0 {
            done = 1
        }
        if done == 0 {
            _fu_write(fd_out, buf, n)
            total = total + n
        }
    }
    _fu_close(fd_in)
    _fu_close(fd_out)
    ret total
}

;; Move/rename file or directory.
fn fu_mv(src: &i8, dst: &i8) -> i64 {
    ret _fu_rename(src, dst)
}

;; Create empty file (or truncate existing).
fn fu_touch(path: &i8) -> i64 {
    let fd = _fu_open_creat(path)
    if fd < 0 { ret -1 }
    _fu_close(fd)
    ret 0
}

;; Change file permissions.
fn fu_chmod(path: &i8, mode: i64) -> i64 {
    ret _fu_chmod_raw(path, mode)
}

;; Compare two files for content equality. Returns 1 if equal, 0 if not.
fn fu_file_eq(a: &i8, b: &i8) -> i64 {
    let fd1 = _fu_open_read(a)
    if fd1 < 0 { ret 0 }
    let fd2 = _fu_open_read(b)
    if fd2 < 0 {
        _fu_close(fd1)
        ret 0
    }
    let buf1: &i8 = alloc_pages(1)
    let buf2: &i8 = alloc_pages(1)
    let equal = 1
    let done = 0
    loop done == 0 {
        let n1 = _fu_read(fd1, buf1, 4096)
        let n2 = _fu_read(fd2, buf2, 4096)
        if n1 != n2 { equal = 0   done = 1 }
        if n1 <= 0 { done = 1 }
        if done == 0 {
            let i = 0
            loop i < n1 {
                if buf1[i] != buf2[i] {
                    equal = 0
                    done = 1
                }
                if done == 0 { i = i + 1 }
            }
        }
    }
    _fu_close(fd1)
    _fu_close(fd2)
    ret equal
}
