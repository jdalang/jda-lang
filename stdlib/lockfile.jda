; =============================================================================
; jda::lockfile -- Lock File for Dependency Pinning
; =============================================================================
; Simple key=value lock file for recording exact installed versions.
; Format: one entry per line, "name = version\n"
;
; Memory layout (&i64 registry):
;   [i*3 + 0] = name pointer (&i8)
;   [i*3 + 1] = version pointer (&i8)
;   [i*3 + 2] = hash (integrity, 0 if not set)
;
; Functions:
;   lock_init()                          initialize lock state
;   lock_add(name, version)              add/update an entry
;   lock_remove(name)                    remove an entry
;   lock_get(name)           -> &i8      get pinned version ("" if not found)
;   lock_has(name)           -> i64      1 if name is locked
;   lock_count()             -> i64      number of entries
;   lock_print()                         print all entries
;   lock_set_hash(name, h)               set integrity hash
;   lock_get_hash(name)     -> i64       get integrity hash (0 if not set)
; =============================================================================

const _LOCK_MAX = 128

let _lock_entries: &i64 = 0
let _lock_count: i64 = 0
let _lock_inited: i64 = 0

;; Internal: c-string length.
fn _lock_cstr_len(s: &i8) -> i64 {
    let n = 0
    loop n < 128 {
        if s[n] == 0 { ret n }
        n = n + 1
    }
    ret 128
}

;; Internal: c-string equality.
fn _lock_cstr_eq(a: &i8, b: &i8) -> i64 {
    let i = 0
    loop i < 128 {
        let ca = a[i]
        let cb = b[i]
        if ca != cb { ret 0 }
        if ca == 0 { ret 1 }
        i = i + 1
    }
    ret 1
}

;; Internal: write to stdout.
fn _lock_write(s: &i8, len: i64) {
    syscall(1, 1, s, len)
}

;; Internal: print c-string to stdout.
fn _lock_print_str(s: &i8) {
    let n = _lock_cstr_len(s)
    _lock_write(s, n)
}

;; Internal: find entry by name, -1 if not found.
fn _lock_find(name: &i8) -> i64 {
    let i = 0
    loop i < _lock_count {
        let base = i * 3
        let stored: &i8 = _lock_entries[base]
        if _lock_cstr_eq(stored, name) == 1 { ret i }
        i = i + 1
    }
    ret 0 - 1
}

;; Initialize the lock file state.
fn lock_init() {
    if _lock_inited == 1 { ret }
    _lock_entries = alloc_pages(1)
    _lock_count = 0
    _lock_inited = 1
}

;; Add or update an entry.
fn lock_add(name: &i8, version: &i8) {
    let idx = _lock_find(name)
    if idx >= 0 {
        ; Update existing
        let base = idx * 3
        let b1 = base + 1
        _lock_entries[b1] = version
        ret
    }
    if _lock_count >= 128 { ret }
    let base = _lock_count * 3
    _lock_entries[base] = name
    let b1 = base + 1
    _lock_entries[b1] = version
    let b2 = base + 2
    _lock_entries[b2] = 0
    _lock_count = _lock_count + 1
}

;; Remove an entry.
fn lock_remove(name: &i8) {
    let idx = _lock_find(name)
    if idx < 0 { ret }
    let last = _lock_count - 1
    if idx != last {
        let dst = idx * 3
        let src = last * 3
        _lock_entries[dst] = _lock_entries[src]
        let d1 = dst + 1
        let s1 = src + 1
        _lock_entries[d1] = _lock_entries[s1]
        let d2 = dst + 2
        let s2 = src + 2
        _lock_entries[d2] = _lock_entries[s2]
    }
    _lock_count = _lock_count - 1
}

;; Get pinned version string ("" if not found).
fn lock_get(name: &i8) -> &i8 {
    let idx = _lock_find(name)
    if idx < 0 { ret "" }
    let base = idx * 3
    let b1 = base + 1
    ret _lock_entries[b1]
}

;; Check if name is in the lock file.
fn lock_has(name: &i8) -> i64 {
    let idx = _lock_find(name)
    if idx >= 0 { ret 1 }
    ret 0
}

;; Get number of locked entries.
fn lock_count() -> i64 {
    ret _lock_count
}

;; Set integrity hash for an entry.
fn lock_set_hash(name: &i8, h: i64) {
    let idx = _lock_find(name)
    if idx < 0 { ret }
    let base = idx * 3
    let b2 = base + 2
    _lock_entries[b2] = h
}

;; Get integrity hash (0 if not set or not found).
fn lock_get_hash(name: &i8) -> i64 {
    let idx = _lock_find(name)
    if idx < 0 { ret 0 }
    let base = idx * 3
    let b2 = base + 2
    ret _lock_entries[b2]
}

;; Print all lock entries.
fn lock_print() {
    let c = _lock_count
    print("Lock (")
    print("{c}")
    print(" entries):\n")
    let i = 0
    loop i < _lock_count {
        let base = i * 3
        let name: &i8 = _lock_entries[base]
        let b1 = base + 1
        let ver: &i8 = _lock_entries[b1]
        _lock_write("  ", 2)
        _lock_print_str(name)
        _lock_write(" = ", 3)
        _lock_print_str(ver)
        _lock_write("\n", 1)
        i = i + 1
    }
}
