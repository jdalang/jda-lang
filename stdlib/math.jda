// =============================================================================
// jda::math -- Integer Math, Random Numbers, and Constants
// =============================================================================
// Pure integer math functions. No floating point, no libc.

// Functions:
//   math_abs(x) -> |x|
//   math_min(a, b) -> min(a, b)
//   math_max(a, b) -> max(a, b)
//   math_clamp(x, lo, hi) -> clamped value
//   math_gcd(a, b) -> greatest common divisor
//   math_lcm(a, b) -> least common multiple
//   math_pow(base, exp) -> base^exp (integer)
//   math_isqrt(n) -> integer square root
//   math_log2(n) -> floor(log2(n))
//   math_factorial(n) -> n!
//   math_fib(n) -> nth Fibonacci number
//   math_is_prime(n) -> 1 if prime, 0 otherwise
//   math_next_pow2(n) -> smallest power of 2 >= n
//   math_divmod(a, b, quot_ptr, rem_ptr) -> 0
//   math_rand_seed(seed) -> 0
//   math_rand() -> pseudo-random i64
//   math_rand_range(lo, hi) -> random in [lo, hi)
// =============================================================================

// Absolute value.
fn math_abs(x: i64) -> i64 {
    if x < 0 { ret 0 - x }
    ret x
}

// Minimum of two values.
fn math_min(a: i64, b: i64) -> i64 {
    if a < b { ret a }
    ret b
}

// Maximum of two values.
fn math_max(a: i64, b: i64) -> i64 {
    if a > b { ret a }
    ret b
}

// Clamp x to [lo, hi].
fn math_clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { ret lo }
    if x > hi { ret hi }
    ret x
}

// Greatest common divisor (Euclidean algorithm).
fn math_gcd(a: i64, b: i64) -> i64 {
    let x = a
    let y = b
    if x < 0 { x = 0 - x }
    if y < 0 { y = 0 - y }
    loop y != 0 {
        let q = x / y
        let r = x - q * y
        x = y
        y = r
    }
    ret x
}

// Least common multiple.
fn math_lcm(a: i64, b: i64) -> i64 {
    if a == 0 { ret 0 }
    if b == 0 { ret 0 }
    let g = math_gcd(a, b)
    let aa = a
    if aa < 0 { aa = 0 - aa }
    let bb = b
    if bb < 0 { bb = 0 - bb }
    ret (aa / g) * bb
}

// Integer exponentiation.
fn math_pow(base: i64, exp: i64) -> i64 {
    if exp == 0 { ret 1 }
    let result = 1
    let b = base
    let e = exp
    loop e > 0 {
        if e - (e / 2) * 2 == 1 {
            result = result * b
        }
        b = b * b
        e = e / 2
    }
    ret result
}

// Integer square root (floor).
fn math_isqrt(n: i64) -> i64 {
    if n < 0 { ret -1 }
    if n == 0 { ret 0 }
    let x = n
    let half = (x + 1) / 2
    let y = half
    loop y < x {
        x = y
        let div = n / x
        let sum = x + div
        y = sum / 2
    }
    ret x
}

// Floor of log base 2.
fn math_log2(n: i64) -> i64 {
    if n < 1 { ret -1 }
    let r = 0
    let v = n
    loop v > 1 {
        v = v / 2
        r = r + 1
    }
    ret r
}

// Factorial (iterative).
fn math_factorial(n: i64) -> i64 {
    if n < 0 { ret -1 }
    let result = 1
    let i = 2
    loop i <= n {
        result = result * i
        i = i + 1
    }
    ret result
}

// Fibonacci number (iterative).
fn math_fib(n: i64) -> i64 {
    if n <= 0 { ret 0 }
    if n == 1 { ret 1 }
    let a = 0
    let b = 1
    let i = 2
    loop i <= n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    ret b
}

// Primality test (trial division).
fn math_is_prime(n: i64) -> i64 {
    if n < 2 { ret 0 }
    if n < 4 { ret 1 }
    if n - (n / 2) * 2 == 0 { ret 0 }
    if n - (n / 3) * 3 == 0 { ret 0 }
    let i = 5
    loop i * i <= n {
        if n - (n / i) * i == 0 { ret 0 }
        if n - (n / (i + 2)) * (i + 2) == 0 { ret 0 }
        i = i + 6
    }
    ret 1
}

// Smallest power of 2 >= n.
fn math_next_pow2(n: i64) -> i64 {
    if n < 1 { ret 1 }
    let v = n - 1
    v = v + v / 1  // no bitwise OR, use repeated halving approach
    let p = 1
    loop p < n {
        p = p * 2
    }
    ret p
}

// Quotient and remainder.
fn math_divmod(a: i64, b: i64, quot_ptr: &i64, rem_ptr: &i64) -> i64 {
    quot_ptr[0] = a / b
    rem_ptr[0] = a - (a / b) * b
    ret 0
}

// ─── Random Number Generator (xorshift64) ──────────────────────────────────

// Seed the random number generator.
// Uses a global variable via a page of memory.
fn math_rand_seed(seed: i64) -> i64 {
    let page = alloc_pages(1)
    let p: &i64 = page
    let s = seed
    if s == 0 { s = 2463534242 }
    p[0] = s
    p[1] = 1  // initialized flag
    ret 0
}

// Generate pseudo-random i64.
// xorshift64 algorithm.
fn math_rand() -> i64 {
    let page = alloc_pages(1)
    let p: &i64 = page
    if p[1] == 0 {
        // Auto-seed from clock
        let ts = alloc_pages(1)
        syscall(228, 0, ts, 0)  // clock_gettime(CLOCK_REALTIME)
        let tsp: &i64 = ts
        p[0] = tsp[1]  // nanoseconds as seed
        if p[0] == 0 { p[0] = 2463534242 }
        p[1] = 1
    }
    let x = p[0]
    // xorshift64 steps (emulated without XOR using arithmetic)
    // Since Jda doesn't have ^ operator, use a linear congruential generator instead
    // LCG: x = (a * x + c) mod m
    // Using Knuth's constants: a=6364136223846793005, c=1442695040888963407
    x = x * 6364136223846793005 + 1442695040888963407
    p[0] = x
    // Make positive
    if x < 0 { x = 0 - x }
    ret x
}

// Random number in range [lo, hi).
fn math_rand_range(lo: i64, hi: i64) -> i64 {
    let range = hi - lo
    if range < 1 { ret lo }
    let r = math_rand()
    // r mod range + lo
    let m = r - (r / range) * range
    ret m + lo
}
