; =============================================================================
; jda::benchmark -- In-Language Micro-Benchmarking
; =============================================================================
; Run and time code blocks from within Jda programs. Complements the external
; jda-bench.sh tool with in-language timing.
;
; Functions:
;   bench_start()                  -> i64   start timer (returns ns timestamp)
;   bench_stop(start)              -> i64   stop timer, return elapsed nanoseconds
;   bench_ms(start)                -> i64   stop timer, return elapsed milliseconds
;   bench_us(start)                -> i64   stop timer, return elapsed microseconds
;   bench_report(name, nlen, start)         print "name: Nns (N.NNNms)"
;   bench_iter(fn_ptr, n)          -> i64   call fn_ptr() n times, return total ns
;   bench_iter_report(name, nlen, fn_ptr, n)  run + print ns/op
; =============================================================================

;; Get current timestamp in nanoseconds.
fn bench_now_ns() -> i64 {
    let ts: &i64 = alloc_pages(1)
    syscall(228, 1, ts, 0)  ; clock_gettime(CLOCK_MONOTONIC)
    ret ts[0] * 1000000000 + ts[1]
}

;; Start a benchmark timer.
fn bench_start() -> i64 {
    ret bench_now_ns()
}

;; Stop timer, return elapsed nanoseconds.
fn bench_stop(start: i64) -> i64 {
    ret bench_now_ns() - start
}

;; Stop timer, return elapsed milliseconds.
fn bench_ms(start: i64) -> i64 {
    let ns = bench_now_ns() - start
    ret ns / 1000000
}

;; Stop timer, return elapsed microseconds.
fn bench_us(start: i64) -> i64 {
    let ns = bench_now_ns() - start
    ret ns / 1000
}

;; Internal: print integer.
fn bench_print_int(val: i64) {
    let buf: &i8 = alloc_pages(1)
    let v = val
    if v == 0 { print("0") ret }
    if v < 0 { print("-") v = 0 - v }
    let pos = 0
    let tmp = v
    loop tmp > 0 {
        let d = tmp - (tmp / 10) * 10
        poke_byte(buf, pos, d + 48)
        pos = pos + 1
        tmp = tmp / 10
    }
    let lo = 0
    let hi = pos - 1
    loop lo < hi {
        let a = load_i8_at(buf, lo)
        let b = load_i8_at(buf, hi)
        poke_byte(buf, lo, b)
        poke_byte(buf, hi, a)
        lo = lo + 1
        hi = hi - 1
    }
    syscall(1, 1, buf, pos)
}

;; Print benchmark result: "name: 12345ns (12.345ms)"
fn bench_report(name: &i8, nlen: i64, start: i64) {
    let ns = bench_now_ns() - start
    syscall(1, 1, name, nlen)
    print(": ")
    bench_print_int(ns)
    print("ns (")
    let ms = ns / 1000000
    let us_rem = (ns / 1000) - ms * 1000
    bench_print_int(ms)
    print(".")
    if us_rem < 100 { print("0") }
    if us_rem < 10 { print("0") }
    bench_print_int(us_rem)
    print("ms)\n")
}

;; Run fn_ptr() n times. Returns total nanoseconds.
fn bench_iter(fn_ptr: i64, n: i64) -> i64 {
    let start = bench_now_ns()
    let i = 0
    loop i < n {
        call_closure(fn_ptr, 0)
        i = i + 1
    }
    ret bench_now_ns() - start
}

;; Run fn_ptr() n times and print results.
fn bench_iter_report(name: &i8, nlen: i64, fn_ptr: i64, n: i64) {
    let total_ns = bench_iter(fn_ptr, n)
    let ns_per_op = total_ns / n
    syscall(1, 1, name, nlen)
    print("\t")
    bench_print_int(n)
    print("\t")
    bench_print_int(ns_per_op)
    print(" ns/op\n")
}
