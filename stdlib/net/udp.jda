; =============================================================================
; jda::net::udp — UDP Socket API
; =============================================================================
; Connectionless datagram sockets via direct Linux syscalls.
; No libc. No <sys/socket.h>. J-Thread yield on EAGAIN.
;
; Linux syscalls used:
;   SYS_SOCKET    = 41   socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)
;   SYS_BIND      = 49   bind(fd, addr, addrlen)
;   SYS_SENDTO    = 44   sendto(fd, buf, len, flags, dst_addr, addrlen)
;   SYS_RECVFROM  = 45   recvfrom(fd, buf, len, flags, src_addr, &addrlen)
;   SYS_SETSOCKOPT= 54   setsockopt(fd, level, opt, val, len)
;   SYS_CLOSE     = 3    close(fd)
;
; Usage:
;   let sock = UdpSocket::bind("0.0.0.0", 9000)?
;   sock.send_to("Hello", "192.168.1.10", 9001)
;   let (n, from) = sock.recv_from(buf, 1500)?
; =============================================================================

import jda::net::tcp::{ SockAddrIn, htons, htonl, ntohs, ntohl, ip_to_u32 }

const SYS_SOCKET     = 41
const SYS_BIND       = 49
const SYS_SENDTO     = 44
const SYS_RECVFROM   = 45
const SYS_SETSOCKOPT = 54
const SYS_CLOSE      = 3

const AF_INET        = 2
const SOCK_DGRAM     = 2
const SOCK_NONBLOCK  = 2048
const IPPROTO_UDP    = 17
const SOL_SOCKET     = 1
const SO_REUSEADDR   = 2
const SO_REUSEPORT   = 15
const SO_BROADCAST   = 6
const IPPROTO_IP     = 0
const IP_ADD_MEMBERSHIP  = 35    ; join multicast group
const IP_DROP_MEMBERSHIP = 36    ; leave multicast group
const IP_MULTICAST_TTL   = 33
const IP_MULTICAST_LOOP  = 34
const EAGAIN         = 11

; Source address info returned with each recv_from
struct UdpPeer {
    addr: u32    ; IPv4 address (host byte order)
    port: u16
}

; =============================================================================
; UdpSocket
; =============================================================================
struct UdpSocket {
    fd:         i32
    local_port: u16
}

impl UdpSocket {
    ; -------------------------------------------------------------------------
    ; bind(addr, port) — create and bind a UDP socket
    ; -------------------------------------------------------------------------
    fn bind(addr: ref []i8, port: u16) -> Result<own UdpSocket, []i8> {
        let fd = syscall(SYS_SOCKET, AF_INET,
                         SOCK_DGRAM | SOCK_NONBLOCK, IPPROTO_UDP) as i32
        if fd < 0 { ret err("udp socket() failed") }

        let one: i32 = 1
        syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_REUSEADDR, &one, 4)
        syscall(SYS_SETSOCKOPT, fd, SOL_SOCKET, SO_REUSEPORT, &one, 4)

        let sa = SockAddrIn {
            sin_family: AF_INET as u16,
            sin_port:   htons(port),
            sin_addr:   htonl(ip_to_u32(addr)),
            sin_zero:   [0u8; 8],
        }
        let rc = syscall(SYS_BIND, fd, &sa, 16) as i32
        if rc < 0 {
            syscall(SYS_CLOSE, fd, 0, 0)
            ret err("udp bind() failed")
        }
        ret ok(UdpSocket { fd: fd, local_port: port })
    }

    ; Unbound socket — for send-only use (OS assigns ephemeral port)
    fn open() -> Result<own UdpSocket, []i8> {
        let fd = syscall(SYS_SOCKET, AF_INET,
                         SOCK_DGRAM | SOCK_NONBLOCK, IPPROTO_UDP) as i32
        if fd < 0 { ret err("udp socket() failed") }
        ret ok(UdpSocket { fd: fd, local_port: 0 })
    }

    ; -------------------------------------------------------------------------
    ; send_to(buf, dst_addr, dst_port) -> i64   bytes sent
    ; -------------------------------------------------------------------------
    fn send_to(self, buf: ref []i8, dst: ref []i8, port: u16) -> Result<i64, []i8> {
        let sa = SockAddrIn {
            sin_family: AF_INET as u16,
            sin_port:   htons(port),
            sin_addr:   htonl(ip_to_u32(dst)),
            sin_zero:   [0u8; 8],
        }
        let n = syscall(SYS_SENDTO, self.fd,
                        buf, buf.len, 0, &sa, 16) as i64
        if n < 0 { ret err("udp send_to() failed") }
        ret ok(n)
    }

    ; Send raw bytes to a pre-built SockAddrIn (zero allocation fast path)
    fn send_to_raw(self, buf: ref []i8, len: i64,
                   sa: ref SockAddrIn) -> i64 {
        ret syscall(SYS_SENDTO, self.fd, buf, len, 0, sa, 16) as i64
    }

    ; -------------------------------------------------------------------------
    ; recv_from(buf, max) -> Result<(i64, UdpPeer), []i8>
    ; Blocks (yields J-Thread) until a datagram arrives.
    ; Returns bytes received and sender address.
    ; -------------------------------------------------------------------------
    fn recv_from(self, buf: []mut i8, max: i64)
                -> Result<(i64, UdpPeer), []i8> {
        let src_sa  = SockAddrIn { sin_family: 0, sin_port: 0,
                                   sin_addr: 0, sin_zero: [0; 8] }
        let src_len: u32 = 16

        loop {
            let n = syscall(SYS_RECVFROM, self.fd, buf, max, 0,
                            &mut src_sa, &mut src_len) as i64
            if n >= 0 {
                let peer = UdpPeer {
                    addr: ntohl(src_sa.sin_addr),
                    port: ntohs(src_sa.sin_port),
                }
                ret ok((n, peer))
            }
            if -n == EAGAIN { jthread_yield() }
            else            { ret err("udp recv_from() failed") }
        }
    }

    ; Non-blocking try — returns none if no datagram ready
    fn try_recv_from(self, buf: []mut i8, max: i64)
                    -> ?( i64, UdpPeer) {
        let src_sa  = SockAddrIn { sin_family: 0, sin_port: 0,
                                   sin_addr: 0, sin_zero: [0; 8] }
        let src_len: u32 = 16
        let n = syscall(SYS_RECVFROM, self.fd, buf, max, 0,
                        &mut src_sa, &mut src_len) as i64
        if n < 0 { ret none }
        ret some((n, UdpPeer {
            addr: ntohl(src_sa.sin_addr),
            port: ntohs(src_sa.sin_port),
        }))
    }

    ; -------------------------------------------------------------------------
    ; Broadcast — send to 255.255.255.255 or subnet broadcast
    ; -------------------------------------------------------------------------
    fn enable_broadcast(self) {
        let one: i32 = 1
        syscall(SYS_SETSOCKOPT, self.fd, SOL_SOCKET, SO_BROADCAST, &one, 4)
    }

    fn send_broadcast(self, buf: ref []i8, port: u16) -> i64 {
        ret self.send_to(buf, "255.255.255.255", port).unwrap_or(0)
    }

    ; -------------------------------------------------------------------------
    ; Multicast — join/leave a multicast group (224.0.0.0/4)
    ; -------------------------------------------------------------------------
    struct IpMreq {
        multiaddr: u32   ; multicast group address
        interface: u32   ; local interface (0 = default)
    }

    fn join_multicast(self, group: ref []i8) -> Result<(), []i8> {
        let mreq = IpMreq {
            multiaddr: htonl(ip_to_u32(group)),
            interface: 0,
        }
        let rc = syscall(SYS_SETSOCKOPT, self.fd, IPPROTO_IP,
                         IP_ADD_MEMBERSHIP, &mreq, 8) as i32
        if rc < 0 { ret err("join_multicast failed") }
        ret ok(())
    }

    fn leave_multicast(self, group: ref []i8) {
        let mreq = IpMreq {
            multiaddr: htonl(ip_to_u32(group)),
            interface: 0,
        }
        syscall(SYS_SETSOCKOPT, self.fd, IPPROTO_IP,
                IP_DROP_MEMBERSHIP, &mreq, 8)
    }

    fn set_multicast_ttl(self, ttl: u8) {
        let v = ttl as i32
        syscall(SYS_SETSOCKOPT, self.fd, IPPROTO_IP,
                IP_MULTICAST_TTL, &v, 4)
    }

    ; -------------------------------------------------------------------------
    ; close
    ; -------------------------------------------------------------------------
    fn close(self) {
        syscall(SYS_CLOSE, self.fd, 0, 0)
    }
}

; =============================================================================
; Example: simple UDP echo server (one J-Thread)
; =============================================================================
fn udp_echo_server(port: u16) {
    let sock = UdpSocket::bind("0.0.0.0", port).unwrap()
    defer sock.close()

    let buf = [65536]i8    ; max UDP datagram = 64 KB
    print("UDP echo server on port ", port)

    loop {
        match sock.recv_from(buf, 65536) {
            ok((n, peer)) => {
                sock.send_to(buf[0..n], peer.addr_str(), peer.port).unwrap_or(0)
            }
            err(e) => print("recv error: ", e)
        }
    }
}
