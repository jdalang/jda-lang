; =============================================================================
; jda::stringscanner -- Stateful String Scanner
; =============================================================================
; Scan through a string with position tracking. Useful for tokenizers/parsers.
;
; Memory layout per StringScanner (&i64):
;   [0] src_ptr    (&i8)
;   [1] src_len
;   [2] pos        (current scan position)
;   [3] match_off  (start of last match)
;   [4] match_len  (length of last match)
;
; Functions:
;   ss_new(src, len)                 -> &i64  create scanner
;   ss_scan(ss, pat, plen)           -> i64   match at pos, advance if found
;   ss_check(ss, pat, plen)          -> i64   match at pos, don't advance
;   ss_skip(ss, n)                            advance position by n
;   ss_skip_until(ss, pat, plen)     -> i64   advance until pattern found
;   ss_rest(ss, out)                 -> i64   copy remaining string
;   ss_rest_len(ss)                  -> i64   length of remaining
;   ss_eos(ss)                       -> i64   1 if at end
;   ss_pos(ss)                       -> i64   current position
;   ss_reset(ss)                              reset to start
;   ss_matched(ss, out)              -> i64   copy last match
;   ss_peek(ss, n, out)              -> i64   peek next n bytes without advancing
;   ss_scan_byte(ss)                 -> i64   read one byte and advance
; =============================================================================

fn _ss_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

fn _ss_copy(dst: &i8, doff: i64, src: &i8, soff: i64, n: i64) {
    let i = 0
    loop i < n {
        poke_byte(dst, doff + i, src[soff + i])
        i = i + 1
    }
}

;; Create new scanner over source string.
fn ss_new(src: &i8, len: i64) -> &i64 {
    let ss: &i64 = alloc_pages(1)
    ss[0] = src
    ss[1] = len
    ss[2] = 0
    ss[3] = 0
    ss[4] = 0
    ret ss
}

;; Try to match pattern at current position. If found, advance and return 1.
fn ss_scan(ss: &i64, pat: &i8, plen: i64) -> i64 {
    let src: &i8 = ss[0]
    let slen = ss[1]
    let pos = ss[2]
    if pos + plen > slen { ret 0 }
    let i = 0
    loop i < plen {
        if _ss_byte_at(src, pos + i) != pat[i] { ret 0 }
        i = i + 1
    }
    ss[3] = pos
    ss[4] = plen
    ss[2] = pos + plen
    ret 1
}

;; Check if pattern matches at current position without advancing.
fn ss_check(ss: &i64, pat: &i8, plen: i64) -> i64 {
    let src: &i8 = ss[0]
    let slen = ss[1]
    let pos = ss[2]
    if pos + plen > slen { ret 0 }
    let i = 0
    loop i < plen {
        if _ss_byte_at(src, pos + i) != pat[i] { ret 0 }
        i = i + 1
    }
    ret 1
}

;; Advance position by n bytes.
fn ss_skip(ss: &i64, n: i64) {
    let new_pos = ss[2] + n
    if new_pos > ss[1] { new_pos = ss[1] }
    ss[2] = new_pos
}

;; Skip forward until pattern is found. Returns distance skipped, -1 if not found.
fn ss_skip_until(ss: &i64, pat: &i8, plen: i64) -> i64 {
    let src: &i8 = ss[0]
    let slen = ss[1]
    let start = ss[2]
    let pos = start
    loop pos + plen <= slen {
        let found = 1
        let i = 0
        loop i < plen {
            if _ss_byte_at(src, pos + i) != pat[i] { found = 0 }
            if found == 0 { i = plen }
            if found == 1 { i = i + 1 }
        }
        if found == 1 {
            ss[2] = pos
            ss[3] = start
            ss[4] = pos - start
            ret pos - start
        }
        pos = pos + 1
    }
    ret 0 - 1
}

;; Copy remaining unscanned portion to out. Returns length.
fn ss_rest(ss: &i64, out: &i8) -> i64 {
    let src: &i8 = ss[0]
    let remaining = ss[1] - ss[2]
    if remaining <= 0 { ret 0 }
    _ss_copy(out, 0, src, ss[2], remaining)
    ret remaining
}

;; Length of remaining unscanned portion.
fn ss_rest_len(ss: &i64) -> i64 {
    ret ss[1] - ss[2]
}

;; 1 if at end of string.
fn ss_eos(ss: &i64) -> i64 {
    if ss[2] >= ss[1] { ret 1 }
    ret 0
}

;; Current scan position.
fn ss_pos(ss: &i64) -> i64 {
    ret ss[2]
}

;; Reset scanner to beginning.
fn ss_reset(ss: &i64) {
    ss[2] = 0
    ss[3] = 0
    ss[4] = 0
}

;; Copy last matched string to out. Returns length.
fn ss_matched(ss: &i64, out: &i8) -> i64 {
    let src: &i8 = ss[0]
    let mlen = ss[4]
    if mlen == 0 { ret 0 }
    _ss_copy(out, 0, src, ss[3], mlen)
    ret mlen
}

;; Peek at next n bytes without advancing. Returns bytes copied.
fn ss_peek(ss: &i64, n: i64, out: &i8) -> i64 {
    let src: &i8 = ss[0]
    let avail = ss[1] - ss[2]
    if n > avail { n = avail }
    if n <= 0 { ret 0 }
    _ss_copy(out, 0, src, ss[2], n)
    ret n
}

;; Read one byte and advance. Returns byte value or -1 at end.
fn ss_scan_byte(ss: &i64) -> i64 {
    if ss[2] >= ss[1] { ret 0 - 1 }
    let src: &i8 = ss[0]
    let b = _ss_byte_at(src, ss[2])
    ss[3] = ss[2]
    ss[4] = 1
    ss[2] = ss[2] + 1
    ret b
}
