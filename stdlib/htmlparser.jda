// =============================================================================
// jda::htmlparser -- Simple HTML Tag Parser (SAX-style events)
// =============================================================================
// Parses HTML into a sequence of events: open-tag, close-tag, text.
// Does not handle attributes or self-closing tags specially.

// Memory layout per HtmlHandle (&i64):
//   [0] event_count
//   [1] event_types  (&i64 — 1=open, 2=close, 3=text)
//   [2] event_offs   (&i64 — byte offsets into data)
//   [3] event_lens   (&i64 — byte lengths)
//   [4] data         (&i8  — copy of source)
//   [5] data_len

// Functions:
//   html_parse(buf, len)            -> &i64  parse HTML
//   html_event_count(h)             -> i64
//   html_event_type(h, idx)         -> i64   1=open, 2=close, 3=text
//   html_event_tag(h, idx, out)     -> i64   copy tag/text name to out
//   html_event_text(h, idx, out)    -> i64   copy text to out
//   html_strip_tags(buf, len, out)  -> i64   strip all tags
//   html_escape(buf, len, out)      -> i64   escape &<>"
// =============================================================================

// Internal byte reader.
fn _html_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

// Internal: copy bytes from src+off to dst+doff, length n.
fn _html_copy(dst: &i8, doff: i64, src: &i8, soff: i64, n: i64) -> i64 {
    let i = 0
    loop i < n {
        let ch = _html_byte_at(src, soff + i)
        poke_byte(dst, doff + i, ch)
        i = i + 1
    }
    ret n
}

// Internal: add an event to the handle.
fn _html_add_evt(h: &i64, typ: i64, off: i64, ln: i64) -> i64 {
    let cnt = h[0]
    let types: &i64 = h[1]
    let offs: &i64 = h[2]
    let lens: &i64 = h[3]
    types[cnt] = typ
    offs[cnt] = off
    lens[cnt] = ln
    h[0] = cnt + 1
    ret cnt + 1
}

// Internal: find '>' starting from pos. Returns index of '>' or len if not found.
fn _html_find_gt(data: &i8, pos: i64, len: i64) -> i64 {
    let p = pos
    loop p < len {
        let c = _html_byte_at(data, p)
        if c == 62 { ret p }
        p = p + 1
    }
    ret len
}

// Internal: find '<' starting from pos. Returns index of '<' or len if not found.
fn _html_find_lt(data: &i8, pos: i64, len: i64) -> i64 {
    let p = pos
    loop p < len {
        let c = _html_byte_at(data, p)
        if c == 60 { ret p }
        p = p + 1
    }
    ret len
}

// Internal: find end of tag name (space or end). Returns index.
fn _html_tag_end(data: &i8, start: i64, limit: i64) -> i64 {
    let p = start
    loop p < limit {
        let c = _html_byte_at(data, p)
        if c == 32 { ret p }
        p = p + 1
    }
    ret limit
}

// Parse HTML buffer into events.
fn html_parse(buf: &i8, len: i64) -> &i64 {
    let h: &i64 = alloc_pages(1)
    let types: &i64 = alloc_pages(1)
    let offs: &i64 = alloc_pages(1)
    let lens: &i64 = alloc_pages(1)
    let data: &i8 = alloc_pages(2)
    h[0] = 0
    h[1] = types
    h[2] = offs
    h[3] = lens
    h[4] = data
    h[5] = len
    // Copy source data
    let ci = 0
    loop ci < len {
        let cb = _html_byte_at(buf, ci)
        poke_byte(data, ci, cb)
        ci = ci + 1
    }
    // Parse using a position variable
    // We use a state array to track position since we can't return multiple values easily
    let pos = 0
    loop pos < len {
        let ch = _html_byte_at(data, pos)
        if ch == 60 {
            // '<' found - start of tag
            let tstart = pos + 1
            let ge = _html_find_gt(data, tstart, len)
            if ge < len {
                // Found '>'
                let first = _html_byte_at(data, tstart)
                if first == 47 {
                    // Close tag </xxx>
                    let ns = tstart + 1
                    let nl = ge - ns
                    _html_add_evt(h, 2, ns, nl)
                } else {
                    // Open tag <xxx ...>
                    let ne = _html_tag_end(data, tstart, ge)
                    let nl = ne - tstart
                    _html_add_evt(h, 1, tstart, nl)
                }
                pos = ge + 1
            } else {
                // No '>' found, skip '<'
                pos = pos + 1
            }
        } else {
            // Text content - scan until '<' or end
            let ts = pos
            let te = _html_find_lt(data, pos, len)
            let tlen = te - ts
            if tlen > 0 {
                _html_add_evt(h, 3, ts, tlen)
            }
            pos = te
        }
    }
    ret h
}

// Return event count.
fn html_event_count(h: &i64) -> i64 { ret h[0] }

// Return event type at index (1=open, 2=close, 3=text).
fn html_event_type(h: &i64, idx: i64) -> i64 {
    let types: &i64 = h[1]
    ret types[idx]
}

// Copy tag name at event idx to out. Return length.
fn html_event_tag(h: &i64, idx: i64, out: &i8) -> i64 {
    let offs: &i64 = h[2]
    let lens: &i64 = h[3]
    let data: &i8 = h[4]
    let off = offs[idx]
    let ln = lens[idx]
    _html_copy(out, 0, data, off, ln)
    ret ln
}

// Copy text content at event idx to out. Return length.
fn html_event_text(h: &i64, idx: i64, out: &i8) -> i64 {
    ret html_event_tag(h, idx, out)
}

// Strip all HTML tags, return plain text length.
fn html_strip_tags(buf: &i8, len: i64, out: &i8) -> i64 {
    let oi = 0
    let pos = 0
    let in_tag = 0
    loop pos < len {
        let ch = _html_byte_at(buf, pos)
        if ch == 60 { in_tag = 1 }
        if in_tag == 0 {
            poke_byte(out, oi, ch)
            oi = oi + 1
        }
        if ch == 62 { in_tag = 0 }
        pos = pos + 1
    }
    ret oi
}

// Internal: poke a string literal byte sequence for HTML escape.
fn _html_poke_amp(out: &i8, oi: i64) -> i64 {
    // &amp;
    poke_byte(out, oi, 38)      // &
    poke_byte(out, oi + 1, 97)  // a
    poke_byte(out, oi + 2, 109) // m
    poke_byte(out, oi + 3, 112) // p
    poke_byte(out, oi + 4, 59)  // ;
    ret oi + 5
}

fn _html_poke_lt(out: &i8, oi: i64) -> i64 {
    // &lt;
    poke_byte(out, oi, 38)      // &
    poke_byte(out, oi + 1, 108) // l
    poke_byte(out, oi + 2, 116) // t
    poke_byte(out, oi + 3, 59)  // ;
    ret oi + 4
}

fn _html_poke_gt(out: &i8, oi: i64) -> i64 {
    // &gt;
    poke_byte(out, oi, 38)      // &
    poke_byte(out, oi + 1, 103) // g
    poke_byte(out, oi + 2, 116) // t
    poke_byte(out, oi + 3, 59)  // ;
    ret oi + 4
}

fn _html_poke_quot(out: &i8, oi: i64) -> i64 {
    // &quot;
    poke_byte(out, oi, 38)       // &
    poke_byte(out, oi + 1, 113)  // q
    poke_byte(out, oi + 2, 117)  // u
    poke_byte(out, oi + 3, 111)  // o
    poke_byte(out, oi + 4, 116)  // t
    poke_byte(out, oi + 5, 59)   // ;
    ret oi + 6
}

// Escape HTML special characters: & < > "
fn html_escape(buf: &i8, len: i64, out: &i8) -> i64 {
    let oi = 0
    let i = 0
    loop i < len {
        let ch = _html_byte_at(buf, i)
        if ch == 38 {
            oi = _html_poke_amp(out, oi)
        } else {
            if ch == 60 {
                oi = _html_poke_lt(out, oi)
            } else {
                if ch == 62 {
                    oi = _html_poke_gt(out, oi)
                } else {
                    if ch == 34 {
                        oi = _html_poke_quot(out, oi)
                    } else {
                        poke_byte(out, oi, ch)
                        oi = oi + 1
                    }
                }
            }
        }
        i = i + 1
    }
    ret oi
}
