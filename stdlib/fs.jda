// =============================================================================
// jda::fs -- Minimal File I/O
// =============================================================================
// Direct Linux syscalls. No libc.

// IMPORTANT: Each helper function contains at most ONE syscall call.
// Multiple syscalls in a single function cause register corruption
// in the current compiler.

// Functions:
//   fs_read_file(path, buf, max) -> bytes read (-1 on error)
//   fs_write_file(path, data, len) -> bytes written (-1 on error)
//   fs_append_file(path, data, len) -> bytes written (-1 on error)
//   fs_exists(path) -> 1 if file exists, 0 otherwise
//   fs_unlink(path) -> 0 on success, -1 on error
//   fs_mkdir(path) -> 0 on success, -1 on error
//   fs_file_size(path) -> size in bytes (-1 on error)
// =============================================================================

// --- Single-syscall primitives ---

fn _fs_open_read(path: &i8) -> i64 {
    ret syscall(2, path, 0, 0)
}

fn _fs_open_write(path: &i8) -> i64 {
    // O_WRONLY | O_CREAT | O_TRUNC = 577, mode 0644 = 420
    ret syscall(2, path, 577, 420)
}

fn _fs_open_append(path: &i8) -> i64 {
    // O_WRONLY | O_CREAT | O_APPEND = 1089, mode 0644 = 420
    ret syscall(2, path, 1089, 420)
}

fn _fs_close(fd: i64) -> i64 {
    ret syscall(3, fd, 0, 0)
}

fn _fs_write(fd: i64, data: &i8, len: i64) -> i64 {
    ret syscall(1, fd, data, len)
}

fn _fs_read(fd: i64, buf: &i8, max: i64) -> i64 {
    ret syscall(0, fd, buf, max)
}

fn _fs_access(path: &i8) -> i64 {
    ret syscall(21, path, 0, 0)
}

fn _fs_unlink_raw(path: &i8) -> i64 {
    ret syscall(87, path, 0, 0)
}

fn _fs_mkdir_raw(path: &i8) -> i64 {
    // mkdir(path, 0755=493)
    ret syscall(83, path, 493, 0)
}

fn _fs_stat(path: &i8, statbuf: &i8) -> i64 {
    ret syscall(4, path, statbuf, 0)
}

fn _fs_rename_raw(src: &i8, dst: &i8) -> i64 {
    ret syscall(82, src, dst, 0)
}

// --- High-level functions (no syscalls, only call single-syscall helpers) ---

fn fs_read_file(path: &i8, buf: &i8, max_bytes: i64) -> i64 {
    let fd = _fs_open_read(path)
    if fd < 0 { ret -1 }
    let total = 0
    let keep = 1
    loop keep == 1 {
        let remaining = max_bytes - total
        if remaining < 1 { keep = 0 }
        if keep == 1 {
            let n = _fs_read(fd, buf + total, remaining)
            if n < 1 {
                keep = 0
            } else {
                total = total + n
            }
        }
    }
    _fs_close(fd)
    ret total
}

fn fs_write_file(path: &i8, data: &i8, len: i64) -> i64 {
    let fd = _fs_open_write(path)
    if fd < 0 { ret -1 }
    let n = _fs_write(fd, data, len)
    _fs_close(fd)
    ret n
}

fn fs_append_file(path: &i8, data: &i8, len: i64) -> i64 {
    let fd = _fs_open_append(path)
    if fd < 0 { ret -1 }
    let n = _fs_write(fd, data, len)
    _fs_close(fd)
    ret n
}

fn fs_exists(path: &i8) -> i64 {
    let r = _fs_access(path)
    if r == 0 { ret 1 }
    ret 0
}

fn fs_unlink(path: &i8) -> i64 {
    let r = _fs_unlink_raw(path)
    if r < 0 { ret -1 }
    ret 0
}

fn fs_mkdir(path: &i8) -> i64 {
    let r = _fs_mkdir_raw(path)
    if r < 0 { ret -1 }
    ret 0
}

fn fs_file_size(path: &i8) -> i64 {
    let statbuf = alloc_pages(1)
    let r = _fs_stat(path, statbuf)
    if r < 0 { ret -1 }
    let size_ptr: &i64 = statbuf + 48
    let size = size_ptr[0]
    ret size
}
