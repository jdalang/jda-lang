; =============================================================================
; jda::fs -- Minimal File I/O
; =============================================================================
; Direct Linux syscalls. No libc.
;
; Functions:
;   fs_read_file(path, buf, max) -> bytes read (-1 on error)
;   fs_write_file(path, data, len) -> bytes written (-1 on error)
;   fs_append_file(path, data, len) -> bytes written (-1 on error)
;   fs_exists(path) -> 1 if file exists, 0 otherwise
;   fs_unlink(path) -> 0 on success, -1 on error
;   fs_mkdir(path) -> 0 on success, -1 on error
;   fs_file_size(path) -> size in bytes (-1 on error)
; =============================================================================

fn fs_read_file(path: &i8, buf: &i8, max_bytes: i64) -> i64 {
    let fd = syscall(2, path, 0, 0)
    if fd < 0 { ret -1 }
    let total = 0
    let keep = 1
    loop keep == 1 {
        let remaining = max_bytes - total
        if remaining < 1 { keep = 0 }
        if keep == 1 {
            let n = syscall(0, fd, buf + total, remaining)
            if n < 1 {
                keep = 0
            } else {
                total = total + n
            }
        }
    }
    syscall(3, fd, 0, 0)
    ret total
}

fn fs_write_file(path: &i8, data: &i8, len: i64) -> i64 {
    ; O_WRONLY | O_CREAT | O_TRUNC = 577, mode 0644 = 420
    let fd = syscall(2, path, 577, 420)
    if fd < 0 { ret -1 }
    let n = syscall(1, fd, data, len)
    syscall(3, fd, 0, 0)
    ret n
}

fn fs_append_file(path: &i8, data: &i8, len: i64) -> i64 {
    ; O_WRONLY | O_CREAT | O_APPEND = 1089, mode 0644 = 420
    let fd = syscall(2, path, 1089, 420)
    if fd < 0 { ret -1 }
    let n = syscall(1, fd, data, len)
    syscall(3, fd, 0, 0)
    ret n
}

fn fs_exists(path: &i8) -> i64 {
    ; access(path, F_OK=0) via syscall 21
    let r = syscall(21, path, 0, 0)
    if r == 0 { ret 1 }
    ret 0
}

fn fs_unlink(path: &i8) -> i64 {
    let r = syscall(87, path, 0, 0)
    if r < 0 { ret -1 }
    ret 0
}

fn fs_mkdir(path: &i8) -> i64 {
    ; mkdir(path, 0755=493)
    let r = syscall(83, path, 493, 0)
    if r < 0 { ret -1 }
    ret 0
}

fn fs_file_size(path: &i8) -> i64 {
    ; stat syscall = 4, st_size at offset 48 in struct stat
    let statbuf = alloc_pages(1)
    let r = syscall(4, path, statbuf, 0)
    if r < 0 { ret -1 }
    let size_ptr: &i64 = statbuf + 48
    let size = size_ptr[0]
    ret size
}
