// =============================================================================
// jda::process — Process management
// =============================================================================
// fork / exec / waitpid / kill / signals / getpid / getenv / argv

// All calls are raw Linux x86-64 syscalls.  No libc.  No POSIX wrappers.
// =============================================================================

// ============================================================
// 1. SYSCALL NUMBERS  (Linux x86-64)
// ============================================================

const SYS_READ      =  0
const SYS_WRITE     =  1
const SYS_OPEN      =  2
const SYS_CLOSE     =  3
const SYS_STAT      =  4
const SYS_MMAP      =  9
const SYS_RT_SIGACTION   = 13
const SYS_RT_SIGPROCMASK = 14
const SYS_RT_SIGRETURN   = 15
const SYS_IOCTL     = 16
const SYS_PIPE      = 22
const SYS_DUP       = 32
const SYS_DUP2      = 33
const SYS_GETPID    = 39
const SYS_CLONE     = 56
const SYS_FORK      = 57
const SYS_VFORK     = 58
const SYS_EXECVE    = 59
const SYS_EXIT      = 60
const SYS_WAIT4     = 61
const SYS_KILL      = 62
const SYS_GETPPID   = 110
const SYS_GETUID    = 102
const SYS_GETGID    = 104
const SYS_GETEUID   = 107
const SYS_GETEGID   = 108
const SYS_SIGALTSTACK= 131
const SYS_PRCTL     = 157
const SYS_SETPGID   = 109
const SYS_GETPGID   = 121
const SYS_SETSID    = 112
const SYS_ENVIRON   = -1   // accessed via auxv, not a syscall

// ============================================================
// 2. SIGNAL NUMBERS
// ============================================================

const SIGHUP    =  1    // hangup
const SIGINT    =  2    // interrupt (Ctrl-C)
const SIGQUIT   =  3    // quit
const SIGILL    =  4    // illegal instruction
const SIGTRAP   =  5    // trace / breakpoint
const SIGABRT   =  6    // abort
const SIGBUS    =  7    // bus error
const SIGFPE    =  8    // floating-point exception
const SIGKILL   =  9    // kill (cannot be caught)
const SIGUSR1   = 10    // user-defined 1
const SIGSEGV   = 11    // segfault
const SIGUSR2   = 12    // user-defined 2
const SIGPIPE   = 13    // broken pipe
const SIGALRM   = 14    // alarm clock
const SIGTERM   = 15    // termination
const SIGCHLD   = 17    // child stopped or exited
const SIGCONT   = 18    // continue
const SIGSTOP   = 19    // stop (cannot be caught)
const SIGTSTP   = 20    // terminal stop (Ctrl-Z)
const SIGTTIN   = 21    // background read from tty
const SIGTTOU   = 22    // background write to tty
const SIGURG    = 23    // urgent data on socket
const SIGWINCH  = 28    // terminal resize

// Signal disposition constants
const SIG_DFL   = 0     // default action
const SIG_IGN   = 1     // ignore signal

// ============================================================
// 3. WAIT STATUS MACROS
// ============================================================

const WNOHANG   = 1     // non-blocking waitpid

fn wifexited(status: i32) -> i32   { ret (status & 0x7F) == 0 }
fn wexitstatus(status: i32) -> i32 { ret (status >> 8) & 0xFF }
fn wifsignaled(status: i32) -> i32 { ret ((status & 0x7F) != 0) and ((status & 0x7F) != 0x7F) }
fn wtermsig(status: i32) -> i32    { ret status & 0x7F }
fn wifstopped(status: i32) -> i32  { ret (status & 0xFF) == 0x7F }
fn wstopsig(status: i32) -> i32    { ret (status >> 8) & 0xFF }

// ============================================================
// 4. STRUCTS
// ============================================================

struct SigAction {
    handler:  i64      // fn pointer or SIG_DFL / SIG_IGN
    flags:    i64      // SA_* flags
    restorer: i64      // signal trampoline (kernel sets this)
    mask:     u64[2]   // signal mask (128 bits)
}

struct ProcInfo {
    pid:      i32
    ppid:     i32
    uid:      i32
    gid:      i32
    euid:     i32
    egid:     i32
    pgid:     i32
    sid:      i32
}

struct SpawnOpts {
    stdin_fd:  i32   // -1 = inherit
    stdout_fd: i32   // -1 = inherit
    stderr_fd: i32   // -1 = inherit
    cwd:       &i8   // null = inherit
    env:       &&i8  // null = inherit current environ
    detach:    i32   // 1 = new session (setsid)
}

struct ChildProc {
    pid:    i32
    stdin:  i32   // write end of stdin pipe  (-1 if not piped)
    stdout: i32   // read  end of stdout pipe (-1 if not piped)
    stderr: i32   // read  end of stderr pipe (-1 if not piped)
}

struct WaitResult {
    pid:    i32
    status: i32
    exited: i32
    code:   i32     // exit code if exited
    signal: i32     // signal if killed by signal
}

// ============================================================
// 5. BASIC PROCESS OPERATIONS
// ============================================================

fn getpid() -> i32 {
    ret syscall(SYS_GETPID, 0, 0, 0) as i32
}

fn getppid() -> i32 {
    ret syscall(SYS_GETPPID, 0, 0, 0) as i32
}

fn getuid() -> i32 { ret syscall(SYS_GETUID, 0, 0, 0) as i32 }
fn getgid() -> i32 { ret syscall(SYS_GETGID, 0, 0, 0) as i32 }

fn exit(code: i32) {
    syscall(SYS_EXIT, code, 0, 0)
}

fn abort() {
    kill(getpid(), SIGABRT)
}

// ============================================================
// 6. FORK / EXEC / WAIT
// ============================================================

fn fork() -> i32 {
    ret syscall(SYS_FORK, 0, 0, 0) as i32
}

// execve(path, argv, envp)
// argv and envp are null-terminated arrays of null-terminated strings.
fn execve(path: &i8, argv: &&i8, envp: &&i8) -> i32 {
    ret syscall(SYS_EXECVE, path, argv, envp) as i32
}

// Execute a command with a simple argv array (no environment override).
// Returns the child pid or -errno.
fn exec_argv(path: &i8, argv: &&i8) -> i32 {
    let pid = fork()
    if pid < 0 { ret pid }          // fork failed
    if pid == 0 {
        // child: exec
        execve(path, argv, environ())
        exit(127)                   // exec failed: command not found
    }
    ret pid
}

fn waitpid(pid: i32, status: &i32, options: i32) -> i32 {
    ret syscall(SYS_WAIT4, pid, status, options) as i32
}

// Wait for any child and return structured result
fn wait_any(opts: i32) -> WaitResult {
    let status = 0
    let pid = waitpid(-1, &status, opts)
    let r = WaitResult{}
    r.pid    = pid
    r.status = status
    r.exited = wifexited(status)
    r.code   = wexitstatus(status)
    r.signal = wtermsig(status)
    ret r
}

// Run a command and wait for it to finish; return exit code.
fn run(path: &i8, argv: &&i8) -> i32 {
    let pid = exec_argv(path, argv)
    if pid < 0 { ret -1 }
    let status = 0
    waitpid(pid, &status, 0)
    ret wexitstatus(status)
}

// ============================================================
// 7. SPAWN WITH PIPES  (like subprocess.Popen)
// ============================================================

fn pipe2(fds: &i32) -> i32 {
    // pipe2(fds, 0) — SYS_PIPE2 = 293
    ret syscall(293, fds, 0, 0) as i32
}

fn dup2(old_fd: i32, new_fd: i32) -> i32 {
    ret syscall(SYS_DUP2, old_fd, new_fd, 0) as i32
}

fn close_fd(fd: i32) {
    syscall(SYS_CLOSE, fd, 0, 0)
}

// Spawn a child process with piped stdin/stdout/stderr.
// Returns ChildProc with pid and pipe file descriptors.
fn spawn(path: &i8, argv: &&i8, opts: &SpawnOpts) -> ChildProc {
    let child = ChildProc{}
    child.stdin  = -1
    child.stdout = -1
    child.stderr = -1

    let in_fds  = i32[2]   // [0]=read  [1]=write  (child reads [0])
    let out_fds = i32[2]
    let err_fds = i32[2]

    if opts.stdin_fd == -1  { pipe2(&in_fds)  }
    if opts.stdout_fd == -1 { pipe2(&out_fds) }
    if opts.stderr_fd == -1 { pipe2(&err_fds) }

    let pid = fork()
    if pid < 0 {
        child.pid = pid
        ret child
    }

    if pid == 0 {
        // ---- Child ----
        if opts.detach != 0 { syscall(SYS_SETSID, 0, 0, 0) }

        // Wire up stdio
        if opts.stdin_fd == -1 {
            dup2(in_fds[0],  0)   // stdin  ← read end of in_pipe
            close_fd(in_fds[0])   close_fd(in_fds[1])
        } else if opts.stdin_fd >= 0 {
            dup2(opts.stdin_fd, 0)
        }
        if opts.stdout_fd == -1 {
            dup2(out_fds[1], 1)
            close_fd(out_fds[0])  close_fd(out_fds[1])
        } else if opts.stdout_fd >= 0 {
            dup2(opts.stdout_fd, 1)
        }
        if opts.stderr_fd == -1 {
            dup2(err_fds[1], 2)
            close_fd(err_fds[0])  close_fd(err_fds[1])
        } else if opts.stderr_fd >= 0 {
            dup2(opts.stderr_fd, 2)
        }

        let env = opts.env
        if env == null { env = environ() }
        execve(path, argv, env)
        exit(127)
    }

    // ---- Parent ----
    // Close child-side pipe ends
    if opts.stdin_fd == -1 {
        close_fd(in_fds[0])
        child.stdin = in_fds[1]
    }
    if opts.stdout_fd == -1 {
        close_fd(out_fds[1])
        child.stdout = out_fds[0]
    }
    if opts.stderr_fd == -1 {
        close_fd(err_fds[1])
        child.stderr = err_fds[0]
    }

    child.pid = pid
    ret child
}

// Read all output from a spawned process into a buffer; return bytes read.
fn spawn_output(path: &i8, argv: &&i8, out: &i8, cap: i64) -> i64 {
    let opts = SpawnOpts{}
    opts.stdin_fd  = -1
    opts.stdout_fd = -1
    opts.stderr_fd = -1
    let child = spawn(path, argv, &opts)
    if child.pid < 0 { ret -1 }

    // Close stdin (we won't write to it)
    close_fd(child.stdin)

    // Read all stdout
    let total = 0
    loop total < cap - 1 {
        let n = syscall(SYS_READ, child.stdout, out + total, cap - 1 - total) as i64
        if n <= 0 { ret total }
        total = total + n
    }
    out[total] = 0
    close_fd(child.stdout)

    let status = 0
    waitpid(child.pid, &status, 0)
    ret total
}

// ============================================================
// 8. KILL / SIGNALS
// ============================================================

fn kill(pid: i32, sig: i32) -> i32 {
    ret syscall(SYS_KILL, pid, sig, 0) as i32
}

fn killpg(pgid: i32, sig: i32) -> i32 {
    ret kill(0 - pgid, sig)   // negative pid = process group
}

fn raise_sig(sig: i32) {
    kill(getpid(), sig)
}

fn signal(sig: i32, handler: i64) -> i32 {
    let sa = SigAction{}
    sa.handler = handler
    sa.flags   = 0x04000000   // SA_RESTORER (kernel requires it on Linux)
    // rt_sigaction(sig, &sa, NULL, 8)
    ret syscall(SYS_RT_SIGACTION, sig, &sa, 0) as i32
}

fn signal_ignore(sig: i32) {
    signal(sig, SIG_IGN)
}

fn signal_default(sig: i32) {
    signal(sig, SIG_DFL)
}

// Block a set of signals (simple: block single signal)
fn signal_block(sig: i32) {
    let mask = u64[2]
    if sig <= 64 { mask[0] = 1 << (sig - 1) }
    else         { mask[1] = 1 << (sig - 65) }
    // SIG_BLOCK = 0
    syscall(SYS_RT_SIGPROCMASK, 0, &mask, 0)
}

fn signal_unblock(sig: i32) {
    let mask = u64[2]
    if sig <= 64 { mask[0] = 1 << (sig - 1) }
    else         { mask[1] = 1 << (sig - 65) }
    // SIG_UNBLOCK = 1
    syscall(SYS_RT_SIGPROCMASK, 1, &mask, 0)
}

// ============================================================
// 9. ENVIRONMENT VARIABLES
// ============================================================
// On Linux, the env pointer is passed to the process via execve
// and is accessible at argv + argc + 1 on the initial stack.
// We expose a module-level pointer set during startup.

let _environ_ptr = 0   // set by process_init()

fn environ() -> &&i8 {
    ret _environ_ptr
}

// Call this from main() with the stack pointer to initialise argv/environ.
// Convention: rsp+8 = argc, rsp+16 = argv[0], argv[argc+1] = envp[0]
fn process_init(argc: i64, argv: &&i8) {
    _environ_ptr = argv + (argc + 1)
}

// Look up an environment variable by name; return null if not found.
fn getenv(name: &i8) -> &i8 {
    let env = environ()
    if env == null { ret null }
    let i = 0
    loop env[i] != null {
        let entry = env[i]
        // Compare name to entry up to '='
        let j = 0
        loop name[j] != 0 and entry[j] == name[j] { j = j + 1 }
        if name[j] == 0 and entry[j] == '=' {
            ret entry + j + 1    // pointer to value
        }
        i = i + 1
    }
    ret null
}

// Set an environment variable (appends to env array — limited to 256 new vars)
let _extra_env  = &i8[256 * 64]   // storage for new KEY=VALUE strings
let _extra_cnt  = 0
let _env_arr    = &&i8[512]        // rebuilt env array

fn setenv(name: &i8, value: &i8, overwrite: i32) -> i32 {
    // Check if already set
    if overwrite == 0 {
        if getenv(name) != null { ret 0 }
    }
    // Build "NAME=VALUE" string
    let slot = &_extra_env[_extra_cnt * 64]
    let p = 0
    let i = 0
    loop name[i] != 0 { slot[p] = name[i]   p = p + 1   i = i + 1 }
    slot[p] = '='   p = p + 1
    i = 0
    loop value[i] != 0 { slot[p] = value[i]   p = p + 1   i = i + 1 }
    slot[p] = 0
    _extra_cnt = _extra_cnt + 1

    // Rebuild env array: copy existing + append new
    let old = environ()
    let cnt = 0
    if old != null { loop old[cnt] != null { _env_arr[cnt] = old[cnt]   cnt = cnt + 1 } }
    _env_arr[cnt] = slot
    _env_arr[cnt + 1] = null
    _environ_ptr = &_env_arr
    ret 0
}

fn unsetenv(name: &i8) -> i32 {
    let env = environ()
    if env == null { ret 0 }
    // Rebuild array skipping matching entry
    let cnt = 0
    let out = 0
    loop env[cnt] != null {
        let entry = env[cnt]
        let j = 0
        loop name[j] != 0 and entry[j] == name[j] { j = j + 1 }
        if name[j] != 0 or entry[j] != '=' {
            _env_arr[out] = entry
            out = out + 1
        }
        cnt = cnt + 1
    }
    _env_arr[out] = null
    _environ_ptr = &_env_arr
    ret 0
}

// ============================================================
// 10. PROCESS INFO
// ============================================================

fn proc_info() -> ProcInfo {
    let info = ProcInfo{}
    info.pid  = getpid()
    info.ppid = getppid()
    info.uid  = getuid()
    info.gid  = getgid()
    info.euid = syscall(SYS_GETEUID, 0, 0, 0) as i32
    info.egid = syscall(SYS_GETEGID, 0, 0, 0) as i32
    info.pgid = syscall(SYS_GETPGID, 0, 0, 0) as i32
    info.sid  = syscall(112, 0, 0, 0) as i32   // getsid(0)
    ret info
}

// ============================================================
// 11. PIPES (standalone, without spawn)
// ============================================================

struct Pipe {
    read_fd:  i32
    write_fd: i32
}

fn pipe_open() -> Pipe {
    let fds = i32[2]
    pipe2(&fds)
    let p = Pipe{}
    p.read_fd  = fds[0]
    p.write_fd = fds[1]
    ret p
}

fn pipe_write(p: &Pipe, data: &i8, len: i64) -> i64 {
    ret syscall(SYS_WRITE, p.write_fd, data, len)
}

fn pipe_read(p: &Pipe, buf: &i8, cap: i64) -> i64 {
    ret syscall(SYS_READ, p.read_fd, buf, cap)
}

fn pipe_close_write(p: &Pipe) { close_fd(p.write_fd)   p.write_fd = -1 }
fn pipe_close_read(p: &Pipe)  { close_fd(p.read_fd)    p.read_fd  = -1 }

// ============================================================
// 12. DAEMON  (double-fork + setsid)
// ============================================================

fn daemonize() -> i32 {
    // First fork
    let pid = fork()
    if pid < 0 { ret pid }
    if pid > 0 { exit(0) }           // parent exits

    // New session
    syscall(SYS_SETSID, 0, 0, 0)

    // Second fork (prevents re-acquiring a controlling terminal)
    pid = fork()
    if pid < 0 { ret pid }
    if pid > 0 { exit(0) }           // first child exits

    // Redirect stdio to /dev/null
    let devnull = syscall(SYS_OPEN, "/dev/null", 2, 0) as i32  // O_RDWR
    if devnull >= 0 {
        dup2(devnull, 0)   dup2(devnull, 1)   dup2(devnull, 2)
        if devnull > 2 { close_fd(devnull) }
    }
    ret 0
}

// ============================================================
// 13. PRCTL HELPERS
// ============================================================

const PR_SET_NAME   = 15
const PR_GET_NAME   = 16
const PR_SET_DUMPABLE = 4
const PR_GET_DUMPABLE = 3
const PR_SET_PDEATHSIG = 1   // signal sent to child when parent dies

fn set_process_name(name: &i8) {
    syscall(SYS_PRCTL, PR_SET_NAME, name, 0)
}

fn get_process_name(out: &i8) {
    syscall(SYS_PRCTL, PR_GET_NAME, out, 0)
}

// Send sig to this process when its parent dies
fn set_pdeathsig(sig: i32) {
    syscall(SYS_PRCTL, PR_SET_PDEATHSIG, sig, 0)
}

// Disable core dumps for this process
fn disable_coredump() {
    syscall(SYS_PRCTL, PR_SET_DUMPABLE, 0, 0)
}
