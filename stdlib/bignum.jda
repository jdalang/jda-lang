; =============================================================================
; jda::bignum -- Arbitrary Precision Integers
; =============================================================================
; Stores large integers as arrays of base-10^9 limbs with a sign flag.
; Each limb holds a value 0..999999999 in an i64.
;
; Memory layout per BigNum (&i64):
;   [0] sign       (0=positive, 1=negative)
;   [1] len        (number of limbs)
;   [2] cap        (limb capacity)
;   [3] digits_ptr (&i64 — array of limbs, least significant first)
;
; Functions:
;   bn_new(val)                -> &i64  create from i64
;   bn_from_str(s, slen)      -> &i64  parse decimal string
;   bn_add(a, b)               -> &i64  addition
;   bn_sub(a, b)               -> &i64  subtraction
;   bn_mul(a, b)               -> &i64  multiplication
;   bn_cmp(a, b)               -> i64   -1, 0, 1
;   bn_abs_cmp(a, b)           -> i64   compare magnitudes
;   bn_to_str(a, out)          -> i64   write decimal string
;   bn_to_i64(a)               -> i64   convert to i64 (truncate)
;   bn_is_zero(a)              -> i64   1 if zero
;   bn_negate(a)               -> &i64  flip sign
; =============================================================================

const BN_BASE = 1000000000

;; Internal: allocate BigNum with given limb capacity.
fn _bn_alloc(cap: i64) -> &i64 {
    let bn: &i64 = alloc_pages(1)
    let pages = cap * 8 / 4096 + 1
    let digits: &i64 = alloc_pages(pages)
    bn[0] = 0
    bn[1] = 0
    bn[2] = cap
    bn[3] = digits
    ret bn
}

;; Create BigNum from i64 value.
fn bn_new(val: i64) -> &i64 {
    let bn = _bn_alloc(16)
    let sign = 0
    if val < 0 {
        sign = 1
        val = 0 - val
    }
    bn[0] = sign
    let digits: &i64 = bn[3]
    if val == 0 {
        digits[0] = 0
        bn[1] = 1
    } else {
        let i = 0
        loop val > 0 {
            digits[i] = val - (val / BN_BASE) * BN_BASE
            val = val / BN_BASE
            i = i + 1
        }
        bn[1] = i
    }
    ret bn
}

;; Parse decimal string to BigNum. Handles optional leading '-'.
fn bn_from_str(s: &i8, slen: i64) -> &i64 {
    let bn = _bn_alloc(slen / 9 + 2)
    let digits: &i64 = bn[3]
    let sign = 0
    let start = 0
    if slen > 0 {
        if s[0] == 45 { sign = 1   start = 1 }
    }
    bn[0] = sign

    ; Process digits in groups of 9 from the right
    let ndigits = 0
    let pos = slen
    loop pos > start {
        let chunk_start = pos - 9
        if chunk_start < start { chunk_start = start }
        let limb = 0
        let mult = 1
        let ci = pos - 1
        loop ci >= chunk_start {
            let d = s[ci] - 48
            limb = limb + d * mult
            mult = mult * 10
            ci = ci - 1
        }
        digits[ndigits] = limb
        ndigits = ndigits + 1
        pos = chunk_start
    }
    if ndigits == 0 {
        digits[0] = 0
        ndigits = 1
    }
    bn[1] = ndigits
    ret bn
}

;; Compare magnitudes (ignoring sign). Returns -1, 0, or 1.
fn bn_abs_cmp(a: &i64, b: &i64) -> i64 {
    let alen = a[1]
    let blen = b[1]
    if alen > blen { ret 1 }
    if alen < blen { ret 0 - 1 }
    let ad: &i64 = a[3]
    let bd: &i64 = b[3]
    let i = alen - 1
    loop i >= 0 {
        if ad[i] > bd[i] { ret 1 }
        if ad[i] < bd[i] { ret 0 - 1 }
        i = i - 1
    }
    ret 0
}

;; Compare two BigNums. Returns -1, 0, or 1.
fn bn_cmp(a: &i64, b: &i64) -> i64 {
    let as_val = a[0]
    let bs = b[0]
    if as_val == 0 and bs == 1 { ret 1 }
    if as_val == 1 and bs == 0 { ret 0 - 1 }
    let mc = bn_abs_cmp(a, b)
    if as_val == 1 { ret 0 - mc }
    ret mc
}

;; Internal: add magnitudes. Both must be non-negative limb arrays.
fn _bn_add_mag(a: &i64, b: &i64) -> &i64 {
    let alen = a[1]
    let blen = b[1]
    let maxlen = alen
    if blen > maxlen { maxlen = blen }
    let result = _bn_alloc(maxlen + 2)
    let rd: &i64 = result[3]
    let ad: &i64 = a[3]
    let bd: &i64 = b[3]
    let carry = 0
    let i = 0
    loop i < maxlen {
        let av = 0
        if i < alen { av = ad[i] }
        let bv = 0
        if i < blen { bv = bd[i] }
        let sum = av + bv + carry
        if sum >= BN_BASE {
            rd[i] = sum - BN_BASE
            carry = 1
        } else {
            rd[i] = sum
            carry = 0
        }
        i = i + 1
    }
    if carry > 0 {
        rd[maxlen] = carry
        result[1] = maxlen + 1
    } else {
        result[1] = maxlen
    }
    ret result
}

;; Internal: subtract magnitudes. |a| must be >= |b|.
fn _bn_sub_mag(a: &i64, b: &i64) -> &i64 {
    let alen = a[1]
    let blen = b[1]
    let result = _bn_alloc(alen + 1)
    let rd: &i64 = result[3]
    let ad: &i64 = a[3]
    let bd: &i64 = b[3]
    let borrow = 0
    let i = 0
    loop i < alen {
        let av = ad[i]
        let bv = 0
        if i < blen { bv = bd[i] }
        let diff = av - bv - borrow
        if diff < 0 {
            diff = diff + BN_BASE
            borrow = 1
        } else {
            borrow = 0
        }
        rd[i] = diff
        i = i + 1
    }
    ; Trim leading zeros
    let rlen = alen
    loop rlen > 1 and rd[rlen - 1] == 0 { rlen = rlen - 1 }
    result[1] = rlen
    ret result
}

;; Add two BigNums.
fn bn_add(a: &i64, b: &i64) -> &i64 {
    let as_val = a[0]
    let bs = b[0]
    if as_val == bs {
        ; Same sign: add magnitudes, keep sign
        let r = _bn_add_mag(a, b)
        r[0] = as_val
        ret r
    }
    ; Different signs: subtract smaller from larger
    let cmp = bn_abs_cmp(a, b)
    if cmp == 0 { ret bn_new(0) }
    if cmp > 0 {
        let r = _bn_sub_mag(a, b)
        r[0] = as_val
        ret r
    }
    let r = _bn_sub_mag(b, a)
    r[0] = bs
    ret r
}

;; Subtract: a - b.
fn bn_sub(a: &i64, b: &i64) -> &i64 {
    ; Negate b and add
    let neg_b = _bn_alloc(b[1] + 1)
    let nd: &i64 = neg_b[3]
    let bd: &i64 = b[3]
    let i = 0
    loop i < b[1] {
        nd[i] = bd[i]
        i = i + 1
    }
    neg_b[1] = b[1]
    neg_b[0] = 1 - b[0]
    ret bn_add(a, neg_b)
}

;; Multiply two BigNums. Grade-school algorithm.
fn bn_mul(a: &i64, b: &i64) -> &i64 {
    let alen = a[1]
    let blen = b[1]
    let rlen = alen + blen
    let result = _bn_alloc(rlen + 1)
    let rd: &i64 = result[3]
    let ad: &i64 = a[3]
    let bd: &i64 = b[3]

    let i = 0
    loop i < alen {
        let carry = 0
        let j = 0
        loop j < blen {
            let prod = ad[i] * bd[j] + rd[i + j] + carry
            rd[i + j] = prod - (prod / BN_BASE) * BN_BASE
            carry = prod / BN_BASE
            j = j + 1
        }
        if carry > 0 { rd[i + blen] = rd[i + blen] + carry }
        i = i + 1
    }

    ; Find actual length
    let actual = rlen
    loop actual > 1 and rd[actual - 1] == 0 { actual = actual - 1 }
    result[1] = actual
    ; Sign: different signs = negative
    if a[0] != b[0] { result[0] = 1 }
    ret result
}

;; Check if BigNum is zero.
fn bn_is_zero(a: &i64) -> i64 {
    if a[1] == 1 {
        let d: &i64 = a[3]
        if d[0] == 0 { ret 1 }
    }
    ret 0
}

;; Negate: return new BigNum with flipped sign.
fn bn_negate(a: &i64) -> &i64 {
    let r = _bn_alloc(a[1] + 1)
    let rd: &i64 = r[3]
    let ad: &i64 = a[3]
    let i = 0
    loop i < a[1] {
        rd[i] = ad[i]
        i = i + 1
    }
    r[1] = a[1]
    r[0] = 1 - a[0]
    if bn_is_zero(a) == 1 { r[0] = 0 }
    ret r
}

;; Convert BigNum to decimal string. Returns length written.
fn bn_to_str(a: &i64, out: &i8) -> i64 {
    let pos = 0
    if a[0] == 1 {
        if bn_is_zero(a) == 0 {
            poke_byte(out, 0, 45)  ; '-'
            pos = 1
        }
    }
    let digits: &i64 = a[3]
    let nlen = a[1]

    ; Write most significant limb without leading zeros
    let top = digits[nlen - 1]
    let tmp: &i8 = alloc_pages(1)
    let tpos = 0
    if top == 0 {
        poke_byte(out, pos, 48)
        ret pos + 1
    }
    ; Convert top limb
    let t = top
    loop t > 0 {
        poke_byte(tmp, tpos, 48 + (t - (t / 10) * 10))
        t = t / 10
        tpos = tpos + 1
    }
    ; Reverse
    let ri = tpos - 1
    loop ri >= 0 {
        poke_byte(out, pos, tmp[ri])
        pos = pos + 1
        ri = ri - 1
    }

    ; Write remaining limbs with zero padding (9 digits each)
    let li = nlen - 2
    loop li >= 0 {
        let limb = digits[li]
        ; Write 9 digits, zero-padded
        let di = 8
        loop di >= 0 {
            poke_byte(out, pos + di, 48 + (limb - (limb / 10) * 10))
            limb = limb / 10
            di = di - 1
        }
        pos = pos + 9
        li = li - 1
    }
    ret pos
}

;; Convert BigNum to i64 (truncates if too large).
fn bn_to_i64(a: &i64) -> i64 {
    let digits: &i64 = a[3]
    let nlen = a[1]
    let result = 0
    let mult = 1
    let i = 0
    loop i < nlen and i < 3 {
        result = result + digits[i] * mult
        mult = mult * BN_BASE
        i = i + 1
    }
    if a[0] == 1 { result = 0 - result }
    ret result
}
