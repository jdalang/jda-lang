; =============================================================================
; jda::hashmap -- Hash Map (i64 -> i64)
; =============================================================================
; Open addressing with linear probing. Power-of-2 capacity.
; No external dependencies.
;
; Memory layout per map (&i64):
;   [0] capacity   (always power of 2)
;   [1] size       (occupied entries)
;   [2] keys_ptr   (&i64)
;   [3] vals_ptr   (&i64)
;   [4] state_ptr  (&i64 — 0=empty, 1=occupied, 2=tombstone)
;
; Functions:
;   map_new(cap)              -> &i64   create map
;   map_of2(k1,v1,k2,v2)     -> &i64   literal {k1:v1, k2:v2}
;   map_of3(k1,v1,k2,v2,k3,v3) -> &i64 literal {k1:v1, k2:v2, k3:v3}
;   map_put(m, key, val)                insert or update
;   map_get(m, key)           -> i64    lookup (0 if missing)
;   map_has(m, key)           -> i64    1 if exists, 0 otherwise
;   map_del(m, key)           -> i64    1 if deleted, 0 if not found
;   map_len(m)                -> i64    entry count
;   map_clear(m)                        remove all entries
;   map_keys(m, out)          -> i64    copy keys to out, return count
;   map_values(m, out)        -> i64    copy values to out, return count
;   map_copy(m)               -> &i64   shallow copy
;   map_merge(dst, src)                 merge src into dst
;   map_get_or(m, key, def)   -> i64    lookup with default
;   map_print(m)                        print as {k1: v1, k2: v2}
;   map_println(m)                      print + newline
;   str_hash(s, len)          -> i64    djb2 hash for byte buffers
;   map_puts(m, key, klen, val)         string-keyed insert
;   map_gets(m, key, klen)    -> i64    string-keyed lookup
;   map_hass(m, key, klen)    -> i64    string-keyed exists
; =============================================================================

;; Hash an i64 key (Knuth multiplicative hash).
fn hash_i64(key: i64) -> i64 {
    ret key * 2654435769
}

;; Hash a byte buffer (djb2).
fn str_hash(s: &i8, len: i64) -> i64 {
    let h = 5381
    let i = 0
    loop i < len {
        let c = s[i]
        h = h * 33 + c
        i = i + 1
    }
    ret h
}

;; Round up to next power of 2. Minimum 16.
fn map_round_pow2(n: i64) -> i64 {
    let v = 16
    loop v < n {
        v = v * 2
    }
    ret v
}

;; Pages needed for n i64 elements (8 bytes each, 4096 per page).
fn map_pages_for(n: i64) -> i64 {
    let bytes = n * 8
    let pages = bytes / 4096
    let rem = bytes - pages * 4096
    if rem > 0 { pages = pages + 1 }
    if pages == 0 { pages = 1 }
    ret pages
}

;; Create a new hash map with given capacity.
fn map_new(cap: i64) -> &i64 {
    let c = map_round_pow2(cap)
    let hdr: &i64 = alloc_pages(1)
    let pg = map_pages_for(c)
    let keys: &i64 = alloc_pages(pg)
    let vals: &i64 = alloc_pages(pg)
    let state: &i64 = alloc_pages(pg)
    ; Zero-init state array (alloc_pages returns zeroed memory from mmap)
    hdr[0] = c
    hdr[1] = 0
    hdr[2] = keys
    hdr[3] = vals
    hdr[4] = state
    ret hdr
}

;; Get number of entries.
fn map_len(m: &i64) -> i64 {
    ret m[1]
}

;; Internal: find slot for key. Returns index.
;; If key is found (state=1, keys match), returns that index.
;; If key is not found, returns the first empty or tombstone slot.
fn map_find_slot(m: &i64, key: i64) -> i64 {
    let cap = m[0]
    let keys: &i64 = m[2]
    let state: &i64 = m[4]
    let mask = cap - 1
    let h = hash_i64(key)
    let idx = h and mask
    let first_tomb = 0 - 1
    let i = 0
    loop i < cap {
        let s = state[idx]
        if s == 0 {
            ; Empty slot — key not in map
            if first_tomb >= 0 { ret first_tomb }
            ret idx
        }
        if s == 1 {
            if keys[idx] == key { ret idx }
        }
        if s == 2 {
            if first_tomb < 0 { first_tomb = idx }
        }
        let next = idx + 1
        idx = next and mask
        i = i + 1
    }
    ; Table full (shouldn't happen with rehash)
    if first_tomb >= 0 { ret first_tomb }
    ret 0
}

;; Internal: rehash to double capacity.
fn map_rehash(m: &i64) {
    let old_cap = m[0]
    let old_keys: &i64 = m[2]
    let old_vals: &i64 = m[3]
    let old_state: &i64 = m[4]
    let new_cap = old_cap * 2
    let pg = map_pages_for(new_cap)
    let new_keys: &i64 = alloc_pages(pg)
    let new_vals: &i64 = alloc_pages(pg)
    let new_state: &i64 = alloc_pages(pg)
    m[0] = new_cap
    m[1] = 0
    m[2] = new_keys
    m[3] = new_vals
    m[4] = new_state
    ; Re-insert all occupied entries
    let i = 0
    loop i < old_cap {
        if old_state[i] == 1 {
            map_put(m, old_keys[i], old_vals[i])
        }
        i = i + 1
    }
}

;; Insert or update a key-value pair.
fn map_put(m: &i64, key: i64, val: i64) {
    ; Check load factor: size * 10 > cap * 7 → rehash
    let sz = m[1]
    let cap = m[0]
    let load_num = sz * 10
    let load_den = cap * 7
    if load_num > load_den {
        map_rehash(m)
    }
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    let keys: &i64 = m[2]
    let vals: &i64 = m[3]
    if state[idx] != 1 {
        ; New entry
        m[1] = m[1] + 1
    }
    keys[idx] = key
    vals[idx] = val
    state[idx] = 1
}

;; Get value for key. Returns 0 if not found.
fn map_get(m: &i64, key: i64) -> i64 {
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    if state[idx] == 1 {
        let keys: &i64 = m[2]
        if keys[idx] == key {
            let vals: &i64 = m[3]
            ret vals[idx]
        }
    }
    ret 0
}

;; Check if key exists. Returns 1 or 0.
fn map_has(m: &i64, key: i64) -> i64 {
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    if state[idx] == 1 {
        let keys: &i64 = m[2]
        if keys[idx] == key { ret 1 }
    }
    ret 0
}

;; Delete key. Returns 1 if found and deleted, 0 if not found.
fn map_del(m: &i64, key: i64) -> i64 {
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    if state[idx] == 1 {
        let keys: &i64 = m[2]
        if keys[idx] == key {
            state[idx] = 2
            m[1] = m[1] - 1
            ret 1
        }
    }
    ret 0
}

;; String-keyed insert: hash string, use hash as key.
fn map_puts(m: &i64, key: &i8, klen: i64, val: i64) {
    let h = str_hash(key, klen)
    map_put(m, h, val)
}

;; String-keyed lookup.
fn map_gets(m: &i64, key: &i8, klen: i64) -> i64 {
    let h = str_hash(key, klen)
    ret map_get(m, h)
}

;; String-keyed existence check.
fn map_hass(m: &i64, key: &i8, klen: i64) -> i64 {
    let h = str_hash(key, klen)
    ret map_has(m, h)
}

; --- Literal constructors (pairs of key, value) ---

;; Create map with 1 entry. Usage: map_of1(k1, v1)
fn map_of1(k1: i64, v1: i64) -> &i64 {
    let m = map_new(16)
    map_put(m, k1, v1)
    ret m
}

;; Create map with 2 entries. Usage: map_of2(k1, v1, k2, v2)
fn map_of2(k1: i64, v1: i64, k2: i64, v2: i64) -> &i64 {
    let m = map_new(16)
    map_put(m, k1, v1)
    map_put(m, k2, v2)
    ret m
}

;; Create map with 3 entries. Usage: map_of3(k1, v1, k2, v2, k3, v3)
fn map_of3(k1: i64, v1: i64, k2: i64, v2: i64, k3: i64, v3: i64) -> &i64 {
    let m = map_new(16)
    map_put(m, k1, v1)
    map_put(m, k2, v2)
    map_put(m, k3, v3)
    ret m
}

; --- Utilities ---

;; Lookup with default value.
fn map_get_or(m: &i64, key: i64, def: i64) -> i64 {
    let h = map_has(m, key)
    if h == 1 { ret map_get(m, key) }
    ret def
}

;; Remove all entries (reset size, clear state array).
fn map_clear(m: &i64) {
    let cap = m[0]
    let state: &i64 = m[4]
    let i = 0
    loop i < cap {
        state[i] = 0
        i = i + 1
    }
    m[1] = 0
}

;; Copy all occupied keys into out array. Returns count.
fn map_keys(m: &i64, out: &i64) -> i64 {
    let cap = m[0]
    let keys: &i64 = m[2]
    let state: &i64 = m[4]
    let n = 0
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            out[n] = keys[i]
            n = n + 1
        }
        i = i + 1
    }
    ret n
}

;; Copy all occupied values into out array. Returns count.
fn map_values(m: &i64, out: &i64) -> i64 {
    let cap = m[0]
    let vals: &i64 = m[3]
    let state: &i64 = m[4]
    let n = 0
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            out[n] = vals[i]
            n = n + 1
        }
        i = i + 1
    }
    ret n
}

;; Shallow copy of map.
fn map_copy(m: &i64) -> &i64 {
    let cap = m[0]
    let keys: &i64 = m[2]
    let vals: &i64 = m[3]
    let state: &i64 = m[4]
    let c = map_new(cap)
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            map_put(c, keys[i], vals[i])
        }
        i = i + 1
    }
    ret c
}

;; Merge all entries from src into dst (overwrites on conflict).
fn map_merge(dst: &i64, src: &i64) {
    let cap = src[0]
    let keys: &i64 = src[2]
    let vals: &i64 = src[3]
    let state: &i64 = src[4]
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            map_put(dst, keys[i], vals[i])
        }
        i = i + 1
    }
}

;; Print map as {k1: v1, k2: v2}.
fn map_print(m: &i64) {
    let cap = m[0]
    let keys: &i64 = m[2]
    let vals: &i64 = m[3]
    let state: &i64 = m[4]
    print("{")
    let first = 1
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            if first == 0 { print(", ") }
            let k = keys[i]
            let v = vals[i]
            print("{k}: {v}")
            first = 0
        }
        i = i + 1
    }
    print("}")
}

;; Print map followed by newline.
fn map_println(m: &i64) {
    map_print(m)
    print("\n")
}
