// =============================================================================
// jda::weakref -- Weak References
// =============================================================================
// Weak references that don't prevent deallocation. Since Jda has no GC,
// weak references track liveness via a manual release mechanism.

// Memory layout per WeakRef (&i64):
//   [0] target     (pointer to referenced object)
//   [1] alive      (1=alive, 0=released)
//   [2] id         (unique reference ID)

// Global registry tracks all weak refs for batch operations.

// Functions:
//   weakref_new(target)          -> &i64  create weak reference
//   weakref_deref(wr)            -> i64   get target (0 if released)
//   weakref_alive(wr)            -> i64   1 if still alive
//   weakref_release(wr)                   mark as released
//   weakref_id(wr)               -> i64   get unique ID
//   weakref_registry_new()       -> &i64  create a registry
//   weakref_register(reg, wr)             add to registry
//   weakref_sweep(reg)           -> i64   count and remove dead refs
// =============================================================================

let _wr_next_id = 1

// Create new weak reference to target pointer.
fn weakref_new(target: i64) -> &i64 {
    let wr: &i64 = alloc_pages(1)
    wr[0] = target
    wr[1] = 1
    wr[2] = _wr_next_id
    _wr_next_id = _wr_next_id + 1
    ret wr
}

// Dereference: get target pointer. Returns 0 if released.
fn weakref_deref(wr: &i64) -> i64 {
    if wr[1] == 0 { ret 0 }
    ret wr[0]
}

// Check if reference is still alive.
fn weakref_alive(wr: &i64) -> i64 {
    ret wr[1]
}

// Release the weak reference (mark target as gone).
fn weakref_release(wr: &i64) {
    wr[1] = 0
    wr[0] = 0
}

// Get unique reference ID.
fn weakref_id(wr: &i64) -> i64 {
    ret wr[2]
}

// Registry: tracks a collection of weak references.
// Layout: [0]=count, [1]=capacity, [2]=refs_ptr (&i64 array of WeakRef pointers)
fn weakref_registry_new() -> &i64 {
    let reg: &i64 = alloc_pages(1)
    reg[0] = 0
    reg[1] = 512
    reg[2] = alloc_pages(1)
    ret reg
}

// Register a weak reference in the registry.
fn weakref_register(reg: &i64, wr: &i64) {
    let count = reg[0]
    let refs: &i64 = reg[2]
    refs[count] = wr
    reg[0] = count + 1
}

// Sweep: count dead references and compact the registry.
// Returns number of dead references removed.
fn weakref_sweep(reg: &i64) -> i64 {
    let count = reg[0]
    let refs: &i64 = reg[2]
    let dead = 0
    let write_idx = 0
    let i = 0
    loop i < count {
        let wr: &i64 = refs[i]
        if weakref_alive(wr) == 1 {
            refs[write_idx] = wr
            write_idx = write_idx + 1
        } else {
            dead = dead + 1
        }
        i = i + 1
    }
    reg[0] = write_idx
    ret dead
}
