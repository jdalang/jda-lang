; =============================================================================
; jda::stringio -- In-Memory String I/O
; =============================================================================
; Read/write/seek on an in-memory string buffer. Useful for building strings
; or parsing without file I/O.
;
; Memory layout per StringIO (&i64):
;   [0] buf_ptr    (&i8)
;   [1] len        (current data length)
;   [2] cap        (buffer capacity)
;   [3] pos        (read/write position)
;
; Functions:
;   sio_new(cap)                     -> &i64  create empty StringIO
;   sio_from(src, len)               -> &i64  create from existing string
;   sio_write(sio, data, dlen)       -> i64   write at current pos, return bytes written
;   sio_read(sio, out, n)            -> i64   read n bytes from current pos
;   sio_getline(sio, out, max)       -> i64   read until newline
;   sio_seek(sio, pos)                        set position
;   sio_rewind(sio)                           set position to 0
;   sio_eof(sio)                     -> i64   1 if at end
;   sio_len(sio)                     -> i64   current data length
;   sio_pos(sio)                     -> i64   current position
;   sio_string(sio, out)             -> i64   copy contents to out
;   sio_putc(sio, ch)               -> i64   write single byte
;   sio_getc(sio)                    -> i64   read single byte (-1 at EOF)
; =============================================================================

fn _sio_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

fn _sio_copy(dst: &i8, doff: i64, src: &i8, soff: i64, n: i64) {
    let i = 0
    loop i < n {
        poke_byte(dst, doff + i, src[soff + i])
        i = i + 1
    }
}

;; Create empty StringIO with given capacity.
fn sio_new(cap: i64) -> &i64 {
    let sio: &i64 = alloc_pages(1)
    let pages = cap / 4096 + 1
    let buf: &i8 = alloc_pages(pages)
    sio[0] = buf
    sio[1] = 0
    sio[2] = pages * 4096
    sio[3] = 0
    ret sio
}

;; Create StringIO from existing string.
fn sio_from(src: &i8, len: i64) -> &i64 {
    let sio: &i64 = alloc_pages(1)
    let pages = len / 4096 + 1
    let buf: &i8 = alloc_pages(pages)
    _sio_copy(buf, 0, src, 0, len)
    sio[0] = buf
    sio[1] = len
    sio[2] = pages * 4096
    sio[3] = 0
    ret sio
}

;; Write data at current position. Returns bytes written.
fn sio_write(sio: &i64, data: &i8, dlen: i64) -> i64 {
    let buf: &i8 = sio[0]
    let pos = sio[3]
    let cap = sio[2]
    ; Check capacity
    let needed = pos + dlen
    if needed > cap {
        dlen = cap - pos
        if dlen <= 0 { ret 0 }
    }
    _sio_copy(buf, pos, data, 0, dlen)
    sio[3] = pos + dlen
    if pos + dlen > sio[1] {
        sio[1] = pos + dlen
    }
    ret dlen
}

;; Read n bytes from current position. Returns bytes read.
fn sio_read(sio: &i64, out: &i8, n: i64) -> i64 {
    let buf: &i8 = sio[0]
    let pos = sio[3]
    let avail = sio[1] - pos
    if avail <= 0 { ret 0 }
    if n > avail { n = avail }
    _sio_copy(out, 0, buf, pos, n)
    sio[3] = pos + n
    ret n
}

;; Read until newline or max bytes. Returns bytes read (including newline).
fn sio_getline(sio: &i64, out: &i8, max: i64) -> i64 {
    let buf: &i8 = sio[0]
    let pos = sio[3]
    let len = sio[1]
    let count = 0
    let done = 0
    loop done == 0 and pos < len and count < max {
        let c = _sio_byte_at(buf, pos)
        poke_byte(out, count, c)
        count = count + 1
        pos = pos + 1
        if c == 10 { done = 1 }  ; newline
    }
    sio[3] = pos
    ret count
}

;; Set read/write position.
fn sio_seek(sio: &i64, pos: i64) {
    if pos < 0 { pos = 0 }
    if pos > sio[1] { pos = sio[1] }
    sio[3] = pos
}

;; Reset position to beginning.
fn sio_rewind(sio: &i64) {
    sio[3] = 0
}

;; 1 if at end of data.
fn sio_eof(sio: &i64) -> i64 {
    if sio[3] >= sio[1] { ret 1 }
    ret 0
}

;; Current data length.
fn sio_len(sio: &i64) -> i64 {
    ret sio[1]
}

;; Current read/write position.
fn sio_pos(sio: &i64) -> i64 {
    ret sio[3]
}

;; Copy all contents to out buffer. Returns length.
fn sio_string(sio: &i64, out: &i8) -> i64 {
    let buf: &i8 = sio[0]
    let len = sio[1]
    _sio_copy(out, 0, buf, 0, len)
    ret len
}

;; Write a single byte at current position.
fn sio_putc(sio: &i64, ch: i64) -> i64 {
    let buf: &i8 = sio[0]
    let pos = sio[3]
    if pos >= sio[2] { ret 0 }
    poke_byte(buf, pos, ch)
    sio[3] = pos + 1
    if pos + 1 > sio[1] { sio[1] = pos + 1 }
    ret 1
}

;; Read a single byte at current position. Returns -1 at EOF.
fn sio_getc(sio: &i64) -> i64 {
    let pos = sio[3]
    if pos >= sio[1] { ret 0 - 1 }
    let buf: &i8 = sio[0]
    let c = _sio_byte_at(buf, pos)
    sio[3] = pos + 1
    ret c
}
