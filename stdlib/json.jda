// =============================================================================
// jda::json — Zero-Copy JSON Parser
// =============================================================================
// Parser: string and number spans point INTO the source buffer — the parser
// allocates only its node arena, never copies payload bytes.
// No global state, so it is J-Thread safe as long as each thread parses into
// its own arena.
//
// This is a rewrite of an earlier version written against a dialect this
// compiler does not implement (tagged-union enums with payloads, slices,
// generic Result). The data model is the same idea expressed with what the
// language has: a flat node arena instead of a recursive tagged union, and
// integer node handles instead of references.
//
// Usage:
//   let doc = json_parse(src, len)
//   if doc < 0 { /* parse error */ }
//   let name = json_obj_get(doc, "name", 4)
//   if name >= 0 { print_str(g_json_src + json_str_off(name), json_str_len(name)) }
//   let age = json_obj_get(doc, "age", 3)
//   if age >= 0 { let n = json_num(age) }
//
// Every accessor takes a node handle. -1 means "absent" everywhere, so a
// missing key and a failed parse are the same shape and a caller that forgets
// to check gets -1 rather than garbage.
// =============================================================================

// Node kinds.
const JSON_NULL  = 0
const JSON_BOOL  = 1
const JSON_NUM   = 2
const JSON_STR   = 3
const JSON_ARR   = 4
const JSON_OBJ   = 5

// A node is 6 slots in a flat arena:
//   0 kind
//   1 value      -- bool 0/1, or number
//   2 span_off   -- offset into the source of a string, or of an object key
//   3 span_len
//   4 first      -- first child (array element or object member), else -1
//   5 next       -- next sibling, else -1
const JSON_NODE_SLOTS = 6

let g_json_nodes: &i64 = 0
let g_json_cnt = 0
let g_json_cap = 0
let g_json_src: &i8 = 0
let g_json_len = 0
let g_json_pos = 0
let g_json_bad = 0

fn json_reset(src: &i8, len: i64) {
    if g_json_nodes == 0 {
        // 8192 nodes is 384KB; a manifest or an LSP message is far below that.
        g_json_nodes = alloc_pages(96)
        g_json_cap = 8192
    }
    g_json_cnt = 0
    g_json_src = src
    g_json_len = len
    g_json_pos = 0
    g_json_bad = 0
    ret 0
}

fn json_node_new(kind: i64) -> i64 {
    if g_json_cnt >= g_json_cap {
        g_json_bad = 1
        ret 0 - 1
    }
    let n = g_json_cnt
    let b = n * JSON_NODE_SLOTS
    g_json_nodes[b + 0] = kind
    g_json_nodes[b + 1] = 0
    g_json_nodes[b + 2] = 0
    g_json_nodes[b + 3] = 0
    g_json_nodes[b + 4] = 0 - 1
    g_json_nodes[b + 5] = 0 - 1
    g_json_cnt = n + 1
    ret n
}

// -- accessors ---------------------------------------------------------------

fn json_kind(n: i64) -> i64 {
    if n < 0 { ret 0 - 1 }
    ret g_json_nodes[n * JSON_NODE_SLOTS + 0]
}

fn json_num(n: i64) -> i64 {
    if n < 0 { ret 0 }
    ret g_json_nodes[n * JSON_NODE_SLOTS + 1]
}

fn json_bool(n: i64) -> i64 {
    if n < 0 { ret 0 }
    ret g_json_nodes[n * JSON_NODE_SLOTS + 1]
}

fn json_str_off(n: i64) -> i64 {
    if n < 0 { ret 0 }
    ret g_json_nodes[n * JSON_NODE_SLOTS + 2]
}

fn json_str_len(n: i64) -> i64 {
    if n < 0 { ret 0 }
    ret g_json_nodes[n * JSON_NODE_SLOTS + 3]
}

fn json_first(n: i64) -> i64 {
    if n < 0 { ret 0 - 1 }
    ret g_json_nodes[n * JSON_NODE_SLOTS + 4]
}

fn json_next(n: i64) -> i64 {
    if n < 0 { ret 0 - 1 }
    ret g_json_nodes[n * JSON_NODE_SLOTS + 5]
}

// Number of elements in an array, or members in an object.
fn json_len(n: i64) -> i64 {
    let c = 0
    let k = json_first(n)
    loop k >= 0 {
        c = c + 1
        k = json_next(k)
    }
    ret c
}

// nth element of an array (0-based), or -1.
fn json_at(n: i64, idx: i64) -> i64 {
    let i = 0
    let k = json_first(n)
    loop k >= 0 {
        if i == idx { ret k }
        i = i + 1
        k = json_next(k)
    }
    ret 0 - 1
}

fn json_span_eq(off: i64, len: i64, key: &i8, klen: i64) -> i64 {
    if len != klen { ret 0 }
    let i = 0
    loop i < len {
        if g_json_src[off + i] != key[i] { ret 0 }
        i = i + 1
    }
    ret 1
}

// Member of an object by key, or -1. Object members carry their key in the
// span slots, so the value node and its key are the same node.
fn json_obj_get(n: i64, key: &i8, klen: i64) -> i64 {
    if json_kind(n) != JSON_OBJ { ret 0 - 1 }
    let k = json_first(n)
    loop k >= 0 {
        if json_span_eq(json_str_off(k), json_str_len(k), key, klen) == 1 { ret k }
        k = json_next(k)
    }
    ret 0 - 1
}

// -- scanner -----------------------------------------------------------------

fn json_skip_ws() {
    loop g_json_pos < g_json_len {
        let c = g_json_src[g_json_pos]
        if c == 32 or c == 9 or c == 10 or c == 13 {
            g_json_pos = g_json_pos + 1
        } else {
            ret 0
        }
    }
    ret 0
}

fn json_peek() -> i64 {
    if g_json_pos >= g_json_len { ret 0 - 1 }
    ret g_json_src[g_json_pos]
}

fn json_lit(text: &i8, len: i64) -> i64 {
    if g_json_pos + len > g_json_len { ret 0 }
    let i = 0
    loop i < len {
        if g_json_src[g_json_pos + i] != text[i] { ret 0 }
        i = i + 1
    }
    g_json_pos = g_json_pos + len
    ret 1
}

// A string, with the span covering the contents between the quotes. Escapes are
// left as written: this is a zero-copy parser, so it reports where the bytes
// are rather than producing a decoded copy.
fn json_parse_string_span(out_off: &i64, out_len: &i64) -> i64 {
    if json_peek() != 34 { ret 0 }
    g_json_pos = g_json_pos + 1
    let start = g_json_pos
    loop g_json_pos < g_json_len {
        let c = g_json_src[g_json_pos]
        if c == 92 {
            g_json_pos = g_json_pos + 2
        } else {
            if c == 34 {
                out_off[0] = start
                out_len[0] = g_json_pos - start
                g_json_pos = g_json_pos + 1
                ret 1
            }
            g_json_pos = g_json_pos + 1
        }
    }
    ret 0
}

// Integers only. A fractional part parses and is skipped, with the integer part
// kept, because the language has no f64 path through this arena.
fn json_parse_number() -> i64 {
    let neg = 0
    if json_peek() == 45 {
        neg = 1
        g_json_pos = g_json_pos + 1
    }
    let v = 0
    let any = 0
    loop g_json_pos < g_json_len {
        let c = g_json_src[g_json_pos]
        if c >= 48 and c <= 57 {
            v = v * 10 + (c - 48)
            any = 1
            g_json_pos = g_json_pos + 1
        } else {
            g_json_pos = g_json_pos
            if c == 46 {
                g_json_pos = g_json_pos + 1
            } else {
                if any == 0 { g_json_bad = 1 }
                if neg == 1 { ret 0 - v }
                ret v
            }
        }
    }
    if any == 0 { g_json_bad = 1 }
    if neg == 1 { ret 0 - v }
    ret v
}

fn json_parse_value() -> i64 {
    json_skip_ws()
    if g_json_bad == 1 { ret 0 - 1 }
    let c = json_peek()

    if c == 110 {
        if json_lit("null", 4) == 1 { ret json_node_new(JSON_NULL) }
        g_json_bad = 1
        ret 0 - 1
    }
    if c == 116 {
        if json_lit("true", 4) == 1 {
            let n = json_node_new(JSON_BOOL)
            if n >= 0 { g_json_nodes[n * JSON_NODE_SLOTS + 1] = 1 }
            ret n
        }
        g_json_bad = 1
        ret 0 - 1
    }
    if c == 102 {
        if json_lit("false", 5) == 1 { ret json_node_new(JSON_BOOL) }
        g_json_bad = 1
        ret 0 - 1
    }
    if c == 34 {
        let off = 0
        let len = 0
        if json_parse_string_span(&off, &len) == 0 {
            g_json_bad = 1
            ret 0 - 1
        }
        let n = json_node_new(JSON_STR)
        if n >= 0 {
            g_json_nodes[n * JSON_NODE_SLOTS + 2] = off
            g_json_nodes[n * JSON_NODE_SLOTS + 3] = len
        }
        ret n
    }
    if c == 91 { ret json_parse_array() }
    if c == 123 { ret json_parse_object() }

    if c == 45 or (c >= 48 and c <= 57) {
        let v = json_parse_number()
        let n = json_node_new(JSON_NUM)
        if n >= 0 { g_json_nodes[n * JSON_NODE_SLOTS + 1] = v }
        ret n
    }

    g_json_bad = 1
    ret 0 - 1
}

fn json_parse_array() -> i64 {
    g_json_pos = g_json_pos + 1
    let arr = json_node_new(JSON_ARR)
    if arr < 0 { ret 0 - 1 }
    let last = 0 - 1
    json_skip_ws()
    if json_peek() == 93 {
        g_json_pos = g_json_pos + 1
        ret arr
    }
    let more = 1
    loop more == 1 {
        let el = json_parse_value()
        if g_json_bad == 1 { ret 0 - 1 }
        if last < 0 {
            g_json_nodes[arr * JSON_NODE_SLOTS + 4] = el
        } else {
            g_json_nodes[last * JSON_NODE_SLOTS + 5] = el
        }
        last = el
        json_skip_ws()
        let c = json_peek()
        if c == 44 {
            g_json_pos = g_json_pos + 1
        } else {
            if c == 93 {
                g_json_pos = g_json_pos + 1
                more = 0
            } else {
                g_json_bad = 1
                ret 0 - 1
            }
        }
    }
    ret arr
}

fn json_parse_object() -> i64 {
    g_json_pos = g_json_pos + 1
    let obj = json_node_new(JSON_OBJ)
    if obj < 0 { ret 0 - 1 }
    let last = 0 - 1
    json_skip_ws()
    if json_peek() == 125 {
        g_json_pos = g_json_pos + 1
        ret obj
    }
    let more = 1
    loop more == 1 {
        json_skip_ws()
        let koff = 0
        let klen = 0
        if json_parse_string_span(&koff, &klen) == 0 {
            g_json_bad = 1
            ret 0 - 1
        }
        json_skip_ws()
        if json_peek() != 58 {
            g_json_bad = 1
            ret 0 - 1
        }
        g_json_pos = g_json_pos + 1
        let val = json_parse_value()
        if g_json_bad == 1 { ret 0 - 1 }
        // The member's key lives in the value node's span slots, so a member is
        // one node rather than a pair node plus a value node.
        if val >= 0 {
            if json_kind(val) == JSON_STR {
                // A string value would otherwise want the same slots, so it is
                // re-parented: the key goes on a wrapper whose only child is
                // the string.
                let w = json_node_new(JSON_STR)
                if w >= 0 {
                    g_json_nodes[w * JSON_NODE_SLOTS + 2] = koff
                    g_json_nodes[w * JSON_NODE_SLOTS + 3] = klen
                    g_json_nodes[w * JSON_NODE_SLOTS + 4] = val
                    g_json_nodes[w * JSON_NODE_SLOTS + 1] = 1
                }
                val = w
            } else {
                g_json_nodes[val * JSON_NODE_SLOTS + 2] = koff
                g_json_nodes[val * JSON_NODE_SLOTS + 3] = klen
            }
        }
        if last < 0 {
            g_json_nodes[obj * JSON_NODE_SLOTS + 4] = val
        } else {
            g_json_nodes[last * JSON_NODE_SLOTS + 5] = val
        }
        last = val
        json_skip_ws()
        let c = json_peek()
        if c == 44 {
            g_json_pos = g_json_pos + 1
        } else {
            if c == 125 {
                g_json_pos = g_json_pos + 1
                more = 0
            } else {
                g_json_bad = 1
                ret 0 - 1
            }
        }
    }
    ret obj
}

// Parse a document. Returns the root node handle, or -1 on any error.
fn json_parse(src: &i8, len: i64) -> i64 {
    json_reset(src, len)
    let root = json_parse_value()
    if g_json_bad == 1 { ret 0 - 1 }
    ret root
}

// The text of a string member. For a member whose value is a string, the value
// hangs off the wrapper as its first child; for a bare string node the span is
// the text itself.
fn json_str_value_off(n: i64) -> i64 {
    if json_kind(n) != JSON_STR { ret 0 }
    let c = json_first(n)
    if c >= 0 { ret json_str_off(c) }
    ret json_str_off(n)
}

fn json_str_value_len(n: i64) -> i64 {
    if json_kind(n) != JSON_STR { ret 0 }
    let c = json_first(n)
    if c >= 0 { ret json_str_len(c) }
    ret json_str_len(n)
}
