; =============================================================================
; jda::platform -- Platform Detection and System Information
; =============================================================================
; Query operating system, architecture, and kernel version via uname(2).
; Linux x86-64 only (Jda's target platform).
;
; Functions:
;   platform_system(out, max)          -> i64  OS name ("Linux")
;   platform_release(out, max)         -> i64  kernel version string
;   platform_machine(out, max)         -> i64  architecture ("x86_64")
;   platform_node(out, max)            -> i64  hostname
;   platform_info(out, max)            -> i64  combined "Linux x86_64 <release>"
;   platform_is_x86_64()              -> i64  always 1
;   platform_page_size()              -> i64  4096
; =============================================================================

;; Internal: uname syscall wrapper (syscall 63).
;; struct utsname: 5 fields of 65 bytes each = 325 bytes total.
;; [0..64] = sysname, [65..129] = nodename, [130..194] = release,
;; [195..259] = version, [260..324] = machine
fn _platform_uname(buf: &i8) -> i64 {
    ret syscall(63, buf, 0, 0)
}

;; Internal byte reader helper.
fn _plat_byte_at(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

;; Internal: copy string from utsname field to output.
fn _plat_copy_field(dst: &i8, src: &i8, offset: i64, max: i64) -> i64 {
    let i = 0
    let running = 1
    loop running == 1 {
        if i >= max { running = 0 }
        if running == 1 {
            let b = _plat_byte_at(src, offset + i)
            if b == 0 { running = 0 }
            if running == 1 {
                poke_byte(dst, i, b)
                i = i + 1
            }
        }
    }
    ret i
}

;; Internal: copy literal bytes.
fn _plat_copy_lit(dst: &i8, doff: i64, src: &i8, len: i64) -> i64 {
    let i = 0
    loop i < len {
        poke_byte(dst, doff + i, src[i])
        i = i + 1
    }
    ret doff + len
}

;; Get OS name. Returns length written.
fn platform_system(out: &i8, max: i64) -> i64 {
    let buf: &i8 = alloc_pages(1)
    let rc = _platform_uname(buf)
    if rc < 0 { ret -1 }
    ret _plat_copy_field(out, buf, 0, max)
}

;; Get kernel release string. Returns length written.
fn platform_release(out: &i8, max: i64) -> i64 {
    let buf: &i8 = alloc_pages(1)
    let rc = _platform_uname(buf)
    if rc < 0 { ret -1 }
    ret _plat_copy_field(out, buf, 130, max)
}

;; Get machine architecture. Returns length written.
fn platform_machine(out: &i8, max: i64) -> i64 {
    let buf: &i8 = alloc_pages(1)
    let rc = _platform_uname(buf)
    if rc < 0 { ret -1 }
    ret _plat_copy_field(out, buf, 260, max)
}

;; Get hostname. Returns length written.
fn platform_node(out: &i8, max: i64) -> i64 {
    let buf: &i8 = alloc_pages(1)
    let rc = _platform_uname(buf)
    if rc < 0 { ret -1 }
    ret _plat_copy_field(out, buf, 65, max)
}

;; Get combined platform info: "Linux x86_64 <release>". Returns length.
fn platform_info(out: &i8, max: i64) -> i64 {
    let buf: &i8 = alloc_pages(1)
    let rc = _platform_uname(buf)
    if rc < 0 { ret -1 }
    let pos = _plat_copy_field(out, buf, 0, max)
    poke_byte(out, pos, 32)
    pos = pos + 1
    let mlen = _plat_copy_field(out, buf, 260, max)
    let i = 0
    loop i < mlen {
        let b = _plat_byte_at(out, i)
        i = i + 1
    }
    pos = pos + mlen
    poke_byte(out, pos, 32)
    pos = pos + 1
    let rlen = _plat_copy_field(out, buf, 130, max)
    pos = pos + rlen
    ret pos
}

;; Check if platform is x86_64. Always returns 1 (Jda only targets x86-64).
fn platform_is_x86_64() -> i64 {
    ret 1
}

;; Get system page size. Always 4096 on Linux x86-64.
fn platform_page_size() -> i64 {
    ret 4096
}
