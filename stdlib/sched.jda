; =============================================================================
; jda::sched -- Simple Task Scheduler (Min-Heap)
; =============================================================================
; Priority queue based task scheduler. Tasks are ordered by time using an
; array-based min-heap. Each task has a time and an id.
;
; Memory layout per SchedHandle (&i64):
;   [0] count       (number of tasks)
;   [1] times       (&i64 — task times, heap-ordered)
;   [2] ids         (&i64 — task ids, parallel to times)
;
; Functions:
;   sched_new()              -> &i64  create scheduler
;   sched_enter(h, time, id)          add task
;   sched_cancel(h, id)     -> i64   cancel task, 1 if found
;   sched_next(h)           -> i64   id of next task (-1 if empty)
;   sched_next_time(h)      -> i64   time of next task
;   sched_run(h, now)       -> i64   run next if ready, return id (-1 if none)
;   sched_empty(h)          -> i64   1 if empty
;   sched_count(h)          -> i64   number of tasks
; =============================================================================

;; Create a new scheduler.
fn sched_new() -> &i64 {
    let h: &i64 = alloc_pages(1)
    let times: &i64 = alloc_pages(1)
    let ids: &i64 = alloc_pages(1)
    h[0] = 0
    h[1] = times
    h[2] = ids
    ret h
}

;; Internal: swap two entries in the heap.
fn _sched_swap(times: &i64, ids: &i64, a: i64, b: i64) -> i64 {
    let tt = times[a]
    let ti = ids[a]
    times[a] = times[b]
    ids[a] = ids[b]
    times[b] = tt
    ids[b] = ti
    ret 0
}

;; Internal: sift up from index i.
fn _sched_sift_up(times: &i64, ids: &i64, i: i64) -> i64 {
    let cur = i
    let running = 1
    loop running == 1 {
        if cur <= 0 { running = 0 }
        if running == 1 {
            let par = cur - 1
            par = par / 2
            if times[cur] < times[par] {
                let dummy = _sched_swap(times, ids, cur, par)
                cur = par
            } else {
                running = 0
            }
        }
    }
    ret 0
}

;; Internal: sift down from index i, with count elements.
fn _sched_sift_down(times: &i64, ids: &i64, i: i64, count: i64) -> i64 {
    let cur = i
    let running = 1
    loop running == 1 {
        let left = cur * 2 + 1
        let right = cur * 2 + 2
        let smallest = cur
        if left < count {
            if times[left] < times[smallest] { smallest = left }
        }
        if right < count {
            if times[right] < times[smallest] { smallest = right }
        }
        if smallest != cur {
            let dummy = _sched_swap(times, ids, cur, smallest)
            cur = smallest
        } else {
            running = 0
        }
    }
    ret 0
}

;; Add a task to the scheduler.
fn sched_enter(h: &i64, time: i64, id: i64) -> i64 {
    let count = h[0]
    let times: &i64 = h[1]
    let ids: &i64 = h[2]
    times[count] = time
    ids[count] = id
    count = count + 1
    h[0] = count
    let idx = count - 1
    let dummy = _sched_sift_up(times, ids, idx)
    ret 0
}

;; Cancel a task by id. Returns 1 if found and removed.
fn sched_cancel(h: &i64, id: i64) -> i64 {
    let count = h[0]
    let times: &i64 = h[1]
    let ids: &i64 = h[2]
    let i = 0
    loop i < count {
        if ids[i] == id {
            ; Move last element to this position
            let last = count - 1
            times[i] = times[last]
            ids[i] = ids[last]
            h[0] = last
            if last > 0 and i < last {
                let dummy = _sched_sift_down(times, ids, i, last)
                let dummy2 = _sched_sift_up(times, ids, i)
            }
            ret 1
        }
        i = i + 1
    }
    ret 0
}

;; Return id of the next (earliest) task, or -1 if empty.
fn sched_next(h: &i64) -> i64 {
    let count = h[0]
    if count == 0 { ret 0 - 1 }
    let ids: &i64 = h[2]
    ret ids[0]
}

;; Return time of the next (earliest) task.
fn sched_next_time(h: &i64) -> i64 {
    let count = h[0]
    if count == 0 { ret 0 - 1 }
    let times: &i64 = h[1]
    ret times[0]
}

;; Internal: remove the root element from the heap.
fn _sched_pop(h: &i64) -> i64 {
    let count = h[0]
    let times: &i64 = h[1]
    let ids: &i64 = h[2]
    let id = ids[0]
    let last = count - 1
    times[0] = times[last]
    ids[0] = ids[last]
    h[0] = last
    if last > 0 {
        let dummy = _sched_sift_down(times, ids, 0, last)
    }
    ret id
}

;; Run the next task if its time <= now. Returns task id or -1.
fn sched_run(h: &i64, now: i64) -> i64 {
    let count = h[0]
    if count == 0 { ret 0 - 1 }
    let times: &i64 = h[1]
    if times[0] > now { ret 0 - 1 }
    let id = _sched_pop(h)
    ret id
}

;; Return 1 if the scheduler has no tasks.
fn sched_empty(h: &i64) -> i64 {
    if h[0] == 0 { ret 1 }
    ret 0
}

;; Return the number of tasks.
fn sched_count(h: &i64) -> i64 {
    ret h[0]
}
