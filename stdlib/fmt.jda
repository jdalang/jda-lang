; =============================================================================
; jda::fmt -- Minimal String Formatting
; =============================================================================
; Integer-to-string conversion and basic string utilities.
;
; Functions:
;   fmt_i64(buf, val) -> length written
;   fmt_hex(buf, val) -> length written
;   str_len(s) -> length
;   str_eq(a, b) -> 1 if equal, 0 otherwise
;   str_copy(dst, src, len) -> len
;   mem_set(dst, val, len)
;   eprint_str(s, len) -- write to stderr
;   print_str(s, len) -- write to stdout
; =============================================================================

fn fmt_i64(buf: &i8, val: i64) -> i64 {
    let v = val
    let neg = 0
    if v < 0 {
        neg = 1
        v = 0 - v
    }
    if v == 0 {
        buf[0] = 48
        ret 1
    }
    ; Write digits backwards starting at position 20
    let pos = 20
    let len = 0
    loop v > 0 {
        pos = pos - 1
        let digit = v - (v / 10) * 10
        buf[pos] = digit + 48
        v = v / 10
        len = len + 1
    }
    if neg == 1 {
        pos = pos - 1
        buf[pos] = 45
        len = len + 1
    }
    ; Shift to start of buffer
    let i = 0
    loop i < len {
        let src_pos = pos + i
        let ch = buf[src_pos]
        buf[i] = ch
        i = i + 1
    }
    ret len
}

fn fmt_hex(buf: &i8, val: i64) -> i64 {
    let v = val
    if v == 0 {
        buf[0] = 48
        buf[1] = 120
        buf[2] = 48
        ret 3
    }
    ; Write "0x" prefix
    buf[0] = 48
    buf[1] = 120
    ; Write hex digits backwards starting at position 20
    let pos = 20
    let len = 0
    loop v > 0 {
        pos = pos - 1
        let nibble = v - (v / 16) * 16
        if nibble < 10 {
            buf[pos] = nibble + 48
        } else {
            buf[pos] = nibble + 87
        }
        v = v / 16
        len = len + 1
    }
    ; Shift to position 2 (after "0x")
    let i = 0
    loop i < len {
        let src_pos = pos + i
        let ch = buf[src_pos]
        buf[2 + i] = ch
        i = i + 1
    }
    ret len + 2
}

fn str_len(s: &i8) -> i64 {
    let i = 0
    loop s[i] != 0 {
        i = i + 1
    }
    ret i
}

fn str_eq(a: &i8, b: &i8) -> i64 {
    let i = 0
    loop a[i] != 0 {
        if a[i] != b[i] { ret 0 }
        i = i + 1
    }
    if b[i] != 0 { ret 0 }
    ret 1
}

fn str_copy(dst: &i8, src: &i8, len: i64) -> i64 {
    let i = 0
    loop i < len {
        dst[i] = src[i]
        i = i + 1
    }
    ret len
}

fn mem_set(dst: &i8, val: i64, len: i64) {
    let i = 0
    loop i < len {
        dst[i] = val
        i = i + 1
    }
}

fn eprint_str(s: &i8, len: i64) {
    syscall(1, 2, s, len)
}

fn print_str(s: &i8, len: i64) {
    syscall(1, 1, s, len)
}
