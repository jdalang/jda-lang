; =============================================================================
; jda::vec -- Dynamic Array (Vec<i64>)
; =============================================================================
; Growable array of i64 values. Doubles capacity on overflow.
; No external dependencies.
;
; Memory layout per vec (&i64):
;   [0] length     (number of elements)
;   [1] capacity   (allocated slots)
;   [2] data_ptr   (&i64 — the backing array)
;
; Functions:
;   vec_new(cap)              -> &i64   create vec
;   vec_push(v, val)                    append element
;   vec_pop(v)                -> i64    remove & return last
;   vec_get(v, idx)           -> i64    get element at index
;   vec_set(v, idx, val)                set element at index
;   vec_len(v)                -> i64    length
;   vec_cap(v)                -> i64    capacity
;   vec_clear(v)                        reset length to 0
;   vec_last(v)               -> i64    get last element
;   vec_contains(v, val)      -> i64    1 if found, 0 otherwise
;   vec_remove(v, idx)        -> i64    remove at index, shift left
; =============================================================================

;; Pages needed for n i64 elements.
fn vec_pages_for(n: i64) -> i64 {
    let bytes = n * 8
    let pages = bytes / 4096
    let rem = bytes - pages * 4096
    if rem > 0 { pages = pages + 1 }
    if pages == 0 { pages = 1 }
    ret pages
}

;; Create a new vec with given initial capacity (minimum 16).
fn vec_new(cap: i64) -> &i64 {
    let c = cap
    if c < 16 { c = 16 }
    let hdr: &i64 = alloc_pages(1)
    let pg = vec_pages_for(c)
    let data: &i64 = alloc_pages(pg)
    hdr[0] = 0
    hdr[1] = c
    hdr[2] = data
    ret hdr
}

;; Get length.
fn vec_len(v: &i64) -> i64 {
    ret v[0]
}

;; Get capacity.
fn vec_cap(v: &i64) -> i64 {
    ret v[1]
}

;; Internal: grow the backing array to double capacity.
fn vec_grow(v: &i64) {
    let old_cap = v[1]
    let old_data: &i64 = v[2]
    let new_cap = old_cap * 2
    let pg = vec_pages_for(new_cap)
    let new_data: &i64 = alloc_pages(pg)
    ; Copy old elements
    let i = 0
    let len = v[0]
    loop i < len {
        new_data[i] = old_data[i]
        i = i + 1
    }
    v[1] = new_cap
    v[2] = new_data
}

;; Append an element.
fn vec_push(v: &i64, val: i64) {
    let len = v[0]
    let cap = v[1]
    if len == cap {
        vec_grow(v)
    }
    let data: &i64 = v[2]
    let cur_len = v[0]
    data[cur_len] = val
    v[0] = cur_len + 1
}

;; Remove and return last element. Returns 0 if empty.
fn vec_pop(v: &i64) -> i64 {
    let len = v[0]
    if len == 0 { ret 0 }
    let new_len = len - 1
    v[0] = new_len
    let data: &i64 = v[2]
    ret data[new_len]
}

;; Get element at index.
fn vec_get(v: &i64, idx: i64) -> i64 {
    let data: &i64 = v[2]
    ret data[idx]
}

;; Set element at index.
fn vec_set(v: &i64, idx: i64, val: i64) {
    let data: &i64 = v[2]
    data[idx] = val
}

;; Reset length to 0 (does not free memory).
fn vec_clear(v: &i64) {
    v[0] = 0
}

;; Get last element (0 if empty).
fn vec_last(v: &i64) -> i64 {
    let len = v[0]
    if len == 0 { ret 0 }
    let data: &i64 = v[2]
    let last_idx = len - 1
    ret data[last_idx]
}

;; Check if vec contains value. Returns 1 or 0.
fn vec_contains(v: &i64, val: i64) -> i64 {
    let data: &i64 = v[2]
    let len = v[0]
    let i = 0
    loop i < len {
        if data[i] == val { ret 1 }
        i = i + 1
    }
    ret 0
}

;; Remove element at index, shift remaining left. Returns removed value.
fn vec_remove(v: &i64, idx: i64) -> i64 {
    let data: &i64 = v[2]
    let len = v[0]
    let removed = data[idx]
    let i = idx
    let end = len - 1
    loop i < end {
        let next = i + 1
        data[i] = data[next]
        i = i + 1
    }
    v[0] = end
    ret removed
}
; =============================================================================
; jda::hashmap -- Hash Map (i64 -> i64)
; =============================================================================
; Open addressing with linear probing. Power-of-2 capacity.
; No external dependencies.
;
; Memory layout per map (&i64):
;   [0] capacity   (always power of 2)
;   [1] size       (occupied entries)
;   [2] keys_ptr   (&i64)
;   [3] vals_ptr   (&i64)
;   [4] state_ptr  (&i64 — 0=empty, 1=occupied, 2=tombstone)
;
; Functions:
;   map_new(cap)              -> &i64   create map
;   map_put(m, key, val)                insert or update
;   map_get(m, key)           -> i64    lookup (0 if missing)
;   map_has(m, key)           -> i64    1 if exists, 0 otherwise
;   map_del(m, key)           -> i64    1 if deleted, 0 if not found
;   map_len(m)                -> i64    entry count
;   str_hash(s, len)          -> i64    djb2 hash for byte buffers
;   map_puts(m, key, klen, val)         string-keyed insert
;   map_gets(m, key, klen)    -> i64    string-keyed lookup
;   map_hass(m, key, klen)    -> i64    string-keyed exists
; =============================================================================

;; Hash an i64 key (Knuth multiplicative hash).
fn hash_i64(key: i64) -> i64 {
    ret key * 2654435769
}

;; Hash a byte buffer (djb2).
fn str_hash(s: &i8, len: i64) -> i64 {
    let h = 5381
    let i = 0
    loop i < len {
        let c = s[i]
        let h33 = h * 33
        h = h33 + c
        i = i + 1
    }
    ret h
}

;; Round up to next power of 2. Minimum 16.
fn map_round_pow2(n: i64) -> i64 {
    let v = 16
    loop v < n {
        v = v * 2
    }
    ret v
}

;; Pages needed for n i64 elements (8 bytes each, 4096 per page).
fn map_pages_for(n: i64) -> i64 {
    let bytes = n * 8
    let pages = bytes / 4096
    let rem = bytes - pages * 4096
    if rem > 0 { pages = pages + 1 }
    if pages == 0 { pages = 1 }
    ret pages
}

;; Create a new hash map with given capacity.
fn map_new(cap: i64) -> &i64 {
    let c = map_round_pow2(cap)
    let hdr: &i64 = alloc_pages(1)
    let pg = map_pages_for(c)
    let keys: &i64 = alloc_pages(pg)
    let vals: &i64 = alloc_pages(pg)
    let state: &i64 = alloc_pages(pg)
    ; Zero-init state array (alloc_pages returns zeroed memory from mmap)
    hdr[0] = c
    hdr[1] = 0
    hdr[2] = keys
    hdr[3] = vals
    hdr[4] = state
    ret hdr
}

;; Get number of entries.
fn map_len(m: &i64) -> i64 {
    ret m[1]
}

;; Internal: find slot for key. Returns index.
;; If key is found (state=1, keys match), returns that index.
;; If key is not found, returns the first empty or tombstone slot.
fn map_find_slot(m: &i64, key: i64) -> i64 {
    let cap = m[0]
    let keys: &i64 = m[2]
    let state: &i64 = m[4]
    let mask = cap - 1
    let h = hash_i64(key)
    let idx = h and mask
    let first_tomb = 0 - 1
    let i = 0
    loop i < cap {
        let s = state[idx]
        if s == 0 {
            ; Empty slot — key not in map
            if first_tomb >= 0 { ret first_tomb }
            ret idx
        }
        if s == 1 {
            if keys[idx] == key { ret idx }
        }
        if s == 2 {
            if first_tomb < 0 { first_tomb = idx }
        }
        let next = idx + 1
        idx = next and mask
        i = i + 1
    }
    ; Table full (shouldn't happen with rehash)
    if first_tomb >= 0 { ret first_tomb }
    ret 0
}

;; Internal: rehash to double capacity.
fn map_rehash(m: &i64) {
    let old_cap = m[0]
    let old_keys: &i64 = m[2]
    let old_vals: &i64 = m[3]
    let old_state: &i64 = m[4]
    let new_cap = old_cap * 2
    let pg = map_pages_for(new_cap)
    let new_keys: &i64 = alloc_pages(pg)
    let new_vals: &i64 = alloc_pages(pg)
    let new_state: &i64 = alloc_pages(pg)
    m[0] = new_cap
    m[1] = 0
    m[2] = new_keys
    m[3] = new_vals
    m[4] = new_state
    ; Re-insert all occupied entries
    let i = 0
    loop i < old_cap {
        if old_state[i] == 1 {
            map_put(m, old_keys[i], old_vals[i])
        }
        i = i + 1
    }
}

;; Insert or update a key-value pair.
fn map_put(m: &i64, key: i64, val: i64) {
    ; Check load factor: size * 10 > cap * 7 → rehash
    let sz = m[1]
    let cap = m[0]
    let load_num = sz * 10
    let load_den = cap * 7
    if load_num > load_den {
        map_rehash(m)
    }
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    let keys: &i64 = m[2]
    let vals: &i64 = m[3]
    if state[idx] != 1 {
        ; New entry
        m[1] = m[1] + 1
    }
    keys[idx] = key
    vals[idx] = val
    state[idx] = 1
}

;; Get value for key. Returns 0 if not found.
fn map_get(m: &i64, key: i64) -> i64 {
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    if state[idx] == 1 {
        let keys: &i64 = m[2]
        if keys[idx] == key {
            let vals: &i64 = m[3]
            ret vals[idx]
        }
    }
    ret 0
}

;; Check if key exists. Returns 1 or 0.
fn map_has(m: &i64, key: i64) -> i64 {
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    if state[idx] == 1 {
        let keys: &i64 = m[2]
        if keys[idx] == key { ret 1 }
    }
    ret 0
}

;; Delete key. Returns 1 if found and deleted, 0 if not found.
fn map_del(m: &i64, key: i64) -> i64 {
    let idx = map_find_slot(m, key)
    let state: &i64 = m[4]
    if state[idx] == 1 {
        let keys: &i64 = m[2]
        if keys[idx] == key {
            state[idx] = 2
            m[1] = m[1] - 1
            ret 1
        }
    }
    ret 0
}

;; String-keyed insert: hash string, use hash as key.
fn map_puts(m: &i64, key: &i8, klen: i64, val: i64) {
    let h = str_hash(key, klen)
    map_put(m, h, val)
}

;; String-keyed lookup.
fn map_gets(m: &i64, key: &i8, klen: i64) -> i64 {
    let h = str_hash(key, klen)
    ret map_get(m, h)
}

;; String-keyed existence check.
fn map_hass(m: &i64, key: &i8, klen: i64) -> i64 {
    let h = str_hash(key, klen)
    ret map_has(m, h)
}
; =============================================================================
; jda::comprehension -- Python-style List/Dict Comprehensions
; =============================================================================
; Provides functional collection operations over Vec and HashMap.
; Depends on: stdlib/vec.jda, stdlib/hashmap.jda
;
; Python equivalent mapping:
;   range(5)                    -> range(5)
;   [x*2 for x in range(10)]   -> vec_map(range(10), fn(x) { ret x*2 })
;   [x for x in v if x > 3]    -> vec_filter(v, fn(x) { ret x > 3 })
;   sum(v)                      -> vec_sum(v)
;   any(x > 3 for x in v)      -> vec_any(v, fn(x) { ret x > 3 })
;   len([x for x in v if p])   -> vec_count(v, fn(x) { ret p })
;   enumerate(v)                -> vec_enumerate(v)
;   zip(a, b)                   -> vec_zip(a, b)
;   v[1:4]                      -> vec_slice(v, 1, 4)
;   reversed(v)                 -> vec_reverse(v)
;   sorted(v)                   -> vec_sort(v)
;   {k: v for k, v in pairs}   -> map_from_vecs(keys, vals)
;   dict.keys()                 -> map_keys(m, cap)
;   dict.values()               -> map_vals(m, cap)
;
; Zero compiler changes.
; =============================================================================

; --- Range generators ---
; range(stop) -> Vec of [0, 1, ..., stop-1]
fn range(stop: i64) -> &i64 {
    let v = vec_new(stop)
    let i = 0
    loop i < stop {
        vec_push(v, i)
        i = i + 1
    }
    ret v
}

; range2(start, stop) -> Vec of [start, start+1, ..., stop-1]
fn range2(start: i64, stop: i64) -> &i64 {
    let cap = stop - start
    if cap < 16 { cap = 16 }
    let v = vec_new(cap)
    let i = start
    loop i < stop {
        vec_push(v, i)
        i = i + 1
    }
    ret v
}

; range3(start, stop, step) -> Vec of [start, start+step, ...]
fn range3(start: i64, stop: i64, step: i64) -> &i64 {
    let v = vec_new(16)
    let i = start
    if step > 0 {
        loop i < stop {
            vec_push(v, i)
            i = i + step
        }
    }
    ret v
}

; --- Vec comprehension: map ---
; vec_map(v, fn) -> new Vec with fn applied to each element
; Python: [fn(x) for x in v]
fn vec_comp_map(v: &i64, f: i64) -> &i64 {
    let n = vec_len(v)
    let out = vec_new(n)
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        let y = call_closure(f, x)
        vec_push(out, y)
        i = i + 1
    }
    ret out
}

; --- Vec comprehension: filter ---
; vec_filter(v, pred) -> new Vec with elements where pred(x) != 0
; Python: [x for x in v if pred(x)]
fn vec_comp_filter(v: &i64, pred: i64) -> &i64 {
    let n = vec_len(v)
    let out = vec_new(n)
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        let keep = call_closure(pred, x)
        if keep != 0 {
            vec_push(out, x)
        }
        i = i + 1
    }
    ret out
}

; --- Vec comprehension: map + filter ---
; Python: [f(x) for x in v if pred(x)]
fn vec_comp_map_filter(v: &i64, f: i64, pred: i64) -> &i64 {
    let n = vec_len(v)
    let out = vec_new(n)
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        let keep = call_closure(pred, x)
        if keep != 0 {
            let y = call_closure(f, x)
            vec_push(out, y)
        }
        i = i + 1
    }
    ret out
}

; --- Vec sum ---
; Python: sum(v)
fn vec_sum(v: &i64) -> i64 {
    let n = vec_len(v)
    let acc = 0
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        acc = acc + x
        i = i + 1
    }
    ret acc
}

; --- Vec any ---
; Python: any(pred(x) for x in v)
; Note: closures must capture at least one variable.
fn vec_any(v: &i64, pred: i64) -> i64 {
    let n = vec_len(v)
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        let r = call_closure(pred, x)
        if r != 0 { ret 1 }
        i = i + 1
    }
    ret 0
}

; --- Vec count ---
; Python: len([x for x in v if pred(x)])
fn vec_count(v: &i64, pred: i64) -> i64 {
    let n = vec_len(v)
    let cnt = 0
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        let r = call_closure(pred, x)
        if r != 0 { cnt = cnt + 1 }
        i = i + 1
    }
    ret cnt
}

; --- Vec each ---
; Python: for x in v: f(x)
fn vec_each(v: &i64, f: i64) {
    let n = vec_len(v)
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        call_closure(f, x)
        i = i + 1
    }
}

; --- Vec enumerate ---
; Returns a flat vec: [idx0, val0, idx1, val1, ...]
; Access pairs as out[i*2] (index) and out[i*2+1] (value)
fn vec_enumerate(v: &i64) -> &i64 {
    let n = vec_len(v)
    let out = vec_new(n * 2)
    let i = 0
    loop i < n {
        let x = vec_get(v, i)
        vec_push(out, i)
        vec_push(out, x)
        i = i + 1
    }
    ret out
}

; --- Vec zip ---
; zip two vecs into a flat vec: [a0, b0, a1, b1, ...]
; Access pairs as out[i*2] and out[i*2+1]
fn vec_zip(a: &i64, b: &i64) -> &i64 {
    let na = vec_len(a)
    let nb = vec_len(b)
    let n = na
    if nb < n { n = nb }
    let out = vec_new(n * 2)
    let i = 0
    loop i < n {
        let va = vec_get(a, i)
        let vb = vec_get(b, i)
        vec_push(out, va)
        vec_push(out, vb)
        i = i + 1
    }
    ret out
}

; --- Vec slice ---
; Python: v[start:stop]
fn vec_slice(v: &i64, start: i64, stop: i64) -> &i64 {
    let n = vec_len(v)
    let s = start
    let e = stop
    if s < 0 { s = 0 }
    if e > n { e = n }
    let cap = e - s
    if cap < 16 { cap = 16 }
    let out = vec_new(cap)
    let i = s
    loop i < e {
        let x = vec_get(v, i)
        vec_push(out, x)
        i = i + 1
    }
    ret out
}

; --- Vec reverse ---
; Returns a new vec with elements in reverse order.
; Python: list(reversed(v))
fn vec_reverse(v: &i64) -> &i64 {
    let n = vec_len(v)
    let out = vec_new(n)
    let i = n - 1
    loop i >= 0 {
        let x = vec_get(v, i)
        vec_push(out, x)
        i = i - 1
    }
    ret out
}

; --- Vec sort (insertion sort) ---
; Returns a new sorted vec (ascending).
; Python: sorted(v)
fn vec_sort(v: &i64) -> &i64 {
    let n = vec_len(v)
    ; Copy to new vec
    let out = vec_new(n)
    let k = 0
    loop k < n {
        let x = vec_get(v, k)
        vec_push(out, x)
        k = k + 1
    }
    ; Insertion sort in place
    let i = 1
    loop i < n {
        let key = vec_get(out, i)
        let j = i - 1
        let done = 0
        loop j >= 0 and done == 0 {
            let cur = vec_get(out, j)
            if cur > key {
                vec_set(out, j + 1, cur)
                j = j - 1
            } else {
                done = 1
            }
        }
        vec_set(out, j + 1, key)
        i = i + 1
    }
    ret out
}

; --- Vec min / max ---
fn vec_min(v: &i64) -> i64 {
    let n = vec_len(v)
    let m = vec_get(v, 0)
    let i = 1
    loop i < n {
        let x = vec_get(v, i)
        if x < m { m = x }
        i = i + 1
    }
    ret m
}

fn vec_max(v: &i64) -> i64 {
    let n = vec_len(v)
    let m = vec_get(v, 0)
    let i = 1
    loop i < n {
        let x = vec_get(v, i)
        if x > m { m = x }
        i = i + 1
    }
    ret m
}

; --- Vec flatten ---
; Flatten a vec of vecs into one flat vec.
; Input: array of vec pointers (as &i64) and count.
fn vec_flatten(vecs: &i64, n: i64) -> &i64 {
    let out = vec_new(16)
    let i = 0
    loop i < n {
        let inner: &i64 = vecs[i]
        let m = vec_len(inner)
        let j = 0
        loop j < m {
            let x = vec_get(inner, j)
            vec_push(out, x)
            j = j + 1
        }
        i = i + 1
    }
    ret out
}

; --- Vec concat ---
; Python: a + b
fn vec_concat(a: &i64, b: &i64) -> &i64 {
    let na = vec_len(a)
    let nb = vec_len(b)
    let out = vec_new(na + nb)
    let i = 0
    loop i < na {
        let x = vec_get(a, i)
        vec_push(out, x)
        i = i + 1
    }
    i = 0
    loop i < nb {
        let x = vec_get(b, i)
        vec_push(out, x)
        i = i + 1
    }
    ret out
}

; --- Vec from raw array ---
fn vec_from_arr(arr: &i64, len: i64) -> &i64 {
    let v = vec_new(len)
    let i = 0
    loop i < len {
        vec_push(v, arr[i])
        i = i + 1
    }
    ret v
}

; --- Map comprehension helpers ---

; map_from_vecs(keys_vec, vals_vec) -> new map
; Python: {k: v for k, v in zip(keys, vals)}
fn map_from_vecs(keys: &i64, vals: &i64) -> &i64 {
    let n = vec_len(keys)
    let m = map_new(n * 2)
    let i = 0
    loop i < n {
        let k = vec_get(keys, i)
        let v = vec_get(vals, i)
        map_put(m, k, v)
        i = i + 1
    }
    ret m
}

; map_keys(m, cap) -> Vec of all keys
; cap = map capacity (m[0])
fn map_keys(m: &i64) -> &i64 {
    let cap = m[0]
    let state: &i64 = m[4]
    let keys: &i64 = m[2]
    let out = vec_new(16)
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            vec_push(out, keys[i])
        }
        i = i + 1
    }
    ret out
}

; map_vals(m) -> Vec of all values
fn map_vals(m: &i64) -> &i64 {
    let cap = m[0]
    let state: &i64 = m[4]
    let vals: &i64 = m[3]
    let out = vec_new(16)
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            vec_push(out, vals[i])
        }
        i = i + 1
    }
    ret out
}

; map_items(m) -> flat Vec of [k0, v0, k1, v1, ...]
; Access pairs as out[i*2] (key) and out[i*2+1] (value)
fn map_items(m: &i64) -> &i64 {
    let cap = m[0]
    let state: &i64 = m[4]
    let keys: &i64 = m[2]
    let vals: &i64 = m[3]
    let out = vec_new(16)
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            vec_push(out, keys[i])
            vec_push(out, vals[i])
        }
        i = i + 1
    }
    ret out
}

; map_filter(m, pred) -> new map with entries where pred(key) != 0
; Python: {k: v for k, v in d.items() if pred(k)}
fn map_comp_filter(m: &i64, pred: i64) -> &i64 {
    let cap = m[0]
    let state: &i64 = m[4]
    let keys: &i64 = m[2]
    let vals: &i64 = m[3]
    let out = map_new(16)
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            let keep = call_closure(pred, keys[i])
            if keep != 0 {
                map_put(out, keys[i], vals[i])
            }
        }
        i = i + 1
    }
    ret out
}

; map_map_vals(m, f) -> new map with f applied to each value
; Python: {k: f(v) for k, v in d.items()}
fn map_comp_map_vals(m: &i64, f: i64) -> &i64 {
    let cap = m[0]
    let state: &i64 = m[4]
    let keys: &i64 = m[2]
    let vals: &i64 = m[3]
    let out = map_new(16)
    let i = 0
    loop i < cap {
        if state[i] == 1 {
            let new_val = call_closure(f, vals[i])
            map_put(out, keys[i], new_val)
        }
        i = i + 1
    }
    ret out
}
