{
    "scopeName": "source.jda",
    "name": "Jda",
    "fileTypes": ["jda"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#operators" },
        { "include": "#constants" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.semicolon.jda",
                    "match": ";.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.jda",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.jda",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.jda",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.binary.jda",
                    "match": "\\b0b[01]+\\b"
                },
                {
                    "name": "constant.numeric.float.jda",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.jda",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.jda",
                    "match": "\\b(if|else|loop|for|match|ret|break|continue|in)\\b"
                },
                {
                    "name": "keyword.declaration.jda",
                    "match": "\\b(fn|let|mut|const|struct|enum|impl|import|defer)\\b"
                },
                {
                    "name": "keyword.other.jda",
                    "match": "\\b(spawn|own|ref|and|or|not|asm|volatile)\\b"
                },
                {
                    "name": "keyword.operator.jda",
                    "match": "\\b(as)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "entity.name.type.primitive.jda",
                    "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|void)\\b"
                },
                {
                    "name": "entity.name.type.jda",
                    "match": "\\b(Result|Option|Vec|Tensor|SemVer)\\b"
                },
                {
                    "name": "entity.name.type.class.jda",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.jda",
                    "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.jda" },
                        "2": { "name": "entity.name.function.jda" }
                    }
                },
                {
                    "name": "support.function.builtin.jda",
                    "match": "\\b(syscall|print|assert_eq|assert_ne|assert_true|assert_close|f64_from_int|f64_add|f64_sub|f64_mul|f64_div|f64_sqrt|f64_neg|f64_cmp|f64_print|tensor_new|tensor_get|tensor_set|tensor_fill|tensor_free|tensor_shape|tensor_len|chan_new|chan_send|chan_recv|chan_close|atomic_load|atomic_store|atomic_cmpxchg|atomic_fetch_add)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.jda",
                    "match": "(->|=>|==|!=|<=|>=|\\+|-|\\*|/|%|&|\\||\\^|<<|>>|!)"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.jda",
                    "match": "\\b(true|false|none|some|ok|err)\\b"
                }
            ]
        }
    }
}
