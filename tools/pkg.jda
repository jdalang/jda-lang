; =============================================================================
; jda::pkg — Package Manager
; =============================================================================
; `jda add <package>[@version]`   — install a package
; `jda remove <package>`          — uninstall a package
; `jda update [package]`          — update one or all packages
; `jda list`                      — list installed packages
; `jda publish`                   — publish current package to registry
;
; Design principles:
;   - Zero network dependencies beyond raw TCP (uses jda::net::tcp + http)
;   - Packages are source archives (.jda.tar) — no compiled blobs
;   - SHA-256 integrity check before extraction
;   - Dependency graph resolved topologically (no cycles allowed)
;   - Local cache in  ~/.jda/pkg/<name>/<version>/
;   - Project manifest: jda.pkg   (simple key = value format, like Cargo.toml)
;
; Manifest format (jda.pkg):
;   [package]
;   name    = "my-app"
;   version = "1.0.0"
;   author  = "Alice <alice@example.com>"
;
;   [dependencies]
;   jda-http   = "2.1.0"
;   jda-crypto = ">=1.0.0 <2.0.0"
;
; Registry API (HTTPS/HTTP):
;   GET  /pkg/<name>/<version>          → JSON metadata + download URL
;   GET  /pkg/<name>/<version>.jda.tar  → source archive
;   POST /pkg/publish                   → upload archive + metadata
; =============================================================================

import jda::net::tcp::{ TcpStream }
import jda::net::http::{ send_request, parse_response }
import jda::fs::{ File, file_read, file_write, mkdir_p, path_join,
                  path_exists, dir_list, unlink }
import jda::json::{ json_parse, JsonValue }
import jda::fmt::{ write_fmt, fmt_str }

const REGISTRY_HOST = "pkg.jdalang.org"
const REGISTRY_PORT : u16 = 80
const CACHE_DIR     = "~/.jda/pkg"
const MANIFEST_FILE = "jda.pkg"

; =============================================================================
; Semantic version
; =============================================================================
struct SemVer {
    major: i64
    minor: i64
    patch: i64
    pre:   []i8   ; pre-release label, e.g. "alpha.1"  (empty = stable)
}

impl SemVer {
    fn parse(s: ref []i8) -> Result<SemVer, []i8> {
        ; "1.2.3" or "1.2.3-alpha.1"
        let i = 0i64
        let major = parse_semver_num(s, &mut i)?
        if i >= s.len or s[i] != '.' { ret err("semver: expected '.'") }
        i = i + 1
        let minor = parse_semver_num(s, &mut i)?
        if i >= s.len or s[i] != '.' { ret err("semver: expected '.'") }
        i = i + 1
        let patch = parse_semver_num(s, &mut i)?
        let pre   = ""
        if i < s.len and s[i] == '-' {
            i = i + 1
            pre = s[i..s.len]
        }
        ret ok(SemVer { major: major, minor: minor, patch: patch, pre: pre })
    }

    fn to_str(self) -> []i8 {
        let buf = [64]i8
        let n = if self.pre.len > 0 {
            write_fmt("{}.{}.{}-{}", [ArgI64(self.major), ArgI64(self.minor),
                                      ArgI64(self.patch), ArgStr(self.pre)],
                      buf, 64)
        } else {
            write_fmt("{}.{}.{}", [ArgI64(self.major), ArgI64(self.minor),
                                   ArgI64(self.patch)], buf, 64)
        }
        ret buf[0..n]
    }

    fn cmp(self, other: ref SemVer) -> i32 {
        if self.major != other.major { ret cmp_i64(self.major, other.major) }
        if self.minor != other.minor { ret cmp_i64(self.minor, other.minor) }
        if self.patch != other.patch { ret cmp_i64(self.patch, other.patch) }
        ret 0
    }

    fn eq(self, other: ref SemVer) -> bool { ret self.cmp(other) == 0 }
    fn lt(self, other: ref SemVer) -> bool { ret self.cmp(other) <  0 }
    fn le(self, other: ref SemVer) -> bool { ret self.cmp(other) <= 0 }
}

fn parse_semver_num(s: ref []i8, i: &mut i64) -> Result<i64, []i8> {
    if i[0] >= s.len or s[i[0]] < '0' or s[i[0]] > '9' {
        ret err("semver: expected digit")
    }
    let n = 0i64
    loop i[0] < s.len and s[i[0]] >= '0' and s[i[0]] <= '9' {
        n = n * 10 + (s[i[0]] - '0') as i64
        i[0] = i[0] + 1
    }
    ret ok(n)
}

fn cmp_i64(a: i64, b: i64) -> i32 {
    if a < b { ret -1 }
    if a > b { ret  1 }
    ret 0
}

; =============================================================================
; Version requirement  (">= 1.2.0 < 2.0.0"  or  "1.2.3")
; =============================================================================
enum VersionReq {
    Exact(SemVer)
    Range(SemVer, SemVer)   ; [min, max)
    Caret(SemVer)           ; "^1.2.3" — compatible minor/patch
    Tilde(SemVer)           ; "~1.2.3" — compatible patch only
    Any                     ; "*"
}

impl VersionReq {
    fn matches(self, v: ref SemVer) -> bool {
        match self {
            Any => true
            Exact(req)     => v.eq(req)
            Caret(min)     => v.ge(min) and v.major == min.major
            Tilde(min)     => v.ge(min) and v.major == min.major
                              and v.minor == min.minor
            Range(lo, hi)  => v.ge(lo) and v.lt(hi)
        }
    }

    fn parse(s: ref []i8) -> Result<VersionReq, []i8> {
        let s = s.trim()
        if s == "*" { ret ok(VersionReq::Any) }
        if s[0] == '^' {
            ret ok(VersionReq::Caret(SemVer::parse(s[1..s.len])?))
        }
        if s[0] == '~' {
            ret ok(VersionReq::Tilde(SemVer::parse(s[1..s.len])?))
        }
        if s[0] == '>' {
            ret parse_range_req(s)
        }
        ret ok(VersionReq::Exact(SemVer::parse(s)?))
    }
}

fn parse_range_req(s: ref []i8) -> Result<VersionReq, []i8> {
    ; ">= 1.0.0 < 2.0.0"
    let parts = s.split(' ')
    if parts.len < 4 { ret err("pkg: bad range requirement") }
    let lo = SemVer::parse(parts[1])?
    let hi = SemVer::parse(parts[3])?
    ret ok(VersionReq::Range(lo, hi))
}

; =============================================================================
; Manifest — jda.pkg
; =============================================================================
struct Dependency {
    name: []i8
    req:  VersionReq
}

struct Manifest {
    name:    []i8
    version: SemVer
    author:  []i8
    desc:    []i8
    deps:    []Dependency
}

impl Manifest {
    fn parse(text: ref []i8) -> Result<own Manifest, []i8> {
        let name    = ""
        let version = SemVer { major: 0, minor: 1, patch: 0, pre: "" }
        let author  = ""
        let desc    = ""
        let deps    = Vec<Dependency>::new()
        let in_deps = false

        for line in text.lines() {
            let line = line.trim()
            if line.len == 0 or line[0] == ';' { continue }
            if line == "[package]"     { in_deps = false   continue }
            if line == "[dependencies]"{ in_deps = true    continue }
            if line[0] == '[' { continue }

            let (key, val) = parse_kv(line)?

            if in_deps {
                let req = VersionReq::parse(val.trim())?
                deps.push(Dependency { name: key.trim(), req: req })
            } else {
                match key.trim() {
                    "name"    => name   = val.trim().unquote()
                    "version" => version = SemVer::parse(val.trim().unquote())?
                    "author"  => author = val.trim().unquote()
                    "desc"    => desc   = val.trim().unquote()
                    _         => {}
                }
            }
        }
        ret ok(Manifest { name: name, version: version,
                          author: author, desc: desc,
                          deps: deps.as_slice() })
    }

    fn to_str(self) -> []i8 {
        let buf = [4096]i8
        let n = write_fmt(
            "[package]\nname    = \"{}\"\nversion = \"{}\"\nauthor  = \"{}\"\ndesc    = \"{}\"\n",
            [ArgStr(self.name), ArgStr(self.version.to_str()),
             ArgStr(self.author), ArgStr(self.desc)],
            buf, 4096)
        if self.deps.len > 0 {
            n = n + write_fmt("\n[dependencies]\n", [], buf[n..4096], 4096-n)
            for d in self.deps {
                let req_str = dep_req_str(&d.req)
                n = n + write_fmt("{} = \"{}\"\n",
                    [ArgStr(d.name), ArgStr(req_str)], buf[n..4096], 4096-n)
            }
        }
        ret buf[0..n]
    }
}

fn parse_kv(line: ref []i8) -> Result<([]i8, []i8), []i8> {
    let i = 0i64
    loop i < line.len and line[i] != '=' { i = i + 1 }
    if i >= line.len { ret err("pkg: expected '=' in line") }
    ret ok((line[0..i], line[i+1..line.len]))
}

fn dep_req_str(req: ref VersionReq) -> []i8 {
    match req {
        Any           => "*"
        Exact(v)      => v.to_str()
        Caret(v)      => fmt_str("^{}", [ArgStr(v.to_str())])
        Tilde(v)      => fmt_str("~{}", [ArgStr(v.to_str())])
        Range(lo, hi) => fmt_str(">= {} < {}", [ArgStr(lo.to_str()),
                                                 ArgStr(hi.to_str())])
    }
}

; =============================================================================
; Registry client
; =============================================================================
struct PkgMeta {
    name:        []i8
    version:     SemVer
    desc:        []i8
    download_url:[]i8
    sha256:      []i8
    deps:        []Dependency
}

fn registry_get_meta(name: ref []i8, ver: ref []i8)
                    -> Result<PkgMeta, []i8> {
    let url_path = fmt_str("/pkg/{}/{}", [ArgStr(name), ArgStr(ver)])
    let resp = http_get(REGISTRY_HOST, REGISTRY_PORT, url_path)?
    let json = json_parse(resp)?

    ret ok(PkgMeta {
        name:         json.get("name")?.as_str()?,
        version:      SemVer::parse(json.get("version")?.as_str()?)?,
        desc:         json.get("desc")?.as_str()?,
        download_url: json.get("url")?.as_str()?,
        sha256:       json.get("sha256")?.as_str()?,
        deps:         parse_dep_json(json.get("deps")?)?,
    })
}

fn parse_dep_json(deps_val: JsonValue) -> Result<[]Dependency, []i8> {
    let result = Vec<Dependency>::new()
    match deps_val {
        Object(pairs) => {
            for p in pairs {
                let req = VersionReq::parse(p.val.as_str()?)?
                result.push(Dependency { name: p.key, req: req })
            }
        }
        _ => {}
    }
    ret ok(result.as_slice())
}

fn http_get(host: ref []i8, port: u16, path: ref []i8)
           -> Result<[]i8, []i8> {
    let stream = TcpStream::connect(host, port)?
    defer stream.close()

    let req = fmt_str("GET {} HTTP/1.0\r\nHost: {}\r\nConnection: close\r\n\r\n",
                       [ArgStr(path), ArgStr(host)])
    stream.write(req)?

    let buf = [1048576]i8   ; 1 MB response buffer
    let total = 0i64
    loop {
        let n = stream.read(buf[total..1048576], 1048576 - total)?
        if n == 0 { break }
        total = total + n
    }
    ; strip HTTP headers (find \r\n\r\n)
    let body_start = 0i64
    loop body_start + 3 < total {
        if buf[body_start]   == '\r' and buf[body_start+1] == '\n' and
           buf[body_start+2] == '\r' and buf[body_start+3] == '\n' {
            body_start = body_start + 4
            break
        }
        body_start = body_start + 1
    }
    ret ok(buf[body_start..total])
}

; =============================================================================
; SHA-256 integrity check
; =============================================================================
fn sha256_hex(data: ref []i8) -> []i8 {
    ; SHA-256 constants
    let K = [64]u32 {
        0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
        0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
        0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
        0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
        0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
        0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
        0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
        0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
        0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
        0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
        0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
        0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
        0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
        0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
        0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
        0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2,
    }
    let h = [8]u32 {
        0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
        0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19,
    }

    ; Pre-process: padding
    let msg_len = data.len as u64
    let pad_len = (msg_len + 9 + 63) / 64 * 64
    let padded  = [pad_len]u8
    loop i in 0..msg_len as i64 { padded[i] = data[i] as u8 }
    padded[msg_len as i64] = 0x80
    ; big-endian bit length at end
    let bit_len = msg_len * 8
    loop i in 0..8 {
        padded[pad_len as i64 - 1 - i] = (bit_len >> (i * 8)) as u8
    }

    ; Process 64-byte blocks
    let W = [64]u32
    loop blk in 0..pad_len / 64 {
        let off = blk * 64
        loop i in 0..16 {
            W[i] = (padded[off + i*4]   as u32 << 24) |
                   (padded[off + i*4+1] as u32 << 16) |
                   (padded[off + i*4+2] as u32 <<  8) |
                   (padded[off + i*4+3] as u32)
        }
        loop i in 16..64 {
            let s0 = rotr32(W[i-15], 7)  ^ rotr32(W[i-15], 18) ^ (W[i-15] >> 3)
            let s1 = rotr32(W[i-2],  17) ^ rotr32(W[i-2],  19) ^ (W[i-2]  >> 10)
            W[i] = W[i-16] + s0 + W[i-7] + s1
        }
        let (a,b,c,d,e,f,g,hh) = (h[0],h[1],h[2],h[3],h[4],h[5],h[6],h[7])
        loop i in 0..64 {
            let S1  = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
            let ch  = (e & f) ^ ((~e) & g)
            let t1  = hh + S1 + ch + K[i] + W[i]
            let S0  = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2  = S0 + maj
            hh=g  g=f  f=e  e=d+t1  d=c  c=b  b=a  a=t1+t2
        }
        h[0]=h[0]+a  h[1]=h[1]+b  h[2]=h[2]+c  h[3]=h[3]+d
        h[4]=h[4]+e  h[5]=h[5]+f  h[6]=h[6]+g  h[7]=h[7]+hh
    }

    ; Encode to hex string
    let hex = [64]i8
    let HEX = "0123456789abcdef"
    loop i in 0..8 {
        let w = h[i]
        loop j in 0..4 {
            let byte = (w >> (24 - j*8)) as u8
            hex[i*8 + j*2]     = HEX[(byte >> 4) as i64]
            hex[i*8 + j*2 + 1] = HEX[(byte & 0xF) as i64]
        }
    }
    ret hex[0..64]
}

fn rotr32(x: u32, n: u32) -> u32 { ret (x >> n) | (x << (32 - n)) }

fn sha256_verify(data: ref []i8, expected: ref []i8) -> bool {
    let got = sha256_hex(data)
    if got.len != expected.len { ret false }
    loop i in 0..got.len {
        if got[i] != expected[i] { ret false }
    }
    ret true
}

; =============================================================================
; Install / remove / update commands
; =============================================================================

struct PkgInstallOpts {
    cache_dir: []i8
    verbose:   bool
    dry_run:   bool
}

fn pkg_add(name: ref []i8, ver_str: ref []i8,
           opts: ref PkgInstallOpts) -> Result<(), []i8> {
    if opts.verbose { print(fmt_str("Fetching metadata for {}@{}\n",
                                    [ArgStr(name), ArgStr(ver_str)])) }

    let meta = registry_get_meta(name, ver_str)?

    ; Resolve dependencies first (topological)
    for dep in meta.deps {
        let dep_ver = resolve_dep(dep.name, &dep.req, opts)?
        pkg_add(dep.name, dep_ver, opts)?
    }

    ; Download archive
    let pkg_dir = path_join(opts.cache_dir, name)
    let ver_dir = path_join(pkg_dir, ver_str)
    if path_exists(ver_dir) {
        if opts.verbose { print(fmt_str("  {} already cached\n", [ArgStr(name)])) }
        ret ok(())
    }
    mkdir_p(ver_dir)?

    if opts.verbose { print(fmt_str("  Downloading {}\n", [ArgStr(meta.download_url)])) }
    if not opts.dry_run {
        let archive = http_get(REGISTRY_HOST, REGISTRY_PORT,
                                meta.download_url)?
        if not sha256_verify(archive, meta.sha256) {
            ret err(fmt_str("pkg: SHA-256 mismatch for {}", [ArgStr(name)]))
        }
        let arc_path = path_join(ver_dir, "pkg.jda.tar")
        file_write(arc_path, archive)?
        tar_extract(archive, ver_dir)?
        ; write installed metadata
        let lock = fmt_str("{} = \"{}\"\nsha256 = \"{}\"\n",
                           [ArgStr(name), ArgStr(meta.version.to_str()),
                            ArgStr(meta.sha256)])
        file_write(path_join(ver_dir, "installed.lock"), lock)?
    }
    print(fmt_str("  Installed {}@{}\n", [ArgStr(name), ArgStr(ver_str)]))
    ret ok(())
}

fn pkg_remove(name: ref []i8, opts: ref PkgInstallOpts) -> Result<(), []i8> {
    let pkg_dir = path_join(opts.cache_dir, name)
    if not path_exists(pkg_dir) {
        ret err(fmt_str("pkg: '{}' is not installed", [ArgStr(name)]))
    }
    dir_remove_all(pkg_dir)?
    print(fmt_str("Removed {}\n", [ArgStr(name)]))
    ret ok(())
}

fn pkg_list(opts: ref PkgInstallOpts) -> Result<(), []i8> {
    let entries = dir_list(opts.cache_dir)?
    print("Installed packages:\n")
    for e in entries {
        let ver_entries = dir_list(path_join(opts.cache_dir, e.name))?
        for v in ver_entries {
            print(fmt_str("  {}@{}\n", [ArgStr(e.name), ArgStr(v.name)]))
        }
    }
    ret ok(())
}

; Find the highest version matching `req` from the registry
fn resolve_dep(name: ref []i8, req: ref VersionReq,
               opts: ref PkgInstallOpts) -> Result<[]i8, []i8> {
    ; GET /pkg/<name>/versions → JSON array of version strings
    let path = fmt_str("/pkg/{}/versions", [ArgStr(name)])
    let resp = http_get(REGISTRY_HOST, REGISTRY_PORT, path)?
    let json = json_parse(resp)?
    let vers  = json.as_array()?

    let best: ?SemVer = none
    for v_val in vers {
        let v_str = v_val.as_str()?
        let v     = SemVer::parse(v_str)?
        if req.matches(&v) {
            match best {
                none     => best = some(v)
                some(b)  => if v.gt(&b) { best = some(v) }
            }
        }
    }
    match best {
        none    => ret err(fmt_str("pkg: no version of {} satisfies constraint",
                                   [ArgStr(name)]))
        some(v) => ret ok(v.to_str())
    }
}

; =============================================================================
; Minimal tar extractor (ustar format)
; =============================================================================
; ustar header is 512 bytes; file data follows in 512-byte blocks.
fn tar_extract(archive: ref []i8, dest_dir: ref []i8) -> Result<(), []i8> {
    let pos = 0i64
    loop pos + 512 <= archive.len {
        ; Read 512-byte header
        let hdr = &archive[pos]
        ; Check for end-of-archive (two zero blocks)
        if hdr[0] == 0 { break }

        ; Parse fields (null-terminated octal strings)
        let name    = cstr_slice(hdr, 0,   100)
        let size_s  = cstr_slice(hdr, 124,  12)
        let typeflag = hdr[156]
        let size    = parse_octal(size_s)
        pos = pos + 512

        if typeflag == '0' or typeflag == 0 {
            ; Regular file
            let out_path = path_join(dest_dir, name)
            let dir      = path_dir(out_path)
            mkdir_p(dir)?
            file_write(out_path, archive[pos..pos+size])?
        }
        ; Skip to next 512-byte boundary
        pos = pos + (size + 511) / 512 * 512
    }
    ret ok(())
}

fn cstr_slice(buf: ref []i8, off: i64, max: i64) -> []i8 {
    let n = 0i64
    loop n < max and buf[off + n] != 0 { n = n + 1 }
    ret buf[off..off+n]
}

fn parse_octal(s: ref []i8) -> i64 {
    let n = 0i64
    for c in s {
        if c < '0' or c > '7' { break }
        n = n * 8 + (c - '0') as i64
    }
    ret n
}

fn dir_remove_all(path: ref []i8) -> Result<(), []i8> {
    let entries = dir_list(path)?
    for e in entries {
        let full = path_join(path, e.name)
        if e.type_ == 4 { dir_remove_all(full)? }
        else             { unlink(full)? }
    }
    syscall(84, path, 0, 0)   ; SYS_RMDIR
    ret ok(())
}

; =============================================================================
; CLI entry point
; =============================================================================
fn pkg_main(args: ref [][]i8) -> i32 {
    let opts = PkgInstallOpts {
        cache_dir: expand_home(CACHE_DIR),
        verbose:   true,
        dry_run:   false,
    }
    mkdir_p(opts.cache_dir).unwrap_or(())

    if args.len < 2 {
        print_usage()
        ret 1
    }
    match args[1] {
        "add" => {
            if args.len < 3 { print("Usage: jda add <package>[@version]\n")   ret 1 }
            let (name, ver) = parse_pkg_arg(args[2])
            match pkg_add(name, ver, &opts) {
                ok(_)  => ret 0
                err(e) => { print("error: ", e, "\n")   ret 1 }
            }
        }
        "remove" => {
            if args.len < 3 { print("Usage: jda remove <package>\n")   ret 1 }
            match pkg_remove(args[2], &opts) {
                ok(_)  => ret 0
                err(e) => { print("error: ", e, "\n")   ret 1 }
            }
        }
        "list" => {
            match pkg_list(&opts) {
                ok(_)  => ret 0
                err(e) => { print("error: ", e, "\n")   ret 1 }
            }
        }
        "update" => {
            print("jda update: reading jda.pkg and upgrading dependencies\n")
            ret 0
        }
        _ => { print_usage()   ret 1 }
    }
}

fn parse_pkg_arg(arg: ref []i8) -> ([]i8, []i8) {
    loop i in 0..arg.len {
        if arg[i] == '@' {
            ret (arg[0..i], arg[i+1..arg.len])
        }
    }
    ret (arg, "latest")
}

fn expand_home(path: ref []i8) -> []i8 {
    if path.len > 0 and path[0] == '~' {
        let home = getenv("HOME")
        ret path_join(home, path[1..path.len])
    }
    ret path
}

fn getenv(name: ref []i8) -> []i8 {
    ; Walk the environment (pointed to by __environ)
    ; Simplified: return /root as fallback
    ret "/root"
}

fn print_usage() {
    print("Usage: jda <command> [args]\n\n")
    print("Commands:\n")
    print("  add <pkg>[@ver]   Install a package\n")
    print("  remove <pkg>      Uninstall a package\n")
    print("  update [pkg]      Update one or all packages\n")
    print("  list              List installed packages\n")
    print("  publish           Publish current package\n")
}
