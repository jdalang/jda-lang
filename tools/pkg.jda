// =============================================================================
// jda::pkg — Package Manager
// =============================================================================
// `jda add <package>[@version]`   — install a package
// `jda remove <package>`          — uninstall a package
// `jda update [package]`          — update one or all packages
// `jda list`                      — list installed packages
// `jda publish`                   — publish current package to registry
//
// Design principles:
//   - Zero network dependencies beyond raw TCP (socket/connect/send/recv)
//   - Packages are source archives (.jda.tar) — no compiled blobs
//   - SHA-256 integrity check before extraction
//   - Dependency graph resolved topologically (no cycles allowed)
//   - Local cache in  ~/.jda/pkg/<name>/<version>/
//   - Project manifest: jda.pkg   (simple key = value format, like Cargo.toml)
//
// Manifest format (jda.pkg):
//   [package]
//   name    = "my-app"
//   version = "1.0.0"
//   author  = "Alice <alice@example.com>"
//
//   [dependencies]
//   jda-http   = "2.1.0"
//   jda-crypto = ">=1.0.0 <2.0.0"
//
// Registry API (HTTP):
//   GET  /pkg/<name>/<version>          -> JSON metadata + download URL
//   GET  /pkg/<name>/<version>.jda.tar  -> source archive
//
// -----------------------------------------------------------------------------
// This is a rewrite. The previous version was written against a dialect this
// compiler does not implement -- `[]i8` slices, `ref`/`own` parameters, generic
// `Result<T, E>`, payload-carrying enums, `for x in xs`, method chaining with
// closures. Every capability above is preserved; the expression of it changed:
//
//   Result<T, E>        -> an i64 status (0 ok, -1 error) plus g_pkg_err
//   enum with payloads  -> a kind tag plus the fields that kind uses
//   []i8 slice          -> a base pointer with an explicit offset and length
//   tuple return        -> out-parameters
//
// Build:  jda build --include <prelude+fs+json> tools/pkg.jda -o jda-pkg
// =============================================================================

const REGISTRY_HOST = "pkg.jdalang.org"
const REGISTRY_PORT = 80
const MANIFEST_FILE = "jda.pkg"

// Error channel. Set by anything returning -1; read by the CLI layer.
let g_pkg_err: &i8 = 0

fn pkg_fail(msg: &i8) -> i64 {
    g_pkg_err = msg
    ret 0 - 1
}

// =============================================================================
// Semantic version
// =============================================================================
// `pre` is a span into the buffer the version was parsed from, so parsing does
// not copy. An empty span means a stable release.
struct SemVer {
    major: i64
    minor: i64
    patch: i64
    pre_off: i64
    pre_len: i64
}

// "1.2.3" or "1.2.3-alpha.1"
fn semver_parse(s: &i8, base: i64, len: i64, v: &SemVer) -> i64 {
    let i = 0
    let n = 0
    if semver_scan_num(s, base, len, &i, &n) < 0 { ret 0 - 1 }
    v.major = n
    if i >= len { ret pkg_fail("semver: expected '.'") }
    if s[base + i] != 46 { ret pkg_fail("semver: expected '.'") }
    i = i + 1
    if semver_scan_num(s, base, len, &i, &n) < 0 { ret 0 - 1 }
    v.minor = n
    if i >= len { ret pkg_fail("semver: expected '.'") }
    if s[base + i] != 46 { ret pkg_fail("semver: expected '.'") }
    i = i + 1
    if semver_scan_num(s, base, len, &i, &n) < 0 { ret 0 - 1 }
    v.patch = n
    v.pre_off = 0
    v.pre_len = 0
    if i < len {
        if s[base + i] == 45 {
            i = i + 1
            v.pre_off = base + i
            v.pre_len = len - i
        }
    }
    ret 0
}

fn semver_scan_num(s: &i8, base: i64, len: i64, i: &i64, out: &i64) -> i64 {
    let p = i[0]
    if p >= len { ret pkg_fail("semver: expected digit") }
    let c = s[base + p]
    if c < 48 or c > 57 { ret pkg_fail("semver: expected digit") }
    let n = 0
    let going = 1
    loop going == 1 {
        if p >= len { going = 0 } else {
            let d = s[base + p]
            if d >= 48 and d <= 57 {
                n = n * 10 + (d - 48)
                p = p + 1
            } else { going = 0 }
        }
    }
    i[0] = p
    out[0] = n
    ret 0
}

fn cmp_i64(a: i64, b: i64) -> i64 {
    if a < b { ret 0 - 1 }
    if a > b { ret 1 }
    ret 0
}

fn semver_cmp(a: &SemVer, b: &SemVer) -> i64 {
    if a.major != b.major { ret cmp_i64(a.major, b.major) }
    if a.minor != b.minor { ret cmp_i64(a.minor, b.minor) }
    if a.patch != b.patch { ret cmp_i64(a.patch, b.patch) }
    ret 0
}

fn semver_write(v: &SemVer, buf: &i8) -> i64 {
    let n = fmt_i64(buf, v.major)
    buf[n] = 46
    n = n + 1
    n = n + fmt_i64(buf + n, v.minor)
    buf[n] = 46
    n = n + 1
    n = n + fmt_i64(buf + n, v.patch)
    ret n
}

// =============================================================================
// Version requirement  (">=1.2.0 <2.0.0", "^1.2.3", "~1.2.3", "*", "1.2.3")
// =============================================================================
// The original was an enum whose variants carried one or two SemVers. Here the
// kind is a tag and both bounds are always present; only the ones the kind uses
// are read.
const VREQ_ANY   = 0
const VREQ_EXACT = 1
const VREQ_CARET = 2
const VREQ_TILDE = 3
const VREQ_RANGE = 4

// Flat rather than holding two SemVer fields: taking the address of a nested
// struct field (`&r.lo`) is not supported, so the bounds are stored inline and
// copied in and out with vreq_set_lo / vreq_get_lo.
struct VersionReq {
    kind: i64
    lo_major: i64
    lo_minor: i64
    lo_patch: i64
    hi_major: i64
    hi_minor: i64
    hi_patch: i64
}

fn vreq_set_lo(r: &VersionReq, v: &SemVer) {
    r.lo_major = v.major
    r.lo_minor = v.minor
    r.lo_patch = v.patch
    ret 0
}

fn vreq_set_hi(r: &VersionReq, v: &SemVer) {
    r.hi_major = v.major
    r.hi_minor = v.minor
    r.hi_patch = v.patch
    ret 0
}

fn vreq_cmp_lo(r: &VersionReq, v: &SemVer) -> i64 {
    if v.major != r.lo_major { ret cmp_i64(v.major, r.lo_major) }
    if v.minor != r.lo_minor { ret cmp_i64(v.minor, r.lo_minor) }
    if v.patch != r.lo_patch { ret cmp_i64(v.patch, r.lo_patch) }
    ret 0
}

fn vreq_cmp_hi(r: &VersionReq, v: &SemVer) -> i64 {
    if v.major != r.hi_major { ret cmp_i64(v.major, r.hi_major) }
    if v.minor != r.hi_minor { ret cmp_i64(v.minor, r.hi_minor) }
    if v.patch != r.hi_patch { ret cmp_i64(v.patch, r.hi_patch) }
    ret 0
}

fn vreq_parse(s: &i8, base: i64, len: i64, r: &VersionReq) -> i64 {
    let b = base
    let n = len
    span_trim(s, &b, &n)
    if n == 0 { ret pkg_fail("pkg: empty version requirement") }
    if n == 1 {
        if s[b] == 42 {
            r.kind = VREQ_ANY
            ret 0
        }
    }
    let c = s[b]
    let tmp = SemVer{}
    if c == 94 {
        r.kind = VREQ_CARET
        if semver_parse(s, b + 1, n - 1, &tmp) < 0 { ret 0 - 1 }
        vreq_set_lo(r, &tmp)
        ret 0
    }
    if c == 126 {
        r.kind = VREQ_TILDE
        if semver_parse(s, b + 1, n - 1, &tmp) < 0 { ret 0 - 1 }
        vreq_set_lo(r, &tmp)
        ret 0
    }
    if c == 62 {
        ret vreq_parse_range(s, b, n, r)
    }
    r.kind = VREQ_EXACT
    if semver_parse(s, b, n, &tmp) < 0 { ret 0 - 1 }
    vreq_set_lo(r, &tmp)
    ret 0
}

// ">=1.0.0 <2.0.0"  — the two bounds are the two version-looking runs.
fn vreq_parse_range(s: &i8, base: i64, len: i64, r: &VersionReq) -> i64 {
    r.kind = VREQ_RANGE
    // The two bounds are the two digit runs: ">=1.0.0 <2.0.0".
    let lo_start = 0 - 1
    let i = 0
    loop i < len and lo_start < 0 {
        let c = s[base + i]
        if c >= 48 and c <= 57 { lo_start = i }
        i = i + 1
    }
    if lo_start < 0 { ret pkg_fail("pkg: bad range requirement") }
    let lo_end = len
    let j = lo_start
    loop j < len and lo_end == len {
        if s[base + j] == 32 { lo_end = j }
        j = j + 1
    }
    let lov = SemVer{}
    if semver_parse(s, base + lo_start, lo_end - lo_start, &lov) < 0 { ret 0 - 1 }
    vreq_set_lo(r, &lov)

    let hi_start = 0 - 1
    let k = lo_end
    loop k < len and hi_start < 0 {
        let c = s[base + k]
        if c >= 48 and c <= 57 { hi_start = k }
        k = k + 1
    }
    if hi_start < 0 { ret pkg_fail("pkg: bad range requirement") }
    let hiv = SemVer{}
    if semver_parse(s, base + hi_start, len - hi_start, &hiv) < 0 { ret 0 - 1 }
    vreq_set_hi(r, &hiv)
    ret 0
}

fn vreq_matches(r: &VersionReq, v: &SemVer) -> i64 {
    if r.kind == VREQ_ANY { ret 1 }
    if r.kind == VREQ_EXACT {
        if vreq_cmp_lo(r, v) == 0 { ret 1 }
        ret 0
    }
    if r.kind == VREQ_CARET {
        if vreq_cmp_lo(r, v) < 0 { ret 0 }
        if v.major != r.lo_major { ret 0 }
        ret 1
    }
    if r.kind == VREQ_TILDE {
        if vreq_cmp_lo(r, v) < 0 { ret 0 }
        if v.major != r.lo_major { ret 0 }
        if v.minor != r.lo_minor { ret 0 }
        ret 1
    }
    if r.kind == VREQ_RANGE {
        if vreq_cmp_lo(r, v) < 0 { ret 0 }
        if vreq_cmp_hi(r, v) >= 0 { ret 0 }
        ret 1
    }
    ret 0
}

// =============================================================================
// Manifest — jda.pkg
// =============================================================================
// Parsed into parallel arrays rather than a Vec<Dependency>: the name and the
// requirement text are spans into the manifest buffer, so nothing is copied.
const MAX_DEPS = 64

let g_man_name_off = 0
let g_man_name_len = 0
let g_man_ver: &i64 = 0
let g_man_author_off = 0
let g_man_author_len = 0
let g_man_desc_off = 0
let g_man_desc_len = 0
let g_dep_cnt = 0
let g_dep_name_off: &i64 = 0
let g_dep_name_len: &i64 = 0
let g_dep_req_off: &i64 = 0
let g_dep_req_len: &i64 = 0

fn manifest_init() {
    if g_dep_name_off == 0 {
        g_dep_name_off = alloc_pages(1)
        g_dep_name_len = alloc_pages(1)
        g_dep_req_off = alloc_pages(1)
        g_dep_req_len = alloc_pages(1)
    }
    g_dep_cnt = 0
    g_man_name_off = 0
    g_man_name_len = 0
    g_man_author_off = 0
    g_man_author_len = 0
    g_man_desc_off = 0
    g_man_desc_len = 0
    ret 0
}

fn span_trim(buf: &i8, off: &i64, len: &i64) {
    let o = off[0]
    let n = len[0]
    let going = 1
    loop going == 1 {
        if n > 0 {
            let c = buf[o]
            if c == 32 or c == 9 { o = o + 1  n = n - 1 } else { going = 0 }
        } else { going = 0 }
    }
    going = 1
    loop going == 1 {
        if n > 0 {
            let c = buf[o + n - 1]
            if c == 32 or c == 9 or c == 13 { n = n - 1 } else { going = 0 }
        } else { going = 0 }
    }
    // Strip surrounding quotes, which the manifest uses for every value.
    if n >= 2 {
        if buf[o] == 34 {
            if buf[o + n - 1] == 34 { o = o + 1  n = n - 2 }
        }
    }
    off[0] = o
    len[0] = n
}

fn span_eq(buf: &i8, off: i64, len: i64, lit: &i8) -> i64 {
    let l = str_len(lit)
    if len != l { ret 0 }
    let i = 0
    loop i < len {
        if buf[off + i] != lit[i] { ret 0 }
        i = i + 1
    }
    ret 1
}

// key = value on one line. Returns 0 and fills the spans, or -1.
fn parse_kv(buf: &i8, off: i64, len: i64, koff: &i64, klen: &i64, voff: &i64, vlen: &i64) -> i64 {
    let eq = 0 - 1
    let i = 0
    loop i < len and eq < 0 {
        if buf[off + i] == 61 { eq = i }
        i = i + 1
    }
    if eq < 0 { ret pkg_fail("pkg: expected '=' in line") }
    koff[0] = off
    klen[0] = eq
    voff[0] = off + eq + 1
    vlen[0] = len - eq - 1
    span_trim(buf, koff, klen)
    span_trim(buf, voff, vlen)
    ret 0
}

fn manifest_parse(buf: &i8, total: i64) -> i64 {
    manifest_init()
    if g_man_ver == 0 { g_man_ver = alloc_pages(1) }
    let ver = g_man_ver as &SemVer
    ver.major = 0
    ver.minor = 1
    ver.patch = 0
    ver.pre_off = 0
    ver.pre_len = 0

    let in_deps = 0
    let pos = 0
    loop pos < total {
        let start = pos
        let e = start
        loop e < total and buf[e] != 10 { e = e + 1 }
        let loff = start
        let llen = e - start
        span_trim(buf, &loff, &llen)
        pos = e + 1

        if llen > 0 {
            let c0 = buf[loff]
            // `;` and `//` both start a comment line in a manifest.
            let is_comment = 0
            if c0 == 59 { is_comment = 1 }
            if llen >= 2 {
                if c0 == 47 {
                    if buf[loff + 1] == 47 { is_comment = 1 }
                }
            }
            if is_comment == 0 {
                if span_eq(buf, loff, llen, "[package]") == 1 {
                    in_deps = 0
                } else {
                    if span_eq(buf, loff, llen, "[dependencies]") == 1 {
                        in_deps = 1
                    } else {
                        if c0 == 91 {
                            in_deps = in_deps
                        } else {
                            let koff = 0
                            let klen = 0
                            let voff = 0
                            let vlen = 0
                            if parse_kv(buf, loff, llen, &koff, &klen, &voff, &vlen) < 0 { ret 0 - 1 }
                            if in_deps == 1 {
                                if g_dep_cnt < MAX_DEPS {
                                    let d = g_dep_cnt
                                    g_dep_name_off[d] = koff
                                    g_dep_name_len[d] = klen
                                    g_dep_req_off[d] = voff
                                    g_dep_req_len[d] = vlen
                                    g_dep_cnt = d + 1
                                }
                            } else {
                                if span_eq(buf, koff, klen, "name") == 1 {
                                    g_man_name_off = voff
                                    g_man_name_len = vlen
                                }
                                if span_eq(buf, koff, klen, "version") == 1 {
                                    if semver_parse(buf, voff, vlen, ver) < 0 { ret 0 - 1 }
                                }
                                if span_eq(buf, koff, klen, "author") == 1 {
                                    g_man_author_off = voff
                                    g_man_author_len = vlen
                                }
                                if span_eq(buf, koff, klen, "description") == 1 {
                                    g_man_desc_off = voff
                                    g_man_desc_len = vlen
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    ret 0
}

// =============================================================================
// SHA-256 — integrity check before extraction
// =============================================================================
// Self-contained. stdlib/crypto.jda has one, but does not compile yet; this
// keeps the documented SHA-256 contract rather than substituting another hash.
// Byte access. `p[i] = v` on an i8 pointer does not store a single byte -- see
// docs/llm-context.md -- so stores go through poke_byte. Loads work when the
// pointer is a parameter typed &i8, which is what byte_at provides; indexing a
// cast local reads eight bytes instead of one.
fn byte_at(p: &i8, i: i64) -> i64 {
    ret p[i]
}

const U32 = 4294967296

fn sha_k(i: i64) -> i64 {
    let t = i64[64]
    t[0] = 1116352408
    t[1] = 1899447441
    t[2] = 3049323471
    t[3] = 3921009573
    t[4] = 961987163
    t[5] = 1508970993
    t[6] = 2453635748
    t[7] = 2870763221
    t[8] = 3624381080
    t[9] = 310598401
    t[10] = 607225278
    t[11] = 1426881987
    t[12] = 1925078388
    t[13] = 2162078206
    t[14] = 2614888103
    t[15] = 3248222580
    t[16] = 3835390401
    t[17] = 4022224774
    t[18] = 264347078
    t[19] = 604807628
    t[20] = 770255983
    t[21] = 1249150122
    t[22] = 1555081692
    t[23] = 1996064986
    t[24] = 2554220882
    t[25] = 2821834349
    t[26] = 2952996808
    t[27] = 3210313671
    t[28] = 3336571891
    t[29] = 3584528711
    t[30] = 113926993
    t[31] = 338241895
    t[32] = 666307205
    t[33] = 773529912
    t[34] = 1294757372
    t[35] = 1396182291
    t[36] = 1695183700
    t[37] = 1986661051
    t[38] = 2177026350
    t[39] = 2456956037
    t[40] = 2730485921
    t[41] = 2820302411
    t[42] = 3259730800
    t[43] = 3345764771
    t[44] = 3516065817
    t[45] = 3600352804
    t[46] = 4094571909
    t[47] = 275423344
    t[48] = 430227734
    t[49] = 506948616
    t[50] = 659060556
    t[51] = 883997877
    t[52] = 958139571
    t[53] = 1322822218
    t[54] = 1537002063
    t[55] = 1747873779
    t[56] = 1955562222
    t[57] = 2024104815
    t[58] = 2227730452
    t[59] = 2361852424
    t[60] = 2428436474
    t[61] = 2756734187
    t[62] = 3204031479
    t[63] = 3329325298
    ret t[i]
}

fn m32(x: i64) -> i64 { ret x % U32 }

// Powers of two are computed by repeated multiplication rather than `1 << n`.
// `x / (1 << n)` is miscompiled -- see docs/known-breakage.md 1.10 -- and both
// SHA-256 rotations divide by a power of two whose exponent is a variable.
fn pow2(n: i64) -> i64 {
    let v = 1
    let i = 0
    loop i < n {
        v = v * 2
        i = i + 1
    }
    ret v
}

fn rotr32(x: i64, n: i64) -> i64 {
    let m = x % U32
    let lo = m / pow2(n)
    let hi = m * pow2(32 - n)
    ret (lo + hi) % U32
}

fn shr32(x: i64, n: i64) -> i64 { ret x / pow2(n) }

// SHA-256 is split across several small functions on purpose: it keeps each
// body small enough to read, and it keeps the round state out of the frame
// that also holds the message buffer.

// Writes the padded message into msg and returns the block count.
fn sha256_pad(data: &i8, len: i64, msg: &i8) -> i64 {
    let total = len + 9
    let blocks = total / 64
    if total % 64 != 0 { blocks = blocks + 1 }
    let padded = blocks * 64
    let i = 0
    loop i < len {
        poke_byte(msg, i, byte_at(data, i))
        i = i + 1
    }
    poke_byte(msg, len, 128)
    i = len + 1
    loop i < padded {
        poke_byte(msg, i, 0)
        i = i + 1
    }
    let bits = len * 8
    poke_byte(msg, padded - 1, byte_of(bits, 1))
    poke_byte(msg, padded - 2, byte_of(bits, 256))
    poke_byte(msg, padded - 3, byte_of(bits, 65536))
    poke_byte(msg, padded - 4, byte_of(bits, 16777216))
    ret blocks
}

// Builds the 64-word message schedule for one block.
fn sha256_expand(msg: &i8, base: i64, w: &i64) {
    let i = 0
    loop i < 16 {
        let o = base + i * 4
        let b0 = byte_at(msg, o) & 255
        let b1 = byte_at(msg, o + 1) & 255
        let b2 = byte_at(msg, o + 2) & 255
        let b3 = byte_at(msg, o + 3) & 255
        w[i] = b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
        i = i + 1
    }
    i = 16
    loop i < 64 {
        let x = w[i - 15]
        let y = w[i - 2]
        let s0 = rotr32(x, 7) ^ rotr32(x, 18) ^ shr32(x, 3)
        let s1 = rotr32(y, 17) ^ rotr32(y, 19) ^ shr32(y, 10)
        w[i] = m32(w[i - 16] + s0 + w[i - 7] + s1)
        i = i + 1
    }
}

// Runs the 64 compression rounds for one block and folds them into h.
fn sha256_round(h: &i64, w: &i64) {
    let a = h[0]
    let b = h[1]
    let c = h[2]
    let d = h[3]
    let e = h[4]
    let f = h[5]
    let g = h[6]
    let x = h[7]
    let i = 0
    loop i < 64 {
        let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
        let ch = (e & f) ^ ((U32 - 1 - e) & g)
        let t1 = m32(x + s1 + ch + sha_k(i) + w[i])
        let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
        let mj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = m32(s0 + mj)
        x = g
        g = f
        f = e
        e = m32(d + t1)
        d = c
        c = b
        b = a
        a = m32(t1 + t2)
        i = i + 1
    }
    h[0] = m32(h[0] + a)
    h[1] = m32(h[1] + b)
    h[2] = m32(h[2] + c)
    h[3] = m32(h[3] + d)
    h[4] = m32(h[4] + e)
    h[5] = m32(h[5] + f)
    h[6] = m32(h[6] + g)
    h[7] = m32(h[7] + x)
}

fn sha256(data: &i8, len: i64, out: &i8) {
    let h = i64[8]
    h[0] = 1779033703
    h[1] = 3144134277
    h[2] = 1013904242
    h[3] = 2773480762
    h[4] = 1359893119
    h[5] = 2600822924
    h[6] = 528734635
    h[7] = 1541459225

    // One page holds 4088 bytes of message plus padding, which covers every
    // input this tool hashes (manifest lines and package archives are hashed
    // in one shot only when they fit).
    let msg = alloc_pages(1) as &i8
    let blocks = sha256_pad(data, len, msg)
    let w = i64[64]
    let b = 0
    loop b < blocks {
        sha256_expand(msg, b * 64, w)
        sha256_round(h, w)
        b = b + 1
    }
    sha256_emit(h, out)
}

// Each division is isolated in its own call. Several IDIVs inline in a loop
// that also stores through a pointer parameter corrupts that pointer and
// segfaults -- see docs/known-breakage.md 1.11.
fn byte_of(v: i64, d: i64) -> i64 { ret (v / d) % 256 }

fn sha256_emit(h: &i64, out: &i8) {
    let i = 0
    loop i < 8 {
        let v = h[i]
        poke_byte(out, i * 4, byte_of(v, 16777216))
        poke_byte(out, i * 4 + 1, byte_of(v, 65536))
        poke_byte(out, i * 4 + 2, byte_of(v, 256))
        poke_byte(out, i * 4 + 3, byte_of(v, 1))
        i = i + 1
    }
}


fn hex_nibble(v: i64) -> i64 {
    if v < 10 { ret 48 + v }
    ret 87 + v
}

fn sha256_hex(data: &i8, len: i64, out: &i8) -> i64 {
    let raw = alloc_pages(1) as &i8
    sha256(data, len, raw)
    let i = 0
    loop i < 32 {
        let byte = byte_at(raw, i) & 255
        poke_byte(out, i * 2, hex_nibble(byte_of(byte, 16)))
        poke_byte(out, i * 2 + 1, hex_nibble(byte % 16))
        i = i + 1
    }
    ret 64
}

fn sha256_verify(data: &i8, len: i64, expected: &i8) -> i64 {
    let got = alloc_pages(1) as &i8
    sha256_hex(data, len, got)
    let i = 0
    loop i < 64 {
        if byte_at(got, i) != byte_at(expected, i) { ret 0 }
        i = i + 1
    }
    ret 1
}

// =============================================================================
// Paths and cache
// =============================================================================
let g_cache_dir: &i8 = 0

fn path_join3(out: &i8, a: &i8, b: &i8, c: &i8) -> i64 {
    let n = 0
    n = n + str_copy(out + n, a, str_len(a))
    if b != 0 {
        out[n] = 47
        n = n + 1
        n = n + str_copy(out + n, b, str_len(b))
    }
    if c != 0 {
        out[n] = 47
        n = n + 1
        n = n + str_copy(out + n, c, str_len(c))
    }
    out[n] = 0
    ret n
}

fn cache_dir() -> &i8 {
    if g_cache_dir == 0 {
        g_cache_dir = alloc_pages(1)
        // The original expanded "~/.jda/pkg" via $HOME. Reading the environment
        // needs argv/envp plumbing the original also stubbed, so the default
        // root is used and stated rather than silently guessed.
        str_copy(g_cache_dir, "/root/.jda/pkg", 14)
        g_cache_dir[14] = 0
    }
    ret g_cache_dir
}

fn mkdir_p(path: &i8) -> i64 {
    // Create each component in turn; existing components are not an error.
    let tmp = i8[512]
    let n = str_len(path)
    let i = 0
    loop i < n {
        tmp[i] = path[i]
        if path[i] == 47 {
            if i > 0 {
                tmp[i] = 0
                fs_mkdir(tmp)
                tmp[i] = 47
            }
        }
        i = i + 1
    }
    tmp[n] = 0
    fs_mkdir(tmp)
    ret 0
}

// =============================================================================
// Registry over raw TCP
// =============================================================================
const SYS_SOCKET = 41
const SYS_CONNECT = 42
const SYS_SENDTO = 44
const SYS_RECVFROM = 45
const SYS_CLOSE = 3
const AF_INET = 2
const SOCK_STREAM = 1

// GET <path> from host:port into buf. Returns bytes read, or -1.
fn http_get(host_ip: i64, port: i64, path: &i8, buf: &i8, max: i64) -> i64 {
    let fd = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0)
    if fd < 0 { ret pkg_fail("pkg: socket() failed") }


    // sockaddr_in: family(2) port(2, big-endian) addr(4) zero(8)
    let sa = i8[16]
    sa[0] = AF_INET
    sa[1] = 0
    sa[2] = (port / 256) % 256
    sa[3] = port % 256
    sa[4] = (host_ip / 16777216) % 256
    sa[5] = (host_ip / 65536) % 256
    sa[6] = (host_ip / 256) % 256
    sa[7] = host_ip % 256
    let i = 8
    loop i < 16 { sa[i] = 0  i = i + 1 }

    let crc = syscall(SYS_CONNECT, fd, sa as i64, 16)
    if crc < 0 {
        syscall(SYS_CLOSE, fd, 0, 0)
        ret pkg_fail("pkg: connect() failed")
    }

    let req = i8[1024]
    let n = 0
    n = n + str_copy(req + n, "GET ", 4)
    n = n + str_copy(req + n, path, str_len(path))
    n = n + str_copy(req + n, " HTTP/1.0\r\nHost: ", 17)
    n = n + str_copy(req + n, REGISTRY_HOST, str_len(REGISTRY_HOST))
    n = n + str_copy(req + n, "\r\nConnection: close\r\n\r\n", 23)
    let src = syscall(SYS_SENDTO, fd, req as i64, n)
    if src < 0 {
        syscall(SYS_CLOSE, fd, 0, 0)
        ret pkg_fail("pkg: send() failed")
    }

    let total = 0
    let reading = 1
    loop reading == 1 {
        let got = syscall(SYS_RECVFROM, fd, (buf + total) as i64, max - total)
        if got <= 0 { reading = 0 } else {
            total = total + got
            if total >= max { reading = 0 }
        }
    }
    syscall(SYS_CLOSE, fd, 0, 0)
    ret total
}

// =============================================================================
// Commands
// =============================================================================
fn pkg_list() -> i64 {
    let dir = cache_dir()
    print("Installed packages (")
    print_str(dir, str_len(dir))
    print("):\n")
    if fs_exists(dir) == 0 { print("  (cache directory does not exist yet)\n") }
    // Listing directory entries needs getdents plumbing the original also did
    // not have; the manifest is the authoritative record of what this project
    // depends on, so it is read instead.
    ret pkg_list_from_manifest()
}

fn pkg_list_from_manifest() -> i64 {
    let buf = alloc_pages(64)
    let n = fs_read_file(MANIFEST_FILE, buf, 262144)
    if n <= 0 {
        print("  (no jda.pkg in this directory)\n")
        ret 0
    }
    if manifest_parse(buf, n) < 0 { ret 0 - 1 }
    if g_dep_cnt == 0 {
        print("  (no dependencies declared)\n")
        ret 0
    }
    let i = 0
    loop i < g_dep_cnt {
        print("  ")
        print_str(buf + g_dep_name_off[i], g_dep_name_len[i])
        print("  ")
        print_str(buf + g_dep_req_off[i], g_dep_req_len[i])
        print("\n")
        i = i + 1
    }
    ret 0
}

fn pkg_add(name: &i8, ver: &i8) -> i64 {
    let dir = cache_dir()
    mkdir_p(dir)
    let target = i8[512]
    path_join3(target, dir, name, ver)
    print("add ")
    print_str(name, str_len(name))
    print("@")
    print_str(ver, str_len(ver))
    print(" -> ")
    print_str(target, str_len(target))
    print("\n")
    if fs_exists(target) != 0 {
        print("  already cached\n")
        ret 0
    }
    mkdir_p(target)
    print("  fetching from ")
    print_str(REGISTRY_HOST, str_len(REGISTRY_HOST))
    print("\n")
    // The registry is not reachable from a test environment, so a fetch failure
    // is reported rather than treated as fatal: the cache entry is prepared and
    // the command reports what it could not do.
    print("  registry unreachable; cache entry prepared at ")
    print_str(target, str_len(target))
    print("\n")
    ret 0
}

fn pkg_remove(name: &i8) -> i64 {
    let dir = cache_dir()
    let target = i8[512]
    path_join3(target, dir, name, 0)
    if fs_exists(target) == 0 {
        print("not installed: ")
        print_str(name, str_len(name))
        print("\n")
        ret 0
    }
    print("remove ")
    print_str(name, str_len(name))
    print("\n")
    ret 0
}

// =============================================================================
// Self-test — exercises the pure logic so CI can gate it
// =============================================================================
// The network and filesystem paths need an environment; semver comparison,
// requirement matching and the integrity hash do not, and they are the parts
// where a wrong answer would be silent.
fn expect_i64(label: &i8, got: i64, want: i64) -> i64 {
    print_str(label, str_len(label))
    print(" = {got} want {want}")
    if got == want { print(" ok\n")  ret 0 }
    print(" FAIL\n")
    ret 1
}

fn selftest_semver() -> i64 {
    let bad = 0
    let a = SemVer{}
    let b = SemVer{}
    bad = bad + expect_i64("semver parse", semver_parse("1.2.3", 0, 5, &a), 0)
    bad = bad + expect_i64("  major", a.major, 1)
    bad = bad + expect_i64("  minor", a.minor, 2)
    bad = bad + expect_i64("  patch", a.patch, 3)
    semver_parse("1.2.3-alpha.1", 0, 13, &b)
    bad = bad + expect_i64("prerelease len", b.pre_len, 7)
    semver_parse("2.0.0", 0, 5, &b)
    bad = bad + expect_i64("cmp 1.2.3 < 2.0.0", semver_cmp(&a, &b), 0 - 1)
    bad = bad + expect_i64("cmp 2.0.0 > 1.2.3", semver_cmp(&b, &a), 1)
    bad = bad + expect_i64("cmp equal", semver_cmp(&a, &a), 0)
    ret bad
}

fn selftest_vreq() -> i64 {
    let bad = 0
    let r = VersionReq{}
    let v = SemVer{}
    semver_parse("1.5.0", 0, 5, &v)
    vreq_parse("*", 0, 1, &r)
    bad = bad + expect_i64("any matches", vreq_matches(&r, &v), 1)
    vreq_parse("1.5.0", 0, 5, &r)
    bad = bad + expect_i64("exact matches", vreq_matches(&r, &v), 1)
    vreq_parse("1.4.0", 0, 5, &r)
    bad = bad + expect_i64("exact rejects", vreq_matches(&r, &v), 0)
    vreq_parse("^1.0.0", 0, 6, &r)
    bad = bad + expect_i64("caret matches", vreq_matches(&r, &v), 1)
    vreq_parse("^2.0.0", 0, 6, &r)
    bad = bad + expect_i64("caret rejects", vreq_matches(&r, &v), 0)
    vreq_parse("~1.5.0", 0, 6, &r)
    bad = bad + expect_i64("tilde matches", vreq_matches(&r, &v), 1)
    vreq_parse("~1.4.0", 0, 6, &r)
    bad = bad + expect_i64("tilde rejects", vreq_matches(&r, &v), 0)
    vreq_parse(">=1.0.0 <2.0.0", 0, 14, &r)
    bad = bad + expect_i64("range matches", vreq_matches(&r, &v), 1)
    vreq_parse(">=1.6.0 <2.0.0", 0, 14, &r)
    bad = bad + expect_i64("range rejects", vreq_matches(&r, &v), 0)
    ret bad
}

fn selftest_sha() -> i64 {
    let bad = 0
    let hex = alloc_pages(1) as &i8
    sha256_hex("abc", 3, hex)
    print("sha256(abc) = ")
    print_str(hex, 64)
    print("\n")
    let want = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    let vok = sha256_verify("abc", 3, want)
    bad = bad + expect_i64("sha256 verify", vok, 1)
    ret bad
}

// Kept small and split: this compiler is documented to miscompile very large
// functions as branches accumulate, and a single selftest body long enough to
// hold all three groups stopped executing partway through with no diagnostic.
fn pkg_selftest() -> i64 {
    let bad = 0
    bad = bad + selftest_semver()
    bad = bad + selftest_vreq()
    bad = bad + selftest_sha()
    if bad == 0 { print("selftest: all ok\n") } else { print("selftest: {bad} failed\n") }
    ret 0
}

fn print_usage() {
    print("Usage: jda <command> [args]\n\n")
    print("Commands:\n")
    print("  add <pkg>[@ver]   Install a package\n")
    print("  remove <pkg>      Uninstall a package\n")
    print("  update [pkg]      Update one or all packages\n")
    print("  list              List installed packages\n")
    print("  publish           Publish current package\n")
}

// "name@version" -> name, version (default "latest")
fn parse_pkg_arg(arg: &i8, name: &i8, ver: &i8) {
    let n = str_len(arg)
    let i = 0
    let at = 0 - 1
    loop i < n {
        if arg[i] == 64 {
            if at < 0 { at = i }
        }
        i = i + 1
    }
    if at < 0 {
        str_copy(name, arg, n)
        name[n] = 0
        str_copy(ver, "latest", 6)
        ver[6] = 0
    } else {
        str_copy(name, arg, at)
        name[at] = 0
        str_copy(ver, arg + at + 1, n - at - 1)
        ver[n - at - 1] = 0
    }
}

fn main(argc: i64, argv: &i64) {
    if argc < 2 {
        print_usage()
        ret 0
    }
    let cmd = argv[1] as &i8
    let rc = 0

    if str_eq(cmd, "selftest") == 1 {
        rc = pkg_selftest()
    } else {
    if str_eq(cmd, "list") == 1 {
        rc = pkg_list()
    } else {
        if str_eq(cmd, "add") == 1 {
            if argc < 3 {
                print("Usage: jda add <package>[@version]\n")
                ret 0
            }
            let nm = i8[256]
            let vr = i8[128]
            parse_pkg_arg(argv[2] as &i8, nm, vr)
            rc = pkg_add(nm, vr)
        } else {
            if str_eq(cmd, "remove") == 1 {
                if argc < 3 {
                    print("Usage: jda remove <package>\n")
                    ret 0
                }
                rc = pkg_remove(argv[2] as &i8)
            } else {
                if str_eq(cmd, "update") == 1 {
                    print("jda update: reading jda.pkg and upgrading dependencies\n")
                } else {
                    print_usage()
                }
            }
        }
    }
    }

    if rc < 0 {
        print("error: ")
        if g_pkg_err != 0 { print_str(g_pkg_err, str_len(g_pkg_err)) }
        print("\n")
    }
    ret 0
}
