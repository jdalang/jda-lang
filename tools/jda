#!/bin/bash
# jda — Unified CLI for the Jda programming language
#
# Usage:
#   jda build [--target <os/arch>] [--include <lib>] <file.jda> [-o output]
#   jda run [--include <lib>] <file.jda>
#   jda repl
#   jda test <file.jda | dir/>
#   jda fmt [--check|--diff] <file.jda | dir/>
#   jda doc [--output <dir>] <file.jda | dir/>
#   jda pkg <init|add|build|deps>
#   jda version
#   jda help
#
# Cross-compilation:
#   jda build --target linux/arm64 file.jda -o out
#   jda build --target darwin/arm64 file.jda -o out
#   jda build --target darwin/x86_64 file.jda -o out
#   jda build --target darwin/universal file.jda -o out
#   jda build --target wasm file.jda -o out.wasm
#   jda build --target wasm/browser file.jda -o out.wasm
#
# Environment variables:
#   JDAOS     Override target OS (linux, darwin, wasm)
#   JDAARCH   Override target architecture (amd64, arm64, x86_64, universal, browser)
#   JDA       Override path to jda1 compiler binary

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Locate jda1 compiler binary
JDA1="${JDA:-$PROJECT_ROOT/bootstrap/stage0/jda1}"

print_help() {
    cat <<'HELP'
jda — The Jda Programming Language

Usage: jda <command> [options]

Commands:
  build   Compile a .jda file to a binary
  run     Compile and execute a .jda file
  repl    Start the interactive REPL
  test    Run test files with assertions
  fuzz    Fuzz test fn fuzz_* functions with random inputs
  race    Run with data race detection on g_* globals
  fmt     Format .jda source files
  doc     Generate documentation from doc comments
  pkg     Package manager (init, add, build, deps)

Info:
  version   Print version
  help      Print this help message

Cross-compilation:
  jda build --target linux/amd64 file.jda       Native x86-64 Linux (default)
  jda build --target linux/arm64 file.jda       ARM64 Linux
  jda build --target darwin/arm64 file.jda      macOS ARM64 (Apple Silicon)
  jda build --target darwin/x86_64 file.jda     macOS x86-64 (Intel)
  jda build --target darwin/universal file.jda   macOS universal binary
  jda build --target wasm file.jda              WebAssembly (WASI)
  jda build --target wasm/browser file.jda      WebAssembly (browser)

Environment variables (alternative to --target):
  JDAOS=darwin JDAARCH=arm64 jda build file.jda
  JDA=/path/to/jda1  Override compiler binary

Examples:
  jda build hello.jda -o hello
  jda build --include stdlib/vec.jda app.jda -o app
  jda build --target linux/arm64 server.jda -o server
  jda run hello.jda
  jda test tests/
  jda fmt src/
HELP
}

# Parse target into OS and ARCH
# Accepts: "linux/amd64", "darwin/arm64", "wasm", "wasm/browser", etc.
parse_target() {
    local target="$1"
    case "$target" in
        */*)
            JDAOS="${target%%/*}"
            JDAARCH="${target#*/}"
            ;;
        wasm)
            JDAOS="wasm"
            JDAARCH="wasi"
            ;;
        *)
            echo "jda: invalid target '$target'" >&2
            echo "Valid targets: linux/amd64, linux/arm64, darwin/arm64, darwin/x86_64, darwin/universal, wasm, wasm/browser" >&2
            exit 1
            ;;
    esac
}

# Route build to the correct backend based on JDAOS/JDAARCH
build_with_target() {
    local target_os="${JDAOS:-linux}"
    local target_arch="${JDAARCH:-amd64}"

    case "$target_os/$target_arch" in
        linux/amd64|linux/x86_64)
            exec "$JDA1" build "$@"
            ;;
        linux/arm64|linux/aarch64)
            exec bash "$SCRIPT_DIR/jda-arm64.sh" "$@"
            ;;
        darwin/arm64|darwin/aarch64)
            exec bash "$SCRIPT_DIR/jda-macos.sh" --arch arm64 "$@"
            ;;
        darwin/x86_64|darwin/amd64)
            exec bash "$SCRIPT_DIR/jda-macos.sh" --arch x86_64 "$@"
            ;;
        darwin/universal)
            exec bash "$SCRIPT_DIR/jda-macos.sh" --universal "$@"
            ;;
        wasm/wasi|wasm/wasm)
            exec bash "$SCRIPT_DIR/jda-wasm.sh" "$@"
            ;;
        wasm/browser)
            exec bash "$SCRIPT_DIR/jda-wasm.sh" --target browser "$@"
            ;;
        *)
            echo "jda: unsupported target '$target_os/$target_arch'" >&2
            echo "Valid targets: linux/amd64, linux/arm64, darwin/arm64, darwin/x86_64, darwin/universal, wasm, wasm/browser" >&2
            exit 1
            ;;
    esac
}

if [ $# -eq 0 ]; then
    print_help
    exit 0
fi

CMD="$1"
shift

case "$CMD" in
    build)
        # Check for --target flag before passing to backend
        ARGS=()
        while [ $# -gt 0 ]; do
            case "$1" in
                --target)
                    if [ $# -lt 2 ]; then
                        echo "jda: --target requires a value (e.g., linux/arm64)" >&2
                        exit 1
                    fi
                    parse_target "$2"
                    shift 2
                    ;;
                *)
                    ARGS+=("$1")
                    shift
                    ;;
            esac
        done
        build_with_target "${ARGS[@]}"
        ;;
    run)
        # Compile to temp binary via build, execute it, clean up
        TMPBIN="/tmp/jda_run_$$"
        "$JDA1" build "$@" -o "$TMPBIN"
        chmod +x "$TMPBIN"
        "$TMPBIN"
        RC=$?
        rm -f "$TMPBIN"
        exit $RC
        ;;
    repl)
        exec "$JDA1" repl "$@"
        ;;
    test)
        exec "$SCRIPT_DIR/jda-test.sh" "$@"
        ;;
    fuzz)
        exec bash "$SCRIPT_DIR/jda-fuzz.sh" "$@"
        ;;
    race)
        exec bash "$SCRIPT_DIR/jda-race.sh" "$@"
        ;;
    fmt)
        exec "$SCRIPT_DIR/jda-fmt.sh" "$@"
        ;;
    doc)
        exec "$SCRIPT_DIR/jda-doc.sh" "$@"
        ;;
    pkg)
        exec "$SCRIPT_DIR/jda-pkg.sh" "$@"
        ;;
    version|--version|-V)
        exec "$JDA1" --version
        ;;
    help|--help|-h)
        print_help
        exit 0
        ;;
    *)
        echo "jda: unknown command '$CMD'" >&2
        echo "Run 'jda help' for usage." >&2
        exit 1
        ;;
esac
