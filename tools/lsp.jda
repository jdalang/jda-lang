// =============================================================================
// jda::lsp — Language Server Protocol Server
// =============================================================================
// Implements the core LSP 3.17 protocol over stdin/stdout (JSON-RPC 2.0).
// Provides IDE features for the Jda language:
//
//   ✓  initialize / shutdown / exit
//   ✓  textDocument/didOpen, didChange, didClose
//   ✓  textDocument/publishDiagnostics  (syntax + type errors via fmt.jda)
//   ✓  textDocument/hover               (type info + doc comment)
//   ✓  textDocument/completion          (keywords, symbols in scope)
//   ✓  textDocument/definition          (go-to-definition)
//   ✓  textDocument/documentSymbol      (outline view)
//   ✓  textDocument/formatting          (indentation normaliser)
//   ✓  workspace/symbol
//
// Transport: Content-Length: <n>\r\n\r\n<json>
// All JSON encoding/decoding via jda::json.
// Error diagnostics generated by jda::fmt::DiagEmitter.
//
// Usage:
//   Invoked by editors (VS Code, Neovim, Emacs) via the extension config:
//     "command": ["jda", "lsp"]
// =============================================================================

import jda::json::{ json_parse, json_write, JsonValue, JsonPair }
import jda::fmt::{ DiagEmitter, Diag, Label, Span, Level }
import jda::fs::{ File, file_read }
import jda::stdlib::{ HashMap }

// =============================================================================
// JSON-RPC 2.0 message types
// =============================================================================
struct RpcRequest {
    id:     JsonValue   // number | string | null
    method: []i8
    params: JsonValue
}

struct RpcResponse {
    id:     JsonValue
    result: JsonValue
    error:  ?RpcError
}

struct RpcError {
    code:    i64
    message: []i8
}

// JSON-RPC error codes
const ERR_PARSE_ERROR      = -32700
const ERR_INVALID_REQUEST  = -32600
const ERR_METHOD_NOT_FOUND = -32601
const ERR_INVALID_PARAMS   = -32602
const ERR_INTERNAL         = -32603

// =============================================================================
// Document store — in-memory map of URI → source text
// =============================================================================
struct DocStore {
    docs: []DocEntry   // flat list (small enough for linear scan)
    n:    i64
}

struct DocEntry {
    uri:  []i8
    text: []i8
    ver:  i64
}

impl DocStore {
    fn new() -> own DocStore {
        ret DocStore { docs: [256]DocEntry, n: 0 }
    }

    fn put(self, uri: ref []i8, text: ref []i8, ver: i64) {
        loop i in 0..self.n {
            if str_eq(self.docs[i].uri, uri) {
                self.docs[i].text = text
                self.docs[i].ver  = ver
                ret
            }
        }
        if self.n < 256 {
            self.docs[self.n] = DocEntry { uri: uri, text: text, ver: ver }
            self.n = self.n + 1
        }
    }

    fn get(self, uri: ref []i8) -> ?[]i8 {
        loop i in 0..self.n {
            if str_eq(self.docs[i].uri, uri) { ret some(self.docs[i].text) }
        }
        ret none
    }

    fn remove(self, uri: ref []i8) {
        loop i in 0..self.n {
            if str_eq(self.docs[i].uri, uri) {
                // shift remaining entries down
                loop j in i..(self.n - 1) { self.docs[j] = self.docs[j+1] }
                self.n = self.n - 1
                ret
            }
        }
    }
}

// =============================================================================
// LSP Server state
// =============================================================================
struct LspServer {
    docs:          own DocStore
    initialized:   bool
    shutdown:      bool
    root_uri:      []i8

    // Buffers
    read_buf:  [65536]i8
    write_buf: [65536]i8
}

impl LspServer {
    fn new() -> own LspServer {
        ret LspServer {
            docs:        DocStore::new(),
            initialized: false,
            shutdown:    false,
            root_uri:    "",
            read_buf:    [0; 65536],
            write_buf:   [0; 65536],
        }
    }

    // ---- main event loop ---------------------------------------------------
    fn run(self) {
        loop not self.shutdown {
            match self.read_message() {
                err(e) => {
                    if e == "eof" { break }
                    self.log(fmt_str("read error: {}", [ArgStr(e)]))
                    break
                }
                ok(msg) => {
                    self.handle_message(msg)
                }
            }
        }
    }

    // ---- read one LSP message from stdin -----------------------------------
    // Format: "Content-Length: <N>\r\n\r\n<json>"
    fn read_message(self) -> Result<[]i8, []i8> {
        // Read headers until \r\n\r\n
        let header_buf = [512]i8
        let hlen = 0i64
        let content_len = 0i64

        loop {
            let n = syscall(SYS_READ, 0, header_buf[hlen..512], 1) as i64
            if n <= 0 { ret err("eof") }
            hlen = hlen + n

            // Look for end of headers
            if hlen >= 4 and
               header_buf[hlen-4] == '\r' and header_buf[hlen-3] == '\n' and
               header_buf[hlen-2] == '\r' and header_buf[hlen-1] == '\n' {
                content_len = parse_content_length(header_buf[0..hlen])
                break
            }
        }

        if content_len <= 0 or content_len > 65535 {
            ret err("invalid Content-Length")
        }

        // Read exactly content_len bytes
        let total = 0i64
        loop total < content_len {
            let n = syscall(SYS_READ, 0,
                             self.read_buf[total..content_len],
                             content_len - total) as i64
            if n <= 0 { ret err("eof reading body") }
            total = total + n
        }
        ret ok(self.read_buf[0..content_len])
    }

    // ---- dispatch a message -------------------------------------------------
    fn handle_message(self, raw: ref []i8) {
        let json = match json_parse(raw) {
            err(e) => { self.send_error(JsonValue::Null, ERR_PARSE_ERROR, e)   ret }
            ok(v)  => v
        }

        let method = match json.get("method") {
            err(_) => { ret }   // response — ignore
            ok(v)  => match v.as_str() {
                err(_) => { ret }
                ok(s)  => s
            }
        }

        let id     = json.get("id").unwrap_or(JsonValue::Null)
        let params = json.get("params").unwrap_or(JsonValue::Null)

        match method {
            "initialize"                   => self.on_initialize(id, params)
            "initialized"                  => {}
            "shutdown"                     => self.on_shutdown(id)
            "exit"                         => self.shutdown = true
            "textDocument/didOpen"         => self.on_did_open(params)
            "textDocument/didChange"       => self.on_did_change(params)
            "textDocument/didClose"        => self.on_did_close(params)
            "textDocument/hover"           => self.on_hover(id, params)
            "textDocument/completion"      => self.on_completion(id, params)
            "textDocument/definition"      => self.on_definition(id, params)
            "textDocument/documentSymbol"  => self.on_doc_symbol(id, params)
            "textDocument/formatting"      => self.on_formatting(id, params)
            "workspace/symbol"             => self.on_workspace_symbol(id, params)
            _                              => {
                self.send_error(id, ERR_METHOD_NOT_FOUND,
                                fmt_str("method not found: {}", [ArgStr(method)]))
            }
        }
    }

    // ---- initialize ---------------------------------------------------------
    fn on_initialize(self, id: JsonValue, params: JsonValue) {
        self.initialized = true
        match params.get("rootUri") {
            ok(v) => match v.as_str() {
                ok(s) => self.root_uri = s
                _     => {}
            }
            _ => {}
        }

        let result = json_object([
            ("capabilities", json_object([
                ("textDocumentSync",   json_int(1)),   // Incremental
                ("hoverProvider",      json_bool(true)),
                ("completionProvider", json_object([
                    ("triggerCharacters", json_array([".", ":"])),
                ])),
                ("definitionProvider",     json_bool(true)),
                ("documentSymbolProvider", json_bool(true)),
                ("documentFormattingProvider", json_bool(true)),
                ("workspaceSymbolProvider",    json_bool(true)),
            ])),
            ("serverInfo", json_object([
                ("name",    json_str("jda-lsp")),
                ("version", json_str("0.1.0")),
            ])),
        ])
        self.send_response(id, result)
    }

    fn on_shutdown(self, id: JsonValue) {
        self.shutdown = true
        self.send_response(id, JsonValue::Null)
    }

    // ---- document sync ------------------------------------------------------
    fn on_did_open(self, params: JsonValue) {
        let td   = params.get("textDocument").unwrap_or(JsonValue::Null)
        let uri  = td.get("uri").and_then(|v| v.as_str()).unwrap_or("")
        let text = td.get("text").and_then(|v| v.as_str()).unwrap_or("")
        let ver  = td.get("version").and_then(|v| v.as_i64()).unwrap_or(0)
        self.docs.put(uri, text, ver)
        self.publish_diagnostics(uri, text)
    }

    fn on_did_change(self, params: JsonValue) {
        let td      = params.get("textDocument").unwrap_or(JsonValue::Null)
        let uri     = td.get("uri").and_then(|v| v.as_str()).unwrap_or("")
        let ver     = td.get("version").and_then(|v| v.as_i64()).unwrap_or(0)
        let changes = params.get("contentChanges").unwrap_or(JsonValue::Null)

        // For full-sync (TextDocumentSyncKind.Full) take last change
        let new_text = ""
        match changes {
            JsonValue::Array(items) => {
                if items.len > 0 {
                    new_text = items[items.len-1].get("text")
                               .and_then(|v| v.as_str()).unwrap_or("")
                }
            }
            _ => {}
        }
        self.docs.put(uri, new_text, ver)
        self.publish_diagnostics(uri, new_text)
    }

    fn on_did_close(self, params: JsonValue) {
        let uri = params.get("textDocument")
                        .and_then(|v| v.get("uri"))
                        .and_then(|v| v.as_str()).unwrap_or("")
        self.docs.remove(uri)
        // Clear diagnostics for this file
        self.send_notification("textDocument/publishDiagnostics",
            json_object([("uri", json_str(uri)),
                         ("diagnostics", json_array([]))]))
    }

    // ---- diagnostics ---------------------------------------------------------
    fn publish_diagnostics(self, uri: ref []i8, text: ref []i8) {
        let diags = Vec<JsonValue>::new()
        let errors = lint_source(text)

        for e in errors {
            diags.push(json_object([
                ("range",   lsp_range(e.line, e.col, e.line, e.col + e.len)),
                ("severity", json_int(lsp_severity(e.level))),
                ("code",    json_str(e.code)),
                ("source",  json_str("jda")),
                ("message", json_str(e.msg)),
            ]))
        }

        self.send_notification("textDocument/publishDiagnostics",
            json_object([
                ("uri",         json_str(uri)),
                ("diagnostics", json_array_val(diags.as_slice())),
            ]))
    }

    // ---- hover ---------------------------------------------------------------
    fn on_hover(self, id: JsonValue, params: JsonValue) {
        let (uri, line, col) = extract_position(params)
        let text = self.docs.get(uri).unwrap_or("")
        let word = word_at(text, line, col)

        if word.len == 0 {
            self.send_response(id, JsonValue::Null)
            ret
        }

        let doc  = builtin_doc(word)
        let hover = if doc.len > 0 {
            json_object([
                ("contents", json_object([
                    ("kind",  json_str("markdown")),
                    ("value", json_str(doc)),
                ])),
            ])
        } else {
            JsonValue::Null
        }
        self.send_response(id, hover)
    }

    // ---- completion ----------------------------------------------------------
    fn on_completion(self, id: JsonValue, params: JsonValue) {
        let (uri, line, col) = extract_position(params)
        let text    = self.docs.get(uri).unwrap_or("")
        let prefix  = word_before(text, line, col)

        let items   = Vec<JsonValue>::new()

        // Keywords
        let keywords = ["fn", "let", "mut", "ret", "if", "else", "loop",
                         "for", "match", "struct", "enum", "impl", "import",
                         "const", "defer", "spawn", "tensor", "own", "ref",
                         "and", "or", "not", "in", "break", "continue"]
        for kw in keywords {
            if str_starts_with(kw, prefix) {
                items.push(json_object([
                    ("label",  json_str(kw)),
                    ("kind",   json_int(14)),   // Keyword
                    ("detail", json_str("keyword")),
                ]))
            }
        }

        // Symbols from open document
        let syms = extract_symbols(text)
        for sym in syms {
            if str_starts_with(sym.name, prefix) {
                items.push(json_object([
                    ("label",  json_str(sym.name)),
                    ("kind",   json_int(sym.kind)),
                    ("detail", json_str(sym.detail)),
                ]))
            }
        }

        self.send_response(id, json_array_val(items.as_slice()))
    }

    // ---- definition ----------------------------------------------------------
    fn on_definition(self, id: JsonValue, params: JsonValue) {
        let (uri, line, col) = extract_position(params)
        let text = self.docs.get(uri).unwrap_or("")
        let word = word_at(text, line, col)

        let def_loc = find_definition(text, word)
        match def_loc {
            none => self.send_response(id, JsonValue::Null)
            some((def_line, def_col)) => {
                self.send_response(id, json_object([
                    ("uri",   json_str(uri)),
                    ("range", lsp_range(def_line, def_col,
                                        def_line, def_col + word.len as i64)),
                ]))
            }
        }
    }

    // ---- document symbols ---------------------------------------------------
    fn on_doc_symbol(self, id: JsonValue, params: JsonValue) {
        let uri  = params.get("textDocument")
                         .and_then(|v| v.get("uri"))
                         .and_then(|v| v.as_str()).unwrap_or("")
        let text = self.docs.get(uri).unwrap_or("")
        let syms = extract_symbols(text)
        let result = Vec<JsonValue>::new()

        for sym in syms {
            result.push(json_object([
                ("name",           json_str(sym.name)),
                ("kind",           json_int(sym.kind)),
                ("location",       json_object([
                    ("uri",   json_str(uri)),
                    ("range", lsp_range(sym.line, 0, sym.line, 80)),
                ])),
            ]))
        }
        self.send_response(id, json_array_val(result.as_slice()))
    }

    // ---- formatting ----------------------------------------------------------
    fn on_formatting(self, id: JsonValue, params: JsonValue) {
        let uri  = params.get("textDocument")
                         .and_then(|v| v.get("uri"))
                         .and_then(|v| v.as_str()).unwrap_or("")
        let text = self.docs.get(uri).unwrap_or("")
        let formatted = format_jda(text)

        let line_count = count_lines(text)
        let edit = json_object([
            ("range", lsp_range(0, 0, line_count, 0)),
            ("newText", json_str(formatted)),
        ])
        self.send_response(id, json_array_val([edit]))
    }

    // ---- workspace symbol ---------------------------------------------------
    fn on_workspace_symbol(self, id: JsonValue, params: JsonValue) {
        let query = params.get("query").and_then(|v| v.as_str()).unwrap_or("")
        let result = Vec<JsonValue>::new()

        loop i in 0..self.docs.n {
            let e    = &self.docs.docs[i]
            let syms = extract_symbols(e.text)
            for sym in syms {
                if query.len == 0 or str_contains(sym.name, query) {
                    result.push(json_object([
                        ("name", json_str(sym.name)),
                        ("kind", json_int(sym.kind)),
                        ("location", json_object([
                            ("uri",   json_str(e.uri)),
                            ("range", lsp_range(sym.line, 0, sym.line, 80)),
                        ])),
                    ]))
                }
            }
        }
        self.send_response(id, json_array_val(result.as_slice()))
    }

    // ---- transport -----------------------------------------------------------
    fn send_response(self, id: JsonValue, result: JsonValue) {
        let msg = json_object([
            ("jsonrpc", json_str("2.0")),
            ("id",      id),
            ("result",  result),
        ])
        self.send_json(msg)
    }

    fn send_error(self, id: JsonValue, code: i64, message: ref []i8) {
        let msg = json_object([
            ("jsonrpc", json_str("2.0")),
            ("id",      id),
            ("error",   json_object([
                ("code",    json_int(code)),
                ("message", json_str(message)),
            ])),
        ])
        self.send_json(msg)
    }

    fn send_notification(self, method: ref []i8, params: JsonValue) {
        let msg = json_object([
            ("jsonrpc", json_str("2.0")),
            ("method",  json_str(method)),
            ("params",  params),
        ])
        self.send_json(msg)
    }

    fn send_json(self, val: JsonValue) {
        let body_n  = json_write(&val, self.write_buf, 65536)
        let header  = [64]i8
        let hdr_n   = write_fmt("Content-Length: {}\r\n\r\n",
                                 [ArgI64(body_n)], header, 64)
        syscall(SYS_WRITE, 1, header,          hdr_n)
        syscall(SYS_WRITE, 1, self.write_buf,  body_n)
    }

    fn log(self, msg: ref []i8) {
        // Write to stderr (fd=2)
        syscall(SYS_WRITE, 2, msg, msg.len)
        syscall(SYS_WRITE, 2, "\n", 1)
    }
}

// =============================================================================
// Source analysis helpers (minimal — calls into the Stage 1 lexer/parser)
// =============================================================================

struct LintError {
    line:  i64
    col:   i64
    len:   i64
    level: Level
    code:  []i8
    msg:   []i8
}

struct Symbol {
    name:   []i8
    kind:   i64    // LSP SymbolKind: 12=function, 23=struct, 10=enum, 6=method
    line:   i64
    detail: []i8
}

// Lightweight lint: scan for obvious issues without a full parse
fn lint_source(src: ref []i8) -> []LintError {
    let errors = Vec<LintError>::new()
    let lines   = src.split('\n')

    loop ln in 0..lines.len {
        let line = lines[ln]
        // Check for tab characters (Jda uses spaces)
        loop col in 0..line.len {
            if line[col] == '\t' {
                errors.push(LintError {
                    line: ln, col: col, len: 1,
                    level: Level::Warning,
                    code: "W099", msg: "use spaces, not tabs"
                })
                break
            }
        }
        // Check trailing whitespace
        if line.len > 0 and (line[line.len-1] == ' ' or line[line.len-1] == '\t') {
            errors.push(LintError {
                line: ln, col: line.len-1, len: 1,
                level: Level::Warning,
                code: "W098", msg: "trailing whitespace"
            })
        }
    }
    ret errors.as_slice()
}

// Extract top-level function/struct/enum definitions for symbol outline
fn extract_symbols(src: ref []i8) -> []Symbol {
    let syms  = Vec<Symbol>::new()
    let lines = src.split('\n')

    loop ln in 0..lines.len {
        let line = lines[ln].trim()
        if str_starts_with(line, "fn ") {
            let name = ident_after(line, 3)
            syms.push(Symbol { name: name, kind: 12, line: ln, detail: "fn" })
        } else if str_starts_with(line, "struct ") {
            let name = ident_after(line, 7)
            syms.push(Symbol { name: name, kind: 23, line: ln, detail: "struct" })
        } else if str_starts_with(line, "enum ") {
            let name = ident_after(line, 5)
            syms.push(Symbol { name: name, kind: 10, line: ln, detail: "enum" })
        } else if str_starts_with(line, "impl ") {
            let name = ident_after(line, 5)
            syms.push(Symbol { name: name, kind: 19, line: ln, detail: "impl" })
        } else if str_starts_with(line, "const ") {
            let name = ident_after(line, 6)
            syms.push(Symbol { name: name, kind: 14, line: ln, detail: "const" })
        }
    }
    ret syms.as_slice()
}

// Find the definition of `word` in `src` — returns (line, col) or none
fn find_definition(src: ref []i8, word: ref []i8) -> ?(i64, i64) {
    if word.len == 0 { ret none }
    let lines = src.split('\n')
    loop ln in 0..lines.len {
        let line = lines[ln]
        let targets = [
            fmt_str("fn {}(", [ArgStr(word)]),
            fmt_str("struct {} ", [ArgStr(word)]),
            fmt_str("enum {} ", [ArgStr(word)]),
            fmt_str("let {} ", [ArgStr(word)]),
            fmt_str("const {} ", [ArgStr(word)]),
        ]
        for t in targets {
            let col = str_find(line, t)
            if col >= 0 {
                // advance past keyword
                let name_col = col + t.len - word.len - 1
                ret some((ln, name_col))
            }
        }
    }
    ret none
}

// Simple source formatter — normalise indentation (4 spaces per level)
fn format_jda(src: ref []i8) -> []i8 {
    let out   = [65536]i8
    let pos   = 0i64
    let depth = 0i64
    let lines = src.split('\n')

    for line in lines {
        let trimmed = line.trim()
        if trimmed.len == 0 { out[pos] = '\n'   pos = pos + 1   continue }

        // Decrease depth for closing braces before printing
        if trimmed[0] == '}' and depth > 0 { depth = depth - 1 }

        // Emit indent
        loop i in 0..depth * 4 { out[pos] = ' '   pos = pos + 1 }

        // Emit line content
        loop i in 0..trimmed.len { out[pos] = trimmed[i]   pos = pos + 1 }
        out[pos] = '\n'   pos = pos + 1

        // Increase depth if line ends with {
        if trimmed.len > 0 and trimmed[trimmed.len-1] == '{' {
            depth = depth + 1
        }
    }
    ret out[0..pos]
}

// =============================================================================
// JSON construction helpers
// =============================================================================

fn json_str(s: ref []i8) -> JsonValue { ret JsonValue::Str(s) }
fn json_int(n: i64)      -> JsonValue { ret JsonValue::Int(n) }
fn json_bool(b: bool)    -> JsonValue { ret JsonValue::Bool(b) }

fn json_object(pairs: ref []([]i8, JsonValue)) -> JsonValue {
    let jps = [pairs.len]JsonPair
    loop i in 0..pairs.len {
        jps[i] = JsonPair { key: pairs[i].0, val: pairs[i].1 }
    }
    ret JsonValue::Object(jps[0..pairs.len])
}

fn json_array(strs: ref [][]i8) -> JsonValue {
    let items = [strs.len]JsonValue
    loop i in 0..strs.len { items[i] = JsonValue::Str(strs[i]) }
    ret JsonValue::Array(items[0..strs.len])
}

fn json_array_val(items: ref []JsonValue) -> JsonValue {
    ret JsonValue::Array(items)
}

fn lsp_range(sl: i64, sc: i64, el: i64, ec: i64) -> JsonValue {
    ret json_object([
        ("start", json_object([("line", json_int(sl)), ("character", json_int(sc))])),
        ("end",   json_object([("line", json_int(el)), ("character", json_int(ec))])),
    ])
}

fn lsp_severity(level: Level) -> i64 {
    match level {
        Level::Error   => 1
        Level::Warning => 2
        Level::Info    => 3
        Level::Note    => 4
        Level::Help    => 4
    }
}

// =============================================================================
// Text utilities
// =============================================================================

fn parse_content_length(header: ref []i8) -> i64 {
    let prefix = "Content-Length: "
    loop i in 0..header.len {
        if str_starts_with(header[i..header.len], prefix) {
            let start = i + prefix.len
            let n     = 0i64
            loop start < header.len and header[start] >= '0'
                                    and header[start] <= '9' {
                n     = n * 10 + (header[start] - '0') as i64
                start = start + 1
            }
            ret n
        }
    }
    ret 0
}

fn extract_position(params: JsonValue) -> ([]i8, i64, i64) {
    let uri  = params.get("textDocument").and_then(|v| v.get("uri"))
                     .and_then(|v| v.as_str()).unwrap_or("")
    let pos  = params.get("position").unwrap_or(JsonValue::Null)
    let line = pos.get("line").and_then(|v| v.as_i64()).unwrap_or(0)
    let col  = pos.get("character").and_then(|v| v.as_i64()).unwrap_or(0)
    ret (uri, line, col)
}

fn word_at(src: ref []i8, line: i64, col: i64) -> []i8 {
    let lines = src.split('\n')
    if line >= lines.len { ret "" }
    let ln = lines[line]
    if col >= ln.len { ret "" }
    let start = col
    let end   = col
    loop start > 0 and is_ident_char(ln[start-1]) { start = start - 1 }
    loop end < ln.len and is_ident_char(ln[end])  { end   = end   + 1 }
    ret ln[start..end]
}

fn word_before(src: ref []i8, line: i64, col: i64) -> []i8 {
    let lines = src.split('\n')
    if line >= lines.len { ret "" }
    let ln    = lines[line]
    let end   = if col > ln.len { ln.len } else { col }
    let start = end
    loop start > 0 and is_ident_char(ln[start-1]) { start = start - 1 }
    ret ln[start..end]
}

fn is_ident_char(c: i8) -> bool {
    ret (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or
        (c >= '0' and c <= '9') or c == '_'
}

fn ident_after(line: ref []i8, off: i64) -> []i8 {
    let i = off
    loop i < line.len and not is_ident_char(line[i]) { i = i + 1 }
    let start = i
    loop i < line.len and is_ident_char(line[i]) { i = i + 1 }
    ret line[start..i]
}

fn count_lines(src: ref []i8) -> i64 {
    let n = 0i64
    for c in src { if c == '\n' { n = n + 1 } }
    ret n
}

// Built-in documentation for Jda keywords and builtins
fn builtin_doc(word: ref []i8) -> []i8 {
    match word {
        "fn"     => "**fn** — declare a function\n```jda\nfn name(arg: type) -> ret_type { ... }\n```"
        "let"    => "**let** — bind an immutable variable\n```jda\nlet x = 42\n```"
        "mut"    => "**mut** — mutable variable qualifier\n```jda\nlet mut x = 0\n```"
        "ret"    => "**ret** — return a value from a function"
        "spawn"  => "**spawn** — launch a J-Thread\n```jda\nspawn { work() }\n```"
        "tensor" => "**tensor** — declare a native tensor (shape-checked at compile time)\n```jda\ntensor W = [768 x 768]f32::randn()\n```"
        "match"  => "**match** — exhaustive pattern matching\n```jda\nmatch x {\n    Ok(v) => ...\n    Err(e) => ...\n}\n```"
        "defer"  => "**defer** — run a statement when the current scope exits"
        "own"    => "**own** — owned (uniquely owned) type qualifier"
        "ref"    => "**ref** — shared borrow qualifier"
        _        => ""
    }
}

fn str_starts_with(s: ref []i8, prefix: ref []i8) -> bool {
    if prefix.len > s.len { ret false }
    loop i in 0..prefix.len { if s[i] != prefix[i] { ret false } }
    ret true
}

fn str_contains(s: ref []i8, sub: ref []i8) -> bool {
    ret str_find(s, sub) >= 0
}

fn str_find(s: ref []i8, sub: ref []i8) -> i64 {
    if sub.len > s.len { ret -1 }
    loop i in 0..(s.len - sub.len + 1) {
        let ok = true
        loop j in 0..sub.len { if s[i+j] != sub[j] { ok = false   break } }
        if ok { ret i }
    }
    ret -1
}

// =============================================================================
// Entry point
// =============================================================================
fn lsp_main() {
    let server = LspServer::new()
    server.run()
}
