// textDocument/publishDiagnostics for the document at `idx`.
fn publish_diagnostics(idx: i64) {
    if idx < 0 { ret 0 }
    let toff = g_doc_txt_off[idx]
    let tlen = g_doc_txt_len[idx]
    lint_source(g_arena, toff, toff + tlen)
    out_begin()
    w_ch(44)
    w_key("method")
    w_qlit("textDocument/publishDiagnostics")
    w_ch(44)
    w_key("params")
    w_ch(123)
    w_key("uri")
    w_qspan(g_arena, g_doc_uri_off[idx], g_doc_uri_len[idx])
    w_ch(44)
    w_key("diagnostics")
    w_ch(91)
    let i = 0
    loop i < g_diag_cnt {
        if i > 0 { w_ch(44) }
        w_ch(123)
        w_range(g_diag_line[i], g_diag_col[i], g_diag_line[i], g_diag_col[i] + g_diag_len[i])
        w_ch(44)
        w_key("severity")
        w_int(g_diag_sev[i])
        w_ch(44)
        w_key("code")
        w_qlit(lint_code_str(g_diag_code[i]))
        w_ch(44)
        w_key("source")
        w_qlit("jda")
        w_ch(44)
        w_key("message")
        w_qlit(lint_msg_str(g_diag_code[i]))
        w_ch(125)
        i = i + 1
    }
    w_ch(93)
    w_ch(125)
    w_ch(125)
    out_flush()
}

fn clear_diagnostics(uri: &i8, uoff: i64, ulen: i64) {
    out_begin()
    w_ch(44)
    w_key("method")
    w_qlit("textDocument/publishDiagnostics")
    w_ch(44)
    w_key("params")
    w_ch(123)
    w_key("uri")
    w_qspan(uri, uoff, ulen)
    w_ch(44)
    w_key("diagnostics")
    w_lit("[]")
    w_ch(125)
    w_ch(125)
    out_flush()
}

fn on_did_open(params: i64) {
    let td = obj_get_lit(params, "textDocument")
    if td < 0 { ret 0 }
    if member_str(td, "uri") == 0 { ret 0 }
    let uoff = g_span_off
    let ulen = g_span_len
    let toff = 0
    let tlen = 0
    if member_str(td, "text") == 1 {
        toff = g_span_off
        tlen = g_span_len
    }
    let idx = doc_put(g_in, uoff, ulen, g_in, toff, tlen)
    publish_diagnostics(idx)
}

// Full-document sync only: the server advertises textDocumentSync 1, so each
// change carries the whole text and the last entry wins.
fn on_did_change(params: i64) {
    let td = obj_get_lit(params, "textDocument")
    if td < 0 { ret 0 }
    if member_str(td, "uri") == 0 { ret 0 }
    let uoff = g_span_off
    let ulen = g_span_len
    let changes = obj_get_lit(params, "contentChanges")
    let toff = 0
    let tlen = 0
    if changes >= 0 {
        if json_kind(changes) == JSON_ARR {
            let n = json_len(changes)
            if n > 0 {
                let last = json_at(changes, n - 1)
                if member_str(last, "text") == 1 {
                    toff = g_span_off
                    tlen = g_span_len
                }
            }
        }
    }
    let idx = doc_put(g_in, uoff, ulen, g_in, toff, tlen)
    publish_diagnostics(idx)
}

fn on_did_close(params: i64) {
    if params_uri(params) == 0 { ret 0 }
    let uoff = g_span_off
    let ulen = g_span_len
    doc_remove(g_in, uoff, ulen)
    clear_diagnostics(g_in, uoff, ulen)
}

fn on_hover(id: i64, params: i64) {
    let idx = params_doc(params)
    if idx < 0 {
        send_result_null(id)
        ret 0
    }
    params_position(params)
    let toff = g_doc_txt_off[idx]
    let tlen = g_doc_txt_len[idx]
    word_at(g_arena, toff, toff + tlen, g_pos_line, g_pos_col)
    let woff = g_span_off
    let wlen = g_span_len
    if wlen == 0 {
        send_result_null(id)
        ret 0
    }
    let doc = builtin_doc(g_arena, woff, wlen)
    if str_len(doc) == 0 {
        send_result_null(id)
        ret 0
    }
    out_begin()
    w_ch(44)
    w_key("id")
    w_id(id)
    w_ch(44)
    w_key("result")
    w_ch(123)
    w_key("contents")
    w_ch(123)
    w_key("kind")
    w_qlit("markdown")
    w_ch(44)
    w_key("value")
    w_qlit(doc)
    w_ch(125)
    w_ch(125)
    w_ch(125)
    out_flush()
}

fn w_completion_item(label_src: &i8, loff: i64, llen: i64, kind: i64, detail: &i8) {
    w_ch(123)
    w_key("label")
    w_qspan(label_src, loff, llen)
    w_ch(44)
    w_key("kind")
    w_int(kind)
    w_ch(44)
    w_key("detail")
    w_qlit(detail)
    w_ch(125)
}

fn on_completion(id: i64, params: i64) {
    let idx = params_doc(params)
    out_begin()
    w_ch(44)
    w_key("id")
    w_id(id)
    w_ch(44)
    w_key("result")
    w_ch(91)
    let first = 1
    let poff = 0
    let plen = 0
    if idx >= 0 {
        params_position(params)
        let toff = g_doc_txt_off[idx]
        let tlen = g_doc_txt_len[idx]
        word_before(g_arena, toff, toff + tlen, g_pos_line, g_pos_col)
        poff = g_span_off
        plen = g_span_len
    }
    let k = 0
    loop k < COMPLETION_KEYWORDS {
        let kw = completion_keyword(k)
        let keep = 1
        if plen > 0 { keep = prefix_matches(kw, g_arena, poff, plen) }
        if keep == 1 {
            if first == 0 { w_ch(44) }
            first = 0
            w_completion_item(kw, 0, str_len(kw), SYM_KEYWORD, "keyword")
        }
        k = k + 1
    }
    if idx >= 0 {
        let toff = g_doc_txt_off[idx]
        let tlen = g_doc_txt_len[idx]
        extract_symbols(g_arena, toff, toff + tlen)
        let i = 0
        loop i < g_sym_cnt {
            let keep = 1
            if plen > 0 {
                keep = span_prefix(g_arena, g_sym_off[i], g_sym_len[i], g_arena, poff, plen)
            }
            if keep == 1 {
                if first == 0 { w_ch(44) }
                first = 0
                w_completion_item(g_arena, g_sym_off[i], g_sym_len[i], g_sym_kind[i], sym_detail(g_sym_kind[i]))
            }
            i = i + 1
        }
    }
    w_ch(93)
    w_ch(125)
    out_flush()
}

// Does the C string `s` begin with the span (poff, plen)?
fn prefix_matches(s: &i8, psrc: &i8, poff: i64, plen: i64) -> i64 {
    if plen > str_len(s) { ret 0 }
    let i = 0
    loop i < plen {
        if get_byte(s, i) != get_byte(psrc, poff + i) { ret 0 }
        i = i + 1
    }
    ret 1
}

// Does the span (off, len) begin with the span (poff, plen)?
fn span_prefix(src: &i8, off: i64, len: i64, psrc: &i8, poff: i64, plen: i64) -> i64 {
    if plen > len { ret 0 }
    let i = 0
    loop i < plen {
        if get_byte(src, off + i) != get_byte(psrc, poff + i) { ret 0 }
        i = i + 1
    }
    ret 1
}

fn on_definition(id: i64, params: i64) {
    let idx = params_doc(params)
    if idx < 0 {
        send_result_null(id)
        ret 0
    }
    params_position(params)
    let toff = g_doc_txt_off[idx]
    let tlen = g_doc_txt_len[idx]
    word_at(g_arena, toff, toff + tlen, g_pos_line, g_pos_col)
    let woff = g_span_off
    let wlen = g_span_len
    if find_definition(g_arena, toff, toff + tlen, woff, wlen) == 0 {
        send_result_null(id)
        ret 0
    }
    out_begin()
    w_ch(44)
    w_key("id")
    w_id(id)
    w_ch(44)
    w_key("result")
    w_ch(123)
    w_key("uri")
    w_qspan(g_arena, g_doc_uri_off[idx], g_doc_uri_len[idx])
    w_ch(44)
    w_range(g_def_line, g_def_col, g_def_line, g_def_col + wlen)
    w_ch(125)
    w_ch(125)
    out_flush()
}

fn w_symbol_location(uri_off: i64, uri_len: i64, line: i64) {
    w_key("location")
    w_ch(123)
    w_key("uri")
    w_qspan(g_arena, uri_off, uri_len)
    w_ch(44)
    w_range(line, 0, line, 80)
    w_ch(125)
}

fn on_doc_symbol(id: i64, params: i64) {
    let idx = params_doc(params)
    out_begin()
    w_ch(44)
    w_key("id")
    w_id(id)
    w_ch(44)
    w_key("result")
    w_ch(91)
    if idx >= 0 {
        let toff = g_doc_txt_off[idx]
        let tlen = g_doc_txt_len[idx]
        extract_symbols(g_arena, toff, toff + tlen)
        let i = 0
        loop i < g_sym_cnt {
            if i > 0 { w_ch(44) }
            w_ch(123)
            w_key("name")
            w_qspan(g_arena, g_sym_off[i], g_sym_len[i])
            w_ch(44)
            w_key("kind")
            w_int(g_sym_kind[i])
            w_ch(44)
            w_symbol_location(g_doc_uri_off[idx], g_doc_uri_len[idx], g_sym_line[i])
            w_ch(125)
            i = i + 1
        }
    }
    w_ch(93)
    w_ch(125)
    out_flush()
}

fn on_formatting(id: i64, params: i64) {
    let idx = params_doc(params)
    if idx < 0 {
        send_result_null(id)
        ret 0
    }
    let toff = g_doc_txt_off[idx]
    let tlen = g_doc_txt_len[idx]
    let scratch = alloc_pages(OUT_CAP / 4096) as &i8
    let n = format_jda(g_arena, toff, toff + tlen, scratch, OUT_CAP)
    let lines = count_lines(g_arena, toff, toff + tlen)
    out_begin()
    w_ch(44)
    w_key("id")
    w_id(id)
    w_ch(44)
    w_key("result")
    w_ch(91)
    w_ch(123)
    w_range(0, 0, lines + 1, 0)
    w_ch(44)
    w_key("newText")
    w_qspan(scratch, 0, n)
    w_ch(125)
    w_ch(93)
    w_ch(125)
    out_flush()
}

fn on_workspace_symbol(id: i64, params: i64) {
    let qoff = 0
    let qlen = 0
    if member_str(params, "query") == 1 {
        qoff = g_span_off
        qlen = g_span_len
    }
    out_begin()
    w_ch(44)
    w_key("id")
    w_id(id)
    w_ch(44)
    w_key("result")
    w_ch(91)
    let first = 1
    let d = 0
    loop d < g_doc_cnt {
        let toff = g_doc_txt_off[d]
        let tlen = g_doc_txt_len[d]
        extract_symbols(g_arena, toff, toff + tlen)
        let i = 0
        loop i < g_sym_cnt {
            let keep = 1
            if qlen > 0 {
                keep = span_contains(g_arena, g_sym_off[i], g_sym_len[i], g_in, qoff, qlen)
            }
            if keep == 1 {
                if first == 0 { w_ch(44) }
                first = 0
                w_ch(123)
                w_key("name")
                w_qspan(g_arena, g_sym_off[i], g_sym_len[i])
                w_ch(44)
                w_key("kind")
                w_int(g_sym_kind[i])
                w_ch(44)
                w_symbol_location(g_doc_uri_off[d], g_doc_uri_len[d], g_sym_line[i])
                w_ch(125)
            }
            i = i + 1
        }
        d = d + 1
    }
    w_ch(93)
    w_ch(125)
    out_flush()
}

// Substring test between two spans, used for the workspace/symbol query.
fn span_contains(src: &i8, off: i64, len: i64, nsrc: &i8, noff: i64, nlen: i64) -> i64 {
    if nlen == 0 { ret 1 }
    if nlen > len { ret 0 }
    let last = len - nlen
    let i = 0
    loop i <= last {
        if span_prefix(src, off + i, len - i, nsrc, noff, nlen) == 1 { ret 1 }
        i = i + 1
    }
    ret 0
}

// =============================================================================
// Dispatch
// =============================================================================

fn method_is(m: i64, name: &i8) -> i64 {
    if m < 0 { ret 0 }
    if json_kind(m) != JSON_STR { ret 0 }
    ret span_eq_lit(g_in, json_str_value_off(m), json_str_value_len(m), name)
}

fn handle_message(len: i64) {
    let root = json_parse(g_in, len)
    if root < 0 {
        send_error(0 - 1, ERR_PARSE_ERROR, "invalid JSON")
        ret 0
    }
    if json_kind(root) != JSON_OBJ {
        send_error(0 - 1, ERR_INVALID_REQUEST, "expected a JSON object")
        ret 0
    }
    let m = obj_get_lit(root, "method")
    if m < 0 { ret 0 }
    let id = obj_get_lit(root, "id")
    let params = obj_get_lit(root, "params")

    if method_is(m, "initialize") == 1 {
        on_initialize(id)
        ret 0
    }
    if method_is(m, "initialized") == 1 { ret 0 }
    if method_is(m, "shutdown") == 1 {
        g_shutdown = 1
        send_result_null(id)
        ret 0
    }
    if method_is(m, "exit") == 1 {
        g_exit = 1
        ret 0
    }
    if method_is(m, "textDocument/didOpen") == 1 {
        on_did_open(params)
        ret 0
    }
    if method_is(m, "textDocument/didChange") == 1 {
        on_did_change(params)
        ret 0
    }
    if method_is(m, "textDocument/didClose") == 1 {
        on_did_close(params)
        ret 0
    }
    if method_is(m, "textDocument/hover") == 1 {
        on_hover(id, params)
        ret 0
    }
    if method_is(m, "textDocument/completion") == 1 {
        on_completion(id, params)
        ret 0
    }
    if method_is(m, "textDocument/definition") == 1 {
        on_definition(id, params)
        ret 0
    }
    if method_is(m, "textDocument/documentSymbol") == 1 {
        on_doc_symbol(id, params)
        ret 0
    }
    if method_is(m, "textDocument/formatting") == 1 {
        on_formatting(id, params)
        ret 0
    }
    if method_is(m, "workspace/symbol") == 1 {
        on_workspace_symbol(id, params)
        ret 0
    }
    // Notifications carry no id and must not be answered.
    if id >= 0 {
        send_error(id, ERR_METHOD_NOT_FOUND, "method not found")
    }
}

// =============================================================================
// Message framing
// =============================================================================

// Reads one byte from stdin; -1 at end of input.
fn read_byte() -> i64 {
    let b = i8[8]
    let n = syscall(0, 0, b, 1)
    if n <= 0 { ret 0 - 1 }
    ret get_byte(b, 0) & 255
}

// Reads headers up to the blank line and returns Content-Length, or -1 on EOF.
fn read_headers() -> i64 {
    let hdr = i8[512]
    let n = 0
    let content_len = 0 - 1
    let done = 0
    loop done == 0 {
        let c = read_byte()
        if c < 0 { ret 0 - 1 }
        if n < 512 {
            set_byte(hdr, n, c)
            n = n + 1
        }
        if n >= 4 {
            if get_byte(hdr, n - 4) == 13 and get_byte(hdr, n - 3) == 10 {
                if get_byte(hdr, n - 2) == 13 and get_byte(hdr, n - 1) == 10 {
                    done = 1
                }
            }
        }
    }
    let at = span_find(hdr, 0, n, "Content-Length:")
    if at < 0 { ret 0 - 1 }
    let i = at + 15
    loop i < n and is_space(get_byte(hdr, i)) == 1 { i = i + 1 }
    let v = 0
    let any = 0
    loop i < n {
        let c = get_byte(hdr, i)
        if c < 48 { i = n } else {
        if c > 57 { i = n } else {
            v = v * 10 + (c - 48)
            any = 1
            i = i + 1
        }}
    }
    if any == 0 { ret 0 - 1 }
    ret v
}

// Reads one framed message into g_in. Returns its length, or -1 at end of input.
//
// The body is read through a fixed scratch buffer and copied in with set_byte:
// there is no pointer arithmetic on `&i8`, so `read` cannot be pointed at
// g_in + offset directly.
fn read_message() -> i64 {
    let want = read_headers()
    if want < 0 { ret 0 - 1 }
    if want > IN_CAP { ret 0 - 1 }
    let scratch = i8[4096]
    let got = 0
    loop got < want {
        let chunk = want - got
        if chunk > 4096 { chunk = 4096 }
        let n = syscall(0, 0, scratch, chunk)
        if n <= 0 { ret 0 - 1 }
        let i = 0
        loop i < n {
            set_byte(g_in, got + i, get_byte(scratch, i))
            i = i + 1
        }
        got = got + n
    }
    ret got
}

fn lsp_run() {
    loop g_exit == 0 {
        let n = read_message()
        if n < 0 {
            g_exit = 1
        } else {
            handle_message(n)
        }
    }
}

// =============================================================================
// Selftest. Drives the analysis and the JSON encoder without a client, so CI
// can gate this file on behaviour rather than on it merely compiling.
// =============================================================================

let g_fail = 0

fn expect_i64(what: &i8, got: i64, want: i64) {
    print_str(what, str_len(what))
    print(" = {got} want {want}")
    if got == want {
        print(" ok\n")
    } else {
        print(" FAIL\n")
        g_fail = g_fail + 1
    }
}

// Loads a source string into the arena and returns its offset; length in
// g_span_len.
fn arena_lit(s: &i8) -> i64 {
    let n = str_len(s)
    let at = arena_put(s, 0, n)
    g_span_len = n
    ret at
}

fn selftest_spans() {
    let src = "fn main() {\n    let x = 1\n}\n"
    let off = arena_lit(src)
    let len = g_span_len
    let end = off + len
    expect_i64("count_lines", count_lines(g_arena, off, end), 3)
    expect_i64("line_start 1", line_start(g_arena, off, end, 1) - off, 12)
    expect_i64("line_len 0", line_len(g_arena, end, off), 11)
    word_at(g_arena, off, end, 0, 4)
    expect_i64("word_at len", g_span_len, 4)
    expect_i64("word_at is main", span_eq_lit(g_arena, g_span_off, g_span_len, "main"), 1)
    word_before(g_arena, off, end, 1, 9)
    expect_i64("word_before is x", span_eq_lit(g_arena, g_span_off, g_span_len, "x"), 1)
}

fn selftest_symbols() {
    let src = "fn alpha() {\n}\n\nstruct Beta {\n    x: i64\n}\n\nconst GAMMA = 7\n"
    let off = arena_lit(src)
    let end = off + g_span_len
    extract_symbols(g_arena, off, end)
    expect_i64("symbol count", g_sym_cnt, 3)
    expect_i64("sym 0 is alpha", span_eq_lit(g_arena, g_sym_off[0], g_sym_len[0], "alpha"), 1)
    expect_i64("sym 0 kind fn", g_sym_kind[0], SYM_FUNCTION)
    expect_i64("sym 1 is Beta", span_eq_lit(g_arena, g_sym_off[1], g_sym_len[1], "Beta"), 1)
    expect_i64("sym 1 kind struct", g_sym_kind[1], SYM_STRUCT)
    expect_i64("sym 2 is GAMMA", span_eq_lit(g_arena, g_sym_off[2], g_sym_len[2], "GAMMA"), 1)
    expect_i64("sym 2 line", g_sym_line[2], 7)
}

fn selftest_definition() {
    let src = "fn helper() {\n}\n\nfn main() {\n    helper()\n}\n"
    let off = arena_lit(src)
    let end = off + g_span_len
    word_at(g_arena, off, end, 4, 6)
    expect_i64("call word is helper", span_eq_lit(g_arena, g_span_off, g_span_len, "helper"), 1)
    let woff = g_span_off
    let wlen = g_span_len
    expect_i64("definition found", find_definition(g_arena, off, end, woff, wlen), 1)
    expect_i64("definition line", g_def_line, 0)
    expect_i64("definition col", g_def_col, 3)
    word_at(g_arena, off, end, 0, 3)
    expect_i64("no definition for absent name",
        find_definition(g_arena, off, end, g_span_off, 0), 0)
}

fn selftest_lint() {
    let src = "fn main() {\n\tlet x = 1  \n}\n"
    let off = arena_lit(src)
    let end = off + g_span_len
    lint_source(g_arena, off, end)
    expect_i64("diagnostic count", g_diag_cnt, 2)
    expect_i64("tab on line 1", g_diag_line[0], 1)
    expect_i64("tab severity", g_diag_sev[0], SEV_WARNING)
    expect_i64("tab code", g_diag_code[0], LINT_TAB)
    expect_i64("trailing ws on line 1", g_diag_line[1], 1)
    expect_i64("trailing ws code", g_diag_code[1], LINT_TRAILWS)
}

fn selftest_format() {
    let src = "fn main() {\nlet x = 1\nif x > 0 {\nprint(\"hi\")\n}\n}\n"
    let off = arena_lit(src)
    let end = off + g_span_len
    let out = alloc_pages(1) as &i8
    let n = format_jda(g_arena, off, end, out, 4096)
    let want = "fn main() {\n    let x = 1\n    if x > 0 {\n        print(\"hi\")\n    }\n}\n"
    expect_i64("formatted length", n, str_len(want))
    expect_i64("formatted text", span_eq_lit(out, 0, n, want), 1)
}

fn selftest_json_out() {
    g_out_pos = 0
    w_ch(123)
    w_key("a")
    w_qlit("x\"y")
    w_ch(44)
    w_key("b")
    w_int(0 - 12)
    w_ch(125)
    let want = "{\"a\":\"x\\\"y\",\"b\":-12}"
    expect_i64("encoded length", g_out_pos, str_len(want))
    expect_i64("encoded text", span_eq_lit(g_out, 0, g_out_pos, want), 1)

    g_out_pos = 0
    w_qlit("tab\there")
    expect_i64("tab escaped", span_eq_lit(g_out, 0, g_out_pos, "\"tab\\there\""), 1)
}

fn selftest_docs() {
    let uri = "file:///tmp/a.jda"
    let text = "fn one() {\n}\n"
    let uoff = arena_lit(uri)
    let ulen = g_span_len
    let toff = arena_lit(text)
    let tlen = g_span_len
    let before = g_doc_cnt
    let idx = doc_put(g_arena, uoff, ulen, g_arena, toff, tlen)
    expect_i64("document stored", idx >= 0, 1)
    expect_i64("document count", g_doc_cnt, before + 1)
    expect_i64("document found again", doc_find(g_arena, uoff, ulen), idx)
    doc_remove(g_arena, uoff, ulen)
    expect_i64("document removed", g_doc_cnt, before)
    expect_i64("lookup after removal", doc_find(g_arena, uoff, ulen), 0 - 1)
}

fn selftest_request() {
    let msg = "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///x\"},\"position\":{\"line\":3,\"character\":5}}}"
    let n = str_len(msg)
    let i = 0
    loop i < n {
        set_byte(g_in, i, get_byte(msg, i))
        i = i + 1
    }
    let root = json_parse(g_in, n)
    expect_i64("request parses", root >= 0, 1)
    let m = obj_get_lit(root, "method")
    expect_i64("method matches", method_is(m, "textDocument/hover"), 1)
    expect_i64("other method does not", method_is(m, "textDocument/definition"), 0)
    let params = obj_get_lit(root, "params")
    expect_i64("uri present", params_uri(params), 1)
    expect_i64("uri text", span_eq_lit(g_in, g_span_off, g_span_len, "file:///x"), 1)
    params_position(params)
    expect_i64("position line", g_pos_line, 3)
    expect_i64("position character", g_pos_col, 5)

    let id = obj_get_lit(root, "id")
    g_out_pos = 0
    w_id(id)
    expect_i64("id echoed", span_eq_lit(g_out, 0, g_out_pos, "7"), 1)
}

fn selftest_hover_doc() {
    let src = "fn"
    let off = arena_lit(src)
    let doc = builtin_doc(g_arena, off, g_span_len)
    expect_i64("fn has documentation", str_len(doc) > 0, 1)
    let src2 = "notakeyword"
    let off2 = arena_lit(src2)
    expect_i64("unknown word has none", str_len(builtin_doc(g_arena, off2, g_span_len)), 0)
}

fn lsp_selftest() -> i64 {
    g_fail = 0
    selftest_spans()
    selftest_symbols()
    selftest_definition()
    selftest_lint()
    selftest_format()
    selftest_json_out()
    selftest_docs()
    selftest_request()
    selftest_hover_doc()
    if g_fail == 0 {
        print("selftest: all ok\n")
    } else {
        print("selftest: {g_fail} failed\n")
    }
    ret 0
}

fn print_usage() {
    print("jda::lsp - Language Server Protocol server for Jda\n\n")
    print("Usage:\n")
    print("  jda lsp             speak LSP on stdin/stdout (editors launch this)\n")
    print("  jda lsp selftest    run the built-in analysis and encoder tests\n")
}

fn main(argc: i64, argv: &i64) {
    lsp_init()
    if argc >= 2 {
        let cmd = argv[1] as &i8
        if str_eq(cmd, "selftest") == 1 {
            lsp_selftest()
            ret 0
        }
        if str_eq(cmd, "help") == 1 {
            print_usage()
            ret 0
        }
        if str_eq(cmd, "--help") == 1 {
            print_usage()
            ret 0
        }
    }
    lsp_run()
}
