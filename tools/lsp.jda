// =============================================================================
// jda::lsp - Language Server Protocol server
// =============================================================================
// Speaks LSP 3.17 over stdin/stdout using JSON-RPC 2.0, and provides:
//
//   initialize / initialized / shutdown / exit
//   textDocument/didOpen, didChange, didClose
//   textDocument/publishDiagnostics   (lint: tabs, trailing whitespace)
//   textDocument/hover                (documentation for keywords)
//   textDocument/completion           (keywords + symbols in the open document)
//   textDocument/definition           (go to definition)
//   textDocument/documentSymbol       (outline)
//   textDocument/formatting           (indentation normaliser)
//   workspace/symbol
//
// Transport: Content-Length: <n>\r\n\r\n<json>
//
// Usage. Editors launch it as `jda lsp`; run `jda lsp selftest` to exercise the
// analysis and JSON encoding without a client attached.
//
// Implementation notes. Requests are parsed with stdlib/json.jda. Responses are
// written directly as bytes rather than built as a value tree -- there is no
// JSON writer in the stdlib, and streaming the bytes out keeps the whole server
// allocation-free past the three buffers set up in lsp_init.
//
// Documents live in one arena with parallel index arrays. Byte access goes
// through the prelude's get_byte/set_byte: a plain `p[i] = v` on an `&i8`
// parameter does not store a single byte.
// =============================================================================

// ---- JSON-RPC error codes ---------------------------------------------------
const ERR_PARSE_ERROR      = 0 - 32700
const ERR_INVALID_REQUEST  = 0 - 32600
const ERR_METHOD_NOT_FOUND = 0 - 32601
const ERR_INVALID_PARAMS   = 0 - 32602
const ERR_INTERNAL         = 0 - 32603

// ---- LSP SymbolKind ---------------------------------------------------------
const SYM_FUNCTION = 12
const SYM_STRUCT   = 23
const SYM_ENUM     = 10
const SYM_CONST    = 14
const SYM_OBJECT   = 19
const SYM_KEYWORD  = 14

// ---- LSP DiagnosticSeverity -------------------------------------------------
const SEV_ERROR   = 1
const SEV_WARNING = 2

const MAX_DOCS = 64
const MAX_SYMS = 512
const MAX_DIAGS = 256

const IN_CAP  = 262144
const OUT_CAP = 262144
const ARENA_CAP = 1048576

// ---- buffers ----------------------------------------------------------------
let g_in: &i8 = 0
let g_in_len = 0
let g_out: &i8 = 0
let g_out_pos = 0
let g_arena: &i8 = 0
let g_arena_pos = 0

// ---- document store ---------------------------------------------------------
let g_doc_cnt = 0
let g_doc_uri_off: &i64 = 0
let g_doc_uri_len: &i64 = 0
let g_doc_txt_off: &i64 = 0
let g_doc_txt_len: &i64 = 0

// ---- server state -----------------------------------------------------------
let g_initialized = 0
let g_shutdown = 0
let g_exit = 0

// ---- scratch results (functions cannot return spans) ------------------------
let g_span_off = 0
let g_span_len = 0
let g_def_line = 0
let g_def_col = 0

fn lsp_init() {
    g_in = alloc_pages(IN_CAP / 4096) as &i8
    g_out = alloc_pages(OUT_CAP / 4096) as &i8
    g_arena = alloc_pages(ARENA_CAP / 4096) as &i8
    g_arena_pos = 0
    g_doc_uri_off = alloc_pages(1) as &i64
    g_doc_uri_len = alloc_pages(1) as &i64
    g_doc_txt_off = alloc_pages(1) as &i64
    g_doc_txt_len = alloc_pages(1) as &i64
    g_doc_cnt = 0
}

// =============================================================================
// Output: JSON written straight into g_out
// =============================================================================

fn w_ch(c: i64) {
    if g_out_pos >= OUT_CAP { ret 0 }
    set_byte(g_out, g_out_pos, c)
    g_out_pos = g_out_pos + 1
}

fn w_span(src: &i8, off: i64, len: i64) {
    let i = 0
    loop i < len {
        w_ch(get_byte(src, off + i))
        i = i + 1
    }
}

fn w_lit(s: &i8) {
    let n = str_len(s)
    w_span(s, 0, n)
}

fn w_int(n: i64) {
    let tmp = i8[24]
    let used = fmt_i64(tmp, n)
    w_span(tmp, 0, used)
}

// A JSON string body, escaped. Control characters below 0x20 become \u00XX,
// which is what an editor will send back for anything exotic in a source file.
fn w_esc(src: &i8, off: i64, len: i64) {
    let i = 0
    loop i < len {
        let c = get_byte(src, off + i) & 255
        if c == 34 {
            w_ch(92)
            w_ch(34)
        } else {
        if c == 92 {
            w_ch(92)
            w_ch(92)
        } else {
        if c == 10 {
            w_ch(92)
            w_ch(110)
        } else {
        if c == 13 {
            w_ch(92)
            w_ch(114)
        } else {
        if c == 9 {
            w_ch(92)
            w_ch(116)
        } else {
        if c < 32 {
            w_ch(92)
            w_ch(117)
            w_ch(48)
            w_ch(48)
            w_ch(hex_digit(c / 16))
            w_ch(hex_digit(c % 16))
        } else {
            w_ch(c)
        }}}}}}
        i = i + 1
    }
}

fn hex_digit(v: i64) -> i64 {
    if v < 10 { ret 48 + v }
    ret 87 + v
}

// "..." around an escaped span.
fn w_qspan(src: &i8, off: i64, len: i64) {
    w_ch(34)
    w_esc(src, off, len)
    w_ch(34)
}

fn w_qlit(s: &i8) {
    w_qspan(s, 0, str_len(s))
}

// `"key":` -- every object member goes through this so the quoting is uniform.
fn w_key(s: &i8) {
    w_qlit(s)
    w_ch(58)
}

// =============================================================================
// Span helpers. A "span" is (base pointer, offset, length) into the arena or
// into the request buffer; the language has no slices, so spans are passed as
// separate arguments and results come back in g_span_off / g_span_len.
// =============================================================================

fn is_ident_char(c: i64) -> i64 {
    if c >= 97 and c <= 122 { ret 1 }
    if c >= 65 and c <= 90 { ret 1 }
    if c >= 48 and c <= 57 { ret 1 }
    if c == 95 { ret 1 }
    ret 0
}

fn is_space(c: i64) -> i64 {
    if c == 32 { ret 1 }
    if c == 9 { ret 1 }
    if c == 13 { ret 1 }
    ret 0
}

// Does the span at `off` begin with the C string `pre`?
fn span_starts(src: &i8, off: i64, len: i64, pre: &i8) -> i64 {
    let pl = str_len(pre)
    if pl > len { ret 0 }
    let i = 0
    loop i < pl {
        if get_byte(src, off + i) != get_byte(pre, i) { ret 0 }
        i = i + 1
    }
    ret 1
}

fn span_eq_lit(src: &i8, off: i64, len: i64, s: &i8) -> i64 {
    if str_len(s) != len { ret 0 }
    ret span_starts(src, off, len, s)
}

// First offset at or after `off` where `needle` occurs, or -1.
fn span_find(src: &i8, off: i64, len: i64, needle: &i8) -> i64 {
    let nl = str_len(needle)
    if nl == 0 { ret off }
    if nl > len { ret 0 - 1 }
    let last = off + len - nl
    let i = off
    loop i <= last {
        if span_starts(src, i, last + nl - i, needle) == 1 { ret i }
        i = i + 1
    }
    ret 0 - 1
}

// Offset of the first byte of `line` (0-based), or -1 past the end.
fn line_start(src: &i8, off: i64, end: i64, line: i64) -> i64 {
    if line == 0 { ret off }
    let seen = 0
    let i = off
    loop i < end {
        if get_byte(src, i) == 10 {
            seen = seen + 1
            if seen == line { ret i + 1 }
        }
        i = i + 1
    }
    ret 0 - 1
}

// Length of the line beginning at `start`, excluding the newline.
fn line_len(src: &i8, end: i64, start: i64) -> i64 {
    let i = start
    loop i < end {
        if get_byte(src, i) == 10 { ret i - start }
        i = i + 1
    }
    ret end - start
}

fn count_lines(src: &i8, off: i64, end: i64) -> i64 {
    let n = 0
    let i = off
    loop i < end {
        if get_byte(src, i) == 10 { n = n + 1 }
        i = i + 1
    }
    ret n
}

// Trims leading and trailing whitespace, leaving the result in g_span_*.
fn span_trim(src: &i8, off: i64, len: i64) {
    let s = off
    let e = off + len
    loop s < e and is_space(get_byte(src, s)) == 1 { s = s + 1 }
    loop e > s and is_space(get_byte(src, e - 1)) == 1 { e = e - 1 }
    g_span_off = s
    g_span_len = e - s
}

// The identifier that starts at or after `off`, into g_span_*.
fn ident_after(src: &i8, off: i64, limit: i64) {
    let i = off
    loop i < limit and is_ident_char(get_byte(src, i)) == 0 { i = i + 1 }
    let s = i
    loop i < limit and is_ident_char(get_byte(src, i)) == 1 { i = i + 1 }
    g_span_off = s
    g_span_len = i - s
}

// The identifier surrounding (line, col), into g_span_*. Empty if there is none.
fn word_at(src: &i8, off: i64, end: i64, line: i64, col: i64) {
    g_span_off = 0
    g_span_len = 0
    let ls = line_start(src, off, end, line)
    if ls < 0 { ret 0 }
    let ll = line_len(src, end, ls)
    if col >= ll { ret 0 }
    let s = col
    let e = col
    loop s > 0 and is_ident_char(get_byte(src, ls + s - 1)) == 1 { s = s - 1 }
    loop e < ll and is_ident_char(get_byte(src, ls + e)) == 1 { e = e + 1 }
    g_span_off = ls + s
    g_span_len = e - s
}

// The identifier ending at (line, col) -- the completion prefix.
fn word_before(src: &i8, off: i64, end: i64, line: i64, col: i64) {
    g_span_off = 0
    g_span_len = 0
    let ls = line_start(src, off, end, line)
    if ls < 0 { ret 0 }
    let ll = line_len(src, end, ls)
    let e = col
    if e > ll { e = ll }
    let s = e
    loop s > 0 and is_ident_char(get_byte(src, ls + s - 1)) == 1 { s = s - 1 }
    g_span_off = ls + s
    g_span_len = e - s
}

// =============================================================================
// Lint. Deliberately shallow: this runs on every keystroke, so it only reports
// what can be decided from a single line.
// =============================================================================

let g_diag_cnt = 0
let g_diag_line: &i64 = 0
let g_diag_col: &i64 = 0
let g_diag_len: &i64 = 0
let g_diag_sev: &i64 = 0
let g_diag_code: &i64 = 0

fn diag_init() {
    if g_diag_line != 0 { ret 0 }
    g_diag_line = alloc_pages(1) as &i64
    g_diag_col = alloc_pages(1) as &i64
    g_diag_len = alloc_pages(1) as &i64
    g_diag_sev = alloc_pages(1) as &i64
    g_diag_code = alloc_pages(1) as &i64
}

fn diag_push(line: i64, col: i64, len: i64, sev: i64, code: i64) {
    if g_diag_cnt >= MAX_DIAGS { ret 0 }
    g_diag_line[g_diag_cnt] = line
    g_diag_col[g_diag_cnt] = col
    g_diag_len[g_diag_cnt] = len
    g_diag_sev[g_diag_cnt] = sev
    g_diag_code[g_diag_cnt] = code
    g_diag_cnt = g_diag_cnt + 1
}

// Diagnostic codes, kept as small integers so the tables stay i64 arrays.
const LINT_TAB     = 0
const LINT_TRAILWS = 1

fn lint_code_str(code: i64) -> &i8 {
    if code == LINT_TAB { ret "W099" }
    ret "W098"
}

fn lint_msg_str(code: i64) -> &i8 {
    if code == LINT_TAB { ret "use spaces, not tabs" }
    ret "trailing whitespace"
}

fn lint_source(src: &i8, off: i64, end: i64) {
    diag_init()
    g_diag_cnt = 0
    let ln = 0
    let ls = off
    loop ls < end and ln < 100000 {
        let ll = line_len(src, end, ls)
        let c = 0
        loop c < ll {
            if get_byte(src, ls + c) == 9 {
                diag_push(ln, c, 1, SEV_WARNING, LINT_TAB)
                c = ll
            } else {
                c = c + 1
            }
        }
        if ll > 0 {
            let last = get_byte(src, ls + ll - 1)
            if is_space(last) == 1 {
                diag_push(ln, ll - 1, 1, SEV_WARNING, LINT_TRAILWS)
            }
        }
        ls = ls + ll + 1
        ln = ln + 1
        if ls > end { ls = end + 1 }
    }
}

// =============================================================================
// Symbol extraction. Top-level declarations only, matched on the trimmed line.
// =============================================================================

let g_sym_cnt = 0
let g_sym_off: &i64 = 0
let g_sym_len: &i64 = 0
let g_sym_kind: &i64 = 0
let g_sym_line: &i64 = 0

fn sym_init() {
    if g_sym_off != 0 { ret 0 }
    g_sym_off = alloc_pages(1) as &i64
    g_sym_len = alloc_pages(1) as &i64
    g_sym_kind = alloc_pages(1) as &i64
    g_sym_line = alloc_pages(1) as &i64
}

fn sym_push(off: i64, len: i64, kind: i64, line: i64) {
    if g_sym_cnt >= MAX_SYMS { ret 0 }
    if len == 0 { ret 0 }
    g_sym_off[g_sym_cnt] = off
    g_sym_len[g_sym_cnt] = len
    g_sym_kind[g_sym_cnt] = kind
    g_sym_line[g_sym_cnt] = line
    g_sym_cnt = g_sym_cnt + 1
}

fn sym_detail(kind: i64) -> &i8 {
    if kind == SYM_FUNCTION { ret "fn" }
    if kind == SYM_STRUCT { ret "struct" }
    if kind == SYM_ENUM { ret "enum" }
    if kind == SYM_OBJECT { ret "impl" }
    ret "const"
}

// Classifies one trimmed line, returning the SymbolKind or -1, and leaving the
// keyword width in g_span_len so the caller knows where the name begins.
fn sym_kind_of(src: &i8, off: i64, len: i64) -> i64 {
    if span_starts(src, off, len, "fn ") == 1 {
        g_span_len = 3
        ret SYM_FUNCTION
    }
    if span_starts(src, off, len, "struct ") == 1 {
        g_span_len = 7
        ret SYM_STRUCT
    }
    if span_starts(src, off, len, "enum ") == 1 {
        g_span_len = 5
        ret SYM_ENUM
    }
    if span_starts(src, off, len, "impl ") == 1 {
        g_span_len = 5
        ret SYM_OBJECT
    }
    if span_starts(src, off, len, "const ") == 1 {
        g_span_len = 6
        ret SYM_CONST
    }
    ret 0 - 1
}

fn extract_symbols(src: &i8, off: i64, end: i64) {
    sym_init()
    g_sym_cnt = 0
    let ln = 0
    let ls = off
    loop ls < end and ln < 100000 {
        let ll = line_len(src, end, ls)
        span_trim(src, ls, ll)
        let toff = g_span_off
        let tlen = g_span_len
        let kind = sym_kind_of(src, toff, tlen)
        if kind >= 0 {
            let kw = g_span_len
            ident_after(src, toff + kw, toff + tlen)
            sym_push(g_span_off, g_span_len, kind, ln)
        }
        ls = ls + ll + 1
        ln = ln + 1
        if ls > end { ls = end + 1 }
    }
}

// =============================================================================
// Go to definition. Looks for the declaration forms rather than any use.
// =============================================================================

fn def_target(i: i64) -> &i8 {
    if i == 0 { ret "fn " }
    if i == 1 { ret "struct " }
    if i == 2 { ret "enum " }
    if i == 3 { ret "const " }
    ret "let "
}

// True when the identifier at `off` is exactly the span (word_off, word_len).
fn ident_matches(src: &i8, off: i64, limit: i64, word_off: i64, word_len: i64) -> i64 {
    if off + word_len > limit { ret 0 }
    let i = 0
    loop i < word_len {
        if get_byte(src, off + i) != get_byte(src, word_off + i) { ret 0 }
        i = i + 1
    }
    if off + word_len < limit {
        if is_ident_char(get_byte(src, off + word_len)) == 1 { ret 0 }
    }
    ret 1
}

// Sets g_def_line / g_def_col, or returns 0 when there is no declaration.
fn find_definition(src: &i8, off: i64, end: i64, word_off: i64, word_len: i64) -> i64 {
    g_def_line = 0
    g_def_col = 0
    if word_len == 0 { ret 0 }
    let ln = 0
    let ls = off
    loop ls < end and ln < 100000 {
        let ll = line_len(src, end, ls)
        span_trim(src, ls, ll)
        let toff = g_span_off
        let tlen = g_span_len
        let k = 0
        loop k < 5 {
            let kw = def_target(k)
            if span_starts(src, toff, tlen, kw) == 1 {
                let nameoff = toff + str_len(kw)
                if ident_matches(src, nameoff, toff + tlen, word_off, word_len) == 1 {
                    g_def_line = ln
                    g_def_col = nameoff - ls
                    ret 1
                }
            }
            k = k + 1
        }
        ls = ls + ll + 1
        ln = ln + 1
        if ls > end { ls = end + 1 }
    }
    ret 0
}

// =============================================================================
// Formatting: re-indent at four spaces per brace level. Blank lines stay blank.
// =============================================================================

fn format_jda(src: &i8, off: i64, end: i64, out: &i8, cap: i64) -> i64 {
    let pos = 0
    let depth = 0
    let ls = off
    let ln = 0
    loop ls < end and ln < 100000 {
        let ll = line_len(src, end, ls)
        span_trim(src, ls, ll)
        let toff = g_span_off
        let tlen = g_span_len
        if tlen == 0 {
            if pos < cap {
                set_byte(out, pos, 10)
                pos = pos + 1
            }
        } else {
            if get_byte(src, toff) == 125 {
                if depth > 0 { depth = depth - 1 }
            }
            let ind = depth * 4
            let i = 0
            loop i < ind and pos < cap {
                set_byte(out, pos, 32)
                pos = pos + 1
                i = i + 1
            }
            i = 0
            loop i < tlen and pos < cap {
                set_byte(out, pos, get_byte(src, toff + i))
                pos = pos + 1
                i = i + 1
            }
            if pos < cap {
                set_byte(out, pos, 10)
                pos = pos + 1
            }
            if get_byte(src, toff + tlen - 1) == 123 { depth = depth + 1 }
        }
        ls = ls + ll + 1
        ln = ln + 1
        if ls > end { ls = end + 1 }
    }
    ret pos
}

// =============================================================================
// Hover documentation for the keywords the language actually has.
// =============================================================================

fn builtin_doc(src: &i8, off: i64, len: i64) -> &i8 {
    if span_eq_lit(src, off, len, "fn") == 1 {
        ret "**fn** - declare a function\n```jda\nfn name(arg: i64) -> i64 { ret arg }\n```"
    }
    if span_eq_lit(src, off, len, "let") == 1 {
        ret "**let** - bind a variable\n```jda\nlet x = 42\n```"
    }
    if span_eq_lit(src, off, len, "ret") == 1 {
        ret "**ret** - return a value from a function"
    }
    if span_eq_lit(src, off, len, "loop") == 1 {
        ret "**loop** - repeat while a condition holds\n```jda\nloop i < n { i = i + 1 }\n```"
    }
    if span_eq_lit(src, off, len, "if") == 1 {
        ret "**if** - conditional\n```jda\nif x > 0 { ... } else { ... }\n```"
    }
    if span_eq_lit(src, off, len, "struct") == 1 {
        ret "**struct** - declare a record type\n```jda\nstruct Point {\n    x: i64\n    y: i64\n}\n```"
    }
    if span_eq_lit(src, off, len, "const") == 1 {
        ret "**const** - a compile-time constant\n```jda\nconst MAX = 4096\n```"
    }
    if span_eq_lit(src, off, len, "import") == 1 {
        ret "**import** - bring another module into scope"
    }
    if span_eq_lit(src, off, len, "syscall") == 1 {
        ret "**syscall(n, a, b, c)** - raw Linux system call"
    }
    if span_eq_lit(src, off, len, "alloc_pages") == 1 {
        ret "**alloc_pages(n)** - map n pages of zeroed memory"
    }
    if span_eq_lit(src, off, len, "print") == 1 {
        ret "**print(s)** - write a string to stdout, with `{expr}` interpolation"
    }
    ret ""
}

fn completion_keyword(i: i64) -> &i8 {
    if i == 0 { ret "fn" }
    if i == 1 { ret "let" }
    if i == 2 { ret "ret" }
    if i == 3 { ret "if" }
    if i == 4 { ret "else" }
    if i == 5 { ret "loop" }
    if i == 6 { ret "break" }
    if i == 7 { ret "struct" }
    if i == 8 { ret "const" }
    if i == 9 { ret "import" }
    if i == 10 { ret "and" }
    if i == 11 { ret "or" }
    if i == 12 { ret "as" }
    if i == 13 { ret "syscall" }
    if i == 14 { ret "alloc_pages" }
    if i == 15 { ret "print" }
    ret ""
}

const COMPLETION_KEYWORDS = 16

// =============================================================================
// Document store. URIs and texts are copied into the arena so they outlive the
// request buffer, which is overwritten by the next message.
// =============================================================================

fn arena_put(src: &i8, off: i64, len: i64) -> i64 {
    if g_arena_pos + len >= ARENA_CAP { ret 0 - 1 }
    let at = g_arena_pos
    let i = 0
    loop i < len {
        set_byte(g_arena, at + i, get_byte(src, off + i))
        i = i + 1
    }
    g_arena_pos = at + len
    ret at
}

// The parser hands back the raw span between the quotes, so escapes are still
// encoded. Text arriving from an editor is full of them -- every newline in a
// source file is a `\n` pair -- and storing that verbatim makes the whole
// document look like a single line to every analysis below.

let g_ap = 0

fn ap_push(c: i64) {
    if g_ap >= ARENA_CAP { ret 0 }
    set_byte(g_arena, g_ap, c)
    g_ap = g_ap + 1
}

fn ap_utf8(cp: i64) {
    if cp < 128 {
        ap_push(cp)
        ret 0
    }
    if cp < 2048 {
        ap_push(192 + cp / 64)
        ap_push(128 + cp % 64)
        ret 0
    }
    if cp < 65536 {
        ap_push(224 + cp / 4096)
        ap_push(128 + (cp / 64) % 64)
        ap_push(128 + cp % 64)
        ret 0
    }
    ap_push(240 + cp / 262144)
    ap_push(128 + (cp / 4096) % 64)
    ap_push(128 + (cp / 64) % 64)
    ap_push(128 + cp % 64)
}

fn hex_val(c: i64) -> i64 {
    if c >= 48 and c <= 57 { ret c - 48 }
    if c >= 97 and c <= 102 { ret c - 87 }
    if c >= 65 and c <= 70 { ret c - 55 }
    ret 0
}

fn hex4(src: &i8, off: i64) -> i64 {
    let v = hex_val(get_byte(src, off) & 255)
    v = v * 16 + hex_val(get_byte(src, off + 1) & 255)
    v = v * 16 + hex_val(get_byte(src, off + 2) & 255)
    v = v * 16 + hex_val(get_byte(src, off + 3) & 255)
    ret v
}

fn simple_escape(e: i64) -> i64 {
    if e == 110 { ret 10 }
    if e == 116 { ret 9 }
    if e == 114 { ret 13 }
    if e == 98 { ret 8 }
    if e == 102 { ret 12 }
    if e == 34 { ret 34 }
    if e == 92 { ret 92 }
    if e == 47 { ret 47 }
    ret 0 - 1
}

// Copies a JSON string span into the arena, decoding escapes. Returns the
// arena offset; the decoded length is left in g_span_len.
fn arena_put_json(src: &i8, off: i64, len: i64) -> i64 {
    if g_arena_pos + len >= ARENA_CAP { ret 0 - 1 }
    let at = g_arena_pos
    g_ap = at
    let i = 0
    loop i < len {
        let c = get_byte(src, off + i) & 255
        if c == 92 and i + 1 < len {
            let e = get_byte(src, off + i + 1) & 255
            if e == 117 and i + 5 < len {
                let cp = hex4(src, off + i + 2)
                i = i + 6
                if cp >= 55296 and cp < 56320 {
                    if i + 5 < len {
                        if get_byte(src, off + i) == 92 and get_byte(src, off + i + 1) == 117 {
                            let lo = hex4(src, off + i + 2)
                            if lo >= 56320 and lo < 57344 {
                                cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                                i = i + 6
                            }
                        }
                    }
                }
                ap_utf8(cp)
            } else {
                let d = simple_escape(e)
                if d < 0 {
                    ap_push(e)
                } else {
                    ap_push(d)
                }
                i = i + 2
            }
        } else {
            ap_push(c)
            i = i + 1
        }
    }
    g_arena_pos = g_ap
    g_span_len = g_ap - at
    ret at
}

fn doc_find(src: &i8, off: i64, len: i64) -> i64 {
    let i = 0
    loop i < g_doc_cnt {
        if g_doc_uri_len[i] == len {
            let j = 0
            let same = 1
            loop j < len {
                if get_byte(g_arena, g_doc_uri_off[i] + j) != get_byte(src, off + j) {
                    same = 0
                    j = len
                } else {
                    j = j + 1
                }
            }
            if same == 1 { ret i }
        }
        i = i + 1
    }
    ret 0 - 1
}

// Stores (or replaces) a document. The arena is append-only: replacing a
// document leaves the old text behind, which is the right trade for an editor
// session -- no free list, and edits stay O(text).
fn doc_put(uri: &i8, uoff: i64, ulen: i64, text: &i8, toff: i64, tlen: i64) -> i64 {
    let ua = arena_put_json(uri, uoff, ulen)
    if ua < 0 { ret 0 - 1 }
    let ulen2 = g_span_len
    let idx = doc_find(g_arena, ua, ulen2)
    let ta = arena_put_json(text, toff, tlen)
    if ta < 0 { ret 0 - 1 }
    let tlen2 = g_span_len
    if idx < 0 {
        if g_doc_cnt >= MAX_DOCS { ret 0 - 1 }
        idx = g_doc_cnt
        g_doc_uri_off[idx] = ua
        g_doc_uri_len[idx] = ulen2
        g_doc_cnt = g_doc_cnt + 1
    }
    g_doc_txt_off[idx] = ta
    g_doc_txt_len[idx] = tlen2
    ret idx
}

// Looks a document up by a URI that is still JSON-escaped, decoding into the
// arena and then rolling the cursor back.
fn doc_find_json(src: &i8, off: i64, len: i64) -> i64 {
    let save = g_arena_pos
    let a = arena_put_json(src, off, len)
    if a < 0 { ret 0 - 1 }
    let n = g_span_len
    let idx = doc_find(g_arena, a, n)
    g_arena_pos = save
    ret idx
}

fn doc_remove(uri: &i8, uoff: i64, ulen: i64) {
    let idx = doc_find_json(uri, uoff, ulen)
    if idx < 0 { ret 0 }
    let i = idx
    loop i + 1 < g_doc_cnt {
        g_doc_uri_off[i] = g_doc_uri_off[i + 1]
        g_doc_uri_len[i] = g_doc_uri_len[i + 1]
        g_doc_txt_off[i] = g_doc_txt_off[i + 1]
        g_doc_txt_len[i] = g_doc_txt_len[i + 1]
        i = i + 1
    }
    g_doc_cnt = g_doc_cnt - 1
}

// =============================================================================
// Request access. The parser hands back node ids; these pull out the pieces the
// handlers need, with -1 and 0 standing in for absent.
// =============================================================================

fn obj_get_lit(node: i64, key: &i8) -> i64 {
    ret json_obj_get(node, key, str_len(key))
}

// Leaves a string member's span in g_span_*, and returns 1 when present.
fn member_str(node: i64, key: &i8) -> i64 {
    g_span_off = 0
    g_span_len = 0
    let m = obj_get_lit(node, key)
    if m < 0 { ret 0 }
    if json_kind(m) != JSON_STR { ret 0 }
    g_span_off = json_str_value_off(m)
    g_span_len = json_str_value_len(m)
    ret 1
}

fn member_num(node: i64, key: &i8, dflt: i64) -> i64 {
    let m = obj_get_lit(node, key)
    if m < 0 { ret dflt }
    if json_kind(m) != JSON_NUM { ret dflt }
    ret json_num(m)
}

// textDocument.uri, into g_span_*.
fn params_uri(params: i64) -> i64 {
    let td = obj_get_lit(params, "textDocument")
    if td < 0 { ret 0 }
    ret member_str(td, "uri")
}

// The document text for a request's textDocument.uri; -1 when unknown.
fn params_doc(params: i64) -> i64 {
    if params_uri(params) == 0 { ret 0 - 1 }
    ret doc_find_json(g_in, g_span_off, g_span_len)
}

let g_pos_line = 0
let g_pos_col = 0

fn params_position(params: i64) {
    g_pos_line = 0
    g_pos_col = 0
    let p = obj_get_lit(params, "position")
    if p < 0 { ret 0 }
    g_pos_line = member_num(p, "line", 0)
    g_pos_col = member_num(p, "character", 0)
}

// =============================================================================
// Transport
// =============================================================================

// Echoes the request id back verbatim. LSP allows a number or a string, and a
// response whose id does not match the request is dropped by the client, so the
// safest thing is to reproduce whatever arrived.
fn w_id(id: i64) {
    if id < 0 {
        w_lit("null")
        ret 0
    }
    let k = json_kind(id)
    if k == JSON_NUM {
        w_int(json_num(id))
        ret 0
    }
    if k == JSON_STR {
        w_qspan(g_in, json_str_value_off(id), json_str_value_len(id))
        ret 0
    }
    w_lit("null")
}

fn out_begin() {
    g_out_pos = 0
    w_ch(123)
    w_key("jsonrpc")
    w_qlit("2.0")
}

// Frames g_out with its Content-Length header and writes both to stdout.
fn out_flush() {
    let hdr = i8[64]
    let n = 0
    let prefix = "Content-Length: "
    let pl = str_len(prefix)
    let i = 0
    loop i < pl {
        set_byte(hdr, i, get_byte(prefix, i))
        i = i + 1
    }
    n = pl
    let digits = i8[24]
    let dn = fmt_i64(digits, g_out_pos)
    i = 0
    loop i < dn {
        set_byte(hdr, n + i, get_byte(digits, i))
        i = i + 1
    }
    n = n + dn
    set_byte(hdr, n, 13)
    set_byte(hdr, n + 1, 10)
    set_byte(hdr, n + 2, 13)
    set_byte(hdr, n + 3, 10)
    n = n + 4
    syscall(1, 1, hdr, n)
    syscall(1, 1, g_out, g_out_pos)
}

fn send_error(id: i64, code: i64, message: &i8) {
    out_begin()
    w_ch(44)
    w_key("id")
    w_id(id)
    w_ch(44)
    w_key("error")
    w_ch(123)
    w_key("code")
    w_int(code)
    w_ch(44)
    w_key("message")
    w_qlit(message)
    w_ch(125)
    w_ch(125)
    out_flush()
}

fn log_line(msg: &i8) {
    syscall(1, 2, msg, str_len(msg))
    syscall(1, 2, "\n", 1)
}

// =============================================================================
// Handlers
// =============================================================================

