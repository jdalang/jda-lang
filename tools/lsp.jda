fn w_range(sl: i64, sc: i64, el: i64, ec: i64) {
    w_key("range")
    w_ch(123)
    w_key("start")
    w_ch(123)
    w_key("line")
    w_int(sl)
    w_ch(44)
    w_key("character")
    w_int(sc)
    w_ch(125)
    w_ch(44)
    w_key("end")
    w_ch(123)
    w_key("line")
    w_int(el)
    w_ch(44)
