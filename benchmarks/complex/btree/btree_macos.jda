fn new_nd(mem: &i64, leaf: i64) -> i64 {
    let id = mem[0]; mem[0] = id + 1
    let kptr = mem + id * 1032 + 16
    kptr[127] = 0; kptr[128] = leaf
    let i = 0
    loop i < 64 { kptr[63 + i] = 0 - 1; i = i + 1 }
    ret id
}

fn search(mem: &i64, id: i64, key: i64) -> i64 {
    loop id >= 0 {
        let kptr = mem + id * 1032 + 16
        let n = kptr[127]
        kptr[n] = 2147483647
        let pos = 0
        loop kptr[pos] < key { pos = pos + 1 }
        if kptr[pos] == key { ret 1 }
        if kptr[128] == 1 { ret 0 }
        id = kptr[63 + pos]
    }
    ret 0
}

fn split_ch(mem: &i64, par: i64, idx: i64) {
    let pptr = mem + par * 1032 + 16
    let full = pptr[63 + idx]
    let fptr = mem + full * 1032 + 16
    let mid = 31; let leaf = fptr[128]
    let right = new_nd(mem, leaf)
    let rptr = mem + right * 1032 + 16
    let rn = 31; let j = 0
    loop j < rn {
        rptr[j] = fptr[mid + 1 + j]
        j = j + 1
    }
    if leaf == 0 {
        j = 0
        loop j < rn + 1 {
            rptr[63 + j] = fptr[63 + mid + 1 + j]
            j = j + 1
        }
    }
    let pk = fptr[mid]
    fptr[127] = mid; rptr[127] = rn
    let pn = pptr[127]
    j = pn
    loop j > idx {
        pptr[j] = pptr[j - 1]
        pptr[63 + j + 1] = pptr[63 + j]
        j = j - 1
    }
    pptr[idx] = pk
    pptr[63 + idx + 1] = right
    pptr[127] = pn + 1
}

fn ins_leaf(mem: &i64, id: i64, key: i64) {
    let kptr = mem + id * 1032 + 16
    let n = kptr[127]; let i = n - 1
    loop i >= 0 {
        if key >= kptr[i] { break }
        kptr[i + 1] = kptr[i]; i = i - 1
    }
    if i >= 0 { if kptr[i] == key { ret } }
    kptr[i + 1] = key; kptr[127] = n + 1
}

fn ins_nf(mem: &i64, id: i64, key: i64) {
    let kptr = mem + id * 1032 + 16
    if kptr[128] == 1 { ins_leaf(mem, id, key); ret }
    let n = kptr[127]
    kptr[n] = 2147483647
    let i = 0
    loop kptr[i] < key { i = i + 1 }
    if i < n { if kptr[i] == key { ret } }
    let child = kptr[63 + i]
    let cptr = mem + child * 1032 + 16
    if cptr[127] == 63 {
        split_ch(mem, id, i)
        if key > kptr[i] { i = i + 1 }
        if i < kptr[127] { if kptr[i] == key { ret } }
    }
    ins_nf(mem, kptr[63 + i], key)
}

fn bt_ins(mem: &i64, key: i64) {
    let root = mem[1]
    let rptr = mem + root * 1032 + 16
    if rptr[127] == 63 {
        let s = new_nd(mem, 0)
        let sptr = mem + s * 1032 + 16
        sptr[63] = root; mem[1] = s
        split_ch(mem, s, 0)
        ins_nf(mem, s, key)
    } else {
        ins_nf(mem, root, key)
    }
}

fn main() -> i64 {
    let mem = alloc_pages(8100)
    mem[0] = 0
    let r0 = new_nd(mem, 1)
    mem[1] = r0
    let N = 1000000; let N10 = 10000000
    let t0 = rdtsc()
    let rng = 12345
    let i = 0
    loop i < N { rng = (rng * 1103515245 + 12345) & 2147483647; bt_ins(mem, rng % N10); i = i + 1 }
    let root = mem[1]
    rng = 12345
    let found = 0; i = 0
    loop i < N { rng = (rng * 1103515245 + 12345) & 2147483647; found = found + search(mem, root, rng % N10); i = i + 1 }
    rng = 99999
    let found2 = 0; i = 0
    loop i < N { rng = (rng * 1103515245 + 12345) & 2147483647; found2 = found2 + search(mem, root, rng % N10); i = i + 1 }
    let t1 = rdtsc()
    let ticks = t1 - t0
    let ms = ticks / 1000000
    let nn = mem[0]
    print("inserted: {N}\nfound (known): {found}\nfound (random): {found2}\nnodes: {nn}\nticks: {ticks}\ntime: {ms} ms\n")
    ret 0
}
