let mem: &i64
let g_nn = 0
let g_root = 0

fn now_ms(ts: &i64) -> i64 {
    syscall(96, ts, 0, 0, 0)
    let s = ts[0]; let us = ts[1]
    ret s * 1000 + us / 1000
}

// Order-32 B-tree: 31 keys, 32 children per node
// Node layout (66 i64 slots, 528 bytes):
//   [0..30]  = 31 keys
//   [31]     = sentinel slot (always MAX_INT)
//   [32..63] = 32 children
//   [64]     = n (key count)
//   [65]     = leaf flag
//
// IMPORTANT: jda `ptr + X` adds X BYTES (not elements).
// To step by 66 elements, use byte stride 66*8=528:
//   kptr = mem + id * 528  →  kptr[k] = element id*66+k  ✓

fn new_nd(leaf: i64) -> i64 {
    let id = g_nn; g_nn = g_nn + 1
    let kptr = mem + id * 528
    kptr[64] = 0; kptr[65] = leaf
    kptr[31] = 2147483647
    let i = 0
    loop i < 32 { kptr[32 + i] = 0 - 1; i = i + 1 }
    ret id
}

fn search(id: i64, key: i64) -> i64 {
    loop id >= 0 {
        let kptr = mem + id * 528
        let n = kptr[64]
        kptr[n] = 2147483647
        let pos = 0
        loop kptr[pos] < key { pos = pos + 1 }
        if kptr[pos] == key { ret 1 }
        if kptr[65] == 1 { ret 0 }
        id = kptr[32 + pos]
    }
    ret 0
}

fn split_ch(par: i64, idx: i64) {
    let pptr = mem + par * 528
    let full = pptr[32 + idx]
    let fptr = mem + full * 528
    let mid = 15; let leaf = fptr[65]
    let right = new_nd(leaf)
    let rptr = mem + right * 528
    let rn = 15; let j = 0
    loop j < rn {
        rptr[j] = fptr[mid + 1 + j]
        j = j + 1
    }
    if leaf == 0 {
        j = 0
        loop j < rn + 1 {
            rptr[32 + j] = fptr[32 + mid + 1 + j]
            j = j + 1
        }
    }
    let pk = fptr[mid]
    fptr[64] = mid; rptr[64] = rn
    let pn = pptr[64]
    j = pn
    loop j > idx {
        pptr[j] = pptr[j - 1]
        pptr[32 + j + 1] = pptr[32 + j]
        j = j - 1
    }
    pptr[idx] = pk
    pptr[32 + idx + 1] = right
    pptr[64] = pn + 1
}

fn ins_leaf(id: i64, key: i64) {
    let kptr = mem + id * 528
    let n = kptr[64]; let i = n - 1
    loop i >= 0 {
        if key >= kptr[i] { break }
        kptr[i + 1] = kptr[i]; i = i - 1
    }
    if i >= 0 { if kptr[i] == key { ret } }
    kptr[i + 1] = key; kptr[64] = n + 1
}

fn ins_nf(id: i64, key: i64) {
    let kptr = mem + id * 528
    if kptr[65] == 1 { ins_leaf(id, key); ret }
    let n = kptr[64]
    kptr[n] = 2147483647
    let i = 0
    loop kptr[i] < key { i = i + 1 }
    if i < n { if kptr[i] == key { ret } }
    let child = kptr[32 + i]
    let cptr = mem + child * 528
    if cptr[64] == 31 {
        split_ch(id, i)
        if key > kptr[i] { i = i + 1 }
        if i < kptr[64] { if kptr[i] == key { ret } }
    }
    ins_nf(kptr[32 + i], key)
}

fn bt_ins(key: i64) {
    let rptr = mem + g_root * 528
    if rptr[64] == 31 {
        let s = new_nd(0)
        let sptr = mem + s * 528
        sptr[32] = g_root; g_root = s
        split_ch(s, 0)
        ins_nf(s, key)
    } else {
        ins_nf(g_root, key)
    }
}

fn main() -> i64 {
    mem = alloc_pages(10000)
    g_root = new_nd(1)
    let N = 1000000; let N10 = 10000000
    let ts = mem + 4700000
    let t0 = now_ms(ts)
    let rng = 12345
    let i = 0
    loop i < N { rng = (rng * 1103515245 + 12345) & 2147483647; bt_ins(rng % N10); i = i + 1 }
    let root = g_root
    rng = 12345
    let found = 0; i = 0
    loop i < N { rng = (rng * 1103515245 + 12345) & 2147483647; found = found + search(root, rng % N10); i = i + 1 }
    rng = 99999
    let found2 = 0; i = 0
    loop i < N { rng = (rng * 1103515245 + 12345) & 2147483647; found2 = found2 + search(root, rng % N10); i = i + 1 }
    let t1 = now_ms(ts)
    let elapsed = t1 - t0
    let nn = g_nn
    print("inserted: {N}\nfound (known): {found}\nfound (random): {found2}\nnodes: {nn}\ntime: {elapsed} ms\n")
    ret 0
}
