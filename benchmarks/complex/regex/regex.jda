// NFA regex engine — Thompson construction, 8 patterns x 100K strings
// Reports total match count and timing.

let mem: &i64
let g_ns = 0
let g_start = 0
let g_gen = 0
let g_clen = 0
let g_nlen = 0
let g_rng = 0
let g_re_pat: &i8
let g_re_pos = 0
let g_strbuf: &i8
let g_eps_top = 0
let g_dfa_n = 0

// Memory layout (i64 slots):
//   [0..6143]      NFA states: 2048 * 3 (c, out1, out2)
//   [6144..8191]   clist
//   [8192..10239]  nlist
//   [10240..12287] seen
//   DFA tables (added after NFA/closure tables):
//   [28884..29139] dfa_masks:  256 DFA state bitmasks (one i64 per state)
//   [29140..29395] dfa_acc:    256 DFA accept flags
//   [29396..36051] dfa_delta:  256 * 32 transitions (state * 32 + char_idx, stride=32 for SHL)
//   [12500..14547] g_eps_start: state -> start index in eps_list
//   [14548..16595] g_eps_len:   state -> count of entries in eps_list
//   [16596..26835] g_eps_list:  flat array of leaf state indices
//   [26836..28883] g_wstk:      DFS work stack for closure computation
// Total: 28884 slots = 231072 bytes < alloc_pages(60) = 245760 bytes

fn _sb(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

fn now_ms(ts: &i64) -> i64 {
    syscall(96, ts, 0, 0, 0)
    let s = ts[0]; let us = ts[1]
    ret s * 1000 + us / 1000
}

fn st_sc(i: i64, v: i64) { mem[i * 3] = v }
fn st_so1(i: i64, v: i64) { mem[i * 3 + 1] = v }
fn st_so2(i: i64, v: i64) { mem[i * 3 + 2] = v }

fn new_st(c: i64, o1: i64, o2: i64) -> i64 {
    let s = g_ns; g_ns = g_ns + 1
    st_sc(s, c); st_so1(s, o1); st_so2(s, o2)
    ret s
}

// Fragment: packed as start * 65536 + end
fn frag(s: i64, e: i64) -> i64 { ret s * 65536 + e }
fn frag_s(f: i64) -> i64 { ret f / 65536 }
fn frag_e(f: i64) -> i64 { ret f - (f / 65536) * 65536 }

fn re_peek() -> i64 { ret _sb(g_re_pat, g_re_pos) }
fn re_adv() { if _sb(g_re_pat, g_re_pos) != 0 { g_re_pos = g_re_pos + 1 } }

// Recursive descent parser: level 0=expr, 1=term, 2=factor, 3=atom
fn parse_re(level: i64) -> i64 {
    if level == 3 {
        let c = re_peek()
        if c == 40 { // '('
            re_adv()
            let f = parse_re(0)
            if re_peek() == 41 { re_adv() } // ')'
            ret f
        }
        if c == 46 { // '.'
            re_adv()
            let s = new_st(0 - 1, 0 - 1, 0 - 1)
            let j = new_st(0 - 4, 0 - 1, 0 - 1)
            st_so1(s, j); ret frag(s, j)
        }
        re_adv()
        let s = new_st(c, 0 - 1, 0 - 1)
        let j = new_st(0 - 4, 0 - 1, 0 - 1)
        st_so1(s, j); ret frag(s, j)
    }
    if level == 2 {
        let f = parse_re(3)
        let fs = frag_s(f); let fe = frag_e(f); let c = re_peek()
        if c == 42 { // '*'
            re_adv()
            let sp = new_st(0 - 2, fs, 0 - 1)
            let j = new_st(0 - 4, 0 - 1, 0 - 1)
            st_so1(fe, sp); st_so2(sp, j); ret frag(sp, j)
        }
        if c == 43 { // '+'
            re_adv()
            let sp = new_st(0 - 2, fs, 0 - 1)
            let j = new_st(0 - 4, 0 - 1, 0 - 1)
            st_so1(fe, sp); st_so2(sp, j); ret frag(fs, j)
        }
        if c == 63 { // '?'
            re_adv()
            let sp = new_st(0 - 2, fs, 0 - 1)
            let j = new_st(0 - 4, 0 - 1, 0 - 1)
            st_so1(fe, j); st_so2(sp, j); ret frag(sp, j)
        }
        ret f
    }
    if level == 1 {
        let f = parse_re(2)
        let fs = frag_s(f); let fe = frag_e(f); let go = 1
        loop go == 1 {
            let p = re_peek()
            if p == 0 or p == 41 or p == 124 { go = 0 }
            if go == 1 {
                let f2 = parse_re(2)
                st_so1(fe, frag_s(f2)); fe = frag_e(f2)
            }
        }
        ret frag(fs, fe)
    }
    // level 0: expr = term (| term)*
    let f = parse_re(1)
    let fs = frag_s(f); let fe = frag_e(f); let go = 1
    loop go == 1 {
        if re_peek() != 124 { go = 0 }
        if go == 1 {
            re_adv()
            let f2 = parse_re(1)
            let s2 = frag_s(f2); let e2 = frag_e(f2)
            let sp = new_st(0 - 2, fs, s2)
            let j = new_st(0 - 4, 0 - 1, 0 - 1)
            st_so1(fe, j); st_so1(e2, j)
            fs = sp; fe = j
        }
    }
    ret frag(fs, fe)
}

fn compile(pat: &i8) {
    g_ns = 0; g_re_pat = pat; g_re_pos = 0
    let f = parse_re(0)
    let acc = new_st(0 - 3, 0 - 1, 0 - 1)
    st_so1(frag_e(f), acc)
    g_start = frag_s(f)
}

// Precompute epsilon closure for state s0 via iterative DFS.
// Stores leaf states (char/accept) into mem[16596..] flat list.
// mem[12500+s0] = start index, mem[14548+s0] = count.
fn compute_closure_for(s0: i64) {
    mem[12500 + s0] = g_eps_top
    g_gen = g_gen + 1
    let top = 0
    mem[26836 + top] = s0; top = top + 1
    loop top > 0 {
        top = top - 1
        let s = mem[26836 + top]
        if s >= 0 {
            if s < g_ns {
                if mem[10240 + s] != g_gen {
                    mem[10240 + s] = g_gen
                    let s3 = s * 3
                    let c = mem[s3]
                    if c == 0 - 2 {
                        mem[26836 + top] = mem[s3 + 1]; top = top + 1
                        mem[26836 + top] = mem[s3 + 2]; top = top + 1
                    } else {
                        if c == 0 - 4 {
                            mem[26836 + top] = mem[s3 + 1]; top = top + 1
                        } else {
                            mem[16596 + g_eps_top] = s
                            g_eps_top = g_eps_top + 1
                        }
                    }
                }
            }
        }
    }
    mem[14548 + s0] = g_eps_top - mem[12500 + s0]
}

fn compile_closures() {
    g_eps_top = 0
    let s = 0
    loop s < g_ns { compute_closure_for(s); s = s + 1 }
}

fn match_nfa(str: &i8, slen: i64) -> i64 {
    let gen = g_gen + 1; let clen = 0
    let cb = 6144
    let nb = 8192
    // Initial clist: precomputed closure of start state
    let cs0 = mem[12500 + g_start]
    let ce0 = cs0 + mem[14548 + g_start]
    let ci0 = cs0
    loop ci0 < ce0 {
        let tgt0 = mem[16596 + ci0]
        mem[10240 + tgt0] = gen
        mem[cb + clen] = tgt0 * 3; clen = clen + 1
        ci0 = ci0 + 1
    }
    let i = 0
    loop i < slen {
        let ch = str[i]
        gen = gen + 1; let nlen = 0
        let j = 0
        loop j < clen {
            let s3 = mem[cb + j]
            let sc = mem[s3]
            if sc == ch or sc == 0 - 1 {
                let out1 = mem[s3 + 1]
                if mem[10240 + out1] != gen {
                    mem[10240 + out1] = gen
                    let cl_s = mem[12500 + out1]
                    let cl_e = cl_s + mem[14548 + out1]
                    let ci = cl_s
                    loop ci < cl_e {
                        let target = mem[16596 + ci]
                        if mem[10240 + target] != gen {
                            mem[10240 + target] = gen
                            mem[nb + nlen] = target * 3; nlen = nlen + 1
                        }
                        ci = ci + 1
                    }
                }
            }
            j = j + 1
        }
        let tmp = cb; cb = nb; nb = tmp
        clen = nlen; i = i + 1
        if nlen == 0 { break }
    }
    g_gen = gen; g_clen = clen
    let k = 0
    loop k < clen {
        let s3 = mem[cb + k]
        if mem[s3] == 0 - 3 { ret 1 }
        k = k + 1
    }
    ret 0
}

fn gen_str_wb(i: i64, c: i64) { poke_byte(g_strbuf, i, c) }

fn gen_str(seed: i64, slen: i64) {
    let rng = (seed * 2654435761 + 1) & 2147483647
    let seed_add = 12345 + seed
    let i = 0
    loop i < slen {
        rng = (rng * 1103515245 + seed_add) & 2147483647
        gen_str_wb(i, 97 + rng % 26)
        i = i + 1
    }
}

// DFA subset construction using 64-bit NFA state bitmasks.
// Requires g_ns <= 63 (all benchmark patterns satisfy this).
// dfa_masks[qi] = bitmask of NFA states in DFA state qi
// dfa_acc[qi]   = 1 if DFA state qi contains NFA accept state
// dfa_delta[qi*32 + c] = next DFA state for char 'a'+c, or -1 (dead); row stride 32 (=1<<5)

fn bdf_acc_check(di_mask: i64) -> i64 {
    let sa = 0
    loop sa < g_ns {
        let bit = (di_mask >> sa) & 1
        if bit == 1 {
            if mem[sa * 3] == 0 - 3 { ret 1 }
        }
        sa = sa + 1
    }
    ret 0
}

fn bdf_next(di_mask: i64, c: i64) -> i64 {
    let next: i64 = 0
    let s = 0
    loop s < g_ns {
        let bit = (di_mask >> s) & 1
        if bit == 1 {
            let sc = mem[s * 3]
            let ok: i64 = 0
            if sc == c + 97 { ok = 1 }
            if sc == 0 - 1 { ok = 1 }
            if ok == 1 {
                let out1 = mem[s * 3 + 1]
                if out1 >= 0 {
                    let cl_s = mem[12500 + out1]
                    let cl_e = cl_s + mem[14548 + out1]
                    let ci = cl_s
                    loop ci < cl_e {
                        let t = mem[16596 + ci]
                        next = next | (1 << t)
                        ci = ci + 1
                    }
                }
            }
        }
        s = s + 1
    }
    ret next
}

fn bdf_find(mask: i64) -> i64 {
    let di = 0
    loop di < g_dfa_n {
        if mem[28884 + di] == mask { ret di }
        di = di + 1
    }
    ret 0 - 1
}

fn build_dfa() {
    g_dfa_n = 0
    let init: i64 = 0
    let cs0 = mem[12500 + g_start]
    let ce0 = cs0 + mem[14548 + g_start]
    let ci0 = cs0
    loop ci0 < ce0 {
        let s = mem[16596 + ci0]
        init = init | (1 << s)
        ci0 = ci0 + 1
    }
    mem[28884] = init; g_dfa_n = 1
    let qi = 0
    loop qi < g_dfa_n {
        let di_mask = mem[28884 + qi]
        mem[29140 + qi] = bdf_acc_check(di_mask)
        let c = 0
        loop c < 26 {
            let nm = bdf_next(di_mask, c)
            let found: i64 = 0 - 1
            if nm != 0 {
                found = bdf_find(nm)
                if found < 0 {
                    mem[28884 + g_dfa_n] = nm
                    found = g_dfa_n
                    g_dfa_n = g_dfa_n + 1
                }
            }
            mem[29396 + qi * 32 + c] = found
            c = c + 1
        }
        qi = qi + 1
    }
}

fn match_dfa(str: &i8, slen: i64) -> i64 {
    let state: i64 = 0
    let i = 0
    loop i < slen {
        let c = str[i] - 97
        state = mem[29396 + state * 32 + c]
        if state < 0 { ret 0 }
        i = i + 1
    }
    ret mem[29140 + state]
}

fn run_pat(pat: &i8, pidx: i64) -> i64 {
    compile(pat)
    compile_closures()
    build_dfa()
    let matches = 0; let ns = 100000; let i = 0
    let base_seed = pidx * 1000
    let slen_ctr = 0
    loop i < ns {
        let slen = 10 + slen_ctr
        slen_ctr = slen_ctr + 1; if slen_ctr == 50 { slen_ctr = 0 }
        gen_str(i + base_seed, slen)
        matches = matches + match_dfa(g_strbuf, slen)
        i = i + 1
    }
    ret matches
}

fn main() -> i64 {
    mem = alloc_pages(80)
    let ts = mem + 12300 * 8
    g_strbuf = mem + 12400 * 8

    let t0 = now_ms(ts)

    let total = 0
    total = total + run_pat("a.*b.*c", 0)
    total = total + run_pat("(ab|cd|ef)+", 1)
    total = total + run_pat("a.b.c.d.e", 2)
    total = total + run_pat("(a|b)(c|d)(e|f)", 3)
    total = total + run_pat("ab*c+d?ef", 4)
    total = total + run_pat(".*hello.*world.*", 5)
    total = total + run_pat("(abc|def|ghi|jkl)+", 6)
    total = total + run_pat("a.*a.*a.*a", 7)

    let t1 = now_ms(ts)
    let elapsed = t1 - t0

    print("matches: {total}\ntime: {elapsed} ms\n")
    ret 0
}
