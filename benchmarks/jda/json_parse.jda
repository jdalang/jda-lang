; JSON parse benchmark — parse array of objects, sum "value" fields
; Generates ~1.5MB JSON in-memory, then scans for "value": fields
; Same algorithm as C/Rust: byte scan for pattern + parse integer

fn jp_byte_at(buf: &i8, idx: i64) -> i64 {
    ret buf[idx]
}

; Write an integer to buffer, return new position
; tmp must be a pre-allocated scratch buffer
fn write_int(buf: &i8, pos: i64, val: i64, tmp: &i8) -> i64 {
    if val == 0 {
        poke_byte(buf, pos, 48)
        ret pos + 1
    }
    let n = 0
    let v = val
    loop v > 0 {
        let digit = v % 10
        poke_byte(tmp, n, digit + 48)
        v = v / 10
        n = n + 1
    }
    let p = pos
    let j = n - 1
    loop j >= 0 {
        let b = jp_byte_at(tmp, j)
        poke_byte(buf, p, b)
        p = p + 1
        j = j - 1
    }
    ret p
}

; Generate JSON: [{"id":0,"value":100},...]
fn generate_json(buf: &i8, n: i64) -> i64 {
    let tmp: &i8 = alloc_pages(1)
    let pos = 0
    poke_byte(buf, pos, 91)
    pos = pos + 1

    let i = 0
    loop i < n {
        if i > 0 {
            poke_byte(buf, pos, 44)
            pos = pos + 1
        }
        ; {"id":
        poke_byte(buf, pos, 123)
        poke_byte(buf, pos + 1, 34)
        poke_byte(buf, pos + 2, 105)
        poke_byte(buf, pos + 3, 100)
        poke_byte(buf, pos + 4, 34)
        poke_byte(buf, pos + 5, 58)
        pos = pos + 6
        pos = write_int(buf, pos, i, tmp)

        ; ,"value":
        poke_byte(buf, pos, 44)
        poke_byte(buf, pos + 1, 34)
        poke_byte(buf, pos + 2, 118)
        poke_byte(buf, pos + 3, 97)
        poke_byte(buf, pos + 4, 108)
        poke_byte(buf, pos + 5, 117)
        poke_byte(buf, pos + 6, 101)
        poke_byte(buf, pos + 7, 34)
        poke_byte(buf, pos + 8, 58)
        pos = pos + 9
        let val = 100 + i % 1000
        pos = write_int(buf, pos, val, tmp)

        poke_byte(buf, pos, 125)
        pos = pos + 1
        i = i + 1
    }

    poke_byte(buf, pos, 93)
    pos = pos + 1
    ret pos
}

; Check if buf[i..i+8] == "value":  (34 118 97 108 117 101 34 58)
fn is_value_key(buf: &i8, i: i64) -> i64 {
    if buf[i] != 34 { ret 0 }
    if buf[i + 1] != 118 { ret 0 }
    if buf[i + 2] != 97 { ret 0 }
    if buf[i + 3] != 108 { ret 0 }
    ret is_value_tail(buf, i)
}

fn is_value_tail(buf: &i8, i: i64) -> i64 {
    if buf[i + 4] != 117 { ret 0 }
    if buf[i + 5] != 101 { ret 0 }
    if buf[i + 6] != 34 { ret 0 }
    if buf[i + 7] != 58 { ret 0 }
    ret 1
}

; Parse JSON: scan for "value": pattern, sum all integer values
fn parse_and_sum(buf: &i8, len: i64) -> i64 {
    let total = 0
    let i = 0
    let limit = len - 8

    loop i < limit {
        let found = is_value_key(buf, i)
        if found == 1 {
            i = i + 8
            ; Parse integer inline
            let val = 0
            let b = buf[i]
            if b < 0 { b = b + 256 }
            loop b >= 48 and b <= 57 and i < len {
                val = val * 10 + b - 48
                i = i + 1
                b = buf[i]
                if b < 0 { b = b + 256 }
            }
            total = total + val
        } else {
            i = i + 1
        }
    }
    ret total
}

fn main() -> i64 {
    let n = 50000
    let buf: &i8 = alloc_pages(512)
    let len = generate_json(buf, n)
    let sum = parse_and_sum(buf, len)
    print("len={len} sum={sum}\n")
    ret 0
}
