fn main() {
    let limit = 100000
    let sieve = i64[100001]
    let i = 2
    loop i <= limit {
        sieve[i] = 0
        i = i + 1
    }
    i = 2
    loop i * i <= limit {
        let v = sieve[i]
        if v == 0 {
            let j = i * i
            loop j <= limit {
                sieve[j] = 1
                j = j + i
            }
        }
        i = i + 1
    }
    let count = 0
    i = 2
    loop i <= limit {
        let v = sieve[i]
        if v == 0 {
            count = count + 1
        }
        i = i + 1
    }
    print_int(count)
}
