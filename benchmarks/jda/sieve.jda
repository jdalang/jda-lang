fn main() -> i64 {
    let limit = 1000000
    let sieve: &i8 = alloc_pages(250)
    let i = 2
    loop i <= limit {
        poke_byte(sieve, i, 0)
        i = i + 1
    }
    i = 2
    loop i * i <= limit {
        let v = sieve[i]
        if v < 0 { v = v + 256 }
        if v == 0 {
            let j = i * i
            loop j <= limit {
                poke_byte(sieve, j, 1)
                j = j + i
            }
        }
        i = i + 1
    }
    let count = 0
    i = 2
    loop i <= limit {
        let v = sieve[i]
        if v < 0 { v = v + 256 }
        if v == 0 {
            count = count + 1
        }
        i = i + 1
    }
    print("{count}\n")
    ret 0
}
