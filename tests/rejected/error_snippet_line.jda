// This first line is deliberately not the line the error is on.
//
// Punctuation tokens record a line but no source offset, and the diagnostic
// renderer used to derive the snippet from the offset -- so it printed this
// line's text under a gutter that named a different one. The expected-error
// file pins the rendered snippet, not just the message.
fn main() {
    let z = 1
    let g = |a, b| => a + b
}
