// A method that does not exist used to compile clean and evaluate to the base
// value, so this program printed 0 and `check --json` reported ok:true. That is
// the shape a hallucinated API takes, which makes it the single worst thing for
// a language that wants to be written by a model: the failure is invisible.
fn main() {
    let nums = [3, 1, 2]
    let sorted = nums.totally_fake_method()
    print("{sorted}\n")
}
