; Test: a program that uses a function from a "dependency" (concatenated source)
; This simulates what jda-pkg.sh build does — prepend dep functions, then main

fn add(a: i64, b: i64) -> i64 {
    ret a + b
}

fn mul(a: i64, b: i64) -> i64 {
    ret a * b
}

fn main() -> i64 {
    let x = add(3, 4)
    let y = mul(x, 2)
    if y != 14 {
        syscall(60, 1, 0, 0)
    }
    print "pkg_build ok"
    ret 0
}
