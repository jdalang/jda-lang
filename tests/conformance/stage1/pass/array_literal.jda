; Test array literal constructors and utilities

fn main() {
    ; Literal constructors
    let a = arr3(10, 20, 30)
    let v0 = a[0]
    let v1 = a[1]
    let v2 = a[2]
    print("{v0}\n")
    print("{v1}\n")
    print("{v2}\n")

    ; arr4
    let b = arr4(1, 2, 3, 4)
    arr_println(b, 4)

    ; arr_fill / arr_zeros
    let z = arr_zeros(3)
    arr_println(z, 3)
    let f = arr_fill(3, 7)
    arr_println(f, 3)

    ; arr_range
    let r = arr_range(1, 5)
    arr_println(r, 4)

    ; arr_copy
    let c = arr_copy(a, 3)
    let eq1 = arr_eq(a, c, 3)
    print("{eq1}\n")

    ; arr_sum / arr_min / arr_max
    let s = arr_sum(a, 3)
    print("{s}\n")
    let mn = arr_min(a, 3)
    print("{mn}\n")
    let mx = arr_max(a, 3)
    print("{mx}\n")

    ; arr_contains / arr_index_of / arr_count
    let has20 = arr_contains(a, 3, 20)
    let has99 = arr_contains(a, 3, 99)
    print("{has20}\n")
    print("{has99}\n")
    let idx = arr_index_of(a, 3, 30)
    print("{idx}\n")

    let d = arr5(1, 2, 1, 3, 1)
    let cnt = arr_count(d, 5, 1)
    print("{cnt}\n")

    ; arr_reverse (in-place)
    let rev = arr3(1, 2, 3)
    arr_reverse(rev, 3)
    arr_println(rev, 3)

    ; arr_sort (in-place)
    let unsorted = arr5(5, 3, 1, 4, 2)
    arr_sort(unsorted, 5)
    arr_println(unsorted, 5)

    ; arr_swap
    let sw = arr2(100, 200)
    arr_swap(sw, 0, 1)
    arr_println(sw, 2)

    ; arr1 / arr6
    let one = arr1(42)
    arr_println(one, 1)
    let six = arr6(1, 2, 3, 4, 5, 6)
    arr_println(six, 6)

    print("ok\n")
}
