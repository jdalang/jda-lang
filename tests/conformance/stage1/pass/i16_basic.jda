; Test i16 (16-bit signed integer) type

fn main() {
    ; Basic i16 variable
    let a: i16 = 1000
    print("{a}\n")

    ; i16 max positive (32767)
    let b: i16 = 32767
    print("{b}\n")

    ; i16 arithmetic
    let x: i16 = 100
    let y: i16 = 25
    let sum = x + y
    print("{sum}\n")

    let diff = x - y
    print("{diff}\n")

    let prod = x * y
    print("{prod}\n")

    let quot = x / y
    print("{quot}\n")
}
