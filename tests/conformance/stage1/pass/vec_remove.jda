fn main() {
    let v = vec_new(4)
    vec_push(v, 10)
    vec_push(v, 20)
    vec_push(v, 30)
    let removed = vec_remove(v, 1)
    print("{removed}")
    ; After removing index 1: [10, 30]
    let a = vec_get(v, 0)
    let b = vec_get(v, 1)
    let len = vec_len(v)
    print("{a}")
    print("{b}")
    print("{len}")
}
