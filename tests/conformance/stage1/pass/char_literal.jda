fn main() -> i64 {
    let a = 'A'
    if a == 65 {
        print("char A ok\n")
    }
    let nl = '\n'
    if nl == 10 {
        print("char nl ok\n")
    }
    let zero = '0'
    if zero == 48 {
        print("char 0 ok\n")
    }
    let tab = '\t'
    if tab == 9 {
        print("char tab ok\n")
    }
    ret 0
}
