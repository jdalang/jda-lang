fn main() -> i64 {
    // range(start, end) — iterate from start to end-1
    let sum = 0
    for i in range(3, 7) {
        sum += i
    }
    // 3+4+5+6 = 18
    if sum == 18 {
        print("range2 ok\n")
    }
    // range(n) still works
    let s2 = 0
    for j in range(5) {
        s2 += j
    }
    // 0+1+2+3+4 = 10
    if s2 == 10 {
        print("range1 ok\n")
    }
    ret 0
}
