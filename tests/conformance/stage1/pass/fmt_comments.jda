// Test: code with comments compiles correctly after formatting

// helper function
fn double(x: i64) -> i64 {
  ret x + x
}

fn main() -> i64 {
  // test basic doubling
  let a = double(21)
  if a != 42 { syscall(60, 1, 0, 0) }
  let b = double(0)
  if b != 0 { syscall(60, 1, 0, 0) }
  print "fmt_comments ok"
  ret 0
}
