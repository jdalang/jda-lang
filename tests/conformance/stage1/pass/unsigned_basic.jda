// Test unsigned integer types u8, u16, u32, u64

fn main() {
    // u8 basic
    let a: u8 = 255
    print("{a}\n")

    // u16 basic
    let b: u16 = 65535
    print("{b}\n")

    // u32 basic
    let c: u32 = 100000
    print("{c}\n")

    // u64 basic
    let d: u64 = 42
    print("{d}\n")

    // Arithmetic on unsigned
    let x: u64 = 10
    let y: u64 = 3
    let sum = x + y
    print("{sum}\n")

    let diff = x - y
    print("{diff}\n")

    let prod = x * y
    print("{prod}\n")

    // Unsigned division (should use DIV not IDIV)
    let quot = x / y
    print("{quot}\n")

    let rem = x - (quot * y)
    print("{rem}\n")
}
