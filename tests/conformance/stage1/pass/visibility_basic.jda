// Test stdlib/visibility — pub/private convention

fn main() -> i64 {
    // --- Public names ---
    let r1 = vis_is_public("str_len")
    print("str_len public: ")
    print("{r1}")
    print("\n")

    // --- Private names ---
    let r2 = vis_is_private("_str_grow")
    print("_str_grow private: ")
    print("{r2}")
    print("\n")

    // --- Internal names ---
    let r3 = vis_is_internal("__compiler_hook")
    print("__compiler_hook internal: ")
    print("{r3}")
    print("\n")

    // --- Access levels ---
    let a1 = vis_check_access("vec_push")
    print("vec_push level: ")
    print("{a1}")
    print("\n")

    let a2 = vis_check_access("_vec_grow")
    print("_vec_grow level: ")
    print("{a2}")
    print("\n")

    let a3 = vis_check_access("__init")
    print("__init level: ")
    print("{a3}")
    print("\n")

    // --- Print access ---
    vis_print_access("map_get")
    vis_print_access("_map_hash")
    vis_print_access("__builtin")

    print("PASS\n")
    ret 0
}
