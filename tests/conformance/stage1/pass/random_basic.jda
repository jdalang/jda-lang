fn main() -> i64 {
    rng_seed(42)
    // Call a few times to exercise the generator
    let a = rng_next()
    let b = rng_next()
    if a != b { print "next ok\n" }

    let c = rng_range(10, 20)
    if c >= 10 and c < 20 { print "range ok\n" }

    let d = rng_float_x10k()
    if d >= 0 and d < 10000 { print "float_x10k ok\n" }

    ret 0
}
