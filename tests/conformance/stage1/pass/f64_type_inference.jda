fn main() {
    // Bug #10: let x = 3.14 without : f64 loses value
    let x = 3.14
    let xi = x.to_i64()
    print("{xi}")

    // Float arithmetic without annotation
    let a = 1.5
    let b = 2.5
    let c = a + b
    let ci = c.to_i64()
    print("{ci}")

    // Verify annotated still works
    let z: f64 = 7.25
    let zi = z.to_i64()
    print("{zi}")

    // Negative float literal
    let y = -2.5
    let neg_check = y + 10.0
    let ni = neg_check.to_i64()
    print("{ni}")

    // Zero
    let w = 0.0
    let wi = w.to_i64()
    print("{wi}")

    ret 0
}
