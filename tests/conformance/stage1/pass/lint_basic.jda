// Test stdlib/lint — naming checks, warnings, line checks

fn test_snake() {
    let s1 = lint_is_snake("my_func")
    let s2 = lint_is_snake("hello")
    let s3 = lint_is_snake("_private")
    let s4 = lint_is_snake("has123")
    let s5 = lint_is_snake("BadName")
    let s6 = lint_is_snake("UPPER")
    print("snake my_func: ")
    print("{s1}")
    print("\n")
    print("snake hello: ")
    print("{s2}")
    print("\n")
    print("snake _private: ")
    print("{s3}")
    print("\n")
    print("snake has123: ")
    print("{s4}")
    print("\n")
    print("snake BadName: ")
    print("{s5}")
    print("\n")
    print("snake UPPER: ")
    print("{s6}")
    print("\n")
}

fn test_upper() {
    let u1 = lint_is_upper("MAX_SIZE")
    let u2 = lint_is_upper("FOO")
    let u3 = lint_is_upper("A123")
    let u4 = lint_is_upper("lower")
    let u5 = lint_is_upper("Mixed")
    print("upper MAX_SIZE: ")
    print("{u1}")
    print("\n")
    print("upper FOO: ")
    print("{u2}")
    print("\n")
    print("upper A123: ")
    print("{u3}")
    print("\n")
    print("upper lower: ")
    print("{u4}")
    print("\n")
    print("upper Mixed: ")
    print("{u5}")
    print("\n")
}

fn test_pascal() {
    let p1 = lint_is_pascal("MyStruct")
    let p2 = lint_is_pascal("Node")
    let p3 = lint_is_pascal("Vec3d")
    let p4 = lint_is_pascal("lowercase")
    let p5 = lint_is_pascal("_private")
    print("pascal MyStruct: ")
    print("{p1}")
    print("\n")
    print("pascal Node: ")
    print("{p2}")
    print("\n")
    print("pascal Vec3d: ")
    print("{p3}")
    print("\n")
    print("pascal lowercase: ")
    print("{p4}")
    print("\n")
    print("pascal _private: ")
    print("{p5}")
    print("\n")
}

fn test_checks() {
    let f1 = lint_check_fn("do_stuff")
    let f2 = lint_check_fn("BadFunc")
    let c1 = lint_check_const("MAX_LEN")
    let c2 = lint_check_const("notConst")
    let s1 = lint_check_struct("MyType")
    let s2 = lint_check_struct("not_type")
    let v1 = lint_check_var("count")
    let v2 = lint_check_var("NOTVAR")
    print("fn do_stuff: ")
    print("{f1}")
    print("\n")
    print("fn BadFunc: ")
    print("{f2}")
    print("\n")
    print("const MAX_LEN: ")
    print("{c1}")
    print("\n")
    print("const notConst: ")
    print("{c2}")
    print("\n")
    print("struct MyType: ")
    print("{s1}")
    print("\n")
    print("struct not_type: ")
    print("{s2}")
    print("\n")
    print("var count: ")
    print("{v1}")
    print("\n")
    print("var NOTVAR: ")
    print("{v2}")
    print("\n")
}

fn test_warnings() {
    lint_init()
    lint_warn("foo", "unused variable")
    lint_warn("bar", "shadowed name")
    let w = lint_warning_count()
    print("warnings: ")
    print("{w}")
    print("\n")
    lint_summary()
    lint_reset()
    let w2 = lint_warning_count()
    print("after reset: ")
    print("{w2}")
    print("\n")
}

fn test_lines() {
    let ok1 = lint_check_line_len("short", 80)
    let ok2 = lint_check_line_len("ab", 1)
    print("line ok: ")
    print("{ok1}")
    print("\n")
    print("line too long: ")
    print("{ok2}")
    print("\n")
    let ws1 = lint_has_trailing_ws("hello ")
    let ws2 = lint_has_trailing_ws("hello")
    print("trailing ws: ")
    print("{ws1}")
    print("\n")
    print("no trailing ws: ")
    print("{ws2}")
    print("\n")
}

fn main() -> i64 {
    test_snake()
    test_upper()
    test_pascal()
    test_checks()
    test_warnings()
    test_lines()
    print("PASS\n")
    ret 0
}
