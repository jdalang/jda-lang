// Test stdlib/namespace — module registry

fn main() -> i64 {
    ns_init()

    // --- Initial state ---
    let c0 = ns_count()
    print("initial: ")
    print("{c0}")
    print("\n")

    // --- Register modules ---
    ns_register("string", "str_", 1)
    ns_register("vec", "vec_", 1)
    ns_register("hashmap", "map_", 2)
    let c1 = ns_count()
    print("after register: ")
    print("{c1}")
    print("\n")

    // --- Duplicate register (should be no-op) ---
    ns_register("string", "str_", 1)
    let c2 = ns_count()
    print("after dup: ")
    print("{c2}")
    print("\n")

    // --- is_loaded ---
    let r1 = ns_is_loaded("string")
    print("string loaded: ")
    print("{r1}")
    print("\n")
    let r2 = ns_is_loaded("regex")
    print("regex loaded: ")
    print("{r2}")
    print("\n")

    // --- get_version ---
    let v1 = ns_get_version("hashmap")
    print("hashmap version: ")
    print("{v1}")
    print("\n")
    let v2 = ns_get_version("missing")
    print("missing version: ")
    print("{v2}")
    print("\n")

    // --- ns_require (should not panic for loaded module) ---
    ns_require("vec")
    print("require vec: ok\n")

    // --- ns_list ---
    ns_list()

    print("PASS\n")
    ret 0
}
