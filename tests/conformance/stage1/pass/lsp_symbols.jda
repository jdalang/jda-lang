// Test: source with multiple symbol types that LSP should discover

fn add(a: i64, b: i64) -> i64 {
    ret a + b
}

fn sub(a: i64, b: i64) -> i64 {
    ret a - b
}

fn main() -> i64 {
    let x = add(10, 5)
    let y = sub(x, 3)
    if y != 12 { syscall(60, 1, 0, 0) }
    print "lsp_symbols ok"
    ret 0
}
