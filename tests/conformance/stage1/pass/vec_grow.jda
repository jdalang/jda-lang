fn main() {
    let v = vec_new(4)
    // Push 30 elements — will trigger multiple grows
    let i = 1
    loop i <= 30 {
        vec_push(v, i * 10)
        i = i + 1
    }
    // Verify all 30 survived
    let ok = 1
    i = 1
    loop i <= 30 {
        let val = vec_get(v, i - 1)
        let expected = i * 10
        if val != expected { ok = 0 }
        i = i + 1
    }
    let len = vec_len(v)
    if len != 30 { ok = 0 }
    if ok == 1 { print("ok") }
    if ok == 0 { print("fail") }
}
