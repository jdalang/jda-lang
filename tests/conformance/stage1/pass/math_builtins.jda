; Math builtin functions
fn main() {
    ; abs(-5) = 5
    let v = f64_neg(f64_from_int(5))
    if f64_to_int(f64_abs(v)) == 5 { print("abs ok\n") }

    ; sin(0) = 0, cos(0) = 1
    let z = f64_from_int(0)
    if f64_to_int(f64_sin(z)) == 0 { print("sin ok\n") }
    if f64_to_int(f64_cos(z)) == 1 { print("cos ok\n") }

    ; exp(0) = 1, exp(1) ~ 2.718
    if f64_to_int(f64_exp(z)) == 1 { print("exp0 ok\n") }
    let one = f64_from_int(1)
    if f64_to_int(f64_exp(one)) == 2 { print("exp1 ok\n") }

    ; log(1) = 0
    if f64_to_int(f64_log(one)) == 0 { print("log ok\n") }

    ; tanh(0) = 0
    if f64_to_int(f64_tanh(z)) == 0 { print("tanh ok\n") }
}
