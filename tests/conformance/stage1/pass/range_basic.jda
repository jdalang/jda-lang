fn main() -> i64 {
    // Test exclusive range [0, 5)
    let r = range_new(0, 5)
    let sz = range_size(r)
    print("{sz}\n")

    // Test contains
    let c1 = range_contains(r, 3)
    print("{c1}\n")
    let c2 = range_contains(r, 5)
    print("{c2}\n")

    // Test inclusive range [1, 5]
    let ri = range_inclusive(1, 5)
    let szi = range_size(ri)
    print("{szi}\n")

    // Test sum
    let s = range_sum(ri)
    print("{s}\n")

    // Test first/last
    let f = range_first(ri)
    print("{f}\n")
    let l = range_last(ri)
    print("{l}\n")

    // Test step range
    let rs = range_step(0, 20, 5)
    let szs = range_size(rs)
    print("{szs}\n")

    ret 0
}
