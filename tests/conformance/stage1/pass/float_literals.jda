fn main() -> i64 {
    ; Basic float literal
    let a: f64 = 3.14
    let b: f64 = 2.0
    let c: f64 = a + b
    let ci = f64_to_int(c)
    if ci == 5 { print "add ok\n" }

    ; Float multiplication
    let x: f64 = 2.5
    let y: f64 = 4.0
    let z: f64 = x * y
    let zi = f64_to_int(z)
    if zi == 10 { print "mul ok\n" }

    ; Float in expression
    let pi: f64 = 3.14159
    let r: f64 = 2.0
    let area: f64 = pi * r * r
    let ai = f64_to_int(area)
    if ai == 12 { print "expr ok\n" }

    ; Modulo operator
    let m = 17 % 5
    if m == 2 { print "mod ok\n" }

    ret 0
}
