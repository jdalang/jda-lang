// Test: reproducible builds — same inputs produce same results
// Verifies deterministic compilation (foundation for jda.lock)

fn fib(n: i64) -> i64 {
    if n <= 1 { ret n }
    ret fib(n - 1) + fib(n - 2)
}

fn main() -> i64 {
    let r = fib(10)
    if r != 55 { syscall(60, 1, 0, 0) }
    print "pkg_lock ok"
    ret 0
}
