fn main() -> i64 {
    ; --- Test 1: same-shape add ---
    let a = tensor_new1(3)
    let b = tensor_new1(3)
    let out = tensor_new1(3)
    let i = 0
    loop i < 3 {
        let va = f64_from_int(i + 1)
        let vb = f64_from_int((i + 1) * 10)
        tensor_set(a, i, va)
        tensor_set(b, i, vb)
        i = i + 1
    }
    ; a=[1,2,3], b=[10,20,30]
    broadcast_add_1d(a, b, out)
    let r0 = f64_to_int(tensor_get(out, 0))
    let r1 = f64_to_int(tensor_get(out, 1))
    let r2 = f64_to_int(tensor_get(out, 2))
    if r0 == 11 and r1 == 22 and r2 == 33 {
        print "same add ok"
    }
    tensor_free(a)
    tensor_free(b)
    tensor_free(out)

    ; --- Test 2: [2,3] + [3] row broadcast ---
    let m = tensor_new2(2, 3)
    let v = tensor_new1(3)
    let mo = tensor_new2(2, 3)
    ; m = [[1,2,3],[4,5,6]]
    tensor_set(m, 0, f64_from_int(1))
    tensor_set(m, 1, f64_from_int(2))
    tensor_set(m, 2, f64_from_int(3))
    tensor_set(m, 3, f64_from_int(4))
    tensor_set(m, 4, f64_from_int(5))
    tensor_set(m, 5, f64_from_int(6))
    ; v = [10,20,30]
    tensor_set(v, 0, f64_from_int(10))
    tensor_set(v, 1, f64_from_int(20))
    tensor_set(v, 2, f64_from_int(30))
    broadcast_add_2d1d(m, v, mo)
    ; expect [[11,22,33],[14,25,36]]
    let e0 = f64_to_int(tensor_get(mo, 0))
    let e1 = f64_to_int(tensor_get(mo, 1))
    let e2 = f64_to_int(tensor_get(mo, 2))
    let e3 = f64_to_int(tensor_get(mo, 3))
    let e4 = f64_to_int(tensor_get(mo, 4))
    let e5 = f64_to_int(tensor_get(mo, 5))
    if e0 == 11 and e1 == 22 and e2 == 33 and e3 == 14 and e4 == 25 and e5 == 36 {
        print "row broadcast ok"
    }
    tensor_free(v)

    ; --- Test 3: [2,3] + [2,1] column broadcast ---
    let cv = tensor_new2(2, 1)
    tensor_set(cv, 0, f64_from_int(100))
    tensor_set(cv, 1, f64_from_int(200))
    broadcast_add_2d_col(m, cv, mo)
    ; expect [[101,102,103],[204,205,206]]
    let c0 = f64_to_int(tensor_get(mo, 0))
    let c1 = f64_to_int(tensor_get(mo, 1))
    let c2 = f64_to_int(tensor_get(mo, 2))
    let c3 = f64_to_int(tensor_get(mo, 3))
    let c4 = f64_to_int(tensor_get(mo, 4))
    let c5 = f64_to_int(tensor_get(mo, 5))
    if c0 == 101 and c1 == 102 and c2 == 103 and c3 == 204 and c4 == 205 and c5 == 206 {
        print "col broadcast ok"
    }
    tensor_free(cv)

    ; --- Test 4: scalar broadcast ---
    let so = tensor_new2(2, 3)
    broadcast_scalar_add(m, f64_from_int(100), so)
    let s0 = f64_to_int(tensor_get(so, 0))
    let s5 = f64_to_int(tensor_get(so, 5))
    if s0 == 101 and s5 == 106 {
        print "scalar add ok"
    }
    broadcast_scalar_mul(m, f64_from_int(10), so)
    let p0 = f64_to_int(tensor_get(so, 0))
    let p5 = f64_to_int(tensor_get(so, 5))
    if p0 == 10 and p5 == 60 {
        print "scalar mul ok"
    }

    tensor_free(m)
    tensor_free(mo)
    tensor_free(so)
    ret 0
}
