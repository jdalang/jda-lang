fn math_gcd(a: i64, b: i64) -> i64 {
    let x = a
    let y = b
    if x < 0 { x = 0 - x }
    if y < 0 { y = 0 - y }
    loop y != 0 {
        let q = x / y
        let r = x - q * y
        x = y
        y = r
    }
    ret x
}
fn main() {
    let g = math_gcd(48, 18)
    if g == 6 {
        print("stdlib_gcd ok")
    }
}
