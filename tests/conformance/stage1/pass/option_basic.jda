; Test Option type — Some/None

fn main() {
    ; some / none
    let a = some(42)
    let b = none()

    ; is_some / is_none
    let s1 = opt_is_some(a)
    let s2 = opt_is_some(b)
    let n1 = opt_is_none(a)
    let n2 = opt_is_none(b)
    print("{s1}\n")
    print("{s2}\n")
    print("{n1}\n")
    print("{n2}\n")

    ; unwrap / unwrap_or
    let v1 = opt_unwrap(a)
    print("{v1}\n")
    let v2 = opt_unwrap_or(a, 0)
    let v3 = opt_unwrap_or(b, 99)
    print("{v2}\n")
    print("{v3}\n")

    ; opt_or
    let c = opt_or(b, a)
    let cv = opt_unwrap(c)
    print("{cv}\n")

    ; opt_eq
    let eq1 = opt_eq(a, some(42))
    let eq2 = opt_eq(a, some(10))
    let eq3 = opt_eq(b, none())
    print("{eq1}\n")
    print("{eq2}\n")
    print("{eq3}\n")

    ; opt_print
    opt_println(a)
    opt_println(b)

    print("ok\n")
}
