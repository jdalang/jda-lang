// Test chained f64 operator expressions (a + b * c, a - b * c, etc.)
// This tests the RAX-clobber fix in lower_instr_float

fn check(val: i64, expect: i64, name: i64) -> i64 {
    let v: f64 = val
    let vi = f64_to_int(v)
    if vi == expect {
        print name
        print " ok\n"
    }
    ret 0
}

fn test_in_fn(x: i64, y: i64) -> i64 {
    let a: f64 = f64_from_int(10)
    let b: f64 = f64_from_int(3)
    let c: f64 = f64_from_int(4)

    // a + b * c = 10 + 12 = 22
    let r1: f64 = a + b * c
    check(r1, 22, "add_mul")

    // a - b * c = 10 - 12 = -2
    let r2: f64 = a - b * c
    check(r2, -2, "sub_mul")

    // a * b + c = 30 + 4 = 34
    let r3: f64 = a * b + c
    check(r3, 34, "mul_add")

    // a * b - c = 30 - 4 = 26
    let r4: f64 = a * b - c
    check(r4, 26, "mul_sub")

    ret 0
}

fn test_tensor(t: i64, lr: i64) -> i64 {
    let p: f64 = tensor_get(t, 0)
    let g: f64 = tensor_get(t, 1)
    let lr_f: f64 = lr
    // p - lr * g = 10 - 1*2 = 8
    tensor_set(t, 2, p - lr_f * g)
    ret 0
}

fn main() -> i64 {
    test_in_fn(0, 0)

    // Test acc pattern in loop
    let t = tensor_new1(4)
    let one: f64 = f64_from_int(1)
    let two: f64 = f64_from_int(2)
    let three: f64 = f64_from_int(3)
    let ten: f64 = f64_from_int(10)
    tensor_set(t, 0, one)
    tensor_set(t, 1, two)
    tensor_set(t, 2, three)

    let acc: f64 = f64_from_int(0)
    let i = 0
    loop i < 3 {
        let v: f64 = tensor_get(t, i)
        acc = acc + v * v
        i = i + 1
    }
    // 1+4+9 = 14
    if f64_to_int(acc) == 14 { print "acc ok\n" }

    // Test tensor sgd pattern
    tensor_set(t, 0, ten)
    tensor_set(t, 1, two)
    test_tensor(t, one)
    let r: f64 = tensor_get(t, 2)
    if f64_to_int(r) == 8 { print "tset ok\n" }

    tensor_free(t)
    ret 0
}
