fn main() {
    ; plus one: "ab+c" = 4 bytes
    let r1 = regex_match("ab+c", 4, "abc", 3)
    print("{r1}")
    ; plus zero fails
    let r2 = regex_match("ab+c", 4, "ac", 2)
    print("{r2}")
    ; optional with: "ab?c" = 4 bytes
    let r3 = regex_match("ab?c", 4, "abc", 3)
    print("{r3}")
    ; optional without
    let r4 = regex_match("ab?c", 4, "ac", 2)
    print("{r4}")
}
