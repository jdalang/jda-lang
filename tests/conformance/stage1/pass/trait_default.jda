; Test: trait with default method inherited

trait Greetable {
    fn greet(&self) -> i64 {
        print "hello\n"
        ret 1
    }
}

struct Person {
    age: i64
}

impl Greetable for Person {
}

fn main() -> i64 {
    let p = Person{}
    p.age = 30
    let r = p.greet()
    if r == 1 { print "default ok\n" }
    ret 0
}
