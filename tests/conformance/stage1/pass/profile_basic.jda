; Test stdlib/profile — profiler slots, call counts, enable/disable

fn dummy_work() {
    let i = 0
    loop i < 100 {
        i = i + 1
    }
}

fn test_init() {
    prof_init()
    let en = prof_enabled()
    print("enabled: ")
    print("{en}")
    print("\n")
    let sc = prof_slot_count()
    print("slots: ")
    print("{sc}")
    print("\n")
}

fn test_enter_leave() {
    prof_enter(0, "func_a")
    dummy_work()
    prof_leave(0)

    prof_enter(0, "func_a")
    dummy_work()
    prof_leave(0)

    prof_enter(1, "func_b")
    dummy_work()
    prof_leave(1)

    let ca = prof_calls(0)
    let cb = prof_calls(1)
    print("calls func_a: ")
    print("{ca}")
    print("\n")
    print("calls func_b: ")
    print("{cb}")
    print("\n")

    let sc = prof_slot_count()
    print("active slots: ")
    print("{sc}")
    print("\n")

    ; Total ns should be > 0
    let ta = prof_total_ns(0)
    let ok = 0
    if ta > 0 { ok = 1 }
    print("func_a has time: ")
    print("{ok}")
    print("\n")

    ; Avg should be > 0
    let avg = prof_avg_ns(0)
    let ok2 = 0
    if avg > 0 { ok2 = 1 }
    print("func_a has avg: ")
    print("{ok2}")
    print("\n")
}

fn test_disable() {
    prof_disable()
    let en = prof_enabled()
    print("after disable: ")
    print("{en}")
    print("\n")

    ; This should be a no-op
    prof_enter(2, "ignored")
    prof_leave(2)
    let c = prof_calls(2)
    print("ignored calls: ")
    print("{c}")
    print("\n")

    prof_enable()
    let en2 = prof_enabled()
    print("after enable: ")
    print("{en2}")
    print("\n")
}

fn test_reset() {
    prof_reset(0)
    let ca = prof_calls(0)
    print("after reset calls: ")
    print("{ca}")
    print("\n")

    let sc = prof_slot_count()
    print("slots after reset: ")
    print("{sc}")
    print("\n")

    prof_reset_all()
    let sc2 = prof_slot_count()
    print("slots after reset_all: ")
    print("{sc2}")
    print("\n")
}

fn main() -> i64 {
    test_init()
    test_enter_leave()
    test_disable()
    test_reset()
    print("PASS\n")
    ret 0
}
