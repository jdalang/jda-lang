fn main() -> i64 {
    // Basic for loop
    let sum = 0
    for i in range(5) {
        sum += i
    }
    if sum == 10 { print "basic ok\n" }

    // Nested for loops
    let total = 0
    for i in range(3) {
        for j in range(4) {
            total += 1
        }
    }
    if total == 12 { print "nested ok\n" }

    // For loop with expression limit
    let n = 10
    let s = 0
    for i in range(n) {
        s += i
    }
    if s == 45 { print "expr_limit ok\n" }

    ret 0
}
