fn main() -> i64 {
    // Create and touch a file
    let r = fu_touch("/tmp/jda_fu_test.txt")
    if r == 0 { print("touch ok") }
    print("\n")

    // Copy file
    fu_cp("/tmp/jda_fu_test.txt", "/tmp/jda_fu_test2.txt")
    print("cp ok\n")

    // Move file
    fu_mv("/tmp/jda_fu_test2.txt", "/tmp/jda_fu_test3.txt")
    print("mv ok\n")

    // Mkdir -p
    fu_mkdir_p("/tmp/jda_fu_dir/sub/deep")
    print("mkdir_p ok\n")

    // Cleanup
    fu_rm_rf("/tmp/jda_fu_dir")
    print("rm_rf ok\n")

    // Cleanup test files
    _fu_unlink("/tmp/jda_fu_test.txt")
    _fu_unlink("/tmp/jda_fu_test3.txt")

    ret 0
}
