fn main() -> i64 {
    // Test range(5) -> [0, 1, 2, 3, 4]
    let v = range(5)
    let n = vec_len(v)
    let a = vec_get(v, 0)
    let b = vec_get(v, 4)
    if n == 5 and a == 0 and b == 4 {
        print "range ok"
    }

    // Test range2(3, 7) -> [3, 4, 5, 6]
    let v2 = range2(3, 7)
    let n2 = vec_len(v2)
    let c = vec_get(v2, 0)
    let d = vec_get(v2, 3)
    if n2 == 4 and c == 3 and d == 6 {
        print "range2 ok"
    }

    // Test range3(0, 10, 3) -> [0, 3, 6, 9]
    let v3 = range3(0, 10, 3)
    let n3 = vec_len(v3)
    let e = vec_get(v3, 0)
    let f = vec_get(v3, 3)
    if n3 == 4 and e == 0 and f == 9 {
        print "range3 ok"
    }

    ret 0
}
