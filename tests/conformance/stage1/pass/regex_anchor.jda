fn main() {
    let r1 = regex_search("^hello", 6, "hello world", 11)
    print("{r1}")
    let r2 = regex_search("^world", 6, "hello world", 11)
    let found2 = 0
    if r2 >= 0 { found2 = 1 }
    print("{found2}")
    let r3 = regex_match("hello$", 6, "hello", 5)
    print("{r3}")
    let r4 = regex_search("world$", 6, "hello world", 11)
    print("{r4}")
}
