fn _cp_test_byte(buf: &i8, idx: i64) -> i64 { ret buf[idx] }

fn main() -> i64 {
    // Test copy_bytes
    let src: &i8 = alloc_pages(1)
    poke_byte(src, 0, 65)
    poke_byte(src, 1, 66)
    poke_byte(src, 2, 67)
    let dst: &i8 = alloc_pages(1)
    copy_bytes(dst, src, 3)
    let b0 = _cp_test_byte(dst, 0)
    let b1 = _cp_test_byte(dst, 1)
    let b2 = _cp_test_byte(dst, 2)
    if b0 == 65 { print("bytes ok\n") }

    // Test copy_i64_array
    let arr: &i64 = alloc_pages(1)
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    let arr2 = copy_i64_array(arr, 3)
    // Modify original
    arr[0] = 99
    // Check copy is independent
    let v = arr2[0]
    print("{v}\n")

    // Test copy_vec
    let vec: &i64 = alloc_pages(1)
    vec[0] = 3   // len
    vec[1] = 8   // cap
    vec[2] = 100
    vec[3] = 200
    vec[4] = 300
    let vec2 = copy_vec(vec)
    vec[2] = 999
    let cv = vec2[2]
    print("{cv}\n")

    ret 0
}
