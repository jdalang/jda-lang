fn main() -> i64 {
    let out: &i8 = alloc_pages(1)

    // Create enum
    let colors = enum_new("Color", 5)
    enum_add(colors, "RED", 3, 0)
    enum_add(colors, "GREEN", 5, 1)
    enum_add(colors, "BLUE", 4, 2)

    // Count
    let cnt = enum_count(colors)
    print("{cnt}\n")

    // Lookup by name
    let v = enum_by_name(colors, "GREEN", 5)
    print("{v}\n")

    // Lookup by value
    let n = enum_by_val(colors, 2, out)
    syscall(1, 1, out, n)
    print("\n")

    // Has check
    let h = enum_has(colors, "RED", 3)
    print("{h}\n")

    // Missing
    let m = enum_has(colors, "YELLOW", 6)
    print("{m}\n")

    // Name at index
    n = enum_name_at(colors, 0, out)
    syscall(1, 1, out, n)
    print("\n")

    ret 0
}
