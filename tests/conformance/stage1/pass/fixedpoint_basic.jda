fn main() -> i64 {
    let out: &i8 = alloc_pages(1)

    // 3 * 7 = 21
    let a = fp_from_int(3)
    let b = fp_from_int(7)
    let c = fp_mul(a, b)
    print("{c}\n")

    // fp_to_str
    let v = fp_from_parts(3, 1415)
    let n = fp_to_str(v, out)
    syscall(1, 1, out, n)
    print("\n")

    // fp_whole and fp_frac
    let w = fp_whole(v)
    let f = fp_frac(v)
    print("{w}\n")
    print("{f}\n")

    // fp_div: 10 / 3 = 3.3333
    let ten = fp_from_int(10)
    let three = fp_from_int(3)
    let d = fp_div(ten, three)
    let n2 = fp_to_str(d, out)
    syscall(1, 1, out, n2)
    print("\n")

    ret 0
}
