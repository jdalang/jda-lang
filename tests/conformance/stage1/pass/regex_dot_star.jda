fn main() {
    ; dot matches any char: "h.llo" = 5 bytes
    let r1 = regex_match("h.llo", 5, "hello", 5)
    print("{r1}")
    ; star zero: "ab*c" = 4 bytes
    let r2 = regex_match("ab*c", 4, "ac", 2)
    print("{r2}")
    ; star no match: "ab*c" = 4 bytes
    let r3 = regex_match("ab*c", 4, "adc", 3)
    print("{r3}")
}
