derive(Ord, Eq, Clone, Debug)
struct Rec {
    x: i64
    y: i64
}

fn main() -> i64 {
    let a = Rec{}
    a.x = 1
    a.y = 5
    let b = Rec{}
    b.x = 2
    b.y = 3
    let c = Rec{}
    c.x = 1
    c.y = 5

    // === cmp_le: a <= c (equal) ===
    let lt_ac = Rec_lt(&a, &c)
    let eq_ac = Rec_eq(&a, &c)
    let le = cmp_le(lt_ac, eq_ac)
    if le == 1 { print "le ok" }

    // === cmp_gt: b > a ===
    let lt_ab = Rec_lt(&a, &b)
    let eq_ab = Rec_eq(&a, &b)
    let gt = cmp_gt(lt_ab, eq_ab)
    if gt == 0 { print "gt ok" }

    // === cmp_ge: a >= c (equal) ===
    let ge = cmp_ge(lt_ac, eq_ac)
    if ge == 1 { print "ge ok" }

    // === cmp: three-way ===
    let lt_ba = Rec_lt(&b, &a)
    let c3 = cmp(lt_ab, lt_ba)
    if c3 == -1 { print "cmp ok" }

    // === validate_range ===
    let v1 = validate_range(5, 1, 10)
    if v1 == 1 { print "vr ok" }
    let v2 = validate_range(15, 1, 10)
    if v2 == 0 { print "vr2 ok" }

    // === validate_positive ===
    let v3 = validate_positive(5)
    if v3 == 1 { print "vp ok" }
    let v4 = validate_positive(0)
    if v4 == 0 { print "vp2 ok" }

    // === validate_non_negative ===
    let v5 = validate_non_negative(0)
    if v5 == 1 { print "vnn ok" }

    ret 0
}
