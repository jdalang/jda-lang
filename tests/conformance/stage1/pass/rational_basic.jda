fn main() -> i64 {
    // 1/3 + 1/6 = 1/2
    let a = rat_new(1, 3)
    let b = rat_new(1, 6)
    let c = rat_add(a, b)
    let cn = rat_num(c)
    let cd = rat_den(c)
    print("{cn}/{cd}\n")

    // 2/3 * 3/4 = 1/2
    let x = rat_new(2, 3)
    let y = rat_new(3, 4)
    let d = rat_mul(x, y)
    let dn = rat_num(d)
    let dd = rat_den(d)
    print("{dn}/{dd}\n")

    // 5/1 is integer
    let e = rat_new(5, 1)
    let ei = rat_is_integer(e)
    print("{ei}\n")

    // comparison: 1/3 < 1/2 should be -1
    let p = rat_new(1, 3)
    let q = rat_new(1, 2)
    let cmp = rat_cmp(p, q)
    // cmp is -1, print as signed
    if cmp < 0 {
        print("-")
        let acmp = 0 - cmp
        print("{acmp}\n")
    } else {
        print("{cmp}\n")
    }

    // to_i64: 7/2 = 3
    let r = rat_new(7, 2)
    let ri = rat_to_i64(r)
    print("{ri}\n")

    ret 0
}
