// Test: code with hover-documentable constructs (fn, let, if, loop)

fn max_val(a: i64, b: i64) -> i64 {
    if a > b {
        ret a
    }
    ret b
}

fn main() -> i64 {
    let x = max_val(42, 17)
    if x != 42 { syscall(60, 1, 0, 0) }
    let y = max_val(3, 99)
    if y != 99 { syscall(60, 1, 0, 0) }
    print "lsp_hover ok"
    ret 0
}
