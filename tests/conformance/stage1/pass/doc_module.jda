;; Module-level documentation test.

;; Identity function.
fn identity(x: i64) -> i64 {
    ret x
}

;; Negate a value.
fn negate(x: i64) -> i64 {
    ret 0 - x
}

fn main() -> i64 {
    let a = identity(42)
    if a != 42 { syscall(60, 1, 0, 0) }
    let b = negate(7)
    if b != 0 - 7 { syscall(60, 1, 0, 0) }
    print "doc_module ok"
    ret 0
}
