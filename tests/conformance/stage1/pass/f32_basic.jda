// Test f32 (32-bit float) type — uses f64 precision internally

fn main() {
    // Basic f32 variable
    let a: f32 = 3.14
    let b: f32 = 2.0

    // Arithmetic
    let sum: f32 = a + b
    let diff: f32 = a - b
    let prod: f32 = a * b
    let quot: f32 = a / b

    // Comparison
    if a > b { print("gt\n") }
    if b < a { print("lt\n") }

    // i2f with f32 annotation
    let x: f32 = 42 as f64
    if x > 0.0 as f64 { print("pos\n") }

    print("ok\n")
}
