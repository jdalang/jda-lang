fn assert_close(a: i64, b: i64) {
    if a != b {
        syscall(60, 1, 0, 0)
    }
}

fn main() -> i64 {
    let a = f64_from_int(1)
    let b = f64_from_int(1)
    assert_close(a, b)
    let ten = f64_from_int(10)
    let c = f64_div(a, ten)
    let d = f64_div(a, ten)
    assert_close(c, d)
    print "assert_close ok"
    ret 0
}
