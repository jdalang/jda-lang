fn main() -> i64 {
    let a = op_add(3, 4)
    print("{a}\n")

    let b = op_mul(6, 7)
    print("{b}\n")

    let c = op_lt(1, 2)
    print("{c}\n")

    let d = op_eq(5, 5)
    print("{d}\n")

    let e = op_neg(42)
    ; print negative manually
    if e < 0 {
        print("-")
        let av = 0 - e
        print("{av}\n")
    }

    let f = op_abs(-10)
    print("{f}\n")

    let g = op_max(100, 200)
    print("{g}\n")

    let h = op_sign(-7)
    if h < 0 {
        print("-")
        let ah = 0 - h
        print("{ah}\n")
    }

    let i = op_clamp(150, 0, 100)
    print("{i}\n")

    ret 0
}
