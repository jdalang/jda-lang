; Test: properly formatted code compiles and runs correctly
; (validates that formatter-style indentation is valid Jda)

fn square(x: i64) -> i64 {
    ret x * x
}

fn main() -> i64 {
    let a = square(5)
    if a != 25 {
        syscall(60, 1, 0, 0)
    }
    let b = square(3)
    if b != 9 {
        syscall(60, 1, 0, 0)
    }
    print "lsp_format ok"
    ret 0
}
