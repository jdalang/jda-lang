fn main() -> i64 {
    ; Test * wildcard
    let r1 = fnmatch("*.jda", 5, "test.jda", 8)
    print("{r1}\n")

    ; Test ? wildcard
    let r2 = fnmatch("test_??", 7, "test_01", 7)
    print("{r2}\n")

    ; Test no match
    let r3 = fnmatch("*.py", 4, "test.jda", 8)
    print("{r3}\n")

    ; Test character class
    let r4 = fnmatch("[abc]x", 6, "bx", 2)
    print("{r4}\n")

    ; Test has_magic
    let m1 = fnmatch_has_magic("hello.txt", 9)
    print("{m1}\n")

    let m2 = fnmatch_has_magic("*.txt", 5)
    print("{m2}\n")

    ; Test exact match
    let r5 = fnmatch("hello", 5, "hello", 5)
    print("{r5}\n")

    ret 0
}
