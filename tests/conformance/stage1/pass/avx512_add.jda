fn vec_add_test(dst: i64, a: i64, b: i64) -> i64 {
    let dp = tensor_data(dst)
    let ap = tensor_data(a)
    let bp = tensor_data(b)
    let n = tensor_len(a)
    if avx512_check() == 1 {
        avx512_add_f64(dp, ap, bp, n)
    } else {
        let i = 0
        loop i < n {
            let va = tensor_get(a, i)
            let vb = tensor_get(b, i)
            let r = f64_add(va, vb)
            tensor_set(dst, i, r)
            i = i + 1
        }
    }
    ret 0
}

fn vec_mul_test(dst: i64, a: i64, b: i64) -> i64 {
    let dp = tensor_data(dst)
    let ap = tensor_data(a)
    let bp = tensor_data(b)
    let n = tensor_len(a)
    if avx512_check() == 1 {
        avx512_mul_f64(dp, ap, bp, n)
    } else {
        let i = 0
        loop i < n {
            let va = tensor_get(a, i)
            let vb = tensor_get(b, i)
            let r = f64_mul(va, vb)
            tensor_set(dst, i, r)
            i = i + 1
        }
    }
    ret 0
}

fn vec_scale_test(dst: i64, a: i64, s: i64) -> i64 {
    let dp = tensor_data(dst)
    let ap = tensor_data(a)
    let n = tensor_len(a)
    if avx512_check() == 1 {
        avx512_scale_f64(dp, ap, s, n)
    } else {
        let i = 0
        loop i < n {
            let va = tensor_get(a, i)
            let r = f64_mul(va, s)
            tensor_set(dst, i, r)
            i = i + 1
        }
    }
    ret 0
}

fn main() -> i64 {
    let a = tensor_new1(4)
    let b = tensor_new1(4)
    let out = tensor_new1(4)
    // a = [1, 2, 3, 4], b = [10, 20, 30, 40]
    let v1 = f64_from_int(1)
    tensor_set(a, 0, v1)
    let v2 = f64_from_int(2)
    tensor_set(a, 1, v2)
    let v3 = f64_from_int(3)
    tensor_set(a, 2, v3)
    let v4 = f64_from_int(4)
    tensor_set(a, 3, v4)
    let v10 = f64_from_int(10)
    tensor_set(b, 0, v10)
    let v20 = f64_from_int(20)
    tensor_set(b, 1, v20)
    let v30 = f64_from_int(30)
    tensor_set(b, 2, v30)
    let v40 = f64_from_int(40)
    tensor_set(b, 3, v40)
    // Test vec add: [11, 22, 33, 44]
    vec_add_test(out, a, b)
    let r0 = f64_to_int(tensor_get(out, 0))
    let r1 = f64_to_int(tensor_get(out, 1))
    let r2 = f64_to_int(tensor_get(out, 2))
    let r3 = f64_to_int(tensor_get(out, 3))
    if r0 == 11 and r1 == 22 and r2 == 33 and r3 == 44 {
        print "vec add ok"
    }
    // Test vec mul: [10, 40, 90, 160]
    vec_mul_test(out, a, b)
    let m0 = f64_to_int(tensor_get(out, 0))
    let m1 = f64_to_int(tensor_get(out, 1))
    let m2 = f64_to_int(tensor_get(out, 2))
    let m3 = f64_to_int(tensor_get(out, 3))
    if m0 == 10 and m1 == 40 and m2 == 90 and m3 == 160 {
        print "vec mul ok"
    }
    // Test vec scale: a * 5 = [5, 10, 15, 20]
    let five = f64_from_int(5)
    vec_scale_test(out, a, five)
    let s0 = f64_to_int(tensor_get(out, 0))
    let s1 = f64_to_int(tensor_get(out, 1))
    let s2 = f64_to_int(tensor_get(out, 2))
    let s3 = f64_to_int(tensor_get(out, 3))
    if s0 == 5 and s1 == 10 and s2 == 15 and s3 == 20 {
        print "vec scale ok"
    }
    tensor_free(a)
    tensor_free(b)
    tensor_free(out)
    ret 0
}
