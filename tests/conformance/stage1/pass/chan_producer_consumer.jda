let g_queue: &i64 = 0
let g_head = 0
let g_tail = 0
let g_current: &i64 = 0
let g_main_ctx: &i64 = 0
let g_ch: &i64 = 0

fn __thread_done() {
    if g_head == g_tail {
        ctx_switch(g_current, g_main_ctx)
    } else {
        let next: &i64 = g_queue[g_head]
        g_head = g_head + 1
        let old = g_current
        g_current = next
        ctx_switch(old, next)
    }
}

fn sched_yield() {
    g_queue[g_tail] = g_current
    g_tail = g_tail + 1
    let next: &i64 = g_queue[g_head]
    g_head = g_head + 1
    let old = g_current
    g_current = next
    ctx_switch(old, next)
}

fn producer() {
    chan_send(g_ch, 10)
    sched_yield()
    chan_send(g_ch, 20)
    sched_yield()
    chan_send(g_ch, 30)
    chan_close(g_ch)
}

fn consumer() {
    let run = 1
    loop run == 1 {
        let val = chan_recv(g_ch)
        if val == -2 {
            sched_yield()
        } else if val == -1 {
            run = 0
        } else {
            print_int(val)
            sched_yield()
        }
    }
    print("done")
}

fn main() {
    g_queue = alloc_pages(1)
    g_main_ctx = alloc_pages(1)
    g_ch = chan_new(2)

    let tp = spawn producer()
    g_queue[g_tail] = tp
    g_tail = g_tail + 1

    let tc = spawn consumer()
    g_queue[g_tail] = tc
    g_tail = g_tail + 1

    let first: &i64 = g_queue[g_head]
    g_head = g_head + 1
    g_current = first
    ctx_switch(g_main_ctx, first)
    print("exit")
}
