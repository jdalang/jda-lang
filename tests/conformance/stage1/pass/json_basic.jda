// stdlib/json.jda — parse, lookup, arrays, nesting, and the absent cases.
//
// The previous json.jda was written against a dialect this compiler does not
// implement (payload-carrying enums, slices, generic Result) and did not
// compile. This covers the rewrite: a flat node arena with integer handles,
// where -1 means absent everywhere so a missing key and a failed parse have
// the same shape.
fn main() {
    let src = "{\"name\":\"jda\",\"ver\":42,\"ok\":true,\"deps\":[1,2,3],\"nest\":{\"a\":7}}"
    let doc = json_parse(src, str_len(src))
    if doc < 0 { print("parse FAILED\n") ret 0 }
    print("kind={json_kind(doc)} expect 5\n")

    let name = json_obj_get(doc, "name", 4)
    print("name len={json_str_value_len(name)} expect 3: ")
    print_str(src + json_str_value_off(name), json_str_value_len(name))
    print("\n")

    let ver = json_obj_get(doc, "ver", 3)
    print("ver={json_num(ver)} expect 42\n")

    let ok = json_obj_get(doc, "ok", 2)
    print("ok={json_bool(ok)} expect 1\n")

    let deps = json_obj_get(doc, "deps", 4)
    print("deps len={json_len(deps)} expect 3, [1]={json_num(json_at(deps,1))} expect 2\n")

    let nest = json_obj_get(doc, "nest", 4)
    let a = json_obj_get(nest, "a", 1)
    print("nest.a={json_num(a)} expect 7\n")

    let missing = json_obj_get(doc, "nope", 4)
    print("missing={missing} expect -1\n")

    let bad = json_parse("{oops", 5)
    print("bad={bad} expect -1\n")
}
