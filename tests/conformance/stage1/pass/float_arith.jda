; Float arithmetic operations
fn main() {
    let a = f64_from_int(10)
    let b = f64_from_int(3)
    let sum = f64_add(a, b)
    let diff = f64_sub(a, b)
    let prod = f64_mul(a, b)
    let quot = f64_div(a, b)
    if f64_to_int(sum) == 13 { print("add ok\n") }
    if f64_to_int(diff) == 7 { print("sub ok\n") }
    if f64_to_int(prod) == 30 { print("mul ok\n") }
    if f64_to_int(quot) == 3 { print("div ok\n") }
    let neg = f64_neg(a)
    if f64_to_int(neg) == 0 - 10 { print("neg ok\n") }
}
