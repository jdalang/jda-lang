fn tensor_relu(a: i64, out: i64) -> i64 {
    let n = tensor_len(a)
    let zero = f64_from_int(0)
    let i = 0
    loop i < n {
        let v = tensor_get(a, i)
        if f64_gt(v, zero) == 1 {
            tensor_set(out, i, v)
        } else {
            tensor_set(out, i, zero)
        }
        i = i + 1
    }
    ret 0
}

fn tensor_max(a: i64) -> i64 {
    let n = tensor_len(a)
    let mx = tensor_get(a, 0)
    let i = 1
    loop i < n {
        let v = tensor_get(a, i)
        if f64_gt(v, mx) == 1 {
            mx = v
        }
        i = i + 1
    }
    ret mx
}

fn tensor_softmax(a: i64, out: i64) -> i64 {
    let n = tensor_len(a)
    let mx = tensor_max(a)
    let exp_sum = f64_from_int(0)
    let i = 0
    loop i < n {
        let v = tensor_get(a, i)
        let shifted = f64_sub(v, mx)
        let e = f64_exp(shifted)
        tensor_set(out, i, e)
        exp_sum = f64_add(exp_sum, e)
        i = i + 1
    }
    i = 0
    loop i < n {
        let v = tensor_get(out, i)
        let r = f64_div(v, exp_sum)
        tensor_set(out, i, r)
        i = i + 1
    }
    ret 0
}

fn main() -> i64 {
    // Test relu: [-3, -1, 0, 2, 5] -> [0, 0, 0, 2, 5]
    let a = tensor_new1(5)
    let out = tensor_new1(5)
    let vm3 = f64_from_int(-3)
    tensor_set(a, 0, vm3)
    let vm1 = f64_from_int(-1)
    tensor_set(a, 1, vm1)
    let v0 = f64_from_int(0)
    tensor_set(a, 2, v0)
    let v2 = f64_from_int(2)
    tensor_set(a, 3, v2)
    let v5 = f64_from_int(5)
    tensor_set(a, 4, v5)
    tensor_relu(a, out)
    let r0 = f64_to_int(tensor_get(out, 0))
    let r1 = f64_to_int(tensor_get(out, 1))
    let r2 = f64_to_int(tensor_get(out, 2))
    let r3 = f64_to_int(tensor_get(out, 3))
    let r4 = f64_to_int(tensor_get(out, 4))
    if r0 == 0 and r1 == 0 and r2 == 0 and r3 == 2 and r4 == 5 {
        print "relu ok"
    }
    // Test softmax: output sums to 1 (check as int = 1)
    let s = tensor_new1(3)
    let sout = tensor_new1(3)
    let s1 = f64_from_int(1)
    tensor_set(s, 0, s1)
    let s2 = f64_from_int(2)
    tensor_set(s, 1, s2)
    let s3 = f64_from_int(3)
    tensor_set(s, 2, s3)
    tensor_softmax(s, sout)
    // Sum of softmax outputs should be 1.0
    let p0 = tensor_get(sout, 0)
    let p1 = tensor_get(sout, 1)
    let partial = f64_add(p0, p1)
    let p2 = tensor_get(sout, 2)
    let total = f64_add(partial, p2)
    // Round to nearest integer: add 0.5 before truncating
    let half = f64_from_int(1)
    let two = f64_from_int(2)
    let half_val = f64_div(half, two)
    let rounded = f64_add(total, half_val)
    let total_i = f64_to_int(rounded)
    if total_i == 1 {
        print "softmax ok"
    }
    // softmax(3) > softmax(2) > softmax(1)
    let g2 = tensor_get(sout, 2)
    let g1 = tensor_get(sout, 1)
    let g0 = tensor_get(sout, 0)
    if f64_gt(g2, g1) == 1 {
        if f64_gt(g1, g0) == 1 {
            print "softmax order ok"
        }
    }
    tensor_free(a)
    tensor_free(out)
    tensor_free(s)
    tensor_free(sout)
    ret 0
}
