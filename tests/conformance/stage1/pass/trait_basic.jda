; Test: basic trait declaration and impl

trait Valuable {
    fn value(&self) -> i64
}

struct Num {
    v: i64
}

impl Valuable for Num {
    fn value(&self) -> i64 {
        ret self.v
    }
}

fn main() -> i64 {
    let n = Num{}
    n.v = 42
    let r = n.value()
    if r == 42 { print "trait ok\n" }
    ret 0
}
