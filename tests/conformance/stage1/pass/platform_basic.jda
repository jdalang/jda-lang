fn main() -> i64 {
    let out: &i8 = alloc_pages(1)

    // Test platform_system
    let n = platform_system(out, 64)
    syscall(1, 1, out, n)
    print("\n")

    // Test platform_machine
    n = platform_machine(out, 64)
    syscall(1, 1, out, n)
    print("\n")

    // Test platform_is_x86_64
    let x = platform_is_x86_64()
    print("{x}\n")

    // Test platform_page_size
    let ps = platform_page_size()
    print("{ps}\n")

    ret 0
}
