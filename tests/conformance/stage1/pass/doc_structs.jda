;; Documented code with multiple declaration types.

fn square(x: i64) -> i64 {
    ret x * x
}

fn cube(x: i64) -> i64 {
    ret x * x * x
}

fn main() -> i64 {
    let a = square(4)
    if a != 16 { syscall(60, 1, 0, 0) }
    let b = cube(3)
    if b != 27 { syscall(60, 1, 0, 0) }
    print "doc_structs ok"
    ret 0
}
