fn main() {
    let arr: &i64 = alloc_pages(1)
    arr[0] = 5
    arr[1] = 10
    arr[2] = 15
    let out: &i64 = map(arr, 3, fn(x: i64) -> i64 {
        ret x * 2
    })
    let a = out[0]
    let b = out[1]
    let c = out[2]
    if a == 10 and b == 20 and c == 30 {
        print("10")
        print("20")
        print("30")
    }
}
