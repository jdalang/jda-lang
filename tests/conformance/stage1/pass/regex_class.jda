fn main() {
    // char class: "[aeiou]" = 7 bytes
    let r1 = regex_match("[aeiou]", 7, "e", 1)
    print("{r1}")
    // no match
    let r2 = regex_match("[aeiou]", 7, "x", 1)
    print("{r2}")
    // range + quantifier: "[a-z]+" = 6 bytes
    let r3 = regex_match("[a-z]+", 6, "hello", 5)
    print("{r3}")
}
