; Test epoll: create pipe, write to it, epoll detects readability
; pipe2 syscall 293: pipe2(pipefd, flags) → 0
; write syscall 1: write(fd, buf, count) → bytes
; epoll_event struct: { u32 events(0), u32 padding(4), u64 data(8) } = 16 bytes
; EPOLLIN = 1, EPOLL_CTL_ADD = 1

fn main() {
    ; Create a pipe: pipefd[0]=read, pipefd[1]=write
    let pipefd: &i64 = alloc_pages(1)
    pipefd[0] = 0
    ; pipe2(pipefd, 0) — syscall 293
    let pr = syscall(293, pipefd, 0, 0)

    ; Extract read_fd and write_fd from the i32 pair
    ; pipefd is two i32s packed into first 8 bytes
    let pair = pipefd[0]
    let read_fd = pair and 4294967295
    let write_fd = pair / 4294967296

    ; Create epoll instance
    let epfd = epoll_create1(0)

    ; Build epoll_event struct for EPOLLIN on read_fd
    ; event.events = EPOLLIN (1), event.data.fd = read_fd
    let ev: &i64 = alloc_pages(1)
    ; events(u32) = 1 (EPOLLIN), padding = 0 → first 8 bytes = 1
    ev[0] = 1
    ; data.fd = read_fd
    ev[1] = read_fd

    ; EPOLL_CTL_ADD = 1
    let cr = epoll_ctl(epfd, 1, read_fd, ev)

    ; Write "hi" to the pipe
    let msg: &i8 = alloc_pages(1)
    poke_byte(msg, 0, 104)
    poke_byte(msg, 1, 105)
    let wr = syscall(1, write_fd, msg, 2)

    ; Now epoll_wait should return 1 (one fd ready)
    let out_ev: &i64 = alloc_pages(1)
    out_ev[0] = 0
    out_ev[1] = 0
    let nfds = epoll_wait(epfd, out_ev, 1, 0)

    if nfds == 1 {
        ; Check that returned event has EPOLLIN set
        let revents = out_ev[0] and 4294967295
        if revents and 1 {
            print("ready")
        }
    }
}
