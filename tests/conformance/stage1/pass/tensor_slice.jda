fn main() -> i64 {
    // --- Test 1D slicing ---
    let t = tensor_new1(5)
    let i = 0
    loop i < 5 {
        let v = f64_from_int(i * 10)
        tensor_set(t, i, v)
        i = i + 1
    }
    // t = [0, 10, 20, 30, 40]
    // slice [1:4:1] -> [10, 20, 30]
    let s = tensor_slice1d(t, 1, 4, 1)
    let v0 = f64_to_int(tensor_get(s, 0))
    let v1 = f64_to_int(tensor_get(s, 1))
    let v2 = f64_to_int(tensor_get(s, 2))
    if v0 == 10 and v1 == 20 and v2 == 30 {
        print "slice1d ok"
    }
    tensor_free(s)

    // slice with step=2: [0:5:2] -> [0, 20, 40]
    let s2 = tensor_slice1d(t, 0, -1, 2)
    let w0 = f64_to_int(tensor_get(s2, 0))
    let w1 = f64_to_int(tensor_get(s2, 1))
    let w2 = f64_to_int(tensor_get(s2, 2))
    if w0 == 0 and w1 == 20 and w2 == 40 {
        print "slice1d step ok"
    }
    tensor_free(s2)
    tensor_free(t)

    // --- Test 2D slicing ---
    // 3x4 matrix: val = row*10 + col
    let m = tensor_new2(3, 4)
    let r = 0
    loop r < 3 {
        let c = 0
        loop c < 4 {
            let idx = r * 4 + c
            let val = r * 10 + c
            let fv = f64_from_int(val)
            tensor_set(m, idx, fv)
            c = c + 1
        }
        r = r + 1
    }
    // m = [[0,1,2,3],[10,11,12,13],[20,21,22,23]]
    // slice rows [1:3], cols [1:3] -> [[11,12],[21,22]]
    let sub = tensor_slice2d(m, 1, 3, 1, 3)
    let s00 = f64_to_int(tensor_get(sub, 0))
    let s01 = f64_to_int(tensor_get(sub, 1))
    let s10 = f64_to_int(tensor_get(sub, 2))
    let s11 = f64_to_int(tensor_get(sub, 3))
    if s00 == 11 and s01 == 12 and s10 == 21 and s11 == 22 {
        print "slice2d ok"
    }
    tensor_free(sub)

    // --- Test row/col extraction ---
    let row1 = tensor_row(m, 1)
    let r0 = f64_to_int(tensor_get(row1, 0))
    let r1 = f64_to_int(tensor_get(row1, 1))
    let r2 = f64_to_int(tensor_get(row1, 2))
    let r3 = f64_to_int(tensor_get(row1, 3))
    if r0 == 10 and r1 == 11 and r2 == 12 and r3 == 13 {
        print "row ok"
    }
    tensor_free(row1)

    let col2 = tensor_col(m, 2)
    let c0 = f64_to_int(tensor_get(col2, 0))
    let c1 = f64_to_int(tensor_get(col2, 1))
    let c2 = f64_to_int(tensor_get(col2, 2))
    if c0 == 2 and c1 == 12 and c2 == 22 {
        print "col ok"
    }
    tensor_free(col2)
    tensor_free(m)

    ret 0
}
