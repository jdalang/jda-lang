fn main() -> i64 {
    ; (3+4i) + (1+2i) = (4+6i)
    let a = cx_new(3, 4)
    let b = cx_new(1, 2)
    let c = cx_add(a, b)
    let re = cx_re(c)
    let im = cx_im(c)
    print("{re}\n")
    print("{im}\n")

    ; (3+4i) * (1+2i) = (3*1-4*2) + (3*2+4*1)i = (-5+10i)
    let d = cx_mul(a, b)
    let dre = cx_re(d)
    let dim = cx_im(d)
    ; dre is -5, print as signed
    if dre < 0 {
        print("-")
        let adre = 0 - dre
        print("{adre}\n")
    } else {
        print("{dre}\n")
    }
    print("{dim}\n")

    ; |3+4i|^2 = 25
    let asq = cx_abs_sq(a)
    print("{asq}\n")

    ; conjugate of (3+4i) = (3-4i)
    let e = cx_conjugate(a)
    let eim = cx_im(e)
    if eim < 0 {
        print("-")
        let aeim = 0 - eim
        print("{aeim}\n")
    } else {
        print("{eim}\n")
    }

    ; equality
    let f = cx_new(3, 4)
    let eq = cx_eq(a, f)
    print("{eq}\n")

    ret 0
}
