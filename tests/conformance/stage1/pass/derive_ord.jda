derive(Ord, Eq)
struct Point {
    x: i64
    y: i64
}

fn main() -> i64 {
    let a = Point{}
    a.x = 1
    a.y = 2
    let b = Point{}
    b.x = 1
    b.y = 3
    let c = Point{}
    c.x = 2
    c.y = 0
    let d = Point{}
    d.x = 1
    d.y = 2

    // a(1,2) < b(1,3) — same x, y differs
    let r1 = Point_lt(&a, &b)
    if r1 == 1 { print "lt1 ok" }

    // b(1,3) < a(1,2) — should be 0
    let r2 = Point_lt(&b, &a)
    if r2 == 0 { print "lt2 ok" }

    // a(1,2) < c(2,0) — first field decides
    let r3 = Point_lt(&a, &c)
    if r3 == 1 { print "lt3 ok" }

    // a(1,2) < d(1,2) — equal, not less
    let r4 = Point_lt(&a, &d)
    if r4 == 0 { print "eq ok" }

    ret 0
}
