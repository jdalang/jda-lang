fn tensor_transpose(a: i64, out: i64) -> i64 {
    let rows = tensor_shape(a, 0)
    let cols = tensor_shape(a, 1)
    let i = 0
    loop i < rows {
        let j = 0
        loop j < cols {
            let idx_a = i * cols + j
            let v = tensor_get(a, idx_a)
            let idx_o = j * rows + i
            tensor_set(out, idx_o, v)
            j = j + 1
        }
        i = i + 1
    }
    ret 0
}

fn main() -> i64 {
    ; Transpose [[1,2,3],[4,5,6]] -> [[1,4],[2,5],[3,6]]
    let a = tensor_new2(2, 3)
    let out = tensor_new2(3, 2)
    let v1 = f64_from_int(1)
    tensor_set(a, 0, v1)
    let v2 = f64_from_int(2)
    tensor_set(a, 1, v2)
    let v3 = f64_from_int(3)
    tensor_set(a, 2, v3)
    let v4 = f64_from_int(4)
    tensor_set(a, 3, v4)
    let v5 = f64_from_int(5)
    tensor_set(a, 4, v5)
    let v6 = f64_from_int(6)
    tensor_set(a, 5, v6)
    tensor_transpose(a, out)
    ; out = [[1,4],[2,5],[3,6]] stored row-major: [1,4,2,5,3,6]
    let r0 = f64_to_int(tensor_get(out, 0))
    let r1 = f64_to_int(tensor_get(out, 1))
    let r2 = f64_to_int(tensor_get(out, 2))
    let r3 = f64_to_int(tensor_get(out, 3))
    let r4 = f64_to_int(tensor_get(out, 4))
    let r5 = f64_to_int(tensor_get(out, 5))
    if r0 == 1 and r1 == 4 and r2 == 2 and r3 == 5 and r4 == 3 and r5 == 6 {
        print "transpose ok"
    }
    tensor_free(a)
    tensor_free(out)
    ret 0
}
