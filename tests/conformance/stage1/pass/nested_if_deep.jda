// Six levels of if nesting and a six-way else-if chain both compile correctly.
fn deep(x: i64) -> i64 {
    if x > 0 {
        if x > 1 {
            if x > 2 {
                if x > 3 {
                    if x > 4 {
                        if x > 5 { ret 6 }
                        ret 5
                    }
                    ret 4
                }
                ret 3
            }
            ret 2
        }
        ret 1
    }
    ret 0
}
fn pick(x: i64) -> i64 {
    if x == 1 { ret 10 }
    else if x == 2 { ret 20 }
    else if x == 3 { ret 30 }
    else if x == 4 { ret 40 }
    else if x == 5 { ret 50 }
    else { ret 60 }
}
fn main() {
    let a = deep(6)
    let b = pick(5)
    print("{a}\n")
    print("{b}\n")
}
