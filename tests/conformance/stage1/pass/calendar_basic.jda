fn main() -> i64 {
    let out: &i8 = alloc_pages(1)

    // Day name for Monday (0)
    let n = cal_day_name(0, out)
    syscall(1, 1, out, n)
    print("\n")

    // Month name
    n = cal_month_name(4, out)
    syscall(1, 1, out, n)
    print("\n")

    // Weekday for 2026-04-07 (should be Tuesday = 1)
    let dow = cal_weekday(2026, 4, 7)
    print("{dow}\n")

    // Leap year
    let leap = cal_is_leap(2000)
    print("{leap}\n")

    // Days in Feb 2024
    let feb = cal_days_in_month(2024, 2)
    print("{feb}\n")

    ret 0
}
