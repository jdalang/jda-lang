fn main() {
    let s = str_from("Hello World", 11)
    let upper = str_to_upper(s)
    let lower = str_to_lower(s)
    let eu = str_from("HELLO WORLD", 11)
    let el = str_from("hello world", 11)
    let r1 = str_eq(upper, eu)
    let r2 = str_eq(lower, el)
    if r1 == 1 and r2 == 1 { print("ok") }
    if r1 == 0 or r2 == 0 { print("fail") }
}
