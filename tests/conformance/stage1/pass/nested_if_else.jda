fn classify(n: i64) -> i64 {
    if n > 100 {
        ret 3
    } else if n > 50 {
        ret 2
    } else if n > 0 {
        ret 1
    } else {
        ret 0
    }
}

fn main() {
    let a = classify(200)
    let b = classify(75)
    let c = classify(25)
    let d = classify(0)
    let sum = a + b + c + d
    if sum == 6 { print("ok") }
}
