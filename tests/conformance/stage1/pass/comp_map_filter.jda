fn main() -> i64 {
    // Python: [x*2 for x in range(5)] -> [0, 2, 4, 6, 8]
    let d1 = 0
    let v = range(5)
    let doubled = vec_comp_map(v, fn(x: i64) -> i64 { ret x * 2 + d1 })
    let n = vec_len(doubled)
    let a = vec_get(doubled, 0)
    let b = vec_get(doubled, 2)
    let c = vec_get(doubled, 4)
    if n == 5 and a == 0 and b == 4 and c == 8 {
        print "map ok"
    }

    // Python: [x for x in range(10) if x > 6] -> [7, 8, 9]
    let d2 = 0
    let v2 = range(10)
    let big = vec_comp_filter(v2, fn(x: i64) -> i64 { ret x > 6 + d2 })
    let n2 = vec_len(big)
    let d = vec_get(big, 0)
    let e = vec_get(big, 2)
    if n2 == 3 and d == 7 and e == 9 {
        print "filter ok"
    }

    // Python: [x*x for x in range(6) if x > 2] -> [9, 16, 25]
    let d3 = 0
    let d4 = 0
    let v3 = range(6)
    let squares = vec_comp_map_filter(v3,
        fn(x: i64) -> i64 { ret x * x + d3 },
        fn(x: i64) -> i64 { ret x > 2 + d4 })
    let n3 = vec_len(squares)
    let f = vec_get(squares, 0)
    let g = vec_get(squares, 1)
    let h = vec_get(squares, 2)
    if n3 == 3 and f == 9 and g == 16 and h == 25 {
        print "map_filter ok"
    }

    ret 0
}
