fn main() -> i64 {
    let ss = ss_new("hello world", 11)

    ; Scan "hello"
    let found = ss_scan(ss, "hello", 5)
    print("{found}\n")
    let p = ss_pos(ss)
    print("{p}\n")

    ; Scan " "
    found = ss_scan(ss, " ", 1)
    print("{found}\n")

    ; Check "world" without advancing
    let check = ss_check(ss, "world", 5)
    print("{check}\n")
    p = ss_pos(ss)
    print("{p}\n")

    ; Scan "world"
    found = ss_scan(ss, "world", 5)
    print("{found}\n")

    ; At end
    let eos = ss_eos(ss)
    print("{eos}\n")

    ; Rest length
    let rl = ss_rest_len(ss)
    print("{rl}\n")

    ret 0
}
