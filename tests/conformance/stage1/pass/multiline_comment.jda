/* This is a multi-line comment */
fn main() -> i64 {
    /* single line block comment */
    let x = 10
    /*
     * Multi-line
     * comment
     * spanning lines
     */
    let y = 20
    let z = x + y
    if z == 30 {
        print("mc1 ok\n")
    }
    let a = 5 /* inline comment */ + 3
    if a == 8 {
        print("mc2 ok\n")
    }
    ret 0
}
