; Float comparison operations
fn main() {
    let a = f64_from_int(3)
    let b = f64_from_int(5)
    if f64_lt(a, b) == 1 { print("lt ok\n") }
    if f64_gt(b, a) == 1 { print("gt ok\n") }
    if f64_eq(a, a) == 1 { print("eq ok\n") }
    if f64_eq(a, b) == 0 { print("neq ok\n") }
    let four = f64_from_int(4)
    let c = f64_sqrt(four)
    if f64_to_int(c) == 2 { print("sqrt ok\n") }
}
