fn main() -> i64 {
    ; Test LCS length
    let lcs = diff_lcs_len("abcde", 5, "abfde", 5)
    print("{lcs}\n")

    ; Test ratio (identical strings)
    let r1 = diff_ratio("hello", 5, "hello", 5)
    print("{r1}\n")

    ; Test ratio (different)
    let r2 = diff_ratio("abc", 3, "axc", 3)
    print("{r2}\n")

    ; Test ratio (empty)
    let r3 = diff_ratio("", 0, "", 0)
    print("{r3}\n")

    ret 0
}
