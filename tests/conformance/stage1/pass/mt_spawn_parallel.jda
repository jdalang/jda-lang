; Test that clone_thread spawns a real OS thread that runs in parallel
; Parent and child both atomically increment a shared counter
let g_counter: &i64 = 0
let g_done: &i64 = 0

fn child_fn() {
    let i = 0
    loop i < 1000 {
        atomic_fetch_add(g_counter, 1)
        i = i + 1
    }
    ; Signal done
    g_done[0] = 1
    futex_wake(g_done, 1)
    ; Exit thread
    let dummy = syscall(60, 0, 0, 0)
}

fn main() {
    g_counter = alloc_pages(1)
    g_counter[0] = 0
    g_done = alloc_pages(1)
    g_done[0] = 0

    let child_stack: &i8 = alloc_pages(16)
    let stack_top: &i8 = child_stack + 65536
    let fn_p = fn_addr(child_fn)
    let tid = clone_thread(stack_top, fn_p)

    ; Parent also increments 1000 times
    let i = 0
    loop i < 1000 {
        atomic_fetch_add(g_counter, 1)
        i = i + 1
    }

    ; Wait for child to finish
    let run = 1
    loop run == 1 {
        let d = g_done[0]
        if d == 1 {
            run = 0
        } else {
            futex_wait(g_done, 0)
        }
    }

    let total = atomic_load(g_counter)
    if total == 2000 {
        print("2000")
    }
}
