fn _lct_write(path: &i8, data: &i8, dlen: i64) -> i64 {
    ret syscall(2, path, 577, 420)
}

fn _lct_write2(fd: i64, data: &i8, dlen: i64) -> i64 {
    ret syscall(1, fd, data, dlen)
}

fn _lct_close(fd: i64) -> i64 {
    ret syscall(3, fd, 0, 0)
}

fn main() -> i64 {
    let out: &i8 = alloc_pages(1)

    ; Write a test file (split syscalls into separate functions)
    let fd = _lct_write("/tmp/lc_test.txt", "x", 0)
    _lct_write2(fd, "line one\nline two\nline three\n", 28)
    _lct_close(fd)

    ; Open and index
    let lc = linecache_open("/tmp/lc_test.txt")

    ; Count
    let cnt = linecache_count(lc)
    print("{cnt}\n")

    ; Get line 1
    let n = linecache_getline(lc, 1, out)
    syscall(1, 1, out, n)
    print("\n")

    ; Get line 3
    n = linecache_getline(lc, 3, out)
    syscall(1, 1, out, n)
    print("\n")

    ; Out of range
    let bad = linecache_getline(lc, 10, out)
    if bad < 0 {
        print("out of range\n")
    }

    linecache_close(lc)

    ; Cleanup
    syscall(87, "/tmp/lc_test.txt", 0, 0)

    ret 0
}
