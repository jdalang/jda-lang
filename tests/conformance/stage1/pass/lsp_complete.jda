// Test: code with completable identifiers (fn names, variables)

fn compute(a: i64, b: i64) -> i64 {
    let sum = a + b
    let product = a * b
    ret sum + product
}

fn main() -> i64 {
    let result = compute(3, 4)
    if result != 19 { syscall(60, 1, 0, 0) }
    print "lsp_complete ok"
    ret 0
}
