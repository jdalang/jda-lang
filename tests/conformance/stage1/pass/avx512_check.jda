fn main() -> i64 {
    ; avx512_check returns 0 or 1 — either is valid
    let has = avx512_check()
    if has == 0 {
        print "avx512 not available"
    }
    if has == 1 {
        print "avx512 available"
    }
    ; Always print ok to confirm it compiled and ran
    print "check ok"
    ret 0
}
