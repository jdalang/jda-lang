; Test: code with proper indentation compiles correctly

fn nested(x: i64) -> i64 {
  if x > 0 {
    if x > 10 {
      ret x + 1
    }
    ret x
  }
  ret 0
}

fn main() -> i64 {
  let a = nested(15)
  if a != 16 { syscall(60, 1, 0, 0) }
  let b = nested(5)
  if b != 5 { syscall(60, 1, 0, 0) }
  let c = nested(0)
  if c != 0 { syscall(60, 1, 0, 0) }
  print "fmt_indent ok"
  ret 0
}
