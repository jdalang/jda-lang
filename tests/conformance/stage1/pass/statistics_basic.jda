fn main() -> i64 {
    let data: &i64 = alloc_pages(1)
    data[0] = 10
    data[1] = 20
    data[2] = 30
    data[3] = 40
    data[4] = 50

    let s = stat_sum(data, 5)
    print("{s}\n")

    let mean = stat_mean_x10k(data, 5)
    print("{mean}\n")

    let med = stat_median(data, 5)
    print("{med}\n")

    let lo = stat_min(data, 5)
    print("{lo}\n")

    let hi = stat_max(data, 5)
    print("{hi}\n")

    let r = stat_range(data, 5)
    print("{r}\n")

    ; Mode test
    let data2: &i64 = alloc_pages(1)
    data2[0] = 1
    data2[1] = 2
    data2[2] = 2
    data2[3] = 3
    let mode = stat_mode(data2, 4)
    print("{mode}\n")

    ret 0
}
