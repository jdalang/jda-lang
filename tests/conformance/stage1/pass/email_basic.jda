fn _write_buf(buf: &i8, len: i64) -> i64 {
    syscall(1, 1, buf, len)
    ret 0
}

fn main() -> i64 {
    ; Build email:
    ; From: alice@example.com
    ; To: bob@example.com
    ; Subject: Hello
    ;
    ; Hi Bob!
    let buf: &i8 = alloc_pages(1)
    let p = 0
    ; "From: alice@example.com\n"
    poke_byte(buf, p, 70) p = p + 1   ; F
    poke_byte(buf, p, 114) p = p + 1  ; r
    poke_byte(buf, p, 111) p = p + 1  ; o
    poke_byte(buf, p, 109) p = p + 1  ; m
    poke_byte(buf, p, 58) p = p + 1   ; :
    poke_byte(buf, p, 32) p = p + 1   ; space
    ; alice@example.com
    poke_byte(buf, p, 97) p = p + 1   ; a
    poke_byte(buf, p, 108) p = p + 1  ; l
    poke_byte(buf, p, 105) p = p + 1  ; i
    poke_byte(buf, p, 99) p = p + 1   ; c
    poke_byte(buf, p, 101) p = p + 1  ; e
    poke_byte(buf, p, 64) p = p + 1   ; @
    poke_byte(buf, p, 101) p = p + 1  ; e
    poke_byte(buf, p, 120) p = p + 1  ; x
    poke_byte(buf, p, 97) p = p + 1   ; a
    poke_byte(buf, p, 109) p = p + 1  ; m
    poke_byte(buf, p, 112) p = p + 1  ; p
    poke_byte(buf, p, 108) p = p + 1  ; l
    poke_byte(buf, p, 101) p = p + 1  ; e
    poke_byte(buf, p, 46) p = p + 1   ; .
    poke_byte(buf, p, 99) p = p + 1   ; c
    poke_byte(buf, p, 111) p = p + 1  ; o
    poke_byte(buf, p, 109) p = p + 1  ; m
    poke_byte(buf, p, 10) p = p + 1   ; \n
    ; "To: bob@example.com\n"
    poke_byte(buf, p, 84) p = p + 1   ; T
    poke_byte(buf, p, 111) p = p + 1  ; o
    poke_byte(buf, p, 58) p = p + 1   ; :
    poke_byte(buf, p, 32) p = p + 1   ; space
    ; bob@example.com
    poke_byte(buf, p, 98) p = p + 1   ; b
    poke_byte(buf, p, 111) p = p + 1  ; o
    poke_byte(buf, p, 98) p = p + 1   ; b
    poke_byte(buf, p, 64) p = p + 1   ; @
    poke_byte(buf, p, 101) p = p + 1  ; e
    poke_byte(buf, p, 120) p = p + 1  ; x
    poke_byte(buf, p, 97) p = p + 1   ; a
    poke_byte(buf, p, 109) p = p + 1  ; m
    poke_byte(buf, p, 112) p = p + 1  ; p
    poke_byte(buf, p, 108) p = p + 1  ; l
    poke_byte(buf, p, 101) p = p + 1  ; e
    poke_byte(buf, p, 46) p = p + 1   ; .
    poke_byte(buf, p, 99) p = p + 1   ; c
    poke_byte(buf, p, 111) p = p + 1  ; o
    poke_byte(buf, p, 109) p = p + 1  ; m
    poke_byte(buf, p, 10) p = p + 1   ; \n
    ; "Subject: Hello\n"
    poke_byte(buf, p, 83) p = p + 1   ; S
    poke_byte(buf, p, 117) p = p + 1  ; u
    poke_byte(buf, p, 98) p = p + 1   ; b
    poke_byte(buf, p, 106) p = p + 1  ; j
    poke_byte(buf, p, 101) p = p + 1  ; e
    poke_byte(buf, p, 99) p = p + 1   ; c
    poke_byte(buf, p, 116) p = p + 1  ; t
    poke_byte(buf, p, 58) p = p + 1   ; :
    poke_byte(buf, p, 32) p = p + 1   ; space
    poke_byte(buf, p, 72) p = p + 1   ; H
    poke_byte(buf, p, 101) p = p + 1  ; e
    poke_byte(buf, p, 108) p = p + 1  ; l
    poke_byte(buf, p, 108) p = p + 1  ; l
    poke_byte(buf, p, 111) p = p + 1  ; o
    poke_byte(buf, p, 10) p = p + 1   ; \n
    ; blank line (header/body separator)
    poke_byte(buf, p, 10) p = p + 1   ; \n
    ; "Hi Bob!"
    poke_byte(buf, p, 72) p = p + 1   ; H
    poke_byte(buf, p, 105) p = p + 1  ; i
    poke_byte(buf, p, 32) p = p + 1   ; space
    poke_byte(buf, p, 66) p = p + 1   ; B
    poke_byte(buf, p, 111) p = p + 1  ; o
    poke_byte(buf, p, 98) p = p + 1   ; b
    poke_byte(buf, p, 33) p = p + 1   ; !

    let h = email_parse(buf, p)
    let hcnt = email_header_count(h)
    print("headers: {hcnt}\n")

    ; Get From
    let out: &i8 = alloc_pages(1)
    let flen = email_from(h, out)
    print("from len: {flen}\n")
    let wr = _write_buf(out, flen)
    print("\n")

    ; Get To
    let tlen = email_to(h, out)
    print("to len: {tlen}\n")
    let wr2 = _write_buf(out, tlen)
    print("\n")

    ; Get Subject
    let slen = email_subject(h, out)
    print("subj len: {slen}\n")
    let wr3 = _write_buf(out, slen)
    print("\n")

    ; Get Body
    let blen = email_body(h, out)
    print("body len: {blen}\n")
    let wr4 = _write_buf(out, blen)
    print("\n")

    ret 0
}
