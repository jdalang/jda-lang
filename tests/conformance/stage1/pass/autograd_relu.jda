; Test autograd: ReLU and tensor elementwise gradient rules
; relu(a) → grad_a = grad_c * (a > 0 ? 1 : 0)
; Also tests tensor-level gradient accumulation

fn grad_relu(a: i64, grad_c: i64) -> i64 {
    let zero = f64_from_int(0)
    if f64_gt(a, zero) == 1 { ret grad_c }
    ret zero
}

fn grad_tensor_relu(a: i64, grad_c: i64, grad_a: i64) -> i64 {
    let n = tensor_len(a)
    let zero = f64_from_int(0)
    let i = 0
    loop i < n {
        let ai = tensor_get(a, i)
        let gc = tensor_get(grad_c, i)
        let ga = tensor_get(grad_a, i)
        if f64_gt(ai, zero) == 1 {
            let new_ga = f64_add(ga, gc)
            tensor_set(grad_a, i, new_ga)
        }
        i = i + 1
    }
    ret 0
}

fn grad_tensor_add(grad_c: i64, grad_a: i64, grad_b: i64) -> i64 {
    let n = tensor_len(grad_c)
    let i = 0
    loop i < n {
        let gc = tensor_get(grad_c, i)
        let ga = tensor_get(grad_a, i)
        let gb = tensor_get(grad_b, i)
        let new_ga = f64_add(ga, gc)
        let new_gb = f64_add(gb, gc)
        tensor_set(grad_a, i, new_ga)
        tensor_set(grad_b, i, new_gb)
        i = i + 1
    }
    ret 0
}

fn main() -> i64 {
    ; Scalar relu gradient
    let one = f64_from_int(1)
    let zero = f64_from_int(0)
    let gc = f64_from_int(1)

    ; relu(3) = 3 → grad = 1*gc = 1
    let pos = f64_from_int(3)
    let g_pos = grad_relu(pos, gc)
    let g_pos_i = f64_to_int(g_pos)

    ; relu(-2) = 0 → grad = 0
    let neg = f64_from_int(-2)
    let g_neg = grad_relu(neg, gc)
    let g_neg_i = f64_to_int(g_neg)

    if g_pos_i == 1 and g_neg_i == 0 {
        print "grad relu scalar ok"
    }

    ; Tensor relu gradient: a = [-1, 2, -3, 4], grad_c = [1,1,1,1]
    ; Expected grad_a: [0, 1, 0, 1]
    let a = tensor_new1(4)
    let gc_t = tensor_new1(4)
    let ga_t = tensor_new1(4)
    let vm1 = f64_from_int(-1)
    tensor_set(a, 0, vm1)
    let v2 = f64_from_int(2)
    tensor_set(a, 1, v2)
    let vm3 = f64_from_int(-3)
    tensor_set(a, 2, vm3)
    let v4 = f64_from_int(4)
    tensor_set(a, 3, v4)
    tensor_fill(gc_t, one)
    tensor_fill(ga_t, zero)
    grad_tensor_relu(a, gc_t, ga_t)
    let r0 = f64_to_int(tensor_get(ga_t, 0))
    let r1 = f64_to_int(tensor_get(ga_t, 1))
    let r2 = f64_to_int(tensor_get(ga_t, 2))
    let r3 = f64_to_int(tensor_get(ga_t, 3))
    if r0 == 0 and r1 == 1 and r2 == 0 and r3 == 1 {
        print "grad relu tensor ok"
    }

    ; Tensor add gradient: grad_c=[2,3], grad_a and grad_b should each get [2,3]
    let gc2 = tensor_new1(2)
    let ga2 = tensor_new1(2)
    let gb2 = tensor_new1(2)
    let vtwo = f64_from_int(2)
    tensor_set(gc2, 0, vtwo)
    let vthree = f64_from_int(3)
    tensor_set(gc2, 1, vthree)
    tensor_fill(ga2, zero)
    tensor_fill(gb2, zero)
    grad_tensor_add(gc2, ga2, gb2)
    let ta0 = f64_to_int(tensor_get(ga2, 0))
    let ta1 = f64_to_int(tensor_get(ga2, 1))
    let tb0 = f64_to_int(tensor_get(gb2, 0))
    let tb1 = f64_to_int(tensor_get(gb2, 1))
    if ta0 == 2 and ta1 == 3 and tb0 == 2 and tb1 == 3 {
        print "grad tensor add ok"
    }
    tensor_free(a)
    tensor_free(gc_t)
    tensor_free(ga_t)
    tensor_free(gc2)
    tensor_free(ga2)
    tensor_free(gb2)
    ret 0
}
