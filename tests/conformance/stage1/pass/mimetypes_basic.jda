fn main() -> i64 {
    let out: &i8 = alloc_pages(1)

    ; Test direct lookup
    let n = mime_type("html", 4, out, 256)
    syscall(1, 1, out, n)
    print("\n")

    n = mime_type("json", 4, out, 256)
    syscall(1, 1, out, n)
    print("\n")

    n = mime_type("png", 3, out, 256)
    syscall(1, 1, out, n)
    print("\n")

    ; Test guess from path
    n = mime_guess("index.html", 10, out, 256)
    syscall(1, 1, out, n)
    print("\n")

    ; Test is_text
    let t1 = mime_is_text("css", 3)
    print("{t1}\n")

    let t2 = mime_is_text("png", 3)
    print("{t2}\n")

    ret 0
}
