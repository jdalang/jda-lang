// Math builtin functions: pow, tanh
fn main() {
    // pow(2, 10) = 1024
    let two = f64_from_int(2)
    let ten = f64_from_int(10)
    let pw = f64_pow(two, ten)
    if f64_to_int(pw) == 1024 { print("pow ok\n") }

    // pow(3, 3) = 27
    let three = f64_from_int(3)
    let p2 = f64_pow(three, three)
    if f64_to_int(p2) == 27 { print("pow2 ok\n") }

    // tanh(0) = 0
    let z = f64_from_int(0)
    let th = f64_tanh(z)
    if f64_to_int(th) == 0 { print("tanh ok\n") }
}
