struct Record {
    kind: i64
    size: i64
    flags: i64
}

fn verify(r: &Record) -> i64 {
    if r.kind == 1 {
        if r.size == 100 {
            if r.flags == 0 { ret 1 }
        }
    }
    ret 0
}

fn main() {
    let r = Record{}
    r.kind = 1
    r.size = 100
    r.flags = 0
    let ok = verify(&r)
    if ok == 1 { print("ok") }
}
