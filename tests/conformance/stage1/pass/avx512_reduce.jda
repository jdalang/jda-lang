fn vec_sum_test(a: i64) -> i64 {
    let ap = tensor_data(a)
    let n = tensor_len(a)
    if avx512_check() == 1 {
        ret avx512_sum_f64(ap, n)
    }
    let acc = f64_from_int(0)
    let i = 0
    loop i < n {
        let v = tensor_get(a, i)
        acc = f64_add(acc, v)
        i = i + 1
    }
    ret acc
}

fn vec_dot_test(a: i64, b: i64) -> i64 {
    let ap = tensor_data(a)
    let bp = tensor_data(b)
    let n = tensor_len(a)
    if avx512_check() == 1 {
        ret avx512_dot_f64(ap, bp, n)
    }
    let acc = f64_from_int(0)
    let i = 0
    loop i < n {
        let va = tensor_get(a, i)
        let vb = tensor_get(b, i)
        let p = f64_mul(va, vb)
        acc = f64_add(acc, p)
        i = i + 1
    }
    ret acc
}

fn main() -> i64 {
    let a = tensor_new1(4)
    let b = tensor_new1(4)
    ; a = [10, 20, 30, 40]
    let v10 = f64_from_int(10)
    tensor_set(a, 0, v10)
    let v20 = f64_from_int(20)
    tensor_set(a, 1, v20)
    let v30 = f64_from_int(30)
    tensor_set(a, 2, v30)
    let v40 = f64_from_int(40)
    tensor_set(a, 3, v40)
    ; sum = 100
    let s = vec_sum_test(a)
    let si = f64_to_int(s)
    if si == 100 {
        print "vec sum ok"
    }
    ; b = [1, 2, 3, 4]
    let w1 = f64_from_int(1)
    tensor_set(b, 0, w1)
    let w2 = f64_from_int(2)
    tensor_set(b, 1, w2)
    let w3 = f64_from_int(3)
    tensor_set(b, 2, w3)
    let w4 = f64_from_int(4)
    tensor_set(b, 3, w4)
    ; dot = 10*1 + 20*2 + 30*3 + 40*4 = 10+40+90+160 = 300
    let d = vec_dot_test(a, b)
    let di = f64_to_int(d)
    if di == 300 {
        print "vec dot ok"
    }
    tensor_free(a)
    tensor_free(b)
    ret 0
}
