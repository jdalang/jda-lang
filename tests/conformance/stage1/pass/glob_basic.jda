fn main() -> i64 {
    let pat: &i8 = alloc_pages(1)
    let str: &i8 = alloc_pages(1)
    let out: &i8 = alloc_pages(1)

    ; Test 1: literal match "abc" vs "abc" -> 1
    poke_byte(pat, 0, 97) poke_byte(pat, 1, 98) poke_byte(pat, 2, 99)
    poke_byte(str, 0, 97) poke_byte(str, 1, 98) poke_byte(str, 2, 99)
    let m1 = glob_match(pat, 3, str, 3)
    print("{m1}\n")

    ; Test 2: literal mismatch "abc" vs "abd" -> 0
    poke_byte(str, 2, 100)
    let m2 = glob_match(pat, 3, str, 3)
    print("{m2}\n")

    ; Test 3: "*.t" vs "f.t" -> 1
    poke_byte(pat, 0, 42)  ; *
    poke_byte(pat, 1, 46)  ; .
    poke_byte(pat, 2, 116) ; t
    poke_byte(str, 0, 102) ; f
    poke_byte(str, 1, 46)  ; .
    poke_byte(str, 2, 116) ; t
    let m3 = glob_match(pat, 3, str, 3)
    print("{m3}\n")

    ; Test 4: "a?c" vs "axc" -> 1
    poke_byte(pat, 0, 97)  ; a
    poke_byte(pat, 1, 63)  ; ?
    poke_byte(pat, 2, 99)  ; c
    poke_byte(str, 0, 97)  ; a
    poke_byte(str, 1, 120) ; x
    poke_byte(str, 2, 99)  ; c
    let m4 = glob_match(pat, 3, str, 3)
    print("{m4}\n")

    ; Test 5: "*" vs "anything" -> 1
    poke_byte(pat, 0, 42)
    poke_byte(str, 0, 104) ; h
    poke_byte(str, 1, 105) ; i
    let m5 = glob_match(pat, 1, str, 2)
    print("{m5}\n")

    ; Test 6: has_magic on "a*b"
    poke_byte(pat, 0, 97)
    poke_byte(pat, 1, 42)
    poke_byte(pat, 2, 98)
    let hm = glob_has_magic(pat, 3)
    print("{hm}\n")

    ; Test 7: has_magic on "abc" -> 0
    poke_byte(pat, 0, 97)
    poke_byte(pat, 1, 98)
    poke_byte(pat, 2, 99)
    let hm2 = glob_has_magic(pat, 3)
    print("{hm2}\n")

    ; Test 8: escape "a*b" -> "a[*]b"
    poke_byte(str, 0, 97)  ; a
    poke_byte(str, 1, 42)  ; *
    poke_byte(str, 2, 98)  ; b
    let en = glob_escape(str, 3, out)
    ; Expected: "a[*]b" = 5 bytes
    print("{en}\n")
    syscall(1, 1, out, en)
    print("\n")

    ret 0
}
